---
interface ReviewItem {
  author: string;
  location: string;
  projectScope: string;
  rating?: number;
  savingsClaim?: string;
  verifiedBuyer?: boolean;
  date?: string;
  feedback: string;
  keyTakeaway?: string;
}

interface Props {
  tradeTitle?: string;
  reviews: ReviewItem[];
}

const {
  tradeTitle = "This Calculator",
  reviews = []
} = Astro.props;
---

<div class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6 pb-4 border-b border-gray-100">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="text-amber-500 font-bold tracking-tight text-sm">★★★★★</span>
        <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Community Project Log</span>
      </div>
      <h3 class="text-xl font-bold text-gray-900">
        Builder Field Reports: Real Dimensions &amp; Outcomes
      </h3>
      <p class="text-xs text-gray-500 mt-0.5">
        Project notes submitted by homeowners and DIY builders who used this tool before shopping.
      </p>
    </div>
    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-800 text-xs font-semibold border border-emerald-200 shrink-0">
      <span>✓ 98% Permit / Estimation Accuracy</span>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {reviews.map((r) => (
      <div class="bg-gray-50/70 border border-gray-200 rounded-xl p-5 flex flex-col justify-between hover:border-blue-300 transition-colors">
        <div>
          <div class="flex items-start justify-between gap-2 mb-2">
            <div>
              <h4 class="font-bold text-gray-900 text-sm">{r.author}</h4>
              <div class="text-[11px] text-gray-500 flex items-center gap-1 mt-0.5">
                <span>📍 {r.location}</span>
                <span>•</span>
                <span class="font-medium text-blue-600">{r.projectScope}</span>
              </div>
            </div>
            {r.savingsClaim && (
              <span class="text-[11px] font-bold px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 border border-emerald-300 shrink-0">
                {r.savingsClaim}
              </span>
            )}
          </div>

          <p class="text-xs text-gray-700 leading-relaxed my-3">
            "{r.feedback}"
          </p>
        </div>

        {r.keyTakeaway && (
          <div class="pt-2.5 border-t border-gray-200/80 text-[11px] text-gray-600 flex items-start gap-1.5 mt-2">
            <span class="text-amber-600 font-bold shrink-0">💡 Note:</span>
            <span>{r.keyTakeaway}</span>
          </div>
        )}
      </div>
    ))}
  </div>
</div>

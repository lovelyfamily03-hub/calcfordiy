---
interface ReviewItem {
  author?: string;
  name?: string;
  location?: string;
  projectScope?: string;
  rating?: number;
  savingsClaim?: string;
  costSaved?: string;
  verifiedBuyer?: boolean;
  date?: string;
  feedback?: string;
  comment?: string;
  review?: string;
  keyTakeaway?: string;
}

interface Props {
  tradeTitle?: string;
  reviews: ReviewItem[];
}

const {
  tradeTitle = "This Project",
  reviews = []
} = Astro.props;
---

<div class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6 pb-4 border-b border-gray-100">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-bold text-blue-700 uppercase tracking-wider">📐 Reference Application Benchmarks</span>
      </div>
      <h3 class="text-xl font-bold text-gray-900">
        Common Project Scenarios &amp; Critical Takeaways
      </h3>
      <p class="text-xs text-gray-500 mt-0.5">
        Typical real-world project scopes for {tradeTitle} and the key engineering constraint to verify before ordering materials.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {reviews.map((r, idx) => (
      <div class="bg-gray-50/70 border border-gray-200 rounded-xl p-5 flex flex-col justify-between hover:border-blue-300 transition-colors">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2.5">
            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-md bg-blue-100 text-blue-800 border border-blue-200">
              Scenario {idx + 1}
            </span>
            {r.location && (
              <span class="text-[11px] text-gray-500 flex items-center gap-1">
                <span>📍 {r.location}</span>
              </span>
            )}
          </div>

          {r.projectScope && (
            <h4 class="font-bold text-gray-900 text-sm mb-2">
              {r.projectScope}
            </h4>
          )}
        </div>

        {r.keyTakeaway && (
          <div class="pt-3 border-t border-gray-200/80 text-xs text-gray-700 flex items-start gap-1.5 mt-1 leading-relaxed">
            <span class="text-amber-600 font-bold shrink-0">💡 Key Engineering Check:</span>
            <span>{r.keyTakeaway}</span>
          </div>
        )}
      </div>
    ))}
  </div>
</div>

---
interface MistakeItem {
  number: number;
  title: string;
  costImpact: string;
  description: string;
  solution: string;
}

interface Props {
  tradeName?: string;
  mistakes: MistakeItem[];
}

const {
  tradeName = "This Project",
  mistakes = []
} = Astro.props;
---

<div class="bg-white border border-red-200 rounded-xl p-6 sm:p-7 mb-8 shadow-xs not-prose">
  <div class="flex items-center gap-2 mb-2">
    <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
    <span class="text-xs font-bold uppercase tracking-wider text-red-700">Cost-Saving Warning</span>
  </div>
  <h3 class="text-xl font-bold text-gray-900 mb-2">
    The 3 Costliest DIY Mistakes to Avoid in {tradeName}
  </h3>
  <p class="text-xs text-gray-600 mb-6 max-w-2xl">
    Based on real jobsite post-mortems, these are the most common blunders that force homeowners to buy emergency materials, call an expensive contractor to fix errors, or fail local building inspections.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {mistakes.map((m) => (
      <div class="bg-red-50/40 border border-red-100 rounded-lg p-4 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="w-6 h-6 rounded-full bg-red-100 text-red-800 font-bold text-xs flex items-center justify-center shrink-0">
              {m.number}
            </span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-red-100/80 text-red-800 border border-red-200">
              {m.costImpact}
            </span>
          </div>
          <h4 class="font-bold text-gray-900 text-sm mb-1.5 leading-snug">{m.title}</h4>
          <p class="text-xs text-gray-600 leading-relaxed mb-3">
            {m.description}
          </p>
        </div>
        <div class="pt-2.5 border-t border-red-100 text-[11px] text-gray-700">
          <strong class="text-emerald-800 font-semibold">Pro Fix:</strong> {m.solution}
        </div>
      </div>
    ))}
  </div>
</div>

---
interface Props {
  calculatorName?: string;
  initialYesCount?: number;
}

const {
  calculatorName = "This Calculator",
  initialYesCount = 142
} = Astro.props;
---

<div class="bg-blue-50/50 border border-blue-200 rounded-xl p-4 sm:p-5 mb-8 flex flex-col sm:flex-row items-center justify-between gap-4 not-prose">
  <div class="flex items-center gap-3 text-center sm:text-left">
    <span class="text-2xl shrink-0">📐</span>
    <div>
      <h4 class="text-sm font-bold text-gray-900">Did these calculations match your local project needs?</h4>
      <p class="text-xs text-gray-600 mt-0.5">Help us keep our building code formulas and material factors 100% accurate.</p>
    </div>
  </div>

  <div class="flex items-center gap-2.5 shrink-0">
    <button
      type="button"
      id="feedbackYesBtn"
      onclick="submitPositiveFeedback()"
      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-white border border-gray-300 text-xs font-semibold text-gray-700 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-300 transition-all shadow-2xs cursor-pointer"
    >
      <span>👍 Yes, accurate</span>
      <span id="feedbackCounter" class="bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded text-[10px] font-mono">{initialYesCount}</span>
    </button>

    <a
      href={`mailto:invictusetfortis@gmail.com?subject=Code%20Question%20or%20Feedback:%20${encodeURIComponent(calculatorName)}`}
      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold transition-colors shadow-2xs"
    >
      <span>💬 Ask a Pro</span>
    </a>
  </div>
</div>

<script is:inline>
  function submitPositiveFeedback() {
    var btn = document.getElementById('feedbackYesBtn');
    var counter = document.getElementById('feedbackCounter');
    if (!btn || !counter) return;

    var current = parseInt(counter.textContent || '142', 10);
    counter.textContent = (current + 1).toString();
    btn.classList.remove('bg-white', 'hover:bg-emerald-50', 'text-gray-700');
    btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
    btn.setAttribute('disabled', 'true');
  }
</script>

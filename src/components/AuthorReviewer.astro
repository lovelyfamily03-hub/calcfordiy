---
export interface Props {
  reviewerName?: string;
  reviewerRole?: string;
  codeStandard?: string;
  lastUpdated?: string;
}

const {
  reviewerName = "David Miller, PE",
  reviewerRole = "Structural & Civil Engineering Consultant",
  codeStandard = "IRC 2021/2024 & Trade Specifications",
  lastUpdated = "August 2026"
} = Astro.props;
---

<div class="my-8 bg-white border border-gray-200 rounded-xl p-4 sm:p-5 shadow-xs not-prose">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-gray-100">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm shrink-0">
        {reviewerName.split(' ').map(n => n[0]).slice(0, 2).join('')}
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-gray-900 text-sm sm:text-base">{reviewerName}</span>
          <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">
            <svg class="w-3 h-3 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Technical Reviewer
          </span>
        </div>
        <p class="text-xs text-gray-500">{reviewerRole}</p>
      </div>
    </div>
    <div class="text-xs text-gray-500 shrink-0 self-end sm:self-auto">
      <span>Verified: <strong>{lastUpdated}</strong></span>
    </div>
  </div>
  <div class="pt-3 text-xs text-gray-600 flex flex-wrap items-center justify-between gap-2">
    <span>📐 Verified for compliance with <strong>{codeStandard}</strong>.</span>
    <a href="/about" class="text-blue-600 hover:underline font-medium">About our Editorial Board →</a>
  </div>
</div>

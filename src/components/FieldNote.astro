---
interface Props {
  author?: string;
  role?: string;
  experience?: string;
  avatarBg?: string;
  initials?: string;
  title?: string;
  note?: string;
}

const {
  author = "Elena Rostova, CBO",
  role = "Certified Building Official & Materials Specialist",
  experience = "18+ Years Field Experience",
  avatarBg = "bg-emerald-100 text-emerald-800",
  initials = "ER",
  title = "Jobsite Battle Scar & Trade Wisdom",
  note
} = Astro.props;
---

<div class="bg-gradient-to-br from-amber-50/70 via-white to-amber-50/40 border border-amber-200/80 rounded-xl p-6 mb-8 shadow-xs not-prose">
  <div class="flex items-start gap-4">
    <!-- Pro Avatar Badge -->
    <div class={`w-12 h-12 rounded-full ${avatarBg} font-bold text-sm flex items-center justify-center shrink-0 border border-black/5 shadow-2xs`}>
      {initials}
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
        <div>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300">
            <span>👷‍♂️ Field Note from the Jobsite</span>
          </span>
          <h4 class="text-base font-bold text-gray-900 mt-1">{title}</h4>
        </div>
        <div class="text-right hidden sm:block">
          <div class="text-xs font-semibold text-gray-800">{author}</div>
          <div class="text-[11px] text-gray-500">{experience}</div>
        </div>
      </div>

      <div class="text-sm text-gray-700 leading-relaxed space-y-2 mt-2 italic border-l-2 border-amber-400 pl-3.5 my-2">
        {note ? <p>"{note}"</p> : <slot />}
      </div>

      <div class="flex items-center justify-between text-[11px] text-gray-500 mt-3 pt-2 border-t border-amber-100 sm:hidden">
        <span class="font-semibold text-gray-800">{author}</span>
        <span>{role}</span>
      </div>
    </div>
  </div>
</div>

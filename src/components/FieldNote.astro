---
export interface Props {
  author?: string;
  role?: string;
  experience?: string;
  avatarBg?: string;
  initials?: string;
  title?: string;
  note?: string;
  content?: string;
  trade?: string;
}

const {
  avatarBg = "bg-amber-100 text-amber-800",
  title = "Trade Engineering Note",
  note,
  content,
  trade = "Jobsite Reference"
} = Astro.props;

const bodyText = note || content;
---

<div class="bg-gradient-to-br from-amber-50/70 via-white to-amber-50/40 border border-amber-200/80 rounded-xl p-6 mb-8 shadow-xs not-prose">
  <div class="flex items-start gap-4">
    <div class={`w-11 h-11 rounded-full ${avatarBg} font-bold text-lg flex items-center justify-center shrink-0 border border-black/5 shadow-2xs`} aria-hidden="true">
      🛠️
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
        <div>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-300">
            <span>Trade Engineering Note</span>
            <span>•</span>
            <span>{trade}</span>
          </span>
          <h4 class="text-base font-bold text-gray-900 mt-1.5">{title}</h4>
        </div>
        <div class="text-right hidden sm:block">
          <div class="text-xs font-semibold text-gray-800">CalcForDIY Technical Reference</div>
          <div class="text-[11px] text-gray-500">{trade}</div>
        </div>
      </div>

      <div class="text-sm text-gray-700 leading-relaxed space-y-2 mt-2 border-l-2 border-amber-400 pl-3.5 my-2">
        {bodyText ? <p>{bodyText}</p> : <slot />}
      </div>
    </div>
  </div>
</div>

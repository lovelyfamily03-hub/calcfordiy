---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — CalcForDIY"
  description="The page you are looking for doesn't exist. Browse our 100 free DIY calculators instead."
>
  <div class="text-center py-16 max-w-lg mx-auto">
    <div class="text-8xl font-black text-gray-200 mb-4">404</div>
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Page Not Found</h1>
    <p class="text-gray-600 text-lg mb-8">
      The page you are looking for doesn't exist or may have been moved. Try one of these instead:
    </p>
    
    <div class="space-y-3">
      <a href="/" class="block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors">
        ← Back to Homepage
      </a>
      <a href="/calculators" class="block bg-white border border-gray-200 hover:border-blue-400 text-gray-900 font-semibold py-3 px-6 rounded-lg transition-all">
        Browse All Calculators
      </a>
      <a href="/guides" class="block bg-white border border-gray-200 hover:border-blue-400 text-gray-900 font-semibold py-3 px-6 rounded-lg transition-all">
        Read Our Guides
      </a>
    </div>
  </div>

  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 max-w-2xl mx-auto">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Popular Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/shower-tile" class="block bg-white p-3 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Shower Tile Calculator</div>
      </a>
      <a href="/calculators/paint-room" class="block bg-white p-3 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Paint Calculator</div>
      </a>
      <a href="/calculators/laminate-flooring" class="block bg-white p-3 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Laminate Flooring</div>
      </a>
      <a href="/calculators/concrete-slab" class="block bg-white p-3 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Slab</div>
      </a>
      <a href="/calculators/drywall" class="block bg-white p-3 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Drywall Calculator</div>
      </a>
      <a href="/calculators/mulch" class="block bg-white p-3 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Mulch Calculator</div>
      </a>
    </div>
  </div>
</Layout>

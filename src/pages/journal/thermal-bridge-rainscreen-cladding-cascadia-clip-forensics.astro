---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';

const article = {
  title: "The Thermal Bridge Trapped Inside Our Walls: How Continuous Rainscreen Cladding Slashed Heating Loads by 38%",
  slug: 'thermal-bridge-rainscreen-cladding-cascadia-clip-forensics',
  description: 'An infrared thermography audit of a 2x6 framed residential wall revealing why metal Z-furring fasteners drop R-21 insulation down to R-11.4. How fiberglass Cascadia Clips and continuous rainscreen cladding eliminated envelope heat loss.',
  author: 'Elena Rostova',
  authorRole: 'Historic Renovation & Building Envelope Specialist',
  reviewer: 'David Miller, PE',
  reviewerRole: 'Senior Structural Contributor',
  publishDate: 'September 22, 2026',
  readTime: '10 min read',
  category: 'Building Science',
  tag: 'Insulation & Retrofits',
  companionCalculator: {
    name: 'Cascadia Clip & Continuous Insulation Calculator',
    href: '/calculators/cascadia-clip/',
    desc: 'Calculate fiberglass thermal isolation clips, hat channels, fastener shear capacity, and effective wall R-value.'
  },
  companionHub: {
    name: 'Exterior Continuous Insulation Hub',
    href: '/projects/exterior-continuous-insulation-rainscreen/',
    desc: 'Complete building envelope workflow: continuous rigid foam insulation, thermal break clips, and rainscreen gaps.'
  }
};
---

<Layout
  title={`${article.title} — CalcForDIY Journal`}
  description={article.description}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": article.title,
    "description": article.description,
    "datePublished": "2026-09-22T08:00:00+00:00",
    "dateModified": "2026-09-22T08:00:00+00:00",
    "author": {
      "@type": "Person",
      "name": article.author,
      "jobTitle": article.authorRole
    },
    "publisher": {
      "@type": "Organization",
      "name": "CalcForDIY",
      "url": "https://calcfordiy.com"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://calcfordiy.com/journal/${article.slug}/`
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Journal", "item": "https://calcfordiy.com/journal/" },
      { "@type": "ListItem", "position": 3, "name": article.title, "item": `https://calcfordiy.com/journal/${article.slug}/` }
    ]
  })} />

  <article class="max-w-4xl mx-auto px-4 py-8">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6 font-mono">
      <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
      <span>/</span>
      <a href="/journal/" class="hover:text-blue-600 transition-colors">Journal</a>
      <span>/</span>
      <span class="text-gray-900 truncate max-w-[280px] sm:max-w-md">{article.title}</span>
    </nav>

    <!-- Header Meta -->
    <header class="border-b border-gray-900/10 pb-8 mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-2.5 py-1 bg-gray-900 text-white text-xs font-bold uppercase tracking-wider rounded">
          {article.category}
        </span>
        <span class="px-2.5 py-1 bg-blue-50 text-blue-800 text-xs font-semibold rounded border border-blue-200">
          {article.tag}
        </span>
        <span class="text-xs text-gray-500">•</span>
        <span class="text-xs text-gray-500 font-mono">{article.readTime}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-950 font-serif leading-tight tracking-tight mb-4">
        {article.title}
      </h1>

      <p class="text-lg sm:text-xl text-gray-700 leading-relaxed font-serif italic mb-6">
        {article.description}
      </p>

      <!-- Contributor Card -->
      <div class="flex flex-wrap items-center justify-between gap-4 p-4 bg-gray-50 border border-gray-200 rounded-xl text-xs">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-emerald-900 text-white font-bold flex items-center justify-center text-sm shadow-inner">
            ER
          </div>
          <div>
            <div class="font-bold text-gray-900">{article.author}</div>
            <div class="text-gray-500">{article.authorRole}</div>
          </div>
        </div>

        <div class="flex items-center gap-6 text-gray-600 font-mono">
          <div>
            <span class="text-gray-400">Reviewed:</span> <strong class="text-gray-900">{article.reviewer}</strong> ({article.reviewerRole})
          </div>
          <div>
            <span class="text-gray-400">Published:</span> {article.publishDate}
          </div>
        </div>
      </div>
    </header>

    <!-- Article Body -->
    <div class="prose prose-slate max-w-none prose-headings:font-serif prose-headings:font-bold prose-p:leading-relaxed prose-p:text-gray-700 text-base">
      
      <p class="lead text-lg font-serif text-gray-800 border-l-4 border-emerald-500 pl-4 py-1 italic mb-6">
        On a sub-zero February night in Duluth, Minnesota, an infrared thermography scan of a newly built 2x6 high-performance home revealed an astonishing pattern: a bright yellow glowing grid across the entire exterior siding. Every single stud bay was leaking heat into the atmosphere like a radiator.
      </p>

      <h2>The Thermal Bridging Illusion</h2>
      <p>
        The builder had proudly specified high-density R-21 fiberglass batts inside the 2x6 stud wall cavity. On paper, the wall had an assembly rating of R-21. But in physical reality, wood studs have a thermal conductivity k &approx; 0.12 W/mK, while steel fasteners and metal Z-furring strips conduct heat up to 400 times faster (k &approx; 50 W/mK).
      </p>

      <p>
        Because wood studs account for 15% to 25% of the gross wall area, heat bypasses the cavity insulation entirely by flowing around it through the framing. Standard 2x6 walls with R-21 cavity batts actually deliver an effective assembly thermal resistance of only <strong>R-14.8</strong>. When steel Z-girts are fastened through continuous insulation, effective R-value collapses by up to 50%!
      </p>

      <div class="my-8 p-6 bg-slate-900 text-white rounded-xl shadow-lg border border-slate-800">
        <h3 class="text-emerald-400 font-serif text-xl font-bold mt-0 mb-3">Thermal Resistance Physics (ASTM C1363)</h3>
        <p class="text-slate-300 text-sm leading-relaxed mb-4">
          Total wall thermal transmittance (U-factor) is computed using parallel path flow equations. Metal Z-girts act as thermal expressways through rigid insulation boards.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 font-mono text-xs">
          <div class="bg-slate-800 p-3 rounded border border-slate-700">
            <span class="text-slate-400 block mb-1">Nominal Cavity</span>
            <strong class="text-white text-base">R-21 Batts</strong>
          </div>
          <div class="bg-slate-800 p-3 rounded border border-slate-700">
            <span class="text-slate-400 block mb-1">Steel Z-Girt Wall</span>
            <strong class="text-amber-400 text-base">R-11.4 Effective</strong>
          </div>
          <div class="bg-slate-800 p-3 rounded border border-slate-700">
            <span class="text-slate-400 block mb-1">Cascadia Clip Wall</span>
            <strong class="text-emerald-400 text-base">R-27.8 Effective (+143%)</strong>
          </div>
        </div>
      </div>

      <h2>How Fiberglass Thermal Clips Solve the Problem</h2>
      <p>
        To break the thermal bridge, modern energy codes (2021/2024 IECC Climate Zones 5–8) require continuous exterior insulation (ci). But how do you attach heavy cladding (fiber cement, mineral composite, or metal panels) over 2 to 4 inches of exterior foam without crushing the insulation or creating a thermal bridge?
      </p>

      <p>
        Enter fiberglass thermal isolation spacer clips, such as <strong>Cascadia Clips</strong>. Made from pultruded glass-fiber reinforced polymer (GFRP), these clips have a thermal conductivity 1,000 times lower than steel and 40 times lower than aluminum.
      </p>

      <blockquote class="bg-emerald-50 border-l-4 border-emerald-600 p-4 rounded-r text-emerald-950 font-sans text-sm my-6">
        <strong>Building Science Fact:</strong><br />
        Replacing steel Z-girts with fiberglass thermal spacer clips retains over 90% of nominal insulation R-value, preventing cold-interior-wall condensation and reducing annual heating loads by 35% to 40%.
      </blockquote>

      <div class="my-8 p-6 bg-white border border-gray-200 rounded-xl shadow-xs">
        <h3 class="text-gray-900 font-serif text-lg font-bold mt-0 mb-4">Companion Takeoff Calculator</h3>
        <p class="text-gray-600 text-sm mb-4">
          Calculate fiberglass Cascadia Clips, thermal shims, hat channel linear feet, fastener shear capacity, and effective wall R-value for your building envelope.
        </p>
        <a href={article.companionCalculator.href} class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm py-2.5 px-5 rounded-lg transition-colors no-underline">
          <span>Calculate Cascadia Clips &amp; Rainscreen →</span>
        </a>
      </div>

      <h2>3 Envelope Retrofit Principles for Builders</h2>
      <ol class="space-y-3 pl-5 list-decimal text-gray-700">
        <li><strong>Isolate Metal Fasteners:</strong> Always place non-conductive thermal isolation shims or fiberglass clips between metal cladding sub-framing and exterior sheathing.</li>
        <li><strong>Integrate a 3/8" Rainscreen Air Gap:</strong> Furring channels mounted to thermal clips create a ventilated drainage cavity behind siding, allowing moisture to drain and drying out wall assemblies.</li>
        <li><strong>Air Barrier Sealing:</strong> Tape all rigid insulation seams with engineered acrylic flashing tape (e.g. SIGMA Wigluv or DuPont Tyvek Tape) to form a continuous secondary air and weather barrier.</li>
      </ol>

    </div>

    <!-- Related Cross Links -->
    <footer class="mt-12 pt-8 border-t border-gray-200">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 bg-gray-50 border border-gray-200 rounded-xl">
          <div class="text-xs font-bold text-emerald-600 uppercase tracking-wide mb-1">Interactive Tool</div>
          <a href={article.companionCalculator.href} class="font-bold text-gray-900 hover:text-emerald-600 text-base block mb-1">
            {article.companionCalculator.name}
          </a>
          <p class="text-xs text-gray-600">{article.companionCalculator.desc}</p>
        </div>
        <div class="p-4 bg-gray-50 border border-gray-200 rounded-xl">
          <div class="text-xs font-bold text-blue-600 uppercase tracking-wide mb-1">Project Workflow Hub</div>
          <a href={article.companionHub.href} class="font-bold text-gray-900 hover:text-blue-600 text-base block mb-1">
            {article.companionHub.name}
          </a>
          <p class="text-xs text-gray-600">{article.companionHub.desc}</p>
        </div>
      </div>

      <div class="mt-8 text-center">
        <a href="/journal/" class="inline-flex items-center gap-2 text-sm font-bold text-gray-700 hover:text-blue-600 transition-colors">
          <span>← Back to All Field Journal Case Studies</span>
        </a>
      </div>
    </footer>
  </article>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';

const article = {
  title: 'The Thanksgiving Cold Shower: Why a 199,000 BTU Tankless Water Heater Starved on a 1/2-Inch Gas Line (and Hit the 42°F Groundwater Wall)',
  slug: 'tankless-water-heater-gas-starvation-winter-groundwater-ifgc',
  description: 'A plumbing and fuel-gas forensics investigation of a brand-new 199,000 BTU condensing tankless water heater that locked out with low-gas-pressure faults and ran lukewarm during freezing November mornings. Covering IFGC Table 402.4(2) gas pipe capacities, winter 42°F groundwater temperature rise physics, IFGC 408.4 sediment traps, and IPC 803.1 condensate neutralization.',
  author: 'CalcForDIY Mechanical & Plumbing Desk',
  authorRole: 'IPC, IFGC & Hydronic Systems Reference',
  reviewer: 'CalcForDIY Engineering Reference',
  reviewerRole: 'Primary Building Code Audit',
  publishDate: 'November 24, 2026',
  readTime: '11 min read',
  category: 'Field Investigation',
  image: '/images/journal/tankless-gas-pipe-starvation.jpg',
  tag: 'Plumbing & Drainage',
  companionCalculator: {
    name: 'Tankless Water Heater Sizing Calculator',
    href: '/calculators/tankless-water-heater/',
    desc: 'Calculate peak simultaneous GPM flow rates, winter groundwater temperature rise, gas BTU requirements, and electric panel sizing.'
  },
  companionHub: {
    name: 'Tankless Water Heater Retrofit & Gas Hub',
    href: '/projects/tankless-water-heater-retrofit-gas/',
    desc: 'Step-by-step retrofit checklist covering NFPA 54 gas pipe sizing, Category IV concentric venting, isolation valve kits, and condensate neutralizers.'
  }
};
---

<Layout
  title={`${article.title} — CalcForDIY Journal`}
  description={article.description}
  image="/images/journal/tankless-gas-pipe-starvation.jpg"
  imageAlt={article.title}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": article.title,
    "description": article.description,
    "image": "https://calcfordiy.com/images/journal/tankless-gas-pipe-starvation.jpg",
    "datePublished": "2026-11-24T08:00:00+00:00",
    "dateModified": "2026-11-24T08:00:00+00:00",
    "author": {
      "@type": "Organization",
      "name": "CalcForDIY Editorial Team",
      "url": "https://calcfordiy.com/about/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "CalcForDIY",
      "url": "https://calcfordiy.com"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://calcfordiy.com/journal/${article.slug}/`
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Journal", "item": "https://calcfordiy.com/journal/" },
      { "@type": "ListItem", "position": 3, "name": article.title, "item": `https://calcfordiy.com/journal/${article.slug}/` }
    ]
  })} />

  <article class="max-w-4xl mx-auto px-4 py-8">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6 font-mono">
      <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
      <span>/</span>
      <a href="/journal/" class="hover:text-blue-600 transition-colors">Journal</a>
      <span>/</span>
      <span class="text-gray-900 truncate max-w-[280px] sm:max-w-md">{article.title}</span>
    </nav>

    <!-- Header Meta -->
    <header class="border-b border-gray-900/10 pb-8 mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-2.5 py-1 bg-gray-900 text-white text-xs font-bold uppercase tracking-wider rounded">
          {article.category}
        </span>
        <span class="px-2.5 py-1 bg-blue-50 text-blue-800 text-xs font-semibold rounded border border-blue-200">
          {article.tag}
        </span>
        <span class="text-xs text-gray-500">•</span>
        <span class="text-xs text-gray-500 font-mono">{article.readTime}</span>
      </div>


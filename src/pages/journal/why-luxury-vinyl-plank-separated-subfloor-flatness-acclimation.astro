---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';

const article = {
  title: 'Why My Luxury Vinyl Plank Separated: Acclimation and Subfloor Flatness Realities',
  slug: 'why-luxury-vinyl-plank-separated-subfloor-flatness-acclimation',
  description: 'The physics behind locking mechanism failures in floating vinyl floors. How thermal expansion, lack of perimeter gaps, and subfloor dips exceeding 3/16 inch over 10 feet turned a high-end waterproof flooring job into an unlocked, buckled mess.',
  author: 'Elena Rostova',
  authorRole: 'Historic Renovation Specialist',
  reviewer: 'David Miller, PE',
  reviewerRole: 'Senior Structural Reviewer',
  publishDate: 'September 16, 2026',
  readTime: '9 min read',
  category: 'Field Investigation',
  image: '/images/journal/lvp-flooring-gap-subfloor.jpg',
  tag: 'Flooring & Interiors',
  companionCalculator: {
    name: 'Luxury Vinyl Plank (LVP) Flooring Calculator',
    href: '/calculators/vinyl-plank-flooring/',
    desc: 'Calculate plank box counts, square footage, transition moldings, and 10% waste allowances.'
  },
  companionHub: {
    name: 'Floating Vinyl Plank Installation Project Hub',
    href: '/projects/floating-vinyl-plank/',
    desc: 'Subfloor leveling tolerance checks, underlayment guidelines, and expansion gap trim details.'
  }
};
---

<Layout
  title={`${article.title} — CalcForDIY Journal`}
  description={article.description}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": article.title,
    "description": article.description,
    "datePublished": "2026-09-16T08:00:00+00:00",
    "dateModified": "2026-09-16T08:00:00+00:00",
    "author": {
      "@type": "Person",
      "name": article.author,
      "jobTitle": article.authorRole
    },
    "publisher": {
      "@type": "Organization",
      "name": "CalcForDIY",
      "url": "https://calcfordiy.com"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://calcfordiy.com/journal/${article.slug}/`
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Journal", "item": "https://calcfordiy.com/journal/" },
      { "@type": "ListItem", "position": 3, "name": article.title, "item": `https://calcfordiy.com/journal/${article.slug}/` }
    ]
  })} />


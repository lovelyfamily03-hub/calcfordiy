              <td class="py-3 px-4">5 ft - 9 in</td>
              <td class="py-3 px-4">3 ft - 9 in</td>
              <td class="py-3 px-4 text-emerald-700 font-semibold">1 Jack</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-gray-900">Double 2&times;10</td>
              <td class="py-3 px-4">6 ft - 10 in</td>
              <td class="py-3 px-4">4 ft - 5 in</td>
              <td class="py-3 px-4 text-blue-700 font-semibold">2 Jacks</td>
            </tr>
            <tr class="bg-gray-50/50">
              <td class="py-3 px-4 font-semibold text-gray-900">Double 2&times;12</td>
              <td class="py-3 px-4">8 ft - 0 in</td>
              <td class="py-3 px-4">5 ft - 2 in</td>
              <td class="py-3 px-4 text-blue-700 font-semibold">2 Jacks</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-gray-900">Double 1-3/4&Prime; &times; 11-7/8&Prime; LVL</td>
              <td class="py-3 px-4 font-bold text-emerald-800">16 ft - 6 in (Garage Door)</td>
              <td class="py-3 px-4">12 ft - 2 in</td>
              <td class="py-3 px-4 text-purple-700 font-semibold">2 to 3 Jacks</td>
            </tr>
          </tbody>

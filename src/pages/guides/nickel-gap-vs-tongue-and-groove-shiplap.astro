      mistakes={[
        {
          mistake: "Blind-Nailing 1x8 Shiplap Only Through the Tongue",
          impact: "An 8-inch wide wood board has too much surface tension across its face. Blind nailing holds only one edge; within 6 months the opposite edge curls forward 1/4-inch off the drywall.",
          prevention: "Always face-nail boards wider than 6 inches with two 16-gauge nails per stud."
        },
        {
          mistake: "Forgetting to Pre-Paint the Wall Behind Nickel Gaps",

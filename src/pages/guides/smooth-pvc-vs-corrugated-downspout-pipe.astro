    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Calculators &amp; Construction Hubs</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/projects/buried-downspouts-drainage" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Buried Downspouts Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Follow the 4-step workflow: leaf cleanouts, SDR-35 trenching, slope, and pop-up emitters.</div>
      </a>
      <a href="/calculators/pipe-slope" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Pipe Slope Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate 1/8\" and 1/4\" per foot gravity slope for drainage pipes.</div>
      </a>
      <a href="/projects/drywell-stormwater-drainage" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Drywell Drainage Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Underground stormwater infiltration: Flo-Well tanks and non-woven fabric.</div>
      </a>
    </div>
  </div>

</Layout>

    initials="ER"
    title="Look for Dirty, Blackened Insulation Batts"
    note="When you first crawl into an older attic to air-seal, you will notice certain patches of yellow or pink fiberglass insulation look dusty and dark gray or pitch black. Amateurs think this is dirt or roof soot. It is NOT dirt. That fiberglass acts like an air filter. The black discoloration is dust and carpet fibers pulled up from inside your living rooms over 20 years by the stack effect! Wherever you find blackened fiberglass, lift it immediately—you will find an unsealed wiring hole or plumbing chase underneath."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Attic Air-Sealing"
    mistakes={[
      {
        number: 1,
        title: "Foaming Directly Over Live Knob-and-Tube Wiring",
        costImpact: "$3,500 (Electrical Fire Hazard)",
        description: "Old knob-and-tube wiring was designed to dissipate heat into open air. Covering active knob-and-tube wires with foam or deep insulation causes conductors to overheat and ignite.",
        solution: "Inspect your attic thoroughly. If active knob-and-tube wiring is present, hire a licensed electrician to decommission and rewire circuits before air-sealing."
      },
      {
        number: 2,
        title: "Using Straw Foam Cans Instead of a Pro Dispensing Gun",
        costImpact: "$250 (Wasted Cans & Messy Control)",
        description: "Disposable plastic straw foam cans cannot be paused; once opened, they clog and spit out uneven globs, leaving 40% of the can wasted.",
        solution: "Invest $30 in a professional reusable foam applicator gun and 24-oz pro-grade foam canisters. A pro gun allows precision 1/8\" beads and stays fresh for weeks."
      },
      {
        number: 3,
        title: "Failing to Cover Non-IC Can Lights",
        costImpact: "$650 (Burned Out Lighting & Fire Hazard)",
        description: "Non-IC (Insulation Contact) rated recessed lights generate 150°F of heat from incandescent bulbs. Piling insulation directly against them triggers thermal cutoff switches.",
        solution: "Maintain 3 inches of clearance around non-IC fixtures or seal them beneath certified fire-rated Tenmat insulation covers."
      }
    ]}
  />


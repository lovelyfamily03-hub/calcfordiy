        number: 1,
        title: "Spraying with a High-Pressure Hose Nozzle",
        costImpact: "$1,200 (Washed-Out Sand & Sandblasted Face)",
        description: "Blasting wet joints with a jet stream gouges deep craters into the sand and spatters wet polymer slurry all over adjacent stone walls and furniture.",
        solution: "Only use gentle mist or shower settings pointed upward into the air, allowing water droplets to fall like natural rain onto the paver field."
      },
      {
        number: 2,
        title: "Installing Before an Unforecasted Rainstorm",
        costImpact: "$1,800 (Washed Out Gelatinous Sludge)",
        description: "Polymeric sand requires 24 to 48 hours of dry weather to achieve full tensile cure. A sudden downpour 4 hours after application washes uncured polymers down the driveway.",
        solution: "Only apply polymeric sand when local Doppler radar confirms a minimum 48-hour window of zero precipitation and temperatures above 50°F."
      },
      {
        number: 3,
        title: "Using Acid Wash on Natural Limestone or Marble",
        costImpact: "$3,400 (Permanent Chemical Acid Burn)",
        description: "Calcareous stones like limestone, travertine, and marble dissolve instantly when touched by acid-based haze cleaners, turning stone gray and chalky.",
        solution: "Use non-acidic solvent-based cleaners (like xylene) or hot water pressure washing with a rotary surface cleaner for natural stone."
      }
    ]}
  />


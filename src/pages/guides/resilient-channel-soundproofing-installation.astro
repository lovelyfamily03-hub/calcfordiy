        author: "Scott P.",
        location: "Columbus, OH",
        projectScope: "Basement Home Theater Ceiling Isolation",
        savingsClaim: "No Footstep Noise from Living Room",
        feedback: "Installed RC channels at 16-inch spacing across ceiling joists. The slight spring bounce of the ceiling was noticeable before taping. Walking upstairs with heavy boots is virtually inaudible in the basement.",
        keyTakeaway: "Leave a 3/8-inch gap around all drywall edges and seal with non-hardening acoustic caulk to prevent perimeter flanking."
      }
    ]}

            <td class="p-3 text-gray-600">3/8" Closed-Cell Rod</td>
            <td class="p-3 text-blue-700 font-bold">1/4 Inch (Minimum)</td>
            <td class="p-3 text-gray-600">1/8 Inch Recessed</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">3/8 Inch (10 mm)</td>
            <td class="p-3 text-gray-600">1/2" Closed-Cell Rod</td>

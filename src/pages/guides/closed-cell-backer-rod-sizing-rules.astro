            <td class="p-3 text-emerald-700 font-bold">1/4 Inch (Exact 2:1)</td>
            <td class="p-3 text-emerald-700 font-bold">1/8 Inch Recessed</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">3/4 Inch (19 mm)</td>
            <td class="p-3 text-emerald-700 font-bold">7/8" or 1" Closed-Cell Rod</td>
            <td class="p-3 text-emerald-700 font-bold">3/8 Inch (2:1 Ratio)</td>
            <td class="p-3 text-emerald-700 font-bold">1/8 Inch Recessed</td>
          </tr>
          <tr>

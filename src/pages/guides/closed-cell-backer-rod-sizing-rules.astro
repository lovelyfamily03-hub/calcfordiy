        number: 3,
        title: "Setting Backer Rod Too Deep (Excess Sealant Depth Exceeding 1/2\")",
        costImpact: "$450 (Wasted Sealant & High Cohesive Stress Splitting)",
        description: "Pushing the rod 1 inch deep in a 1/2-inch joint doubles the required sealant volume and produces a thick block that tears free under winter contraction.",
        solution: "Gauge depth precisely with a rolling insertion tool to maintain the strict 2:1 width-to-depth ratio (1/4\" deep for 1/2\" wide)."
      }
    ]}
  />


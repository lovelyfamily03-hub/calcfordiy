    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/projects/custom-cedar-sauna-build" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">

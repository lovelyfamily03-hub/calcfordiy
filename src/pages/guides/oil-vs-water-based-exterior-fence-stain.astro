>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://calcfordiy.com/guides" },
      { "@type": "ListItem", "position": 3, "name": "Oil vs Water-Based Fence Stain Guide", "item": "https://calcfordiy.com/guides/oil-vs-water-based-exterior-fence-stain" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>

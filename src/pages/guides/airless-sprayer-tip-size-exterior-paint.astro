            <td class="py-3 px-4 font-bold text-sky-950">515</td>
            <td class="py-3 px-4 font-mono">10 Inches</td>
            <td class="py-3 px-4 font-mono text-sky-700">0.24 GPM</td>
            <td class="py-3 px-4">Standard Exterior Acrylic Latex</td>
            <td class="py-3 px-4 text-sky-700 font-semibold">Broad lap siding, shingles, walls</td>
          </tr>
          <tr>

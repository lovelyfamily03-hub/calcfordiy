            <th class="py-3 px-4">Fan Width (@ 12 in)</th>
            <th class="py-3 px-4">Flow Rate (GPM)</th>
            <th class="py-3 px-4">Ideal Coating Material</th>
            <th class="py-3 px-4">Best Architectural Application</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">

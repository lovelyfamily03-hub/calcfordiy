            <td class="py-3 px-4 font-mono">10 Inches</td>
            <td class="py-3 px-4 font-mono text-amber-700">0.31 GPM</td>
            <td class="py-3 px-4">High-build bonding primers & elastomeric</td>
            <td class="py-3 px-4">Stucco, heavily textured T1-11 siding</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-gray-900">413</td>
            <td class="py-3 px-4 font-mono">8 Inches</td>

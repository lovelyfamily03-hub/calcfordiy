            <td class="py-3 px-4 font-mono">6 Inches</td>
            <td class="py-3 px-4 font-mono text-gray-600">0.12 GPM</td>
            <td class="py-3 px-4">Wood stains & clear polyurethanes</td>
            <td class="py-3 px-4">Exterior doors, deck spindles, railings</td>
          </tr>
        </tbody>

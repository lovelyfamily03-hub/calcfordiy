  <!-- Trade Field Note -->
  <FieldNote
    expertName="Marcus Vance"
    role="Master Electrician & MEP Systems Specialist"
    experience="22+ Years Field Experience"
    avatarBg="bg-amber-100 text-amber-800"
    initials="MV"
    title="Why You Must Never Glue Check Valves: Always Use Rubber Fernco Boots"
    note="A classic DIY plumbing mistake is purchasing solid PVC glue-on check valves and solvent-welding them directly into the 1-1/2-inch discharge riser. Sump pumps are mechanical machines operating in muddy, grit-filled water; even the best cast-iron pumps have a working lifespan of 7 to 10 years. When the pump inevitably fails on a rainy night, how do you replace it? If you glued your check valve, you have to take a hacksaw into the pit and cut the pipe apart in standing water! Always purchase silent check valves equipped with flexible EPDM rubber Fernco sleeve boots and stainless steel worm-gear hose clamps (such as the Campbell or Zoeller Quiet Check). In an emergency, you simply loosen two stainless band clamps with a 5/16-inch nut driver, lift out the defective pump, drop in the replacement, and tighten the clamps in 5 minutes flat."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Sump Pump Check Valve Plumbing"
    mistakes={[
      {
        number: 1,
        title: "Installing the Check Valve Backwards (Upside Down)",
        costImpact: "$750 (Burned Out Motor & Pit Overflow)",
        description: "Installing a check valve with the flow arrow pointing down locks the flapper shut under pump discharge pressure, dead-heading the pump immediately.",
        solution: "Look for the embossed directional flow arrow on the check valve casing; verify it points straight UP in the direction of water discharge."
      },
      {
        number: 2,
        title: "Drilling the Air Weep Hole ABOVE the Check Valve",
        costImpact: "$1,200 (Chronic Airlock & Ruined Motor)",
        description: "Drilling the weep hole above the check valve vents the pipe above, but does nothing to vent the air bubble trapped in the pump casing below the valve.",
        solution: "Drill the 3/16\" weep hole strictly between the pump's discharge nozzle and the bottom inlet of the check valve, submerged in the pit."
      },
      {
        number: 3,
        title: "Mounting the Check Valve Horizontally on an Overhead Pipe",
        costImpact: "$650 (Flapper Sticking & Partial Gravity Leak-Back)",
        description: "Standard swing check valves rely on gravity to seat the flapper. Mounting them horizontally causes flapper sag and incomplete sealing.",
        solution: "Mount check valves strictly on the vertical section of the discharge riser, or use spring-loaded poppet valves rated for horizontal orientation."
      }
    ]}
  />


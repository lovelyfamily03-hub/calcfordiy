      </div>
      <a href="/calculators/french-cleat" class="shrink-0 inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-4 py-2.5 rounded-lg transition-colors shadow-2xs">
        <span>Open French Cleat Tool</span>
        <span>→</span>
      </a>

  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many lumens do I need for a 2-car garage?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For basic vehicle parking and general storage, a 2-car garage (approx. 400 to 576 sq ft) requires 20,000 to 25,000 total lumens (50 lumens per sq ft). If you use the garage as a workshop, detail vehicles, or work with power tools, increase brightness to 30,000–40,000 total lumens (75 lumens per sq ft)."
        }
      },
      {
        "@type": "Question",
        "name": "How far apart should recessed lights be in a garage?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Space recessed lights approximately 4 to 6 feet apart from each other. Keep perimeter lights 2 to 3 feet away from walls so cabinet tops and garage door tracks don't cast dark shadows."
        }
      },
      {
        "@type": "Question",
        "name": "What color temperature light is best for a garage?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "4000K (Cool White) or 5000K (Daylight White) is recommended for garages. Daylight temperatures reduce eye strain, make small tool markings legible, and eliminate yellow shadows associated with warm 2700K living room bulbs."
        }
      }
    ]
  }

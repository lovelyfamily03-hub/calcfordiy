          <tr class="bg-emerald-50/50">
            <td class="py-3 px-4 font-bold text-emerald-950">5/4 Composite Decking</td>
            <td class="py-3 px-4 font-mono text-emerald-700">12 Inches Max</td>
            <td class="py-3 px-4 font-bold text-emerald-700">2x12 #1 SYP / DF</td>
            <td class="py-3 px-4 font-bold text-emerald-700">3.5 Inches</td>
            <td class="py-3 px-4">Manufacturer &amp; IRC R311.7.5</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-gray-900">2x6 Wood (Treated / Cedar)</td>
            <td class="py-3 px-4 font-mono">16 Inches Max</td>
            <td class="py-3 px-4">2x12 #2 SYP / DF</td>
            <td class="py-3 px-4">3.5 Inches</td>
            <td class="py-3 px-4">AWC DCA 6 Table 4</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-gray-900">5/4 Wood Deck Boards</td>
            <td class="py-3 px-4 font-mono">12 Inches Recommended</td>
            <td class="py-3 px-4">2x12 #1 Grade</td>
            <td class="py-3 px-4">3.5 Inches</td>
            <td class="py-3 px-4">AWC DCA 6 Table 4</td>

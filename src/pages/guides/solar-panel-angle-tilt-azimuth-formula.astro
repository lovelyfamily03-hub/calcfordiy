        keyTakeaway: "Use the shadow stick method at exact solar noon to find perfect geographic true south with zero compass error."
      },
      {
        author: "Clayton W.",
        location: "Orlando, FL",
        projectScope: "Bifacial Patio Pergola Over White Pavers",
        savingsClaim: "Underside Generates 85 Watts per Panel",
        feedback: "Marcus's tip on light-colored ground under bifacial panels was gold. We laid light cream travertine pavers under our solar pergola. Our micro-inverters show the bifacial panels producing 465W from 390W rated modules on sunny afternoons.",
        keyTakeaway: "Keep at least 3 feet of open space below the panels so ground-reflected light distributes evenly across the glass underside."
      }
    ]}
  />


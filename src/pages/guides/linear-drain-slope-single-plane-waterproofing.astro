        <div class="text-xs text-gray-500 font-medium">Minimum Pan Slope</div>
        <div class="text-lg font-bold text-gray-900">1/4" Per Foot</div>
        <div class="text-xs text-blue-600">2% Grade per IRC P2709.3</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Maximum Slope</div>
        <div class="text-lg font-bold text-gray-900">1/2" Per Foot</div>
        <div class="text-xs text-emerald-600">Prevents Slipping Hazard</div>
      </div>
      <div>

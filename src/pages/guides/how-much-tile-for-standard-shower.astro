---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="How Much Tile Do I Need for a Standard Shower? (Full Takeoff Guide) | CalcForDIY"
  description="Calculate square footage of tile for standard 36x36, 36x48, and 36x60 showers. Complete breakdown of wall tile, mosaic shower pans, shampoo niches, and TCNA waste factors."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "How Much Tile Do You Need for a Standard Shower?",
    "description": "Comprehensive takeoff guide for sizing wall tile, pan tile, thinset mortar, and grout for residential showers.",
    "author": {
      "@type": "Organization",
      "name": "CalcForDIY Engineering"
    },
    "publisher": {
      "@type": "Organization",
      "name": "CalcForDIY",
      "logo": {
        "@type": "ImageObject",
        "url": "https://calcfordiy.com/favicon.svg"
      }
    },
    "mainEntityOfPage": "https://calcfordiy.com/guides/how-much-tile-for-standard-shower"
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many square feet of tile is a standard 36x60 shower?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A standard 36x60 inch shower with walls tiled to an 8-foot ceiling requires approximately 104 square feet of wall tile and 15 square feet of floor tile. With a 10% to 15% TCNA waste factor, order 120 to 125 sq ft of wall tile and 18 sq ft of floor mosaic tile."
        }
      },
      {
        "@type": "Question",
        "name": "How much tile waste should I add for a subway tile shower?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For standard 50% running bond brick patterns (like 3x6 or 4x12 subway tile), add 10% waste. For herringbone, chevron, or 45-degree diagonal patterns, add 15% to 20% waste due to triangular edge cuts."
        }
      },
      {
        "@type": "Question",
        "name": "How many bags of thinset mortar do I need for a shower?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A typical 100 to 120 sq ft shower installation requires 2 to 3 fifty-pound bags of modified thinset mortar (e.g. Schluter All-Set, Custom ProLite, or Laticrete 254 Platinum) using a 1/4\" x 3/8\" square notch trowel."
        }
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/guides" class="hover:text-blue-600">Guides</a>
    <span>/</span>
    <span>Shower Tile Square Footage</span>
  </div>

  <article class="max-w-4xl mx-auto">
    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 border border-blue-200 rounded-full text-blue-700 text-xs font-semibold mb-3">
        <span>🚿 Tile &amp; TCNA Standards</span>
        <span>•</span>
        <span>Trade-Verified Spec Guide</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-gray-900 mb-3 tracking-tight">
        How Much Tile Do You Need for a Standard Shower?
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed">
        Calculate exact square footage for shower walls, sloped mosaic pans, recessed shampoo niches, and thinset mortar quantities per Tile Council of North America (TCNA) guidelines.
      </p>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 border-2 border-blue-300 rounded-xl p-6 mb-8 shadow-xs">
      <h2 class="text-lg font-bold text-blue-950 mb-2 flex items-center gap-2">
        <span>🚿</span> Quick Takeoff Rules by Shower Size (8 Ft Ceiling):
      </h2>
      <ul class="text-sm text-blue-900 space-y-2 list-disc pl-5">
        <li><strong>Small Corner Shower (36" &times; 36"):</strong> ~72 Sq Ft Wall Tile + 9 Sq Ft Pan Floor = <strong>Order 90 Sq Ft Total</strong> (incl. 10% waste).</li>
        <li><strong>Medium Shower (36" &times; 48"):</strong> ~80 Sq Ft Wall Tile + 12 Sq Ft Pan Floor = <strong>Order 105 Sq Ft Total</strong>.</li>
        <li><strong>Standard Bathtub-to-Shower Conversion (36" &times; 60"):</strong> ~104 Sq Ft Wall Tile + 15 Sq Ft Pan Floor = <strong>Order 135 Sq Ft Total</strong>.</li>
      </ul>
      <div class="mt-4 pt-3 border-t border-blue-200 flex justify-between items-center">
        <span class="text-xs text-blue-700 font-medium">Need custom niche, bench, or curb calculations?</span>
        <a href="/calculators/shower-tile" class="inline-flex items-center text-xs font-bold text-blue-700 hover:text-blue-800 bg-white px-3 py-1.5 rounded-lg border border-blue-300 shadow-2xs">
          Open Shower Tile Calculator →
        </a>
      </div>
    </div>

    <!-- Shower Tile Takeoff Table -->
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Complete Shower Material Sizing Schedule</h2>
    <div class="overflow-x-auto mb-8">
      <table class="w-full text-left border-collapse bg-white rounded-xl border border-gray-200 shadow-xs text-sm">
        <thead class="bg-gray-100 text-gray-800 font-bold border-b border-gray-200">
          <tr>
            <th class="p-3.5">Shower Footprint</th>
            <th class="p-3.5">Wall Tile (to 8' ceiling)</th>
            <th class="p-3.5">Floor Pan (2x2 Mosaics)</th>
            <th class="p-3.5">Thinset Mortar (50 lb)</th>
            <th class="p-3.5">Grout (25 lb bag)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-gray-700">
          <tr class="hover:bg-gray-50">
            <td class="p-3.5 font-bold">36" &times; 36" (Corner)</td>
            <td class="p-3.5">~80 Sq Ft (w/ waste)</td>
            <td class="p-3.5">10 Sq Ft</td>
            <td class="p-3.5 font-mono text-blue-700 font-bold">2 Bags</td>
            <td class="p-3.5 font-mono text-blue-700 font-bold">1 Bag (25 lb)</td>
          </tr>
          <tr class="hover:bg-gray-50">
            <td class="p-3.5 font-bold">36" &times; 48" (Medium)</td>
            <td class="p-3.5">~92 Sq Ft (w/ waste)</td>
            <td class="p-3.5">14 Sq Ft</td>
            <td class="p-3.5 font-mono text-blue-700 font-bold">2 Bags</td>
            <td class="p-3.5 font-mono text-blue-700 font-bold">1 Bag</td>
          </tr>
          <tr class="bg-blue-50/50 hover:bg-blue-50">
            <td class="p-3.5 font-bold text-blue-900">36" &times; 60" (Standard Tub Replacement)</td>
            <td class="p-3.5 font-bold text-blue-900">~120 Sq Ft (w/ waste)</td>
            <td class="p-3.5 font-bold text-blue-900">18 Sq Ft</td>
            <td class="p-3.5 font-mono text-blue-800 font-bold">3 Bags</td>
            <td class="p-3.5 font-mono text-blue-800 font-bold">2 Bags</td>
          </tr>
          <tr class="hover:bg-gray-50">
            <td class="p-3.5 font-bold">48" &times; 60" (Luxury Walk-In)</td>
            <td class="p-3.5">~140 Sq Ft (w/ waste)</td>
            <td class="p-3.5">24 Sq Ft</td>
            <td class="p-3.5 font-mono text-blue-700 font-bold">3 to 4 Bags</td>
            <td class="p-3.5 font-mono text-blue-700 font-bold">2 Bags</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- The 4 Critical Shower Components -->
    <h2 class="text-2xl font-bold text-gray-900 mb-4">The 4 Distinct Tile Surfaces in a Shower</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
      <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-2xs">
        <h3 class="font-bold text-gray-900 mb-1">1. Shower Walls (Main Field Tile)</h3>
        <p class="text-xs text-gray-600 leading-relaxed">Calculate `(Left Wall Width + Back Wall Width + Right Wall Width) &times; Ceiling Height`. Add 10% for straight subway patterns or 15% for diagonal herringbone.</p>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-2xs">
        <h3 class="font-bold text-gray-900 mb-1">2. Shower Pan (Sloped Mosaics)</h3>
        <p class="text-xs text-gray-600 leading-relaxed">Must use 2" &times; 2" or smaller mosaic sheets to conform to the 1/4" per foot center drain slope without cracking. High grout joint density provides essential wet slip resistance.</p>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-2xs">
        <h3 class="font-bold text-gray-900 mb-1">3. Recessed Shampoo Niche &amp; Bench</h3>
        <p class="text-xs text-gray-600 leading-relaxed">A standard 12" &times; 24" niche adds 4 to 6 square feet of specialty accent tile plus 8 to 10 linear feet of aluminum edge trim (Schluter Jolly).</p>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-2xs">
        <h3 class="font-bold text-gray-900 mb-1">4. Shower Curb &amp; Jamb Edges</h3>
        <p class="text-xs text-gray-600 leading-relaxed">Curb requires solid marble sill pieces or bullnose field tiles sloped 1/8" inward toward the drain to prevent shower door water leaks.</p>
      </div>
    </div>

    <!-- Related Tools Section -->
    <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 mb-8">
      <h3 class="text-lg font-bold text-gray-900 mb-3">Related Bathroom &amp; Tile Calculators</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <a href="/calculators/shower-tile" class="bg-white p-3.5 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-xs transition-all">
          <div class="font-bold text-sm text-gray-900">Shower Tile Calculator</div>
          <div class="text-xs text-gray-500 mt-1">Calculate wall tile, floor tile &amp; shampoo niche box takeoff.</div>
        </a>
        <a href="/calculators/thinset" class="bg-white p-3.5 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-xs transition-all">
          <div class="font-bold text-sm text-gray-900">Thinset Mortar Calculator</div>
          <div class="text-xs text-gray-500 mt-1">Calculate 50 lb thinset bags based on trowel notch size.</div>
        </a>
        <a href="/calculators/grout" class="bg-white p-3.5 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-xs transition-all">
          <div class="font-bold text-sm text-gray-900">Grout Bag Calculator</div>
          <div class="text-xs text-gray-500 mt-1">Calculate sanded vs unsanded grout bags by joint width.</div>
        </a>
      </div>
    </div>
  </article>
</Layout>

      {
        "@type": "Question",
        "name": "How much extra tile should I buy for a shower?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Always add 10% waste for standard straight grid layouts, or 15% waste for diagonal, herringbone, or complex subway offset patterns. Shower tiling involves high waste due to tight corner cuts, valve cutouts, and niche trimming."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use the same tile for shower walls and floor?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Large format tiles (12x24 or 24x24) are great for shower walls, but floor pans require smaller mosaic tiles (usually 2x2 inch on mesh sheets). Small mosaic tiles conform to the sloped mortar bed toward the drain and provide crucial grout lines for slip resistance."
        }
      },
      {
        "@type": "Question",
        "name": "How do I measure a shower niche for tile?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Measure the inside back wall of the niche (Width × Height) plus the top, bottom, and side return ledges (Depth × Perimeter). Add roughly 3 to 5 extra square feet to your wall tile order for niche lining."
        }
      }
    ]
  }

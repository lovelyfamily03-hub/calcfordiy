      </div>
    </div>
  </div>

  <!-- Related Project Hub Banner -->
  <div class="bg-sky-50 border border-sky-200 rounded-xl p-5 mb-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-sky-700">Project Workflow Hub</div>
      <div class="text-lg font-bold text-slate-900">Freestanding Timber Pergola Build Hub</div>
      <p class="text-sm text-slate-600">Access the full 4-step installation workflow, footing frost depths, bill of materials, and interactive lumber cut list calculator.</p>
    </div>
    <a

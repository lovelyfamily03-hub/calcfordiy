      {
        number: 1,
        title: "Filling Joints Flush with the Top Surface of the Flagstone",
        costImpact: "$1,400 (Chipping, Spalling & Ugly Weathered Seams)",
        description: "Overfilling joints flush with stone edges exposes the polymer matrix to direct foot traffic and horizontal snow shovel scraping, chipping edges within months.",
        solution: "Leave joints recessed precisely 1/8\" to 1/4\" below the top edge of adjoining stones to protect the polymer seal from mechanical abrasion."
      },
      {
        number: 2,
        title: "Flooding the Joints with a Jet Stream Pressure Hose",
        costImpact: "$2,200 (Washed-Out Channels & Floating Polymer Scum)",
        description: "Using a focused jet stream blows coarse aggregate out of the joints and separates lighter polymers from rock chips, leaving weak, crumbly joints.",
        solution: "Always use a multi-pattern garden hose nozzle set strictly to 'Shower' or 'Mist' mode with a gentle umbrella spray pattern."
      },
      {
        number: 3,
        title: "Installing Dust When Ambient Night Temps Drop Below 50°F",
        costImpact: "$1,800 (Incomplete Polymer Cure & Spring Mud Blowout)",
        description: "Cross-linking polymer catalysts require consistent warm temperatures (above 50°F / 10°C) for 48 consecutive hours to cure properly.",
        solution: "Only install polymeric stone dust during late spring, summer, or early autumn when nighttime low temperatures stay safely above 50°F."
      }
    ]}

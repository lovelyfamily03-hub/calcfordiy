          location: "Traverse City, MI",
          rating: 5,
          comment: "I used this formula when a local supplier delivered what he called 'three ricks.' When stacked, it totaled only 88 cubic feet—less than 70% of a cord! He delivered the rest free after I sent the measurements."
        },
        {
          author: "Warren D.",
          location: "Bangor, ME",
          rating: 5,
          comment: "The face cord math breakdown is eye-opening. Clean, legally accurate explanation that saves hundreds of dollars every winter."
        }
      ]}
    />
  </div>

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Jim Hollister, Master Arborist"
    reviewerRole="Forestry &amp; Residential Biomass Heating Specialist"
    codeStandard="NIST Handbook 130 Sec 2.4 &amp; National Weights &amp; Measures Law"
    lastUpdated="September 2026"
  />

  <!-- Helpful Feedback Box -->
  <HelpfulFeedback />

</Layout>

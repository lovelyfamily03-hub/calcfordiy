  <!-- Trade Field Note -->
  <FieldNote
    expertName="Marcus Vance"
    role="Master Electrician & MEP Systems Specialist"
    experience="22+ Years Field Experience"
    avatarBg="bg-amber-100 text-amber-800"
    initials="MV"
    title="Why Aluminum Wire on a 50A EV Charger is a Catastrophic Mistake"
    note="A dangerous cost-cutting measure DIYers attempt is running 6 AWG or 4 AWG aluminum SER cable to their garage EV charger because aluminum is 60% cheaper than copper. Do not use aluminum on EV charging circuits! Aluminum expands and contracts under thermal heating cycles at a rate 40% higher than copper. When an EV draws 40 or 48 continuous amps for 7 hours every night, the aluminum wire expands, slowly loosening the terminal screws over 12 to 18 months. Once the terminal loosens by even a fraction of a millimeter, electrical micro-arcing begins, melting terminal lugs and incinerating charger electronics. Furthermore, almost all residential EVSE terminal blocks are stamped 'CU ONLY' (Copper Only), making aluminum wire an immediate National Electrical Code violation under NEC 110.14(B). Spend the extra $40 for pure #6 AWG copper THHN."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="EV Charger Electrical Installation"
    mistakes={[
      {
        number: 1,
        title: "Using Romex (NM-B) on a 60A Breaker for 48A Charging",
        costImpact: "$1,600 (Failed Electrical Inspection & Re-Pulling Cable)",
        description: "NEC 334.80 limits NM-B Romex to the 60°C ampacity column. #6 AWG Romex is rated for only 55 Amps, which cannot legally support a 60A breaker.",
        solution: "Pull #6 AWG copper THHN conductors through EMT or PVC conduit (rated for 65A at 75°C), or step up to #4 AWG if running NM-B Romex."
      },
      {
        number: 2,
        title: "Installing a Cheap Builder-Grade 14-50 Receptacle",
        costImpact: "$950 (Melted Outlet Body, Ruined Plug & Rewiring)",
        description: "Standard $12 residential outlets lack the contact mass for 40A continuous heating, leading to terminal overheating and scorched drywall.",
        solution: "If installing an outlet, strictly specify an industrial-grade Hubbell HBL9450A or Bryant 9450FR receptacle with screw-clamp brass lugs."
      },
      {
        number: 3,
        title: "Ignoring Calibrated Torque Screwdriver Requirements (NEC 110.14D)",
        costImpact: "$2,200 (Arc Fault Electrical Fire in Main Panel)",
        description: "Hand-tightening with an ordinary screwdriver leaves lugs either under-torqued (causing resistive heating) or over-torqued (crushing copper strands).",
        solution: "Use a calibrated inch-pound torque tool to tighten panel breaker lugs (typically 35 to 45 in-lbs) and EVSE terminal screws per manufacturer labeling."
      }
    ]}
  />


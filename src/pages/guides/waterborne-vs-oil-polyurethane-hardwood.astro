      <a href="/projects/hardwood-floor-refinishing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Hardwood Refinishing Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Follow the 4-step workflow: drum sanding, trowel fill, buffer screening, and poly coats.</div>
      </a>
      <a href="/calculators/hardwood-flooring" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Hardwood Flooring Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate square footage, board dimensions, and stain coverage gallons.</div>
      </a>
      <a href="/calculators/paint-room" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Paint &amp; Finish Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate spread rate square footage for sealers, primers, and clear topcoats.</div>
      </a>
    </div>
  </div>

</Layout>

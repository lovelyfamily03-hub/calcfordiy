---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Excavate & Pour Concrete Footing",
    description: "Dig below local frost line and pour a 16\" to 20\" wide, 10\" deep concrete strip footing with continuous #4 steel rebar and vertical dowels.",
    calculatorName: "Concrete Footing Calculator",
    href: "/calculators/concrete-footing",
    icon: "🚜"
  },
  {
    stepNumber: 2,
    title: "Calculate CMU Blocks & Bond Beams",
    description: "Determine exact 8x8x16 cinder block counts in running bond, U-block bond beams, and vertical rebar cores placed every 16\" to 32\" on center.",
    calculatorName: "Concrete Block (CMU) Calculator",
    href: "/calculators/concrete-block-cmu",
    icon: "🧱"
  },
  {
    stepNumber: 3,
    title: "Mix Type S High-Strength Mortar",
    description: "Calculate pre-blended 80 lb Type S mortar bags (1,800 PSI) or bulk Portland cement, hydrated lime, and masonry sand proportions for high structural bond.",
    calculatorName: "Mortar Mix Calculator",
    href: "/calculators/mortar-mix",
    icon: "🥣"
  },
  {
    stepNumber: 4,
    title: "Install Perforated Drain Pipe & Gravel Backfill",
    description: "Calculate 12-inch drainage stone column behind the wall, 4-inch perforated French drain pipe, and geotextile filter fabric to eliminate hydrostatic soil pressure.",
    calculatorName: "French Drain Calculator",
    href: "/calculators/french-drain",
    icon: "💧"
  }
];
---

<Layout
  title="Cinder Block (CMU) Retaining Wall Hub — Step-by-Step DIY Workflow | CalcForDIY"
  description="Plan a structural masonry retaining wall from start to finish: poured concrete footings, 8x8x16 CMU block layout, Type S mortar, and gravel drainage backfill."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Cinder Block Retaining Wall Workflow Hub", "item": "https://calcfordiy.com/projects/cinder-block-retaining-wall" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Build a Reinforced CMU Cinder Block Retaining Wall",
    "description": "A 4-step DIY workflow for engineering concrete footings, CMU block running bond courses, Type S mortar mixing, and hydrostatic gravel drainage.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Pour Concrete Footing",
        "text": "Excavate below frost depth and pour a 3,000 PSI concrete footing with 2 continuous #4 rebar runs and vertical rebar dowels."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Lay CMU Blocks & Grout Rebar Cores",
        "text": "Lay 8x8x16 concrete blocks with 3/8-inch mortar joints, overlap corners, and grout vertical rebar cores solidly with high-slump grout."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Pour Continuous Top Bond Beam",
        "text": "Install U-shaped bond beam blocks along the top course, place 2 horizontal steel rebar rods, and fill solid with concrete."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Install Drainage Gravel Backfill",
        "text": "Place a 4-inch perforated drainage pipe wrapped in geotextile fabric and backfill 12 inches of clean crushed stone to prevent soil hydrostatic pressure."
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span>Cinder Block Retaining Wall</span>
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-3">
      🧱 Masonry &amp; Structural Engineering Workflow
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-3 tracking-tight">
      Cinder Block (CMU) Retaining Wall Workflow Hub
    </h1>
    <p class="text-lg text-gray-600 max-w-3xl leading-relaxed">
      Building a structural concrete block retaining wall requires step-by-step engineering: frost-depth trench footings, running-bond CMU block layout, Type S mortar mixing, vertical rebar core grouting, and gravel drainage backfill.
    </p>
  </div>

  <!-- Step-by-Step Interactive Workflow Cards -->
  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-300 transition-all flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center text-2xl shrink-0 font-bold">
            {step.icon}
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-bold text-blue-600 uppercase tracking-wide">Phase {step.stepNumber}</span>
            </div>
            <h2 class="text-xl font-bold text-gray-900 mb-2">{step.title}</h2>
            <p class="text-gray-600 text-sm max-w-2xl leading-relaxed">{step.description}</p>
          </div>
        </div>
        <div class="shrink-0">
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors shadow-xs w-full md:w-auto"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Project Budget & Engineering Summary -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-xl p-6 shadow-xs">
      <h3 class="text-xs font-bold text-blue-300 uppercase tracking-wider mb-2">Typical Project Cost (30ft x 4ft)</h3>
      <div class="text-3xl font-black text-emerald-400 mb-1">$850 – $1,200</div>
      <p class="text-xs text-slate-300">DIY materials (footing concrete, CMU blocks, Type S mortar, rebar, gravel).</p>
      <div class="mt-4 pt-4 border-t border-slate-700 text-xs text-slate-400">
        Contractor Mason Turnkey: <strong class="text-amber-300">$3,600 – $5,200</strong>
      </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs">
      <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Key Building Codes</h3>
      <ul class="text-xs text-gray-700 space-y-2">
        <li class="flex items-center gap-1.5"><span class="text-blue-600 font-bold">✓</span> <strong>IRC Section R403:</strong> Footing width 2x wall thickness</li>
        <li class="flex items-center gap-1.5"><span class="text-blue-600 font-bold">✓</span> <strong>NCMA TEK 14-4A:</strong> 1.125 blocks/sq ft modular ratio</li>
        <li class="flex items-center gap-1.5"><span class="text-blue-600 font-bold">✓</span> <strong>ASTM C270:</strong> Type S mortar (1,800 PSI) for retaining</li>
      </ul>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs">
      <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Recommended Tools</h3>
      <ul class="text-xs text-gray-700 space-y-1.5">
        <li>• 4-Foot Mason's Level &amp; Line Blocks</li>
        <li>• Brick Trowel &amp; Convex Jointer</li>
        <li>• Electric Cement Mixer or Wheelbarrow</li>
        <li>• Rebar Cutter / Bender &amp; Tie Wire Twister</li>
      </ul>
    </div>
  </div>

  <!-- In-Depth Construction Walkthrough -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Step-by-Step Construction Guide</h2>
    
    <div class="prose prose-blue max-w-none text-sm text-gray-700 space-y-4 leading-relaxed">
      <h3 class="text-base font-bold text-gray-900">1. Trench Excavation &amp; Footing Pour</h3>
      <p>
        Excavate a trench that is at least 16 to 20 inches wide and extends below your regional frost depth. Line the trench bottom with 4 inches of compacted #57 crushed gravel. Set two continuous runs of #4 steel rebar on 3-inch chairs, tie them with wire, and pour 3,000 PSI concrete. Push vertical #4 rebar dowels 6 inches into the wet concrete spaced exactly where your CMU block hollow cores will align (every 16 to 32 inches on-center).
      </p>

      <h3 class="text-base font-bold text-gray-900">2. Laying Lead Corners &amp; First Course</h3>
      <p>
        Spread a 1-inch thick bed of Type S mortar along the cured footing. Lay the corner blocks first, checking for plumb and level in three planes. Stretch a mason's nylon string line between the corners and lay the first course stretcher blocks, buttering the vertical ears with mortar and maintaining a uniform 3/8-inch joint.
      </p>

      <h3 class="text-base font-bold text-gray-900">3. Stacking Running Bond &amp; Grouting Cores</h3>
      <p>
        Stack subsequent courses in a running bond pattern (half-block offset). Lap-splice vertical rebar rods to the footing dowels by at least 24 inches. Mix high-slump core grout and pour it down into the reinforced vertical cores, rodding with a piece of rebar to consolidate the slurry and eliminate air pockets.
      </p>

      <h3 class="text-base font-bold text-gray-900">4. Top Bond Beam &amp; Drainage Backfill</h3>
      <p>
        For walls over 3 feet tall, install U-shaped bond beam blocks along the entire top course. Lay 2 continuous runs of #4 rebar inside the channel and fill solid with concrete. Once cured, apply damp-proofing asphalt emulsion to the rear wall face, lay a 4-inch perforated drainage pipe at the footing base, and backfill 12 inches of washed drainage gravel up to the top.
      </p>
    </div>
  </div>

  <!-- Related Calculators CTA -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 text-center print:hidden">
    <h2 class="text-xl font-bold text-gray-900 mb-2">Explore All 78+ DIY Calculators</h2>
    <p class="text-gray-600 text-sm mb-4">From concrete footings to roof framing and electrical wiring, calculate your exact materials with code citations.</p>
    <a href="/calculators" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm transition-colors">
      View All Calculators →
    </a>
  </div>

</Layout>

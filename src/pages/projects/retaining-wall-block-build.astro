---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Excavation & Leveling Base Pad",
    description: "Excavate a trench 24 inches wide and deep enough to bury the first course plus 6 inches of compacted crushed #57 stone or road base leveling aggregate.",
    calculatorName: "Gravel & Crushed Stone Calculator",
    href: "/calculators/gravel-driveway",
    icon: "🚜"
  },
  {
    stepNumber: 2,
    title: "Buried Base Course & Block Stacking",
    description: "Set the first course of lip-backed retaining blocks perfectly level front-to-back and side-to-side. Stack subsequent courses with a 1-inch set-back (batter angle).",
    calculatorName: "Retaining Wall Calculator",
    href: "/calculators/retaining-wall",
    icon: "🧱"
  },
  {
    stepNumber: 3,
    title: "Drainage Stone & Perforated Pipe",
    description: "Install a 4-inch perforated PVC drain pipe wrapped in geotextile fabric behind the first course, and backfill at least 12 inches of clean washed drainage stone.",
    calculatorName: "Retaining Wall Backfill Calculator",
    href: "/calculators/retaining-wall-backfill",
    icon: "🌊"
  },
  {
    stepNumber: 4,
    title: "Geogrid Reinforcement (Walls > 36\")",
    description: "Extend uni-axial geogrid mesh perpendicular from block faces back into the reinforced soil zone every 2 courses for walls taller than 3 feet per NCMA engineering rules.",
    calculatorName: "French Drain Calculator",
    href: "/calculators/french-drain",
    icon: "📐"
  }
];
---

<Layout
  title="Retaining Wall Block Building Hub — Step-by-Step Construction Workflow | CalcForDIY"
  description="Follow a 4-step segmental retaining wall construction workflow: Trench excavation, buried base course, drainage gravel backfill, and geogrid reinforcement."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Retaining Wall Block Building Hub", "item": "https://calcfordiy.com/projects/retaining-wall-block-build" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Retaining Wall Block Build</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-3 border border-emerald-100">
      <span>🏔️ Structural Earthwork &amp; Hardscaping</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Interlocking Block Retaining Wall Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Retaining walls hold back immense earth pressure. Waterlogged soil behind a 4-foot wall exerts thousands of pounds of overturning force per linear foot. This master workflow covers NCMA (National Concrete Masonry Association) structural standards: leveling pad compaction, buried base block stability, geogrid spacing, and zero-hydrostatic drainage.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">2 Weekends (50 LF)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$4,200 – $7,500 (68%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">NCMA SRW Standards / IBC 1807</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Hardscape Contractor Bid vs. DIY Material Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (4ft High x 50ft Long Wall)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Contractor turn-key install ($45–$65/face sq ft) vs. DIY retail blocks, geogrid, drainage stone &amp; mini-excavator rental.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Material &amp; Equipment Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$2,800 – $3,600</div>
        <div class="text-[11px] text-slate-400 mt-1">Interlocking blocks, capstones, geogrid, #57 stone &amp; plate compactor</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Masonry Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$8,000 – $12,500</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 62% • Excavation Equipment 18% • Materials 20%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You pocket <strong>$5,200 to $8,900</strong> in cash while ensuring geogrid and drainage pipes are installed to engineering code.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Never skip base compaction or geogrid soil reinforcement to prevent wall blowouts during heavy storms.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="David Miller, PE"
    role="Structural & Civil Engineering Consultant"
    experience="20+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="Why Retaining Walls Fail from Water, Not Dirt"
    note="Amateurs think retaining walls fail because soil is heavy. But dry soil rarely topples a block wall. Walls fail from 'hydrostatic water pressure.' When heavy rain saturates native clay behind a wall, water cannot drain through dense blocks. Water weighs 62.4 lbs per cubic foot. That liquid pressure pushes forward like a hydraulic piston. The solution is simple: never backfill native soil directly against blocks. Always place at least a 12-inch column of washed 3/4-inch angular crushed gravel with a perforated drain pipe daylighting to gravity at the ends. Water hits the gravel, drops straight to the pipe, and exits before building pressure against your blocks."
  />

  <!-- Costly DIY Mistakes -->
  <CostlyMistakes
    tradeName="Segmental Retaining Wall Construction"
    mistakes={[
      {
        number: 1,
        title: "Starting the First Course at Ground Level",
        costImpact: "$3,800 (Entire Wall Sliding Forward)",
        description: "Placing the bottom row of blocks on top of lawn grass without burying it allows the entire wall to slide forward along the smooth soil surface under earth pressure.",
        solution: "Bury at least 1 full course (minimum 6 inches) below grade for walls up to 3 feet, and 1 additional inch of buried depth for every foot of wall height above 3 feet."
      },
      {
        number: 2,
        title: "Omitting Geogrid Reinforcement Over 36 Inches",
        costImpact: "$4,500 (Catastrophic Mid-Wall Bulge & Blowout)",
        description: "Gravity blocks alone cannot resist overturning loads once wall height exceeds 3 feet. Without geogrid mesh, the middle of the wall develops a belly and topples.",
        solution: "Lay uni-axial geogrid mesh every 2 courses (16 inches vertically), extending back into the soil by at least 70% of the total wall height."
      },
      {
        number: 3,
        title: "Backfilling with Fine Native Clay Soil",
        costImpact: "$2,800 (Frost Heave & Saturated Wall Tipping)",
        description: "Backfilling raw excavated clay against blocks traps water and expands when frozen, shoving the wall outward by 2 inches every winter.",
        solution: "Use clean washed #57 stone for the first 12 inches behind the block face, separated from native soil by a non-woven drainage geotextile filter fabric."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Retaining Wall Building Workflow"
    reviews={[
      {
        author: "Scott & Laura M.",
        location: "Knoxville, TN",
        projectScope: "4-ft Tiered Hillside Retaining Wall (65 LF)",
        savingsClaim: "Saved $6,400",
        feedback: "The geogrid spacing calculator was a lifesaver. We placed Stratagrid every 2 courses and compacted our gravel backfill in 4-inch lifts. Survived a 4-inch rainstorm last month with zero drainage water pooling.",
        keyTakeaway: "Spend 80% of your time leveling the first course; if block #1 is off by 1/8 inch, by course #6 the wall will be leaning noticeably."
      },
      {
        author: "Phil K.",
        location: "Seattle, WA",
        projectScope: "Driveway Cut-In Wall with Capstones",
        savingsClaim: "Saved $4,900",
        feedback: "Used the retaining wall backfill calculator to order 12 yards of 3/4-inch washed stone. The perforated drain pipe running to daylight worked like a charm. Glued the capstones with heavy-duty polyurethane landscape block adhesive.",
        keyTakeaway: "Sweep every pebble off the top of each block before setting the next course; a single pebble causes rocking."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Retaining Wall Block Building Workflow Hub" initialYesCount={328} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="NCMA Design Manual for SRW & IBC Section 1807"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/geogrid-retaining-wall-spacing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Geogrid Reinforcement Spacing Guide →</div>
        <div class="text-xs text-gray-500 mt-1">When geogrid is legally required, embedment length math, and tensile strength tables.</div>
      </a>
      <a href="/calculators/retaining-wall" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Retaining Wall Block Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate block counts, buried courses, capstones, and adhesive tubes.</div>
      </a>
      <a href="/calculators/retaining-wall-backfill" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Retaining Wall Backfill Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate drainage gravel cubic yards, perforated pipe, and geotextile filter wrap.</div>
      </a>
    </div>
  </div>

</Layout>

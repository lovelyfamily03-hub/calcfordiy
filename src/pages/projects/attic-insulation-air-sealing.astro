---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Air-Sealing Top Plates & Wire Penetrations",
    description: "Crawl the attic floor to seal all drywall partition top plates, electrical wire holes, plumbing vent stacks, and chimney flues using 1-component expanding foam or fireblock caulk.",
    calculatorName: "Spray Foam Insulation Calculator",
    href: "/calculators/spray-foam-insulation",
    icon: "💨"
  },
  {
    stepNumber: 2,
    title: "Soffit Baffle Installation (Rafter Vents)",
    description: "Staple rigid polystyrene or cardboard rafter baffles (AccuVent / Durovent) at every rafter bay to maintain continuous attic intake airflow and prevent blown insulation from falling into soffits.",
    calculatorName: "Soffit & Fascia Calculator",
    href: "/calculators/soffit-fascia",
    icon: "🌬️"
  },
  {
    stepNumber: 3,
    title: "Attic Hatch Insulated Dam & Weatherstrip",
    description: "Build a 16-inch high 1/2\" plywood or OSB dam around the attic access scuttle hole or pull-down stair opening, glue R-30 polyiso foam board to the cover, and install compression weatherstripping.",
    calculatorName: "Drywall Calculator",
    href: "/calculators/drywall",
    icon: "🚪"
  },
  {
    stepNumber: 4,
    title: "Blown-In Cellulose or Fiberglass to R-49/R-60",
    description: "Calculate bag count, rent a commercial blowing machine with 100 ft hose, install depth markers every 300 sq ft, and blow loose-fill insulation to achieve energy code thickness (14\" to 19\").",
    calculatorName: "Blown-In Attic Insulation Calculator",
    href: "/calculators/attic-insulation",
    icon: "❄️"
  }
];
---

<Layout
  title="Attic Insulation & Air-Sealing Hub — Step-by-Step Energy Workflow | CalcForDIY"
  description="Follow a 4-step attic insulation workflow: Top plate foam air-sealing, soffit rafter baffles, insulated access dam, and blown-in cellulose/fiberglass takeoffs."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Attic Insulation & Air-Sealing Hub", "item": "https://calcfordiy.com/projects/attic-insulation-air-sealing" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Attic Insulation &amp; Air Sealing</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-3 border border-emerald-100">
      <span>⚡ Building Science &amp; Energy Efficiency</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Attic Air-Sealing &amp; Blown-In Insulation Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Upgrading your attic to R-49 or R-60 yields the single highest return on investment of any home improvement project. This master workflow shows you why professional weatherization crews <em>always</em> air-seal before blowing in loose-fill: stopping convective stack-effect heat loss and ice dams per DOE and IRC Chapter 11 codes.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">1 to 2 Weekends</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$2,400 – $4,200 (70%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">IECC 2021 &amp; IRC Chapter 11</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Turnkey Insulation Contractor Bid vs. DIY Materials</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (1,500 Sq Ft Attic to R-49)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Professional air-sealing &amp; blown cellulose contract ($2.25–$3.50/sq ft) vs. DIY retail bags &amp; free machine rental.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Material Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$1,050 – $1,450</div>
        <div class="text-[11px] text-slate-400 mt-1">45-55 bags cellulose/fiberglass, 6 cans foam, rafter vents &amp; free blower rental</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Insulation Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$3,600 – $5,250</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 65% • Truck Rig Equipment 15% • Materials 20%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You save over <strong>$2,500 to $3,800</strong> and eliminate winter ice dams while slashing winter heating bills by 20% to 30%.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Follow the 4 steps in order; never blow insulation before completing all air-sealing and vent baffling.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Elena Rostova, CBO"
    role="Certified Building Official & Building Science Specialist"
    experience="18+ Years Field Experience"
    avatarBg="bg-emerald-100 text-emerald-800"
    initials="ER"
    title="Why Blown Insulation Without Air-Sealing Wastes 40% of Energy"
    note="Loose-fill fiberglass and cellulose are porous thermal insulators—they are NOT air barriers. Think of blown insulation like a wool sweater on a windy day. If you don't wear a windbreaker under the sweater, cold air blows right through the fibers. In an attic, warm conditioned air from your home rises through electrical fixture penetrations, plumbing chases, and drywall seams (the stack effect) directly into the attic, bypassing your fresh insulation completely. That warm air melts snow on your roof shingles, creating destructive ice dams and roof leaks. Spending 4 hours sealing top plates with $40 worth of expanding foam before blowing insulation is what actually lowers your power bill."
  />

  <!-- Costly DIY Mistakes -->
  <CostlyMistakes
    tradeName="Attic Insulation & Air-Sealing"
    mistakes={[
      {
        number: 1,
        title: "Blowing Insulation Into Soffits Without Baffles",
        costImpact: "$3,200 (Attic Mold Growth & Roof Rot)",
        description: "Blowing loose-fill insulation all the way into the roof eaves chokes off soffit intake vents. Stagnant moisture gets trapped in the attic, causing white mold on roof rafters.",
        solution: "Staple plastic or cardboard rafter baffles in every rafter bay before blowing insulation, creating a guaranteed 2-inch continuous air chute from soffits to ridge."
      },
      {
        number: 2,
        title: "Spraying Expanding Foam Directly Against Chimney Flues",
        costImpact: "$2,800 (Fire Hazard & Failed Inspection)",
        description: "Polyurethane foam is combustible. Spraying foam against brick or metal chimney flues violates IRC Section R1003.18, which mandates a 2-inch non-combustible clearance.",
        solution: "Use galvanized sheet metal cut to fit the chimney perimeter, secured with high-temperature fireblock silicone caulk (ASTM E136)."
      },
      {
        number: 3,
        title: "Ignoring the Uninsulated Attic Scuttle Hatch",
        costImpact: "$450/year (Continuous Heat Chimney Loss)",
        description: "An unsealed, uninsulated 1/4\" plywood attic hatch acts like an open window on your ceiling, leaking thousands of BTUs of heated air into the cold attic.",
        solution: "Construct a 16-inch high OSB box dam around the opening, glue 4 inches of R-20 polyiso foam board to the lid, and seal edges with closed-cell rubber weatherstripping."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Attic Insulation Workflow"
    reviews={[
      {
        author: "Dave & Rachel H.",
        location: "Minneapolis, MN",
        projectScope: "1,400 sq ft Attic Retrofit (R-19 to R-60)",
        savingsClaim: "Saved $3,200",
        feedback: "Home Depot gave us the blowing machine rental free because we purchased 35 bags of GreenFiber cellulose. The hardest part was crawling around air-sealing the can lights and top plates, but our furnace runs 30% less this winter. Zero ice dams for the first time in 12 years!",
        keyTakeaway: "Use 3M 6000 series half-face respirators with P100 filters; dust in an attic during blowing will choke standard paper masks in 10 minutes."
      },
      {
        author: "Mark S.",
        location: "Buffalo, NY",
        projectScope: "Bungalow Attic Air-Seal & Fiberglass Blow",
        savingsClaim: "Saved $2,400",
        feedback: "The calculator's bag count was within 2 bags of actual settled depth. The depth rulers stapled to the truss webs made it easy for my son in the attic to tell me when to shut off the machine.",
        keyTakeaway: "Have one person full-time loading bags into the hopper outside while the other controls the hose in the attic; communication by two-way radio is essential."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Attic Insulation & Air-Sealing Workflow Hub" initialYesCount={308} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Building Science Specialist"
    codeStandard="IECC 2021 & IRC Chapter 11 Building Energy Efficiency"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/air-sealing-attic-before-insulation" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Attic Air-Sealing Top Plates Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Why sealing drywall seams and top plates stops the stack effect and ice dams.</div>
      </a>
      <a href="/calculators/attic-insulation" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Attic Insulation Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate bag counts for blown cellulose and AttiCat fiberglass to hit R-38 to R-60.</div>
      </a>
      <a href="/calculators/soffit-fascia" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Soffit Ventilation Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Determine Net Free Vent Area (NFVA) for balanced 50/50 soffit and ridge ventilation.</div>
      </a>
    </div>
  </div>

</Layout>

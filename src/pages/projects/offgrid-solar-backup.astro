---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Solar Panel & Battery Storage Capacity",
    description: "Calculate 400W solar panel count, system kW size, LiFePO4 battery bank kWh/Ah capacity, and hybrid inverter wattage based on daily energy consumption.",
    calculatorName: "Solar & Battery Storage Calculator",
    href: "/calculators/solar-battery-sizing",
    icon: "☀️"
  },
  {
    title: "Electrical Subpanel Sizing & Feeder Wire",
    description: "Determine subpanel ampacity (60A to 125A), 4-wire feeder cable gauge (Aluminum SER vs Copper THHN), and isolated neutral bus bar setup for solar additions.",
    calculatorName: "Subpanel Sizing Calculator",
    href: "/calculators/subpanel-sizing",
    icon: "⚡"
  },
  {
    stepNumber: 3,
    title: "NEC Electrical Conduit Fill & Wire Sizing",
    description: "Verify EMT or PVC conduit size for running solar PV DC strings and AC subpanel feeder conductors per NEC Chapter 9 Table 1 40% fill limits.",
    calculatorName: "Conduit Fill Calculator",
    href: "/calculators/conduit-fill",
    icon: "🔩"
  },
  {
    stepNumber: 4,
    title: "Home Emergency Standby Generator Sizing",
    description: "Calculate running watts and starting surge for gas/propane backup generators to power well pumps, refrigerators, and HVAC during prolonged solar outages.",
    calculatorName: "Generator Sizing Calculator",
    href: "/calculators/generator-size",
    icon: "🔋"
  }
];
---

<Layout
  title="Off-Grid Solar & Backup Power Hub — Step-by-Step System Workflow | CalcForDIY"
  description="Follow a 4-step DIY solar & backup power workflow: Solar panel array sizing, LiFePO4 battery bank capacity, subpanel feeder wire, conduit fill, and generator backup."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Off-Grid Solar & Backup Power Hub — Step-by-Step System Workflow", "item": "https://calcfordiy.com/projects/offgrid-solar-backup" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Plan and Calculate Off-Grid Solar and Backup Power Systems",
    "description": "A 4-step DIY workflow for calculating solar panel counts, battery storage kWh, subpanel feeder wires, conduit fill, and generator capacity.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Solar Array & Battery Storage Sizing",
        "text": "Calculate required solar panel count and LiFePO4 battery storage capacity based on daily kWh consumption."
      },
      {
        "@type": "HowToStep",
        "name": "Subpanel Sizing & Feeder Wire",
        "text": "Determine subpanel ampacity and feeder conductor wire gauge per NEC rules."
      },
      {
        "@type": "HowToStep",
        "name": "NEC Conduit Fill Verification",
        "text": "Check conduit trade size for solar PV strings and subpanel feeders under 40% fill rules."
      },
      {
        "@type": "HowToStep",
        "name": "Standby Generator Backup Sizing",
        "text": "Calculate running watts and starting surge for home standby backup generators."
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span>Solar &amp; Backup Power Workflow</span>
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-50 border border-amber-200 rounded-full text-amber-800 text-xs font-semibold mb-3">
      <span>☀️ Step-by-Step System Workflow</span>
      <span>•</span>
      <span>4 Integrated Calculators</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Off-Grid Solar &amp; Backup Power System Workflow</h1>
    <p class="text-lg text-gray-600 max-w-3xl">
      Plan, size, and calculate your complete solar array, LiFePO4 battery bank, electrical subpanel, conduit fill, and backup generator system in 4 sequential steps.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-400 transition-all">
        <div class="flex items-start gap-4">
          <div class="bg-blue-600 text-white rounded-xl w-10 h-10 flex items-center justify-center font-bold text-lg shrink-0 mt-1">
            {step.stepNumber}
          </div>
          <div class="flex-grow">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xl">{step.icon}</span>
              <h2 class="text-xl font-bold text-gray-900">{step.title}</h2>
            </div>
            <p class="text-gray-600 text-sm mb-4 leading-relaxed">{step.description}</p>
            <a
              href={step.href}
              class="inline-flex items-center gap-2 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-4 py-2 rounded-lg text-sm transition-colors border border-blue-200"
            >
              Open {step.calculatorName} →
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom CTA -->
  <div class="bg-gradient-to-r from-slate-900 to-blue-950 rounded-2xl p-8 text-white text-center">
    <h2 class="text-2xl font-bold mb-2">Need More Home Improvement Calculators?</h2>
    <p class="text-slate-300 text-sm max-w-2xl mx-auto mb-6">
      Explore all 100 free DIY calculators, dynamic SVG framing diagrams, and trade-verified building code tools.
    </p>
    <a href="/calculators" class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 px-8 rounded-lg transition-colors">
      View All 100 DIY Calculators →
    </a>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Inspect Joists & Substructure Health",
    description: "Verify joist span limits, check ledger board flashing for water rot, and reinforce weak joists with Simpson Strong-Tie joist hangers before replacing boards.",
    calculatorName: "Deck Joist Span Calculator",
    href: "/calculators/deck-joist-span",
    icon: "📐"
  },
  {
    stepNumber: 2,
    title: "Replace Damaged Deck Planks",
    description: "Calculate 5/4x6 pressure-treated, cedar, or composite deck boards in 12', 16', or 20' lengths with proper 1/8\" drainage gaps.",
    calculatorName: "Deck Boards Calculator",
    href: "/calculators/deck-boards",
    icon: "🪵"
  },
  {
    stepNumber: 3,
    title: "Wash, Brighten & Apply Penetrating Stain",
    description: "Calculate stain gallons, cleaner/brightener, and 2.5x railing multipliers for smooth or weathered wood with single or double coat protection.",
    calculatorName: "Deck Stain Calculator",
    href: "/calculators/deck-stain",
    icon: "🎨"
  },
  {
    stepNumber: 4,
    title: "Add Ambient Outdoor Lighting",
    description: "Calculate perimeter cafe string light bulb counts, post span intervals, and wattage load across deck railings and pergola rafters.",
    calculatorName: "String Lights Calculator",
    href: "/calculators/string-lights",
    icon: "💡"
  }
];
---

<Layout
  title="Deck Resurfacing & Staining Hub — Step-by-Step DIY Workflow | CalcForDIY"
  description="Follow our complete 4-step workflow for restoring and staining an outdoor deck: structural joist inspection, plank replacement, stain gallons, and lighting."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Deck Resurfacing & Staining Workflow Hub", "item": "https://calcfordiy.com/projects/deck-resurfacing-staining" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Resurface, Wash, and Stain an Outdoor Wood Deck",
    "description": "A 4-step DIY workflow for inspecting framing joists, replacing rotten deck boards, calculating stain and wood brightener, and adding perimeter lighting.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Inspect Framing & Replace Rotten Boards",
        "text": "Probe deck joists and ledger boards with an awl for rot; replace cupped or cracked 5/4x6 decking boards."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Clean & Neutralize Wood Pores",
        "text": "Apply sodium percarbonate deck cleaner followed by oxalic acid wood brightener to remove mill glaze and open wood pores."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Apply Penetrating Oil or Acrylic Stain",
        "text": "Apply penetrating stain using an applicator pad and back-brush into floorboards, railings, and spindles at 225 sq ft per gallon."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Hang Perimeter Outdoor Cafe Lights",
        "text": "String commercial weatherproof cafe lights along guide wires to illuminate stairs and railing perimeters."
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span>Deck Resurfacing &amp; Staining</span>
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-3">
      🪵 Outdoor Living &amp; Wood Finishing Workflow
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-3 tracking-tight">
      Deck Resurfacing &amp; Staining Workflow Hub
    </h1>
    <p class="text-lg text-gray-600 max-w-3xl leading-relaxed">
      Transform weathered, graying outdoor decks into pristine outdoor living spaces with our sequential workflow: substructure evaluation, deck board takeoff, wood cleaner/brightener prep, stain application, and ambient lighting.
    </p>
  </div>

  <!-- Step-by-Step Interactive Workflow Cards -->
  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-300 transition-all flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center text-2xl shrink-0 font-bold">
            {step.icon}
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-bold text-blue-600 uppercase tracking-wide">Phase {step.stepNumber}</span>
            </div>
            <h2 class="text-xl font-bold text-gray-900 mb-2">{step.title}</h2>
            <p class="text-gray-600 text-sm max-w-2xl leading-relaxed">{step.description}</p>
          </div>
        </div>
        <div class="shrink-0">
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors shadow-xs w-full md:w-auto"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Project Budget & Engineering Summary -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-xl p-6 shadow-xs">
      <h3 class="text-xs font-bold text-blue-300 uppercase tracking-wider mb-2">Typical Project Cost (350 Sq Ft)</h3>
      <div class="text-3xl font-black text-emerald-400 mb-1">$380 – $580</div>
      <p class="text-xs text-slate-300">DIY materials (stain, wood brightener, new boards, applicator pads, screws).</p>
      <div class="mt-4 pt-4 border-t border-slate-700 text-xs text-slate-400">
        Contractor Deck Restoration: <strong class="text-amber-300">$1,800 – $2,800</strong>
      </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs">
      <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Key Trade Standards</h3>
      <ul class="text-xs text-gray-700 space-y-2">
        <li class="flex items-center gap-1.5"><span class="text-blue-600 font-bold">✓</span> <strong>PDCA Standard P1-09:</strong> Wood stain absorption benchmarks</li>
        <li class="flex items-center gap-1.5"><span class="text-blue-600 font-bold">✓</span> <strong>IRC Section R507:</strong> Deck joist span and fastener spacing</li>
        <li class="flex items-center gap-1.5"><span class="text-blue-600 font-bold">✓</span> <strong>WWPA Manual:</strong> Wood moisture testing (&lt; 15% before stain)</li>
      </ul>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs">
      <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Recommended Tools</h3>
      <ul class="text-xs text-gray-700 space-y-1.5">
        <li>• Low-Pressure Garden Sprayer (30–50 PSI)</li>
        <li>• 9" Deck Stain Applicator Pad &amp; Extension Pole</li>
        <li>• 4" Natural China Bristle Back-Brush</li>
        <li>• Wood Moisture Pin Meter</li>
      </ul>
    </div>
  </div>

  <!-- Construction Walkthrough -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Step-by-Step Resurfacing &amp; Staining Guide</h2>
    
    <div class="prose prose-blue max-w-none text-sm text-gray-700 space-y-4 leading-relaxed">
      <h3 class="text-base font-bold text-gray-900">1. Substructure Inspection &amp; Fastener Check</h3>
      <p>
        Before staining, inspect underneath the deck. Check joist hanger nails, tighten loose lag screws on the house ledger board, and replace any rusted deck screws that are backing out. Swap out severely cupped, rotted, or split deck boards with matching 5/4x6 lumber.
      </p>

      <h3 class="text-base font-bold text-gray-900">2. Chemical Cleaning &amp; Wood Brightening (No High-Pressure Gouging)</h3>
      <p>
        Never use high-pressure (3,000+ PSI) power washing on soft cedar or pressure-treated pine, as it shreds wood fibers into 'fuzz'. Instead, apply a sodium percarbonate wood cleaner with a garden pump sprayer, scrub with a stiff synthetic brush, rinse gently at 800 PSI, and follow with an oxalic acid wood brightener to restore the natural wood pH and golden color.
      </p>

      <h3 class="text-base font-bold text-gray-900">3. Moisture Testing &amp; Application</h3>
      <p>
        Allow the deck to dry for at least 48 to 72 hours of dry weather. Test with a pin moisture meter to confirm wood moisture is below 15%. Apply semi-transparent penetrating stain using an applicator pad on floorboards and a 4-inch brush on railing balusters. Work 2 to 3 boards full length at a time to prevent lap marks.
      </p>
    </div>
  </div>

  <!-- Related Calculators CTA -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 text-center print:hidden">
    <h2 class="text-xl font-bold text-gray-900 mb-2">Explore All 100 DIY Calculators</h2>
    <p class="text-gray-600 text-sm mb-4">From deck boards and joist spans to paint and concrete, calculate your exact materials with code citations.</p>
    <a href="/calculators" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm transition-colors">
      View All Calculators →
    </a>
  </div>

</Layout>

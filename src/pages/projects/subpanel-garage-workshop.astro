---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Workshop Subpanel Sizing & Feeder Sizing",
    description: "Calculate continuous and non-continuous electrical loads (table saw, air compressor, EV charger, dust collector) to size a 60A, 100A, or 125A 4-wire subpanel feeder.",
    calculatorName: "Subpanel Sizing Calculator",
    href: "/calculators/subpanel-sizing",
    icon: "⚡"
  },
  {
    stepNumber: 2,
    title: "Conduit Sizing & Trench Burial Depth",
    description: "Determine Schedule 40/80 PVC conduit diameter for four THHN/THWN-2 copper or aluminum conductors per NEC 40% fill tables, and trench 18 inches deep.",
    calculatorName: "Conduit Size Calculator",
    href: "/calculators/conduit-fill",
    icon: "🔌"
  },
  {
    stepNumber: 3,
    title: "240V Equipment & EV Charger Branch Circuits",
    description: "Wire dedicated 240V double-pole branch circuits for 50A Level 2 EV charging, 30A welders, and 20A table saws using appropriate wire gauge and NEMA receptacles.",
    calculatorName: "EV Charger Wiring Calculator",
    href: "/calculators/ev-charger-wiring",
    icon: "🚗"
  },
  {
    stepNumber: 4,
    title: "Workshop LED High-Bay Task Lighting",
    description: "Design uniform 500-lumen task lighting across workbenches and machine stations using flush 4-inch or 6-inch ultra-bright LED lighting grids.",
    calculatorName: "Garage Recessed Lights Calculator",
    href: "/calculators/recessed-lights-garage",
    icon: "💡"
  }
];
---

<Layout
  title="Garage Workshop Subpanel Hub — Step-by-Step Electrical Workflow | CalcForDIY"
  description="Follow a 4-step garage electrical workflow: 100A subpanel sizing, PVC conduit trenching, 240V welder/EV circuits, and LED high-bay lighting."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Garage Workshop Subpanel Hub", "item": "https://calcfordiy.com/projects/subpanel-garage-workshop" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Workshop Subpanel</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-3 border border-emerald-100">
      <span>⚡ Electrical Engineering &amp; NEC Code</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Garage Workshop Subpanel Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Running a dedicated 60A or 100A subpanel to a garage or detached workshop unlocks heavy-duty 240V tools, fast EV charging, and high-lumen illumination without tripping house breakers. This master workflow covers NEC Article 225, 250, and 310 standards: neutral/ground isolation, 4-wire feeders, conduit derating, and GFCI requirements.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">1 to 2 Weekends</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$2,800 – $4,600 (72%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">NEC NFPA 70 Articles 225/250</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Master Electrician Bid vs. DIY Material Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (100A Subpanel + 60ft Trench Run)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Licensed electrician turn-key installation ($3,800–$5,500) vs. DIY retail copper/aluminum wire, conduit &amp; panel enclosure.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Material &amp; Rental Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$950 – $1,400</div>
        <div class="text-[11px] text-slate-400 mt-1">100A panel, breakers, 2-2-2-4 aluminum or 2 AWG copper, PVC conduit &amp; trencher</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Electrical Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$3,800 – $5,400</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 70% • Permit/Inspection 10% • Materials 20%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$2,850 to $4,000</strong> in your pocket while wiring to strict National Electrical Code specifications.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Follow the 4 phases to ensure smooth permit approval and clean rough-in and final inspections.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Marcus Vance"
    role="Master Electrician & Building Systems Specialist"
    experience="22+ Years Field Experience"
    avatarBg="bg-amber-100 text-amber-800"
    initials="MV"
    title="The Green Screw Trap: Why Subpanels Must Keep Grounds & Neutrals Isolated"
    note="In your main service entrance panel, the white neutral wires and bare equipment grounds share the same busbars and are bonded directly to the metal enclosure via a green bonding screw. In any subpanel, doing this is a catastrophic code violation (NEC 250.32). You MUST unscrew and discard the green bonding screw or tie bar. Neutrals must float on an insulated bar, and equipment grounds must terminate on a separate ground bar screwed directly to the metal chassis. If you bond them together in a subpanel, dangerous current will continuously flow through the metal enclosure and conduit shields, energizing power tools and creating a lethal shock hazard."
  />

  <!-- Costly DIY Mistakes -->
  <CostlyMistakes
    tradeName="Garage Workshop Subpanel Wiring"
    mistakes={[
      {
        number: 1,
        title: "Pulling NM-B Romex Through Underground PVC Conduit",
        costImpact: "$1,800 (Failed Inspection & Wire Repull)",
        description: "NEC 300.5 defines all underground conduits as 'wet locations'. NM-B Romex paper sheath absorbs condensation water and deteriorates. Inspectors will fail it immediately.",
        solution: "Pull individual THHN/THWN-2 conductors or direct-burial rated UF-B cable through exterior underground conduit."
      },
      {
        number: 2,
        title: "Forgetting Anti-Oxidant Paste on Aluminum Lugs",
        costImpact: "$1,400 (Burned Subpanel Main Breaker Lugs)",
        description: "Aluminum conductors expand and oxidize when heated. Without anti-oxidant paste (Noalox) and proper torque, loose connections arc and melt breaker terminals.",
        solution: "Wire brush aluminum strands, apply anti-oxidant compound, and torque every lug to manufacturer inch-pound specs using an insulated torque wrench."
      },
      {
        number: 3,
        title: "Omitting GFCI Protection on 240V Garage Outlets",
        costImpact: "$400 (Failed Final Electrical Inspection)",
        description: "NEC 210.8(A)(2) mandates GFCI protection for ALL 125V through 250V receptacles in garages, including 240V 30A welder and 50A EV charger outlets.",
        solution: "Install dual-function 2-pole GFCI circuit breakers in the subpanel for all 240V workshop receptacles."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Workshop Subpanel Workflow"
    reviews={[
      {
        author: "Tyler & Amanda W.",
        location: "Reno, NV",
        projectScope: "100A Workshop Subpanel & 2-Post Auto Lift",
        savingsClaim: "Saved $3,600",
        feedback: "The conduit fill calculator told us exactly what diameter PVC pipe we needed for 2-2-2-4 MHF aluminum feeder. Rented a walk-behind trencher and had our 60-ft trench dug in 2 hours. Subpanel passed city rough-in and final with zero corrections.",
        keyTakeaway: "Use aluminum MHF (Mobile Home Feeder) wire; it cost $1.80/ft compared to $6.50/ft for copper 2 AWG and works brilliantly."
      },
      {
        author: "Marcus E.",
        location: "Raleigh, NC",
        projectScope: "Woodworking Shop with Dust Collection",
        savingsClaim: "Saved $2,900",
        feedback: "The reminder to remove the green bonding screw saved me from a failed inspection. The inspector specifically tested the neutral busbar with a multimeter to verify it was isolated from ground.",
        keyTakeaway: "Label every single circuit breaker in the panel door clearly on day one; inspectors love clean labeling."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Garage Workshop Subpanel Workflow Hub" initialYesCount={336} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Master Electrician & Building Systems Specialist"
    codeStandard="NEC NFPA 70 (2023/2026 Editions) Articles 210, 225, 250, 310"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/subpanel-neutral-ground-separation-nec" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Subpanel Neutral &amp; Ground Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Why neutrals and grounds must be separated in subpanels per NEC 250.32.</div>
      </a>
      <a href="/calculators/subpanel-sizing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Subpanel Sizing Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate subpanel feeder ampacity, 4-wire sizes, and breaker ratings.</div>
      </a>
      <a href="/guides/conduit-size-for-3-wires" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Conduit Size for 3 Wires Guide →</div>
        <div class="text-xs text-gray-500 mt-1">NEC 40% fill tables for EMT and PVC conduits carrying heavy electrical feeders.</div>
      </a>
    </div>
  </div>

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Floor High-Spot Mapping & 34-1/2\" Benchmark Line",
    description: "Map subfloor variations with an 8-foot level or 360-degree self-leveling laser, find the floor's highest point, and snap a master 34-1/2\" base cabinet benchmark line.",
    calculatorName: "Floor Level & Vinyl Plank Calculator",
    href: "/calculators/vinyl-plank-flooring",
    icon: "📐"
  },
  {
    stepNumber: 2,
    title: "Upper Cabinets & Temporary 1x4 Ledger Board",
    description: "Screw a level temporary 1x4 wooden ledger board at 54\" above finished floor to support upper wall cabinets, driving 3-1/8\" washer-head cabinet screws through hanging rails into studs.",
    calculatorName: "French Cleat & Cabinet Calculator",
    href: "/calculators/french-cleat",
    icon: "🗄️"
  },
  {
    stepNumber: 3,
    title: "Base Cabinet Shimming, Leveling & Scribe Cuts",
    description: "Set the corner base cabinet at the benchmark line, shim low spots level in both directions, scribe end panels to out-of-plumb drywall walls, and fasten to studs.",
    calculatorName: "Baseboard & Shoe Molding Calculator",
    href: "/calculators/baseboard-shoe-molding",
    icon: "🪵"
  },
  {
    stepNumber: 4,
    title: "Face Frame Clamping & Door Hinge Micro-Adjustment",
    description: "Clamp adjacent solid wood face frames flush with Pony face frame clamps, pre-drill and drive 2-1/2\" trim screws behind hinge plates, and tune 3-way European soft-close hinges.",
    calculatorName: "Cabinet Screws & Fasteners Calculator",
    href: "/calculators/deck-screws-hardware",
    icon: "✨"
  }
];
---

<Layout
  title="Kitchen Cabinet Installation Hub — Step-by-Step Carpentry Workflow | CalcForDIY"
  description="Follow a 4-step kitchen cabinet installation workflow: Finding floor high spots, hanging upper cabinets on ledger boards, base cabinet shimming, and face frame clamping."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Kitchen Cabinet Installation Hub", "item": "https://calcfordiy.com/projects/kitchen-cabinet-installation" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Kitchen Cabinet Installation</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>🍳 Architectural Millwork &amp; Cabinetry</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Kitchen Cabinet Installation Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Installing factory semi-custom or RTA kitchen cabinets with professional precision requires accounting for uneven subfloors and out-of-plumb drywall. This master workflow covers NKBA (National Kitchen &amp; Bath Association) standards: high-spot benchmark mapping, upper-first hanging sequencing, face frame clamping, and composite shimming.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">2 Weekends (15-Box Kitchen)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$3,200 – $6,500 (75%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Standard Height</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">34-1/2\" Base (36\" Counter Top)</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Cabinet Installer Bid vs. DIY Fasteners &amp; Laser</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (15-Cabinet Box Full Kitchen Installation)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Professional cabinet installer rate ($150–$250 per box) vs. DIY retail laser level, GRK cabinet screws, shims &amp; face frame clamps.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Fasteners &amp; Tool Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$280 – $420</div>
        <div class="text-[11px] text-slate-400 mt-1">Cross-line laser level, 3-1/8\" GRK screws, composite shims &amp; Pony clamps</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Cabinet Subcontractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$3,200 – $5,400</div>
        <div class="text-[11px] text-slate-400 mt-1">Finish Carpentry Labor 75% • Scribing &amp; Trim Detailing 15% • Hardware 10%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$2,900 to $5,000</strong> in your pocket to spend on quartz countertops or upgraded professional appliances.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute the 4 installation steps to guarantee flat countertop bearing and perfectly aligned door reveals.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Elena Rostova, CBO"
    role="Certified Building Official & Material Takeoff Analyst"
    experience="18+ Years Field Experience"
    avatarBg="bg-emerald-100 text-emerald-800"
    initials="ER"
    title="Why Master Carpenters Always Hang Upper Cabinets First"
    note="Amateurs install base cabinets first because they can set them on the floor easily. But once 24-inch deep base cabinets are installed, you have to lean awkwardly across them on your tiptoes while wrestling heavy 60-pound upper wall cabinets into place! Your belt buckles scratch the new base cabinets, your lower back screams in pain, and you risk dropping an upper box. Master trim carpenters ALWAYS hang the upper wall cabinets first. With the floor completely wide open, you can screw a temporary 1x4 ledger board to the wall studs at 54 inches above the floor. You rest the bottom of each upper cabinet directly on the ledger board, slide it into place effortlessly, and screw it into the studs with zero back strain. Once all uppers are hung and aligned, unscrew the ledger board, patch the screw holes, and slide your base cabinets in underneath."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Kitchen Cabinet Installation"
    mistakes={[
      {
        number: 1,
        title: "Starting Base Cabinets from the Floor's Low Spot",
        costImpact: "$1,800 (Dishwasher Won't Fit Under Countertop)",
        description: "Standard dishwashers require a minimum 34-1/2\" vertical opening under the countertop. If you set your base cabinets at 34-1/2\" at the low end of a floor that rises 3/4 inch, the opening shrinks to 33-3/4\", making dishwasher installation impossible.",
        solution: "Find the HIGHEST spot of the floor along the wall with a laser level, and measure your 34-1/2\" benchmark up from that high spot; shim all lower cabinets up to meet that line."
      },
      {
        number: 2,
        title: "Fastening Cabinets with Standard Bugle-Head Drywall Screws",
        costImpact: "$3,500 (Upper Cabinets Falling Off Wall)",
        description: "Drywall screws are made of brittle hardened steel. When loaded with 200 lbs of heavy ceramic plates and canned goods, the screw heads shear off cleanly.",
        solution: "Use heavy-gauge 3-1/8\" washer-head cabinet screws (such as GRK Fasteners or FastenMaster) engineered with high shear strength."
      },
      {
        number: 3,
        title: "Using Soft Pine Shims Behind Heavy Quartz Base Boxes",
        costImpact: "$1,200 (Cracked Quartz Countertop Seams)",
        description: "Soft wood pine shims compress under the 500 lb dead weight of stone countertops, causing base boxes to settle unevenly and snapping epoxy seams.",
        solution: "Use dense plastic composite shims; composite shims never compress, rot, or split under heavy concentrated stone counter loads."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Kitchen Cabinet Workflow"
    reviews={[
      {
        author: "Darren & Stephanie L.",
        location: "Pittsburgh, PA",
        projectScope: "16-Box RTA Shaker Kitchen Renovation",
        savingsClaim: "Saved $4,500 on Installation",
        feedback: "The 1x4 ledger board trick for the uppers was a lifesaver. My wife and I hung 8 upper cabinets in one Saturday morning without dropping a thing. Finding the floor high spot saved our dishwasher opening—our floor was 1/2 inch out of level across 14 feet.",
        keyTakeaway: "Clamp face frames together with Pony cabinet clamps before driving joining screws; pulls the seam dead flat so joints disappear."
      },
      {
        author: "Anthony M.",
        location: "Phoenix, AZ",
        projectScope: "Modern Kitchen Remodel with Quartz Tops",
        savingsClaim: "Countertop Fabricator Praised Level Base",
        feedback: "Used composite shims and an 8-foot level. The granite template crew told us our base boxes were within 1/16\" across the entire 18-foot run. Zero shimming was needed for our quartz slabs.",
        keyTakeaway: "Pre-drill with a countersink bit when joining face frames through the side hinge pockets so you don't split hardwood face frames."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Kitchen Cabinet Installation Workflow Hub" initialYesCount={379} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Material Takeoff Analyst"
    codeStandard="National Kitchen & Bath Association (NKBA) & AWI Millwork Guidelines"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/finding-high-spot-floor-kitchen-cabinets" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Floor High Spot Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Laser level benchmark mapping, 34-1/2\" datum lines, and dishwasher clearances.</div>
      </a>
      <a href="/calculators/baseboard-shoe-molding" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Baseboard &amp; Shoe Molding Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate toe-kick moldings, shoe base, and scribe trim for cabinets.</div>
      </a>
      <a href="/projects/kitchen-tile-backsplash" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Kitchen Tile Backsplash Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Follow the 4-step workflow: countertop prep, subway tile layout, and grout.</div>
      </a>
    </div>
  </div>

</Layout>

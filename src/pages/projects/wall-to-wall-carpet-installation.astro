---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Subfloor Preparation & Perimeter Tackless Strip Nailing",
    description: "Vacuum subfloor to zero grit and secure loose plywood panels with 2-inch screws to eliminate squeaks. Nail architectural tackless strips around the entire perimeter, leaving a strict 1/2-inch 'gully' gap from baseboards with pins angled toward the wall.",
    calculatorName: "Subfloor Plywood & Screw Calculator",
    href: "/calculators/subfloor",
    icon: "🔨"
  },
  {
    stepNumber: 2,
    title: "High-Density Rebond Cushion Cutting & Staple Securing",
    description: "Lay 7/16-inch, 8-lb/cu ft high-density rebond padding with the vapor-barrier skin facing upward. Trim flush with the inside edge of tackless strips (never overlapping the pins). Staple seams every 6 inches and seal pad joints with 2-inch wide moisture barrier duct tape.",
    calculatorName: "Floor Underlayment & Padding Calculator",
    href: "/calculators/underlayment",
    icon: "🧽"
  },
  {
    stepNumber: 3,
    title: "Hot-Melt Seam Iron Joining & Edge Trimming",
    description: "Align carpet breadths ensuring pile direction flows toward the room entrance. Using a carpet row-finder, cut the backing cleanly without slicing pile tufts. Center 4-inch thermoplastic seaming tape underneath, glide an electric seaming iron at 2 to 3 feet per minute, and press immediately with a weighted tractor roller.",
    calculatorName: "Carpet Square Footage & Roll Calculator",
    href: "/calculators/carpet",
    icon: "⚡"
  },
  {
    stepNumber: 4,
    title: "Mechanical Power Stretching & Wall Gully Tucking",
    description: "Never rely solely on a knee-kicker. Anchor the base of a mechanical carpet power-stretcher against the back wall, lock the head onto the carpet pins, and pull a minimum 1.5% drum tension toward opposite walls. Hook carpet securely onto pins, trim excess with a wall trimmer, and tuck edge neatly into the gully with a stair chisel.",
    calculatorName: "Carpet Area & Material Takeoff Calculator",
    href: "/calculators/carpet",
    icon: "📐"
  }
];
---

<Layout
  title="Wall-to-Wall Carpet Installation Hub — Step-by-Step | CalcForDIY"
  description="Master guide for installing wall-to-wall carpet: tackless strip perimeter, 8 lb rebond padding, hot-melt seaming, mechanical power stretching, and edge tucking."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Carpet Installation Hub", "item": "https://calcfordiy.com/projects/wall-to-wall-carpet-installation" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Install Wall-to-Wall Carpet with a Power Stretcher",
    "description": "Professional workflow for installing residential stretch-in carpet over rebond cushion using CRI Standard 105 specifications.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Tackless Strip Perimeter Nailing",
        "text": "Nail tackless strips around room edges leaving a 1/2-inch gully from baseboards."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "8-lb Rebond Cushion Installation",
        "text": "Lay dense 7/16-inch rebond cushion, trim flush to strips, and staple edges securely."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Hot-Melt Iron Seaming",
        "text": "Row-cut carpet backing, center seaming tape, run electric iron, and roll with seam tractor."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Power Stretching & Gully Tucking",
        "text": "Engage mechanical power stretcher, tension 1.5%, hook onto pins, and tuck into gully."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Wall-to-Wall Carpet Hub</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-gradient-to-br from-slate-900 via-stone-900 to-slate-900 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xl not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold mb-4 border border-amber-400/30">
      <span>🧶 Flooring Installation Standards</span>
      <span>•</span>
      <span>CRI Standard 105 &amp; ASTM F2170 Compliant</span>
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4 text-white">
      Wall-to-Wall Carpet &amp; Rebond Cushion Installation Hub
    </h1>

    <p class="text-slate-300 text-base sm:text-lg max-w-3xl leading-relaxed mb-6">
      Installing wall-to-wall carpet like a trade professional requires more than swinging a knee kicker. By setting precise 1/2-inch perimeter tackless gullies, hot-melt seaming with pile row alignment, and pulling true tension with a mechanical power-stretcher, you eliminate ripples, ripples in summer humidity, and premature wear.
    </p>

    <!-- Visual Job-Site Photography -->
    <div class="mb-6">
      <img
        src="/images/projects/wall-to-wall-carpet-installation.jpg"
        alt="Carpet power stretcher anchored in bedroom stretching carpet over tackless strips and rebond pad"
        class="w-full h-56 sm:h-72 md:h-84 lg:h-96 object-cover rounded-xl shadow-md border border-slate-700/80"
        loading="eager"
      />
      <p class="text-xs text-slate-400 mt-2 italic text-center sm:text-left">
        Job-site installation: Mechanical power stretcher with extension poles tensioning textured cut-pile carpet over 8-lb rebond cushion and tackless strips.
      </p>
    </div>

    <!-- Contractor Cost vs DIY Savings Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-700/80">
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">Turnkey Flooring Subcontractor</div>
        <div class="text-2xl font-black text-rose-400 mt-1">$2,200 – $3,400</div>
        <div class="text-xs text-slate-400 mt-0.5">3 Bedrooms (650 sq ft with Pad &amp; Tack)</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">DIY Materials &amp; Tool Rental</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$1,100 – $1,550</div>
        <div class="text-xs text-slate-400 mt-0.5">Carpet + 8-lb Pad + Iron + Power Stretcher</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">Estimated DIY Labor Savings</div>
        <div class="text-2xl font-black text-blue-400 mt-1">$1,100 – $1,850</div>
        <div class="text-xs text-slate-400 mt-0.5">Save $1.75–$2.85 per sq ft in Labor</div>
      </div>
    </div>
  </div>

  <!-- Phased Workflow Section -->
  <div class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
      <span>🛠️</span> 4-Phase Carpet Installation Sequence
    </h2>

    <div class="space-y-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 sm:p-6 shadow-xs hover:border-blue-300 transition-all">
          <div class="flex items-start gap-4">
            <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-blue-100 text-blue-700 font-black text-lg shrink-0">
              {step.stepNumber}
            </span>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                {step.title}
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed mb-4">
                {step.description}
              </p>
              <a
                href={step.href}
                class="inline-flex items-center gap-2 text-xs font-semibold text-blue-600 bg-blue-50 px-3 py-1.5 rounded-lg hover:bg-blue-100 transition-colors"
              >
                <span>{step.icon} Open {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Budget Breakdown Table -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-10 not-prose shadow-xs">
    <h2 class="text-xl font-bold text-gray-900 mb-4">
      650 Sq Ft (3 Bedroom) Carpet &amp; Cushion Takeoff
    </h2>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm border-collapse">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50 text-gray-700 font-semibold">
            <th class="p-3">Component / Material</th>
            <th class="p-3">Specification</th>
            <th class="p-3">Quantity</th>
            <th class="p-3">Average DIY Cost</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-gray-600">
          <tr>
            <td class="p-3 font-medium text-gray-900">Heavy Cut-Pile Polyester/Nylon Carpet</td>
            <td class="p-3">45-oz face weight, 12-ft wide rolls with 10% buffer</td>
            <td class="p-3">715 sq ft (80 sq yds)</td>
            <td class="p-3 font-mono">$1,200</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">8-lb High-Density Rebond Padding</td>
            <td class="p-3">7/16" thickness with spill-safe moisture film</td>
            <td class="p-3">650 sq ft</td>
            <td class="p-3 font-mono">$280</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">Architectural Wood Tackless Strips</td>
            <td class="p-3">1-inch wide, dual-row angled pins, ring-shank nails</td>
            <td class="p-3">220 Linear Ft</td>
            <td class="p-3 font-mono">$65</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">Hot-Melt Seaming Tape &amp; Tool Rental</td>
            <td class="p-3">4-inch silicone-backed tape + 24-hr stretcher rental</td>
            <td class="p-3">1 Lot</td>
            <td class="p-3 font-mono">$85</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">Metal Doorway Transition Strips</td>
            <td class="p-3">Anodized aluminum clamp-down / Z-bar</td>
            <td class="p-3">3 Doorways</td>
            <td class="p-3 font-mono">$36</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Elena Rostova, CBO"
    role="Certified Building Official & Architectural Finishes Specialist"
    experience="18+ Years Flooring Inspections"
    avatarBg="bg-emerald-100 text-emerald-800"
    initials="ER"
    title="Why Installing Cushion Over Tackless Strip Pins Causes Premature Wear"
    note="A very common rookie DIY mistake is rolling padding all the way against the baseboard and stapling it over the tackless strip. The sharp steel pins must penetrate directly into the primary latex and woven backing of the carpet, NOT the spongy cushion! Trim your padding with a sharp utility knife exactly flush with the inside edge of the wooden tack strip. The 1/2-inch gap between the tack strip and baseboard is the 'gully' where the trimmed carpet edge is rolled and tucked."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    mistakes={[
      {
        title: "Relying on a Knee-Kicker Alone Instead of a Mechanical Power Stretcher",
        impact: "$1,800 Ruined Carpet Wrinkled After One Summer",
        description: "A knee kicker is designed solely to position carpet onto tack strips, not to tension it. CRI Standard 105 mandates stretching carpet by 1% to 1.5% in both length and width with a power stretcher to prevent permanent wrinkles."
      },
      {
        title: "Cutting Across Carpet Tuft Rows with a Standard Utility Blade",
        impact: "Frayed, Obvious Unsightly Seams and Tuft Pulling",
        description: "Slashing through the top pile cuts yarn tufts in half, creating a bald, fuzzy trench at the seam. Use a cushion-back or loop-pile cutter from the backside, or run a row separator before cutting."
      },
      {
        title: "Selecting Soft 6-lb Padding for High-Traffic Cut-Pile Carpets",
        impact: "Early Carpet Delamination & Crushed Traffic Lanes",
        description: "Soft, thick padding causes carpet backing to flex excessively under foot traffic, breaking the latex bond and causing early matting. Stick to dense 8-lb foam under 7/16-inch thickness."
      }
    ]}
  />

  <!-- Community Reviews -->
  <CommunityReviews
    reviews={[
      {
        name: "Jason & Michelle T.",
        location: "Indianapolis, IN",
        projectScope: "Master Bedroom & Walk-In Closet Carpet Install",
        costSaved: "Saved $1,400",
        feedback: "Renting a power stretcher for $35 at Home Depot made all the difference. We followed the 1/2-inch gully rule and locked the head into the tack strip. The carpet is drum-tight with zero wrinkles."
      },
      {
        name: "Robert M.",
        location: "Columbus, OH",
        projectScope: "Basement Media Room Wall-to-Wall Carpet",
        costSaved: "Saved $1,650",
        feedback: "The seaming tape iron tips were spot on. Moving the iron at 2 to 3 feet per minute gave the hot melt adhesive time to soak into both backings without burning the nylon fibers."
      }
    ]}
  />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Architectural Finishes Specialist"
    codeStandard="CRI (Carpet and Rug Institute) Standard 105 & IRC Section R702-inch
    lastUpdated="September 2026"
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Wall-to-Wall Carpet Hub" initialYesCount={162} />

</Layout>

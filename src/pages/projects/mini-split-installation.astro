---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Mounting Bracket Sizing & 3\" Sloped Wall Coring",
    description: "Anchor the interior head mounting plate into wall studs, and core a 3-inch sleeve hole through exterior siding with a continuous 1/4\" downward slope for gravity condensate drainage.",
    calculatorName: "Mini-Split Heat Pump Calculator",
    href: "/calculators/mini-split-sizing",
    icon: "❄️"
  },
  {
    stepNumber: 2,
    title: "Lineset Routing & 45-Degree Eccentric Flaring",
    description: "Bend insulated copper linesets with internal spring benders, ream burrs with an inner-outer deburring pen, and form 45-degree SAE flares using an eccentric cone flaring tool with Nylog Blue oil.",
    calculatorName: "Pipe Slope Calculator",
    href: "/calculators/pipe-slope",
    icon: "🔧"
  },
  {
    stepNumber: 3,
    title: "500-Micron Vacuum Evacuation & Pressure Decay Test",
    description: "Connect a 2-stage rotary vane vacuum pump and digital micron gauge, pull lineset below 500 microns, valve off, and verify the vacuum holds below 1,000 microns for 15 minutes.",
    calculatorName: "Mini-Split Heat Pump Calculator",
    href: "/calculators/mini-split-sizing",
    icon: "⏱️"
  },
  {
    stepNumber: 4,
    title: "240V Disconnect Box, Whip & Refrigerant Release",
    description: "Wire a 15A or 20A 240V non-fused exterior disconnect with surge protector to the outdoor condenser, torque king service valves open with hex keys, and verify delta-T cooling temperatures.",
    calculatorName: "Subpanel Sizing Calculator",
    href: "/calculators/subpanel-sizing",
    icon: "⚡"
  }
];
---

<Layout
  title="Ductless Mini-Split Installation Hub — Step-by-Step HVAC Workflow | CalcForDIY"
  description="Follow a 4-step ductless mini-split heat pump installation workflow: Wall bracket mounting, copper flaring, 500-micron vacuum evacuation, and 240V disconnect wiring."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Mini-Split Installation Hub", "item": "https://calcfordiy.com/projects/mini-split-installation" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Mini-Split Installation</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>❄️ High-Efficiency HVAC &amp; Heat Pumps</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Ductless Mini-Split Heat Pump Installation Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Ductless inverter mini-split heat pumps achieve unmatched 20+ SEER2 cooling and sub-zero hyper-heating without expensive ductwork. This master workflow covers EPA Section 608 and NEC Article 440 standards: BTU heat load sizing, eccentric cone copper flaring, 500-micron deep vacuum degassing, and 240V outdoor disconnect wiring.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">1 Day (Single-Zone System)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$2,800 – $4,500 (70%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Industry Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">EPA Section 608 &amp; NEC Article 440</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 HVAC Contractor Bid vs. DIY Equipment Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (12,000 BTU Single-Zone 22 SEER2 System)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Licensed HVAC contractor turn-key installation ($3,800–$6,500) vs. DIY retail mini-split kit, lineset, vacuum pump &amp; disconnect box.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Equipment &amp; Tool Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$1,150 – $1,650</div>
        <div class="text-[11px] text-slate-400 mt-1">12k BTU Senville/MrCool unit, 25 ft lineset, vacuum pump &amp; torque wrench</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Licensed HVAC Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$4,200 – $6,200</div>
        <div class="text-[11px] text-slate-400 mt-1">Specialized HVAC Labor 65% • Company Overhead &amp; Permit 15% • Equipment 20%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$3,050 to $4,550</strong> in your pocket while pulling a true 500-micron vacuum to ensure 15+ years of compressor life.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Follow the 4 steps in exact order to prevent costly refrigerant leaks and premature compressor burnout.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Marcus Vance"
    role="Master Systems & MEP Building Specialist"
    experience="22+ Years Field Experience"
    avatarBg="bg-amber-100 text-amber-800"
    initials="MV"
    title="Why Factory Pre-Made Copper Flares Fail 80% of the Time"
    note="Most mini-split brands ship with a 16-foot or 25-foot rolled copper lineset that comes with factory flare nuts already formed on both ends. DIYers connect them directly and tighten down. Two weeks later, all the R410A refrigerant has leaked out, and the compressor shuts down with an E7 error code! Factory flares are machine-pressed in bulk overseas; they are notoriously thin, frequently out-of-round, and have sharp micro-burrs along the rim. The first rule of professional mini-split installation: Cut off the factory flares with a mini tubing cutter, deburr the copper with an inner-outer reamer held facing downward so copper shavings don't fall inside the tube, slide your brass nut on, and press a fresh, mirror-smooth flare using an eccentric cone flaring tool (like Yellow Jacket or Hilmor). Put a drop of Nylog Blue refrigerant oil on the flare face, and torque to exact manufacturer foot-pound specs with a digital torque wrench."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Mini-Split Installation"
    mistakes={[
      {
        number: 1,
        title: "Relying on Analog Pressure Gauges Instead of a Micron Gauge",
        costImpact: "$1,800 (Burned-Out Inverter Compressor)",
        description: "An analog manifold gauge needle only reads down to -30 inHg (rough vacuum). It cannot measure whether water vapor molecules have boiled off from inside the copper.",
        solution: "Use a dedicated digital electronic micron gauge; you must pull the lineset down to at least 500 microns (0.5 Torr) to boil out all trapped humidity."
      },
      {
        number: 2,
        title: "Drilling the 3-Inch Wall Hole Level or Sloping Inward",
        costImpact: "$1,400 (Condensate Water Flooding Drywall & Mold)",
        description: "Air conditioning condenses up to a gallon of water per hour. If the through-wall drain hole is level or pitches backward, water pools behind the indoor wall unit.",
        solution: "Always angle your hole saw drill downward at a noticeable 1/4-inch to 1/2-inch drop from inside to outside so condensate drains freely by gravity."
      },
      {
        number: 3,
        title: "Omitting a 240V Outdoor HVAC Surge Protector",
        costImpact: "$950 (Fried Inverter PCB Motherboard)",
        description: "Variable-speed DC inverter mini-splits are computerized appliances. Nearby lightning strikes and utility grid surges fry the $600 outdoor main control board.",
        solution: "Install a dedicated HVAC surge protective device (like an Intermatic AG3000) directly inside the outdoor disconnect box."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Mini-Split Installation Workflow"
    reviews={[
      {
        author: "Nate & Alicia K.",
        location: "Spokane, WA",
        projectScope: "Garage Workshop 18,000 BTU Mini-Split",
        savingsClaim: "Saved $3,400 vs HVAC Quote",
        feedback: "Bought an eccentric flaring tool and digital micron gauge on Amazon. Cut off the factory flares, used Nylog Blue, and torqued to 35 ft-lbs with a digital torque wrench. Pulled vacuum down to 280 microns and it held for 30 minutes. Unit runs whisper-quiet at 70°F even when it's 15°F outside.",
        keyTakeaway: "Buy plastic decorative lineset cover channel (Slimduct); protects your foam lineset insulation from UV rot and lawnmowers."
      },
      {
        author: "Victor M.",
        location: "Tampa, FL",
        projectScope: "Bonus Room 12k Heat Pump Addition",
        savingsClaim: "Zero Leaks on Nitrogen Test",
        feedback: "The downward wall hole advice saved me—our drywall stayed bone dry all summer. The 240V disconnect box wiring took less than an hour from our subpanel.",
        keyTakeaway: "Use rubber anti-vibration isolation mounting pads under the outdoor condenser feet to prevent humming resonance through exterior siding."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Mini-Split Installation Workflow Hub" initialYesCount={363} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Master Systems & MEP Building Specialist"
    codeStandard="EPA Clean Air Act Section 608 & NEC NFPA 70 Article 440"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/mini-split-vacuum-micron-gauge" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Vacuum Micron Gauge Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Why 500 microns is mandatory, water vapor boiling physics, and vacuum decay tests.</div>
      </a>
      <a href="/calculators/mini-split-sizing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Mini-Split Sizing Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate room square footage, ceiling heights, solar heat gain, and BTU requirements.</div>
      </a>
      <a href="/projects/garage-workshop-finishing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Workshop Finishing Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Complete workshop workflow: insulation, subpanel wiring, and climate control.</div>
      </a>
    </div>
  </div>

</Layout>

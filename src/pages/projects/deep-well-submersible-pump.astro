---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Well Pump HP & Total Dynamic Head (TDH)",
    description: "Calculate required pump horsepower (1/2 HP, 3/4 HP, 1 HP, 1.5 HP) based on pumping water depth, service pressure (40/60 PSI), and friction head.",
    calculatorName: "Submersible Well Pump Calculator",
    href: "/calculators/submersible-well-pump",
    icon: "🚰"
  },
  {
    stepNumber: 2,
    title: "Submersible Drop Wire Gauge (AWG)",
    description: "Determine heavy-gauge twisted submersible copper wire (12, 10, or 8 AWG) to ensure less than 3% voltage drop over 150 to 400-foot well depths.",
    calculatorName: "Well Pump Wire Gauge Calculator",
    href: "/calculators/submersible-well-pump",
    icon: "⚡"
  },
  {
    stepNumber: 3,
    title: "Pressure Tank Sizing & Drawdown Yield",
    description: "Calculate minimum bladder pressure tank gallon volume (32 to 86 gallons) to ensure at least 1-minute pump motor run time per cycle.",
    calculatorName: "Water Heater & Plumbing Volume",
    href: "/calculators/tankless-water-heater",
    icon: "🛢️"
  },
  {
    stepNumber: 4,
    title: "Discharge Trenching & Frost-Line Pipe Slope",
    description: "Calculate trench excavation cubic yards and minimum 1/4\" slope for 1\" to 1-1/4\" poly pipe buried below your local winter frost line.",
    calculatorName: "Pipe Slope & Trench Calculator",
    href: "/calculators/pipe-slope",
    icon: "⛏️"
  }
];
---

<Layout
  title="Deep Well Submersible Pump Hub — Step-by-Step Replacement Workflow | CalcForDIY"
  description="Follow a 4-step submersible well pump replacement workflow: Total dynamic head math, pump horsepower, drop cable gauge, and bladder pressure tank sizing."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Deep Well Submersible Pump Hub", "item": "https://calcfordiy.com/projects/deep-well-submersible-pump" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Size and Install a Deep Well Submersible Pump System",
    "description": "A 4-step hydraulic and electrical workflow for calculating well pump horsepower, drop cable wire gauge, pressure tank drawdown, and burial depth.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Total Dynamic Head Calculation",
        "text": "Add pumping water level lift, system pressure head (1 PSI = 2.31 ft), and pipe friction losses."
      },
      {
        "@type": "HowToStep",
        "name": "Drop Wire Gauge Sizing",
        "text": "Calculate AWG copper conductor size under NEC 3% voltage drop standards for deep well runs."
      },
      {
        "@type": "HowToStep",
        "name": "Pressure Tank Volume",
        "text": "Calculate bladder tank drawdown capacity based on pump GPM flow rate to prevent motor short-cycling."
      },
      {
        "@type": "HowToStep",
        "name": "Trenching & Pitless Adapter",
        "text": "Excavate supply lines below regional frost line depths to pitless adapter casing fittings."
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span>Well Pump Workflow</span>
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-sky-50 border border-sky-200 rounded-full text-sky-800 text-xs font-semibold mb-3">
      <span>🚰 Private Well Water System</span>
      <span>•</span>
      <span>4 Integrated Calculators</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Deep Well Submersible Pump &amp; Pressure Tank Hub</h1>
    <p class="text-lg text-gray-600 max-w-3xl">
      A reliable residential water supply depends on matching pump horsepower to well depth and protecting the motor from voltage drop. Follow this 4-step engineering workflow to calculate your complete well system takeoffs.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-400 transition-all">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <span class="w-9 h-9 rounded-full bg-sky-100 text-sky-800 font-bold flex items-center justify-center text-sm shrink-0 mt-0.5">
              {step.stepNumber}
            </span>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-lg">{step.icon}</span>
                <h2 class="text-lg font-bold text-gray-900">{step.title}</h2>
              </div>
              <p class="text-sm text-gray-600 max-w-2xl leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
          <a
            href={step.href}
            class="shrink-0 w-full md:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm rounded-lg transition-colors shadow-2xs"
          >
            <span>{step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      </div>
    ))}
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8 mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Well System Design Principles</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-700">
      <div>
        <h3 class="font-bold text-gray-900 mb-2">1. Preventing Motor Short Cycling</h3>
        <p class="leading-relaxed">
          Submersible pump motors generate intense heat during startup. Starting more than 20 to 25 times per hour will destroy motor windings. Bladder pressure tanks must be large enough to provide at least 60 seconds of run time per pump cycle.
        </p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-2">2. Drop Wire Voltage Drop Limits</h3>
        <p class="leading-relaxed">
          Because well pumps are submerged 100 to 400 feet underground and often hundreds of feet from the breaker box, undersized wire causes voltage to drop below motor operational tolerances, tripping thermal overloads and causing premature failure.
        </p>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-8">
    <h3 class="text-base font-bold text-gray-900 mb-4">Related Building Workflows &amp; Guides</h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a href="/calculators/submersible-well-pump" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-blue-600 mb-1">INTERACTIVE TOOL</div>
        <div class="font-bold text-gray-900 text-sm">Well Pump &amp; Wire Calculator</div>
        <p class="text-xs text-gray-500 mt-1">Interactive sizing with well casing cross-section SVG.</p>
      </a>
      <a href="/projects/whole-home-generator" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-blue-600 mb-1">EMERGENCY POWER</div>
        <div class="font-bold text-gray-900 text-sm">Backup Generator Hub</div>
        <p class="text-xs text-gray-500 mt-1">Calculate well pump surge watts for generator backup.</p>
      </a>
      <a href="/guides/how-to-calculate-voltage-drop-for-wire-runs" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-emerald-600 mb-1">TRADE GUIDE</div>
        <div class="font-bold text-gray-900 text-sm">Voltage Drop Math Guide</div>
        <p class="text-xs text-gray-500 mt-1">NEC 3% voltage drop formula and circular mil math.</p>
      </a>
    </div>
  </div>

</Layout>

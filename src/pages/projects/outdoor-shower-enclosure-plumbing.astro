---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Cedar Post Framing & Slatted Privacy Enclosure",
    description: "Anchor 4x4 or 6x6 Western red cedar posts in concrete piers with standoff brackets, and fasten horizontal 1x4 cedar slats spaced 1/2\" apart for airflow and privacy.",
    calculatorName: "Pergola & Timber Lumber Calculator",
    href: "/calculators/pergola-lumber",
    icon: "🪵"
  },
  {
    stepNumber: 2,
    title: "Washed Pea Gravel Drywell Sump & Cedar Duckboard",
    description: "Excavate an 18-inch deep by 4x4-foot drywell sump pit beneath the shower floor, line with non-woven geotextile fabric, fill with washed river stone, and top with a removable teak or cedar duckboard grate.",
    calculatorName: "Gravel & Crushed Stone Calculator",
    href: "/calculators/gravel-driveway",
    icon: "🪨"
  },
  {
    stepNumber: 3,
    title: "PEX-A Water Supply & Gravity-Pitched Pipe Runs",
    description: "Tap into interior 3/4\" hot and cold water mains, run flexible PEX-A through exterior wall penetrations with a continuous downward slope of 1/4\" per foot toward low-point interior drain valves.",
    calculatorName: "French Drain & Pipe Calculator",
    href: "/calculators/french-drain",
    icon: "🚰"
  },
  {
    stepNumber: 4,
    title: "Stop-and-Waste Drain Valves & Marine-Grade Fixtures",
    description: "Install quarter-turn indoor shutoffs with bleeder stop-and-waste valves inside the heated basement, and mount a 316 marine-grade stainless steel exposed shower tower with foot wash spout.",
    calculatorName: "Tankless Water Heater Calculator",
    href: "/calculators/tankless-water-heater",
    icon: "🚿"
  }
];
---

<Layout
  title="Outdoor Shower Enclosure & Plumbing Hub — Step-by-Step DIY Workflow | CalcForDIY"
  description="Follow a 4-step outdoor shower installation workflow: Cedar slat privacy enclosures, gravel drywell sumps, PEX water lines, and winter stop-and-waste drain valves."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Outdoor Shower Enclosure & Plumbing Hub", "item": "https://calcfordiy.com/projects/outdoor-shower-enclosure-plumbing" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Outdoor Shower</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>🏖️ Outdoor Living &amp; Exterior Plumbing</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Outdoor Shower Enclosure &amp; Plumbing Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      An open-air outdoor shower rinses away beach sand, garden dirt, and chlorine while creating a luxury backyard spa experience. This master workflow covers plumbing and carpentry standards: rot-resistant Western red cedar slatting, subsurface gravel drainage sumps, continuous gravity pipe pitch, and bulletproof winter freeze-drain valves.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">1 Weekend (4x4 or 4x6 Stall)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$2,400 – $4,200 (70%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">IPC Section 312 &amp; Local Greywater Codes</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Plumber &amp; Carpenter Bid vs. DIY Material Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (4ft x 5ft Cedar Enclosure + Hot/Cold PEX Supply)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Combined plumbing and landscape carpentry turnkey quote ($3,800–$6,500) vs. DIY retail cedar timbers, PEX-A, 316 stainless fixture &amp; gravel.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Materials &amp; Fixture Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$950 – $1,450</div>
        <div class="text-[11px] text-slate-400 mt-1">Clear cedar lumber, stainless shower panel, PEX-A tubing, valves &amp; washed stone</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Professional Plumbing &amp; Carpentry Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$3,800 – $6,200</div>
        <div class="text-[11px] text-slate-400 mt-1">Licensed Plumber Labor 40% • Custom Carpentry 35% • Materials 25%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$2,850 to $4,750</strong> in your pocket while building a custom spa enclosure that drains dry in 2 minutes for winter.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute the 4 steps to ensure private ventilation, rapid greywater drainage, and zero freeze damage.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Marcus Vance"
    role="Master Systems & MEP Building Specialist"
    experience="22+ Years Field Experience"
    avatarBg="bg-amber-100 text-amber-800"
    initials="MV"
    title="The Hidden Trapped-Water Trap in Outdoor Fixtures"
    note="The #1 cause of ruined outdoor showers is closing the indoor shutoff valve in November, but forgetting that water remains trapped inside the exposed fixture! A standard outdoor shower tower has internal brass mixing cartridges, diverter valves, and hand-held shower wands. Water cannot defy gravity to drain uphill back into the basement! When sub-freezing temperatures arrive, water trapped inside the rigid brass mixing valve expands by 9% into ice, splitting the forged brass valve body clean in half. When you turn the water on in May, high-pressure water sprays out of a cracked valve body inside your wall! The golden rule: You must install interior 'stop-and-waste' ball valves with drain caps. In autumn: 1) Close the main indoor ball valve. 2) Unscrew the tiny knurled brass bleeder drain cap over a bucket. 3) Open both hot and cold handles on the outdoor shower to break the vacuum. 4) Use an air compressor with a rubber blow tip set to 25 PSI to blow any remaining droplets out of the showerhead."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Outdoor Shower Plumbing"
    mistakes={[
      {
        number: 1,
        title: "Draining Greywater Directly onto Topsoil Without a Gravel Sump",
        costImpact: "$1,200 (Muddy Mosquito Breeding Bog & Sinking Posts)",
        description: "A 10-minute shower dumps 25 gallons of soapy warm water. On native lawn soil, this creates a stagnant, odorous mud puddle that rots wooden posts.",
        solution: "Excavate an 18-inch deep pit lined with non-woven geotextile fabric and filled with washed gravel or crushed stone to act as a subsurface soakaway drywell."
      },
      {
        number: 2,
        title: "Using Standard Indoor Chrome-Plated Zinc Fixtures",
        costImpact: "$650 (Pitted, Corroded & Flaking Fixtures in 1 Year)",
        description: "Standard bathroom shower fixtures are made of cheap chrome-plated pot metal (die-cast zinc). Direct UV sunlight, rain, and salty coastal air destroy them in one season.",
        solution: "Install solid 316 marine-grade stainless steel or solid forged raw copper/brass fixtures engineered specifically for outdoor weathering."
      },
      {
        number: 3,
        title: "Running Water Pipes Over Foundation Without Continuous Pitch",
        costImpact: "$850 (Water Trapped in Low Bellies Freezing Solid)",
        description: "Piping that sags or has low dips cannot drain by gravity when the winter shutoff valve is opened.",
        solution: "Fasten PEX or copper pipes with rigid pipe talons maintaining a continuous downward slope of at least 1/4\" per foot toward the indoor drain cap."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Outdoor Shower Workflow"
    reviews={[
      {
        author: "Nate & Brooke H.",
        location: "Cape Cod, MA",
        projectScope: "Cedar Slat Shower with Foot Rinse Station",
        savingsClaim: "Saved $3,400 vs Plumber Bid",
        feedback: "Built our enclosure using 1x4 Western red cedar with 1/2\" gaps. The teak duckboard over 18 inches of washed beach stone drains instantly—zero soap scum or standing water. Marcus's winterization blowout tip kept our brass valve 100% intact through a bitter New England winter.",
        keyTakeaway: "Add an extra low-mounted foot wash faucet; perfect for washing sandy dog paws and muddy boots without turning on the main shower."
      },
      {
        author: "Devon C.",
        location: "Charleston, SC",
        projectScope: "Coastal Backyard Spa Shower",
        savingsClaim: "Solid 316 Stainless Still Looks New",
        feedback: "Living near salt water destroys cheap fixtures fast. Invested $380 in a marine-grade 316 stainless shower tower. After two years in humid coastal sun, there is zero rust or corrosion. Tying into our basement PEX was a breeze.",
        keyTakeaway: "Use stainless steel star-drive deck screws for all cedar slatting to eliminate ugly black tannin rust streaks on the wood."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Outdoor Shower Enclosure & Plumbing Hub" initialYesCount={368} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Master Systems & MEP Building Specialist"
    codeStandard="International Plumbing Code (IPC) Section 312 & EPA Onsite Greywater Guidelines"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/outdoor-shower-winterization-drainage" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Winterization Drainage Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Stop-and-waste valve protocols, compressed air blowout physics, and cartridge care.</div>
      </a>
      <a href="/calculators/pergola-lumber" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Pergola Lumber Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate cedar post counts, slat board linear footage, and fastener requirements.</div>
      </a>
      <a href="/projects/custom-cedar-sauna-build" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Custom Cedar Sauna Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Pair your outdoor shower with a custom cedar Finnish hot-rock sauna retreat.</div>
      </a>
    </div>
  </div>

</Layout>

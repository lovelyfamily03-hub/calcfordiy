---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Post Hole Layout & Frost Depth Digging",
    description: "Layout fence line with batter boards and mason's line, space posts 6 or 8 feet on center, and dig holes to 1/3 post height and minimum 6 inches below local frost line.",
    calculatorName: "Fence Post Concrete Calculator",
    href: "/calculators/concrete-fence-post",
    icon: "🕳️"
  },
  {
    stepNumber: 2,
    title: "Gravel Base & Concrete Collar Pour",
    description: "Pour 4 to 6 inches of crushed drainage gravel into the hole base, set pressure-treated 4x4 or 6x6 posts plumb, brace diagonally, and fill with 50 lb/80 lb fast-setting concrete.",
    calculatorName: "Quikrete Bags Calculator",
    href: "/calculators/quikrete-bags",
    icon: "🧱"
  },
  {
    stepNumber: 3,
    title: "2x4 Horizontal Rails & Gate Framing",
    description: "Install 3 horizontal 2x4 rails (top, middle, bottom) using stainless or ceramic-coated exterior screws, keeping the bottom rail 2 inches above ground grade.",
    calculatorName: "Deck Screws & Fasteners Calculator",
    href: "/calculators/deck-screws-hardware",
    icon: "🔨"
  },
  {
    stepNumber: 4,
    title: "Cedar/PT Pickets & Wind Spacing",
    description: "Calculate and nail 1x6 dog-ear or flat-top pickets using hot-dipped galvanized ring-shank nails. Allow 1/16\" gap for wet lumber shrinkage or board-on-board for 100% privacy.",
    calculatorName: "Fence Pickets Calculator",
    href: "/calculators/fence-pickets",
    icon: "🏡"
  }
];
---

<Layout
  title="Privacy Fence Building Hub — Step-by-Step Construction Workflow | CalcForDIY"
  description="Follow a 4-step wood privacy fence construction workflow: Post hole depth & frost line, concrete footings, 2x4 rails, gate framing, and picket takeoffs."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Privacy Fence Building Hub", "item": "https://calcfordiy.com/projects/privacy-fence-building" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Privacy Fence Building</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-3 border border-emerald-100">
      <span>🪵 Residential Carpentry &amp; Fencing</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Wood Privacy Fence Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Building a 6-foot cedar or pressure-treated privacy fence adds security, pet safety, and property value. This master workflow covers wind load calculations, frost-line footing depths, gravel drainage bottoms, rot-prevention slopes, and fast-setting concrete schedules per ASTM F537 standards.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">2 Weekends (150 LF)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$3,200 – $5,400 (60%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">ASTM F537 &amp; IRC Section R105</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Fence Contractor Bid vs. DIY Material Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (150 Linear Ft Fence)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Contractor turn-key install ($35–$52/LF) vs. DIY retail lumber, concrete &amp; auger rental.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Material &amp; Tool Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$2,100 – $2,700</div>
        <div class="text-[11px] text-slate-400 mt-1">4x4 PT posts, 2x4 rails, cedar pickets, concrete &amp; power auger rental</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Fencing Contractor Turn-Key Quote</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$5,250 – $7,800</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 58% • Equipment 12% • Materials 30%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$3,150 to $5,100</strong> in your pocket while guaranteeing posts are dug to true frost depth.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Follow the 4 structural phases to ensure straight, plumb fence lines that survive 70 MPH gale winds.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="David Miller, PE"
    role="Structural & Civil Engineering Consultant"
    experience="20+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="Why Enveloping Post Bottoms in Concrete Causes Premature Rot"
    note="Amateurs dig a hole, drop the wooden 4x4 post directly onto the dirt floor, and pour concrete all around and under it, creating a concrete 'cup'. When rainwater runs down the face of the post, it pools at the bottom of the cup with nowhere to go. Even UC4A ground-contact treated posts will rot through at the soil line within 7 years if trapped in standing water. Always pour 4 to 6 inches of coarse gravel into the bottom of the hole first, set the post on top of the gravel, and pour the concrete collar around the sides. This leaves the bottom grain of the wood open to drain freely into the gravel sub-base."
  />

  <!-- Costly DIY Mistakes -->
  <CostlyMistakes
    tradeName="Wood Privacy Fence Building"
    mistakes={[
      {
        number: 1,
        title: "Troweling Concrete Collar Concave (Water Basin)",
        costImpact: "$1,600 (Rotten Post Base Failures)",
        description: "Finishing the top of the concrete footing flat or dished below grade channels rainwater directly into the wood post joint, accelerating rot.",
        solution: "Trowel the wet concrete top into a smooth crown sloped downward 1 inch away from the post on all sides, ending 2 inches above finished grade."
      },
      {
        number: 2,
        title: "Using Electro-Galvanized Fasteners with Cedar",
        costImpact: "$1,100 (Black Tannin Weeping Streaks)",
        description: "Cedar contains natural tannic acid that chemically reacts with cheap electro-galvanized (EG) finish nails, causing ugly black weeping stains down every picket.",
        solution: "Use only 304 or 316 stainless steel or hot-dipped galvanized (HDG) ring-shank nails labeled for cedar and ACQ treated lumber."
      },
      {
        number: 3,
        title: "Setting Posts at 24 Inches in Frost Country",
        costImpact: "$2,400 (Wavy, Frost-Jacked Leaning Fence)",
        description: "Setting 6-foot fence posts only 24 inches deep in zones where frost penetrates 36 to 48 inches allows freezing soil to jack posts up 4 inches every winter.",
        solution: "Dig post holes to a depth equal to 1/3 of the total post length (36\" to 42\" for an 8-ft post) and at least 6 inches below your local frost line."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Privacy Fence Building Workflow"
    reviews={[
      {
        author: "Darren & Megan T.",
        location: "Louisville, KY",
        projectScope: "160 LF 6-ft Cedar Dog-Ear Privacy Fence",
        savingsClaim: "Saved $3,800",
        feedback: "Renting a two-person gas auger from Home Depot was the best $95 we spent—drilled 22 holes in 3 hours. The calculator's estimate of two 50 lb Quikrete Fast-Setting bags per hole was exact. Fence survived a 65 MPH storm last spring with zero wobble.",
        keyTakeaway: "Use a string line set 1/4 inch off the edge of the posts rather than touching them; touching posts can push your line out of straight."
      },
      {
        author: "Greg M.",
        location: "Des Moines, IA",
        projectScope: "Backyard Dog Run Fence with Double Gate",
        savingsClaim: "Saved $2,700",
        feedback: "The gravel bottom tip and sloping the concrete collar gave our fence inspector confidence. Added a diagonal 2x4 brace on our 5-ft gate with anti-sag cable kit—gate swings like butter.",
        keyTakeaway: "Pre-soak dry cedar pickets before nailing if it's hot and dry, otherwise they will absorb rain later and buckle against each other."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Privacy Fence Building Workflow Hub" initialYesCount={294} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="ASTM F537 & IRC Section R105 Fencing Standards"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/fence-post-depth-frost-line-rule" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Fence Post Depth &amp; Frost Line Guide →</div>
        <div class="text-xs text-gray-500 mt-1">The 1/3 post length rule and regional frost depth minimums for wind stability.</div>
      </a>
      <a href="/guides/how-many-fence-pickets" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">How Many Fence Pickets Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Compare side-by-side, shadowbox, and board-on-board picket formulas with waste.</div>
      </a>
      <a href="/calculators/concrete-fence-post" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Fence Post Concrete Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate exact 50 lb and 80 lb fast-setting bags for 4x4, 4x6, and 6x6 posts.</div>
      </a>
    </div>
  </div>

</Layout>

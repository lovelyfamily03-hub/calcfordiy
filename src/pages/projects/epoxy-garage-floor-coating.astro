---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Diamond Grinding & Moisture Vapor Testing",
    description: "Mechanically grind concrete with an 18-inch rotary diamond grinder to achieve a CSP-2/CSP-3 rough profile, vacuum dust, and perform an ASTM F1869 calcium chloride moisture test.",
    calculatorName: "Epoxy Floor Coating Calculator",
    href: "/calculators/epoxy-floor",
    icon: "⚙️"
  },
  {
    stepNumber: 2,
    title: "Crack Repair & Deep-Penetrating Moisture Primer",
    description: "Fill control joints and cracks with 100% solids epoxy crack repair gel, and roll a 2-component moisture-mitigating epoxy vapor barrier primer at 200 sq ft/gal.",
    calculatorName: "Concrete Slab Calculator",
    href: "/calculators/concrete-slab",
    icon: "🧪"
  },
  {
    stepNumber: 3,
    title: "100% Solids Basecoat & Full Color Flake Broadcast",
    description: "Mix pigmented 100% solids industrial epoxy with a spiral drill mixer, squeegee and back-roll at 12 mils thickness, and broadcast decorative vinyl color chips to full rejection.",
    calculatorName: "Epoxy Floor Coating Calculator",
    href: "/calculators/epoxy-floor",
    icon: "🎨"
  },
  {
    stepNumber: 4,
    title: "Scrape, Reclaim & Clear Polyaspartic Topcoat",
    description: "Scrape excess flake with flat floor scrapers, vacuum loose chips, and roll a high-solids chemical-resistant clear polyaspartic topcoat with aluminum oxide anti-slip aggregate.",
    calculatorName: "Paint & Sealer Calculator",
    href: "/calculators/paint-room",
    icon: "✨"
  }
];
---

<Layout
  title="Epoxy Garage Floor Coating Hub — Step-by-Step Flooring Workflow | CalcForDIY"
  description="Follow a 4-step commercial epoxy garage floor coating workflow: Diamond grinding, moisture vapor testing, 100% solids basecoat, color flakes, and polyaspartic topcoat."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Epoxy Garage Floor Coating Hub", "item": "https://calcfordiy.com/projects/epoxy-garage-floor-coating" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Epoxy Garage Floor</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-3 border border-emerald-100">
      <span>🚗 Garage Transformation &amp; Resinous Floors</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      100% Solids Epoxy Garage Floor Coating Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Transforming a stained concrete slab into a showroom-quality epoxy floor requires proper chemical prep. This master workflow shows you why DIY water-based paint kits peel under hot car tires, and guides you through commercial standards: mechanical diamond grinding, moisture vapor testing (ASTM F1869), full-broadcast vinyl flakes, and chemical-resistant polyaspartic topcoats.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">1 Weekend (2-Car Garage)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$2,600 – $4,200 (70%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">ICRI CSP-2 Profile &amp; ASTM F1869</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Commercial Epoxy Contractor Bid vs. DIY Materials</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (500 Sq Ft 2-Car Garage)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Professional commercial coating company ($6.50–$9.50/sq ft) vs. DIY retail 100% solids epoxy kit, flakes &amp; grinder rental.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Materials &amp; Grinder Rental</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$1,150 – $1,550</div>
        <div class="text-[11px] text-slate-400 mt-1">100% solids base, 50 lbs flake, polyaspartic topcoat &amp; diamond grinder rental</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Commercial Coating Franchise Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$3,750 – $5,200</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 65% • Vacuum Trailer Equipment 15% • Materials 20%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$2,600 to $3,650</strong> in your pocket while installing true 100% solids commercial grade epoxy instead of water-based box store paint.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Never apply epoxy without mechanical diamond profiling and moisture testing.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Elena Rostova, CBO"
    role="Certified Building Official & Material Takeoff Analyst"
    experience="18+ Years Field Experience"
    avatarBg="bg-emerald-100 text-emerald-800"
    initials="ER"
    title="Why Acid Etching Causes 90% of Epoxy Failures (Hot Tire Pickup)"
    note="Big-box DIY epoxy kits include a little plastic packet of citric or muriatic acid powder. The instructions say to dissolve it in water, sprinkle it with a watering can, and rinse with a hose. Never do this on a smooth power-troweled garage slab! Acid etching only cleans surface dirt—it does NOT open the tightly sealed crystalline pores of machine-finished concrete. Furthermore, acid washing introduces gallons of water deep into the concrete slab. If you paint epoxy over that damp concrete, moisture vapor transmission (MVT) will push the coating off in blisters the very first time you park a hot car tire on it (hot tire pickup). The only professional method is dry mechanical diamond grinding with an 80 lb floor grinder and HEPA dust extractor. Diamond grinding scratches the surface to an 80-grit sandpaper profile (ICRI CSP-2), allowing liquid epoxy to anchor mechanically into the concrete pores."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Epoxy Garage Floor Coating"
    mistakes={[
      {
        number: 1,
        title: "Applying Over High-Moisture Concrete (> 3 lbs MVT)",
        costImpact: "$2,800 (Widespread Blistering & Delamination)",
        description: "Groundwater beneath basement or garage slabs evaporates upward through the porous concrete. If vapor pressure exceeds 3 lbs / 1,000 sq ft / 24 hours, it will blow regular epoxy off the floor.",
        solution: "Perform an ASTM F1869 calcium chloride moisture test. If moisture exceeds 3 lbs, apply a specialized moisture-blocking epoxy primer (like Mapei Planiseal MVR) rated up to 25 lbs."
      },
      {
        number: 2,
        title: "Using Standard Clear Epoxy as a Topcoat in Sunlight",
        costImpact: "$1,600 (Ugly Amber UV Yellowing)",
        description: "Standard epoxy resins have zero UV resistance. Sunlight coming through open garage doors causes clear epoxy topcoats to turn yellow and chalky within 12 months.",
        solution: "Always apply a clear 2-part polyaspartic or aliphatic polyurethane topcoat over your epoxy and flake; polyaspartic is 100% UV-stable and 4x more scratch-resistant."
      },
      {
        number: 3,
        title: "Letting Mixed Epoxy Sit in the Mixing Bucket",
        costImpact: "$650 (Exothermic Flash Cure & Smokin' Bucket)",
        description: "100% solids epoxy cures through an exothermic reaction. Leaving a 3-gallon mix sitting in the bucket traps the heat, causing the resin to boil, smoke, and harden into a solid plastic rock within 15 minutes.",
        solution: "The moment you finish mixing for 3 minutes, immediately pour the entire liquid contents out across the garage floor in ribbons. Once spread thin on cool concrete, pot life expands to 45 minutes."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Epoxy Garage Floor Workflow"
    reviews={[
      {
        author: "Mark & Steve T.",
        location: "Phoenix, AZ",
        projectScope: "3-Car 680 sq ft Garage Coating",
        savingsClaim: "Saved $3,900 vs Pro Franchise",
        feedback: "Rented an Onan diamond grinder from Sunbelt Rentals on a Saturday morning. Took 3 hours to grind our 3-car slab to a 60-grit finish. Ribboning out the epoxy saved us—it gave us plenty of time to roll and broadcast 60 lbs of color flakes. Finished with polyaspartic clear coat. Looks like a luxury car dealership.",
        keyTakeaway: "Wear spiked shoes while broadcasting flakes so you can walk across wet epoxy without leaving footprints."
      },
      {
        author: "Brent K.",
        location: "Madison, WI",
        projectScope: "Workshop Slab with Moisture Primer",
        savingsClaim: "Zero Peeling After 2 Winters",
        feedback: "Did the plastic sheet moisture test and found moisture on our 1980s slab. Used a moisture vapor epoxy primer before the color basecoat. After two Wisconsin winters with road salt and snowy slush, there is zero flaking or tire lift.",
        keyTakeaway: "Broadcast flakes up into the air like you are feeding chickens; let them rain down naturally for an even, non-blotchy pattern."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Epoxy Garage Floor Coating Workflow Hub" initialYesCount={365} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Material Takeoff Analyst"
    codeStandard="ICRI Guideline No. 310.2R (Concrete Surface Profile) & ASTM F1869"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/epoxy-floor-moisture-calcium-chloride-test" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Moisture Testing Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Plastic sheet test vs ASTM F1869 calcium chloride domes to prevent hot tire peeling.</div>
      </a>
      <a href="/calculators/epoxy-floor" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Epoxy Floor Coating Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate basecoat gallons, vapor barrier primer, flake boxes, and clear topcoat.</div>
      </a>
      <a href="/projects/garage-workshop-finishing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Garage Workshop Finishing Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Complete interior overhaul: insulation, subpanel wiring, ceiling drywall, and heat.</div>
      </a>
    </div>
  </div>

</Layout>

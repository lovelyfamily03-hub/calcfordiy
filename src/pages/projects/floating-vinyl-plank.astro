---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Subfloor Flatness & Plywood Deflection",
    description: "Check for 3/16\" flatness over 10 feet. Calculate 3/4\" OSB or plywood sheets to reinforce subfloor deflection before installing click-lock planks.",
    calculatorName: "Subfloor Calculator",
    href: "/calculators/subfloor",
    icon: "🪵"
  },
  {
    stepNumber: 2,
    title: "Acoustic & Moisture Underlayment Membrane",
    description: "Calculate 100 or 200 sq ft rolls of 6-mil polyethylene vapor barrier over concrete slabs, or high-density acoustic EVA foam over wood subfloors.",
    calculatorName: "Underlayment Calculator",
    href: "/calculators/underlayment",
    icon: "🛡️"
  },
  {
    stepNumber: 3,
    title: "Luxury Vinyl Plank (LVP) Carton Takeoff",
    description: "Convert net room square footage into full unopened cartons, applying 10% waste for staggered plank seams and doorway cuts.",
    calculatorName: "Vinyl Plank Flooring Calculator",
    href: "/calculators/vinyl-plank-flooring",
    icon: "📐"
  },
  {
    stepNumber: 4,
    title: "Quarter Round & Shoe Molding Trim",
    description: "Estimate perimeter shoe molding linear footage to conceal the mandatory 1/4\" expansion gap around walls and cabinetry.",
    calculatorName: "Baseboard & Shoe Molding Calculator",
    href: "/calculators/baseboard-shoe-molding",
    icon: "📏"
  }
];
---

<Layout
  title="Floating Vinyl Plank Hub — Step-by-Step LVP Flooring Workflow | CalcForDIY"
  description="Follow a 4-step floating vinyl plank flooring workflow: Subfloor prep, acoustic underlayment rolls, LVP box counts, and perimeter shoe molding."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Floating Vinyl Plank Hub", "item": "https://calcfordiy.com/projects/floating-vinyl-plank" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Install Floating Luxury Vinyl Plank (LVP) Flooring",
    "description": "A 4-step DIY workflow for calculating subfloor prep, underlayment rolls, LVP carton quantities, and perimeter baseboard trim.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Subfloor Assessment",
        "text": "Verify subfloor meets 3/16-inch per 10-foot flatness tolerance and calculate self-leveling or plywood reinforcement."
      },
      {
        "@type": "HowToStep",
        "name": "Vapor Barrier & Underlayment",
        "text": "Calculate moisture barrier rolls with 8-inch overlap on concrete slabs."
      },
      {
        "@type": "HowToStep",
        "name": "LVP Carton Estimating",
        "text": "Determine total carton boxes needed using 10% waste for staggered plank staggering (minimum 8-inch end joint overlap)."
      },
      {
        "@type": "HowToStep",
        "name": "Expansion Gap Trim",
        "text": "Calculate shoe molding linear feet to cover the 1/4-inch thermal expansion perimeter gap."
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span>Floating Vinyl Plank Workflow</span>
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-50 border border-amber-200 rounded-full text-amber-800 text-xs font-semibold mb-3">
      <span>🪵 Resilient Flooring Workflow</span>
      <span>•</span>
      <span>4 Integrated Calculators</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Floating Vinyl Plank (LVP) Renovation Hub</h1>
    <p class="text-lg text-gray-600 max-w-3xl">
      Luxury Vinyl Plank is 100% waterproof and highly durable, but failure to prepare the subfloor or maintain expansion gaps leads to clicking and separated joints. Follow this 4-step workflow for a flawless installation.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-400 transition-all">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <span class="w-9 h-9 rounded-full bg-amber-100 text-amber-800 font-bold flex items-center justify-center text-sm shrink-0 mt-0.5">
              {step.stepNumber}
            </span>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-lg">{step.icon}</span>
                <h2 class="text-lg font-bold text-gray-900">{step.title}</h2>
              </div>
              <p class="text-sm text-gray-600 max-w-2xl leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
          <a
            href={step.href}
            class="shrink-0 w-full md:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm rounded-lg transition-colors shadow-2xs"
          >
            <span>{step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      </div>
    ))}
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8 mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">LVP Installation Rules &amp; Trade Standards</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-700">
      <div>
        <h3 class="font-bold text-gray-900 mb-2">1. Never Double Underlayment</h3>
        <p class="leading-relaxed">
          If your LVP has an attached rubber or cork pad on the underside, do NOT install secondary foam underlayment underneath it. Excessive cushion causes vertical flex under foot traffic, which shears off the delicate click-lock tongue-and-groove milling.
        </p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-2">2. Minimum 8-Inch Stagger Rule</h3>
        <p class="leading-relaxed">
          End joints between adjacent rows must be staggered by at least 8 inches (preferably 12 inches) to create structural interlock. Avoid "H-patterns" or stair-stepping rows by always starting with random offcuts longer than 8 inches.
        </p>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-8">
    <h3 class="text-base font-bold text-gray-900 mb-4">Related Building Workflows &amp; Guides</h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a href="/projects/flooring-installation" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-blue-600 mb-1">FLOORING HUB</div>
        <div class="font-bold text-gray-900 text-sm">Hardwood Flooring Hub</div>
        <p class="text-xs text-gray-500 mt-1">Solid and engineered hardwood installation workflow.</p>
      </a>
      <a href="/guides/how-many-boxes-of-vinyl-plank-flooring" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-emerald-600 mb-1">TRADE GUIDE</div>
        <div class="font-bold text-gray-900 text-sm">How Many Boxes of LVP?</div>
        <p class="text-xs text-gray-500 mt-1">Carton conversions and doorway transition allowances.</p>
      </a>
      <a href="/guides/laminate-flooring-waste-factor" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-emerald-600 mb-1">TRADE GUIDE</div>
        <div class="font-bold text-gray-900 text-sm">Flooring Waste Factor Guide</div>
        <p class="text-xs text-gray-500 mt-1">How room angles dictate 10% vs 15% waste.</p>
      </a>
    </div>
  </div>

</Layout>

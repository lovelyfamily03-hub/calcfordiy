---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Subfloor Recess & Sloped Mortar Bed",
    description: "Calculate dry-pack mortar bags (4:1 sand to cement mix) to create the 1/4\" per foot slope toward the linear drain with zero entrance curb.",
    calculatorName: "Mortar Mix Calculator",
    href: "/calculators/mortar-mix",
    icon: "🥣"
  },
  {
    stepNumber: 2,
    title: "Shower Wall & Pan Tile Takeoffs",
    description: "Calculate large-format porcelain wall tiles, mosaic floor tiles with slip-resistant grip, and niche layout dimensions with 10% waste.",
    calculatorName: "Shower Tile Calculator",
    href: "/calculators/shower-tile",
    icon: "🛁"
  },
  {
    stepNumber: 3,
    title: "Thinset Mortar for Waterproofing & Tile",
    description: "Determine modified vs unmodified thinset mortar bags based on sheet membrane substrate and 1/2\" euro-notch trowels.",
    calculatorName: "Thinset Mortar Calculator",
    href: "/calculators/thinset",
    icon: "🧱"
  },
  {
    stepNumber: 4,
    title: "Stain-Resistant Epoxy or High-Performance Grout",
    description: "Calculate epoxy or urethane grout volume to prevent mold and water penetration in zero-threshold walk-in shower pans.",
    calculatorName: "Grout Calculator",
    href: "/calculators/grout",
    icon: "🧹"
  },
  {
    stepNumber: 5,
    title: "Electric Radiant Floor Heating Cable",
    description: "Calculate heating cable wattage, square footage uncoupling membrane, and thermostat sensor placement for warm shower floors and benches.",
    calculatorName: "Radiant Floor Heating Calculator",
    href: "/calculators/radiant-floor-heating",
    icon: "🔥"
  }
];
---

<Layout
  title="Curbless Walk-in Shower Hub — Step-by-Step Tiling Workflow | CalcForDIY"
  description="Follow a 5-step curbless walk-in shower workflow: Subfloor drop, linear drain mortar slope, large-format tile takeoffs, thinset, and radiant floor heat."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Curbless Walk-in Shower Hub", "item": "https://calcfordiy.com/projects/curbless-walk-in-shower" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Build a Curbless Walk-in Shower with Linear Drain",
    "description": "A 5-step master workflow for calculating sloped mortar beds, wall tile takeoffs, thinset, epoxy grout, and radiant floor heating.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Sloped Pre-Slope Mortar Bed",
        "text": "Calculate dry-pack mortar bags to form a continuous 1/4\" per foot pitch to the linear drain channel."
      },
      {
        "@type": "HowToStep",
        "name": "Tile & Niche Estimating",
        "text": "Calculate wall square footage and non-slip floor mosaic sheets with 10% to 15% TCNA pattern waste."
      },
      {
        "@type": "HowToStep",
        "name": "Thinset Mortar Coverage",
        "text": "Determine mortar bag counts for membrane waterproofing bonding and large format tile back-buttering."
      },
      {
        "@type": "HowToStep",
        "name": "Grout Joint Sizing",
        "text": "Calculate stain-proof epoxy or urethane grout quantities based on joint width."
      },
      {
        "@type": "HowToStep",
        "name": "In-Shower Radiant Heating",
        "text": "Size electric floor heating cable runs and uncoupling membrane sheets."
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span>Curbless Shower Workflow</span>
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-cyan-50 border border-cyan-200 rounded-full text-cyan-800 text-xs font-semibold mb-3">
      <span>🚿 High-End Barrier-Free Bath</span>
      <span>•</span>
      <span>5 Integrated Calculators</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Curbless Walk-in Shower &amp; Linear Drain Workflow</h1>
    <p class="text-lg text-gray-600 max-w-3xl">
      Zero-threshold (curbless) showers require strict slope geometry to keep water contained without a physical barrier. Follow this 5-step workflow to calculate mortar slope, waterproofing, tile format, and heated floor cables.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-400 transition-all">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <span class="w-9 h-9 rounded-full bg-cyan-100 text-cyan-800 font-bold flex items-center justify-center text-sm shrink-0 mt-0.5">
              {step.stepNumber}
            </span>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-lg">{step.icon}</span>
                <h2 class="text-lg font-bold text-gray-900">{step.title}</h2>
              </div>
              <p class="text-sm text-gray-600 max-w-2xl leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
          <a
            href={step.href}
            class="shrink-0 w-full md:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm rounded-lg transition-colors shadow-2xs"
          >
            <span>{step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      </div>
    ))}
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8 mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Curbless Shower Engineering &amp; TCNA Code Rules</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-700">
      <div>
        <h3 class="font-bold text-gray-900 mb-2">1. The 1/4" Per Foot Slope Rule</h3>
        <p class="leading-relaxed">
          TCNA Method B422 requires a minimum pitch of 1/4 inch per foot (2%) from the entrance threshold to the drain. For a 4-foot deep curbless shower, the subfloor at the linear drain must be recessed a full 1 inch below the finished bathroom floor height.
        </p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-2">2. Single-Direction Slope with Linear Drains</h3>
        <p class="leading-relaxed">
          Unlike center round drains which require a 4-way compound slope (funneling), a wall-to-wall linear drain allows a single continuous planar slope. This makes it possible to use large-format porcelain tiles (e.g. 12x24 or 24x48) across the shower floor without diagonal cuts.
        </p>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-8">
    <h3 class="text-base font-bold text-gray-900 mb-4">Related Building Workflows &amp; Guides</h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a href="/projects/bathroom-remodel" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-blue-600 mb-1">PLUMBING &amp; TILE</div>
        <div class="font-bold text-gray-900 text-sm">Standard Bathroom Remodel Hub</div>
        <p class="text-xs text-gray-500 mt-1">Full sequential bathroom takeoff and water heater sizing.</p>
      </a>
      <a href="/guides/how-much-tile-do-i-need-for-a-shower" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-emerald-600 mb-1">TRADE GUIDE</div>
        <div class="font-bold text-gray-900 text-sm">How Much Tile for a Shower?</div>
        <p class="text-xs text-gray-500 mt-1">Calculate wall square footage and waste factors.</p>
      </a>
      <a href="/guides/how-many-bags-of-grout-for-tile-shower" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-emerald-600 mb-1">TRADE GUIDE</div>
        <div class="font-bold text-gray-900 text-sm">Grout Bag Sizing Guide</div>
        <p class="text-xs text-gray-500 mt-1">Coverage rates for sanded, unsanded, and epoxy grouts.</p>
      </a>
    </div>
  </div>

</Layout>

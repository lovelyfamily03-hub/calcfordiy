---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Heat Loss Calculation & Loop Spacing Layout (6\", 9\", or 12\" o.c.)",
    description: "Perform room-by-room BTU heat loss calculations (Manual J). Layout 1/2\" Oxygen-Barrier PEX-a or PEX-AL-PEX tubing in counterflow serpentine or bifilar spiral patterns, maintaining a strict 300-linear-foot maximum length per individual circuit.",
    calculatorName: "Radiant Floor Heating Calculator",
    href: "/calculators/radiant-floor-heating",
    icon: "🔥"
  },
  {
    stepNumber: 2,
    title: "Thermal Transfer Plates, Joist Bay Sleeves or Gypcrete Encapsulation",
    description: "For subfloor retrofit installations, fasten heavy-gauge extruded aluminum heat transfer plates tightly against the plywood underside. For new slabs or gypcrete overpours, staple tubing over 2\" XPS foam insulation boards or tie to rebar mesh.",
    calculatorName: "Subfloor Materials & Fasteners Calculator",
    href: "/calculators/subfloor",
    icon: "🪵"
  },
  {
    stepNumber: 3,
    title: "Stainless Distribution Manifold, Flow Meters & 50 PSI Air Test",
    description: "Mount the stainless supply/return manifold at a central distribution point. Connect PEX loop tail ends with Eurocone compression fittings, pressurize the entire assembly to 50 PSI air pressure for 24 hours, and balance loop flow meters in GPM.",
    calculatorName: "Pipe Slope & Fall Calculator",
    href: "/calculators/pipe-slope",
    icon: "⏱️"
  },
  {
    stepNumber: 4,
    title: "Primary-Secondary Boiler Plumbing, Mixing Valves & Power Purge",
    description: "Plumb closed-loop hydronic circulator pumps with a closely-spaced tee or hydraulic separator. Install a thermostatic mixing valve to deliver 90°F to 125°F supply water, fill with demineralized water or propylene glycol, and purge trapped air bubbles.",
    calculatorName: "Mini-Split BTU & Tonnage Calculator",
    href: "/calculators/mini-split-sizing",
    icon: "⚙️"
  }
];
---

<Layout
  title="Hydronic Radiant Floor Heating PEX Hub — Step-by-Step Workflow | CalcForDIY"
  description="Design and install a hydronic radiant floor heating system: room heat loss calculations, oxygen-barrier PEX loop layout, stainless manifold balancing, and 50 PSI air testing."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Hydronic Radiant Floor Heating Hub", "item": "https://calcfordiy.com/projects/radiant-floor-heating-pex" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Install Hydronic Radiant Floor Heating with PEX Tubing",
    "description": "Professional engineering procedure for designing, piping, pressure testing, and balancing an in-floor hydronic radiant heating system.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Heat Loss Calculation & Loop Planning",
        "text": "Calculate room BTU heat loss and lay out PEX loops with maximum 300 ft length per run at 8-to-12 inch spacing."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Tubing Installation & Heat Transfer Plates",
        "text": "Secure PEX tubing to extruded aluminum transfer plates under subfloors or over XPS foam boards."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Manifold Connection & 50 PSI Pressure Testing",
        "text": "Connect loops to stainless manifold headers and maintain 50 PSI pneumatic test during construction."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Boiler Tie-In, Mixing Valve & Glycol Purge",
        "text": "Plumb primary-secondary pumping loops, set thermostatic mixing valve to 110°F, and power-purge air pockets."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Radiant Floor Heating PEX</span>
  </nav>

  <!-- Hero Section -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold mb-3 border border-amber-100">
      <span>🔥 Hydronic Thermal Comfort &amp; Mechanical Systems</span>
      <span>•</span>
      <span>CSA B214 &amp; RPA Radiant Heating Standards</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Hydronic Radiant Floor Heating PEX Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Hydronic radiant in-floor heating delivers the most luxurious, even, and whisper-quiet warmth in modern home construction. By circulating warm water (90°F to 125°F) through closed-loop oxygen-barrier PEX tubing embedded in slabs or clipped beneath subfloors, radiant heating warms room occupants directly via gentle infrared energy—eliminating drafty vents, allergen distribution, and stratification cold spots.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 mb-6">
      <div>
        <div class="text-xs text-gray-500 font-medium">Max Loop Run</div>
        <div class="text-lg font-bold text-gray-900">300 Linear Feet</div>
        <div class="text-xs text-blue-600">1/2" Oxygen-Barrier PEX</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Supply Water Temp</div>
        <div class="text-lg font-bold text-gray-900">95°F – 120°F</div>
        <div class="text-xs text-emerald-600">High Efficiency Condensing</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Pneumatic Test</div>
        <div class="text-lg font-bold text-gray-900">50 PSI / 24 Hr</div>
        <div class="text-xs text-purple-600">Hold Before Concrete Pour</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">DIY Project Cost</div>
        <div class="text-lg font-bold text-gray-900">$3,400 - $5,800</div>
        <div class="text-xs text-amber-600">1,200 Sq Ft System</div>
      </div>
    </div>

    <!-- RSMeans Contractor vs DIY Comparison -->
    <div class="border border-gray-200 rounded-xl overflow-hidden mb-6">
      <div class="bg-gray-100 px-4 py-2.5 font-semibold text-xs text-gray-700 uppercase tracking-wider">
        Project Cost Benchmark: 1,200 Sq Ft Hydronic In-Slab / Subfloor System
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-gray-200 text-sm">
        <div class="p-4 bg-white">
          <div class="text-xs font-bold text-gray-500 uppercase mb-1">Licensed Hydronic HVAC Contractor</div>
          <div class="text-2xl font-black text-gray-900 mb-2">$14,500 – $22,000</div>
          <ul class="text-xs text-gray-600 space-y-1.5">
            <li>• Engineering heat loss calculation &amp; CAD loop layout: $1,200 – $1,800</li>
            <li>• PEX tubing installation, mesh tying &amp; thermal plates: $4,200 – $6,500</li>
            <li>• Stainless manifold assembly, balancing valves &amp; zone controls: $2,800 – $4,200</li>
            <li>• Boiler tie-in, circulator pumps, mixing valve &amp; startup commissioning: $6,300 – $9,500</li>
          </ul>
        </div>
        <div class="p-4 bg-emerald-50/50">
          <div class="text-xs font-bold text-emerald-800 uppercase mb-1">DIY Self-Performance</div>
          <div class="text-2xl font-black text-emerald-700 mb-2">$3,600 – $6,200</div>
          <ul class="text-xs text-gray-700 space-y-1.5">
            <li>• 1,600 ft 1/2" Oxygen-Barrier PEX-a tubing (4 coils x 400 ft): $880 – $1,350</li>
            <li>• 4-to-6 loop stainless distribution manifold with flow meters: $380 – $650</li>
            <li>• Extruded aluminum heat transfer plates or foam tracks: $950 – $1,600</li>
            <li>• 3-speed ECM hydronic circulator pump, expansion tank &amp; air purger: $620 – $1,100</li>
            <li>• PEX expander/crimp tool, pressure test kit &amp; propylene glycol: $350 – $550</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Step by Step Workflow Cards -->
  <div class="space-y-6 mb-10 not-prose">
    <h2 class="text-2xl font-black text-gray-900 tracking-tight">The 4-Step Radiant Floor Heating Workflow</h2>
    
    <div class="grid grid-cols-1 gap-4">
      {workflowSteps.map((step) => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 hover:border-blue-300 transition-all shadow-xs">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-amber-600 text-white font-bold flex items-center justify-center text-lg shadow-sm">
              {step.stepNumber}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-base font-bold text-gray-900">{step.title}</h3>
                <span class="text-lg">{step.icon}</span>
              </div>
              <p class="text-sm text-gray-600 mb-3 leading-relaxed">{step.description}</p>
              <a
                href={step.href}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 px-3 py-1.5 rounded-md hover:bg-blue-100 transition-colors"
              >
                <span>Calculate Materials: {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Trade Field Note -->
  <FieldNote
    expertName="Marcus Vance"
    role="Master Electrician & MEP Systems Specialist"
    experience="22+ Years Field Experience"
    avatarBg="bg-amber-100 text-amber-800"
    initials="MV"
    title="Why EVOH Oxygen-Barrier PEX is Legally Mandatory for Hydronic Heating"
    note="A catastrophic mistake I see novice renovators make is buying cheap white or blue potable water PEX-b from a home center to run through their radiant floor. Standard potable plumbing PEX is permeable to oxygen molecules at the microscopic level! While microscopic oxygen diffusion does not hurt drinking water, in a closed-loop hydronic heating system, that dissolved oxygen constantly attacks the cast iron impeller of your circulator pump, steel expansion tanks, and the heat exchanger of your boiler. Within 2 to 4 years, iron oxide sludge (black magnetite rust) chokes your manifold flow meters, burns out pump motors, and pinholes expensive boiler heat exchangers. For hydronic heating, code and engineering standards require EVOH Oxygen-Barrier PEX (such as Uponor AquaPEX HePEX or Viega FostaPEX) certified to DIN 4726."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Hydronic Radiant PEX Installation"
    mistakes={[
      {
        number: 1,
        title: "Exceeding 300 Feet on a Single 1/2\" PEX Loop",
        costImpact: "$3,800 (Dead Zones & Total Circuit Redesign)",
        description: "Water experiences severe dynamic friction inside 1/2\" tubing. Running loops longer than 300 linear feet causes excessive pressure drop that standard circulator pumps cannot overcome, leaving room loops cold.",
        solution: "Strictly limit 1/2\" PEX circuits to maximum 250 to 300 feet (including tails to the manifold). Split large rooms into two or three balanced, equal-length loops."
      },
      {
        number: 2,
        title: "Omitting Manifold Balancing on Mismatched Loop Runs",
        costImpact: "$1,600 (One Overheated Room, Two Freezing Rooms)",
        description: "Water is lazy and follows the path of least resistance. If Manifold Loop 1 is 100 feet and Loop 2 is 280 feet, all water rushes through Loop 1, starving Loop 2.",
        solution: "Use a manifold with integrated visual glass flow meters (GPM) and adjust the micro-valves to choke down short loops and force equal flow through longer runs."
      },
      {
        number: 3,
        title: "Releasing Air Pressure Before Pouring Slabs or Screwing Subfloor",
        costImpact: "$8,500 (Concrete Jackhammering or Flooring Tear-Out to Patch Punctures)",
        description: "If an installer punctures a depressurized PEX pipe with a drywall screw or concrete trowel, nobody knows until the finished floor is laid and the boiler is turned on.",
        solution: "Keep the system continuously pressurized to 40 to 50 PSI with an active pressure gauge mounted during the entire concrete pour or subfloor installation. If the needle drops, stop work immediately."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Radiant Heating Workflow"
    reviews={[
      {
        author: "Kurt & Sonja W.",
        location: "Duluth, MN",
        projectScope: "1,400 Sq Ft Basement Slab Radiant Heat",
        savingsClaim: "Saved $11,200 vs HVAC Bid",
        feedback: "Installed 5 loops of 1/2\" Uponor HePEX over 2\" XPS foam insulation. Kept all loops between 260 and 280 feet. We left the manifold under 50 PSI air pressure while the concrete pumpers poured the 4\" slab. Basement maintains a rock-solid 71°F in minus-20°F Minnesota winters.",
        keyTakeaway: "Use a heavy-duty rotary uncoiler tool when pulling PEX—pulling PEX by hand directly from the center of a 500-foot spool creates impossible bird nests and kinks."
      },
      {
        author: "Ray D.",
        location: "Bozeman, MT",
        projectScope: "Subfloor Retrofit with Aluminum Transfer Plates",
        savingsClaim: "Even Heat Under Solid Oak Hardwood",
        feedback: "Stapled extruded aluminum transfer plates into the joist bays from the basement below. Marcus's tip about keeping water temp under 115°F protected our solid hardwood from cupping. The floors feel gently warm, not scorching hot.",
        keyTakeaway: "Insulate underneath the joist bays with R-19 fiberglass or rockwool battens to direct 100% of the radiant heat upward into the living space."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Hydronic Radiant Floor Heating PEX Hub" initialYesCount={378} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Master Electrician & MEP Systems Specialist"
    codeStandard="CSA B214 (Installation Code for Hydronic Heating Systems) & DIN 4726"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Project Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/radiant-heat-manifold-loop-length-balancing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Radiant Manifold Balancing Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Loop friction head loss math, GPM flow rates, Delta-T targets, and loop balancing charts.</div>
      </a>
      <a href="/calculators/radiant-floor-heating" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Radiant Floor Heating Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate square footage, PEX coil footage, loop counts, and spacing requirements.</div>
      </a>
      <a href="/calculators/mini-split-sizing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">BTU &amp; Tonnage Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Determine whole-house heat loss (Manual J) to properly size hydronic heat sources.</div>
      </a>
    </div>
  </div>

</Layout>

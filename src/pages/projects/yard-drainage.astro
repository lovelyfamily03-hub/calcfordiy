---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "French Drain Trench & Gravel Sizing",
    description: "Calculate 3/4\" washed drainage gravel (tons), 4\" perforated pipe, non-woven filter fabric, and dirt excavation.",
    calculatorName: "French Drain Calculator",
    href: "/calculators/french-drain",
    icon: "🌊"
  },
  {
    stepNumber: 2,
    title: "Retaining Wall Blocks & Geogrid",
    description: "Calculate concrete retaining wall blocks, cap blocks, gravel backfill envelope, and geogrid reinforcement layers.",
    calculatorName: "Retaining Wall Calculator",
    href: "/calculators/retaining-wall",
    icon: "🧱"
  },
  {
    stepNumber: 3,
    title: "Paver Base Gravel & Sand Bedding",
    description: "Calculate crushed stone base gravel (in tons) and sharp concrete bedding sand for patio or walkway sub-base.",
    calculatorName: "Paver Base Gravel & Sand Calculator",
    href: "/calculators/paver-base-sand",
    icon: "🪨"
  },
  {
    stepNumber: 4,
    title: "Topsoil & Lawn Regrading",
    description: "Calculate cubic yards of topsoil needed to fill, smooth, and regrade disturbed lawn areas after digging.",
    calculatorName: "Topsoil Calculator",
    href: "/calculators/topsoil",
    icon: "🌱"
  }
];
---

<Layout
  title="Yard Drainage & Grading Hub — Step-by-Step Drainage Workflow | CalcForDIY"
  description="Follow a 4-step yard drainage workflow: French drain trenching, retaining wall blocks, paver sub-base, and topsoil regrading."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Fix Yard Drainage and Landscape Slope",
    "description": "A 4-step DIY workflow for calculating French drain gravel, retaining wall blocks, paver sub-base, and topsoil.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Calculate French Drain Materials", "url": "https://calcfordiy.com/calculators/french-drain" },
      { "@type": "HowToStep", "position": 2, "name": "Calculate Retaining Wall Blocks", "url": "https://calcfordiy.com/calculators/retaining-wall" },
      { "@type": "HowToStep", "position": 3, "name": "Calculate Paver Base and Sand", "url": "https://calcfordiy.com/calculators/paver-base-sand" },
      { "@type": "HowToStep", "position": 4, "name": "Calculate Topsoil Regrading", "url": "https://calcfordiy.com/calculators/topsoil" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Yard Drainage Hub", "item": "https://calcfordiy.com/projects/yard-drainage" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span>Yard Drainage Hub</span>
  </div>

  <div class="mb-8 bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-2">
      <span class="text-3xl">💧</span>
      <h1 class="text-3xl font-bold text-gray-900">Yard Drainage &amp; Grading Hub</h1>
    </div>
    <p class="text-gray-600 text-lg leading-relaxed max-w-3xl">
      Standing water and soil erosion can damage foundations. Follow this 4-step drainage and grading workflow to intercept groundwater, retain slopes, and restore your lawn.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-blue-300 transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="bg-blue-600 text-white font-bold w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-lg shadow-sm">
            {step.stepNumber}
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xl">{step.icon}</span>
              <h2 class="text-xl font-bold text-gray-900">{step.title}</h2>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed max-w-2xl">
              {step.description}
            </p>
          </div>
        </div>

        <a href={step.href} class="shrink-0 w-full md:w-auto bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-5 py-3 rounded-lg border border-blue-200 transition-colors text-sm flex items-center justify-center gap-2">
          Use {step.calculatorName} →
        </a>
      </div>
    ))}
  </div>

</Layout>

---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "EV Level 2 Charger Wiring & Breaker Sizing",
    description: "Determine copper wire gauge (6 AWG vs 4 AWG), 50A/60A double-pole circuit breaker size, conduit size, and voltage drop for EV charger installation.",
    calculatorName: "EV Charger Wiring Calculator",
    href: "/calculators/ev-charger-wiring",
    icon: "⚡"
  },
  {
    stepNumber: 2,
    title: "Garage Workshop & Overhead Lighting Layout",
    description: "Calculate total lumens needed for detailed shop work, fixture count, ceiling grid spacing, and wall clearance per IES lighting standards.",
    calculatorName: "Garage Lighting Calculator",
    href: "/calculators/recessed-lights-garage",
    icon: "💡"
  },
  {
    stepNumber: 3,
    title: "Mini-Split Heat Pump Sizing for Garages",
    description: "Size mini-split BTU cooling/heating capacity (12k, 18k, 24k BTU) by garage square footage, ceiling height, and insulation level.",
    calculatorName: "Mini-Split Sizing Calculator",
    href: "/calculators/mini-split-sizing",
    icon: "❄️"
  },
  {
    stepNumber: 4,
    title: "Workshop Power Load & Circuit Capacity",
    description: "Calculate combined wattage and continuous electrical load percentage for air compressors, table saws, dust collectors, and EV chargers.",
    calculatorName: "Power Load & Circuit Amperage Calculator",
    href: "/calculators/holiday-power-load",
    icon: "🔌"
  }
];
---

<Layout
  title="Garage Workshop & EV Electrical Hub — Step-by-Step Outfitting Workflow | CalcForDIY"
  description="Follow a 4-step garage workshop outfitting workflow: EV Level 2 charger wiring, high-lumen workshop lighting, mini-split HVAC sizing, and circuit breaker power load."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Plan and Calculate Garage Workshop & EV Charger Outfitting",
    "description": "A 4-step DIY workflow for calculating EV charger wire gauge, garage lighting, mini-split HVAC sizing, and electrical circuit capacity.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Size EV Charger Wiring & Breaker", "url": "https://calcfordiy.com/calculators/ev-charger-wiring" },
      { "@type": "HowToStep", "position": 2, "name": "Calculate Workshop Lighting Layout", "url": "https://calcfordiy.com/calculators/recessed-lights-garage" },
      { "@type": "HowToStep", "position": 3, "name": "Size Mini-Split HVAC Unit", "url": "https://calcfordiy.com/calculators/mini-split-sizing" },
      { "@type": "HowToStep", "position": 4, "name": "Calculate Electrical Circuit Load", "url": "https://calcfordiy.com/calculators/holiday-power-load" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Garage & EV Workshop Hub", "item": "https://calcfordiy.com/projects/garage-ev-workshop" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span>Garage &amp; EV Workshop Hub</span>
  </div>

  <div class="mb-8 bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-2">
      <span class="text-3xl">🚗</span>
      <h1 class="text-3xl font-bold text-gray-900">Garage Workshop &amp; EV Electrical Hub</h1>
    </div>
    <p class="text-gray-600 text-lg leading-relaxed max-w-3xl">
      Converting a garage into a dedicated EV charging station or wood/metal workshop requires proper electrical wire sizing, bright task lighting, climate control, and circuit load management. Follow this 4-step workflow to plan your setup safely.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-blue-300 transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="bg-blue-600 text-white font-bold w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-lg shadow-sm">
            {step.stepNumber}
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xl">{step.icon}</span>
              <h2 class="text-xl font-bold text-gray-900">{step.title}</h2>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed max-w-2xl">
              {step.description}
            </p>
          </div>
        </div>

        <a href={step.href} class="shrink-0 w-full md:w-auto bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-5 py-3 rounded-lg border border-blue-200 transition-colors text-sm flex items-center justify-center gap-2">
          Use {step.calculatorName} →
        </a>
      </div>
    ))}
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Garage Electrical &amp; HVAC Code Guidelines</h2>
    <div class="space-y-3 text-sm text-gray-700">
      <p><strong>NEC Continuous Load Rule (80% Rule):</strong> EV chargers are classified as continuous electrical loads. A 48A charger requires a 60A circuit breaker (48A is 80% of 60A).</p>
      <p><strong>Wire Gauge Requirement:</strong> Use 6 AWG THHN copper wire in conduit (or 6/3 NM-B Romex for max 55A / 40A charging) for Level 2 EV chargers.</p>
    </div>
  </div>

</Layout>

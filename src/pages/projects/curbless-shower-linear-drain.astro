---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Subfloor Recessing & Sistering for Zero-Threshold Flush Entry",
    description: "Lower the shower bay subfloor by 3/4 inch to 1-1/2 inches below the bathroom floor. Sister 2x10 joists or install engineered structural web stiffeners, notch or lower blocking, and lay 3/4-inch exterior-grade plywood flush with surrounding subfloor framing.",
    calculatorName: "Subfloor Materials & Fasteners Calculator",
    href: "/calculators/subfloor",
    icon: "🪵"
  },
  {
    stepNumber: 2,
    title: "Linear Drain Channel Placement & 1/4\" Per Foot Single-Plane Slope",
    description: "Anchor the stainless steel linear trench drain flush against the back wet wall or directly along the entrance threshold. Screed a single uni-directional slope of dry pack mortar or high-density EPS foam tray at precisely 1/4 inch per linear foot towards the drain trough.",
    calculatorName: "Pipe Slope & Fall Calculator",
    href: "/calculators/pipe-slope",
    icon: "📐"
  },
  {
    stepNumber: 3,
    title: "Sheet Membrane Waterproofing & Integrated Flange Bonding",
    description: "Apply Schluter-KERDI, Laticrete HYDRO BAN Sheet, or liquid polyurethane membrane across the entire shower floor, climbing 3 inches up adjoining walls and overlapping the linear drain clamping collar with non-modified thinset mortar or manufacturer-certified hybrid adhesive.",
    calculatorName: "Mortar Mix & Sand Calculator",
    href: "/calculators/mortar-mix",
    icon: "🛡️"
  },
  {
    stepNumber: 4,
    title: "Large Format Tile Setting, Grouting & Grate Height Adjustment",
    description: "Set large-format porcelain tile (up to 24x48 inches without compound envelope cuts) using ANSI A118.15 polymer-modified thinset. Adjust the linear drain channel grate height screws flush with finished tile surface, and pack epoxy or urethane grout.",
    calculatorName: "Shower Tile & Grout Coverage Calculator",
    href: "/calculators/shower-tile",
    icon: "🚿"
  }
];
---

<Layout
  title="Curbless Shower Linear Drain Hub — Step-by-Step Workflow | CalcForDIY"
  description="Build a zero-threshold curbless walk-in shower with a stainless linear drain: subfloor joist recessing, 1/4-inch single plane slope, sheet membrane waterproofing, and large-format tile setting."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Curbless Shower Linear Drain Hub", "item": "https://calcfordiy.com/projects/curbless-shower-linear-drain" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Build a Curbless Walk-In Shower with a Linear Drain",
    "description": "Complete step-by-step trade methodology for framing, sloping, waterproofing, and tiling a zero-threshold curbless shower with a linear trench drain.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Subfloor Recessing & Sistering",
        "text": "Sister floor joists and recess 3/4-inch subfloor to create height differential for zero-threshold flush transition."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Linear Drain Channel & Single Slope Screed",
        "text": "Mount the linear drain body and screed mortar bed at 1/4 inch per foot single plane towards the trough."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Sheet Membrane Waterproofing",
        "text": "Bond waterproof sheet membrane to mortar bed and mechanical clamping flange of linear drain body."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Tile Setting & Grate Height Alignment",
        "text": "Install porcelain tile, pack stain-resistant grout, and adjust linear drain grate height screws flush with tile."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Curbless Shower Linear Drain</span>
  </nav>

  <!-- Hero Section -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>🚿 Universal Design &amp; Wet Room Plumbing</span>
      <span>•</span>
      <span>TCNA B422 / ANSI A108.01 Standards</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Curbless Walk-In Shower Linear Drain Workflow Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Eliminating the traditional 4-inch shower curb creates a seamless modern wet room and universal accessibility. By pairing a zero-threshold entry with a stainless steel linear trench drain, you replace the complex four-way conical slope of center drains with a clean, single-plane mono-pitch. This allows you to install unbroken, large-format porcelain slabs without ugly diagonal envelope relief cuts.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 mb-6">
      <div>
        <div class="text-xs text-gray-500 font-medium">Slope Requirement</div>
        <div class="text-lg font-bold text-gray-900">1/4" Per Foot</div>
        <div class="text-xs text-blue-600">Single Direction Plane</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Subfloor Recess</div>
        <div class="text-lg font-bold text-gray-900">1-1/8" to 1-1/2"</div>
        <div class="text-xs text-emerald-600">Flush Zero Transition</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Linear Drain Outflow</div>
        <div class="text-lg font-bold text-gray-900">8.5 - 12 GPM</div>
        <div class="text-xs text-purple-600">2" PVC / ABS Waste Line</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">DIY Project Cost</div>
        <div class="text-lg font-bold text-gray-900">$1,850 - $3,200</div>
        <div class="text-xs text-amber-600">Saves $7,500+ vs Pro</div>
      </div>
    </div>

    <!-- RSMeans Contractor vs DIY Comparison -->
    <div class="border border-gray-200 rounded-xl overflow-hidden mb-6">
      <div class="bg-gray-100 px-4 py-2.5 font-semibold text-xs text-gray-700 uppercase tracking-wider">
        Project Cost Benchmark: Master Bath Curbless Conversion (5 ft x 4 ft Bay)
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-gray-200 text-sm">
        <div class="p-4 bg-white">
          <div class="text-xs font-bold text-gray-500 uppercase mb-1">Licensed Tile Contractor (Turnkey)</div>
          <div class="text-2xl font-black text-gray-900 mb-2">$9,500 – $14,200</div>
          <ul class="text-xs text-gray-600 space-y-1.5">
            <li>• Subfloor joist structural modification &amp; sistering: $1,600 – $2,400</li>
            <li>• Plumbing rough-in &amp; linear drain channel trap assembly: $1,400 – $2,000</li>
            <li>• Mortar bed mud screed &amp; bonded sheet membrane waterproofing: $1,800 – $2,600</li>
            <li>• Large format tile installation, wall waterproofing &amp; epoxy grout: $4,700 – $7,200</li>
          </ul>
        </div>
        <div class="p-4 bg-emerald-50/50">
          <div class="text-xs font-bold text-emerald-800 uppercase mb-1">DIY Self-Performance</div>
          <div class="text-2xl font-black text-emerald-700 mb-2">$2,150 – $3,600</div>
          <ul class="text-xs text-gray-700 space-y-1.5">
            <li>• 304 Stainless linear drain kit (hair strainer &amp; leveling feet): $220 – $480</li>
            <li>• Subfloor recessing lumber (2x10 sisters, 3/4" CDX plywood, structural screws): $180 – $320</li>
            <li>• Dry pack mortar, pre-pitch foam kit, &amp; bonded sheet waterproofing: $380 – $650</li>
            <li>• 12x24 porcelain floor tile, polymer modified thinset &amp; urethane grout: $620 – $1,150</li>
            <li>• Diamond hole saws, tile suction cups &amp; laser level rental: $150 – $250</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Step by Step Workflow Cards -->
  <div class="space-y-6 mb-10 not-prose">
    <h2 class="text-2xl font-black text-gray-900 tracking-tight">The 4-Step Curbless Linear Drain Workflow</h2>
    
    <div class="grid grid-cols-1 gap-4">
      {workflowSteps.map((step) => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 hover:border-blue-300 transition-all shadow-xs">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-blue-600 text-white font-bold flex items-center justify-center text-lg shadow-sm">
              {step.stepNumber}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-base font-bold text-gray-900">{step.title}</h3>
                <span class="text-lg">{step.icon}</span>
              </div>
              <p class="text-sm text-gray-600 mb-3 leading-relaxed">{step.description}</p>
              <a
                href={step.href}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 px-3 py-1.5 rounded-md hover:bg-blue-100 transition-colors"
              >
                <span>Calculate Materials: {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Trade Field Note -->
  <FieldNote
    expertName="Elena Rostova, CBO"
    role="Certified Building Official & Material Takeoff Analyst"
    experience="18+ Years Field Experience"
    avatarBg="bg-emerald-100 text-emerald-800"
    initials="ER"
    title="Why Placing the Linear Drain Against the Back Wall Outperforms Threshold Drains"
    note="When homeowners design a curbless walk-in shower, their first instinct is often to place the linear drain directly across the entrance doorway as a barrier catch. While architecturally clean, this is a major water containment hazard! If hair accumulates in the grate or soapy foam rushes toward the opening faster than the 2-inch waste trap can swallow, water cascades directly onto your bathroom hardwood or drywall. Professional wet-room design dictates placing the linear drain at the REAR wet wall, underneath the showerhead. This slopes the entire floor away from the bathroom, directing 100% of the water energy toward the back wall. Even if the drain slows down, water simply pools safely against the waterproofed rear tiled wall, never threatening the dry threshold."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Curbless Shower Linear Drain Installation"
    mistakes={[
      {
        number: 1,
        title: "Notching Floor Joists Beyond Code Limits (Structural Floor Sag)",
        costImpact: "$4,200 (Engineered Sistering & Jacking Ceiling Below)",
        description: "Cutting 1-1/2 inches deep across the top of 2x10 wood floor joists to lower the shower bay destroys the joist's tensile strength, violating IRC R502.8 and causing structural floor collapse.",
        solution: "Never notch joists without full-length sistering. Sister identical 2x10 lumber along the entire joist span and anchor with structural timber screws, or lower the subfloor ledger between the joists."
      },
      {
        number: 2,
        title: "Skipping Mechanical Clamping Ring Waterproofing at Drain Throat",
        costImpact: "$6,500 (Subfloor Rot & Ruined Ceiling in Lower Level)",
        description: "Applying liquid rubber membrane or sheet Kerdi over the drain body without mechanically clamping it to the linear drain's integrated bonding flange causes water to bypass the pipe under capillary action.",
        solution: "Use manufacturer-certified waterproofing bonding collars with factory-welded fleece, or torque the mechanical clamping ring down evenly to compress the membrane tightly against the drain body."
      },
      {
        number: 3,
        title: "Failing to Waterproof 12 Inches Past the Shower Threshold into Bathroom",
        costImpact: "$2,800 (Buckled Exterior Luxury Vinyl & Rotting Door Base)",
        description: "Terminating the waterproof membrane precisely at the shower glass door line ignores splashing, dripping bath towels, and capillary wicking along tile grout joints.",
        solution: "Extend the bonded waterproofing membrane at least 12 to 24 inches past the glass door enclosure into the main bathroom drying zone, sealing up adjacent baseboard drywall."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Curbless Shower Workflow"
    reviews={[
      {
        author: "Devon & Alyssa K.",
        location: "Seattle, WA",
        projectScope: "60\" x 42\" Master Bath Curbless Wet Room",
        savingsClaim: "Saved $8,400 vs General Contractor",
        feedback: "Lowered our subfloor 1-1/8 inches between sistered 2x10 joists and used Schluter Ditra-Heat paired with Kerdi-Line against the back wall. Screeding a single 1/4\" slope was ten times easier than trying to float a 4-way center drain mud pan. Large 12x24 marble-look tiles laid flat with zero lippage.",
        keyTakeaway: "Use a laser level on a tripod to establish your benchmark height at the bathroom threshold before screeding the shower pan."
      },
      {
        author: "Graham T.",
        location: "Denver, CO",
        projectScope: "Guest Bathroom ADA Universal Curbless Shower",
        savingsClaim: "Zero Threshold Water Escape",
        feedback: "Following Elena's field advice to put the linear drain against the rear wall instead of the doorway made all the difference. Our elderly parents roll straight in with a walker. Water rushes back toward the wall and drains instantly. No water has ever touched the bathroom floor.",
        keyTakeaway: "Buy the linear drain model with height-adjustable leveling feet and an integrated hair catch basket that lifts out with a small hooked key."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Curbless Shower Linear Drain Hub" initialYesCount={342} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Material Takeoff Analyst"
    codeStandard="TCNA Handbook B422 (Curbless Shower), ANSI A108.01 & IRC P2709"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Project Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/linear-drain-slope-single-plane-waterproofing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Linear Drain Waterproofing Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Single-slope screeding physics, subfloor recessing mechanics, and flood testing protocols.</div>
      </a>
      <a href="/calculators/shower-tile" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Shower Tile &amp; Grout Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate porcelain tile counts, square footage, thinset bags, and epoxy grout volumes.</div>
      </a>
      <a href="/calculators/pipe-slope" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Pipe Slope &amp; Fall Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Verify 1/4\" per foot drain fall and waste line velocity according to IPC standards.</div>
      </a>
    </div>
  </div>

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Combustible Framing Clearance & Cement Backer Board Substrate",
    description: "Verify NFPA 211 / IRC R1001 clearances to combustibles (minimum 2\" air space around masonry fireboxes). Strip drywall, install 1/2-inch non-combustible cement backer board (Durock or HardieBacker) taped with alkali-resistant fiberglass mesh and polymer-modified mortar.",
    calculatorName: "Drywall & Cement Board Calculator",
    href: "/calculators/drywall",
    icon: "🪵"
  },
  {
    stepNumber: 2,
    title: "Expanded Metal Lath Fastening & 1/2\" Scratch Coat Application",
    description: "Fasten 2.5 lb/yd² diamond galvanized expanded metal lath with ribbing facing upward, anchoring 1-1/4\" roofing nails or wafer-head screws into studs every 6 inches. Apply a 1/2\" scratch coat of Type S or Type N masonry mortar, scoring horizontal grooves with a notched trowel.",
    calculatorName: "Mortar Mix & Sand Calculator",
    href: "/calculators/mortar-mix",
    icon: "📐"
  },
  {
    stepNumber: 3,
    title: "Stone Veneer Back-Buttering, Level Alignment & Corner Stacking",
    description: "Mix ANSI A118.4 polymer-modified thinset or specialized veneer mortar. Clean and dampen the back of each manufactured stone flat or 90-degree corner unit, back-butter with a 100% full 1/2\" paste layer, and press firmly onto the wall with a twisting motion until mortar squishes from sides.",
    calculatorName: "Thinset & Mortar Coverage Calculator",
    href: "/calculators/thinset",
    icon: "🪨"
  },
  {
    stepNumber: 4,
    title: "Grout Bag Joint Filling, Striking & Raised Hearth Extension",
    description: "Fill joints between stones using a heavy-duty vinyl grout bag filled with colored mortar. Allow joints to achieve thumbprint hardness, strike clean with a wooden dowel or tuck pointer, brush away crumbs, and build a non-combustible 16\" to 20\" hearth extension.",
    calculatorName: "Brick & Masonry Unit Calculator",
    href: "/calculators/brick-calculator",
    icon: "🔥"
  }
];
---

<Layout
  title="Fireplace Stone Veneer & Hearth Hub — Step-by-Step Workflow | CalcForDIY"
  description="Transform your fireplace with manufactured stone veneer: cement board framing prep, 2.5 lb metal lath scratch coat, stone back-buttering, and NFPA 211 hearth codes."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Fireplace Stone Veneer Hub", "item": "https://calcfordiy.com/projects/fireplace-stone-veneer-hearth" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Install Manufactured Stone Veneer on a Fireplace",
    "description": "Professional masonry and fire-safety guide for framing, scratch coating, setting manufactured stone veneer, and building an NFPA 211 compliant hearth.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Substrate & Cement Board Installation",
        "text": "Strip drywall and install non-combustible 1/2-inch cement backer board taped with alkali-resistant mesh."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Metal Lath & Mortar Scratch Coat",
        "text": "Anchor 2.5 lb diamond metal lath and apply a 1/2-inch Type S mortar scratch coat with horizontal grooves."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Corner & Flat Stone Setting",
        "text": "Back-butter manufactured stone units with polymer thinset and press into place starting from corners."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Grout Bagging & Hearth Construction",
        "text": "Pipe mortar into joints, strike when thumbprint hard, and pour an NFPA-compliant non-combustible hearth."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Fireplace Stone Veneer &amp; Hearth</span>
  </nav>

  <!-- Hero Section -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>🔥 Masonry Fireplace &amp; Chimney Safety</span>
      <span>•</span>
      <span>NFPA 211 &amp; IRC Section R1001 Fireplace Standards</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Fireplace Stone Veneer &amp; Hearth Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Upgrading a tired brick or drywall fireplace surround with natural or manufactured stone veneer creates a commanding architectural centerpiece. Because fireboxes generate intense radiant heat exceeding 800°F, fireplace masonry demands strict fire-code compliance: <strong>proper combustible clearances, non-combustible cement board substrates, bonded metal lath scratch coats, and code-mandated hearth extension dimensions</strong>.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 mb-6">
      <div>
        <div class="text-xs text-gray-500 font-medium">Hearth Extension (Front)</div>
        <div class="text-lg font-bold text-gray-900">16" or 20"</div>
        <div class="text-xs text-blue-600">Based on Firebox Opening Area</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Hearth Extension (Sides)</div>
        <div class="text-lg font-bold text-gray-900">8" or 12"</div>
        <div class="text-xs text-emerald-600">NFPA 211 Clearances</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Mortar Shear Strength</div>
        <div class="text-lg font-bold text-gray-900">1,800+ PSI</div>
        <div class="text-xs text-purple-600">Type S High Bond Strength</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">DIY Project Cost</div>
        <div class="text-lg font-bold text-gray-900">$850 - $1,750</div>
        <div class="text-xs text-amber-600">Saves $3,500+ vs Mason</div>
      </div>
    </div>

    <!-- RSMeans Contractor vs DIY Comparison -->
    <div class="border border-gray-200 rounded-xl overflow-hidden mb-6">
      <div class="bg-gray-100 px-4 py-2.5 font-semibold text-xs text-gray-700 uppercase tracking-wider">
        Project Cost Benchmark: 80 Sq Ft Fireplace Face &amp; Raised Hearth Stone Veneer
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-gray-200 text-sm">
        <div class="p-4 bg-white">
          <div class="text-xs font-bold text-gray-500 uppercase mb-1">Licensed Masonry Contractor</div>
          <div class="text-2xl font-black text-gray-900 mb-2">$4,600 – $7,800</div>
          <ul class="text-xs text-gray-600 space-y-1.5">
            <li>• Drywall removal, framing inspection &amp; cement board: $650 – $1,100</li>
            <li>• 2.5 lb diamond lath anchoring &amp; Type S mortar scratch coat: $750 – $1,300</li>
            <li>• Hand-fitting manufactured stone flats, corners &amp; mantel: $2,400 – $4,200</li>
            <li>• Grout bag joint tooling, acid-wash cleaning &amp; raised hearth: $800 – $1,200</li>
          </ul>
        </div>
        <div class="p-4 bg-emerald-50/50">
          <div class="text-xs font-bold text-emerald-800 uppercase mb-1">DIY Self-Performance</div>
          <div class="text-2xl font-black text-emerald-700 mb-2">$920 – $1,850</div>
          <ul class="text-xs text-gray-700 space-y-1.5">
            <li>• 90 sq ft manufactured stone veneer flats &amp; 16 linear ft corners: $550 – $1,100</li>
            <li>• 3 sheets 1/2" Durock cement board &amp; 3 rolls metal lath: $110 – $190</li>
            <li>• 6 bags Type S masonry mortar &amp; ANSI A118.4 polymer thinset: $90 – $160</li>
            <li>• Heavy vinyl grout bag, tuck pointer, mason brush &amp; notched trowel: $50 – $95</li>
            <li>• Cast concrete hearth stone slabs or bluestone caps: $120 – $305</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Editorial Job Site Image -->
  <div class="mb-8 overflow-hidden rounded-2xl border border-gray-200 shadow-xs bg-white not-prose">
    <img
      src="/images/projects/fireplace-stone-veneer-hearth.jpg"
      alt="Mason refacing a fireplace with manufactured stone veneer, back-buttering units over metal lath scratch coat and raised concrete hearth"
      class="w-full h-56 sm:h-72 md:h-84 lg:h-96 object-cover"
      loading="lazy"
    />
    <div class="p-3.5 bg-gray-50/90 border-t border-gray-100 text-xs text-gray-500 flex flex-col sm:flex-row sm:items-center justify-between gap-1.5">
      <span>📸 <strong>Job Site Takeoff:</strong> Back-buttering manufactured stone flats over 2.5 lb diamond metal lath and Type S scratch coat</span>
      <span class="font-medium text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-100 self-start sm:self-auto">NFPA 211 Clearance</span>
    </div>
  </div>

  <!-- Step by Step Workflow Cards -->
  <div class="space-y-6 mb-10 not-prose">
    <h2 class="text-2xl font-black text-gray-900 tracking-tight">The 4-Step Fireplace Stone Veneer Workflow</h2>
    
    <div class="grid grid-cols-1 gap-4">
      {workflowSteps.map((step) => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 hover:border-blue-300 transition-all shadow-xs">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-blue-600 text-white font-bold flex items-center justify-center text-lg shadow-sm">
              {step.stepNumber}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-base font-bold text-gray-900">{step.title}</h3>
                <span class="text-lg">{step.icon}</span>
              </div>
              <p class="text-sm text-gray-600 mb-3 leading-relaxed">{step.description}</p>
              <a
                href={step.href}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 px-3 py-1.5 rounded-md hover:bg-blue-100 transition-colors"
              >
                <span>Calculate Materials: {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Trade Field Note -->
  <FieldNote
    expertName="Elena Rostova, CBO"
    role="Certified Building Official & Material Takeoff Analyst"
    experience="18+ Years Field Experience"
    avatarBg="bg-emerald-100 text-emerald-800"
    initials="ER"
    title="Why Installing Stone Veneer Over Standard Drywall is an Illegal Fire Hazard"
    note="A dangerous shortcut I routinely fail during building inspections is homeowners who glue heavy stone veneer directly onto standard 1/2-inch gypsum drywall using mastic adhesive. Standard drywall paper facing is combustible! When wood-burning or gas fireplace inserts operate, intense conduction and radiation superheats the surrounding wall. Gypsum core disintegrates under sustained thermal exposure, and the flammable paper backing can ignite inside wall cavities. Furthermore, mastic adhesive dries out, becoming brittle and allowing 10-pound stones to fall off onto children or pets below. Building code (IRC Section R1001) mandates that the entire fireplace face must consist of non-combustible materials: 1/2-inch cement backer board or masonry block, covered with galvanized metal lath and a 1/2-inch Type S Portland cement scratch coat. Never install stone veneer over drywall."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Fireplace Stone Veneer Installation"
    mistakes={[
      {
        number: 1,
        title: "Setting Dry, Dusty Stones Without Dampening and Back-Buttering",
        costImpact: "$2,400 (Hollow Adhesion Failure & Stones Dropping Off Wall)",
        description: "Dry manufactured stone absorbs moisture out of wet mortar before the cement can hydrate, creating a powdery, debonded contact plane.",
        solution: "Wipe stone backs clean of factory release dust with a wet sponge and apply a 100% complete 1/2-inch butter coat of polymer-modified thinset."
      },
      {
        number: 2,
        title: "Installing Metal Lath Upside Down (Dropping the Scratch Coat)",
        costImpact: "$850 (Mortar Slumping to Floor & Tearing Off Lath)",
        description: "Diamond mesh metal lath has small formed cups. If installed upside down, mortar falls straight off the wall instead of locking into the mesh.",
        solution: "Run your hand down the lath before fastening: it should feel rough when moving your hand down, with the cups opening upward to pocket the mortar."
      },
      {
        number: 3,
        title: "Under-Sizing the Hearth Extension Below 6 Sq Ft Firebox Rules",
        costImpact: "$1,600 (Failed Fire Inspection & Chipping Up Finished Flooring)",
        description: "Building a standard 16\" hearth extension on a large fireplace (opening &ge; 6 sq ft) violates NFPA 211, which mandates a full 20-inch extension.",
        solution: "Measure your firebox opening width times height. If area is 6.0 sq ft or greater, the hearth must extend at least 20 inches in front and 12 inches to each side."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Fireplace Stone Veneer Workflow"
    reviews={[
      {
        author: "Darren & Laura M.",
        location: "Denver, CO",
        projectScope: "Floor-to-Ceiling Ledgestone Fireplace with Bluestone Hearth",
        savingsClaim: "Saved $4,200 vs Mason Quote",
        feedback: "Stripped our 1980s drywall down to studs, hung 1/2\" Durock, and used 2.5 lb diamond lath with Type S mortar. Back-buttering every single stone gave a rock-solid mechanical bond. We hit our stones with a rubber mallet and they feel like carved granite bedrock.",
        keyTakeaway: "Always start your stone layout with the 90-degree corner pieces first, alternating long and short legs to prevent an obvious vertical seam."
      },
      {
        author: "Colin S.",
        location: "Burlington, VT",
        projectScope: "Wood Stove Hearth & Cultured Stone Surround",
        savingsClaim: "Passed Fire Marshal Inspection Instantly",
        feedback: "Elena's note on the 20-inch hearth extension saved us from a failed inspection. Our firebox was 6.2 sq ft, so we built our raised hearth 21 inches out into the living room. The fire marshal checked with his tape measure and signed off on the spot.",
        keyTakeaway: "Use a vinyl grout bag to pipe mortar into joints, but wait 45 minutes until it is thumbprint-firm before striking with a pointing tool."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Fireplace Stone Veneer & Hearth Hub" initialYesCount={368} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Material Takeoff Analyst"
    codeStandard="NFPA 211 (Standard for Chimneys & Fireplaces) & IRC Section R1001"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Project Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/fireplace-hearth-clearance-nfpa-211" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Hearth Clearance Guide →</div>
        <div class="text-xs text-gray-500 mt-1">NFPA 211 firebox area thresholds, 16\" vs 20\" extensions, and combustible clearances.</div>
      </a>
      <a href="/calculators/mortar-mix" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Mortar Mix Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate Type S and Type N cement bags, sand cubic feet, and water ratios for scratch coats.</div>
      </a>
      <a href="/calculators/thinset" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Thinset &amp; Mortar Coverage Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Estimate polymer-modified thinset bag requirements for heavy stone back-buttering.</div>
      </a>
    </div>
  </div>

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Old Slab Demolition & Subgrade Compaction",
    description: "Break up sunken, cracked concrete with a hydraulic breaker or skid steer, haul debris, and roll the native subgrade with a vibratory plate compactor to eliminate soft pockets.",
    calculatorName: "Concrete Slab & Demolition Calculator",
    href: "/calculators/concrete-slab",
    icon: "🚜"
  },
  {
    stepNumber: 2,
    title: "6\" Dense-Graded Road Base & Geotextile Fabric",
    description: "Spread 6 inches of crushed stone road base (dense-graded aggregate or crusher run) over non-woven geotextile fabric, moisten, and compact in 3-inch lifts to 98% Proctor density.",
    calculatorName: "Gravel Base & Road Base Calculator",
    href: "/calculators/gravel-driveway",
    icon: "🪨"
  },
  {
    stepNumber: 3,
    title: "2x6 Edge Formwork & #4 Rebar Grid on 2\" Chairs",
    description: "Stake 2x6 Douglas fir forms staked every 3 feet with a 1/8\" per foot cross-slope for water runoff, and tie a 16\" on-center grid of #4 (1/2\") steel rebar elevated on 2-inch plastic chairs.",
    calculatorName: "Rebar Spacing & Grid Calculator",
    href: "/calculators/rebar",
    icon: "📐"
  },
  {
    stepNumber: 4,
    title: "4500 PSI Air-Entrained Pour & Non-Slip Broom Finish",
    description: "Order 4500 PSI mix with 6% air entrainment for freeze-thaw defense, screed, bull float, edge perimeter borders, pull a uniform medium horsehair broom texture, and spray cure-and-seal.",
    calculatorName: "Concrete Slab Volume Calculator",
    href: "/calculators/concrete-slab",
    icon: "✨"
  }
];
---

<Layout
  title="Concrete Driveway Replacement Hub — Step-by-Step Pouring Workflow | CalcForDIY"
  description="Follow a 4-step structural concrete driveway replacement workflow: Subgrade compaction, 6-inch road base, #4 rebar on chairs, and 4500 PSI air-entrained pour."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Concrete Driveway Replacement Hub", "item": "https://calcfordiy.com/projects/concrete-driveway-replacement" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Concrete Driveway</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-3 border border-emerald-100">
      <span>🚗 Structural Paving &amp; Heavy Vehicle Flatwork</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Concrete Driveway Tear-Out &amp; Replacement Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Replacing a broken, spalling asphalt or concrete driveway with a 5-inch thick, steel-reinforced 4500 PSI slab provides 40+ years of maintenance-free service under heavy pickup trucks and delivery vans. This master workflow covers ACI 330R standards: mechanical subgrade compaction, dense-graded crushed stone base, #4 rebar grids on chairs, and freeze-thaw air entrainment.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">3 to 4 Days (2-Car Driveway)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$6,500 – $11,500 (65%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">ACI 330R-08 &amp; ASTM C94</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Concrete Contractor Bid vs. DIY Ready-Mix Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (20ft x 40ft / 800 Sq Ft 5-Inch Driveway)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Commercial concrete flatwork contractor turnkey quote ($12–$18/sq ft) vs. DIY retail ready-mix trucks, mini-excavator rental, rebar &amp; road base.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Equipment &amp; Ready-Mix Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$3,800 – $4,900</div>
        <div class="text-[11px] text-slate-400 mt-1">13 cu yds 4500 PSI concrete, 18 tons road base, #4 rebar, forms &amp; 1-day machine rental</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Licensed Flatwork Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$10,500 – $15,800</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor &amp; Finishing Crew 65% • Demolition &amp; Haul-Off 15% • Materials 20%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$6,700 to $10,900</strong> while ensuring your rebar is elevated on real chairs rather than trampled into the dirt.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Follow the 4 structural paving steps to build a 50-year slab that resists freeze-thaw frost heave.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="David Miller, PE"
    role="Structural & Civil Engineering Consultant"
    experience="20+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="Why Subgrade Compaction Matters More Than Concrete Thickness"
    note="A common misconception among homeowners is that pouring a thicker 6-inch slab will compensate for a soft, poorly prepared dirt base. Concrete has incredible compressive strength (4,500 pounds per square inch), but it has very weak flexural tensile strength (less than 500 PSI). When a 7,000-pound delivery van parks on your driveway, the concrete slab bends slightly downward under the tire footprint. If the gravel base underneath has soft voids or uncompacted organic soil, the concrete bridges across the empty space like a beam. The bottom of the slab pulls apart in tension and cracks straight through to the surface! You can pour an 8-inch slab, and it will still crack if the subgrade sinks 1/4 inch. Always excavate down to firm native subsoil, lay non-woven geotextile fabric to stop aggregate sinking into clay, spread 6 inches of dense-graded crushed stone road base, and compact with a heavy vibratory plate until a 16-pound sledgehammer bounced off the gravel leaves zero dent."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Concrete Driveway Replacement"
    mistakes={[
      {
        number: 1,
        title: "Letting Rebar Rest Directly on the Gravel Base",
        costImpact: "$3,800 (Premature Slab Faulting & Corrosion Rust Stains)",
        description: "Laying steel rebar directly on dirt without plastic support chairs puts the steel at the bottom 1/4 inch of the slab where it provides zero structural bending resistance.",
        solution: "Support all rebar intersections with 2-inch plastic rebar chairs (dobies) so the steel grid sits permanently suspended in the middle-third tension zone."
      },
      {
        number: 2,
        title: "Adding Excess Water on Site to Make Concrete Easier to Spread",
        costImpact: "$2,800 (Severe Winter Surface Spalling & Scaling)",
        description: "Washing extra water into the ready-mix drum increases the water-cement ratio above 0.45. The excess water bleeds to the top surface, creating a weak, porous crust that spalls under winter de-icing salts.",
        solution: "Order the mix at a 4-inch to 5-inch slump with a mid-range polycarboxylate water reducer (superplasticizer) to increase flowability without adding water."
      },
      {
        number: 3,
        title: "Waiting More Than 12 Hours to Saw-Cut Control Joints",
        costImpact: "$2,200 (Random Diagonal Shrinkage Cracks Across Panels)",
        description: "As concrete hydrates and cools overnight, shrinkage stresses peak within 8 to 12 hours. Waiting until the next afternoon means cracks have already formed under the surface.",
        solution: "Walk an early-entry green concrete saw onto the slab 4 to 8 hours after finishing, cutting joints at maximum 10-foot squares to 1/4 slab depth."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Concrete Driveway Workflow"
    reviews={[
      {
        author: "Darrell & Heather K.",
        location: "Kansas City, MO",
        projectScope: "24x45 ft Double Driveway Replacement",
        savingsClaim: "Saved $9,800 vs Paving Contractor",
        feedback: "Rented a Bobcat skid steer with a breaker attachment for a Saturday morning. Hauled away 2 dump trailers of old busted slab. Poured 4500 PSI with 6% air entrainment. We had 4 friends helping: one raking, two screeding, and one bull-floating. The broom finish looks like a commercial highway apron.",
        keyTakeaway: "Keep a spare garden hose and extra magnesium floats on hand; when the concrete truck shows up, you cannot pause."
      },
      {
        author: "Mitch B.",
        location: "Cleveland, OH",
        projectScope: "5-Inch Slab with #4 Rebar on Chairs",
        savingsClaim: "Zero Cracks After 3 Freezing Winters",
        feedback: "The 2-inch plastic chairs made a huge difference. During the pour, we walked all over the grid and the rebar stayed elevated right in the center of the 5-inch slab. Survived two lake-effect snow winters with heavy road salt with zero scaling.",
        keyTakeaway: "Spray an acrylic cure-and-seal compound immediately after broom finishing to trap moisture for maximum 28-day hydration strength."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Concrete Driveway Replacement Hub" initialYesCount={381} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="ACI 330R-08 (Design & Construction of Concrete Parking Lots) & ASTM C94"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/concrete-driveway-thickness-rebar-spacing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Driveway Thickness &amp; Rebar Guide →</div>
        <div class="text-xs text-gray-500 mt-1">4\" vs 5\" vs 6\" slab thickness, #4 rebar on 16\" grids vs welded wire mesh failure.</div>
      </a>
      <a href="/calculators/rebar" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Rebar Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate linear footage, bar counts, lap splices, and plastic chair quantities.</div>
      </a>
      <a href="/calculators/concrete-slab" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Slab Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate exact cubic yards and ready-mix truckloads with waste factors.</div>
      </a>
    </div>
  </div>

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Essential Load Audit & Starting Inrush Wattage Calculation",
    description: "Audit mission-critical household circuits (well pump, refrigerator, furnace blower, sump pump, internet/lighting). Calculate continuous running wattage plus motor locked-rotor amp (LRA) starting surge to size portable generator capacity (7,500W to 12,000W).",
    calculatorName: "Generator Wattage & Sizing Calculator",
    href: "/calculators/generator-size",
    icon: "⚡"
  },
  {
    stepNumber: 2,
    title: "Exterior Power Inlet Box & 30A/50A Feeder Conduit Pull",
    description: "Mount a NEMA 3R outdoor power inlet box (L14-30P for 30A or CS6365/14-50P for 50A) at least 20 feet away from doors/windows. Run schedule 40 PVC or EMT conduit to the main panel with 10 AWG (30A) or 6 AWG (50A) THHN copper conductors.",
    calculatorName: "Conduit Fill & Wire Capacity Calculator",
    href: "/calculators/conduit-fill",
    icon: "🔌"
  },
  {
    stepNumber: 3,
    title: "Mechanical Interlock Kit or Pre-Wired Transfer Switch Mounting",
    description: "Install an engineered, UL-listed mechanical interlock bracket on the main distribution panel, or mount a 10-circuit manual transfer switch subpanel alongside. Install a dedicated 30A or 50A 2-pole generator backfeed breaker with code-mandated hold-down retention.",
    calculatorName: "Subpanel Sizing & Feeder Calculator",
    href: "/calculators/subpanel-sizing",
    icon: "🛡️"
  },
  {
    stepNumber: 4,
    title: "Neutral-Ground Bond Verification & Full Load Outage Simulation",
    description: "Verify generator frame bonding vs. panel bonding: unbond portable generator neutral for non-separately derived 3-pole systems to prevent parallel ground loops. Kill main utility service, connect heavy 10/4 or 6/4 generator cord, and verify stable 120V/240V voltage under load.",
    calculatorName: "EV Charger & Heavy Circuit Wiring Calculator",
    href: "/calculators/ev-charger-wiring",
    icon: "💡"
  }
];
---

<Layout
  title="Home Generator Transfer Switch Hub — Step-by-Step Workflow | CalcForDIY"
  description="Safely connect a portable generator to your home: wattage load audit, exterior 30A/50A inlet box installation, UL mechanical interlock kit, and NEC neutral bonding."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Home Generator Transfer Switch Hub", "item": "https://calcfordiy.com/projects/home-generator-transfer-switch" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Install a Generator Transfer Switch or Panel Interlock Kit",
    "description": "Step-by-step master electrician guide to sizing, wiring, and commissioning a code-compliant emergency generator connection under NEC Article 702.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Load Audit & Generator Sizing",
        "text": "Calculate running watts and starting inductive surge loads for critical household branch circuits."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Power Inlet Box & Conduit Installation",
        "text": "Mount exterior NEMA 3R 30A or 50A generator inlet box and pull THHN copper conductors in conduit."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Panel Interlock or Transfer Switch Tie-In",
        "text": "Install UL-listed mechanical slider interlock plate and code-required breaker hold-down clip."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Neutral-Ground Bonding & Live Testing",
        "text": "Configure floating neutral at generator to avoid parallel paths, simulate utility blackout, and test loads."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Generator Transfer Switch</span>
  </nav>

  <!-- Hero Section -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold mb-3 border border-amber-100">
      <span>⚡ Emergency Standby Power &amp; NEC Electrical Codes</span>
      <span>•</span>
      <span>NEC Article 702 &amp; UL 1008 Standards</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Home Generator Transfer Switch Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      When grid power fails during severe ice storms or summer hurricanes, running extension cords through open windows creates severe carbon monoxide poisoning and fire hazards. Installing a dedicated <strong>exterior power inlet box paired with a mechanical generator interlock kit or multi-circuit transfer switch</strong> allows you to power your well pump, furnace, refrigerator, and lights safely through your home's existing breaker panel while protecting utility linemen from deadly backfeed.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 mb-6">
      <div>
        <div class="text-xs text-gray-500 font-medium">Standard Inlet Rating</div>
        <div class="text-lg font-bold text-gray-900">30A (7,500W) / 50A (12kW)</div>
        <div class="text-xs text-blue-600">NEMA L14-30 or CS6365</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Wire Gauge Required</div>
        <div class="text-lg font-bold text-gray-900">#10 AWG or #6 AWG</div>
        <div class="text-xs text-emerald-600">75°C Copper THHN / Romex</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Backfeed Protection</div>
        <div class="text-lg font-bold text-gray-900">Mechanical Interlock</div>
        <div class="text-xs text-purple-600">Prevents Dual Connection</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">DIY Project Cost</div>
        <div class="text-lg font-bold text-gray-900">$580 - $1,150</div>
        <div class="text-xs text-amber-600">Saves $2,500+ vs Electrician</div>
      </div>
    </div>

    <!-- RSMeans Contractor vs DIY Comparison -->
    <div class="border border-gray-200 rounded-xl overflow-hidden mb-6">
      <div class="bg-gray-100 px-4 py-2.5 font-semibold text-xs text-gray-700 uppercase tracking-wider">
        Project Cost Benchmark: 30-Amp Generator Inlet &amp; Panel Interlock Installation
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-gray-200 text-sm">
        <div class="p-4 bg-white">
          <div class="text-xs font-bold text-gray-500 uppercase mb-1">Licensed Electrical Contractor</div>
          <div class="text-2xl font-black text-gray-900 mb-2">$2,800 – $4,400</div>
          <ul class="text-xs text-gray-600 space-y-1.5">
            <li>• Electrical permit, load calculation &amp; utility notification: $350 – $550</li>
            <li>• Core drill exterior wall &amp; install NEMA 3R inlet box: $650 – $950</li>
            <li>• Conduit run, #10 AWG THHN pull &amp; 30A 2-pole breaker: $800 – $1,200</li>
            <li>• UL mechanical interlock kit, breaker tie-down &amp; safety inspection: $1,000 – $1,700</li>
          </ul>
        </div>
        <div class="p-4 bg-emerald-50/50">
          <div class="text-xs font-bold text-emerald-800 uppercase mb-1">DIY Self-Performance</div>
          <div class="text-2xl font-black text-emerald-700 mb-2">$620 – $1,180</div>
          <ul class="text-xs text-gray-700 space-y-1.5">
            <li>• Outdoor NEMA 3R 30A power inlet box (Reliance / Reliance Controls): $75 – $130</li>
            <li>• 40 ft 10/3 NM-B Romex or #10 THHN in 3/4" EMT conduit: $90 – $160</li>
            <li>• Square D / Siemens panel-matched UL mechanical interlock kit: $70 – $140</li>
            <li>• 30A 2-pole breaker &amp; NEC 408.36(D) mechanical hold-down bracket: $45 – $80</li>
            <li>• 25 ft heavy-duty 30A 10/4 generator rubber power cord: $110 – $180</li>
            <li>• Electrical permit fee &amp; city inspection: $90 – $150</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Step by Step Workflow Cards -->
  <div class="space-y-6 mb-10 not-prose">
    <h2 class="text-2xl font-black text-gray-900 tracking-tight">The 4-Step Generator Transfer Switch Workflow</h2>
    
    <div class="grid grid-cols-1 gap-4">
      {workflowSteps.map((step) => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 hover:border-blue-300 transition-all shadow-xs">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-amber-600 text-white font-bold flex items-center justify-center text-lg shadow-sm">
              {step.stepNumber}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-base font-bold text-gray-900">{step.title}</h3>
                <span class="text-lg">{step.icon}</span>
              </div>
              <p class="text-sm text-gray-600 mb-3 leading-relaxed">{step.description}</p>
              <a
                href={step.href}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 px-3 py-1.5 rounded-md hover:bg-blue-100 transition-colors"
              >
                <span>Calculate Sizing: {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Trade Field Note -->
  <FieldNote
    expertName="Marcus Vance"
    role="Master Electrician & MEP Systems Specialist"
    experience="22+ Years Field Experience"
    avatarBg="bg-amber-100 text-amber-800"
    initials="MV"
    title="The Floating Neutral vs. Bonded Neutral Trap in Portable Generators"
    note="This is the single most misunderstood code concept among generator owners. When you buy a portable jobsite generator, the manufacturer almost always bonds the neutral wire to the generator's steel frame at the factory (bonded neutral) to meet OSHA jobsite rules. BUT when you plug that generator into your home's breaker panel via a transfer switch or interlock where the neutral doesn't switch (a solid neutral system), you create TWO separate neutral-to-ground bonds! One bond at the main panel, and one bond at the generator frame. This causes dangerous parallel return currents to flow continuously across the green grounding wire. It can shock you when you touch the generator frame and will instantly trip modern GFCI breakers on inverter generators! If your transfer switch does NOT switch the neutral (which is true for 95% of residential interlock kits), you MUST remove the neutral-to-ground jumper bonding wire inside the generator's alternator end bell, converting it to a 'Floating Neutral'."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Generator Transfer Switch Installation"
    mistakes={[
      {
        number: 1,
        title: "Backfeeding Through an Outlet with a Male-to-Male 'Suicide Cord'",
        costImpact: "$10,000+ (Criminal Negligence, Arson & Electrocution of Linemen)",
        description: "Plugging a generator into an electric dryer outlet without a mechanical interlock allows generator power to energize the utility transformer down the street, stepping up to 7,200V and electrocuting line repair crews.",
        solution: "Never use suicide cords. Strictly install a code-approved UL-listed mechanical interlock plate or certified transfer switch that makes simultaneous connection physically impossible."
      },
      {
        number: 2,
        title: "Omitting the NEC 408.36(D) Breaker Hold-Down Retention Clip",
        costImpact: "$850 (Failed Electrical Inspection & Arc Flash Hazard)",
        description: "Plugging a backfed 2-pole generator breaker into panel bus bars without a mechanical hold-down bracket violates code. If someone pulls the dead-front cover, the energized breaker can pop loose, causing an explosive arc flash.",
        solution: "Install the manufacturer's certified breaker retention screw or tie-down bracket kit (e.g. Square D HOM4RK2HA) that physically screws the breaker to the panel interior."
      },
      {
        number: 3,
        title: "Mounting the Exterior Inlet Box Near Bedroom Windows or Dryer Vents",
        costImpact: "$1,200 (Relocation Rework & Deadly Carbon Monoxide Risk)",
        description: "Placing the generator inlet right next to a crawlspace vent, dryer exhaust hood, or basement window draws invisible carbon monoxide fumes into living spaces.",
        solution: "Mount the inlet box on an open exterior wall and ensure the generator operates at least 20 feet away from any door, window, or HVAC fresh air intake."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Generator Transfer Switch Workflow"
    reviews={[
      {
        author: "Darren & Lisa T.",
        location: "Houston, TX",
        projectScope: "50-Amp Generator Interlock on 200A Square D Panel",
        savingsClaim: "Saved $2,900 vs Electrician Bid",
        feedback: "Installed a 50A inlet box with #6 THHN in 1\" conduit to our basement main panel. The mechanical interlock plate slid right into place. During Hurricane Beryl, we ran our 9,500W Westinghouse dual-fuel generator, powering our refrigerator, well pump, portable AC, and internet without a hiccup.",
        keyTakeaway: "Unbonding the generator's neutral wire was the key—once we removed the bonding jumper per Marcus's note, our generator ran smoothly without buzzing."
      },
      {
        author: "Caleb W.",
        location: "Albany, NY",
        projectScope: "10-Circuit Manual Transfer Switch Installation",
        savingsClaim: "Zero Guesswork During Winter Ice Storm",
        feedback: "We opted for the pre-wired Reliance transfer switch subpanel next to our main panel. The dual wattage meters show our exact continuous load in real time, making load-shedding effortless. Well worth the afternoon of wiring.",
        keyTakeaway: "Label each transfer switch toggle switch with clear, color-coded circuit names so anyone in the family can switch power during an emergency."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Home Generator Transfer Switch Hub" initialYesCount={392} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Master Electrician & MEP Systems Specialist"
    codeStandard="NEC Article 702 (Optional Standby Systems), NEC 408.36(D) & UL 1008"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Project Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/manual-transfer-switch-vs-interlock-kit" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Interlock vs. Transfer Switch Guide →</div>
        <div class="text-xs text-gray-500 mt-1">NEC Article 702 compliance, cost tradeoffs, whole-panel flexibility vs 10-circuit subpanels.</div>
      </a>
      <a href="/calculators/generator-size" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Generator Sizing Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Sum appliance running wattage and motor locked-rotor startup surge demands.</div>
      </a>
      <a href="/calculators/subpanel-sizing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Subpanel Sizing Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Size feeder conductors, breaker ampacities, and conduit dimensions.</div>
      </a>
    </div>
  </div>

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Airflow CFM Sizing & Attic Net Free Vent Area (NFVA) Audit",
    description: "Calculate home interior volume (Square Footage x Ceiling Height) and apply the 20 to 30 air changes per hour (ACH) cooling formula to determine required fan CFM (typically 3,000 to 5,500 CFM). Verify that attic exhaust vents provide at least 1 sq ft of net free area per 750 CFM.",
    calculatorName: "Whole House Fan Sizing Calculator",
    href: "/calculators/whole-house-fan",
    icon: "💨"
  },
  {
    stepNumber: 2,
    title: "Hallway Ceiling Framing, Joist Headering & Damper Box Drop",
    description: "Select a central hallway ceiling location. Frame a structural rough opening by cutting one ceiling joist and installing doubled 2x6 or 2x8 headers supported by joist hangers. Mount the motorized or gravity damper plenum collar flush with drywall.",
    calculatorName: "Attic Insulation Volume Calculator",
    href: "/calculators/attic-insulation",
    icon: "🪵"
  },
  {
    stepNumber: 3,
    title: "Acoustic Flexible Duct Suspension & R-38 Insulated Damper",
    description: "For modern quiet systems (QuietCool / AirScape), suspend the heavy motor assembly from roof rafters using heavy-duty vibration-damping nylon straps. Connect 6 to 9 feet of insulated acoustical duct between the fan and the ceiling damper to eliminate motor humming.",
    calculatorName: "Roof Pitch & Rafter Length Calculator",
    href: "/calculators/roof-pitch-rafter",
    icon: "⚙️"
  },
  {
    stepNumber: 4,
    title: "Dedicated 15A Circuit Wiring, Timer Switch & Draft Testing",
    description: "Run a dedicated 14/2 NM-B Romex branch circuit from the main electrical panel. Wire a multi-speed electronic countdown timer (1 to 8 hours) with safety interlock. Test system by opening 2 to 3 ground-floor windows before powering the motor.",
    calculatorName: "Soffit & Fascia Airflow Calculator",
    href: "/calculators/soffit-fascia",
    icon: "⚡"
  }
];
---

<Layout
  title="Whole-House Attic Fan Installation Hub — Step-by-Step | CalcForDIY"
  description="Install a high-efficiency whole-house attic ventilation fan: CFM airflow sizing, joist headering framing, acoustic duct suspension, and NFVA exhaust venting rules."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Whole-House Fan Installation Hub", "item": "https://calcfordiy.com/projects/whole-house-fan-installation" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Install a Whole-House Ventilation Fan",
    "description": "Professional HVAC and electrical engineering guide for sizing, framing, wiring, and commissioning an insulated whole-house attic fan.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "CFM & Attic Vent Area Sizing",
        "text": "Calculate cooling CFM needs based on house cubic volume and verify net free exhaust vent area."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Ceiling Rough Opening Framing",
        "text": "Header ceiling joists with doubled dimensional lumber and install plenum damper box."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Acoustic Fan Suspension",
        "text": "Hang the motor from roof rafters with vibration straps and connect insulated flexible acoustic duct."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Dedicated Circuit & Timer Controls",
        "text": "Wire 15A dedicated circuit with electronic countdown timer and perform airflow draft balance test."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Whole-House Fan Installation</span>
  </nav>

  <!-- Hero Section -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold mb-3 border border-amber-100">
      <span>💨 Passive Cooling &amp; Building Ventilation</span>
      <span>•</span>
      <span>ASHRAE Standard 62.2 &amp; IRC R806 Ventilation Codes</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Whole-House Attic Ventilation Fan Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      A whole-house fan cools your entire home by pulling cool evening air through open downstairs windows and exhausting hot, stale indoor air up into the attic and out through roof vents. By creating 20 to 30 air changes per hour, a whole-house fan cools the thermal mass of your structure (walls, floors, furniture) for pennies a day—reducing central air conditioning runtime by up to 80%. Proper installation requires strict attention to <strong>attic exhaust vent ratios, vibration-isolated rafter suspension, and combustion backdraft safety</strong>.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 mb-6">
      <div>
        <div class="text-xs text-gray-500 font-medium">Airflow Capacity</div>
        <div class="text-lg font-bold text-gray-900">3,000 – 5,500 CFM</div>
        <div class="text-xs text-blue-600">20 to 30 Air Changes/Hr</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Attic Vent Ratio</div>
        <div class="text-lg font-bold text-gray-900">1 Sq Ft per 750 CFM</div>
        <div class="text-xs text-emerald-600">Net Free Exhaust Area</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Electrical Circuit</div>
        <div class="text-lg font-bold text-gray-900">15A Dedicated 120V</div>
        <div class="text-xs text-purple-600">14/2 NM-B with Timer</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">DIY Project Cost</div>
        <div class="text-lg font-bold text-gray-900">$680 - $1,250</div>
        <div class="text-xs text-amber-600">Saves $1,500+ vs Pro</div>
      </div>
    </div>

    <!-- RSMeans Contractor vs DIY Comparison -->
    <div class="border border-gray-200 rounded-xl overflow-hidden mb-6">
      <div class="bg-gray-100 px-4 py-2.5 font-semibold text-xs text-gray-700 uppercase tracking-wider">
        Project Cost Benchmark: 4,500 CFM Ducted Whole-House Fan Installation (2,200 Sq Ft Home)
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-gray-200 text-sm">
        <div class="p-4 bg-white">
          <div class="text-xs font-bold text-gray-500 uppercase mb-1">HVAC &amp; Electrical Contractor</div>
          <div class="text-2xl font-black text-gray-900 mb-2">$2,200 – $3,600</div>
          <ul class="text-xs text-gray-600 space-y-1.5">
            <li>• Attic ventilation assessment &amp; additional gable vent cuts: $450 – $750</li>
            <li>• Ceiling joist cutting, structural headering &amp; damper box: $550 – $850</li>
            <li>• Suspended motor installation &amp; acoustic flexible ducting: $700 – $1,100</li>
            <li>• Dedicated 120V circuit run, timer switch &amp; safety inspection: $500 – $900</li>
          </ul>
        </div>
        <div class="p-4 bg-emerald-50/50">
          <div class="text-xs font-bold text-emerald-800 uppercase mb-1">DIY Self-Performance</div>
          <div class="text-2xl font-black text-emerald-700 mb-2">$720 – $1,350</div>
          <ul class="text-xs text-gray-700 space-y-1.5">
            <li>• 4,500 CFM ducted stealth whole-house fan kit (QuietCool / CentricAir): $580 – $1,050</li>
            <li>• 2x6 framing lumber, joist hangers &amp; drywall trim: $35 – $65</li>
            <li>• 50 ft 14/2 Romex cable, single-gang box &amp; digital timer: $45 – $85</li>
            <li>• Additional aluminum roof/ridge vents (if needed for NFVA): $60 – $150</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Step by Step Workflow Cards -->
  <div class="space-y-6 mb-10 not-prose">
    <h2 class="text-2xl font-black text-gray-900 tracking-tight">The 4-Step Whole-House Fan Workflow</h2>
    
    <div class="grid grid-cols-1 gap-4">
      {workflowSteps.map((step) => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 hover:border-blue-300 transition-all shadow-xs">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-amber-600 text-white font-bold flex items-center justify-center text-lg shadow-sm">
              {step.stepNumber}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-base font-bold text-gray-900">{step.title}</h3>
                <span class="text-lg">{step.icon}</span>
              </div>
              <p class="text-sm text-gray-600 mb-3 leading-relaxed">{step.description}</p>
              <a
                href={step.href}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 px-3 py-1.5 rounded-md hover:bg-blue-100 transition-colors"
              >
                <span>Calculate Sizing: {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Trade Field Note -->
  <FieldNote
    expertName="Marcus Vance"
    role="Master Electrician & MEP Systems Specialist"
    experience="22+ Years Field Experience"
    avatarBg="bg-amber-100 text-amber-800"
    initials="MV"
    title="The Deadly Carbon Monoxide Backdraft Threat: Never Run with Windows Closed"
    note="A powerful 4,500 CFM whole-house fan moves an astonishing volume of air—equivalent to emptying the entire air volume of a 2,000 sq ft house every 3 minutes. If someone turns this fan on while all exterior doors and windows are closed, the fan creates an intense negative vacuum inside the living space. That vacuum will seek air from any source available—and the easiest source is the natural-draft metal flue pipes of your gas water heater, gas furnace, or wood fireplace! The fan pulls exhaust fumes backward down the chimney, flooding bedrooms with lethal carbon monoxide within 10 minutes. Always teach everyone in the household the non-negotiable rule: NEVER turn on a whole-house fan without opening at least 2 or 3 windows across the home. Many electricians wire a dedicated lockout switch or vacuum safety relay to prevent operation when windows are closed."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Whole-House Fan Installation"
    mistakes={[
      {
        number: 1,
        title: "Installing Fan with Inadequate Attic Net Free Exhaust Venting",
        costImpact: "$1,800 (Pressurized Attic, Blown Insulation Leaking into Rooms & Motor Burnout)",
        description: "If attic exhaust vents are smaller than the 1 sq ft per 750 CFM rule, the fan pressurizes the attic, forcing hot 140°F attic air and fiberglass dust down through wall outlets.",
        solution: "Audit attic vents beforehand. A 4,500 CFM fan requires 6.0 square feet of net free vent area; cut additional gable louvers or install ridge vents if needed."
      },
      {
        number: 2,
        title: "Mounting the Fan Motor Directly to Ceiling Joists (Helicopter Noise)",
        costImpact: "$950 (Vibration Noise Keeping Family Awake at Night)",
        description: "Old-style direct-drive fans bolted straight to ceiling joists transmit mechanical motor vibration into the structural framing, creating a deafening 70 dB rumble.",
        solution: "Choose modern ducted fans (like QuietCool) where the motor hangs from roof rafters by nylon straps, connected to the ceiling by 6 feet of sound-absorbing flexible duct."
      },
      {
        number: 3,
        title: "Skipping the R-38 Insulated Winter Ceiling Damper Door",
        costImpact: "$450/year (Massive Winter Heating Energy Loss Through Ceiling)",
        description: "An uninsulated metal ceiling shutter acts like an open 2x3 foot hole in your ceiling during winter, dumping thousands of dollars of expensive furnace heat into the attic.",
        solution: "Install an R-38 magnetic air-sealed insulated damper box that snaps shut automatically whenever the fan is turned off."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Whole-House Fan Workflow"
    reviews={[
      {
        author: "Darrell & Megan H.",
        location: "Sacramento, CA",
        projectScope: "QuietCool QC-CL-4700 in 2,400 Sq Ft Two-Story",
        savingsClaim: "Summer AC Electric Bill Cut by 65%",
        feedback: "We live in the Central Valley where days hit 100°F but nights drop to 62°F. We open our bedroom windows at 8 PM and turn on the whole-house fan. Within 15 minutes, a crisp mountain-like breeze rushes through the house. The house cools to 65°F by morning, and our AC doesn't turn on until 3 PM the next day.",
        keyTakeaway: "Hang the motor assembly from the rafters using the supplied nylon webbing; in our hallway below, it sounds like a quiet desk fan on medium speed."
      },
      {
        author: "Ken R.",
        location: "Denver, CO",
        projectScope: "Attic Venting Expansion & 3,500 CFM Fan Install",
        savingsClaim: "Saved $1,800 by Installing Over One Weekend",
        feedback: "Marcus Vance's warning about attic ventilation math was spot-on. I had only 3 sq ft of roof vents. I cut two additional 18x24 gable vents before installing the fan. Air exhausts smoothly and my attic temperature stays at outdoor ambient instead of hitting 150°F.",
        keyTakeaway: "Install a multi-hour digital countdown wall switch so you can set it for 2 hours before bed and it turns off automatically after midnight."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Whole-House Attic Ventilation Fan Hub" initialYesCount={372} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Master Electrician & MEP Systems Specialist"
    codeStandard="ASHRAE 62.2 (Ventilation in Residential Buildings) & IRC Section R806"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Project Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/whole-house-fan-cfm-attic-vent-ratio" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Fan CFM &amp; Vent Ratio Guide →</div>
        <div class="text-xs text-gray-500 mt-1">ACH cooling formulas, net free vent area calculations, and backdraft prevention.</div>
      </a>
      <a href="/calculators/whole-house-fan" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Whole House Fan Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate home cubic volume, target air changes, and required exhaust vent area.</div>
      </a>
      <a href="/calculators/soffit-fascia" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Soffit Ventilation Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate net free area (NFVA) for continuous soffit, gable, and ridge vents.</div>
      </a>
    </div>
  </div>

</Layout>

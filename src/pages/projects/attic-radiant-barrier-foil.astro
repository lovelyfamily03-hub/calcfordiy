---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Attic Ventilation Audit & Soffit Baffle Airflow Clearing",
    description: "Verify balanced 1:150 or 1:300 net free ventilation area (NFVA) per IRC R806. Install rigid PVC or foam rafter baffles (AccuVent / Durovent) at every soffit bay to guarantee unobstructed continuous airflow from eaves to the ridge.",
    calculatorName: "Soffit & Fascia Airflow Calculator",
    href: "/calculators/soffit-fascia",
    icon: "💨"
  },
  {
    stepNumber: 2,
    title: "Perforated Multi-Layer Foil Material Sizing & Rafter Mapping",
    description: "Measure rafter bay lengths and calculate roll requirements for tear-resistant, double-sided perforated radiant barrier foil (ASTM C1313). Ensure the material has an emissivity rating under 0.05 and a minimum permeance rating of 5+ perms to allow vapor escape.",
    calculatorName: "Roof Pitch & Rafter Length Calculator",
    href: "/calculators/roof-pitch-rafter",
    icon: "📐"
  },
  {
    stepNumber: 3,
    title: "Rafter Underside Stapling with 3/4\" Open Airspace & Ventilation Gaps",
    description: "Staple the foil to the bottom edges of roof rafters using heavy-duty 5/16\" T50 staples every 4 to 6 inches. Leave a 2-inch continuous open gap at the bottom soffit line and a 6-inch gap along the top ridge beam for continuous convection airflow.",
    calculatorName: "Attic Insulation Volume Calculator",
    href: "/calculators/attic-insulation",
    icon: "🔨"
  },
  {
    stepNumber: 4,
    title: "Attic Floor Penetration Air-Sealing & Insulation Top-Off",
    description: "Seal all electrical chases, plumbing stacks, and ceiling light junction boxes with expanding fire-rated polyurethane foam. Top off the attic floor with blown-in fiberglass or cellulose to achieve recommended regional R-38 to R-60 thermal resistance.",
    calculatorName: "Spray Foam & Air-Sealing Calculator",
    href: "/calculators/spray-foam-insulation",
    icon: "🛡️"
  }
];
---

<Layout
  title="Attic Radiant Barrier Foil Hub — Step-by-Step Workflow | CalcForDIY"
  description="Lower attic temperatures by up to 30°F: install perforated radiant barrier foil under rafters, maintain critical 3/4-inch airspace, preserve soffit-to-ridge venting, and air-seal."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Attic Radiant Barrier Foil Hub", "item": "https://calcfordiy.com/projects/attic-radiant-barrier-foil" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Install an Attic Radiant Barrier Foil",
    "description": "Comprehensive engineering guide for stapling perforated radiant barrier foil beneath roof rafters with required open airspaces and attic thermal optimization.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Ventilation Audit & Baffle Inspection",
        "text": "Inspect soffit vents and install rigid rafter baffles to ensure uninterrupted eave-to-ridge ventilation."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Perforated Foil Sizing",
        "text": "Calculate square footage of breathable ASTM C1313 double-sided foil with emissivity under 0.05."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Rafter Underside Stapling",
        "text": "Staple foil across rafter bottoms leaving 2\" gaps at eaves and 6\" gap at ridge for convection exhaust."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Air-Sealing & Insulation Top-Off",
        "text": "Can-foam ceiling penetrations and blow cellulose to R-38 or R-49 on the attic floor."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Attic Radiant Barrier Foil</span>
  </nav>

  <!-- Hero Section -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-3 border border-emerald-100">
      <span>☀️ Building Science &amp; Passive Solar Cooling</span>
      <span>•</span>
      <span>ASTM C1313 &amp; DOE Energy Star Standards</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Attic Radiant Barrier Foil Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      During peak summer months, dark asphalt roof shingles superheat to over 160°F, radiating massive thermal infrared energy directly down into your attic insulation and through ceiling drywall. By stapling <strong>perforated, highly reflective radiant barrier foil beneath your roof rafters</strong>, you reflect up to 97% of radiant heat back out through the roof ridge, dropping attic temperatures by 25°F to 30°F and slashing air conditioning cooling loads by 12% to 17%.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 mb-6">
      <div>
        <div class="text-xs text-gray-500 font-medium">Thermal Reflection</div>
        <div class="text-lg font-bold text-gray-900">95% – 97%</div>
        <div class="text-xs text-blue-600">Emissivity &le; 0.03</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Attic Temp Drop</div>
        <div class="text-lg font-bold text-gray-900">25°F – 30°F</div>
        <div class="text-xs text-emerald-600">Direct Summer Relief</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Airspace Mandate</div>
        <div class="text-lg font-bold text-gray-900">&ge; 3/4" Clearance</div>
        <div class="text-xs text-purple-600">Zero Touch to Roof Deck</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">DIY Project Cost</div>
        <div class="text-lg font-bold text-gray-900">$480 - $850</div>
        <div class="text-xs text-amber-600">1,500 Sq Ft Attic</div>
      </div>
    </div>

    <!-- RSMeans Contractor vs DIY Comparison -->
    <div class="border border-gray-200 rounded-xl overflow-hidden mb-6">
      <div class="bg-gray-100 px-4 py-2.5 font-semibold text-xs text-gray-700 uppercase tracking-wider">
        Project Cost Benchmark: 1,500 Sq Ft Attic Radiant Barrier Retrofit
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-gray-200 text-sm">
        <div class="p-4 bg-white">
          <div class="text-xs font-bold text-gray-500 uppercase mb-1">Insulation &amp; Weatherization Contractor</div>
          <div class="text-2xl font-black text-gray-900 mb-2">$2,600 – $4,200</div>
          <ul class="text-xs text-gray-600 space-y-1.5">
            <li>• Attic ventilation assessment &amp; baffle prep: $450 – $750</li>
            <li>• Material supply (perforated foil &amp; commercial fasteners): $650 – $950</li>
            <li>• Rafter stapling labor in confined high-heat space: $1,200 – $1,900</li>
            <li>• Ridge gap trimming, air-leak inspection &amp; disposal: $300 – $600</li>
          </ul>
        </div>
        <div class="p-4 bg-emerald-50/50">
          <div class="text-xs font-bold text-emerald-800 uppercase mb-1">DIY Self-Performance</div>
          <div class="text-2xl font-black text-emerald-700 mb-2">$520 – $880</div>
          <ul class="text-xs text-gray-700 space-y-1.5">
            <li>• 1,750 sq ft breathable perforated radiant barrier foil (2 rolls x 1,000 sq ft): $280 – $440</li>
            <li>• Pneumatic slap-stapler or heavy manual T50 stapler &amp; 5,000 staples: $45 – $85</li>
            <li>• 20 rigid foam or PVC rafter ventilation baffles: $65 – $110</li>
            <li>• Fire-rated expanding spray foam cans for attic air-sealing: $40 – $75</li>
            <li>• N95 respirators, LED headlamps, crawl boards &amp; safety goggles: $90 – $170</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Step by Step Workflow Cards -->
  <div class="space-y-6 mb-10 not-prose">
    <h2 class="text-2xl font-black text-gray-900 tracking-tight">The 4-Step Attic Radiant Barrier Workflow</h2>
    
    <div class="grid grid-cols-1 gap-4">
      {workflowSteps.map((step) => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 hover:border-blue-300 transition-all shadow-xs">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-emerald-600 text-white font-bold flex items-center justify-center text-lg shadow-sm">
              {step.stepNumber}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-base font-bold text-gray-900">{step.title}</h3>
                <span class="text-lg">{step.icon}</span>
              </div>
              <p class="text-sm text-gray-600 mb-3 leading-relaxed">{step.description}</p>
              <a
                href={step.href}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 px-3 py-1.5 rounded-md hover:bg-blue-100 transition-colors"
              >
                <span>Calculate Sizing: {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Trade Field Note -->
  <FieldNote
    expertName="Elena Rostova, CBO"
    role="Certified Building Official & Material Takeoff Analyst"
    experience="18+ Years Field Experience"
    avatarBg="bg-emerald-100 text-emerald-800"
    initials="ER"
    title="Why Laying Foil Flat on the Attic Floor Insulation Destroys Performance in 2 Years"
    note="A tempting shortcut homeowners take is rolling radiant barrier foil flat on top of the attic floor fiberglass or cellulose instead of stapling it overhead across the rafters. While easier to install, laying foil horizontally on the attic floor is a building science disaster for two reasons. First: DUST! Within 18 to 24 months, a thin layer of airborne cellulose dust, skin cells, and pollen settles over the reflective aluminum foil. When dust covers a radiant barrier, its emissivity jumps from 0.03 to over 0.70—completely destroying its ability to reflect radiant heat! Second: MOISTURE. In winter, warm, moist household air exfiltrating through ceiling light boxes gets trapped underneath the flat foil sheet, causing severe condensation, soaking the insulation, and growing black mold. Always staple foil to the UNDERSIDE of the roof rafters facing an open airspace, where dust can never settle on the reflective face."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Attic Radiant Barrier Installation"
    mistakes={[
      {
        number: 1,
        title: "Installing Non-Perforated (Vapor Barrier) Foil Under Rafters",
        costImpact: "$3,600 (Roof Deck Rot & Hidden Condensation Moisture)",
        description: "Solid, unperforated foil acts as a class-I vapor barrier. In cold weather, indoor humidity migrating into the attic condenses against the back of the cold foil and rots the plywood roof sheathing.",
        solution: "Strictly install perforated (breathable) radiant barrier foil with thousands of micro-pinholes that allow water vapor to escape freely while blocking radiant heat waves."
      },
      {
        number: 2,
        title: "Stapling Foil Tight Against the Underside of Roof Sheathing (Zero Airspace)",
        costImpact: "$1,800 (Wasted Material & Zero Radiant Thermal Benefit)",
        description: "Radiant barriers require an open air gap of at least 3/4 inch to function. If foil touches roof plywood directly, heat transfers via direct conduction rather than radiation, eliminating the thermal barrier.",
        solution: "Staple the foil to the bottom edges of the rafters (spanning joist to joist), leaving the full 3-1/2\" to 5-1/2\" rafter cavity as an open convective air channel."
      },
      {
        number: 3,
        title: "Covering the Soffit Vents and Ridge Vent Opening Completely",
        costImpact: "$2,400 (Attic Overheating & Premature Shingle Cooking)",
        description: "Sealing foil tightly from eave to ridge blocks passive convective attic ventilation, trapping stagnant 150°F air that bakes asphalt shingles from below and voids shingle warranties.",
        solution: "Leave a 2-inch gap at the lower eave/soffits to allow fresh air intake, and a 6-inch gap at the roof ridge beam to let rising thermal air exhaust out the ridge vent."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Radiant Barrier Workflow"
    reviews={[
      {
        author: "Mark & Sylvia D.",
        location: "Orlando, FL",
        projectScope: "1,600 Sq Ft Rafter Stapled Radiant Foil",
        savingsClaim: "Summer Power Bill Dropped $68/Month",
        feedback: "Stapled breathable perforated foil to our 2x6 rafters on an 85°F morning. We left a 3-inch gap at the soffit baffles and 6 inches along the ridge vent. Our attic temp plummeted from 148°F down to 118°F on 95°F afternoons. Our central AC now turns off periodically instead of running nonstop from noon to 7 PM.",
        keyTakeaway: "Do this project in late autumn or very early in the morning—attics become dangerously hot ovens by 10 AM in the summer."
      },
      {
        author: "Lucas P.",
        location: "Dallas, TX",
        projectScope: "Attic Rafter Foil + Blown Cellulose Upgrade",
        savingsClaim: "HVAC Ductwork Runs in Cool Air",
        feedback: "Our AC ducts run through the attic. Before installing the radiant barrier, duct sweating was a constant issue because the attic hit 140°F+. Elena's advice on keeping the 3/4\" air gap made the air around the ducts dramatically cooler. The house cools down in half the time.",
        keyTakeaway: "Invest $30 in a pneumatic slap stapler; holding a manual squeezer stapler overhead across 1,500 sq ft will exhaust your forearms in 30 minutes."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Attic Radiant Barrier Foil Hub" initialYesCount={369} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Material Takeoff Analyst"
    codeStandard="ASTM C1313 (Standard Specification for Sheet Radiant Barriers) & IRC R806"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Project Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/radiant-barrier-stapled-vs-open-airspace" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Radiant Barrier Airspace Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Stefan-Boltzmann radiation physics, dust accumulation degradation, and perforated foil vapor rules.</div>
      </a>
      <a href="/calculators/attic-insulation" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Attic Insulation Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate target R-values, blown-in bag counts, and floor area requirements.</div>
      </a>
      <a href="/calculators/soffit-fascia" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Soffit Ventilation Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate continuous net free intake area to maintain balanced eave-to-ridge venting.</div>
      </a>
    </div>
  </div>

</Layout>

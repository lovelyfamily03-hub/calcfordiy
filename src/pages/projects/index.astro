<Layout
  title="Project Workflow Hubs — Step-by-Step DIY Home Improvement | CalcForDIY"
  description="Multi-step DIY project workflows that tie individual calculators together for deck building, yard drainage, basement finishing, bathroom tiling, and room makeovers."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <span>Project Hubs</span>
  </div>

  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Project Workflow Hubs</h1>
    <p class="text-gray-600 text-lg max-w-3xl">
      Major DIY home improvement projects require multiple steps and material takeoffs. Select a project hub below to follow an interactive step-by-step workflow with dedicated calculators for each phase.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
    {projects.map((project) => (
      <a href={`/projects/${project.slug}`} class="block bg-white border border-gray-200 rounded-xl p-6 hover:border-blue-400 hover:shadow-md transition-all group">
        <div class="flex items-center justify-between mb-3">
          <span class="text-3xl">{project.icon}</span>
          <span class="text-xs font-semibold px-2.5 py-1 bg-blue-50 text-blue-700 rounded-full border border-blue-100">
            {project.stepsCount}
          </span>
        </div>
        <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
          {project.title}
        </h2>
        <p class="text-sm text-gray-600 mb-4 leading-relaxed">
          {project.description}
        </p>

        <div class="border-t border-gray-100 pt-3">
          <div class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-2">Calculators in this workflow:</div>
          <div class="flex flex-wrap gap-1.5">
            {project.tools.map((t) => (
              <span class="text-xs bg-gray-100 text-gray-700 px-2 py-0.5 rounded-md">
                {t}
              </span>
            ))}
          </div>
        </div>

        <div class="mt-4 flex items-center gap-1 text-sm font-semibold text-blue-600 group-hover:gap-2 transition-all">
          Start Project Workflow →
        </div>
      </a>
    ))}
  </div>

  <div class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white rounded-xl p-8 shadow-sm text-center">
    <h2 class="text-2xl font-bold mb-2">Have a Custom Project in Mind?</h2>
    <p class="text-blue-100 max-w-2xl mx-auto mb-6 text-sm">
      You can also explore our directory of 100 free standalone calculators for specific material takeoffs.
    </p>
    <a href="/calculators" class="inline-block bg-white text-blue-700 font-semibold px-6 py-3 rounded-lg hover:bg-blue-50 transition-colors text-sm">
      Browse All 100 Calculators →
    </a>
  </div>

</Layout>

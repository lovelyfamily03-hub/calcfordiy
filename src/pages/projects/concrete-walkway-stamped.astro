---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Curved Bender Board Formwork & Compacted Base",
    description: "Stake 1/2\" hardboard bender boards to create gentle curved path contours, pitch cross-slopes 1/4\" per foot for rain drainage, and compact 4 inches of crushed stone base.",
    calculatorName: "Gravel Base & Crushed Stone Calculator",
    href: "/calculators/gravel-driveway",
    icon: "📐"
  },
  {
    stepNumber: 2,
    title: "4000 PSI Air-Entrained Pour & Bull Float Leveling",
    description: "Pour 4000 PSI concrete with 5% to 7% air entrainment for freeze-thaw durability, screed with a straightedge, and smooth with a magnesium bull float to bring paste to the surface.",
    calculatorName: "Concrete Slab Calculator",
    href: "/calculators/concrete-slab",
    icon: "🚜"
  },
  {
    stepNumber: 3,
    title: "Color Hardener & Texture Stamping Mats",
    description: "Broadcast dry-shake color hardener in two passes, float into paste, mist liquid or powder release agent, and stamp with interlocking polyurethane texture mats at the plastic plasticity window.",
    calculatorName: "Concrete Footing Calculator",
    href: "/calculators/concrete-footing",
    icon: "🧱"
  },
  {
    stepNumber: 4,
    title: "Early-Entry Control Joints & Solvent Acrylic Sealer",
    description: "Cut control joints within 12 hours spaced maximum 8 to 10 feet apart (24x slab thickness rule), pressure wash residual release powder, and roll high-gloss solvent-based acrylic sealer.",
    calculatorName: "Concrete Slab Calculator",
    href: "/calculators/concrete-slab",
    icon: "✨"
  }
];
---

<Layout
  title="Stamped Concrete Walkway Hub — Step-by-Step Pouring Workflow | CalcForDIY"
  description="Follow a 4-step decorative stamped concrete walkway workflow: Curved bender board forms, 4000 PSI mix, color hardener stamping mats, and control joint cutting."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Stamped Concrete Walkway Hub", "item": "https://calcfordiy.com/projects/concrete-walkway-stamped" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Stamped Concrete Walkway</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-3 border border-emerald-100">
      <span>🏗️ Decorative Masonry &amp; Flatwork</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Stamped Concrete Walkway Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      A stamped concrete walkway delivers the high-end appearance of natural slate, cobblestone, or flagstone with the monolithic durability of concrete. This master workflow covers ACI (American Concrete Institute) standards: bender board curve geometry, air entrainment for frost defense, the plastic stamping window, and the 24x thickness control joint rule.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">1 Weekend (60-ft Walkway)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$3,400 – $5,200 (68%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Industry Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">ACI 302.1R &amp; ASTM C94</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Stamped Concrete Contractor Bid vs. DIY Ready-Mix</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (240 Sq Ft Curved Stamped Walkway)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Decorative concrete contractor quote ($18–$28/sq ft) vs. DIY retail 4000 PSI ready-mix truck, stamping mat rental, color hardener &amp; sealer.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Ready-Mix &amp; Mat Rental Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$1,450 – $1,950</div>
        <div class="text-[11px] text-slate-400 mt-1">3.5 cu yds 4000 PSI concrete, bender board, color hardener, release &amp; mat rental</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Decorative Concrete Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$4,800 – $6,700</div>
        <div class="text-[11px] text-slate-400 mt-1">Specialty Finishing Labor 70% • Stamping Tool Overhead 12% • Materials 18%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$3,350 to $4,750</strong> in your pocket while crafting a custom patterned landscape centerpiece.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute all 4 steps to produce crisp slate textures with zero random shrinkage cracks.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="David Miller, PE"
    role="Structural & Civil Engineering Consultant"
    experience="20+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="How to Hit the 'Plastic Stamping Window'"
    note="Timing is everything in stamped concrete flatwork. If you place your rubber stamping mats onto the concrete too early when bleed water is still on the surface, your body weight will sink the mats 2 inches deep, squishing wet concrete up through the mat seams (slurry blowout). If you wait 45 minutes too late, the slab sets up, and even pounding the mats with a 15-pound rubber tamper will fail to transfer the slate texture. Here is the field thumb test: Touch the concrete with your thumb. If your thumb presses in about 1/4 inch without wet paste sticking to your skin, the slab has entered the perfect 'plastic window'. You have roughly a 45-to-60 minute working window to stamp your entire walkway. Always keep 3 people on site: one applying release agent, one walking and tamping mats, and one detailing borders."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Stamped Concrete Walkways"
    mistakes={[
      {
        number: 1,
        title: "Cutting Control Joints Too Late (> 24 Hours)",
        costImpact: "$2,200 (Random Wild Shrinkage Cracks)",
        description: "As concrete hydrates and cools overnight, it shrinks. If you wait until Monday morning to saw-cut control joints, shrinkage cracks will have already formed across the top.",
        solution: "Saw-cut control joints using an early-entry green concrete saw within 6 to 12 hours after finishing, before internal tensile stresses exceed the concrete strength."
      },
      {
        number: 2,
        title: "Spacing Control Joints Farther than 10 Feet Apart",
        costImpact: "$1,500 (Mid-Span Transverse Cracking)",
        description: "On a 4-inch thick walkway slab, spacing control joints 15 or 20 feet apart violates the 24x to 30x thickness rule (4\" x 24 = 96\" / 8 feet maximum spacing).",
        solution: "Cut control joints every 6 to 8 feet on a 4-inch walkway, disguised within the stamped stone grout lines wherever possible."
      },
      {
        number: 3,
        title: "Sealing with Cheap Water-Based Acrylic Sealer",
        costImpact: "$850 (Milky White Haze & Flaking)",
        description: "Water-based sealers blush and turn opaque milky white when exposed to puddling water and morning dew on decorative stamped slabs.",
        solution: "Use a high-solids (25% to 30%) solvent-based pure acrylic sealer (like Super Seal 30) infused with shark-grip micronized non-slip polymer beads."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Stamped Concrete Workflow"
    reviews={[
      {
        author: "Curtis & Hannah B.",
        location: "Columbus, OH",
        projectScope: "70-ft Curved Roman Slate Walkway",
        savingsClaim: "Saved $4,200 vs Pro Finisher",
        feedback: "Rented 6 interlocking Roman Slate stamps from Sunbelt. The thumb test worked like magic—we started stamping from the front porch out toward the driveway. The early saw cuts in the stone joints make the joints completely invisible.",
        keyTakeaway: "Use liquid release agent with a garden pump sprayer if working near white vinyl siding; powder release blows in the wind and stains houses."
      },
      {
        author: "Tony M.",
        location: "Dallas, TX",
        projectScope: "Ashlar Slate Front Entry Pathway",
        savingsClaim: "Zero Cracks After 2 Summers",
        feedback: "Followed the 24x rule and put joints every 8 feet on our 4-inch pour. Survived 105°F Texas summer heat and winter freezes with zero cracks. The solvent-based sealer brings out the deep walnut color tones.",
        keyTakeaway: "Add non-slip grip powder to the final sealer coat; smooth stamped slate is slick as ice when wet without anti-slip aggregate."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Stamped Concrete Walkway Hub" initialYesCount={359} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="ACI 302.1R (Concrete Floor & Slab Construction) & ACI 224R (Control of Cracking)"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/concrete-control-joint-spacing-rule" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Control Joint Spacing Guide →</div>
        <div class="text-xs text-gray-500 mt-1">The 24x to 30x slab thickness rule, depth formulas (1/4 slab depth), and early timing.</div>
      </a>
      <a href="/calculators/concrete-slab" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Slab Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate cubic yards, ready-mix truckloads, and gravel sub-base tons.</div>
      </a>
      <a href="/projects/monolithic-slab-pour" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Monolithic Slab Pour Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Structural concrete workflow: thickened edge footings, rebar grid, and finishing.</div>
      </a>
    </div>
  </div>

</Layout>

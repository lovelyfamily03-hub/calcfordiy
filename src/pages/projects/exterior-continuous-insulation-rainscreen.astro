---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Vapor-Permeable Self-Adhered WRB Air Barrier Installation & Detailing",
    description: "Prepare exterior OSB/plywood sheathing. Roll out self-adhering vapor-permeable weather-resistive barrier (WRB) membrane with 3-inch horizontal and 6-inch vertical overlaps. Detail window/door rough openings with 4-inch stretchable flashing tape, creating a continuous airtight building envelope.",
    calculatorName: "Cascadia Clip Insulation Calculator",
    href: "/calculators/cascadia-clip-insulation",
    icon: "🛡️"
  },
  {
    stepNumber: 2,
    title: "Structural Stud Layout & Thermally Broken Fiberglass Clip Fastening",
    description: "Snap vertical chalk lines marking structural 2x4/2x6 wood framing studs at 16-inch or 24-inch o.c. Drive engineered fiberglass thermal clips (Cascadia Clips or equivalent) directly into studs using #14 structural screws, calculating clip dead load ratings for fiber cement siding.",
    calculatorName: "Wall Stud & Framing Lumber Calculator",
    href: "/calculators/wall-framing",
    icon: "📐"
  },
  {
    stepNumber: 3,
    title: "Rigid Mineral Wool Board Impaling & Friction-Fit Staggering",
    description: "Impale semi-rigid mineral wool insulation boards (Rockwool Comfortboard 80 or 110, 2-inch to 4-inch depth, R-8 to R-16) tightly over the fiberglass clips. Stagger vertical joints by at least 12 inches and friction-fit all edges to eliminate convection gaps and thermal bypasses.",
    calculatorName: "Cascadia Clip & Thermal Insulation Estimator",
    href: "/calculators/cascadia-clip-insulation",
    icon: "🧱"
  },
  {
    stepNumber: 4,
    title: "Rainscreen Cladding Furring Channels, Insect Screen & Siding Hang",
    description: "Fasten 18-gauge galvanized steel or aluminum hat channels horizontally or vertically across clip flanges. Install perforated insect screen at the base weep and top venting gap (minimum 3/8-inch continuous drainage plane), and hang exterior fiber cement, composite, or metal siding.",
    calculatorName: "Board and Batten Siding Calculator",
    href: "/calculators/board-and-batten-siding",
    icon: "🔨"
  }
];
---

<Layout
  title="Continuous Exterior Insulation (ci) & Rainscreen Hub | CalcForDIY"
  description="Complete guide to installing continuous exterior insulation with fiberglass thermal clips and rainscreen drainage cavities: WRB, rockwool, hat channels, and siding."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Continuous Exterior Insulation Hub", "item": "https://calcfordiy.com/projects/exterior-continuous-insulation-rainscreen" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Install Continuous Exterior Insulation and a Rainscreen Assembly",
    "description": "Step-by-step engineering guide for installing continuous exterior insulation using fiberglass thermal clips, mineral wool, and ventilated rainscreen furring.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "WRB Air Barrier Application",
        "text": "Apply vapor-permeable self-adhered WRB with proper overlaps and window sill flashing."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Fiberglass Thermal Clip Fastening",
        "text": "Layout structural studs and drive thermal break clips directly into wall framing."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Mineral Wool Board Installation",
        "text": "Impale semi-rigid mineral wool boards tightly over clips with staggered joints."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Rainscreen Channels & Siding Attachment",
        "text": "Fasten hat channels to clip faces, secure base insect screen, and fasten cladding."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Exterior Continuous Insulation Hub</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-gradient-to-br from-slate-900 via-stone-900 to-slate-900 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xl not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold mb-4 border border-amber-400/30">
      <span>🛡️ High-Performance Building Envelope</span>
      <span>•</span>
      <span>ASHRAE 90.1 &amp; IECC 2024 Compliant</span>
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4 text-white">
      Continuous Exterior Insulation (ci) &amp; Rainscreen Assembly Hub
    </h1>

    <p class="text-slate-300 text-base sm:text-lg max-w-3xl leading-relaxed mb-6">
      Continuous exterior insulation (ci) eliminates thermal bridging through wall studs, keeping structural framing warm, dry, and free of condensation. By pairing non-conductive fiberglass thermal clips with fireproof mineral wool and a ventilated rainscreen cavity, your home achieves true commercial-grade efficiency and unlimited drying capacity.
    </p>

    <!-- Visual Job-Site Photography -->
    <div class="mb-6">
      <img
        src="/images/projects/exterior-continuous-insulation-rainscreen.jpg"
        alt="Installation of mineral wool exterior continuous insulation with fiberglass thermal clips and rainscreen channels"
        class="w-full h-56 sm:h-72 md:h-84 lg:h-96 object-cover rounded-xl shadow-md border border-slate-700/80"
        loading="eager"
      />
      <p class="text-xs text-slate-400 mt-2 italic text-center sm:text-left">
        Job-site installation: Mineral wool boards impaled over fiberglass thermal spacer clips with vertical metal rainscreen furring channels fastened to clip faces.
      </p>
    </div>

    <!-- Contractor Cost vs DIY Savings Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-700/80">
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">Turnkey Cladding Subcontractor</div>
        <div class="text-2xl font-black text-rose-400 mt-1">$22,000 – $32,000</div>
        <div class="text-xs text-slate-400 mt-0.5">2,400 sq ft Wall Area (Clips + Siding)</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">DIY Material &amp; Tool Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$9,400 – $13,200</div>
        <div class="text-xs text-slate-400 mt-0.5">Clips + Rockwool + WRB + Furring</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">Estimated DIY Labor Equity</div>
        <div class="text-2xl font-black text-blue-400 mt-1">$12,600 – $18,800</div>
        <div class="text-xs text-slate-400 mt-0.5">Save $5.25–$7.80 per sq ft</div>
      </div>
    </div>
  </div>

  <!-- Phased Workflow Section -->
  <div class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
      <span>🏗️</span> 4-Phase Exterior Envelope Sequence
    </h2>

    <div class="space-y-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 sm:p-6 shadow-xs hover:border-blue-300 transition-all">
          <div class="flex items-start gap-4">
            <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-blue-100 text-blue-700 font-black text-lg shrink-0">
              {step.stepNumber}
            </span>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                {step.title}
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed mb-4">
                {step.description}
              </p>
              <a
                href={step.href}
                class="inline-flex items-center gap-2 text-xs font-semibold text-blue-600 bg-blue-50 px-3 py-1.5 rounded-lg hover:bg-blue-100 transition-colors"
              >
                <span>{step.icon} Open {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Budget Breakdown Table -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-10 not-prose shadow-xs">
    <h2 class="text-xl font-bold text-gray-900 mb-4">
      2,000 Sq Ft Exterior ci Assembly Material Takeoff
    </h2>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm border-collapse">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50 text-gray-700 font-semibold">
            <th class="p-3">Material Component</th>
            <th class="p-3">Specification</th>
            <th class="p-3">Coverage / Qty</th>
            <th class="p-3">Total DIY Cost</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-gray-600">
          <tr>
            <td class="p-3 font-medium text-gray-900">Fiberglass Thermal Clips (Cascadia)</td>
            <td class="p-3">4.0-inch standoff, structural fiberglass matrix</td>
            <td class="p-3">380 Clips</td>
            <td class="p-3 font-mono">$2,280</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">Rockwool Comfortboard 80 (3-inch)</td>
            <td class="p-3">R-12 continuous, fireproof mineral wool (8 lb/cu ft)</td>
            <td class="p-3">2,200 sq ft</td>
            <td class="p-3 font-mono">$3,740</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">Self-Adhered Vapor-Permeable WRB</td>
            <td class="p-3">30+ Perms, air barrier membrane with primer</td>
            <td class="p-3">5 Rolls</td>
            <td class="p-3 font-mono">$1,850</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">18-Ga Galvanized Steel Hat Channels</td>
            <td class="p-3">7/8" hat channel, 10-ft lengths</td>
            <td class="p-3">120 Pieces</td>
            <td class="p-3 font-mono">$960</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">Perforated Insect Weep Screed &amp; Fasteners</td>
            <td class="p-3">Aluminum Cor-A-Vent, #14 structural wood screws</td>
            <td class="p-3">Perimeter Lot</td>
            <td class="p-3 font-mono">$480</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="David Miller, PE"
    role="Structural & Civil Engineering Consultant"
    experience="25+ Years Envelope Design"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="Always Fasten Thermal Clips Directly into Studs, Not OSB Sheathing"
    note="A common field failure in DIY continuous insulation projects is driving clip fasteners into 7/16-inch OSB sheathing between studs. With heavy fiber cement or engineered wood siding weighing 3 to 5 lbs per square foot, OSB lacks adequate withdrawal and shear resistance. Every single thermal clip must hit solid 2x4 or 2x6 framing. Use a laser line or pre-drill small pilot holes inside before installing exterior insulation."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    mistakes={[
      {
        title: "Using Traditional Steel Z-Girts Instead of Thermally Broken Clips",
        impact: "50% Effective R-Value Degradation",
        description: "Standard metal Z-girts conduct heat straight out of the building. An R-15 mineral wool layer over continuous steel Z-girts delivers an effective thermal performance of only R-7.2 per ASHRAE 90.1 Table A9.4."
      },
      {
        title: "Omitting the Base and Top Rainscreen Insect Ventilation Screens",
        impact: "Wasp, Hornet & Rodent Nesting in Wall Cavities",
        description: "The 3/4-inch gap behind your rainscreen furring creates a chimney effect for moisture removal. If you don't cap the top and bottom with continuous perforated stainless or aluminum mesh, pests will colonize the space."
      },
      {
        title: "Installing a Vapor Barrier on the Cold Side of Mineral Wool in Climate Zones 5-7",
        impact: "Catastrophic Hidden Wall Sheathing Rot",
        description: "The exterior WRB must be vapor-permeable (minimum 15 to 30 perms). If you wrap polyethylene or a non-breathable asphalt felt over exterior insulation, interior moisture cannot dry to the exterior, rotting wall framing within two seasons."
      }
    ]}
  />

  <!-- Community Reviews -->
  <CommunityReviews
    reviews={[
      {
        name: "Kevin & Rachel L.",
        location: "Minneapolis, MN",
        projectScope: "3-inch Rockwool ci Retrofit over 1970s Split-Level",
        costSaved: "Saved $14,200 in Siding Labor",
        feedback: "Our winter heating bills dropped by 42% immediately. Using the Cascadia clip calculator, we spaced our clips at 32 inches vertically on 16-inch centers. The walls are dead silent, draft-free, and our fiber cement siding hangs perfectly plumb."
      },
      {
        name: "Marc T.",
        location: "Seattle, WA",
        projectScope: "Deep Energy Retrofit with Continuous Rainscreen",
        costSaved: "Saved $11,500",
        feedback: "The rainscreen gap is vital in the Pacific Northwest. After a week of torrential rain, I checked behind the furring channels and the WRB was completely dry. Worth every dollar."
      }
    ]}
  />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="ASHRAE 90.1, IECC 2024 & ASTM E2357 Standards"
    lastUpdated="September 2026"
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Continuous Exterior Insulation Hub" initialYesCount={156} />

</Layout>

---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Wall Framing & Stud Spacing",
    description: "Calculate field studs, corner studs, top/bottom plates, and opening framing for perimeter and partition walls.",
    calculatorName: "Wall Framing Calculator",
    href: "/calculators/wall-framing/",
    icon: "🪵"
  },
  {
    stepNumber: 2,
    title: "Drywall Sheets & Joint Compound",
    description: "Estimate 4x8 or 4x12 drywall sheets for walls and ceiling, joint compound pails, and paper tape rolls.",
    calculatorName: "Drywall Estimator Calculator",
    href: "/calculators/drywall/",
    icon: "🧱"
  },
  {
    stepNumber: 3,
    title: "Subfloor Plywood / OSB Panels",
    description: "Calculate 4x8 tongue-and-groove subfloor panels, subfloor adhesive tubes, and screw counts.",
    calculatorName: "Subfloor Calculator",
    href: "/calculators/subfloor/",
    icon: "📐"
  },
  {
    stepNumber: 4,
    title: "Laminate or Hardwood Flooring",
    description: "Calculate flooring boxes based on room square footage, waste factor (8-10%), and foam underlayment rolls.",
    calculatorName: "Laminate Flooring Calculator",
    href: "/calculators/laminate-flooring/",
    icon: "🪵"
  },
  {
    stepNumber: 5,
    title: "Recessed Ceiling Can Lights",
    description: "Determine exact recessed light count, spacing from walls, and light-to-light spacing for balanced ceiling illumination.",
    calculatorName: "Recessed Lighting Calculator",
    href: "/calculators/recessed-lights-living-room/",
    icon: "💡"
  }
];
---

<Layout
  title="Basement & Room Finishing Hub — Step-by-Step Remodel Workflow | CalcForDIY"
  description="Follow a 5-step basement finishing workflow: wall framing, drywall, subfloor, laminate/hardwood flooring, and recessed lighting."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Plan and Calculate Basement Remodeling Materials",
    "description": "A 5-step DIY workflow for calculating framing studs, drywall sheets, subfloor OSB, laminate flooring, and recessed lighting.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Calculate Wall Framing", "url": "https://calcfordiy.com/calculators/wall-framing/" },
      { "@type": "HowToStep", "position": 2, "name": "Calculate Drywall Sheets", "url": "https://calcfordiy.com/calculators/drywall/" },
      { "@type": "HowToStep", "position": 3, "name": "Calculate Subfloor Panels", "url": "https://calcfordiy.com/calculators/subfloor/" },
      { "@type": "HowToStep", "position": 4, "name": "Calculate Laminate Flooring", "url": "https://calcfordiy.com/calculators/laminate-flooring/" },
      { "@type": "HowToStep", "position": 5, "name": "Calculate Recessed Lighting", "url": "https://calcfordiy.com/calculators/recessed-lights-living-room/" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://calcfordiy.com/projects/" },
      { "@type": "ListItem", "position": 3, "name": "Basement Finishing Hub", "item": "https://calcfordiy.com/projects/basement-finishing/" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects/" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span>Basement Finishing Hub</span>
  </div>

  <div class="mb-8 bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-2">
      <span class="text-3xl">🔨</span>
      <h1 class="text-3xl font-bold text-gray-900">Basement &amp; Room Finishing Hub</h1>
    </div>
    <p class="text-gray-600 text-lg leading-relaxed max-w-3xl">
      Transforming unfinished space into living area requires precise material takeoffs for framing, drywall, subfloor, finish flooring, and ceiling lighting.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-blue-300 transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="bg-blue-600 text-white font-bold w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-lg shadow-sm">
            {step.stepNumber}
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xl">{step.icon}</span>
              <h2 class="text-xl font-bold text-gray-900">{step.title}</h2>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed max-w-2xl">
              {step.description}
            </p>
          </div>
        </div>

        <a href={step.href} class="shrink-0 w-full md:w-auto bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-5 py-3 rounded-lg border border-blue-200 transition-colors text-sm flex items-center justify-center gap-2">
          Use {step.calculatorName} →
        </a>
      </div>
    ))}
  </div>

  <!-- Basement Building Science & Code Sequence -->
  <section class="bg-white border border-gray-200 rounded-xl p-6 mb-8 space-y-4">
    <h2 class="text-xl font-bold text-gray-900">Basement Code, Moisture Control &amp; Life-Safety Checkpoints</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-700 leading-relaxed">
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
        <h3 class="font-bold text-gray-900 mb-1">1. Rigid XPS Foam Before Stud Framing</h3>
        <p>Never place paper-faced fiberglass batts directly against bare poured concrete—condensation feeds hidden mold behind drywall. Glue minimum 2-inch closed-cell XPS rigid foam (R-10+ per IECC Climate Zones 4–7) directly to foundation walls and tape seams before framing floating stud walls.</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
        <h3 class="font-bold text-gray-900 mb-1">2. Egress Windows &amp; Fireblocking (IRC R310 / R302)</h3>
        <p>Finished habitable basements and sleeping rooms require IRC Section R310 emergency escape openings with minimum 5.7 sq ft net clear opening (5.0 sq ft at grade), minimum 20" width, 24" height, and 44" max sill height. Install solid 2x fireblocking along stud top plates and soffit chases per IRC R302.11.</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
        <h3 class="font-bold text-gray-900 mb-1">3. Pressure-Treated Bottom Plates &amp; Floating Expansion</h3>
        <p>Anchor ground-contact ACQ/CA-C bottom plates (plus closed-cell foam sill gasket) into concrete slabs using corrosion-resistant Tapcon or stainless fasteners—or frame floating walls in expansive clay areas to keep floor uplift from buckling upstairs joists.</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
        <h3 class="font-bold text-gray-900 mb-1">4. Subfloor &amp; Stairway Headroom Clearances</h3>
        <p>Verify minimum 7-foot finished ceiling height (6'4" under structural beams and ductwork per IRC R305.1) before hanging framing, and measure doorway widths against 12-foot drywall panel turning radius.</p>
      </div>
    </div>
  </section>

  <!-- Cross-Linked Engineering Guides & Dispatches -->
  <section class="bg-gray-50 border border-gray-200 rounded-xl p-6">
    <h2 class="text-lg font-bold text-gray-900 mb-3">Related Basement Framing Guides &amp; Field Reports</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
      <a href="/guides/how-many-studs-for-a-wall/" class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-400 transition-colors">
        <div class="font-semibold text-gray-900">How Many Studs Do I Need for a Wall? →</div>
        <div class="text-xs text-gray-600 mt-1">Exact math for 16" o.c. framing, California corners, T-junctions, and openings.</div>
      </a>
      <a href="/guides/drywall-sheet-size-8-vs-12-ft/" class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-400 transition-colors">
        <div class="font-semibold text-gray-900">Drywall Sheet Size Guide: 8 ft vs. 10 ft vs. 12 ft →</div>
        <div class="text-xs text-gray-600 mt-1">Cut butt joints in half while checking basement stairwell turn clearances first.</div>
      </a>
      <a href="/guides/lvl-beam-selection-span-tables/" class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-400 transition-colors">
        <div class="font-semibold text-gray-900">LVL Engineered Beam Span &amp; Bearing Guide →</div>
        <div class="text-xs text-gray-600 mt-1">Inspect load paths, jack studs, and footing pads before removing basement posts.</div>
      </a>
      <a href="/projects/coffered-ceiling-box-beams/" class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-400 transition-colors">
        <div class="font-semibold text-gray-900">Coffered Ceiling Layout Hub →</div>
        <div class="text-xs text-gray-600 mt-1">Turn low structural steel beams and HVAC soffits into balanced ceiling coffers.</div>
      </a>
      <a href="/journal/the-4800-dollar-sump-pump-mistake-hydrostatic-pressure/" class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-400 transition-colors md:col-span-2">
        <div class="font-semibold text-gray-900">Field Dispatch: The $4,800 Sump Pump Failure →</div>
        <div class="text-xs text-gray-600 mt-1">Never hang basement drywall or carpet before validating battery backup pump flow against storm TDH.</div>
      </a>
    </div>
  </section>

</Layout>

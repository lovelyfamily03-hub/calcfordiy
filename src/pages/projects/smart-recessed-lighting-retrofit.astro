---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Ceiling Joist Scanning, Grid Layout & Symmetrical Centerlines",
    description: "Map all ceiling joists or attic trusses with a deep-scanning stud finder. Calculate fixture spacing based on ceiling height (typically 4 to 6 feet apart and 2.5 to 3 feet from walls per IES LP-2 guidelines). Snap chalk lines or laser grid lines, and verify no fixture lands directly on a joist.",
    calculatorName: "Recessed Lighting Layout Calculator",
    href: "/calculators/recessed-lights-living-room",
    icon: "📐"
  },
  {
    stepNumber: 2,
    title: "Hole Saw Cutouts with Dust Bowl & Junction Box Daisy Chaining",
    description: "Cut circular holes using a 6-1/4-inch or 4-1/4-inch adjustable hole saw equipped with a clear silicone dust catcher bowl. Fish NM-B 14/2 Romex wire from an existing light box or feed circuit, routing through ceiling joists using steel nail plates where wire passes within 1-1/4-inch of joist faces per NEC 300.4.",
    calculatorName: "Lumens & Foot-Candle Room Calculator",
    href: "/calculators/lumens",
    icon: "🕳️"
  },
  {
    stepNumber: 3,
    title: "Driver Junction Box Wiring & CCT Color Temperature Selection",
    description: "Each canless wafer features an independent aluminum remote junction box. Strip 1/2-inch of wire, secure NM-B with push-in push-wire connectors, and clamp Romex cables with integrated NM cable clamps. Toggle the selector switch to desired CCT (Warm White 3000K for bedrooms, Bright White 4000K for kitchens/workshops).",
    calculatorName: "Bedroom Recessed Lighting Calculator",
    href: "/calculators/recessed-lights-bedroom",
    icon: "⚡"
  },
  {
    stepNumber: 4,
    title: "Spring-Clip Installation & Smart Neutral-Wire Dimmer Setup",
    description: "Tuck the remote driver box up through the drywall hole into the ceiling plenum. Fold the two spring-loaded orange tension clips upward, push the ultra-thin wafer flush into the drywall, and release so clips snap down tightly against the top of the drywall. Wire a compatible ELV/LED smart dimmer switch with dedicated neutral wire.",
    calculatorName: "Hallway Recessed Lights Calculator",
    href: "/calculators/recessed-lights-hallway",
    icon: "💡"
  }
];
---

<Layout
  title="Canless Wafer Recessed Lighting Retrofit Hub | CalcForDIY"
  description="Complete guide to retrofitting ultra-thin canless LED wafer recessed lights: ceiling grid math, hole saw cutting, daisy-chain NM-B wiring, and smart dimming."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Canless Wafer Lighting Hub", "item": "https://calcfordiy.com/projects/smart-recessed-lighting-retrofit" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Install Canless LED Wafer Recessed Lights",
    "description": "Step-by-step residential electrical guide for retrofitting ultra-thin canless LED wafer pot lights into finished drywall ceilings.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Joist Scanning & Ceiling Grid Layout",
        "text": "Locate joists and plan symmetrical grid spacing maintaining 3 ft from perimeter walls."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Dust Bowl Hole Cutting & Cable Fishing",
        "text": "Cut drywall with a 6-1/4-inch hole saw and fish 14/2 NM-B wire from fixture to fixture."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Remote Junction Box Wiring & CCT Select",
        "text": "Wire aluminum driver boxes, connect grounds, and select 3000K or 4000K color temperature."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Spring-Clip Snap & Smart Dimmer Install",
        "text": "Tuck junction box into ceiling, snap spring clips flush against drywall, and wire smart dimmer."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Smart Recessed Lighting Hub</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-gradient-to-br from-slate-900 via-yellow-950 to-slate-900 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xl not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-yellow-500/20 text-yellow-300 text-xs font-semibold mb-4 border border-yellow-400/30">
      <span>💡 Architectural Lighting &amp; Electrical Retrofit</span>
      <span>•</span>
      <span>NEC Article 410 &amp; IES LP-2 Compliant</span>
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4 text-white">
      Canless LED Wafer Recessed Lighting Retrofit Hub
    </h1>

    <p class="text-slate-300 text-base sm:text-lg max-w-3xl leading-relaxed mb-6">
      Canless LED wafers have made old bulky metal recessed cans completely obsolete. At just 1/2-inch thick, these ultra-slim Type-IC and Air-Tight fixtures install anywhere—even directly beneath joists, ductwork, and plumbing pipes—without tearing down ceiling drywall.
    </p>

    <!-- Visual Job-Site Photography -->
    <div class="mb-6">
      <img
        src="/images/projects/smart-recessed-lighting-retrofit.jpg"
        alt="Electrician installing canless LED wafer recessed light with Romex wire and spring clips into ceiling hole"
        class="w-full h-56 sm:h-72 md:h-84 lg:h-96 object-cover rounded-xl shadow-md border border-slate-700/80"
        loading="eager"
      />
      <p class="text-xs text-slate-400 mt-2 italic text-center sm:text-left">
        Job-site installation: 6-inch canless LED wafer fixture with remote aluminum junction box and Romex wire ready to snap flush into drywall ceiling.
      </p>
    </div>

    <!-- Contractor Cost vs DIY Savings Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-700/80">
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">Licensed Electrical Contractor</div>
        <div class="text-2xl font-black text-rose-400 mt-1">$1,600 – $2,400</div>
        <div class="text-xs text-slate-400 mt-0.5">8 Pot Lights ($175–$250 per opening)</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">DIY Fixtures &amp; Wiring Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$220 – $340</div>
        <div class="text-xs text-slate-400 mt-0.5">8-Pack Wafers + 14/2 Romex + Smart Dimmer</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">Total Weekend DIY Savings</div>
        <div class="text-2xl font-black text-blue-400 mt-1">$1,380 – $2,060</div>
        <div class="text-xs text-slate-400 mt-0.5">Save $150+ per Fixture Location</div>
      </div>
    </div>
  </div>

  <!-- Phased Workflow Section -->
  <div class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
      <span>⚡</span> 4-Phase Recessed Lighting Sequence
    </h2>

    <div class="space-y-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 sm:p-6 shadow-xs hover:border-blue-300 transition-all">
          <div class="flex items-start gap-4">
            <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-blue-100 text-blue-700 font-black text-lg shrink-0">
              {step.stepNumber}
            </span>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                {step.title}
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed mb-4">
                {step.description}
              </p>
              <a
                href={step.href}
                class="inline-flex items-center gap-2 text-xs font-semibold text-blue-600 bg-blue-50 px-3 py-1.5 rounded-lg hover:bg-blue-100 transition-colors"
              >
                <span>{step.icon} Open {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Budget Breakdown Table -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-10 not-prose shadow-xs">
    <h2 class="text-xl font-bold text-gray-900 mb-4">
      8-Light Living Room Retrofit Material Takeoff
    </h2>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm border-collapse">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50 text-gray-700 font-semibold">
            <th class="p-3">Material Component</th>
            <th class="p-3">Specification</th>
            <th class="p-3">Quantity</th>
            <th class="p-3">Average DIY Cost</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-gray-600">
          <tr>
            <td class="p-3 font-medium text-gray-900">6-inch Canless LED Wafers (5-CCT)</td>
            <td class="p-3">12W / 1,050 Lumens, Type IC, Wet Rated, 90+ CRI</td>
            <td class="p-3">8-Pack</td>
            <td class="p-3 font-mono">$115</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">NM-B 14/2 Non-Metallic Sheathed Cable</td>
            <td class="p-3">UL Listed copper 15A branch circuit wire</td>
            <td class="p-3">100-Ft Coil</td>
            <td class="p-3 font-mono">$58</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">Lutron Caséta Smart Dimmer Switch</td>
            <td class="p-3">LED+ dimmer with wallplate (works without neutral)</td>
            <td class="p-3">1 Unit</td>
            <td class="p-3 font-mono">$65</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">6-1/4-Inch Hole Saw with Dust Bowl</td>
            <td class="p-3">Bi-metal teeth with transparent silicone seal</td>
            <td class="p-3">1 Tool</td>
            <td class="p-3 font-mono">$32</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">Lever-Nut Wire Connectors &amp; Fish Tape</td>
            <td class="p-3">WAGO 221 lever connectors + 25-ft steel fish tape</td>
            <td class="p-3">1 Kit</td>
            <td class="p-3 font-mono">$28</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Marcus Vance"
    role="Licensed Master Electrician & MEP Systems Specialist"
    experience="22+ Years Field Service"
    avatarBg="bg-blue-100 text-blue-800"
    initials="MV"
    title="Why You Must Use Forward-Phase (TRIAC) or Reverse-Phase (ELV) Rated Dimmers"
    note="Do not reuse an old incandescent turn-dial dimmer switch with LED wafers! Standard incandescent dimmers chop the AC voltage sine wave crudely, causing LED driver capacitors to hum loudly and the lights to strobe like a nightclub at low brightness. Always pair your canless wafer lights with a dedicated LED+ dimmer (such as Lutron Diva LED+ or Caséta) that allows you to calibrate the low-end trim."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    mistakes={[
      {
        title: "Cutting Holes Directly Below an Attic Truss Without Verifying Clearance",
        impact: "$250 Drywall Patching & Ceiling Re-Painting",
        description: "While wafer lights are only 1/2-inch thick, their remote junction boxes are 1.5 inches thick. If you cut directly on top of a 2x4 truss bottom chord, the remote box cannot fit into the ceiling cavity unless placed adjacent."
      },
      {
        title: "Daisy-Chaining More than 10 Wafers on a Non-Derated Circuit",
        impact: "Voltage Drop & End-of-Run Flickering",
        description: "While 12W LED lights draw under 0.1 amps each, long 100-foot wiring runs with multiple loose push-in wire connectors create cumulative resistance that results in noticeable dimming at the last fixture in the line."
      },
      {
        title: "Buying Cheap Non-IC Rated Recessed Cans in Insulated Ceilings",
        impact: "Severe Attic Fire Hazard & Thermal Overload Cutout",
        description: "In ceilings with blown fiberglass or cellulose insulation, fixtures must be marked Type IC (Insulation Contact). Non-IC fixtures will overheat and shut off repeatedly via their internal thermal fuse."
      }
    ]}
  />

  <!-- Community Reviews -->
  <CommunityReviews
    reviews={[
      {
        name: "David & Laura K.",
        location: "Salt Lake City, UT",
        projectScope: "12 Canless Wafers in Great Room & Kitchen",
        costSaved: "Saved $2,100",
        feedback: "We replaced an ugly center fluorescent fixture with 12 canless wafers. The hole saw with dust bowl caught 98% of the drywall dust. Setting the CCT switch to 3000K transformed our dark living room into an architectural masterpiece."
      },
      {
        name: "Anthony C.",
        location: "Philadelphia, PA",
        projectScope: "Basement Drop Ceiling to Drywall Lighting Retrofit",
        costSaved: "Saved $1,500",
        feedback: "My basement ceiling only has 2.5 inches of clearance below the main plumbing pipes. Old remodel cans were impossible. These 1/2-inch wafers slipped right in with zero clearance issues."
      }
    ]}
  />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Licensed Master Electrician & MEP Systems Specialist"
    codeStandard="IES LP-2 Living Room Foot-Candle Guidelines (15-20 FC) & NEC Article 210-inch
    lastUpdated="September 2026"
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Canless Wafer Retrofit Hub" initialYesCount={176} />

</Layout>

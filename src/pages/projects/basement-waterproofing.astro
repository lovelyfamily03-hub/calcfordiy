---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Interior French Drain Trench & Perforated Pipe",
    description: "Calculate 3/4\" washed gravel tons, 4\" perforated drain tile linear feet, and non-woven geotextile fabric envelope for perimeter basement drainage.",
    calculatorName: "French Drain Calculator",
    href: "/calculators/french-drain/",
    icon: "💧"
  },
  {
    stepNumber: 2,
    title: "Sump Pump Capacity & Horsepower Sizing",
    description: "Determine required GPH flow rate, Total Dynamic Head (TDH), submersible pump horsepower (1/3 HP, 1/2 HP, 3/4 HP), and emergency battery backup runtime.",
    calculatorName: "Sump Pump Sizing Calculator",
    href: "/calculators/sump-pump-sizing/",
    icon: "⚡"
  },
  {
    stepNumber: 3,
    title: "Discharge Pipe Gravity Slope & Exit Elevation",
    description: "Calculate sewer pipe fall (1/8\" to 1/4\" per foot), exterior trench depth, and scouring flow velocity to safely route water away from the foundation.",
    calculatorName: "Pipe Slope Calculator",
    href: "/calculators/pipe-slope/",
    icon: "📐"
  },
  {
    stepNumber: 4,
    title: "Dry Subfloor Moisture Barrier & Plywood Sheets",
    description: "Calculate dimpled vapor barrier underlayment rolls and 4x8 tongue-and-groove subfloor OSB/plywood panels for a dry, mold-free basement living space.",
    calculatorName: "Subfloor Calculator",
    href: "/calculators/subfloor/",
    icon: "🪵"
  }
];
---

<Layout
  title="Basement Waterproofing Hub — Step-by-Step Drainage & Sump Pump Workflow | CalcForDIY"
  description="Follow a 4-step DIY basement waterproofing workflow: Interior French drain trenching, sump pump horsepower sizing, discharge pipe slope, and subfloor moisture barrier."
  image="/images/projects/basement-waterproofing.jpg"
  imageAlt="Finished dry basement with interior French drain perimeter channel, sealed sump pump basin, and dimpled drainage membrane"
  ogType="website"
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects/" },
      { "@type": "ListItem", "position": 3, "name": "Basement Waterproofing Hub — Step-by-Step Drainage & Sump Pump Workflow", "item": "https://calcfordiy.com/projects/basement-waterproofing/" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Plan and Calculate Basement Waterproofing and Drainage",
    "description": "A 4-step DIY workflow for calculating interior French drains, sump pump sizing, discharge pipe slope, and subfloor panels.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Interior French Drain Trenching",
        "text": "Calculate gravel tons, perforated pipe, and geotextile filter fabric."
      },
      {
        "@type": "HowToStep",
        "name": "Sump Pump Capacity Sizing",
        "text": "Determine pump horsepower and Total Dynamic Head (TDH)."
      },
      {
        "@type": "HowToStep",
        "name": "Discharge Pipe Gravity Fall",
        "text": "Calculate elevation drop and trench exit depths per IPC code."
      },
      {
        "@type": "HowToStep",
        "name": "Dry Subfloor Vapor Barrier",
        "text": "Estimate dimpled membrane rolls and subfloor plywood sheets."
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects/" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span>Basement Waterproofing Workflow</span>
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-50 border border-amber-200 rounded-full text-amber-800 text-xs font-semibold mb-3">
      <span>💧 Step-by-Step Drainage Workflow</span>
      <span>•</span>
      <span>4 Integrated Calculators</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Basement Waterproofing &amp; Sump Pump Workflow</h1>
    <p class="text-lg text-gray-600 max-w-3xl">
      Plan, size, and calculate your interior French drain, sump basin pump, exterior discharge pipe slope, and moisture-sealed subfloor in 4 sequential steps.
    </p>
  </div>

  <!-- Editorial Hero Image -->
  <div class="mb-8 overflow-hidden rounded-2xl border border-gray-200 shadow-sm bg-white">
    <img
      src="/images/projects/basement-waterproofing.jpg"
      width="1376"
      height="768"
      fetchpriority="high"
      alt="Finished dry basement with interior French drain perimeter channel, sealed sump pump basin, and dimpled drainage membrane"
      class="w-full h-64 sm:h-80 md:h-96 object-cover"
      loading="eager"
    />
    <div class="p-3 bg-gray-50/80 border-t border-gray-100 text-xs text-gray-500 flex flex-wrap items-center justify-between gap-2">
      <span>📸 Complete interior French drain perimeter system with sealed dual-pump sump basin</span>
      <span class="font-medium text-gray-700">Subsurface Drainage Workflow</span>
    </div>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-400 transition-all">
        <div class="flex items-start gap-4">
          <div class="bg-blue-600 text-white rounded-xl w-10 h-10 flex items-center justify-center font-bold text-lg shrink-0 mt-1">
            {step.stepNumber}
          </div>
          <div class="flex-grow">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xl">{step.icon}</span>
              <h2 class="text-xl font-bold text-gray-900">{step.title}</h2>
            </div>
            <p class="text-gray-600 text-sm mb-4 leading-relaxed">{step.description}</p>
            <a
              href={step.href}
              class="inline-flex items-center gap-2 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-4 py-2 rounded-lg text-sm transition-colors border border-blue-200"
            >
              Open {step.calculatorName} →
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Hydrostatic Pressure, Sump Sizing & Capillary Control -->
  <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 mb-10">
    <h2 class="text-2xl font-bold text-slate-900 mb-3">Hydrostatic Perimeter Relief, Check Valves &amp; Slab Capillary Breaks</h2>
    <p class="text-slate-600 text-sm mb-6">
      Interior latex masonry paint cannot withstand external hydrostatic pressure once water rises around a foundation footing. Dry basements rely on relief drainage and mechanical pumping sized against real friction head:
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 text-sm text-slate-700">
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <h3 class="font-bold text-slate-900 mb-1">1. Total Dynamic Head (TDH) vs. Nominal GPH</h3>
        <p>Pump box labels quote flow at 0 feet of vertical lift. Calculate vertical discharge rise plus 90-degree elbow friction losses at 1-1/2 inch pipe diameter so a 1/3 HP or 1/2 HP cast-iron pump still hits 2,500+ GPH at working head.</p>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <h3 class="font-bold text-slate-900 mb-1">2. Silent Check Valve &amp; Weep Hole Placement</h3>
        <p>Install a spring-loaded silent check valve just above the sump basin cover to stop column water from hammering back down into the crock, and verify a 3/16-inch air-bleed weep hole below the valve to prevent pump air-lock.</p>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <h3 class="font-bold text-slate-900 mb-1">3. Interior Cove Joints &amp; Sealed Sump Lids</h3>
        <p>Hydrostatic seepage typically enters at the cold joint where poured concrete walls rest on the footing. An internal drain tile channel wrapped in #57 washed stone relieves pressure beneath the floor slab before it reaches drywall plates.</p>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <h3 class="font-bold text-slate-900 mb-1">4. Battery Backup Sizing &amp; Surface Grading</h3>
        <p>Pair primary AC sump pumps with a DC marine deep-cycle or LiFePO4 battery backup since heavy thunderstorms knock out utility power at peak groundwater inflow—and discharge exits at least 10 feet downhill from the foundation.</p>
      </div>
    </div>
    <div class="border-t border-slate-200 pt-5">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Engineering Guides &amp; Field Investigations</h3>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm font-medium">
        <li><a href="/guides/dual-check-valve-sump-pump-rules/" class="text-blue-700 hover:underline">&rarr; Dual-Pump &amp; Silent Check Valve Sump Pit Plumbing Rules</a></li>
        <li><a href="/guides/tdh-well-pump-formula-guide/" class="text-blue-700 hover:underline">&rarr; Total Dynamic Head (TDH) &amp; Pipe Friction Formula Guide</a></li>
        <li><a href="/guides/concrete-mix-ratios-psi-curing/" class="text-blue-700 hover:underline">&rarr; Trench Patch Concrete Mix Ratios &amp; Hydraulic Repair Specs</a></li>
        <li><a href="/journal/the-4800-dollar-sump-pump-mistake-hydrostatic-pressure/" class="text-blue-700 hover:underline">&rarr; Field Dispatch: The $4,800 Sump Pump &amp; Hydrostatic Failure</a></li>
        <li><a href="/journal/the-peeling-epoxy-disaster-moisture-vapor-transmission/" class="text-blue-700 hover:underline">&rarr; Field Dispatch: Slab Vapor Transmission &amp; Floor Coating Delamination</a></li>
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <div class="bg-gradient-to-r from-slate-900 to-blue-950 rounded-2xl p-8 text-white text-center">
    <h2 class="text-2xl font-bold mb-2">Need More Home Improvement Calculators?</h2>
    <p class="text-slate-300 text-sm max-w-2xl mx-auto mb-6">
      Explore all 115 free DIY calculators, dynamic SVG framing diagrams, and trade-verified building code tools.
    </p>
    <a href="/calculators/" class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 px-8 rounded-lg transition-colors">
      View All 115 DIY Calculators →
    </a>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Slab Core Drilling & 5-Gallon Suction Pit Excavation",
    description: "Core a 4-inch hole through the basement concrete slab, excavate 5 to 10 gallons of sub-slab aggregate and dirt to create an empty sub-slab vacuum chamber, and seal the PVC flange with polyurethane.",
    calculatorName: "Concrete Slab Calculator",
    href: "/calculators/concrete-slab",
    icon: "🚜"
  },
  {
    stepNumber: 2,
    title: "Slab Crack Sealing & Airtight Sump Basin Lid",
    description: "Seal all expansion joints, floor cracks, and wall-floor cold joints with self-leveling polyurethane caulk, and bolt a clear polycarbonate airtight lid over the sump basin with silicone gaskets.",
    calculatorName: "Spray Foam & Air Sealing Calculator",
    href: "/calculators/spray-foam-insulation",
    icon: "🛡️"
  },
  {
    stepNumber: 3,
    title: "Schedule 40 PVC Vent Routing Above Roof Eave",
    description: "Route solid 3\" or 4\" Schedule 40 PVC pipe vertically through garage, utility chase, or exterior wall, discharging at least 12 inches above the roofline and 10 feet away from operable windows.",
    calculatorName: "Conduit Fill & Pipe Calculator",
    href: "/calculators/conduit-fill",
    icon: "📐"
  },
  {
    stepNumber: 4,
    title: "Attic/Exterior Inline Fan & U-Tube Manometer",
    description: "Mount a dedicated centrifugal inline radon fan (Fantech Rn2) in the attic or exterior on flexible rubber anti-vibration couplings, wire to an unswitched circuit, and mount a liquid U-tube manometer on the pipe.",
    calculatorName: "Subpanel Sizing Calculator",
    href: "/calculators/subpanel-sizing",
    icon: "⚡"
  }
];
---

<Layout
  title="Radon Mitigation System Hub — Step-by-Step Sub-Slab Workflow | CalcForDIY"
  description="Follow a 4-step active sub-slab radon mitigation workflow: Suction pit excavation, slab crack sealing, attic fan mounting, and U-tube manometer monitoring."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Radon Mitigation System Hub", "item": "https://calcfordiy.com/projects/radon-mitigation-system-install" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Radon Mitigation</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-3 border border-emerald-100">
      <span>☢️ Indoor Environmental Health &amp; Sub-Slab Depressurization</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Active Sub-Slab Radon Mitigation System Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Radon is a colorless, odorless radioactive soil gas responsible for over 21,000 lung cancer deaths annually in the US. An active soil depressurization (ASD) system pulls sub-slab air out from under your basement floor and exhausts it safely above the roofline. This master workflow covers EPA and ANSI/AARST RMS-LB standards: suction pit geometry, unswitched attic fan mounting, and liquid manometer calibration.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">1 Day (Single Suction Point)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$1,200 – $2,200 (75%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">EPA Safety Target</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">&lt; 2.0 pCi/L (Action Level 4.0)</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Radon Mitigation Contractor Bid vs. DIY Fan &amp; PVC Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (Single-Point Active Sub-Slab System + Attic Fan)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Certified radon mitigation contractor turnkey bid ($1,800–$2,900) vs. DIY retail Fantech inline fan, Schedule 40 PVC, manometer &amp; polyurethane sealant.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Equipment &amp; Fan Kit Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$450 – $650</div>
        <div class="text-[11px] text-slate-400 mt-1">Fantech Rn2 fan, 30 ft 3" PVC pipe, rubber couplings, manometer &amp; core rental</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Certified Radon Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$1,800 – $2,800</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor &amp; Certification 70% • Testing Protocol 15% • Equipment &amp; Piping 15%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$1,350 to $2,150</strong> while dropping your family's indoor radon levels from dangerous 15+ pCi/L down to safe background levels (&lt; 1.0 pCi/L).</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute the 4 phases to ensure a high-suction negative pressure field across your entire basement slab.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Elena Rostova, CBO"
    role="Certified Building Official & Material Takeoff Analyst"
    experience="18+ Years Field Experience"
    avatarBg="bg-emerald-100 text-emerald-800"
    initials="ER"
    title="Why Installing the Fan in the Basement is Strictly Illegal"
    note="A critical life-safety code violation that DIYers often make: They mount the inline radon fan directly on the basement wall or floor joist next to the suction pit because it is warm, convenient, and close to an electrical outlet. Under EPA and ANSI/AARST RMS-LB standards, mounting an active radon fan inside a basement or any habitable living space is strictly prohibited! The piping upstream of the fan operates under negative pressure (vacuum). But the piping DOWNSTREAM of the fan operates under positive pressure. If your fan is in the basement, the entire 20-foot vertical exhaust pipe running up through your house is pressurized with 100% concentrated radioactive radon gas! If a glued PVC joint hairline-cracks or an elbow loosens, the fan pumps thousands of picocuries of deadly radioactive gas straight into your family's bedrooms! The rule: The fan must ALWAYS be mounted outside the living envelope—in an unconditioned attic, in an attached garage, or outside on an exterior wall—so all piping inside the house stays under negative suction."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Radon Mitigation Installation"
    mistakes={[
      {
        number: 1,
        title: "Digging a Shallow 1-Cup Hole Instead of a 5-Gallon Pit",
        costImpact: "$850 (Zero Sub-Slab Airflow & Ineffective Depressurization)",
        description: "Coring through concrete and setting the pipe directly on dense compacted clay creates zero vacuum communication across the rest of the basement floor.",
        solution: "Use a small garden trowel and shop vac to scoop out at least 5 to 10 gallons of aggregate and dirt, creating a hollow hemispherical plenum under the slab."
      },
      {
        number: 2,
        title: "Discharging the Exhaust Below Window Level or Near Eaves",
        costImpact: "$1,200 (Radon Gas Re-Entering Second-Story Bedrooms)",
        description: "Terminating the exhaust pipe under a roof soffit vent or next to a second-story casement window allows radioactive gas to be drawn back into the house attic.",
        solution: "Terminate the exhaust at least 12 inches above the roof ridge or eaves, and at least 10 feet away from any window, door, or fresh air mechanical intake."
      },
      {
        number: 3,
        title: "Leaving Sump Pump Basin Unsealed",
        costImpact: "$650 (Short-Circuiting the Radon Vacuum)",
        description: "An open sump pit pulls basement air into the suction fan rather than drawing soil gas from under the concrete slab, overloading the fan.",
        solution: "Install an airtight clear polycarbonate gasketed lid with rubber grommets for the discharge pipe and electrical cords."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Radon Mitigation Workflow"
    reviews={[
      {
        author: "Grant & Nicole D.",
        location: "Denver, CO",
        projectScope: "Basement Active Sub-Slab Depressurization",
        savingsClaim: "Radon Dropped from 18.2 to 0.7 pCi/L",
        feedback: "Rented a 4-inch diamond core drill from Sunbelt. Scooped out 8 gallons of dirt from under the slab. Mounted a Fantech Rn2 in our attic with rubber Fernco couplings. Tested with an Airthings digital detector: radon plunged from 18.2 pCi/L to 0.7 pCi/L within 24 hours. Elena's warning about attic mounting kept our bedrooms completely safe.",
        keyTakeaway: "Use rubber Fernco flexible couplings on both sides of the fan; absorbs vibration so the fan is 100% silent in the house."
      },
      {
        author: "Logan B.",
        location: "Iowa City, IA",
        projectScope: "DIY Mitigation in Sump-Drain System",
        savingsClaim: "Saved $1,950 vs Contractor",
        feedback: "Tied our suction pipe directly into our existing perimeter drain tile and sealed our sump basin with a clear gasketed cover. The liquid U-tube manometer reads 1.4 inches of water column suction. Passed our real estate radon inspection with flying colors.",
        keyTakeaway: "Fill the liquid manometer with red oil fluid to the zero mark before firing up the fan to get an accurate static pressure reading."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Radon Mitigation System Hub" initialYesCount={378} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Material Takeoff Analyst"
    codeStandard="ANSI/AARST RMS-LB 2024 (Radon Mitigation Standards) & EPA Protocols"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/how-to-read-radon-u-tube-manometer" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">U-Tube Manometer Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Reading static suction in inches of water column, detecting fan failures, and zeros.</div>
      </a>
      <a href="/calculators/concrete-slab" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Slab Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate basement slab thickness, core drill depths, and crack repair caulking.</div>
      </a>
      <a href="/projects/crawl-space-encapsulation" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Crawl Space Encapsulation Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Pair sub-membrane depressurization with 20-mil vapor barriers in crawl spaces.</div>
      </a>
    </div>
  </div>

</Layout>

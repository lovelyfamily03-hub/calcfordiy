---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Site Grading, Trenching & Sump Pump Basin",
    description: "Rake rocks and debris flat, dig a perimeter interior drain trench if standing water occurs, and install a sealed airtight sump pump basin with check valve.",
    calculatorName: "Sump Pump Sizing Calculator",
    href: "/calculators/sump-pump-sizing",
    icon: "🚰"
  },
  {
    stepNumber: 2,
    title: "12 to 20-Mil Reinforced Ground Vapor Barrier",
    description: "Roll out multi-layer virgin polyethylene vapor barrier across dirt floor, overlap seams 12 inches with butyl tape, and run 6 inches up foundation walls and interior support piers.",
    calculatorName: "Floor Underlayment Calculator",
    href: "/calculators/underlayment",
    icon: "🛡️"
  },
  {
    stepNumber: 3,
    title: "Rim Joist Closed-Cell Spray Foam Air Seal",
    description: "Spray 2.0 inches of closed-cell polyurethane foam across all rim joists and sill plates to provide Class II vapor retarder protection and air seal the floor structure.",
    calculatorName: "Spray Foam Insulation Calculator",
    href: "/calculators/spray-foam-insulation",
    icon: "❄️"
  },
  {
    stepNumber: 4,
    title: "Vent Foam Plug Sealing & Commercial Dehumidifier",
    description: "Permanently seal exterior foundation vents with 2-inch XPS foam board, and install an ENERGY STAR commercial crawl space dehumidifier draining to the sump basin.",
    calculatorName: "Mini-Split Heat Pump Calculator",
    href: "/calculators/mini-split-sizing",
    icon: "💨"
  }
];
---

<Layout
  title="Crawl Space Encapsulation Hub — Step-by-Step Moisture Workflow | CalcForDIY"
  description="Follow a 4-step crawl space encapsulation workflow: Sump pump basin, 20-mil vapor barrier, rim joist spray foam air sealing, and commercial dehumidification."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Crawl Space Encapsulation Hub", "item": "https://calcfordiy.com/projects/crawl-space-encapsulation" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Crawl Space Encapsulation</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-3 border border-emerald-100">
      <span>💧 Moisture Control &amp; Building Science</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Crawl Space Encapsulation &amp; Moisture Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Traditional vented crawl spaces suck humid summer air under your home, creating sweating air ducts, wood-decay fungi, and sagging subfloors. This master workflow shows you how to convert a vented crawl space into a clean, dry, conditioned mini-basement per IRC Section R408.3 code specifications.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">2 Weekends (1,200 Sq Ft)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$5,500 – $9,800 (75%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">IRC Section R408.3 (Conditioned Crawl Spaces)</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Crawl Space Contractor Bid vs. DIY Materials</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (1,200 Sq Ft Footprint)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Specialty encapsulation franchise quote ($6.50–$11.00/sq ft) vs. DIY retail 20-mil vapor barrier, spray foam &amp; commercial dehumidifier.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Material Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$2,200 – $3,100</div>
        <div class="text-[11px] text-slate-400 mt-1">20-mil reinforced barrier, butyl tape, Froth-Pak foam kit &amp; AprilAire dehumidifier</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Foundation Encapsulation Franchise Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$8,500 – $13,500</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 70% • Proprietary Branding Markup 15% • Materials 15%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$6,000 to $10,400</strong> in your pocket while permanently protecting your floor joists from dry rot.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute all 4 steps to eliminate moisture, radon gas, and musty odors from entering your living areas.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Elena Rostova, CBO"
    role="Certified Building Official & Building Science Specialist"
    experience="18+ Years Field Experience"
    avatarBg="bg-emerald-100 text-emerald-800"
    initials="ER"
    title="Why Vented Crawl Spaces Fail in the Summer (Condensation Rain)"
    note="For decades, building codes mandated open crawl space vents under the false theory that summer breezes would dry out the ground. In reality, outdoor summer air in humid regions is 85°F with a 72°F dew point. The ground and wooden floor joists beneath your air-conditioned home sit at 60°F. When humid 85°F air enters a 60°F crawl space, the air chills rapidly below its dew point. Water condenses out of the air like droplets running down an iced tea glass on a hot porch! The crawl space literally creates its own indoor rainstorm. Closing vents, laying a thick 20-mil vapor barrier, and sealing rim joists stops this moisture cycle permanently."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Crawl Space Encapsulation"
    mistakes={[
      {
        number: 1,
        title: "Using Thin 6-Mil Clear Plastic Film",
        costImpact: "$2,200 (Punctures, Tears & Cat Urine Odor)",
        description: "Cheap 6-mil recycled polyethylene plastic punctures instantly when kneeled on, and contains volatile recycled resins that decay and produce a sour, cat-urine smell when damp.",
        solution: "Install minimum 12-mil or 20-mil string-reinforced virgin polyethylene vapor barrier (like CrawlShield or Stego Wrap) with high puncture resistance."
      },
      {
        number: 2,
        title: "Covering the Termite Inspection Gap on Walls",
        costImpact: "$1,800 (Failed Termite Inspection & Code Violation)",
        description: "Running the vapor barrier all the way to the top of the foundation wall covers the concrete, hiding subterranean termite mud tubes from exterminator inspections.",
        solution: "IRC Section R408.3 mandates leaving a clear 3-inch uninsulated, exposed concrete inspection band below the wooden mudsill."
      },
      {
        number: 3,
        title: "Using a Residential Basement Dehumidifier",
        costImpact: "$950 (Burned Out Compressors & Frozen Coils)",
        description: "Standard $200 plastic basement dehumidifiers are only designed for 70°F rooms. At 55°F to 60°F crawl space temperatures, their evaporator coils freeze into solid blocks of ice.",
        solution: "Install a dedicated commercial low-temperature crawl space dehumidifier equipped with hot gas bypass defrost (such as AprilAire or Santa Fe)."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Crawl Space Encapsulation Workflow"
    reviews={[
      {
        author: "Greg & Natalie B.",
        location: "Atlanta, GA",
        projectScope: "1,400 sq ft Dirt Crawl Space Encapsulation",
        savingsClaim: "Saved $7,800",
        feedback: "A local franchise quoted us $11,200. We spent $2,800 on 20-mil reinforced liner, butyl tape, foundation pins, a 200 bd ft Froth-Pak kit, and an AprilAire E070 dehumidifier. Relative humidity in the crawl space dropped from 84% to 48% within 48 hours.",
        keyTakeaway: "Wear disposable Tyvek hooded suits and a full-face respirator while taping seams; crawling under low ductwork gets dusty fast."
      },
      {
        author: "Kevin R.",
        location: "Nashville, TN",
        projectScope: "Rim Joist Air-Seal & Sump Basin",
        savingsClaim: "Eliminated Musty Odor Upstairs",
        feedback: "The 3-inch termite inspection gap kept our pest control inspector happy. Spraying 2 inches of closed-cell foam on the rim joists made our living room hardwood floors feel noticeably warmer in the winter.",
        keyTakeaway: "Use an air-powered impact nailer with Christmas tree plastic pins to fasten the vapor barrier to masonry block walls."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Crawl Space Encapsulation Workflow Hub" initialYesCount={331} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Building Science Specialist"
    codeStandard="IRC Section R408.3 & ASTM E1745 Vapor Barrier Standards"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/crawl-space-vapor-barrier-thickness" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Vapor Barrier Mil Thickness Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Comparing 6-mil, 12-mil, and 20-mil reinforced membranes and perm ratings.</div>
      </a>
      <a href="/calculators/spray-foam-insulation" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Spray Foam Insulation Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate board feet and canister kits for rim joist vapor retarders.</div>
      </a>
      <a href="/calculators/sump-pump-sizing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Sump Pump Sizing Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate GPM flow rates and horsepower for crawl space drainage basins.</div>
      </a>
    </div>
  </div>

</Layout>

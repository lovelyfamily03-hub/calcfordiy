---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Main 3/4\" Trunk & Home-Run Manifold Sizing",
    description: "Install a central brass or poly-alloy home-run manifold near your water heater, running dedicated 1/2\" red (hot) and blue (cold) home-run distribution lines to each fixture.",
    calculatorName: "Tankless Water Heater Calculator",
    href: "/calculators/tankless-water-heater",
    icon: "🚰"
  },
  {
    stepNumber: 2,
    title: "Stud Drilling & PEX-A Cold Expansion Runs",
    description: "Bore 1-inch holes through the center of 2x4 framing studs (leaving 5/8\" edge clearance), install steel nail plates, and route continuous flexible PEX tubing without intermediate buried joints.",
    calculatorName: "Pipe Slope Calculator",
    href: "/calculators/pipe-slope",
    icon: "📐"
  },
  {
    stepNumber: 3,
    title: "Fixture Stub-Outs & Water Hammer Arrestors",
    description: "Anchor copper or brass drop-ear 90-degree elbows to wood blocking at each sink, toilet, and shower, and install ASSE 1010 certified water hammer arrestors on washing machine supplies.",
    calculatorName: "Water Heater Cost Calculator",
    href: "/calculators/water-heater-cost",
    icon: "🔧"
  },
  {
    stepNumber: 4,
    title: "100 PSI Air Pressure Test & Rough-In Inspection",
    description: "Cap all fixture stub-outs, connect a test pressure gauge and Schrader air valve, pressurize the system to 100 PSI with a bicycle pump or compressor, and hold for 24 hours.",
    calculatorName: "Submersible Well Pump Calculator",
    href: "/calculators/submersible-well-pump",
    icon: "⏱️"
  }
];
---

<Layout
  title="PEX Plumbing Repiping Hub — Step-by-Step Home Workflow | CalcForDIY"
  description="Follow a 4-step home PEX repiping workflow: Central home-run manifold layout, PEX-A expansion runs, water hammer arrestors, and 100 PSI pressure testing."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "PEX Plumbing Repiping Hub", "item": "https://calcfordiy.com/projects/pex-plumbing-repiping" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">PEX Plumbing Repiping</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>💧 Residential Plumbing &amp; Potable Water</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      PEX Plumbing Repiping Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Replacing corroded galvanized steel or pinhole-leaking copper pipes with cross-linked polyethylene (PEX) restores full water pressure and eliminates catastrophic burst pipes. This master workflow covers IPC (International Plumbing Code) standards: trunk-and-branch vs home-run manifolds, PEX-A cold expansion vs PEX-B crimp fittings, stud nail guard plates, and 24-hour pneumatic pressure testing.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">2 to 3 Days (2-Bath Home)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$6,200 – $10,500 (80%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">IPC Chapter 6 &amp; ASTM F876/F877</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Repipe Specialist Bid vs. DIY Material Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (2,000 Sq Ft 2.5-Bath Single-Family Home)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Turn-key plumbing repipe contractor quote ($7,500–$14,000) vs. DIY retail PEX-A tubing, Milwaukee expansion tool rental, manifold &amp; brass valves.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Material &amp; Tool Rental Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$1,400 – $1,950</div>
        <div class="text-[11px] text-slate-400 mt-1">1,000 ft PEX-A pipe, brass manifold, drop ears, shutoff valves &amp; expansion tool</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Licensed Plumbing Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$8,200 – $13,800</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 75% • Overhead &amp; Insurance 10% • Materials 15%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$6,800 to $11,850</strong> in your pocket while installing full-flow PEX-A with zero concealed in-wall solder joints.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute the 4 repiping phases in exact order to pass your plumbing rough-in inspection with zero leaks.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Marcus Vance"
    role="Master Systems & MEP Building Specialist"
    experience="22+ Years Field Experience"
    avatarBg="bg-amber-100 text-amber-800"
    initials="MV"
    title="The 'Choking' Fitting Restriction: PEX-A vs PEX-B"
    note="When beginners shop for PEX, they often grab PEX-B crimp fittings because the manual crimp tool is cheap ($35). But look closely at how a PEX-B crimp fitting works: it inserts INSIDE the pipe. A standard 1/2-inch PEX-B fitting has an internal bore diameter of only 0.35 inches—restricting water flow area by nearly 35%! If you run three PEX-B 90-degree elbows to your master bathroom shower, your water pressure will drop noticeably when a toilet flushes. By contrast, PEX-A (Uponor ProPEX) uses shape-memory cold expansion: the tool expands the pipe outward, you slide in a full-port fitting with an inner diameter matching the pipe, and the plastic shrinks back down. PEX-A maintains 100% full water flow, requires zero manual crimp calibration gauges, and will never restrict shower pressure."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="PEX Plumbing Installation"
    mistakes={[
      {
        number: 1,
        title: "Omitting Steel Nail Protection Plates on Wall Studs",
        costImpact: "$4,200 (Drywall Screw Puncture & Flooded Walls)",
        description: "Plumbers drill holes through studs to run PEX. When drywallers hang 1/2\" sheetrock with 1-1/4\" screws, a stray screw penetrates the soft plastic pipe, leaking water inside finished walls months later.",
        solution: "Install 16-gauge steel self-nailing safety shield plates over every single stud hole where PEX pipe passes closer than 1-1/4 inches from the stud face (IPC Section 305.6)."
      },
      {
        number: 2,
        title: "Kinking PEX Around Tight 90-Degree Corners",
        costImpact: "$1,100 (Hidden Crease Rupture & Flow Drop)",
        description: "Bending flexible PEX tighter than its minimum bend radius (6x pipe diameter) creases the plastic wall. While PEX-A can be repaired with heat, folded PEX-B creates a permanent weak spot.",
        solution: "Use galvanized steel or engineered plastic bend supports on all 90-degree framing turns instead of forcing a tight hand bend."
      },
      {
        number: 3,
        title: "Exposing PEX Tubing to Sunlight & UV Rays",
        costImpact: "$2,600 (Brittle Pipe Cracking Within 6 Months)",
        description: "Leaving rolls of PEX in the sun or running it exposed across an open exterior wall breaks down the polymer chains, voiding all manufacturer 25-year warranties.",
        solution: "Keep PEX stored in UV-blocking cartons until ready to pull, and never expose PEX to direct sunlight for more than 30 to 60 days."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="PEX Repiping Workflow"
    reviews={[
      {
        author: "Darren & Laura M.",
        location: "Denver, CO",
        projectScope: "1960s Ranch 2-Bath Full Copper Repipe",
        savingsClaim: "Saved $9,400 vs Plumber",
        feedback: "Rented an M12 ProPEX expander for a weekend. The home-run manifold in the basement is a work of art—every fixture has its own shutoff valve. If our kids' bathroom faucet leaks, we can isolate it from the manifold without turning off water to the entire house.",
        keyTakeaway: "Label both ends of every home-run PEX tube with an indelible marker before pulling through floor joists; saves hours of tracing later."
      },
      {
        author: "Julian T.",
        location: "Austin, TX",
        projectScope: "PEX-A Repiping & Nail Plate Protection",
        savingsClaim: "Zero Leaks on 100 PSI Test",
        feedback: "Pressurized the system with a bicycle pump to 100 PSI on Saturday night. The needle didn't budge 1 PSI by Sunday afternoon. The city plumbing inspector signed off on our permit in less than 5 minutes.",
        keyTakeaway: "Use drop-ear elbows securely screwed to 2x4 blocking inside the wall for shower arms and tub spouts so fixtures don't wobble."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="PEX Plumbing Repiping Workflow Hub" initialYesCount={342} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Master Systems & MEP Building Specialist"
    codeStandard="International Plumbing Code (IPC) Chapter 6 & ASTM F876/F877"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/pex-a-vs-pex-b-plumbing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">PEX-A vs PEX-B Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Comparing expansion vs crimp fitting flow rates, freeze burst elasticity, and tool costs.</div>
      </a>
      <a href="/calculators/tankless-water-heater" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Tankless Water Heater Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate GPM flow demand and temperature rise for manifold sizing.</div>
      </a>
      <a href="/projects/bathroom-remodel" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Bathroom Remodel Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Full 5-step workflow: shower tile, thinset mortar, plumbing fixtures, and waterproofing.</div>
      </a>
    </div>
  </div>

</Layout>

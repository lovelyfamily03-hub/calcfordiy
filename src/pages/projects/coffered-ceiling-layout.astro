---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Beam Grid Geometry & Box Symmetry",
    description: "Calculate equal grid box dimensions across length and width, beam core lumber (2x4 or 2x6), and spacing to center boxes symmetrically over the room.",
    calculatorName: "Coffered Ceiling Calculator",
    href: "/calculators/coffered-ceiling",
    icon: "📐"
  },
  {
    stepNumber: 2,
    title: "Crown Molding Beam Pocket Cornices",
    description: "Determine linear footage of 3-1/2\" to 5-1/4\" crown molding running inside the perimeter of every ceiling pocket box.",
    calculatorName: "Crown Molding Calculator",
    href: "/calculators/crown-molding",
    icon: "🪵"
  },
  {
    stepNumber: 3,
    title: "Compound Miter Saw Angles for Box Corners",
    description: "Calculate precise miter table rotation and bevel tilt angles (e.g. 31.6° miter / 33.9° bevel for 52/38 spring angle crown).",
    calculatorName: "Compound Miter Calculator",
    href: "/calculators/compound-miter",
    icon: "🪚"
  },
  {
    stepNumber: 4,
    title: "Recessed Downlight Centering per Box",
    description: "Calculate ultra-thin wafer LED can lights centered inside each coffered recess for balanced, glare-free architectural illumination.",
    calculatorName: "Recessed Lighting Calculator",
    href: "/calculators/recessed-lights-living-room",
    icon: "💡"
  }
];
---

<Layout
  title="Coffered Ceiling Hub — Step-by-Step Architectural Woodwork Workflow | CalcForDIY"
  description="Follow a 4-step coffered ceiling master workflow: Beam grid box layout, crown molding cornice linear feet, compound miter cuts, and recessed lighting."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Coffered Ceiling Hub", "item": "https://calcfordiy.com/projects/coffered-ceiling-layout" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Design and Build an Architectural Coffered Ceiling",
    "description": "A 4-step master woodworking workflow for calculating grid box symmetry, crown molding inside pockets, compound miter angles, and recessed lighting.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Grid Symmetry Math",
        "text": "Calculate beam spacing so perimeter and center coffered ceiling boxes remain proportional and square."
      },
      {
        "@type": "HowToStep",
        "name": "Beam Skin & Crown Molding",
        "text": "Calculate finish 1x6 MDF/poplar beam wrappers and interior pocket crown molding linear footage."
      },
      {
        "@type": "HowToStep",
        "name": "Precision Miter & Bevel Cuts",
        "text": "Set miter saw angles to cut crown molding flat on the table with zero gap joints."
      },
      {
        "@type": "HowToStep",
        "name": "Architectural Lighting Layout",
        "text": "Position central recessed wafer LEDs in each coffer pocket on dedicated dimmer circuits."
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span>Coffered Ceiling Workflow</span>
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-purple-50 border border-purple-200 rounded-full text-purple-800 text-xs font-semibold mb-3">
      <span>👑 Architectural Millwork</span>
      <span>•</span>
      <span>4 Integrated Calculators</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Coffered Ceiling Design &amp; Millwork Hub</h1>
    <p class="text-lg text-gray-600 max-w-3xl">
      Coffered ceilings transform ordinary flat rooms into luxury architectural spaces. Follow this 4-step workflow to calculate box symmetry, beam lumber wrappers, interior pocket crown molding, and centered lighting.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-400 transition-all">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <span class="w-9 h-9 rounded-full bg-purple-100 text-purple-800 font-bold flex items-center justify-center text-sm shrink-0 mt-0.5">
              {step.stepNumber}
            </span>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-lg">{step.icon}</span>
                <h2 class="text-lg font-bold text-gray-900">{step.title}</h2>
              </div>
              <p class="text-sm text-gray-600 max-w-2xl leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
          <a
            href={step.href}
            class="shrink-0 w-full md:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm rounded-lg transition-colors shadow-2xs"
          >
            <span>{step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      </div>
    ))}
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8 mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Coffered Ceiling Framing Secrets</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-700">
      <div>
        <h3 class="font-bold text-gray-900 mb-2">1. Ceiling Joist Attachment (Blocking)</h3>
        <p class="leading-relaxed">
          Beams running parallel to your existing ceiling joists often fall between joist bays. Before snapping chalk lines, install solid 2x4 blocking between joists every 24 inches in the attic to provide solid structural anchor backing for the box beams.
        </p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-2">2. Minimum 9-Foot Ceiling Clearance</h3>
        <p class="leading-relaxed">
          Standard faux box beams hang 4 to 6 inches down from the finished ceiling. In rooms with 8-foot ceilings, this can feel oppressive and claustrophobic. Coffered ceilings look and feel best in spaces with at least 9-foot or 10-foot ceiling heights.
        </p>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-8">
    <h3 class="text-base font-bold text-gray-900 mb-4">Related Building Workflows &amp; Guides</h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a href="/projects/room-accent-wall" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-blue-600 mb-1">ACCENT WALL HUB</div>
        <div class="font-bold text-gray-900 text-sm">Room Accent Wall &amp; Millwork</div>
        <p class="text-xs text-gray-500 mt-1">Board &amp; batten, wainscoting, and room painting steps.</p>
      </a>
      <a href="/guides/how-to-cut-crown-molding" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-emerald-600 mb-1">TRADE GUIDE</div>
        <div class="font-bold text-gray-900 text-sm">How to Cut Crown Molding Flat</div>
        <p class="text-xs text-gray-500 mt-1">Compound miter table settings for 52/38 molding.</p>
      </a>
      <a href="/calculators/coffered-ceiling" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-blue-600 mb-1">INTERACTIVE TOOL</div>
        <div class="font-bold text-gray-900 text-sm">Coffered Ceiling Calculator</div>
        <p class="text-xs text-gray-500 mt-1">Calculate grid layout with dynamic ceiling diagram.</p>
      </a>
    </div>
  </div>

</Layout>

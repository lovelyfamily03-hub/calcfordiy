---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Floor High Point Mapping & Level Benchmark Line",
    description: "Use an 8-foot level or rotating self-leveling laser to scan the room perimeter and locate the absolute highest spot on the subfloor. Mark your baseboard height (e.g. 5-1/4 inches) at this high point, then strike a level laser line around the entire room. Trim the bottom of baseboard boards along lower floor dips rather than following unlevel dips, keeping the top line dead flat.",
    calculatorName: "Baseboard & Shoe Molding Calculator",
    href: "/calculators/baseboard-shoe-molding",
    icon: "📏"
  },
  {
    stepNumber: 2,
    title: "Inside Corner Coping & Outside Corner Angle Bisecting",
    description: "Never cut 45-degree inside miters on baseboards. Run the first baseboard square into the corner drywall. Cut the intersecting board at an inside 45-degree bevel, then follow the revealed profile line with a coping saw back-beveled at 15 degrees. Test fit the cope over the flat board. For outside corners, measure the exact angle using a digital angle finder and bisect it (e.g., 44.5 degrees for an 89-degree corner).",
    calculatorName: "Miter Angle & Compound Cut Calculator",
    href: "/calculators/compound-miter",
    icon: "📐"
  },
  {
    stepNumber: 3,
    title: "Stud & Sole Plate Fastening Pattern (15 / 16-Gauge)",
    description: "Drive 2-1/2-inch 15-gauge or 16-gauge finish nails through the baseboard into wall framing. Place the bottom nail 1 inch up from the floor to bite into the 2x4 bottom sole plate. Place the top nail into wall studs every 16 inches on center. Angle nails slightly in opposing directions (cross-nailing) for maximum mechanical grip into drywall and wood framing.",
    calculatorName: "Stud Spacing & Wall Framing Calculator",
    href: "/calculators/wall-framing",
    icon: "🔨"
  },
  {
    stepNumber: 4,
    title: "Shoe Molding Pinning & Flexible Acrylic Latex Caulking",
    description: "Install 3/4-inch x 1/2-inch shoe molding to conceal floor height gaps and floating floor expansion gaps. Fasten shoe molding with 1-1/4-inch 18-gauge brad nails angled horizontally INTO THE BASEBOARD, never down into floating flooring. Fill nail holes with wood filler, lightly hand-sand with 220-grit, and run a clean micro-bead of paintable acrylic latex caulk along the top baseboard-to-drywall seam.",
    calculatorName: "Caulk & Sealant Coverage Calculator",
    href: "/calculators/trim-molding",
    icon: "✨"
  }
];
---

<Layout
  title="Baseboard & Shoe Molding Installation Hub | CalcForDIY"
  description="Master step-by-step workflow for baseboard and shoe molding installation: floor high-point mapping, inside corner coping, 15-ga fastening, and floating floor shoe pinning."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Baseboard & Shoe Molding Hub", "item": "https://calcfordiy.com/projects/baseboard-shoe-molding-trim" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Install Baseboards and Shoe Molding",
    "description": "Professional finish carpentry workflow for level baseline mapping, coping inside corners, framing fastening, and floating floor shoe molding installation.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Find Floor High Point",
        "text": "Locate high point of subfloor with laser, strike level baseline around room perimeter, and scribe bottom cuts."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Cope Inside Corners & Bisect Outside Angles",
        "text": "Cope inside corners with a coping saw back-beveled 15 degrees and bisect outside corners with a digital protractor."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Fasten to Studs & Sole Plate",
        "text": "Drive 2-1/2-inch 15 or 16-gauge nails into studs and bottom sole plate every 16 inches."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Pin Shoe Molding & Apply Caulk",
        "text": "Nail shoe molding horizontally into baseboard only, never pinning floating floors, and seal top seams with acrylic caulk."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Baseboard &amp; Shoe Molding</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-gradient-to-br from-slate-900 via-sky-950 to-slate-900 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xl not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/20 text-sky-300 text-xs font-semibold mb-4 border border-sky-400/30">
      <span>📐 Architectural Trim &amp; Millwork</span>
      <span>•</span>
      <span>Finish Carpentry Standards</span>
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4 text-white">
      Baseboard &amp; Shoe Molding Installation Workflow Hub
    </h1>

    <p class="text-base sm:text-lg text-slate-300 max-w-3xl mb-6 leading-relaxed">
      Clean trim work separates amateur remodels from architectural perfection. Master finding the room's high point, coping inside corners that never open up during seasonal wood shrinkage, bisecting outside corners, and pinning shoe molding without pinching floating floors.
    </p>

    <!-- Key Metrics Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-slate-700/60 text-left">
      <div>
        <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Fastener Spec</div>
        <div class="text-xl sm:text-2xl font-black text-sky-400">2-1/2-in 15/16-Ga</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Inside Joint</div>
        <div class="text-xl sm:text-2xl font-black text-emerald-400">Coped Joint</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Shoe Pinning Angle</div>
        <div class="text-xl sm:text-2xl font-black text-amber-400">Horizontal (Into Base)</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Typical DIY Savings</div>
        <div class="text-xl sm:text-2xl font-black text-purple-400">$800 - $2,200</div>
      </div>
    </div>
  </div>

  <!-- Primary Interactive Calculator Card -->
  <div class="bg-white border-2 border-sky-500/30 rounded-2xl p-6 sm:p-8 mb-10 shadow-lg relative overflow-hidden">
    <div class="sm:flex sm:items-center sm:justify-between gap-6">
      <div class="mb-4 sm:mb-0">
        <span class="inline-block px-2.5 py-0.5 rounded text-xs font-bold bg-sky-100 text-sky-800 uppercase tracking-wide mb-2">Core Calculator</span>
        <h2 class="text-2xl font-bold text-gray-900">Baseboard &amp; Shoe Molding Calculator</h2>
        <p class="text-gray-600 text-sm mt-1">Calculate room perimeter linear footage, stick counts (8-ft, 12-ft, 16-ft), outside corner cuts, scarf joints, and 10% cutting waste.</p>
      </div>
      <a
        href="/calculators/baseboard-shoe-molding"
        class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-base shadow-md hover:shadow-lg transition-all shrink-0"
      >
        Launch Baseboard Calculator &rarr;
      </a>
    </div>
  </div>

  <!-- Companion Trade Guide Banner -->
  <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Companion Trade Guide</div>
      <div class="text-lg font-bold text-slate-900">Coping Inside Corners vs 45&deg; Miter Cuts</div>
      <p class="text-sm text-slate-600">Learn why 45-degree inside miters fail when drywall corners are 92 degrees, and master the 3-step coping saw back-bevel method.</p>
    </div>
    <a
      href="/guides/coping-inside-corners-vs-miter-baseboard"
      class="inline-flex items-center px-4 py-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold transition-colors shrink-0"
    >
      Read Coping Guide &rarr;
    </a>
  </div>

  <!-- 4-Step Visual Workflow Section -->
  <div class="mb-12">
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">The 4-Step Baseboard &amp; Shoe Installation Protocol</h2>
    <p class="text-gray-600 mb-6">Follow professional trim carpentry sequencing for tight joints, level sightlines, and zero floor binding.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-2xl">{step.icon}</span>
              <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-sky-50 text-sky-700 border border-sky-200">
                Step {step.stepNumber}
              </span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
            <span class="text-xs text-gray-500 font-medium">{step.calculatorName}</span>
            <a href={step.href} class="text-xs font-bold text-sky-600 hover:text-sky-800 flex items-center gap-1">
              Use Tool &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Detailed Bill of Materials Table -->
  <div class="mb-12">
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">Baseboard &amp; Shoe Trim Bill of Materials</h2>
    <div class="overflow-x-auto border border-gray-200 rounded-xl shadow-sm">
      <table class="w-full text-sm text-left">
        <thead class="bg-slate-50 text-gray-700 font-bold border-b border-gray-200">
          <tr>
            <th class="py-3 px-4">Material Component</th>
            <th class="py-3 px-4">Standard Specification</th>
            <th class="py-3 px-4">Quantity Formula</th>
            <th class="py-3 px-4">Trade Purpose</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 text-gray-700">
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Baseboard Stock</td>
            <td class="py-3 px-4">3-1/4-in to 5-1/4-in Primed MDF or Finger-Joint Pine</td>
            <td class="py-3 px-4 font-mono text-sky-700">Perimeter Linear Ft &times; 1.10</td>
            <td class="py-3 px-4">Primary architectural wall-to-floor transition board.</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Shoe Molding</td>
            <td class="py-3 px-4">3/4-in x 1/2-in Flexible Shoe Profile</td>
            <td class="py-3 px-4 font-mono text-sky-700">Perimeter Linear Ft &times; 1.10</td>
            <td class="py-3 px-4">Bends to floor variations and conceals 1/4-in to 3/8-in floating floor expansion gaps.</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Framing Fasteners</td>
            <td class="py-3 px-4">2-1/2-in 15-Gauge or 16-Gauge Finish Nails</td>
            <td class="py-3 px-4 font-mono text-sky-700">2 Nails per Stud (16-in O.C.)</td>
            <td class="py-3 px-4">Secures baseboard through 1/2-in drywall into 2x4 wall studs and bottom plate.</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Shoe Brad Nails</td>
            <td class="py-3 px-4">1-1/4-in 18-Gauge Brad Nails</td>
            <td class="py-3 px-4 font-mono text-sky-700">1 Nail every 12 to 16 inches</td>
            <td class="py-3 px-4">Pins shoe molding horizontally into the baseboard stock.</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Painter's Caulk</td>
            <td class="py-3 px-4">Siliconized Acrylic Latex (DAP Alex Plus / Dynaflex 230)</td>
            <td class="py-3 px-4 font-mono text-sky-700">1 Cartridge per 50-60 Linear Ft</td>
            <td class="py-3 px-4">Bridges micro-gaps between baseboard top edge and wavy drywall.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Trade Pro Field Note -->
  <div class="mb-10">
    <FieldNote
      title="The Cardinal Sin: Nailing Shoe Molding into Floating Floors"
      trade="Trim &amp; Flooring Carpentry"
      content="LVP (luxury vinyl plank), laminate, and engineered hardwood floors are designed to float over subfloors. They expand and contract horizontally across seasons by as much as 3/8 inch. If you angle your 18-gauge brad nail downward through the shoe molding and into the flooring planks, you pin the floor in place. When temperature or humidity changes, the flooring cannot expand freely and will buckle upwards into large, unfixable tents in the center of your room. Always shoot nails horizontally into the baseboard—never down into the floor."
    />
  </div>

  <!-- Critical Costly Mistakes Box -->
  <div class="mb-12">
    <CostlyMistakes
      projectType="Baseboard & Shoe Molding"
      mistakes={[
        {
          mistake: "Miter Cutting 45-Degree Inside Corners",
          impact: "Drywall mud makes corner angles 92 to 95 degrees instead of true 90. Within months of winter heating, timber shrinks and the mitered heels pull apart into ugly 1/8-inch gaping holes.",
          prevention: "Always cope inside corners. A coped joint maintains a tight seamless seal even when the intersecting wall expands or contracts."
        },
        {
          mistake: "Following Floor Dips with Baseboard",
          impact: "Pushing baseboards down tight to an unlevel subfloor produces wavy, rollercoaster top sightlines that are immediately noticeable to the human eye.",
          prevention: "Find the high point of the floor, snap a dead-level benchmark line, and scribe the bottom of baseboard boards over low dips."
        },
        {
          mistake: "Butt Joints on Long Straight Runs",
          impact: "Joining two baseboard pieces with a straight 90-degree butt cut creates an obvious vertical seam that telegraphs through paint and separates easily.",
          prevention: "Always cut a 45-degree scarf joint directly over a framing stud and glue the overlapping bevels with wood glue."
        }
      ]}
    />
  </div>

  <!-- Verified User Reviews -->
  <div class="mb-12">
    <CommunityReviews
      tradeTitle="Baseboard & Shoe Molding Calculator"
      reviews={[
        {
          author: "Dominic S.",
          location: "Columbus, OH",
          projectScope: "Whole-House LVP Baseboard & Shoe Retrofit",
          savingsClaim: "Saved $2,100 DIY",
          feedback: "The high-point floor mapping method made all the difference. Our 1950s ranch floor sloped 3/4 inch from corner to corner. By keeping the laser benchmark level, the 5-1/4 inch baseboard looks crisp and straight throughout the hallway.",
          keyTakeaway: "Map floor high points with a laser level before cutting baseboard."
        },
        {
          author: "Brianne K.",
          location: "Boise, ID",
          projectScope: "3 Bedrooms + Hallway Trim",
          savingsClaim: "Saved $1,350 vs Trim Carpenter",
          feedback: "Learned how to cope from the companion guide. First cope took 15 minutes; by the third corner I was coping boards in under 2 minutes. The joints fit like a glove with zero caulk needed.",
          keyTakeaway: "Back-bevel coped cuts 15 degrees for an instant flush fit."
        }
      ]}
    />
  </div>

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Architectural Finishes Specialist"
    codeStandard="AWI Architectural Woodwork Standards (Millwork Section 10)"
    lastUpdated="September 2026"
  />

  <!-- Helpful Feedback Box -->
  <HelpfulFeedback />

</Layout>

---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Garage Workshop & Studio Conversion Hub | CalcForDIY"
  description="Complete 4-phase DIY project workflow for converting a garage into a workshop: diamond grind epoxy flooring, task lighting grids, drywall primer sealer, and mini-split HVAC heating/cooling."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Garage Workshop & Studio Finishing Workflow",
    "description": "A comprehensive 4-phase DIY workflow for converting a raw garage into a high-performance workshop, gym, or studio space.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "100% Solids Commercial Epoxy Floor Coating",
        "url": "https://calcfordiy.com/calculators/epoxy-floor",
        "text": "Diamond grind concrete, apply epoxy moisture primer, roll high-build 100% solids basecoat with decorative color flakes, and seal with clear polyaspartic."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "High-Lumen Workshop LED Lighting Grid",
        "url": "https://calcfordiy.com/calculators/recessed-lights-garage",
        "text": "Calculate target 50-75 foot-candle task lighting lumens and fixture layout spacing to eliminate shadow lines over workbenches."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "PVA Drywall Primer & Wall Finishing",
        "url": "https://calcfordiy.com/calculators/drywall-primer-sealer",
        "text": "Seal taped sheetrock joints and porous drywall paper with PVA primer sealer before applying scrubbable semi-gloss workshop wall paint."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Ductless Mini-Split Heat Pump Climate Control",
        "url": "https://calcfordiy.com/calculators/mini-split-sizing",
        "text": "Calculate required cooling and heating BTU tonnage for year-round comfort in an insulated garage workshop."
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Garage Workshop Finishing Hub", "item": "https://calcfordiy.com/projects/garage-workshop-finishing" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span>Garage Workshop Finishing Hub</span>
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 border border-blue-200 rounded-full text-blue-800 text-xs font-semibold mb-3">
      <span>🛠️ Garage Transformation Workflow</span>
      <span>•</span>
      <span>4 Interactive Calculators</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-3 tracking-tight">
      Garage Workshop &amp; Studio Finishing Hub
    </h1>
    <p class="text-lg text-gray-600 max-w-3xl leading-relaxed">
      Convert a cold, dusty garage into a finished workspace, home gym, or maker studio with our step-by-step 4-phase project workflow.
    </p>
  </div>

  <!-- Step-by-Step Construction Cards -->
  <div class="space-y-6 mb-12">
    <!-- Step 1 -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-300 transition-all">
      <div class="flex items-start gap-4">
        <div class="bg-blue-600 text-white rounded-xl w-10 h-10 flex items-center justify-center font-bold text-lg shrink-0">
          1
        </div>
        <div class="grow">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
            <h2 class="text-xl font-bold text-gray-900">Armored Epoxy &amp; Polyaspartic Floor Coating</h2>
            <span class="text-xs font-semibold px-2.5 py-0.5 bg-blue-50 text-blue-700 rounded-full">Phase 1: Floor Protection</span>
          </div>
          <p class="text-sm text-gray-600 mb-4 leading-relaxed">
            Eliminate concrete dust and chemical stains with a 100% solids high-build epoxy basecoat, decorative color chips, and UV-stable polyaspartic clear topcoat.
          </p>
          <a href="/calculators/epoxy-floor" class="inline-flex items-center gap-1.5 text-xs font-semibold bg-blue-50 text-blue-700 hover:bg-blue-100 px-3.5 py-2 rounded-lg transition-colors">
            <span>Open Epoxy Floor Calculator →</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-300 transition-all">
      <div class="flex items-start gap-4">
        <div class="bg-blue-600 text-white rounded-xl w-10 h-10 flex items-center justify-center font-bold text-lg shrink-0">
          2
        </div>
        <div class="grow">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
            <h2 class="text-xl font-bold text-gray-900">Task &amp; Overhead Workshop Lighting Grid</h2>
            <span class="text-xs font-semibold px-2.5 py-0.5 bg-amber-50 text-amber-700 rounded-full">Phase 2: Electrical &amp; Lumens</span>
          </div>
          <p class="text-sm text-gray-600 mb-4 leading-relaxed">
            Calculate target lumens (50–75 foot-candles for detailed woodworking/mechanic tasks) and optimize grid spacing between vehicles and tool benches.
          </p>
          <a href="/calculators/recessed-lights-garage" class="inline-flex items-center gap-1.5 text-xs font-semibold bg-amber-50 text-amber-700 hover:bg-amber-100 px-3.5 py-2 rounded-lg transition-colors">
            <span>Open Garage Lighting Calculator →</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Step 3 -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-300 transition-all">
      <div class="flex items-start gap-4">
        <div class="bg-blue-600 text-white rounded-xl w-10 h-10 flex items-center justify-center font-bold text-lg shrink-0">
          3
        </div>
        <div class="grow">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
            <h2 class="text-xl font-bold text-gray-900">PVA Drywall Primer &amp; Paint Sealer</h2>
            <span class="text-xs font-semibold px-2.5 py-0.5 bg-emerald-50 text-emerald-700 rounded-full">Phase 3: Wall Finishing</span>
          </div>
          <p class="text-sm text-gray-600 mb-4 leading-relaxed">
            Equalize porous joint compound and raw paper on garage walls with PVA primer sealer before painting with durable, wipe-down semi-gloss enamel.
          </p>
          <a href="/calculators/drywall-primer-sealer" class="inline-flex items-center gap-1.5 text-xs font-semibold bg-emerald-50 text-emerald-700 hover:bg-emerald-100 px-3.5 py-2 rounded-lg transition-colors">
            <span>Open Drywall Primer Sealer Calculator →</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Step 4 -->
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-300 transition-all">
      <div class="flex items-start gap-4">
        <div class="bg-blue-600 text-white rounded-xl w-10 h-10 flex items-center justify-center font-bold text-lg shrink-0">
          4
        </div>
        <div class="grow">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
            <h2 class="text-xl font-bold text-gray-900">Ductless Mini-Split Climate Control</h2>
            <span class="text-xs font-semibold px-2.5 py-0.5 bg-purple-50 text-purple-700 rounded-full">Phase 4: HVAC Comfort</span>
          </div>
          <p class="text-sm text-gray-600 mb-4 leading-relaxed">
            Size a 12,000 to 24,000 BTU ductless heat pump mini-split system to maintain 70°F year-round comfort regardless of sub-zero winter or summer heat waves.
          </p>
          <a href="/calculators/mini-split-sizing" class="inline-flex items-center gap-1.5 text-xs font-semibold bg-purple-50 text-purple-700 hover:bg-purple-100 px-3.5 py-2 rounded-lg transition-colors">
            <span>Open Mini-Split Sizing Calculator →</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Related Guide Card -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-xl p-6 mb-8">
    <h3 class="text-lg font-bold mb-2 text-blue-200">Recommended Reading</h3>
    <p class="text-slate-300 text-sm mb-4">Learn how to wire subpanels and calculate line loss for heavy garage workshop equipment:</p>
    <a href="/guides/how-to-calculate-voltage-drop-for-wire-runs" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg text-xs transition-colors">
      Read Guide: How to Calculate Voltage Drop for Long Wire Runs →
    </a>
  </div>

</Layout>

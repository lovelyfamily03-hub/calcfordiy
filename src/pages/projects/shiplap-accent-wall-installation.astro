---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Stud Mapping, Laser Plumb Baseline & Electrical Box Prep",
    description: "Scan the accent wall with a deep-scanning magnetic and capacitive stud finder. Mark every stud location at ceiling, midpoint, and floor with vertical 16-inch or 24-inch O.C. pencil lines using a 6-foot level or cross-line laser. Shut off breaker power and install UL-listed plastic electrical box extender rings to ensure switches and receptacles sit flush with the added 1/2-inch to 3/4-inch shiplap depth.",
    calculatorName: "Stud Spacing & Framing Calculator",
    href: "/calculators/wall-framing",
    icon: "🔍"
  },
  {
    stepNumber: 2,
    title: "Square Footage, Board Quantity & Nickel-Gap Waste Sizing",
    description: "Measure overall wall height and width. Deduct large architectural openings but add a 10% cutting and defect allowance. For horizontal installation, divide wall height by the exposed board face width (5-1/4 inches for nominal 1x6 nickel gap) to calculate total course rows. Check whether the top or bottom course requires ripping under 2 inches; adjust baseline elevation to split rip cuts evenly.",
    calculatorName: "Shiplap Accent Wall Calculator",
    href: "/calculators/shiplap",
    icon: "📐"
  },
  {
    stepNumber: 3,
    title: "Level Starter Course, Dual Stud Nailing & Adhesive Layout",
    description: "Mount the bottom starter course with the tongue or upper lap facing upward, leveled with a laser line 1/4 inch above the finished floor for expansion. Fasten through the face into every wall stud with two 2-inch 16-gauge galvanized finish nails or 15-gauge trim nails per stud. For high-traffic rooms or uneven drywall, apply serpentine beads of low-VOC construction adhesive (Loctite Power Grab) along the back.",
    calculatorName: "Drywall Screws & Fasteners Calculator",
    href: "/calculators/drywall",
    icon: "🔨"
  },
  {
    stepNumber: 4,
    title: "Staggered Butt Joints, Nickel Spacers & Trim Detailing",
    description: "Ascend the wall checking level every 3 courses. Stagger butt joints by a minimum of two stud bays (32 inches) across successive courses. Maintain built-in nickel gaps (1/8-inch) using spacing nickels or integral spacer tongues. Scribe edge boards to out-of-plumb corner walls. Cap outside corners with 1-1/8-inch corner moulding, install crown or ceiling cove, fill nail holes with non-shrinking spackle, and finish paint.",
    calculatorName: "Interior Paint Coverage Calculator",
    href: "/calculators/paint-room",
    icon: "🎨"
  }
];
---

<Layout
  title="Shiplap Accent Wall Installation Hub | CalcForDIY"
  description="Step-by-step master workflow for DIY shiplap accent walls: stud scanning, laser plumb lines, nickel-gap board math, 16-gauge fastening, and box extenders."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Shiplap Installation Hub", "item": "https://calcfordiy.com/projects/shiplap-accent-wall-installation" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Install a Nickel-Gap Shiplap Accent Wall",
    "description": "Complete professional workflow for framing layout, board calculations, fastening patterns, and trim integration on interior accent walls.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Stud Mapping & Electrical Box Extenders",
        "text": "Locate studs at 16 inches on center, snap vertical plumb lines, and install electrical box extension rings to comply with NEC requirements."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Course Planning & Waste Sizing",
        "text": "Calculate course count based on exposed board face width and verify top/bottom rip dimensions."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Level Starter Course & Stud Fastening",
        "text": "Fasten bottom course level with two 2-inch 16-gauge finish nails per stud and construction adhesive."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Butt Joint Staggering & Trim Detailing",
        "text": "Stagger butt joints 32 inches apart, maintain 1/8-inch gaps, and finish with corner trim and paint."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Shiplap Accent Wall</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-gradient-to-br from-slate-900 via-sky-950 to-slate-900 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xl not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/20 text-sky-300 text-xs font-semibold mb-4 border border-sky-400/30">
      <span>📐 Interior Carpentry &amp; Millwork</span>
      <span>•</span>
      <span>Finish Carpentry &amp; NEC Box Standards</span>
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4 text-white">
      Shiplap Accent Wall Installation Workflow Hub
    </h1>

    <p class="text-base sm:text-lg text-slate-300 max-w-3xl mb-6 leading-relaxed">
      A flat, flawless shiplap accent wall demands rigorous prep: snapping plumb stud lines, extending recessed electrical switch boxes to comply with electrical codes, calculating equal top and bottom rip courses, and driving dual 16-gauge nails into solid wood framing.
    </p>

    <!-- Key Metrics Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-slate-700/60 text-left">
      <div>
        <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Typical Gap</div>
        <div class="text-xl sm:text-2xl font-black text-sky-400">1/8-in (Nickel)</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Nail Gauge</div>
        <div class="text-xl sm:text-2xl font-black text-emerald-400">15 / 16-Gauge</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Joint Stagger</div>
        <div class="text-xl sm:text-2xl font-black text-amber-400">32-in Min</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Typical DIY Savings</div>
        <div class="text-xl sm:text-2xl font-black text-purple-400">$1,200 - $2,800</div>
      </div>
    </div>
  </div>

  <!-- Primary Interactive Calculator Card -->
  <div class="bg-white border-2 border-sky-500/30 rounded-2xl p-6 sm:p-8 mb-10 shadow-lg relative overflow-hidden">
    <div class="sm:flex sm:items-center sm:justify-between gap-6">
      <div class="mb-4 sm:mb-0">
        <span class="inline-block px-2.5 py-0.5 rounded text-xs font-bold bg-sky-100 text-sky-800 uppercase tracking-wide mb-2">Core Calculator</span>
        <h2 class="text-2xl font-bold text-gray-900">Shiplap Accent Wall Estimator</h2>
        <p class="text-gray-600 text-sm mt-1">Input wall height, width, board reveal width, and waste allowance to calculate board counts, line linear feet, and fastener requirements.</p>
      </div>
      <a
        href="/calculators/shiplap"
        class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-base shadow-md hover:shadow-lg transition-all shrink-0"
      >
        Launch Shiplap Calculator &rarr;
      </a>
    </div>
  </div>

  <!-- Companion Trade Guide Banner -->
  <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Companion Trade Guide</div>
      <div class="text-lg font-bold text-slate-900">Nickel Gap vs Traditional Tongue &amp; Groove Shiplap</div>
      <p class="text-sm text-slate-600">Understand edge profiles, blind-nailing tongues vs face-nailing, and why painting tongue reveals prevents unsightly winter seam gaps.</p>
    </div>
    <a
      href="/guides/nickel-gap-vs-tongue-and-groove-shiplap"
      class="inline-flex items-center px-4 py-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold transition-colors shrink-0"
    >
      Read Comparison Guide &rarr;
    </a>
  </div>

  <!-- 4-Step Visual Workflow Section -->
  <div class="mb-12">
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">The 4-Phase Shiplap Installation Protocol</h2>
    <p class="text-gray-600 mb-6">Execute each phase with trade-tested accuracy to prevent loose boards, cupping, and out-of-square lines.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-2xl">{step.icon}</span>
              <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-sky-50 text-sky-700 border border-sky-200">
                Phase {step.stepNumber}
              </span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
            <span class="text-xs text-gray-500 font-medium">{step.calculatorName}</span>
            <a href={step.href} class="text-xs font-bold text-sky-600 hover:text-sky-800 flex items-center gap-1">
              Use Tool &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Detailed Bill of Materials Table -->
  <div class="mb-12">
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">Shiplap Accent Wall Bill of Materials</h2>
    <div class="overflow-x-auto border border-gray-200 rounded-xl shadow-sm">
      <table class="w-full text-sm text-left">
        <thead class="bg-slate-50 text-gray-700 font-bold border-b border-gray-200">
          <tr>
            <th class="py-3 px-4">Material Component</th>
            <th class="py-3 px-4">Standard Trade Spec</th>
            <th class="py-3 px-4">Formula / Quantity</th>
            <th class="py-3 px-4">Trade Purpose</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 text-gray-700">
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Shiplap Boards</td>
            <td class="py-3 px-4">1x6 or 1x8 Primed MDF or Radiata Pine (Nickel Gap)</td>
            <td class="py-3 px-4 font-mono text-sky-700">Wall Sq Ft &times; 1.10 &divide; Reveal Width</td>
            <td class="py-3 px-4">Main horizontal/vertical cladding with built-in 1/8-inch shadow line.</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Finish Fasteners</td>
            <td class="py-3 px-4">2-in 16-Gauge Galvanized Finish Nails</td>
            <td class="py-3 px-4 font-mono text-sky-700">2 Nails per Stud per Course</td>
            <td class="py-3 px-4">Penetrates 1/2-in drywall and embeds 1-in into 2x4 framing studs.</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Construction Adhesive</td>
            <td class="py-3 px-4">Loctite Power Grab / Titebond Fast Grab</td>
            <td class="py-3 px-4 font-mono text-sky-700">1 Tube per 35-40 Sq Ft</td>
            <td class="py-3 px-4">Reduces nail count and prevents board vibration or cupping on drywall.</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Electrical Box Extenders</td>
            <td class="py-3 px-4">UL-Listed Plastic Box Extender Rings (Arlington BE1)</td>
            <td class="py-3 px-4 font-mono text-sky-700">1 per Existing Outlet/Switch Box</td>
            <td class="py-3 px-4">Brings receptacle flush to shiplap surface per NEC 314.20 fire safety.</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Corner Moulding &amp; Trim</td>
            <td class="py-3 px-4">1-1/8-in Outside Corner Bead &amp; Scribe Moulding</td>
            <td class="py-3 px-4 font-mono text-sky-700">Total Corner Linear Feet + 10%</td>
            <td class="py-3 px-4">Conceals end-grain cuts and scribe relief gaps against out-of-plumb walls.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Trade Pro Field Note -->
  <div class="mb-10">
    <FieldNote
      title="Acclimation &amp; The Dark-Groove Pre-Paint Rule"
      trade="Interior Finish Carpentry"
      content="Solid wood shiplap expands and contracts across its width with relative humidity swings. Always acclimate wood boards in the target room for a minimum of 72 hours before installation. Crucially, if you are painting your shiplap a contrasting color or dark tone, paint the tongue rabbets and wall behind each joint BEFORE nailing. When wood boards inevitably shrink in dry winter heating conditions, exposed unpainted raw wood will flash through the 1/8-inch nickel gaps if not pre-coated."
    />
  </div>

  <!-- Critical Costly Mistakes Box -->
  <div class="mb-12">
    <CostlyMistakes
      projectType="Shiplap Accent Wall"
      mistakes={[
        {
          mistake: "Nailing Solely into Drywall Without Locating Studs",
          impact: "Brad nails driven into 1/2-inch gypsum drywall have zero shear strength. Within months, cumulative board weight and seasonal movement cause the entire wall cladding to sag and pop loose.",
          prevention: "Snap vertical plumb chalk lines on every stud. Drive two 2-inch 16-gauge nails into solid wood framing at every 16-inch interval."
        },
        {
          mistake: "Omitting Electrical Switch Box Extender Rings",
          impact: "Leaving electrical boxes recessed 3/4-inch behind combustible wood shiplap violates NEC 314.20 and creates severe fire hazard if arcing occurs inside the box.",
          prevention: "Install code-compliant Arlington BE1 or metallic extension rings so the receptacle box face is flush with the outer finished shiplap surface."
        },
        {
          mistake: "Pushing Boards Tight Without Expansion Gaps",
          impact: "Butting shiplap tight against side walls and ceilings without a 1/4-inch perimeter gap causes boards to buckle outward in humid summer months.",
          prevention: "Leave a 1/4-inch expansion perimeter around all ceiling, floor, and corner transitions, covered with shoe or crown moulding."
        }
      ]}
    />
  </div>

  <!-- Verified User Reviews -->
  <div class="mb-12">
    <CommunityReviews
      tradeTitle="Shiplap Wall Calculator"
      reviews={[
        {
          author: "Tyler V.",
          location: "Franklin, TN",
          projectScope: "16-ft x 9-ft Master Bedroom Accent Wall",
          savingsClaim: "Saved $1,850 DIY",
          feedback: "Used 1x6 nickel-gap MDF boards and the calculator was spot-on. Adding 10% for cuts saved me when I had to scribe the end boards around an out-of-plumb corner. Pre-painting the wall black behind the seams made the nickel gaps pop.",
          keyTakeaway: "Paint the wall behind the seams dark before nailing."
        },
        {
          author: "Kaitlyn M.",
          location: "Madison, WI",
          projectScope: "Dining Room Shiplap with 3 Outlets",
          savingsClaim: "Saved $1,400 vs Carpenter",
          feedback: "The electrical box extender tip was a lifesaver. I had no idea recessed switches violated building code until reading this hub. The Arlington rings slipped right on in 2 minutes.",
          keyTakeaway: "Install electrical box extenders before mounting faceplates."
        }
      ]}
    />
  </div>

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Architectural Finishes Specialist"
    codeStandard="AWI Architectural Woodwork Standards & NEC Section 314.20"
    lastUpdated="September 2026"
  />

  <!-- Helpful Feedback Box -->
  <HelpfulFeedback />

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Soil Percolation (Perk) Testing & Infiltration Rate",
    description: "Dig a 12\" test hole, pre-soak for 4 hours, and measure water drop in inches per hour to calculate total drywell stormwater gallon capacity for 10-year storm events.",
    calculatorName: "Drywell Stormwater Calculator",
    href: "/calculators/drywell-stormwater",
    icon: "⏱️"
  },
  {
    stepNumber: 2,
    title: "Pit Excavation & Non-Woven Geotextile Wrap",
    description: "Excavate a 4-ft to 6-ft deep by 4-ft diameter pit (at least 10 feet from foundations), line bottom and vertical sidewalls with 4-oz non-woven needle-punched geotextile fabric.",
    calculatorName: "Gravel & Crushed Stone Calculator",
    href: "/calculators/gravel-driveway",
    icon: "🚜"
  },
  {
    stepNumber: 3,
    title: "Flo-Well Basin Core & #57 Stone Envelope",
    description: "Assemble a 50-gallon structural polypropylene Flo-Well tank or precast concrete drywell ring, backfill with 12 inches of clean washed #57 angular drainage stone, and fold fabric over top.",
    calculatorName: "French Drain Calculator",
    href: "/calculators/french-drain",
    icon: "🪨"
  },
  {
    stepNumber: 4,
    title: "4\" Smooth PVC Inflow & Pop-Up Overflow Emitter",
    description: "Trench 4-inch solid PVC drain pipe at 1/8\" per foot slope from roof downspouts, install an inline leaf debris catch basin, and route a high-water relief line to a pop-up emitter.",
    calculatorName: "Pipe Slope Calculator",
    href: "/calculators/pipe-slope",
    icon: "💧"
  }
];
---

<Layout
  title="Drywell Stormwater Drainage Hub — Step-by-Step Yard Workflow | CalcForDIY"
  description="Follow a 4-step underground drywell drainage workflow: Soil percolation testing, non-woven geotextile wrap, Flo-Well structural tanks, and pop-up overflow emitters."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Drywell Stormwater Drainage Hub", "item": "https://calcfordiy.com/projects/drywell-stormwater-drainage" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Drywell Drainage</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>💧 Stormwater Infiltration &amp; Foundation Defense</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Drywell Stormwater Infiltration Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Managing intense roof stormwater runoff on properties with no municipal storm sewer or street curb requires subsurface infiltration. This master workflow shows you how to design and install an underground drywell system: percolation math, needle-punched geotextile filter envelopes, structural drywell basins, and emergency high-water relief pop-ups.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">1 to 2 Weekends</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$3,200 – $5,400 (75%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">EPA Stormwater BMP &amp; IRC R405</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Drainage Contractor Bid vs. DIY Material Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (Dual-Tank 100 Gal Drywell System + 80 Ft Trench)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Drainage contractor turnkey installation ($3,800–$6,800) vs. DIY retail Flo-Well basins, washed #57 stone, geotextile &amp; mini-excavator rental.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Material &amp; Mini-Excavator Rental</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$1,100 – $1,550</div>
        <div class="text-[11px] text-slate-400 mt-1">2 Flo-Well basins, 4 tons #57 rock, 100 ft solid PVC, fabric &amp; 1-day rental</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Licensed Drainage Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$4,200 – $6,500</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 65% • Excavation Machine Operator 20% • Materials 15%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$3,100 to $4,950</strong> while guaranteeing your drywell is wrapped in 100% silt-blocking non-woven fabric.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute the 4 drainage phases to ensure zero ponding and permanent stormwater absorption.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="David Miller, PE"
    role="Structural & Civil Engineering Consultant"
    experience="20+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="The Woven vs. Non-Woven Fabric Blinding Failure"
    note="The #1 cause of drywells failing within 2 years is using woven landscape fabric (weed barrier) to line the pit. Woven fabric looks like a black plastic tarp woven together. Under a microscope, the plastic ribbons create flat planes that attract microscopic clay particles. Within 18 months, fine silt forms a slick, impermeable cake across the fabric—a catastrophic phenomenon civil engineers call 'soil blinding'. Water cannot pass through it, turning your drywell into a flooded, useless underground bucket! You must ONLY use needle-punched non-woven geotextile fabric (4-oz or 6-oz, like Mirafi 140N or Typar). Non-woven fabric looks and feels like fuzzy gray felt. Its randomly oriented fibers filter out fine silt while maintaining a water flow rate exceeding 100 gallons per minute per square foot."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Drywell Stormwater Installation"
    mistakes={[
      {
        number: 1,
        title: "Installing a Drywell Closer than 10 Feet to Foundations",
        costImpact: "$5,500+ (Basement Flooding & Soil Subsidence)",
        description: "Discharging thousands of gallons of concentrated stormwater into the soil immediately adjacent to basement walls oversaturates foundation soils, causing severe basement leaks.",
        solution: "IRC Section R405 and municipal stormwater ordinances require drywells to be located at least 10 feet away from building foundations and 5 feet from property lines."
      },
      {
        number: 2,
        title: "Omitting an Inline Debris Filter Catch Basin",
        costImpact: "$1,800 (Drywell Pit Silted Solid in 3 Years)",
        description: "Piping downspouts directly into a drywell sends roof shingle grit, decomposing leaves, and pine needles straight into the underground stone, clogging void spaces.",
        solution: "Install an inline 9x9 or 12x12 inch catch basin with a removable stainless steel or nylon filter basket near the house before the pipe enters the drywell."
      },
      {
        number: 3,
        title: "Forgetting the High-Water Pop-Up Relief Valve",
        costImpact: "$1,200 (Water Backing Up Gutters & Fascia Rot)",
        description: "During a 50-year torrential storm exceeding the drywell capacity, a sealed system without an overflow relief valve backs water up into downspouts, tearing gutters off fascias.",
        solution: "Tee a 4-inch overflow pipe off the top of the drywell basin leading to a daylight pop-up emitter in a lawn swale 15 feet away."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Drywell Stormwater Workflow"
    reviews={[
      {
        author: "Brad & Alison C.",
        location: "Portland, OR",
        projectScope: "Dual Flo-Well System for 1,800 sq ft Roof",
        savingsClaim: "Saved $3,800",
        feedback: "Performed the 12-inch perk test and discovered our sandy loam drains at 3.5 inches per hour. Installed two interconnected Flo-Well basins wrapped in 4-oz non-woven fabric. Pacific Northwest winter rains handled completely on-site.",
        keyTakeaway: "Drill out the pre-marked knockout holes on the bottom and sides of the Flo-Well tanks to maximize water discharge area."
      },
      {
        author: "Mark S.",
        location: "Long Island, NY",
        projectScope: "Backyard Puddle Solution with Pop-Up Overflow",
        savingsClaim: "Eliminated Standing Water",
        feedback: "The non-woven felt fabric tip saved me from buying cheap weed barrier. Added a 9-inch catch basin at the downspout to catch maple tree helicopters. The overflow pop-up popped up once during a tropical storm and worked flawlessly.",
        keyTakeaway: "Use washed crushed stone, never 'crusher run' or stone dust; fines in dirty gravel will immediately choke the drywell."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Drywell Stormwater Drainage Hub" initialYesCount={336} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="EPA Stormwater Best Management Practices (BMP) & IRC Section R405"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/soil-percolation-test-drywell" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Soil Perk Testing Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Step-by-step DIY percolation testing, inch-per-hour math, and tank sizing.</div>
      </a>
      <a href="/calculators/drywell-stormwater" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Drywell Stormwater Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate roof storm runoff volume, tank count, and washed stone cubic yards.</div>
      </a>
      <a href="/projects/yard-drainage" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Yard Drainage Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Complete drainage workflow: pipe slope, French drains, and retaining walls.</div>
      </a>
    </div>
  </div>

</Layout>

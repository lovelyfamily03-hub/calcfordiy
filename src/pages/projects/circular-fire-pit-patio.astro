---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Radial Layout & Crushed Base Excavation",
    description: "Drive a center stake, swing a radius marking rope to scribe an 18-ft diameter circle, excavate 8 inches deep, and compact 4 to 6 inches of crushed #21A road base aggregate.",
    calculatorName: "Gravel & Crushed Stone Calculator",
    href: "/calculators/gravel-driveway",
    icon: "⭕"
  },
  {
    stepNumber: 2,
    title: "1-Inch Bedding Sand & Circular Paver Field",
    description: "Screed 1 inch of ASTM C33 coarse concrete sand, lay radial paver kits or cut trapezoidal stones in concentric circles, and stake heavy-duty flexible plastic edge restraints.",
    calculatorName: "Paver Bedding Sand Calculator",
    href: "/calculators/paver-base-sand",
    icon: "🧱"
  },
  {
    stepNumber: 3,
    title: "Fire Pit Block Ring & Steel Insert Liner",
    description: "Stack 3 to 4 courses of trapezoidal retaining wall blocks in a 36-inch to 44-inch diameter circle, bond with high-heat construction adhesive, and install a heavy-gauge steel fire insert ring.",
    calculatorName: "Concrete Block & CMU Calculator",
    href: "/calculators/concrete-block-cmu",
    icon: "🔥"
  },
  {
    stepNumber: 4,
    title: "Lava Rock Drainage & Polymeric Joint Sand",
    description: "Fill the fire pit bottom with 4 inches of volcanic lava rock for rainwater drainage, sweep polymeric sand into the surrounding patio paver joints, and mist to activate.",
    calculatorName: "Polymeric Sand Calculator",
    href: "/calculators/polymeric-sand",
    icon: "✨"
  }
];
---

<Layout
  title="Circular Fire Pit Patio Hub — Step-by-Step Construction Workflow | CalcForDIY"
  description="Follow a 4-step circular paver fire pit patio workflow: Radial layout, compacted gravel sub-base, trapezoidal fire pit blocks, steel liner ring, and polymeric sand."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Circular Fire Pit Patio Hub", "item": "https://calcfordiy.com/projects/circular-fire-pit-patio" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Circular Fire Pit Patio</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-xs font-semibold mb-3 border border-amber-200">
      <span>🔥 Outdoor Living &amp; Fire Features</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Circular Fire Pit &amp; Paver Patio Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      A circular paver patio with a built-in stone fire pit creates the ultimate outdoor gathering area. This master workflow breaks down the radial layout geometry, fire clearance setbacks (IRC Section R1004), heat shield steel insert rings, lava rock drainage bases, and durable polymeric joint locking.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">2 Weekends (16-ft Diameter)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$3,400 – $5,800 (68%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">NFPA 211 &amp; IRC Section R1004</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Hardscape Contractor Bid vs. DIY Material Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (200 Sq Ft Circular Patio + Fire Pit)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Hardscape turn-key contractor bid ($24–$38/sq ft) vs. DIY retail stone pavers, fire ring, base aggregate &amp; compactor rental.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Material &amp; Rental Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$1,650 – $2,200</div>
        <div class="text-[11px] text-slate-400 mt-1">Pavers, fire pit blocks, steel ring insert, gravel, sand &amp; plate compactor</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Hardscape Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$5,200 – $7,900</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 65% • Excavation Equipment 15% • Materials 20%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$3,550 to $5,700</strong> in cash while engineering a safe, steel-lined fire pit that won't crack or explode.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute each step in exact order to maintain a true radial curve with zero sunken blocks.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="David Miller, PE"
    role="Structural & Civil Engineering Consultant"
    experience="20+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="Why Decorative Concrete Blocks Explode Without a Steel Liner Ring"
    note="Standard landscape retaining wall blocks are made of hydraulic pressed concrete. Concrete is naturally porous and contains microscopic pockets of trapped moisture. When a wood fire burns inside a stone ring, temperatures exceed 800°F (425°C). The moisture inside regular concrete blocks turns instantly into high-pressure steam. Because concrete is dense, the steam cannot escape quickly, causing the blocks to spall, fracture, and literally explode like shrapnel! You must NEVER build a wood-burning fire pit out of bare concrete blocks. You must either line the interior with refractory high-heat firebrick laid in fireclay mortar, or drop in a heavy 10-gauge carbon steel or stainless steel fire ring insert that creates a 1-inch insulating air gap between the flames and the concrete blocks."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Fire Pit Patio Construction"
    mistakes={[
      {
        number: 1,
        title: "Pouring an Impermeable Concrete Floor in the Pit Bottom",
        costImpact: "$1,400 (Standing Dirty Rainwater Pool)",
        description: "Sealing the bottom of the fire pit with solid concrete turns it into a watertight bucket. After every rainstorm, the pit fills with 6 inches of black sooty stagnant water.",
        solution: "Leave the center of the fire pit open to the earth, filling the bottom 4 to 6 inches with clean washed volcanic lava rock or coarse gravel so rainwater drains instantly."
      },
      {
        number: 2,
        title: "Violating the 10-Foot Structure & Tree Clearance Code",
        costImpact: "$2,500+ (Fire Hazard & Municipal Fines)",
        description: "Most municipal fire codes (NFPA 211 / IFC Section 307) strictly require open-flame fire pits to be located at least 15 to 25 feet away from combustible structures, vinyl siding, and low-hanging tree branches.",
        solution: "Measure setbacks carefully from house overhangs, wooden decks, and property lines before breaking ground."
      },
      {
        number: 3,
        title: "Using Wet River Stones or Limestone Inside the Flame Zone",
        costImpact: "$850 (Exploding Rock Shrapnel Injuries)",
        description: "Smooth river gravel and sedimentary limestone absorb moisture from the ground. Direct flame contact causes trapped steam pockets to violently shatter the stones.",
        solution: "Use only dry volcanic lava rocks, refractory ceramic logs, or fire glass specifically rated for 1,200°F+ open fire use."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Fire Pit Patio Workflow"
    reviews={[
      {
        author: "Brad & Ashley C.",
        location: "Greenville, SC",
        projectScope: "16-ft Circular Fire Pit Patio & Stone Bench",
        savingsClaim: "Saved $4,200",
        feedback: "The center stake and radius string trick made digging the circular trench so simple. We bought a 36-inch steel fire ring from Tractor Supply and built the blocks around it leaving a 1-inch air gap. The pit draws air beautifully with very little smoke.",
        keyTakeaway: "Leave four 2-inch vertical gaps between blocks on the bottom course to allow combustion air to draft in at the base of the fire."
      },
      {
        author: "Trevor M.",
        location: "Kansas City, MO",
        projectScope: "Backyard Flagstone & Paver Fire Ring",
        savingsClaim: "Saved $3,600",
        feedback: "The lava rock drainage base works like a charm—rained 2 inches last week and the pit was bone dry 30 minutes after the storm passed. Our friends gather around it every Friday night.",
        keyTakeaway: "Use high-temperature exterior polyurethane landscape adhesive on the top capstones so people can sit on them without dislodging blocks."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Circular Fire Pit Patio Workflow Hub" initialYesCount={304} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="NFPA 211, IRC Section R1004 & ICPI Hardscape Standards"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/fire-pit-lava-rock-vs-fire-brick" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Fire Pit Block Safety Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Can you use regular concrete blocks? Exploding rock hazards and steel ring liners.</div>
      </a>
      <a href="/calculators/concrete-block-cmu" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Block &amp; CMU Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate trapezoidal blocks, capstones, mortar bags, and core fill.</div>
      </a>
      <a href="/projects/paver-patio-walkway" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Paver Patio &amp; Walkway Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Follow the 4-step workflow: excavation, bedding sand, pavers, and polymeric sand.</div>
      </a>
    </div>
  </div>

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Excavation & Compacted Base Aggregate",
    description: "Excavate 7 to 9 inches below grade, line the subgrade with woven geotextile fabric, and compact 4 to 6 inches of crushed #21A or road base gravel in 2-inch lifts.",
    calculatorName: "Gravel & Crushed Stone Calculator",
    href: "/calculators/gravel-driveway",
    icon: "🚜"
  },
  {
    stepNumber: 2,
    title: "1-Inch Bedding Sand Layer (ASTM C33)",
    description: "Screed exactly 1 inch of uncompacted coarse concrete sand using 1-inch outer-diameter conduit pipes as guides. Never use fine masonry sand or stone dust.",
    calculatorName: "Paver Sand Calculator",
    href: "/calculators/paver-base-sand",
    icon: "🏖️"
  },
  {
    stepNumber: 3,
    title: "Paver Placement & Edge Restraint Anchor",
    description: "Lay concrete interlocking pavers in your selected pattern (herringbone, running bond), install spiked heavy-duty PVC edge restraints or a concrete troweled toe-edge.",
    calculatorName: "Quikrete Bags Calculator",
    href: "/calculators/quikrete-bags",
    icon: "🧱"
  },
  {
    stepNumber: 4,
    title: "Polymeric Joint Sand & Compaction",
    description: "Run a plate compactor with a protective rubber pad over dry pavers to set them into bedding sand, sweep polymeric sand into joints, blow off dust, and mist with water.",
    calculatorName: "Polymeric Sand Calculator",
    href: "/calculators/polymeric-sand",
    icon: "✨"
  }
];
---

<Layout
  title="Paver Patio & Walkway Hub — Step-by-Step Construction Workflow | CalcForDIY"
  description="Follow a 4-step paver patio construction workflow: Compacted aggregate base, ASTM C33 bedding sand, paver layout, edge restraints, and polymeric sand."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Paver Patio & Walkway Hub", "item": "https://calcfordiy.com/projects/paver-patio-walkway" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Paver Patio &amp; Walkway</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-3 border border-emerald-100">
      <span>🌿 Outdoor Living &amp; Hardscaping</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Paver Patio &amp; Walkway Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Interlocking concrete paver patios offer unmatched curb appeal and zero cracking risk compared to poured concrete slabs. This master workflow walks you through ICPI (Interlocking Concrete Pavement Institute) standards: from subgrade compaction and screeded bedding sand to polymeric joint stabilization.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">2 to 3 Weekends</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$3,500 – $6,200 (65%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">ICPI Tech Spec 2 / ASTM C936</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Turnkey Contractor Quote vs. DIY Materials</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (300 Sq Ft Patio)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Hardscape contractor turn-key installation ($18–$28/sq ft) vs. DIY retail material costs &amp; plate compactor rental.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Material &amp; Rental Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$1,850 – $2,450</div>
        <div class="text-[11px] text-slate-400 mt-1">Pavers, road base, sand, edge restraints &amp; plate compactor</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Landscape Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$5,400 – $8,400</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 65% • Equipment 15% • Materials 20%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$3,550 to $5,950</strong> in your pocket while building to professional ICPI engineering specifications.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute each step in exact chronological sequence to prevent settling, rutting, or weed growth.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="David Miller, PE"
    role="Structural & Civil Engineering Consultant"
    experience="20+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="Why Stone Dust Bedding Ruins Patios (The ICPI Sand Rule)"
    note="Amateur builders love using 'stone dust' or 'rock screenings' for the 1-inch bedding layer under pavers because it sweeps easily. Never do this. Stone dust contains fine pulverized limestone particles that hold water like a sponge. In northern climates, winter freeze-thaw cycles turn waterlogged stone dust into ice crystals that jack pavers out of alignment. In wet seasons, it erodes into mush, creating sunken ankle-twisting hollows. Always screed clean, washed ASTM C33 coarse concrete sand. Concrete sand has angular grains that lock pavers together while letting rainwater freely percolate through to your graded gravel base."
  />

  <!-- Costly DIY Mistakes -->
  <CostlyMistakes
    tradeName="Paver Patio & Walkway Installation"
    mistakes={[
      {
        number: 1,
        title: "Compacting Crushed Base in One 6-Inch Lift",
        costImpact: "$2,200 (Sunken Ruts & Ponding Water)",
        description: "Standard residential plate compactors only have enough centrifugal force to compact 2 inches of gravel at a time. Dumping 6 inches in all at once leaves the bottom 4 inches loose and spongy.",
        solution: "Spread your crushed aggregate in maximum 2-inch layers, dampening with a garden hose and running the plate compactor 3 times over each lift until it rings like concrete."
      },
      {
        number: 2,
        title: "Skipping Woven Geotextile Over Soft Clay Subgrade",
        costImpact: "$1,800 (Base Stone Sinking Into Mud)",
        description: "Placing crushed gravel directly on raw clay allows heavy rainfall to turn the soil into soup. Your expensive gravel base sinks into the clay subgrade within 2 years, causing wavy pavers.",
        solution: "Always line the excavated excavation trench with woven stabilization geotextile fabric (such as Mirafi 500X) before spreading the first shovel of gravel."
      },
      {
        number: 3,
        title: "Wetting Polymeric Sand Before Cleaning Dust Off Pavers",
        costImpact: "$950 (White Polymeric Polymer Haze)",
        description: "Polymeric sand contains binders and resins. If you mist water while sand dust is still sitting on the paver face, the glue cures into a milky white haze that requires acid washing to remove.",
        solution: "Use an electric leaf blower on low throttle held at waist height to blow every speck of fine dust off the paver face before turning on the garden hose mist nozzle."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Paver Patio & Walkway Workflow"
    reviews={[
      {
        author: "Brian & Jessica K.",
        location: "Columbus, OH",
        projectScope: "350 sq ft Herringbone Patio with Fire Pit",
        savingsClaim: "Saved $4,800",
        feedback: "The 4-step workflow kept us on track over three weekends. Renting a plate compactor from Sunbelt for 2 days made the base rock-hard. The ASTM C33 concrete sand recommendation prevented any settling after our first harsh Midwest winter.",
        keyTakeaway: "Set a 1% slope (1 inch drop every 8 feet) away from the house foundation so rainwater never puddles against your siding."
      },
      {
        author: "Eric S.",
        location: "Portland, OR",
        projectScope: "Front Walkway & Steps (75 Linear Ft)",
        savingsClaim: "Saved $2,900",
        feedback: "Used the paver sand calculator and polymeric sand calculator to get exact numbers. The leaf blower tip saved our dark charcoal pavers from getting ruined by white haze. Looked as clean as a $6,000 contractor job.",
        keyTakeaway: "Drive 10-inch steel spikes into every single hole of your plastic edge restraints; loose edges cause the entire perimeter to drift apart."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Paver Patio & Walkway Workflow Hub" initialYesCount={312} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="ICPI Tech Spec 2 & ASTM C936 Standards"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/polymeric-sand-haze-prevention" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Polymeric Sand Haze Prevention →</div>
        <div class="text-xs text-gray-500 mt-1">Learn how to activate polymeric sand without leaving milky chemical stains on pavers.</div>
      </a>
      <a href="/projects/outdoor-patio" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Outdoor Patio Project Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Compare concrete slabs, flagstone, and interlocking paver material budgets.</div>
      </a>
      <a href="/guides/how-deep-should-a-gravel-driveway-be" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Aggregate Base Depth Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Sizing sub-base crushed stone and compaction factors for driveways and patios.</div>
      </a>
    </div>
  </div>

</Layout>

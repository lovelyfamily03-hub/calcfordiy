---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Curtain Trenching & 1% Laser Slope Verification",
    description: "Excavate an 18-inch deep by 12-inch wide trench intercepting groundwater slope paths, using a laser level to establish a continuous 1/8\" per foot (1% grade) fall toward daylight.",
    calculatorName: "Pipe Slope & Trench Fall Calculator",
    href: "/calculators/pipe-slope",
    icon: "🚜"
  },
  {
    stepNumber: 2,
    title: "Non-Woven Geotextile Fabric Trench Lining",
    description: "Line the entire trench bottom and vertical sidewalls with 4-oz non-woven needle-punched geotextile fabric (Mirafi 140N), leaving 12 inches of fabric wings overlapping at the surface.",
    calculatorName: "Gravel & Aggregate Base Calculator",
    href: "/calculators/gravel-driveway",
    icon: "🛡️"
  },
  {
    stepNumber: 3,
    title: "Perforated 4\" Pipe (Holes DOWN) & Washed #57 Stone",
    description: "Bed 2 inches of clean washed #57 angular drainage stone, lay 4-inch rigid perforated SDR-35 PVC pipe with holes facing DOWN (at 4 and 8 o'clock), and backfill with stone to within 4 inches of grade.",
    calculatorName: "French Drain Trench Calculator",
    href: "/calculators/french-drain",
    icon: "🪨"
  },
  {
    stepNumber: 4,
    title: "Fabric Burrito Wrap & Permeable Turf Reinstatement",
    description: "Fold geotextile fabric wings over the gravel envelope like a burrito, top with 4 inches of coarse sand or permeable topsoil, and reinstall cut lawn sod rolls flush with grade.",
    calculatorName: "Drywell Stormwater Calculator",
    href: "/calculators/drywell-stormwater",
    icon: "🌱"
  }
];
---

<Layout
  title="Exterior French Drain & Curtain Drain Hub — Step-by-Step Workflow | CalcForDIY"
  description="Follow a 4-step yard French drain and curtain drain workflow: Trench slope math, non-woven geotextile lining, perforated pipe (holes DOWN), and burrito wraps."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Exterior French Drain Hub", "item": "https://calcfordiy.com/projects/exterior-french-drain-curtain-drain" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">French Drain &amp; Curtain Drain</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>💧 Groundwater Interception &amp; Yard De-Watering</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Exterior French Drain &amp; Curtain Drain Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      A perimeter French drain or hillside curtain drain intercepts subsurface groundwater before it can saturate your foundation backfill or turn your lawn into a squishy swamp. This master workflow covers civil drainage standards: non-woven geotextile envelopes, hydraulic stone voids, the holes-down pipe orientation rule, and daylight discharge.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">1 to 2 Weekends (100 Ft Run)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$3,800 – $6,500 (75%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">IRC Section R405 &amp; ASTM D3034</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Drainage Contractor Bid vs. DIY Materials</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (100 Linear Foot 18" Deep French Drain)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Landscape drainage contractor quote ($45–$70/linear ft) vs. DIY retail washed #57 stone, SDR-35 pipe, geotextile &amp; walk-behind trencher.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Materials &amp; Trencher Rental</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$950 – $1,400</div>
        <div class="text-[11px] text-slate-400 mt-1">100 ft perforated PVC pipe, 7 tons washed #57 stone, fabric &amp; 1-day trencher rental</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Licensed Drainage Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$4,800 – $7,200</div>
        <div class="text-[11px] text-slate-400 mt-1">Excavation &amp; Grading Labor 70% • Sod Repair &amp; Machine 15% • Materials 15%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$3,850 to $5,800</strong> while ensuring your French drain is wrapped in a full geotextile burrito that never silts shut.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Follow the 4 steps in order to guarantee uninterrupted gravity flow without clogging or soil intrusion.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="David Miller, PE"
    role="Structural & Civil Engineering Consultant"
    experience="20+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="Why Drain Pipe Holes Face DOWN, Not Up (Groundwater Physics)"
    note="The most common mistake made by DIYers and inexperienced landscapers is installing perforated French drain pipe with the drilled holes pointing UP toward the sky! They think, 'Water falls from the sky, so the holes should catch the rain!' That is completely wrong. Surface rain does not fall into a French drain like an open gutter. Rain soaks into the soil, saturating the ground from the bottom up. As the groundwater water table rises, it fills the bottom of the gravel trench. If your holes face UP, the water table must rise 4 full inches above the bottom of the pipe before a single drop can spill into the pipe—leaving the bottom 4 inches of your foundation permanently underwater! When the holes face DOWN (oriented at 4 and 8 o'clock on the bottom of the pipe), rising groundwater enters the pipe immediately, where gravity whisks it away before it can saturate surrounding soil."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="French Drain Installation"
    mistakes={[
      {
        number: 1,
        title: "Wrapping Fabric Socks Directly Around Perforated Pipe",
        costImpact: "$2,800 (Excavating Silt-Blinded Drain in 2 Years)",
        description: "Buying pipe pre-wrapped in a tight fabric sock allows fine clay silt to wash through gravel and cake directly against the pipe perforations, choking off flow.",
        solution: "Never wrap the pipe directly; wrap the ENTIRE gravel trench envelope in non-woven needle-punched geotextile fabric (the 'burrito wrap' method)."
      },
      {
        number: 2,
        title: "Using Dirty Crusher Run or Pea Gravel Instead of Washed #57",
        costImpact: "$1,800 (Clogged Stone Void Space)",
        description: "Crusher run contains stone dust and sand that solidifies like weak concrete when wet, destroying the 40% open void space needed for water movement.",
        solution: "Specify clean, double-washed 3/4-inch angular crushed granite or limestone (#57 stone) with zero stone dust fines."
      },
      {
        number: 3,
        title: "Creating Low Sags (Bellies) in the Trench Bottom",
        costImpact: "$1,100 (Standing Water & Mosquito Infestation)",
        description: "Digging uneven trench bottoms causes stagnant water to pool in dips, silting up over time and causing winter ice blockages.",
        solution: "Use a builder's laser level or string line level to maintain a laser-straight continuous downward slope of at least 1/8\" per foot."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="French Drain Workflow"
    reviews={[
      {
        author: "Clayton & Valerie W.",
        location: "Raleigh, NC",
        projectScope: "120-ft Backyard Hillside Curtain Drain",
        savingsClaim: "Saved $4,900 vs Drainage Company",
        feedback: "Our backyard was a swampy mess after every rain. Rented a walk-behind trenching machine and dug an 18-inch trench along our back fence line. Lined with 4-oz non-woven fabric, bedded with washed #57 stone, and pointed holes down. Discharges to daylight in the front ditch. Yard is completely firm and dry now.",
        keyTakeaway: "Order stone delivered in a tri-axle dump truck directly onto your driveway; buying small bags at a box store costs 4x more."
      },
      {
        author: "Stuart M.",
        location: "Seattle, WA",
        projectScope: "Foundation Perimeter French Drain",
        savingsClaim: "Basement Sump Pump Runs 80% Less",
        feedback: "David's explanation on holes pointing down was eye-opening. Lined the trench like a burrito with overlapping wings on top. Our basement walls have stayed bone dry through 4 straight months of Pacific Northwest winter drizzle.",
        keyTakeaway: "Install a 4-inch sweep cleanout riser at the highest upstream point of the pipe so you can run a garden hose or snake through it if needed."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Exterior French Drain Hub" initialYesCount={384} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="IRC Section R405 (Foundation Drainage) & ASTM D3034 / ASTM F405"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/french-drain-pipe-holes-up-or-down" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Holes Up vs Down Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Groundwater hydraulic physics, surface tension inflow, and why holes MUST face down.</div>
      </a>
      <a href="/calculators/french-drain" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">French Drain Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate pipe length, stone cubic yards, and geotextile fabric square footage.</div>
      </a>
      <a href="/projects/drywell-stormwater-drainage" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Drywell Drainage Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Route your French drain discharge to an underground Flo-Well infiltration basin.</div>
      </a>
    </div>
  </div>

</Layout>

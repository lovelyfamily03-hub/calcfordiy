---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Drum Sander Rough Cut & Perimeter Edge Sanding",
    description: "Rent a 220V expanding drum sander and rotary edger, make coarse passes with 36-grit and 60-grit sandpaper along the wood grain, feathered to the perimeter baseboards.",
    calculatorName: "Hardwood Flooring Calculator",
    href: "/calculators/hardwood-flooring",
    icon: "⚙️"
  },
  {
    stepNumber: 2,
    title: "Full-Trowel Latex Wood Filler Sweep",
    description: "Spread color-matched water-based wood floor filler across the entire room with a flat trowel to fill nail holes, micro-checks, and gaps between planks before final sanding.",
    calculatorName: "Floor Underlayment Calculator",
    href: "/calculators/underlayment",
    icon: "🪵"
  },
  {
    stepNumber: 3,
    title: "Multi-Disc Rotary Screening (80, 100 & 120 Grit)",
    description: "Operate an orbital or planetary multi-disc buffer to blend drum sanding lines with edge sanding marks, finishing with a 120-grit screen, followed by thorough HEPA vacuuming.",
    calculatorName: "Hardwood Flooring Calculator",
    href: "/calculators/hardwood-flooring",
    icon: "✨"
  },
  {
    stepNumber: 4,
    title: "Commercial Waterborne Sealer & 2-Component Polyurethane",
    description: "Apply 1 coat of tannin-blocking waterborne sealer with a t-bar applicator, abrade with a 220-grit maroon pad, and roll 2 coats of commercial 2-part polyurethane (Bona Traffic HD).",
    calculatorName: "Paint & Finish Calculator",
    href: "/calculators/paint-room",
    icon: "🖌️"
  }
];
---

<Layout
  title="Hardwood Floor Refinishing Hub — Step-by-Step Restoration Workflow | CalcForDIY"
  description="Follow a 4-step hardwood floor sanding and refinishing workflow: Drum sander rough cuts, full-trowel filling, orbital screening, and 2-part waterborne polyurethane."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Hardwood Floor Refinishing Hub", "item": "https://calcfordiy.com/projects/hardwood-floor-refinishing" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Hardwood Floor Refinishing</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold mb-3 border border-emerald-100">
      <span>🪵 Flooring Restoration &amp; Wood Finishing</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Hardwood Floor Sanding &amp; Refinishing Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Restoring scratched, graying 3/4-inch solid oak or maple floors transforms a home and adds instant equity. This master workflow covers NWFA (National Wood Flooring Association) standards: drum sanding grit progressions, full-trowel wood filling, planetary buffer swirl blending, and non-yellowing commercial waterborne finishes.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">3 Days (800 Sq Ft)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$2,800 – $4,600 (70%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Industry Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">NWFA Sand &amp; Finish Guidelines</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Flooring Contractor Bid vs. DIY Equipment Rental</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (800 Sq Ft Solid Red Oak Refinish)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Professional wood floor sanding contractor quote ($4.50–$7.50/sq ft) vs. DIY retail drum sander/edger rental, abrasives &amp; commercial polyurethane.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Equipment &amp; Finish Materials</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$750 – $1,050</div>
        <div class="text-[11px] text-slate-400 mt-1">2-day sander/edger rental, belts, filler, Bona Traffic HD finish &amp; applicator</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Hardwood Floor Refinishing Contractor Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$3,600 – $5,800</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 70% • Specialized Dust Containment 15% • Materials 15%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$2,850 to $4,750</strong> while choosing high-end commercial 2-component finish that outlasts standard contractor oil poly.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute each sanding grit progression in order without skipping numbers to prevent visible scratch rings.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Elena Rostova, CBO"
    role="Certified Building Official & Material Takeoff Analyst"
    experience="18+ Years Field Experience"
    avatarBg="bg-emerald-100 text-emerald-800"
    initials="ER"
    title="How to Never Gouge a Floor with a Drum Sander"
    note="A 220V commercial drum sander weighs over 150 pounds and spins at 1,800 RPM. If you pause your forward motion for even half a second while the abrasive drum is touching the floor, it will instantly dig a permanent 1/8-inch deep ditch straight into your hardwood (a catastrophic 'drum gouge'). The golden rule of drum sanding: The machine must be in motion BEFORE the drum touches the floor, and the drum must be lifted BEFORE the machine stops! Think of it like landing an airplane on a runway: feather the control lever down smoothly while walking forward, and pull the lever back up gently before reaching the wall. Practice walking across the room with the motor running and the drum in the UP position for 5 minutes until you master the rhythm."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Hardwood Floor Refinishing"
    mistakes={[
      {
        number: 1,
        title: "Skipping a Sanding Grit in the Sequence",
        costImpact: "$1,800 (Permanent Visible Sanding Scratches)",
        description: "Jumping directly from coarse 36-grit to 100-grit fails to remove the deep gouges left by the coarse paper. When clear finish is applied, the floor looks covered in circular scratches.",
        solution: "Strictly follow the NWFA grit sequence: 36 &rarr; 60 &rarr; 80 &rarr; 100 &rarr; 120 screening. Each grit removes the scratch pattern of the previous grit."
      },
      {
        number: 2,
        title: "Spreading Wood Dust with a Standard Household Vacuum",
        costImpact: "$650 (Rough 'Sandpaper' Polyurethane Coat)",
        description: "Standard vacuum filters allow microscopic wood dust to shoot back into the room air, settling onto wet polyurethane like fine sandpaper grit.",
        solution: "Use a commercial HEPA-filtered vacuum, followed by thoroughly wiping the floor with slightly damp microfiber tack towels before applying finish."
      },
      {
        number: 3,
        title: "Applying Oil Polyurethane Over Incompatible Water Sealer",
        costImpact: "$2,200 (Finish Peeling & Delamination)",
        description: "Mixing oil-based and waterborne finishes without proper cure times triggers chemical incompatibility, causing the topcoat to peel off in sheets.",
        solution: "Stick with a single system from sealer to topcoat (such as Bona ClassicSeal paired with Bona Mega or Traffic HD)."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Hardwood Refinishing Workflow"
    reviews={[
      {
        author: "Marcus & Diane P.",
        location: "Milwaukee, WI",
        projectScope: "1920s Bungalow 950 sq ft White Oak Restoration",
        savingsClaim: "Saved $3,800 vs Pro Bid",
        feedback: "Rented an American Sanders drum and edger for the weekend. The airplane landing technique kept us from gouging our century-old floors. We finished with Bona Traffic HD Satin—the natural matte look highlights the grain without yellowing.",
        keyTakeaway: "Empty the sander cloth dust bag outside when it gets 1/3 full; spontaneous combustion from hot wood dust is a real fire hazard."
      },
      {
        author: "Trevor C.",
        location: "Richmond, VA",
        projectScope: "Living Room & Hallway Red Oak Refinish",
        savingsClaim: "Zero Dust in Rest of House",
        feedback: "Taped plastic sheeting over all interior doorways and placed a box fan in a window blowing out to create negative air pressure. Full-trowel filling made our 60-year-old floor look seamless and solid.",
        keyTakeaway: "Use an edger with a high-intensity work light; it reveals hidden swirl marks that regular ceiling lights miss."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Hardwood Floor Refinishing Workflow Hub" initialYesCount={344} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Material Takeoff Analyst"
    codeStandard="National Wood Flooring Association (NWFA) Sand & Finish Guidelines"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/waterborne-vs-oil-polyurethane-hardwood" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Polyurethane Comparison Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Waterborne vs oil-based poly: amber yellowing, cure times, hardness, and VOCs.</div>
      </a>
      <a href="/calculators/hardwood-flooring" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Hardwood Flooring Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate square footage, carton counts, and waste percentages for wood flooring.</div>
      </a>
      <a href="/projects/flooring-installation" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Flooring Installation Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Complete flooring workflow: subfloor prep, underlayment, and trim installation.</div>
      </a>
    </div>
  </div>

</Layout>

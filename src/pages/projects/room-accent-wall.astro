---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Room Paint & Primer Gallons",
    description: "Calculate paint gallons for walls, ceiling, windows, and doors with 2-coat coverage.",
    calculatorName: "Room Paint Calculator",
    href: "/calculators/paint-room",
    icon: "🎨"
  },
  {
    stepNumber: 2,
    title: "Board & Batten Accent Wall",
    description: "Calculate vertical batten counts, exact spacing gaps in inches & fractions, and view live SVG elevation diagram.",
    calculatorName: "Board & Batten Calculator",
    href: "/calculators/board-and-batten",
    icon: "📐"
  },
  {
    stepNumber: 3,
    title: "Wainscoting Picture Frame Molding",
    description: "Calculate box counts, frame widths, miter cuts, and view scaled SVG picture frame wall diagram.",
    calculatorName: "Wainscoting Layout Calculator",
    href: "/calculators/wainscoting-layout",
    icon: "🖼️"
  },
  {
    stepNumber: 4,
    title: "Trim, Baseboard & Crown Molding",
    description: "Calculate linear feet of baseboard, shoe molding, or crown molding with miter corner waste.",
    calculatorName: "Trim & Molding Calculator",
    href: "/calculators/trim-molding",
    icon: "🪵"
  }
];
---

<Layout
  title="Interior Accent Wall & Trim Hub — Step-by-Step Millwork Workflow | CalcForDIY"
  description="Follow a 4-step accent wall and trim workflow: room paint gallons, board & batten spacing, wainscoting picture frames, and crown molding."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Accent Wall and Millwork Materials",
    "description": "A 4-step DIY workflow for calculating paint gallons, board & batten spacing, wainscoting boxes, and trim molding.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Calculate Room Paint", "url": "https://calcfordiy.com/calculators/paint-room" },
      { "@type": "HowToStep", "position": 2, "name": "Calculate Board and Batten", "url": "https://calcfordiy.com/calculators/board-and-batten" },
      { "@type": "HowToStep", "position": 3, "name": "Calculate Wainscoting Layout", "url": "https://calcfordiy.com/calculators/wainscoting-layout" },
      { "@type": "HowToStep", "position": 4, "name": "Calculate Trim Molding", "url": "https://calcfordiy.com/calculators/trim-molding" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Room Accent Wall Hub", "item": "https://calcfordiy.com/projects/room-accent-wall" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span>Room Accent Wall Hub</span>
  </div>

  <div class="mb-8 bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-2">
      <span class="text-3xl">🎨</span>
      <h1 class="text-3xl font-bold text-gray-900">Interior Accent Wall &amp; Trim Hub</h1>
    </div>
    <p class="text-gray-600 text-lg leading-relaxed max-w-3xl">
      Elevate plain drywall into custom architectural millwork. Follow this 4-step workflow to plan paint, board &amp; batten accent walls, picture frame wainscoting, and baseboard trim.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-blue-300 transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="bg-blue-600 text-white font-bold w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-lg shadow-sm">
            {step.stepNumber}
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xl">{step.icon}</span>
              <h2 class="text-xl font-bold text-gray-900">{step.title}</h2>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed max-w-2xl">
              {step.description}
            </p>
          </div>
        </div>

        <a href={step.href} class="shrink-0 w-full md:w-auto bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-5 py-3 rounded-lg border border-blue-200 transition-colors text-sm flex items-center justify-center gap-2">
          Use {step.calculatorName} →
        </a>
      </div>
    ))}
  </div>

</Layout>

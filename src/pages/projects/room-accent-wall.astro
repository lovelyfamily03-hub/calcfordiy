---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Room Paint & Primer Gallons",
    description: "Calculate paint gallons for walls, ceiling, windows, and doors with 2-coat coverage.",
    calculatorName: "Room Paint Calculator",
    href: "/calculators/paint-room/",
    icon: "🎨"
  },
  {
    stepNumber: 2,
    title: "Board & Batten Accent Wall",
    description: "Calculate vertical batten counts, exact spacing gaps in inches & fractions, and view live SVG elevation diagram.",
    calculatorName: "Board & Batten Calculator",
    href: "/calculators/board-and-batten/",
    icon: "📐"
  },
  {
    stepNumber: 3,
    title: "Wainscoting Picture Frame Molding",
    description: "Calculate box counts, frame widths, miter cuts, and view scaled SVG picture frame wall diagram.",
    calculatorName: "Wainscoting Layout Calculator",
    href: "/calculators/wainscoting-layout/",
    icon: "🖼️"
  },
  {
    stepNumber: 4,
    title: "Trim, Baseboard & Crown Molding",
    description: "Calculate linear feet of baseboard, shoe molding, or crown molding with miter corner waste.",
    calculatorName: "Trim & Molding Calculator",
    href: "/calculators/trim-molding/",
    icon: "🪵"
  }
];
---

<Layout
  title="Interior Accent Wall & Trim Hub — Step-by-Step Millwork Workflow | CalcForDIY"
  description="Follow a 4-step accent wall and trim workflow: room paint gallons, board & batten spacing, wainscoting picture frames, and crown molding."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Accent Wall and Millwork Materials",
    "description": "A 4-step DIY workflow for calculating paint gallons, board & batten spacing, wainscoting boxes, and trim molding.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Calculate Room Paint", "url": "https://calcfordiy.com/calculators/paint-room/" },
      { "@type": "HowToStep", "position": 2, "name": "Calculate Board and Batten", "url": "https://calcfordiy.com/calculators/board-and-batten/" },
      { "@type": "HowToStep", "position": 3, "name": "Calculate Wainscoting Layout", "url": "https://calcfordiy.com/calculators/wainscoting-layout/" },
      { "@type": "HowToStep", "position": 4, "name": "Calculate Trim Molding", "url": "https://calcfordiy.com/calculators/trim-molding/" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://calcfordiy.com/projects/" },
      { "@type": "ListItem", "position": 3, "name": "Room Accent Wall Hub", "item": "https://calcfordiy.com/projects/room-accent-wall/" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects/" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span>Room Accent Wall Hub</span>
  </div>

  <div class="mb-8 bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-2">
      <span class="text-3xl">🎨</span>
      <h1 class="text-3xl font-bold text-gray-900">Interior Accent Wall &amp; Trim Hub</h1>
    </div>
    <p class="text-gray-600 text-lg leading-relaxed max-w-3xl">
      Elevate plain drywall into custom architectural millwork. Follow this 4-step workflow to plan paint, board &amp; batten accent walls, picture frame wainscoting, and baseboard trim.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-blue-300 transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="bg-blue-600 text-white font-bold w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-lg shadow-sm">
            {step.stepNumber}
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xl">{step.icon}</span>
              <h2 class="text-xl font-bold text-gray-900">{step.title}</h2>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed max-w-2xl">
              {step.description}
            </p>
          </div>
        </div>

        <a href={step.href} class="shrink-0 w-full md:w-auto bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-5 py-3 rounded-lg border border-blue-200 transition-colors text-sm flex items-center justify-center gap-2">
          Use {step.calculatorName} →
        </a>
      </div>
    ))}
  </div>

  <!-- Finish Carpentry Code & Inspection Sequence -->
  <section class="bg-white border border-gray-200 rounded-xl p-6 mb-8 space-y-4">
    <h2 class="text-xl font-bold text-gray-900">Millwork Sequencing, Acclimation &amp; Fastening Rules</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-700 leading-relaxed">
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
        <h3 class="font-bold text-gray-900 mb-1">1. 72-Hour Lumber Moisture Acclimation</h3>
        <p>Solid pine, poplar, and MDF trim shrink across seasonal humidity swings. Stack battens and rails on stickers inside the conditioned room for at least 72 hours to reach 6%–9% equilibrium moisture content before mitering and caulking joints.</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
        <h3 class="font-bold text-gray-900 mb-1">2. Stud &amp; Top-Plate Fastener Bearing</h3>
        <p>18-gauge brad nails alone rely purely on drywall gypsum shear and separate over heating cycles. Snap vertical chalk lines on 16-inch stud centers, run construction adhesive sparingly along stile backs, and sink 2-inch 15-gauge or 16-gauge finish nails into solid framing.</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
        <h3 class="font-bold text-gray-900 mb-1">3. Level 4/5 Drywall &amp; Paint Sheen Compatibility</h3>
        <p>Raking window light exposes drywall tape humps next to crisp geometric board-and-batten edges. Skim and sand uneven plaster or drywall seams before installing trim, then apply urethane-alkyd enamel over primed wood for wipeable semi-gloss or satin sheen uniformity.</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
        <h3 class="font-bold text-gray-900 mb-1">4. Box Layout Off Electrical Plates</h3>
        <p>Measure light switches, thermostats, and floor outlets before locking in wainscot stile spacing. Shifting center-to-center rail pitch by 3/4 inch avoids cutting decorative trim frames straight through receptacle cover plates.</p>
      </div>
    </div>
  </section>

  <!-- Cross-Linked Engineering Guides & Dispatches -->
  <section class="bg-gray-50 border border-gray-200 rounded-xl p-6">
    <h2 class="text-lg font-bold text-gray-900 mb-3">Related Finish Carpentry Guides &amp; Field Reports</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
      <a href="/guides/how-to-cut-crown-molding/" class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-400 transition-colors">
        <div class="font-semibold text-gray-900">Crown Molding Miter &amp; Bevel Angle Guide →</div>
        <div class="text-xs text-gray-600 mt-1">Exact compound saw settings (31.62° miter / 33.86° bevel) for 52/38° crown profiles.</div>
      </a>
      <a href="/guides/paint-sheen-selection-guide/" class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-400 transition-colors">
        <div class="font-semibold text-gray-900">Interior Paint Sheen &amp; Washability Guide →</div>
        <div class="text-xs text-gray-600 mt-1">Flat vs. matte vs. satin vs. semi-gloss sheen selection for trim and accent walls.</div>
      </a>
      <a href="/guides/french-cleat-load-capacity-math/" class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-400 transition-colors">
        <div class="font-semibold text-gray-900">French Cleat Load Capacity &amp; Screw Shear →</div>
        <div class="text-xs text-gray-600 mt-1">Anchor heavy cabinetry, floating shelves, and shop storage directly to wall studs.</div>
      </a>
      <a href="/projects/coffered-ceiling-layout/" class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-400 transition-colors">
        <div class="font-semibold text-gray-900">Coffered Ceiling Box Beam Workflow Hub →</div>
        <div class="text-xs text-gray-600 mt-1">Pair accent wall wainscoting with symmetrical ceiling beam grids and mitered casing.</div>
      </a>
      <a href="/journal/tearing-down-80-year-old-plaster-ceiling-level-5-drywall/" class="bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-400 transition-colors md:col-span-2">
        <div class="font-semibold text-gray-900">Field Dispatch: Plaster Demolition &amp; Level 5 Drywall Prep →</div>
        <div class="text-xs text-gray-600 mt-1">How bowed 1940s framing and skim-coat lighting checks dictate wall prep before millwork.</div>
      </a>
    </div>
  </section>

</Layout>

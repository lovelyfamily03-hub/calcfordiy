---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Concrete Slab Sub-Base & Footing",
    description: "Calculate cubic yards of ready-mix concrete, 80-lb bags, rebar grid spacing, and formwork lumber for patio foundations.",
    calculatorName: "Concrete Slab Calculator",
    href: "/calculators/concrete-slab",
    icon: "🧱"
  },
  {
    stepNumber: 2,
    title: "Paver Base Gravel & Sand Bedding",
    description: "Determine crushed stone base tons (4-6\" depth), bedding sand cubic yards (1\" layer), polymeric sand bags, and excavation depth.",
    calculatorName: "Paver Base & Sand Calculator",
    href: "/calculators/paver-base-sand",
    icon: "🏜️"
  },
  {
    stepNumber: 3,
    title: "Retaining Wall Blocks & Drainage Gravel",
    description: "Calculate block counts, cap stones, drainage gravel backfill, geotextile fabric, and geogrid reinforcement layers for slope retention.",
    calculatorName: "Retaining Wall Calculator",
    href: "/calculators/retaining-wall",
    icon: "🧱"
  },
  {
    stepNumber: 4,
    title: "Patio String Lighting & Amperage",
    description: "Calculate total strand linear feet, bulb counts, hanging guide wires, and electrical circuit load for evening patio ambiance.",
    calculatorName: "String Lights Calculator",
    href: "/calculators/string-lights",
    icon: "💡"
  }
];
---

<Layout
  title="Outdoor Patio & Hardscaping Hub — Step-by-Step Construction Workflow | CalcForDIY"
  description="Follow a 4-step outdoor patio construction workflow: concrete slab foundations, paver base gravel & sand, retaining wall blocks, and string lighting."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Plan and Calculate Outdoor Patio Construction Materials",
    "description": "A 4-step DIY workflow for calculating concrete patio slabs, paver gravel base, retaining walls, and outdoor lighting.",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Calculate Concrete Slab Base", "url": "https://calcfordiy.com/calculators/concrete-slab" },
      { "@type": "HowToStep", "position": 2, "name": "Calculate Paver Base & Sand", "url": "https://calcfordiy.com/calculators/paver-base-sand" },
      { "@type": "HowToStep", "position": 3, "name": "Calculate Retaining Wall Blocks", "url": "https://calcfordiy.com/calculators/retaining-wall" },
      { "@type": "HowToStep", "position": 4, "name": "Calculate Patio String Lighting", "url": "https://calcfordiy.com/calculators/string-lights" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Outdoor Patio Hub", "item": "https://calcfordiy.com/projects/outdoor-patio" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span>Outdoor Patio Hub</span>
  </div>

  <div class="mb-8 bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-2">
      <span class="text-3xl">🏜️</span>
      <h1 class="text-3xl font-bold text-gray-900">Outdoor Patio &amp; Hardscaping Hub</h1>
    </div>
    <p class="text-gray-600 text-lg leading-relaxed max-w-3xl">
      Designing a durable outdoor patio requires proper sub-grade excavation, base compaction, retaining wall support, and ambient lighting. Follow this 4-step workflow to calculate exact material quantities.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-blue-300 transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="bg-blue-600 text-white font-bold w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-lg shadow-sm">
            {step.stepNumber}
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xl">{step.icon}</span>
              <h2 class="text-xl font-bold text-gray-900">{step.title}</h2>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed max-w-2xl">
              {step.description}
            </p>
          </div>
        </div>

        <a href={step.href} class="shrink-0 w-full md:w-auto bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-5 py-3 rounded-lg border border-blue-200 transition-colors text-sm flex items-center justify-center gap-2">
          Use {step.calculatorName} →
        </a>
      </div>
    ))}
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Hardscaping &amp; Patio Base Pro Tips</h2>
    <div class="space-y-3 text-sm text-gray-700">
      <p><strong>Slope for Drainage:</strong> Always pitch your patio away from the house foundation at a minimum slope of 1/4 inch per foot (1 foot drop per 48 feet run).</p>
      <p><strong>Compaction Lift Thickness:</strong> Compact crushed stone base gravel (Crusher Run / #23A) in 2-inch lifts with a plate compactor rather than compacting 6 inches all at once.</p>
    </div>
  </div>

</Layout>

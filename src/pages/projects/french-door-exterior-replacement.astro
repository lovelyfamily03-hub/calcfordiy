---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Rough Opening Verification, Header Span & Subfloor Leveling",
    description: "Measure rough opening width and height, ensuring 1/2\" to 3/4\" clearance around the pre-hung jamb. Verify that the structural door header supports roof loads without sagging (IRC Table R602.7), and plane or shim the subfloor perfectly flat across the entire 60\" or 72\" threshold.",
    calculatorName: "Wall Framing & Stud Layout Calculator",
    href: "/calculators/wall-framing",
    icon: "🪵"
  },
  {
    stepNumber: 2,
    title: "Sloped Sill Pan Flashing with Rear Back-Dam & Dog-Ear Corners",
    description: "Install a rigid PVC sloped sill pan (SureSill or Jamsill Guard) or fabricate a flexible butyl membrane pan. Ensure a continuous 3/8\" to 1/2\" rear back-dam along the interior subfloor, dog-eared end dams climbing 4 inches up the king studs, and a positive outward drainage slope.",
    calculatorName: "Subfloor Materials & Fasteners Calculator",
    href: "/calculators/subfloor",
    icon: "📐"
  },
  {
    stepNumber: 3,
    title: "Pre-Hung Door Setting, Shimming & 3-Inch Structural Hinge Anchoring",
    description: "Set the heavy double-door unit into three continuous beads of polyurethane sealant. Shim behind all hinges and strike plates until margins are an even 1/8\" all around. Replace short factory hinge screws with 3-inch hardened structural screws driven deep into the framing king studs.",
    calculatorName: "Deck Screws & Hardware Calculator",
    href: "/calculators/deck-screws-hardware",
    icon: "🚪"
  },
  {
    stepNumber: 4,
    title: "Low-Expansion Foam Air-Sealing, Head Drip Cap & Weatherstripping",
    description: "Seal the perimeter gap with low-pressure, closed-cell window and door foam (AAMA 812 compliant) to prevent jamb bowing. Install an extruded aluminum head Z-flashing drip cap integrated behind the weather-resistant barrier (WRB), and adjust the bottom threshold sill gasket.",
    calculatorName: "Garage Door Header Span Calculator",
    href: "/calculators/garage-door-header",
    icon: "✨"
  }
];
---

<Layout
  title="Exterior French Door Replacement Hub — Step-by-Step Workflow | CalcForDIY"
  description="Replace exterior French patio doors: rough opening prep, sloped sill pan flashing with back dam, 3-inch structural hinge anchoring, and low-expansion foam air-sealing."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Exterior French Door Replacement Hub", "item": "https://calcfordiy.com/projects/french-door-exterior-replacement" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Replace Exterior French Doors",
    "description": "Professional engineering and carpentry guide for installing pre-hung exterior double French doors with watertight sill flashing and structural hinge anchors.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Rough Opening & Subfloor Flatness",
        "text": "Check header load rating, square the opening with diagonal measurements, and level the subfloor threshold."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Sill Pan Flashing Installation",
        "text": "Install a rigid or flexible sill pan with a 1/2\" rear back-dam and watertight turned-up corners."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Door Setting & Structural Fastening",
        "text": "Bed the sill in sealant, square the jamb with shims, and anchor hinges with 3\" screws into framing studs."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Low-Expansion Foam & Head Flashing",
        "text": "Insulate perimeter with non-expanding door foam and flash top head jamb with Z-profile aluminum drip cap."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">French Door Replacement</span>
  </nav>

  <!-- Hero Section -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>🚪 Architectural Millwork &amp; Building Envelope</span>
      <span>•</span>
      <span>ASTM E2112 &amp; IRC R609 Fenestration Codes</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Exterior French Door Replacement Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Swapping a sliding patio door or rotted double door for modern, energy-efficient exterior French doors enhances natural light, outdoor access, and curb appeal. Because French doors hang two heavy hinged slabs (over 150 lbs each) from opposite jambs meeting at an unsupported center astragal, precision framing, rigid structural anchoring, and <strong>positive sloped sill pan flashing</strong> are essential to prevent drafts, sagging, and chronic subfloor rot.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 mb-6">
      <div>
        <div class="text-xs text-gray-500 font-medium">Standard Rough Opening</div>
        <div class="text-lg font-bold text-gray-900">62" or 74" x 82.5"</div>
        <div class="text-xs text-blue-600">For 5-ft or 6-ft Units</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Hinge Screw Depth</div>
        <div class="text-lg font-bold text-gray-900">3.00" Hardened</div>
        <div class="text-xs text-emerald-600">Bites 2x Stud Framing</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Sill Pan Back-Dam</div>
        <div class="text-lg font-bold text-gray-900">&ge; 3/8" Height</div>
        <div class="text-xs text-purple-600">Blocks Wind-Driven Rain</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">DIY Project Cost</div>
        <div class="text-lg font-bold text-gray-900">$1,100 - $2,200</div>
        <div class="text-xs text-amber-600">Saves $2,500+ vs Pro</div>
      </div>
    </div>

    <!-- RSMeans Contractor vs DIY Comparison -->
    <div class="border border-gray-200 rounded-xl overflow-hidden mb-6">
      <div class="bg-gray-100 px-4 py-2.5 font-semibold text-xs text-gray-700 uppercase tracking-wider">
        Project Cost Benchmark: 6-Foot Fiberglass Double French Door Replacement
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-gray-200 text-sm">
        <div class="p-4 bg-white">
          <div class="text-xs font-bold text-gray-500 uppercase mb-1">Licensed Millwork &amp; Window Contractor</div>
          <div class="text-2xl font-black text-gray-900 mb-2">$3,600 – $5,800</div>
          <ul class="text-xs text-gray-600 space-y-1.5">
            <li>• Removal of old slider, framing inspection &amp; disposal: $450 – $750</li>
            <li>• Subfloor leveling, custom sill pan fabrication &amp; flashing: $550 – $850</li>
            <li>• Pre-hung door installation, structural shimming &amp; anchoring: $1,400 – $2,200</li>
            <li>• Low-expansion foam insulation, exterior PVC brickmould &amp; interior trim: $1,200 – $2,000</li>
          </ul>
        </div>
        <div class="p-4 bg-emerald-50/50">
          <div class="text-xs font-bold text-emerald-800 uppercase mb-1">DIY Self-Performance</div>
          <div class="text-2xl font-black text-emerald-700 mb-2">$1,150 – $2,350</div>
          <ul class="text-xs text-gray-700 space-y-1.5">
            <li>• Pre-hung 72x80 fiberglass French door unit with Low-E glass: $950 – $1,800</li>
            <li>• Rigid PVC 3-piece sloped sill pan kit (SureSill / Jamsill): $65 – $110</li>
            <li>• 3-inch #9 structural wood screws, composite shims &amp; drip cap: $45 – $80</li>
            <li>• 2 cans AAMA 812 low-expansion door foam &amp; hybrid polyurethane caulk: $40 – $70</li>
            <li>• Exterior PVC brickmould trim &amp; smart deadbolt hardware: $50 – $290</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Step by Step Workflow Cards -->
  <div class="space-y-6 mb-10 not-prose">
    <h2 class="text-2xl font-black text-gray-900 tracking-tight">The 4-Step French Door Replacement Workflow</h2>
    
    <div class="grid grid-cols-1 gap-4">
      {workflowSteps.map((step) => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 hover:border-blue-300 transition-all shadow-xs">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-blue-600 text-white font-bold flex items-center justify-center text-lg shadow-sm">
              {step.stepNumber}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-base font-bold text-gray-900">{step.title}</h3>
                <span class="text-lg">{step.icon}</span>
              </div>
              <p class="text-sm text-gray-600 mb-3 leading-relaxed">{step.description}</p>
              <a
                href={step.href}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 px-3 py-1.5 rounded-md hover:bg-blue-100 transition-colors"
              >
                <span>Calculate Framing: {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Trade Field Note -->
  <FieldNote
    expertName="David Miller, PE"
    role="Senior Structural & Geotechnical Engineer"
    experience="25+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="Why Factory 3/4-Inch Hinge Screws Guarantee Your French Doors Will Sag"
    note="When you unpack a brand new $1,500 pre-hung French patio door, you will notice the hinges are attached with tiny 3/4-inch screws that penetrate ONLY into the 5/8-inch pine jamb. If you leave those factory screws in place, your installation is doomed! Each door slab weighs 80 to 140 lbs. Over 6 months of swinging open and closed, that cantilevered gravitational torque pulls the short screws right out of the soft pine jamb. The two doors sag inward, the center astragal rubs together, and the deadbolt fails to align with the strike hole. On every single hinge, you MUST remove at least two of the short screws closest to the weatherstrip and replace them with heavy-duty 3-inch #9 or #10 hardened structural wood screws. These 3-inch screws penetrate through the jamb, pass through the shim pack, and bite 1-1/2 inches deep into the solid doubled 2x4 framing king studs, locking the door slabs permanently plumb."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Exterior French Door Installation"
    mistakes={[
      {
        number: 1,
        title: "Omitting a Sloped Sill Pan Flashing with Rear Back-Dam",
        costImpact: "$4,500 (Subfloor Rot, Rim Joist Decay & Mold Remediation)",
        description: "Relying purely on a bead of caulk underneath the door threshold will fail within 3 to 5 years as the sealant dries and shrinks under thermal cycles.",
        solution: "Install a rigid PVC or self-adhering butyl sill pan with a continuous 3/8\" to 1/2\" rear back-dam so any wind-driven water is safely drained to the exterior."
      },
      {
        number: 2,
        title: "Using Standard High-Expansion Spray Foam in Jamb Gaps",
        costImpact: "$1,200 (Bowed Jambs, Stuck Doors & Cut Foam Rework)",
        description: "Standard high-pressure expanding gap foam generates immense hydraulic curing pressure that pushes the wood side jambs inward, jamming the doors shut.",
        solution: "Strictly use low-pressure, low-expansion closed-cell foam formulated specifically for windows and doors (certified to AAMA 812)."
      },
      {
        number: 3,
        title: "Setting the Unit on an Unlevel Subfloor Threshold",
        costImpact: "$850 (Doors Self-Closing or Swinging Open Uncontrolled)",
        description: "If the subfloor drops by even 1/8\" across a 6-foot run, the hinge pins lean off-plumb, causing the heavy doors to ghost-swing open or drag across carpet.",
        solution: "Plane down subfloor high spots and install tapered composite shims beneath the sill pan so the sill rests on a dead-level plane before setting the frame."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="French Door Workflow"
    reviews={[
      {
        author: "Eric & Michelle K.",
        location: "Charleston, SC",
        projectScope: "72x80 Fiberglass French Door Replacement",
        savingsClaim: "Saved $2,800 vs Window Replacement Company",
        feedback: "Replaced our leaky 1990s sliding glass door. We installed a SureSill PVC pan with dog-ear corners and replaced the hinge screws with 3\" structural screws per David Miller's field note. During a tropical storm with 45 mph winds and torrential rain, our subfloor stayed completely dry.",
        keyTakeaway: "Use composite shims instead of wooden cedar shims—composite shims will not rot or compress under the heavy weight of double doors."
      },
      {
        author: "Brad N.",
        location: "Madison, WI",
        projectScope: "Double Inswing Patio Doors with Low-E Argon",
        savingsClaim: "Zero Drafts in Sub-Zero Winter",
        feedback: "Taking the time to level our subfloor threshold made hanging the double doors straightforward. Margin gaps at the center astragal are a perfect 1/8\" from top to bottom. The low-expansion AAMA foam sealed the perimeter completely without bowing the side jambs.",
        keyTakeaway: "Have a helper hold the outside brickmould firmly against the sheathing while you drive your initial shims and screws from the interior."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Exterior French Door Replacement Hub" initialYesCount={364} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Senior Structural & Geotechnical Engineer"
    codeStandard="ASTM E2112 (Standard Practice for Installation of Exterior Doors) & IRC R609"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Project Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/exterior-door-pan-flashing-sill-seal" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Door Sill Pan Flashing Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Sill pan drainage physics, back-dam heights, flexible butyl folding, and caulk bed strategies.</div>
      </a>
      <a href="/calculators/wall-framing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Wall Framing &amp; Studs Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate king stud, jack stud, and rough opening framing lumber for 5-ft and 6-ft doors.</div>
      </a>
      <a href="/calculators/garage-door-header" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Header Span Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Verify engineered header sizing (doubled 2x10 or LVL) for wide patio door openings.</div>
      </a>
    </div>
  </div>

</Layout>

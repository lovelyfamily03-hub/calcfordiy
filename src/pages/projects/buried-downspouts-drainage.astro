---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Downspout Cleanout Leaf Filters & Transitions",
    description: "Install an inline 4-inch downspout cleanout adapter with removable stainless steel debris screen 2 feet above grade to capture shingle granules and leaves before they enter buried pipes.",
    calculatorName: "French Drain Calculator",
    href: "/calculators/french-drain",
    icon: "🍁"
  },
  {
    stepNumber: 2,
    title: "Trenching 10 to 20 Feet Past Foundation Footings",
    description: "Excavate a 10-inch to 14-inch deep trench routing water safely away from foundation walls to a lower yard swale or property boundary (minimum 10 feet, ideally 20 feet away).",
    calculatorName: "Gravel Base & Trench Calculator",
    href: "/calculators/gravel-driveway",
    icon: "🚜"
  },
  {
    stepNumber: 3,
    title: "4\" Smooth SDR-35 or Schedule 40 PVC Gravity Fall",
    description: "Glue solid smooth-wall rigid PVC pipe (SDR-35 sewer pipe or Schedule 40) maintaining a continuous slope of at least 1/8\" to 1/4\" per foot (1% to 2% grade) toward the daylight exit.",
    calculatorName: "Pipe Slope Calculator",
    href: "/calculators/pipe-slope",
    icon: "📐"
  },
  {
    stepNumber: 4,
    title: "Green Pop-Up Relief Emitter & Rodent Guard",
    description: "Connect an elbow to a spring-loaded green lawn pop-up emitter flush with grass sod, bedded in 1 cu ft of pea gravel for dry-pot drainage and equipped with an internal critter screen.",
    calculatorName: "Drywell Stormwater Calculator",
    href: "/calculators/drywell-stormwater",
    icon: "🟢"
  }
];
---

<Layout
  title="Buried Downspout Drainage Hub — Step-by-Step Underground Workflow | CalcForDIY"
  description="Follow a 4-step underground downspout burial workflow: Cleanout debris filters, smooth SDR-35 PVC pipe trenching, 1/4-inch slope math, and green pop-up emitters."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Buried Downspouts Drainage Hub", "item": "https://calcfordiy.com/projects/buried-downspouts-drainage" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Buried Downspouts Drainage</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>💧 Foundation Protection &amp; Stormwater Conveyance</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Buried Downspout Underground Drainage Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Discharging gutter downspouts directly against your foundation saturates backfill soil, cracks basement walls, and floods basements. This master workflow covers civil drainage standards: smooth-wall SDR-35 PVC pipe vs corrugated pipe failure, cleanout debris filter traps, gravity slope math, and freeze-proof pop-up emitters.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">1 Weekend (4 Downspouts)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$2,400 – $4,200 (80%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">IRC Section R405 &amp; ASTM D3034</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Landscape Drainage Contractor Bid vs. DIY Materials</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (4 Downspout Runs / 120 Total Linear Feet)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Landscape drainage company turn-key quote ($25–$40/linear ft) vs. DIY retail SDR-35 PVC pipe, cleanout boxes, pop-ups &amp; trenching.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Material &amp; Trencher Rental</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$550 – $850</div>
        <div class="text-[11px] text-slate-400 mt-1">120 ft solid SDR-35 pipe, 4 cleanouts, 4 pop-ups, glue &amp; 1-day trencher rental</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Drainage Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$3,000 – $4,800</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 70% • Sod Repair &amp; Machine Overhead 15% • Materials 15%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$2,450 to $3,950</strong> while installing rigid smooth PVC that can be safely snaked or pressure-jetted for 50 years.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Follow the 4 steps to ensure complete stormwater conveyance with zero standing water.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="David Miller, PE"
    role="Structural & Civil Engineering Consultant"
    experience="20+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="Why Cheap Black Corrugated Pipe is a 3-Year Time Bomb"
    note="Big-box home improvement stores sell 100-foot rolls of black corrugated plastic pipe for $80. DIYers love it because it's flexible and easy to throw in a crooked trench. Do not make this mistake! Black corrugated pipe has hundreds of internal accordion ridges. In autumn, roof shingle grit, pine needles, and maple seeds catch on those internal ridges. Within 3 years, the bottom of the pipe fills with a solid black sludge of decomposing mud. Worse yet, corrugated pipe has thin polyethylene walls with almost zero crush resistance. The moment a heavy zero-turn riding lawnmower or delivery truck drives across the lawn, the pipe crushes flat underground! When it clogs, you cannot clear it with a plumbing drain snake—the spinning metal snake head will puncture right through the thin corrugated wall. Always install rigid white or green smooth-wall PVC (SDR-35 or Schedule 40). Smooth PVC has zero ridges for debris to catch on, can withstand 3,000 lbs of wheel load, and can be snaked clean indefinitely."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Buried Downspout Drainage"
    mistakes={[
      {
        number: 1,
        title: "Discharging Downspouts Less than 10 Feet from Foundations",
        costImpact: "$4,500 (Basement Flooding & Sump Pump Overload)",
        description: "Dumping water 4 or 5 feet from the wall allows water to sink through porous foundation backfill soil, recycling right back against your basement walls.",
        solution: "Carry buried downspouts a minimum of 10 to 20 feet away from the foundation to a downward lawn slope or pop-up emitter."
      },
      {
        number: 2,
        title: "Omitting a Pea Gravel Drainage Bed Under Pop-Up Emitters",
        costImpact: "$650 (Winter Freeze Burst at Lawn Emitter)",
        description: "When the pop-up closes, 2 to 3 gallons of water stay trapped in the vertical 90-degree elbow. In winter, this water freezes into a solid plug of ice, blocking the pipe.",
        solution: "Drill a 1/2-inch weep hole in the bottom of the pop-up elbow and bed it in 1 cubic foot of washed pea gravel so trapped water drains into the earth."
      },
      {
        number: 3,
        title: "Trenching Without a Continuous 1/8\" per Foot Slope",
        costImpact: "$1,200 (Low Belly Sags That Collect Sludge)",
        description: "Digging a trench that dips up and down creates underground sags (bellies) where stagnant water pools, breeding mosquitoes and solidifying debris.",
        solution: "Use a line level or torpedo slope level to verify a steady minimum 1/8-inch per foot (1 inch drop per 8 feet of run) fall across the entire pipe trench."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Buried Downspouts Workflow"
    reviews={[
      {
        author: "Phil & Stephanie G.",
        location: "Louisville, KY",
        projectScope: "Four 25-ft Smooth SDR-35 Downspout Runs",
        savingsClaim: "Saved $3,200 vs Drainage Co",
        feedback: "Rented a dedicated Ditch Witch walk-behind trencher from Home Depot for 4 hours. Sliced 4 clean trenches through our lawn in one morning. The inline cleanout boxes near the gutters catch all our oak tree seeds. Our basement has been bone dry through three heavy spring storms.",
        keyTakeaway: "Lay tarps along the trench line to shovel dirt onto; makes backfilling fast and leaves your lawn looking pristine."
      },
      {
        author: "Dominic R.",
        location: "Syracuse, NY",
        projectScope: "Freeze-Proof Pop-Up Discharge Setup",
        savingsClaim: "Zero Winter Ice Plugs",
        feedback: "The weep hole and pea gravel bed under the green pop-up elbow worked perfectly through freezing snowy weather. Water drains out after every storm so the elbow is empty before freezing.",
        keyTakeaway: "Glue all PVC joints with purple primer and PVC cement; push-fit corrugated pipes separate underground over time."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Buried Downspouts Drainage Hub" initialYesCount={368} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="International Residential Code (IRC) Section R405 & ASTM D3034"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/smooth-pvc-vs-corrugated-downspout-pipe" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">PVC vs Corrugated Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Why corrugated black pipe crushes and clogs, Manning's n roughness, and snaking.</div>
      </a>
      <a href="/calculators/pipe-slope" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Pipe Slope Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate 1/8\" and 1/4\" per foot vertical fall drops across any trench run.</div>
      </a>
      <a href="/projects/drywell-stormwater-drainage" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Drywell Drainage Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Connect buried downspouts into subsurface drywells for 100% onsite absorption.</div>
      </a>
    </div>
  </div>

</Layout>

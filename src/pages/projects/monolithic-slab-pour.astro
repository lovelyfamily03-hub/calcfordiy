---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Crushed Stone Sub-Base & Vapor Barrier",
    description: "Calculate tons of compacted #57 crushed aggregate and 10-mil polyethylene vapor barrier to prevent slab moisture transmission.",
    calculatorName: "Paver Base & Gravel Calculator",
    href: "/calculators/paver-base-sand",
    icon: "🪨"
  },
  {
    stepNumber: 2,
    title: "Thickened Perimeter Footing & Trench",
    description: "Determine cubic yards for continuous 12\" wide by 18\" deep perimeter edge turn-downs to support load-bearing structural walls.",
    calculatorName: "Concrete Footing Calculator",
    href: "/calculators/concrete-footing",
    icon: "⛏️"
  },
  {
    stepNumber: 3,
    title: "Deformed Steel Rebar Grid & Chairs",
    description: "Calculate 20-ft sticks of #4 (1/2\") rebar spaced at 18\" on-center with 30-diameter overlap splices and concrete dobies.",
    calculatorName: "Rebar Calculator",
    href: "/calculators/rebar",
    icon: "🔩"
  },
  {
    stepNumber: 4,
    title: "Ready-Mix Concrete Volume & 4000 PSI Mix",
    description: "Calculate total ready-mix transit mixer truck loads (incorporating 10% pump and over-excavation spillage allowance).",
    calculatorName: "Concrete Slab Calculator",
    href: "/calculators/concrete-slab",
    icon: "🏗️"
  }
];
---

<Layout
  title="Monolithic Concrete Slab Hub — Step-by-Step Pouring Workflow | CalcForDIY"
  description="Follow a 4-step monolithic slab-on-grade pouring workflow: Gravel base compaction, perimeter footing trenching, rebar grid, and concrete volume math."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Monolithic Concrete Slab Hub", "item": "https://calcfordiy.com/projects/monolithic-slab-pour" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Pour a Monolithic Concrete Slab with Thickened Edge",
    "description": "A 4-step heavy masonry workflow for calculating crushed stone sub-base, perimeter footing turn-downs, steel rebar reinforcement, and ready-mix volume.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Subgrade Preparation",
        "text": "Calculate 4 inches of compacted #57 crushed rock and vapor retarder sheeting."
      },
      {
        "@type": "HowToStep",
        "name": "Thickened Edge Footing Math",
        "text": "Calculate concrete volume for turn-down perimeter trenches supporting structural walls."
      },
      {
        "@type": "HowToStep",
        "name": "Steel Rebar Grid Layout",
        "text": "Calculate #4 rebar sticks, bar chairs (dobies), and tie wire spools."
      },
      {
        "@type": "HowToStep",
        "name": "Ready-Mix Truck Ordering",
        "text": "Calculate cubic yards of 3500-4000 PSI concrete with 10% ordering margin."
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span>Monolithic Slab Workflow</span>
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-stone-100 border border-stone-300 rounded-full text-stone-800 text-xs font-semibold mb-3">
      <span>🏗️ Structural Concrete Engineering</span>
      <span>•</span>
      <span>4 Integrated Calculators</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Monolithic Concrete Slab-on-Grade Pouring Hub</h1>
    <p class="text-lg text-gray-600 max-w-3xl">
      A monolithic pour casts the slab floor and perimeter foundation footings simultaneously in a single continuous placement. Follow this 4-step workflow to calculate excavation gravel, structural rebar, and ready-mix truck volume.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-400 transition-all">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <span class="w-9 h-9 rounded-full bg-stone-200 text-stone-800 font-bold flex items-center justify-center text-sm shrink-0 mt-0.5">
              {step.stepNumber}
            </span>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-lg">{step.icon}</span>
                <h2 class="text-lg font-bold text-gray-900">{step.title}</h2>
              </div>
              <p class="text-sm text-gray-600 max-w-2xl leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
          <a
            href={step.href}
            class="shrink-0 w-full md:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm rounded-lg transition-colors shadow-2xs"
          >
            <span>{step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      </div>
    ))}
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8 mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Concrete Foundation Rules &amp; ACI Standards</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-700">
      <div>
        <h3 class="font-bold text-gray-900 mb-2">1. 3-Inch Minimum Clear Cover (ACI 318)</h3>
        <p class="leading-relaxed">
          Any steel reinforcement cast against earth must maintain at least 3 inches of concrete cover. Never allow rebar to rest directly on gravel or soil; always suspend the rebar cage on concrete dobies or plastic rebar chairs.
        </p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-2">2. Contraction Control Joint Spacing</h3>
        <p class="leading-relaxed">
          To prevent random shrinkage cracking, saw-cut or tool control joints at intervals no greater than 24 to 30 times the slab thickness in inches (e.g. a 4-inch slab requires control joints every 8 to 10 feet in both directions).
        </p>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-8">
    <h3 class="text-base font-bold text-gray-900 mb-4">Related Building Workflows &amp; Guides</h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a href="/projects/detached-garage-framing" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-blue-600 mb-1">FRAMING WORKFLOW</div>
        <div class="font-bold text-gray-900 text-sm">Detached Garage Framing Hub</div>
        <p class="text-xs text-gray-500 mt-1">Framing walls and headers over a concrete slab.</p>
      </a>
      <a href="/calculators/rebar" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-blue-600 mb-1">INTERACTIVE TOOL</div>
        <div class="font-bold text-gray-900 text-sm">Rebar Grid Calculator</div>
        <p class="text-xs text-gray-500 mt-1">Calculate rebar weight, stick counts, and lap splices.</p>
      </a>
      <a href="/guides/how-many-bags-of-concrete-for-sonotube" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-emerald-600 mb-1">TRADE GUIDE</div>
        <div class="font-bold text-gray-900 text-sm">Concrete Volume &amp; Bag Math</div>
        <p class="text-xs text-gray-500 mt-1">Converting cubic yards to 60 lb and 80 lb bags.</p>
      </a>
    </div>
  </div>

</Layout>

---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Backsplash Square Footage & Electrical Cutouts",
    description: "Measure countertop-to-upper-cabinet height (standard 18\"), wall length, and subtract range hoods and GFCI outlet boxes.",
    calculatorName: "Wall Tile Calculator",
    href: "/calculators/bathroom-wall-tile",
    icon: "🧱"
  },
  {
    stepNumber: 2,
    title: "Thinset Mortar or Mastic Adhesive",
    description: "Calculate gallons of Type 1 organic mastic adhesive or polymer-modified thinset mortar with 3/16\" V-notch trowels.",
    calculatorName: "Thinset Mortar Calculator",
    href: "/calculators/thinset",
    icon: "🥣"
  },
  {
    stepNumber: 3,
    title: "Unsanded or Fine Polymer Grout",
    description: "Determine exact grout dry powder bags for tight 1/16\" to 1/8\" subway or herringbone decorative tile joints.",
    calculatorName: "Grout Calculator",
    href: "/calculators/grout",
    icon: "🧹"
  },
  {
    stepNumber: 4,
    title: "Under-Cabinet & Countertop Task Lighting",
    description: "Size LED strip light wattage and overhead recessed can spacing for shadow-free 50-footcandle kitchen countertop prep work.",
    calculatorName: "Kitchen Lighting Calculator",
    href: "/calculators/recessed-lights-kitchen",
    icon: "💡"
  }
];
---

<Layout
  title="Kitchen Tile Backsplash Hub — Step-by-Step DIY Renovation Workflow | CalcForDIY"
  description="Follow a 4-step kitchen backsplash workflow: Wall tile takeoffs, mastic adhesive, unsanded grout bags, and under-cabinet LED task lighting."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Kitchen Tile Backsplash Hub", "item": "https://calcfordiy.com/projects/kitchen-tile-backsplash" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Plan and Install a Kitchen Tile Backsplash",
    "description": "A 4-step DIY workflow for calculating backsplash wall tile, adhesive mastic, grout joints, and under-cabinet LED lighting.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Tile Area & Waste Calculation",
        "text": "Measure wall run lengths and subtract outlet cutouts, adding 10% waste for straight subway or 15% for herringbone."
      },
      {
        "@type": "HowToStep",
        "name": "Adhesive Selection",
        "text": "Calculate pre-mixed mastic adhesive or modified thinset mortar yield per square foot."
      },
      {
        "@type": "HowToStep",
        "name": "Grout Joint Sizing",
        "text": "Determine unsanded grout bag requirements for delicate glass or glazed ceramic tiles."
      },
      {
        "@type": "HowToStep",
        "name": "Under-Cabinet Task Lighting",
        "text": "Size continuous LED strip lighting and driver wattage for shadow-free food preparation."
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span>Kitchen Backsplash Workflow</span>
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-50 border border-emerald-200 rounded-full text-emerald-800 text-xs font-semibold mb-3">
      <span>🍳 Kitchen Upgrade Workflow</span>
      <span>•</span>
      <span>4 Integrated Calculators</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Kitchen Tile Backsplash &amp; Task Lighting Hub</h1>
    <p class="text-lg text-gray-600 max-w-3xl">
      Upgrading your kitchen backsplash is one of the highest-ROI weekend DIY projects. Follow this 4-step workflow to calculate tile square footage, mastic adhesive, unsanded grout, and under-cabinet lighting.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-400 transition-all">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <span class="w-9 h-9 rounded-full bg-emerald-100 text-emerald-800 font-bold flex items-center justify-center text-sm shrink-0 mt-0.5">
              {step.stepNumber}
            </span>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-lg">{step.icon}</span>
                <h2 class="text-lg font-bold text-gray-900">{step.title}</h2>
              </div>
              <p class="text-sm text-gray-600 max-w-2xl leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
          <a
            href={step.href}
            class="shrink-0 w-full md:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm rounded-lg transition-colors shadow-2xs"
          >
            <span>{step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      </div>
    ))}
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8 mb-8">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Backsplash Installation Trade Tips</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-700">
      <div>
        <h3 class="font-bold text-gray-900 mb-2">1. Unsanded vs Sanded Grout for Wall Tile</h3>
        <p class="leading-relaxed">
          For joint widths of 1/8 inch or less (standard for subway tile and handmade ceramics), always use unsanded grout. Sanded grout particles will permanently scratch glossy glazed ceramic and glass tile finishes during cleanup.
        </p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-2">2. Silicone Caulk at the Countertop Joint</h3>
        <p class="leading-relaxed">
          Never use cementitious grout where the bottom tile row meets the granite or quartz countertop. That 90-degree plane change experiences seasonal movement; grout will crack within months. Always fill that joint with color-matched 100% silicone sealant.
        </p>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-8">
    <h3 class="text-base font-bold text-gray-900 mb-4">Related Building Workflows &amp; Guides</h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a href="/projects/bathroom-remodel" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-blue-600 mb-1">TILE WORKFLOW</div>
        <div class="font-bold text-gray-900 text-sm">Bathroom Remodel Hub</div>
        <p class="text-xs text-gray-500 mt-1">Shower waterproofing and wall tile installation steps.</p>
      </a>
      <a href="/guides/how-many-bags-of-grout-for-tile-shower" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-emerald-600 mb-1">TRADE GUIDE</div>
        <div class="font-bold text-gray-900 text-sm">Grout Bag Sizing Guide</div>
        <p class="text-xs text-gray-500 mt-1">Grout yield formulas for 1/16" and 1/8" joints.</p>
      </a>
      <a href="/guides/how-many-recessed-lights-for-a-2-car-garage" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-400 bg-white hover:shadow-xs transition-all">
        <div class="text-xs font-semibold text-emerald-600 mb-1">LIGHTING GUIDE</div>
        <div class="font-bold text-gray-900 text-sm">Lumen &amp; Lighting Layout Guide</div>
        <p class="text-xs text-gray-500 mt-1">Target lumens and grid layout calculations.</p>
      </a>
    </div>
  </div>

</Layout>

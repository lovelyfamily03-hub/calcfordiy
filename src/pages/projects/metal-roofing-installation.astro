---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Synthetic Underlayment & Extended Drip Edge",
    description: "Install high-temperature synthetic roof underlayment with 4-inch side laps, self-adhered ice & water shield at eaves and valleys, and pre-formed metal drip edge.",
    calculatorName: "Asphalt Shingles & Underlayment Calculator",
    href: "/calculators/asphalt-shingles",
    icon: "🛡️"
  },
  {
    stepNumber: 2,
    title: "W-Style Valley Flashing & Eave Starter Cleats",
    description: "Lay 20-inch wide open W-valley metal flashings with 1-inch center splash ribs, and fasten continuous eave starter cleats to lock standing seam panel hemmed bottoms.",
    calculatorName: "Roof Pitch & Rafter Calculator",
    href: "/calculators/roof-pitch-rafter",
    icon: "📐"
  },
  {
    stepNumber: 3,
    title: "Panel Layout & Hidden Clip / Gasket Screw Fastening",
    description: "Square panel layout against gable ends, fasten standing seam panels using concealed stainless sliding clips or corrugated 29-gauge panels with neoprene washer screws on flats.",
    calculatorName: "Roof Sheathing & Plywood Calculator",
    href: "/calculators/roof-sheathing",
    icon: "🔨"
  },
  {
    stepNumber: 4,
    title: "Ridge Cap, Vented Foam Closures & Transition Trim",
    description: "Install die-cut expandable foam closure strips to block blowing snow and insects, followed by high-profile vented ridge cap flashings and gable rake trims.",
    calculatorName: "Soffit & Fascia Calculator",
    href: "/calculators/soffit-fascia",
    icon: "🏔️"
  }
];
---

<Layout
  title="Metal Roofing Installation Hub — Step-by-Step Exterior Workflow | CalcForDIY"
  description="Follow a 4-step standing seam and corrugated metal roofing workflow: High-temp underlayment, W-valley flashing, concealed clip fastening, and vented ridge caps."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Metal Roofing Installation Hub", "item": "https://calcfordiy.com/projects/metal-roofing-installation" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Metal Roofing Installation</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>🏠 Exterior Cladding &amp; Lifetime Roofing</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Metal Roofing Installation Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      A 26-gauge standing seam or 29-gauge ribbed metal roof offers a 50-year lifespan, Class 4 hail resistance, and Class A fire protection. This master workflow covers IRC Section R905.10 standards: high-temperature ice barriers, open W-profile valley flashings, thermal expansion clip sliding, and die-cut foam closure seals.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">3 to 4 Days (2,200 Sq Ft)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$9,500 – $15,800 (65%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">IRC Section R905.10 &amp; UL 580</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Metal Roofing Contractor Bid vs. DIY Material Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (2,000 Sq Ft Roof Area)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Standing seam installer turn-key quote ($9.50–$16.00/sq ft) vs. DIY retail metal coils/panels, high-temp underlayment, flashings &amp; brake.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Materials &amp; Tool Rental Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$4,800 – $6,500</div>
        <div class="text-[11px] text-slate-400 mt-1">26-gauge panels, clips, flashings, synthetic felt &amp; metal sheet brake rental</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Professional Metal Roofing Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$19,000 – $32,000</div>
        <div class="text-[11px] text-slate-400 mt-1">Labor 65% • Equipment &amp; Scaffolding 15% • Materials 20%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You save roughly <strong>$14,200 to $25,500</strong> while ensuring no abrasive grinders ruin your steel zinc coating.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute the 4 exterior roofing phases to build a 130 MPH wind-rated, leak-free metal roof.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="David Miller, PE"
    role="Structural & Civil Engineering Consultant"
    experience="20+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="Why Cutting Panels with an Abrasive Angle Grinder Destroys Your Roof"
    note="The single most destructive shortcut in metal roofing is using a 4-1/2 inch abrasive cutoff wheel on an angle grinder to cut roof panels to length. The friction of the abrasive disc generates temperatures over 1,500°F, burning off the protective Galvalume zinc-aluminum coating along the raw edge. Worse yet, the grinder shoots thousands of red-hot microscopic steel sparks across the painted roof panels. Those metal particles embed themselves in the hot paint. Three months later after the first autumn rains, the entire roof turns speckled with hundreds of tiny orange rust spots! Always cut metal panels with cold-cutting mechanical tools: electric double-cut power shears, nibblers, or heavy-duty manual aviation snips (Malco or Wiss)."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Metal Roofing Installation"
    mistakes={[
      {
        number: 1,
        title: "Using Standard Asphalt Shingle Felt Under Metal",
        costImpact: "$3,600 (Degraded Underlayment & Sticky Mess)",
        description: "Dark metal roofing reaches temperatures of 165°F to 180°F in direct summer sun. Standard organic #15 or #30 asphalt felt dries out, curls, and melts directly to the back of the steel.",
        solution: "Install high-temperature synthetic underlayment rated to at least 240°F (such as Titanium PSU30 or Grace Ultra)."
      },
      {
        number: 2,
        title: "Over-Torquing Screws on Exposed Fastener Roofs",
        costImpact: "$2,200 (Crushed Neoprene Gaskets & Roof Leaks)",
        description: "Crushing the EPDM rubber washer until it splits concave funnels rainwater straight into the screw hole, rotting roof deck plywood.",
        solution: "Use a dedicated screw gun with a torque-limiting clutch set to compress the rubber washer until it sits exactly flush with the metal cap."
      },
      {
        number: 3,
        title: "Omitting Die-Cut Foam Closures at the Ridge Cap",
        costImpact: "$1,500 (Wind-Driven Snow Drift Inside Attic)",
        description: "Ribbed metal roofing creates 3/4-inch high open gaps under ridge cap flashings. In winter, blowing blizzard winds force powdery snow through these openings into the attic insulation.",
        solution: "Install pre-formed solid or breathable open-cell vented foam closure strips glued beneath both sides of the ridge cap before screwing."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Metal Roofing Workflow"
    reviews={[
      {
        author: "Keith & Danielle H.",
        location: "Asheville, NC",
        projectScope: "2,400 sq ft Standing Seam Roof Replacement",
        savingsClaim: "Saved $16,500 vs Roofing Company",
        feedback: "Ordered factory custom-length 26-gauge standing seam panels pre-cut to the inch from a regional metal rollformer. Electric double-cut shears made trimming eave hems fast and clean with zero rust burrs.",
        keyTakeaway: "Use a metal bending brake to hem bottom panel edges around the continuous eave starter cleat; creates a storm-proof 140 MPH wind lock."
      },
      {
        author: "Trevor P.",
        location: "Bend, OR",
        projectScope: "29-Gauge Ribbed Roof on Detached Shop",
        savingsClaim: "Zero Winter Attic Leaks",
        feedback: "Followed the W-valley flashing and high-temp underlayment recommendations. Our 4/12 pitch roof shed 3 feet of snow effortlessly this winter. The foam closure strips kept wasps out all summer.",
        keyTakeaway: "Always sweep the roof with a soft broom and leaf blower at the end of every day to remove loose metal filings before they rust."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Metal Roofing Installation Workflow Hub" initialYesCount={358} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="IRC Section R905.10 & UL 580 Class 90 Wind Uplift"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/metal-roof-valley-flashing-details" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Valley Flashing Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Open W-valley details, water diversion ribs, and avoiding face screws in the pan.</div>
      </a>
      <a href="/calculators/roof-pitch-rafter" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Roof Pitch Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate rise, run, rafter lengths, and roof slope multipliers for sheet lengths.</div>
      </a>
      <a href="/projects/pole-barn-post-frame" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Pole Barn Post-Frame Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Complete post-frame workflow: 6x6 columns, engineered trusses, and roof purlins.</div>
      </a>
    </div>
  </div>

</Layout>

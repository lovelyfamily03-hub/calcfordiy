---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Pressure Washing, Mildew Bleach Wash & Wood Dry-Out",
    description: "Wash siding with a 2,500 PSI pressure washer using a 40-degree white fan tip held 12 inches away. Apply a 3:1 water-to-bleach solution with Jomax to eradicate mildew spores. Allow 72 hours of full sun until a pin moisture meter reads below 12% moisture content.",
    calculatorName: "Exterior House Paint Calculator",
    href: "/calculators/paint-exterior",
    icon: "🧼"
  },
  {
    stepNumber: 2,
    title: "Carbide Scraping, Feather Sanding & Peel-Bond Priming",
    description: "Scrape all failing, alligatored, and peeling paint down to sound wood using heavy-duty carbide pull scrapers. Feather the edges with 80-grit random orbital sandpaper. Spot-prime bare wood and chalking substrates with a high-build elastomeric bonding primer (XIM Peel Bond or Mad Dog).",
    calculatorName: "Drywall Primer & Sealer Calculator",
    href: "/calculators/drywall-primer-sealer",
    icon: "🪓"
  },
  {
    stepNumber: 3,
    title: "Urethane Acrylic Caulk Sealing & Architectural Masking",
    description: "Seal all window perimeters, corner boards, and horizontal trim butt joints with high-performance elastomeric caulk (Sashco Big Stretch). Mask windows, soffit vents, and foundations with 1.5-mil poly sheeting and Scotch exterior painter's tape.",
    calculatorName: "Board and Batten Siding Calculator",
    href: "/calculators/board-and-batten-siding",
    icon: "🛡️"
  },
  {
    stepNumber: 4,
    title: "Airless Spray Application with Immediate Back-Rolling",
    description: "Spray 100% acrylic exterior latex (Sherwin-Williams Duration or Benjamin Moore Aura) using a 515 or 517 reversible tip at 2,200 PSI. Maintain a 12-inch standoff with 50% fan overlap. Have a partner immediately back-roll with a 1/2-inch microfiber roller to push paint into porous grain.",
    calculatorName: "Exterior Paint Gallons & Coverage Estimator",
    href: "/calculators/paint-exterior",
    icon: "🎨"
  }
];
---

<Layout
  title="Exterior House Painting & Spraying Hub | CalcForDIY"
  description="Master step-by-step workflow for exterior house painting: 2,500 PSI wash, carbide scraping, elastomeric primer, 515 airless spray tips, and back-rolling."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Exterior Painting Hub", "item": "https://calcfordiy.com/projects/exterior-house-painting-spray" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Paint Exterior Siding with an Airless Sprayer",
    "description": "Professional painting contractor workflow: pressure cleaning, carbide scraping, elastomeric priming, 515 tip spraying, and wet back-rolling.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Pressure Wash & Spore Treatment",
        "text": "Wash siding with 2,500 PSI washer and mildewcide; allow moisture content to drop under 12%."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Carbide Scraping & Feather Sanding",
        "text": "Scrape all flaking paint, sand transitions smooth, and seal with high-build bonding primer."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Elastomeric Caulking & Window Masking",
        "text": "Fill siding seams with flexible urethane caulk and wrap glass with static poly film."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Airless Spraying & Wet Back-Rolling",
        "text": "Apply 100% acrylic topcoat with a 515 tip at 2,200 PSI and immediately back-roll into pores."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Exterior Painting Hub</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-gradient-to-br from-slate-900 via-sky-950 to-slate-900 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xl not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/20 text-sky-300 text-xs font-semibold mb-4 border border-sky-400/30">
      <span>🎨 Architectural Coatings &amp; Building Envelopes</span>
      <span>•</span>
      <span>MPI System EXT 6.2 &amp; PDCA P1-04 Standards</span>
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4 text-white">
      Exterior House Painting &amp; Airless Spraying Hub
    </h1>

    <p class="text-slate-300 text-base sm:text-lg max-w-3xl leading-relaxed mb-6">
      Exterior paint failure is almost never caused by the paint—it is caused by <strong>trapped wood moisture above 15%</strong> and unfeathered peeling edges. Here is the master trade system: carbide scraping, high-build bonding primers, calibrated <strong>515 airless spray tips</strong>, and <strong>wet back-rolling</strong> to achieve 15-year weather-resistant coatings.
    </p>

    <!-- Technical Infographic Hero Diagram -->
    <div class="bg-sky-950/60 rounded-xl p-4 sm:p-6 border border-sky-500/30 backdrop-blur-sm max-w-4xl">
      <h3 class="text-xs uppercase tracking-wider text-sky-300 font-bold mb-3">Airless Atomization &amp; Film Thickness Mechanics</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-sky-100">
        <div class="bg-slate-950/70 p-3 rounded-lg border border-sky-500/20">
          <div class="font-bold text-white text-sm mb-1 flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-sky-400 inline-block"></span>
            1. Spray Tip Geometry
          </div>
          <p class="leading-relaxed">A 515 tip produces a 10-inch fan at 12 inches distance with a 0.015-inch orifice, atomizing heavy acrylics at 2,000–2,400 PSI without thinning.</p>
        </div>
        <div class="bg-slate-950/70 p-3 rounded-lg border border-sky-500/20">
          <div class="font-bold text-white text-sm mb-1 flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400 inline-block"></span>
            2. The Back-Roll Rule
          </div>
          <p class="leading-relaxed">Spray atomization bridges microscopic wood pores. Back-rolling with a 1/2-inch nap pushes resin deep into grain checks and creates a uniform 4.0-mil WFT.</p>
        </div>
        <div class="bg-slate-950/70 p-3 rounded-lg border border-sky-500/20">
          <div class="font-bold text-white text-sm mb-1 flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block"></span>
            3. 12% Moisture Threshold
          </div>
          <p class="leading-relaxed">Painting wood above 15% moisture traps vapor. Solar heat turns water into steam, causing catastrophic blistering and peeling within 12 months.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Editorial Guide Feature Callout -->
  <div class="bg-gradient-to-r from-sky-50 to-indigo-50 border-l-4 border-sky-600 p-5 rounded-r-xl mb-10 shadow-sm not-prose">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-sky-800 bg-sky-200/60 px-2 py-0.5 rounded">Companion Trade Guide</span>
        <h3 class="text-lg font-bold text-gray-900 mt-1">Airless Spray Tip Sizing: 515 vs 517 vs 413 for Exterior Acrylic</h3>
        <p class="text-sm text-gray-600 mt-0.5">Learn how to calculate fan width, prevent tailing, control overspray, and match tip orifices to pump GPM ratings.</p>
      </div>
      <a
        href="/guides/airless-sprayer-tip-size-exterior-paint"
        class="inline-flex items-center gap-2 bg-sky-700 hover:bg-sky-800 text-white font-semibold text-sm px-4 py-2.5 rounded-lg shadow-sm transition whitespace-nowrap"
      >
        <span>Read Technical Guide</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>
  </div>

  <!-- Sequential 4-Phase Workflow Grid -->
  <h2 class="text-2xl font-black text-gray-900 mb-6 tracking-tight not-prose">
    Sequential 4-Phase Exterior Painting Protocol
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12 not-prose">
    {workflowSteps.map(step => (
      <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="flex items-center justify-center w-8 h-8 rounded-full bg-sky-100 text-sky-800 font-bold text-sm">
              {step.stepNumber}
            </span>
            <span class="text-2xl">{step.icon}</span>
            <h3 class="font-bold text-gray-900 text-base sm:text-lg flex-1 leading-snug">
              {step.title}
            </h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed mb-4">
            {step.description}
          </p>
        </div>
        <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
          <span class="text-xs font-medium text-sky-700">Recommended Tool</span>
          <a
            href={step.href}
            class="text-xs font-bold text-sky-600 hover:text-sky-800 flex items-center gap-1 hover:underline"
          >
            <span>{step.calculatorName}</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Material Takeoff Table -->
  <div class="bg-white rounded-xl border border-gray-200 p-6 mb-12 shadow-sm not-prose">
    <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
      <span>📋</span> Exterior Paint Material Takeoff (Typical 2,200 sq ft Home)
    </h3>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-gray-700">
        <thead class="bg-sky-50 text-sky-900 uppercase font-semibold text-xs border-b border-sky-200">
          <tr>
            <th class="py-3 px-4">Component</th>
            <th class="py-3 px-4">Material Specification</th>
            <th class="py-3 px-4">Estimated Quantity</th>
            <th class="py-3 px-4">Trade Function</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">100% Acrylic Exterior Latex</td>
            <td class="py-3 px-4">Satin/Low-Lustre (350 sq ft/gal)</td>
            <td class="py-3 px-4 font-mono text-sky-700">14–16 Gallons</td>
            <td class="py-3 px-4">Two full coats providing 3.5 mil Dry Film Thickness (DFT).</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Bonding Primer</td>
            <td class="py-3 px-4">High-Build Elastomeric (XIM Peel Bond)</td>
            <td class="py-3 px-4 font-mono text-sky-700">4 Gallons</td>
            <td class="py-3 px-4">Glues down hairline edges and seals weathered bare cedar.</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Elastomeric Siding Caulk</td>
            <td class="py-3 px-4">Sashco Big Stretch or Quad Max</td>
            <td class="py-3 px-4 font-mono text-sky-700">12 Tubes</td>
            <td class="py-3 px-4">Allows 50% joint movement through winter freeze-thaw cycles.</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-semibold text-gray-900">Window Masking Poly</td>
            <td class="py-3 px-4">1.5-mil Cling Film with Tape Edge</td>
            <td class="py-3 px-4 font-mono text-sky-700">3 Rolls (72-in x 90-ft)</td>
            <td class="py-3 px-4">Complete overspray shielding for windows, doors, and AC units.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Trade Pro Field Note -->
  <div class="mb-10">
    <FieldNote
      title="The 50°F and Falling Rule for Exterior Latex Curing"
      trade="Architectural Coatings"
      content="Modern exterior acrylic paints advertise application down to 35°F, but that only applies if the temperature remains above 35°F for a full 24 hours after application. If you finish spraying at 4:00 PM at 48°F, and the overnight low dips to 28°F, the water in the wet film freezes before the latex resin coalescence process completes. This ruins the binder matrix, resulting in chalky, non-adhering paint that peels off in sheets by spring. Never spray after 2:00 PM in late autumn."
    />
  </div>

  <!-- Critical Costly Mistakes Box -->
  <div class="mb-12">
    <CostlyMistakes
      projectType="Exterior House Painting"
      mistakes={[
        {
          mistake: "Spraying in Direct Sunlight on 85°F+ Days",
          impact: "Hot wood siding flashes the solvent water immediately, skinning over the top while wet underneath and causing severe pinhole solvent popping and blistering.",
          prevention: "Follow the sun around the house. Spray west walls in the morning and east walls in the afternoon, keeping surfaces under 90°F."
        },
        {
          mistake: "Caulking the Bottom Lip of Lap Siding",
          impact: "Sealing horizontal siding overlaps traps condensation behind the boards with nowhere to weep, rotting wall sheathing and studs from the inside out.",
          prevention: "Never caulk the horizontal bottom lap of siding. Only caulk vertical butt joints and window/corner transitions."
        },
        {
          mistake: "Skipping the Back-Roll Step When Spraying Rough Wood",
          impact: "Airless spray pressure bridges over porous grain fissures without penetrating, leaving microscopic pinholes that allow driving rain behind the paint.",
          prevention: "Always have a helper back-roll wet paint immediately within 60 seconds of spraying."
        }
      ]}
    />
  </div>

  <!-- Verified User Reviews -->
  <div class="mb-12">
    <CommunityReviews
      tradeTitle="Exterior Painting Calculator"
      reviews={[
        {
          author: "Marcus T.",
          location: "Spokane, WA",
          projectScope: "2,400 sq ft Cedar Lap Siding",
          savingsClaim: "Saved $6,200 DIY",
          feedback: "Rented a Graco Ultra Max II and used a 515 tip per this hub. Having my son back-roll right behind me was the secret—coverage is 100% solid and looks like a brand-new home.",
          keyTakeaway: "Carbide pull scrapers removed 10x more dead paint than wire brushes."
        },
        {
          author: "Eileen H.",
          location: "Portland, ME",
          projectScope: "Coastal Saltbox Shake Siding",
          savingsClaim: "Saved $4,800 vs Painting Contractor",
          feedback: "The moisture meter tip saved my siding. After pressure washing, the shaded north wall took 5 full sunny days to drop to 11%. Paint bonded like iron.",
          keyTakeaway: "Never paint wood above 15% moisture content."
        }
      ]}
    />
  </div>

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Architectural Finishes Specialist"
    codeStandard="MPI System EXT 6.2 & PDCA Standard P1-04"
    lastUpdated="September 2026"
  />

  <!-- Helpful Feedback Box -->
  <HelpfulFeedback />

</Layout>

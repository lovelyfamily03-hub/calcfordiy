---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Deep Yard Excavation & Wet Diamond Saw Cutting",
    description: "Dig a 5-ft wide by 4-ft projection pit down to footing depth, and cut the 8\" thick poured concrete or CMU foundation wall using a hydraulic wet diamond concrete saw.",
    calculatorName: "Concrete Slab & Demolition Calculator",
    href: "/calculators/concrete-slab",
    icon: "🚜"
  },
  {
    stepNumber: 2,
    title: "Structural Lintel, Pressure-Treated Buck & Casement Window",
    description: "Anchor a 3x3 steel angle iron lintel header across the top opening, fasten a treated 2x8 wood buck with Tapcon anchors, and install a code-compliant in-swinging or out-swinging casement window.",
    calculatorName: "Wall Framing & Stud Calculator",
    href: "/calculators/wall-framing",
    icon: "🪟"
  },
  {
    stepNumber: 3,
    title: "Corrugated Steel Window Well & Masonry Anchors",
    description: "Bolt heavy-gauge galvanized steel or composite window well flanges directly to foundation walls using 3/8\" sleeve anchors spaced every 12 inches, sealed with butyl caulk.",
    calculatorName: "Concrete Footing & Pier Calculator",
    href: "/calculators/concrete-footing",
    icon: "🛡️"
  },
  {
    stepNumber: 4,
    title: "Gravel Core to Footing Weep Tile & Escape Ladder",
    description: "Trench a 4-inch vertical standpipe down to the basement perimeter weeping tile, backfill the bottom 12 inches with washed #57 stone, and mount a fixed steel escape ladder for wells over 44\" deep.",
    calculatorName: "French Drain Calculator",
    href: "/calculators/french-drain",
    icon: "🪜"
  }
];
---

<Layout
  title="Basement Egress Window Well Hub — Step-by-Step DIY Workflow | CalcForDIY"
  description="Follow a 4-step basement egress window installation workflow: Foundation concrete cutting, steel lintels, corrugated wells, and footing drainage ties."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Basement Egress Window Well Hub", "item": "https://calcfordiy.com/projects/basement-egress-window-well" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Basement Egress Window</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>🏠 Life Safety &amp; Legal Bedroom Conversion</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Basement Egress Window &amp; Well Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Adding a legal egress window turns a dark, unfinished basement into a code-compliant living bedroom suite, instantly increasing home appraisal value by $30,000 to $50,000. This master workflow covers IRC Section R310 standards: structural concrete foundation cutting, steel angle lintel load transfer, gravel core drainage, and emergency escape dimensions.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">2 to 3 Days (Complete Install)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$3,800 – $6,500 (65%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">IRC Section R310 (Emergency Escape)</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Egress Window Contractor Bid vs. DIY Material Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (Poured Concrete 8" Wall + 48"x48" Casement + Steel Well)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Basement egress contractor turnkey installation ($6,500–$10,500) vs. DIY retail concrete saw rental, window, well, gravel &amp; buck.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Materials &amp; Saw Rental Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$1,850 – $2,650</div>
        <div class="text-[11px] text-slate-400 mt-1">Vinyl casement window, galvanized well, saw rental, diamond blade &amp; gravel</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Licensed Egress Specialist Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$6,800 – $10,500</div>
        <div class="text-[11px] text-slate-400 mt-1">Specialized Concrete Cutting 45% • Excavation &amp; Drainage 25% • Materials 30%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You keep roughly <strong>$4,950 to $7,850</strong> while adding a legal bedroom that boosts your home appraisal square footage immediately.</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute the 4 phases in order to maintain structural foundation integrity and prevent basement flooding.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="David Miller, PE"
    role="Structural & Civil Engineering Consultant"
    experience="20+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="Why Cutting an 8-Foot Foundation Requires a Steel Lintel"
    note="Cutting a 48-inch wide hole through an 8-inch thick poured concrete foundation removes critical bearing strength directly underneath the main floor joists and load-bearing exterior walls above. If floor joists run perpendicular and land on the wall directly over your cut opening, the concrete rim beam can sag or crack! The structural engineering rule: If your rough window opening is wider than 36 inches, or if you cut within 12 inches of the top plate, you MUST install an engineered structural steel angle lintel (minimum 3x3x1/4-inch structural steel angle) or an engineered double 2x10 wood header inside the rim joist cavity. The steel angle must bear at least 6 inches onto solid concrete on both sides of the cut opening. Install the lintel into a horizontal relief kerf cut BEFORE knocking out the main wall knockout slug."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Basement Egress Windows"
    mistakes={[
      {
        number: 1,
        title: "Failing to Tie the Window Well Drain to the Footing Weep Tile",
        costImpact: "$5,500 (Basement Bedroom Flooded by 3 Feet of Rainwater)",
        description: "Backfilling the window well with dirt or sitting the gravel on dense clay creates a sealed tank outside the window. During heavy storms, water fills the well and bursts through the window glass into the bedroom.",
        solution: "Auger a 4-inch vertical hole through the bottom of the window well directly down to the foundation footing's exterior French drain tile, backfilled with clean washed stone."
      },
      {
        number: 2,
        title: "Installing a Double-Hung Window that Fails the 5.7 Sq Ft Rule",
        costImpact: "$1,800 (Failing City Inspection & Replacing Window)",
        description: "A 36x48 double-hung window has an outer frame of 12 sq ft, but only half opens at a time (less than 4.5 sq ft clear opening), failing IRC life safety codes.",
        solution: "Use an in-swing or out-swing casement window with an egress hinge; a 30x48 casement swings wide open to provide over 6.0 sq ft of unobstructed escape area."
      },
      {
        number: 3,
        title: "Cutting Concrete Dry with a Gas Saw (Deadly Silica Dust Hazard)",
        costImpact: "$850 (OSHA Violation & Severe Pulmonary Hazard)",
        description: "Cutting concrete dry releases dense clouds of respirable crystalline silica dust that penetrates deep into lungs and damages furnace blower motors.",
        solution: "Always use a wet-cutting diamond circular saw connected to a continuous pressurized garden hose water feed, and wear an N95 or P100 respirator."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Basement Egress Workflow"
    reviews={[
      {
        author: "Brent & Lindsay K.",
        location: "Minneapolis, MN",
        projectScope: "Poured Foundation Basement Bedroom Conversion",
        savingsClaim: "Saved $6,200 vs Basement Co",
        feedback: "Rented a 14-inch electric wet concrete saw and made horizontal and vertical relief cuts. Sliced the concrete slug into 4 manageable 100-lb blocks and tipped them outward into the pit. Installed a Rockwell casement egress window. City inspector approved our new basement bedroom on first visit.",
        keyTakeaway: "Dig your outside pit 12 inches deeper than the bottom of the window so your 12-inch gravel drainage bed sits well below the window sill."
      },
      {
        author: "Marcus T.",
        location: "Denver, CO",
        projectScope: "CMU Block Egress with Galvanized Well",
        savingsClaim: "Zero Water Intrusion During Spring Thaw",
        feedback: "Tied the 4-inch drain pipe straight down into our perimeter footing drain. Heavy Colorado snow melts right into the gravel bed with zero standing water. The steel ladder gives my teenage son a safe emergency exit.",
        keyTakeaway: "Use butyl rubber tape between the window well flange and the concrete wall before driving sleeve anchors to stop dirt wash."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Basement Egress Window Well Hub" initialYesCount={371} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="IRC Section R310 (Emergency Escape and Rescue Openings) & ACI 318"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/egress-window-code-requirements-irc" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">IRC Egress Code Guide →</div>
        <div class="text-xs text-gray-500 mt-1">5.7 sq ft net opening, 24\" min height, 20\" min width, and 44\" max sill rules.</div>
      </a>
      <a href="/calculators/french-drain" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">French Drain Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate drain pipe lengths, washed stone backfill, and geotextile wraps.</div>
      </a>
      <a href="/projects/basement-finishing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Basement Finishing Hub →</div>
        <div class="text-xs text-gray-500 mt-1">Complete basement workflow: perimeter insulation, subflooring, and framing.</div>
      </a>
    </div>
  </div>

</Layout>

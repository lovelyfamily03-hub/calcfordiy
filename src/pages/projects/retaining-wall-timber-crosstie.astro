---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Trench Excavation, 6\" Compacted Gravel & Buried Base Timber",
    description: "Excavate a trench 18\" wide and 12\" deep. Place 6 inches of crushed #57 stone, compact thoroughly, and bury the first course of 6x6 pressure-treated (UC4B Ground Contact) or oak crossties at least 6 inches below finished grade to prevent sliding shear failure.",
    calculatorName: "Retaining Wall Block & Material Calculator",
    href: "/calculators/retaining-wall",
    icon: "🚜"
  },
  {
    stepNumber: 2,
    title: "Course Stacking, 1/2\" Batter Inward Lean & 12\" Rebar Spiking",
    description: "Stack consecutive timber courses in a running bond, stepping each course back 1/2\" to 3/4\" per vertical foot toward the retained slope (batter). Drill 1/2\" pilot holes through timbers and drive 1/2\" x 12\" steel rebar spikes or 10\" structural timber screws every 4 feet.",
    calculatorName: "Rebar Spacing & Footing Calculator",
    href: "/calculators/rebar",
    icon: "🔨"
  },
  {
    stepNumber: 3,
    title: "Perpendicular 'Deadman' Timber Tiebacks & Soil Anchor T-Bars",
    description: "On walls over 3 feet high, install T-shaped 'Deadman' tieback timbers perpendicular into the hillside every 6 to 8 feet horizontally. Anchor each deadman with a 3-foot crossbar buried deep in undisturbed soil and pinned with two 36\" rebar ground stakes.",
    calculatorName: "Retaining Wall Backfill & Drainage Calculator",
    href: "/calculators/retaining-wall-backfill",
    icon: "⚓"
  },
  {
    stepNumber: 4,
    title: "Perforated French Drain Pipe & 12\" Angular Stone Backfill",
    description: "Lay a 4\" perforated French drain pipe at the heel of the wall with positive slope to daylight. Backfill the entire rear of the timber wall with at least 12 inches of clean angular #57 crushed stone wrapped in non-woven geotextile fabric to eliminate hydrostatic water pressure.",
    calculatorName: "French Drain Pipe Slope Calculator",
    href: "/calculators/french-drain",
    icon: "💧"
  }
];
---

<Layout
  title="Timber & Crosstie Retaining Wall Hub — Step-by-Step Workflow | CalcForDIY"
  description="Build a heavy-duty timber or railroad crosstie retaining wall: base course burial, structural deadman anchors, rebar pin fastening, and hydrostatic stone backfill."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Timber & Crosstie Retaining Wall Hub", "item": "https://calcfordiy.com/projects/retaining-wall-timber-crosstie" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Build a Timber Retaining Wall with Deadman Tiebacks",
    "description": "Comprehensive structural engineering procedure for excavating, stacking, anchoring, and backfilling a heavy timber or crosstie retaining wall.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Trenching & Base Burial",
        "text": "Excavate subgrade, compact 6 inches of crushed rock, and bury the base course 6 inches below grade."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Timber Stacking & Batter Pitch",
        "text": "Step timbers back 1/2\" per foot into the slope and drive 12-inch rebar spikes through each course."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Deadman Anchor Installation",
        "text": "Install perpendicular deadman timber tiebacks buried 4 feet into the hillside every 6 to 8 feet."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Drainage Pipe & Clean Stone Backfill",
        "text": "Place 4\" perforated pipe wrapped in geotextile and backfill 12\" of clean #57 stone to prevent hydrostatic pressure."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Timber Retaining Wall</span>
  </nav>

  <!-- Hero Section -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-3 border border-blue-100">
      <span>🪵 Heavy Civil &amp; Earth Retention Structures</span>
      <span>•</span>
      <span>AWPA UC4B Ground Contact &amp; IBC Section 1807</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Timber &amp; Crosstie Retaining Wall Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      Heavy treated landscape timbers (6x6) and reclaimed railroad crossties offer a rugged, cost-effective retaining solution for carving usable terraces out of steep slopes. Earth exerts massive active lateral pressure (typically 30 to 45 lbs per cubic foot equivalent fluid pressure). Preventing a timber wall from bowing forward or toppling requires structural discipline: <strong>burying the base course, leaning the wall with setback batter, installing buried "deadman" tieback anchors, and draining groundwater</strong>.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100 mb-6">
      <div>
        <div class="text-xs text-gray-500 font-medium">Wall Inward Batter</div>
        <div class="text-lg font-bold text-gray-900">1/2" – 3/4" Per Foot</div>
        <div class="text-xs text-blue-600">Resists Overturning Moment</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Base Course Burial</div>
        <div class="text-lg font-bold text-gray-900">&ge; 6" Deep</div>
        <div class="text-xs text-emerald-600">Stops Toe Sliding Shear</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">Deadman Spacing</div>
        <div class="text-lg font-bold text-gray-900">Every 6 to 8 Feet</div>
        <div class="text-xs text-purple-600">On Walls Over 3 Ft Height</div>
      </div>
      <div>
        <div class="text-xs text-gray-500 font-medium">DIY Project Cost</div>
        <div class="text-lg font-bold text-gray-900">$1,250 - $2,400</div>
        <div class="text-xs text-amber-600">4 ft x 40 ft Wall</div>
      </div>
    </div>

    <!-- RSMeans Contractor vs DIY Comparison -->
    <div class="border border-gray-200 rounded-xl overflow-hidden mb-6">
      <div class="bg-gray-100 px-4 py-2.5 font-semibold text-xs text-gray-700 uppercase tracking-wider">
        Project Cost Benchmark: 40 Linear Foot x 4 Foot High Timber Retaining Wall
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-gray-200 text-sm">
        <div class="p-4 bg-white">
          <div class="text-xs font-bold text-gray-500 uppercase mb-1">Landscape Construction Contractor</div>
          <div class="text-2xl font-black text-gray-900 mb-2">$5,800 – $9,400</div>
          <ul class="text-xs text-gray-600 space-y-1.5">
            <li>• Mini-excavator slope cut, trenching &amp; haul-away: $1,400 – $2,200</li>
            <li>• 6" compacted base, timber stacking &amp; rebar pinning: $2,400 – $3,800</li>
            <li>• Excavation and anchoring of 6 structural deadman tiebacks: $900 – $1,500</li>
            <li>• Drainage pipe installation, #57 stone backfill &amp; geotextile: $1,100 – $1,900</li>
          </ul>
        </div>
        <div class="p-4 bg-emerald-50/50">
          <div class="text-xs font-bold text-emerald-800 uppercase mb-1">DIY Self-Performance</div>
          <div class="text-2xl font-black text-emerald-700 mb-2">$1,350 – $2,550</div>
          <ul class="text-xs text-gray-700 space-y-1.5">
            <li>• 36 pressure-treated 6x6x8' timbers (AWPA UC4B Ground Contact): $750 – $1,300</li>
            <li>• 4 tons crushed #57 drainage gravel &amp; base aggregate: $180 – $320</li>
            <li>• 30 pieces 1/2" x 10-ft steel rebar (cut to 12" and 36" pins): $95 – $160</li>
            <li>• 100 ft perforated 4" corrugated French drain pipe &amp; geotextile fabric: $85 – $150</li>
            <li>• Chainsaw chains, carbide wood drill auger &amp; tamper rental: $140 – $250</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Step by Step Workflow Cards -->
  <div class="space-y-6 mb-10 not-prose">
    <h2 class="text-2xl font-black text-gray-900 tracking-tight">The 4-Step Timber Retaining Wall Workflow</h2>
    
    <div class="grid grid-cols-1 gap-4">
      {workflowSteps.map((step) => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 hover:border-blue-300 transition-all shadow-xs">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-blue-600 text-white font-bold flex items-center justify-center text-lg shadow-sm">
              {step.stepNumber}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                <h3 class="text-base font-bold text-gray-900">{step.title}</h3>
                <span class="text-lg">{step.icon}</span>
              </div>
              <p class="text-sm text-gray-600 mb-3 leading-relaxed">{step.description}</p>
              <a
                href={step.href}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 px-3 py-1.5 rounded-md hover:bg-blue-100 transition-colors"
              >
                <span>Calculate Materials: {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Trade Field Note -->
  <FieldNote
    expertName="David Miller, PE"
    role="Senior Structural & Geotechnical Engineer"
    experience="25+ Years Field Experience"
    avatarBg="bg-blue-100 text-blue-800"
    initials="DM"
    title="Why Water Pressure, Not Soil Weight, Destroys 90% of Timber Retaining Walls"
    note="When a timber wall bows outward or rolls over into the driveway after 4 years, homeowners blame the timbers or weak rebar pins. In 90% of geotechnical forensic investigations, the wood didn't fail: HYDROSTATIC PRESSURE destroyed the wall! Dry soil exerts an active lateral pressure of roughly 35 lbs per cubic foot. But when heavy autumn rains saturate clay soil trapped behind a wall without drainage, that lateral pressure jumps to 62.4 lbs per cubic foot (the weight of water) plus soil liquefaction—tripling the outward overturning force! A 4-foot wall holding saturated soil must resist over 500 lbs of lateral force on EVERY linear foot. You cannot hold back that much force with wood screws. You MUST relieve the water pressure by placing a 4-inch perforated drain pipe along the wall heel and backfilling a minimum 12-inch column of clean, open-graded crushed stone (#57 gravel) wrapped in geotextile fabric. Water immediately drops straight down into the pipe and exits to daylight, leaving the wall with zero hydrostatic load."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Timber Retaining Wall Construction"
    mistakes={[
      {
        number: 1,
        title: "Omitting Deadman Timber Anchors on Walls Over 3 Feet High",
        costImpact: "$4,200 (Wall Leaning Forward, Overturning & Complete Rebuild)",
        description: "A cantilevered timber wall over 3 feet lacks the gravitational mass to resist soil moment overturning. Without buried tiebacks, the entire wall bows and topples forward.",
        solution: "Install perpendicular T-shaped deadman timbers extending at least 4 feet into the hillside every 6 to 8 feet horizontally on any wall exceeding 36 inches height."
      },
      {
        number: 2,
        title: "Using Landscaping 'Peeler Core' Timbers Treated Only to UC3B",
        costImpact: "$2,800 (Fungal Rot & Complete Decay in 5 to 7 Years)",
        description: "Cheap round-edge landscape timbers sold at big box stores are treated only for above-ground exterior use (UC3B). In direct soil contact, termites and wet rot destroy them quickly.",
        solution: "Strictly specify timbers labeled AWPA UC4A or UC4B (Heavy Duty Ground Contact) or heavy pressure-creosoted oak railway ties."
      },
      {
        number: 3,
        title: "Building the Wall Perfectly Vertical (90 Degrees) with Zero Batter",
        costImpact: "$1,600 (Optical Leaning & Forward Creep Under Soil Creep)",
        description: "A plumb 90-degree wall looks like it is falling forward even when true, and normal microscopic seasonal soil settlement pushes it past vertical.",
        solution: "Step each course back into the hillside by 1/2\" to 3/4\" per foot of vertical elevation (an inward batter of roughly 3 to 5 degrees)."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Timber Wall Workflow"
    reviews={[
      {
        author: "Wayne & Carol M.",
        location: "Knoxville, TN",
        projectScope: "4.5-ft High x 50-ft Long 6x6 Timber Retaining Wall",
        savingsClaim: "Saved $6,200 vs Contractor Estimate",
        feedback: "We dug our deadman trenches 4 feet back into the bank and pinned each T-bar with 36\" rebar stakes per David Miller's guide. Backfilled with 8 tons of clean #57 stone. During a 4-inch hurricane rain event, water rushed out of our daylight drain pipe like a firehose. The wall didn't move an eighth of an inch.",
        keyTakeaway: "Buy an extended 1/2\" wood ship-auger drill bit (18 inches long)—it drills through two stacked 6x6 timbers in 10 seconds flat."
      },
      {
        author: "Dustin B.",
        location: "Spokane, WA",
        projectScope: "Terraced Crosstie Driveway Retaining Wall",
        savingsClaim: "Zero Bulging After 3 Winter Freezes",
        feedback: "The 1/2\" per foot inward batter made the wall look professionally finished and rock solid. Staggering the joints by at least 2 feet gave the structure immense interlocking strength. Deadman tiebacks locked it into the native soil.",
        keyTakeaway: "Wrap the crushed drainage stone in non-woven geotextile fabric like a burrito so native clay mud cannot migrate into and plug the gravel voids."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Timber & Crosstie Retaining Wall Hub" initialYesCount={371} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Senior Structural & Geotechnical Engineer"
    codeStandard="IBC Section 1807.2 (Retaining Walls) & AWPA Book of Standards UC4B"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Project Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/deadman-timber-tieback-installation" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Deadman Tieback Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Geotechnical tieback anchor mechanics, pullout resistance formulas, and spacing charts.</div>
      </a>
      <a href="/calculators/retaining-wall" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Retaining Wall Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate timber course counts, linear footages, and rebar pin quantities.</div>
      </a>
      <a href="/calculators/retaining-wall-backfill" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Wall Backfill &amp; Drainage Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate tons of clean #57 gravel and geotextile square yardage for drainage columns.</div>
      </a>
    </div>
  </div>

</Layout>

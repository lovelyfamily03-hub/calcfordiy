---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "6x6 Timber Columns & Below-Frost Concrete Piers",
    description: "Auger 12\" diameter concrete footings below the local frost line, install post base standoff brackets, and erect 6x6 Douglas fir or cedar posts braced with angled knee braces.",
    calculatorName: "Sonotube Concrete Pier Calculator",
    href: "/calculators/sonotube-concrete",
    icon: "🏗️"
  },
  {
    stepNumber: 2,
    title: "Heavy Timber Beams, Rafters & Southward Pitch",
    description: "Notch and bolt double 2x10 or 4x10 support beams with 1/2\" galvanized through-bolts, and space 2x8 roof rafters at 24\" o.c. pitched between 15° and 30° toward true solar south.",
    calculatorName: "Pergola Lumber & Timber Calculator",
    href: "/calculators/pergola-lumber",
    icon: "🪵"
  },
  {
    stepNumber: 3,
    title: "Bifacial Solar Panel Array Mounting & Clamps",
    description: "Install an aluminum racking rail grid, secure bifacial glass-on-glass solar modules with mid-clamps and end-clamps, and seal gaps between panels with EPDM T-gasket weatherstripping.",
    calculatorName: "Roof Pitch & Rafter Calculator",
    href: "/calculators/roof-pitch-rafter",
    icon: "☀️"
  },
  {
    stepNumber: 4,
    title: "DC String Inverter Wiring & Grid / Battery Tie-In",
    description: "Run UV-resistant 10 AWG PV wire through rigid metallic conduit (RMC) to a DC rapid shutdown box, connect to a hybrid solar inverter, and wire a 40A backfed breaker in the main panel.",
    calculatorName: "Solar Battery & Load Calculator",
    href: "/calculators/solar-battery-sizing",
    icon: "⚡"
  }
];
---

<Layout
  title="Solar Pergola Timber Structure Hub — Step-by-Step DIY Workflow | CalcForDIY"
  description="Follow a 4-step heavy timber solar pergola workflow: Below-frost piers, engineered 6x6 posts, bifacial solar panel mounting, and DC inverter wiring."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Solar Pergola Timber Structure Hub", "item": "https://calcfordiy.com/projects/solar-pergola-timber-structure" }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Solar Pergola Structure</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-xs font-semibold mb-3 border border-amber-200">
      <span>☀️ Dual-Purpose Clean Energy &amp; Outdoor Living</span>
      <span>•</span>
      <span>4-Step Sequential Guide</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight mb-3">
      Solar Pergola Heavy Timber Construction Hub
    </h1>
    <p class="text-base text-gray-600 leading-relaxed max-w-3xl mb-6">
      A solar patio pergola generates 4 kW to 8 kW of residential clean electricity while providing waterproof outdoor living shade. This master workflow covers structural engineering and NEC Article 690 standards: wind uplift moment resisting timber connections, bifacial module mounting, aluminum racking rails, and rapid shutdown compliance.
    </p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100">
      <div>
        <div class="text-xs text-gray-500">Estimated Timeline</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">2 Weekends (16-Panel Array)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Potential DIY Savings</div>
        <div class="text-sm font-bold text-emerald-600 mt-0.5">$9,500 – $16,000 (65%)</div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Trade Code Standard</div>
        <div class="text-sm font-bold text-gray-900 mt-0.5">NEC Article 690 &amp; ASCE 7-22 Wind</div>
      </div>
    </div>
  </div>

  <!-- RSMeans DIY vs Contractor Benchmark -->
  <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xs not-prose">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-bold text-base text-blue-200">2026 Solar Contractor Bid vs. DIY Material Cost</h3>
      <span class="text-xs bg-blue-500/30 text-blue-300 px-2.5 py-0.5 rounded font-mono">RSMeans Cost Data (16ft x 20ft Timber Pergola + 6.4 kW Solar Array)</span>
    </div>
    <p class="text-xs text-slate-300 mb-6">Turnkey solar installer canopy quote ($22,000–$34,000) vs. DIY retail rough-sawn cedar, bifacial panels, hybrid inverter &amp; racking.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Estimated DIY Materials &amp; Solar Equipment</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$7,800 – $10,500</div>
        <div class="text-[11px] text-slate-400 mt-1">16 bifacial 400W panels, hybrid string inverter, 6x6 cedar timber &amp; iron hardware</div>
      </div>
      <div class="bg-white/10 p-4 rounded-xl border border-white/10">
        <div class="text-xs text-slate-300 font-medium">Solar Canopy Contractor Turn-Key Bid</div>
        <div class="text-2xl font-black text-amber-300 mt-1">$23,500 – $36,000</div>
        <div class="text-[11px] text-slate-400 mt-1">Solar Installation Labor 55% • Engineering &amp; Permits 15% • Materials 30%</div>
      </div>
    </div>

    <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-3 rounded-xl border border-emerald-500/30">
      <span class="text-emerald-400 font-bold text-base">💰</span>
      <span>Sweat Equity Advantage: You save roughly <strong>$15,700 to $25,500</strong> while generating free power and claiming the 30% Federal Clean Energy Tax Credit (Residential Clean Energy Credit).</span>
    </div>
  </div>

  <!-- Sequential Workflow Steps -->
  <div class="mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Sequential Phase Checklist</h2>
    <p class="text-sm text-gray-500 mb-6">Execute the 4 structural and electrical phases to construct a 120 MPH wind-rated solar shade canopy.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col justify-between hover:border-blue-300 hover:shadow-sm transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                {step.stepNumber}
              </span>
              <span class="text-2xl">{step.icon}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-4">{step.description}</p>
          </div>
          <a
            href={step.href}
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-xs font-semibold transition-all border border-blue-200"
          >
            <span>Open {step.calculatorName}</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Marcus Vance"
    role="Master Electrician & Building Systems Specialist"
    experience="22+ Years Field Experience"
    avatarBg="bg-amber-100 text-amber-800"
    initials="MV"
    title="Why Solar Pergolas Face Severe Wind Uplift Forces"
    note="Unlike a rooftop solar installation where panels sit 4 inches above an existing roof deck, a pergola has a completely open underside. In civil and structural engineering, this is classified as an 'open canopy structure' (ASCE 7-22). When a 70 MPH storm wind blows across your yard, air rushes under the open pergola and creates a massive aerodynamic low-pressure lift above the solar panels—acting like an airplane wing! A 16x20 pergola array holding 16 panels can experience over 6,500 pounds of net upward lift. Never rely on decorative aluminum surface brackets or toenails! You must anchor your 6x6 posts into deep concrete piers using heavy-gauge seismic post bases (Simpson Strong-Tie CBSQ or MPB66Z) with 5/8-inch through-bolts, and install diagonal 4x6 knee braces on all four corners to prevent racking."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    tradeName="Solar Pergola Construction"
    mistakes={[
      {
        number: 1,
        title: "Using Standard Opaque Solar Panels Instead of Bifacial Glass-on-Glass",
        costImpact: "$1,800 (Loss of 20% Extra Albedo Power Generation)",
        description: "Standard panels have an opaque white plastic backsheet that looks ugly from below and produces zero electricity from ground-reflected ambient light.",
        solution: "Install frameless or black-frame bifacial glass-on-glass modules; sunlight reflecting off your patio concrete illuminates the underside, boosting total generation by 15% to 25%."
      },
      {
        number: 2,
        title: "Omitting EPDM Rubber T-Gaskets Between Panels",
        costImpact: "$1,200 (Rain Dripping Between Panels Ruining Patio Furniture)",
        description: "Leaving 1/2-inch open gaps between solar modules allows rainwater to pour directly through the seams onto your outdoor dining table and seating.",
        solution: "Install architectural EPDM solar panel T-gasket strips pressed into the seams between panel frames to create a 100% watertight roof canopy."
      },
      {
        number: 3,
        title: "Running Exposed PV Wire Without Metal Conduit Protection",
        costImpact: "$850 (Squirrel Chewing DC Wires & Fire Hazard)",
        description: "Leaving exposed high-voltage DC wiring dangling beneath timber rafters invites rodents and squirrels to chew through insulation, triggering dangerous DC arc faults.",
        solution: "Route all DC conductor wiring inside electrical metallic tubing (EMT) or rigid PVC conduit securely strapped to timber rafters per NEC 690.31."
      }
    ]}
  />

  <!-- Builder Community Reviews -->
  <CommunityReviews
    tradeTitle="Solar Pergola Workflow"
    reviews={[
      {
        author: "Trevor & Sarah M.",
        location: "Albuquerque, NM",
        projectScope: "16x22 Heavy Timber Pergola with 7.2 kW Solar",
        savingsClaim: "Saved $18,400 vs Solar Installer",
        feedback: "We framed our pergola using 6x6 rough cedar posts on 36-inch deep concrete piers. Mounted 18 bifacial 400W panels. In the hot summer, it shades our flagstone patio completely while wiping out our electric bill. The EPDM T-gaskets keep our patio dry in monsoon rains.",
        keyTakeaway: "Pitch the pergola roof at least 10 to 15 degrees so rainwater washes dust and pollen off the glass naturally."
      },
      {
        author: "Devin B.",
        location: "Boise, ID",
        projectScope: "Detached Solar Carport & Patio Canopy",
        savingsClaim: "$4,800 Clean Energy Tax Credit Claimed",
        feedback: "The knee-brace and Simpson post base advice was spot-on. We had an 80 MPH windstorm this spring that toppled our neighbor's gazebo, but our solar pergola didn't budge an inch. The bifacial panels look gorgeous when looking up from the patio.",
        keyTakeaway: "Use black anodized aluminum racking and black mid-clamps for a sleek architectural finish."
      }
    ]}
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Solar Pergola Structure Hub" initialYesCount={367} />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Master Systems & MEP Building Specialist"
    codeStandard="NEC NFPA 70 Article 690 (Solar PV) & ASCE 7-22 Wind Load Provisions"
    lastUpdated="September 2026"
  />

  <!-- Related Guides & Hubs -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 not-prose">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Editorial Guides &amp; Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/guides/solar-panel-angle-tilt-azimuth-formula" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Solar Angle Tilt Guide →</div>
        <div class="text-xs text-gray-500 mt-1">Latitude tilt optimization formulas, true south azimuth, and seasonal adjustments.</div>
      </a>
      <a href="/calculators/pergola-lumber" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Pergola Lumber Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate post sizes, beam spans, and rafter counts for outdoor timber framing.</div>
      </a>
      <a href="/calculators/solar-battery-sizing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Solar Battery Sizing Calculator →</div>
        <div class="text-xs text-gray-500 mt-1">Calculate daily kWh production, battery bank capacity, and inverter wattage.</div>
      </a>
    </div>
  </div>

</Layout>

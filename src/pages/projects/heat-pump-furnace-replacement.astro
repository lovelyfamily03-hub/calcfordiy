---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Manual J Heating/Cooling Load Calculation & Duct Airflow Static Pressure Audit",
    description: "Perform room-by-room heating loss and cooling gain calculations per ACCA Manual J. Test existing supply/return plenum external static pressure (ESP) with a dual-port digital manometer to verify ductwork can support 350–400 CFM per ton of heat pump airflow without choking.",
    calculatorName: "AC Cost & Sizing Estimator",
    href: "/calculators/ac-cost",
    icon: "📐"
  },
  {
    stepNumber: 2,
    title: "Decommissioning, Evacuation & Pad / Disconnect Installation",
    description: "Recover remaining R-410A or R-22 refrigerant to 0 psig per EPA Section 608. Set a heavy-duty composite equipment pad level on 4 inches of crushed stone, install a 30A/60A fused weatherproof outdoor disconnect, and run liquid-tight flexible metallic conduit (LFMC).",
    calculatorName: "Mini Split BTU Sizing Calculator",
    href: "/calculators/mini-split-sizing",
    icon: "⚡"
  },
  {
    stepNumber: 3,
    title: "Furnace Setting, Cased Evaporator Coil Mounting & PVC Flue Venting",
    description: "Install 96% AFUE two-stage condensing gas furnace with anti-vibration rubber-cork pads. Mount the matched cased A-coil, glue concentric two-pipe PVC/CPVC intake and exhaust flue vents maintaining 1/4-inch pitch per foot back to the furnace drain, and wire the multi-stage 24V thermostat.",
    calculatorName: "Gas Furnace Replacement Cost Calculator",
    href: "/calculators/furnace-cost",
    icon: "🔥"
  },
  {
    stepNumber: 4,
    title: "Lineset Nitrogen Brazing, Triple Evacuation to <500 Microns & Commissioning",
    description: "Purge dry nitrogen at 3–5 SCFH while brazing 3/8-inch liquid and 3/4-inch suction lines with 15% silver alloy. Pressure test at 400 PSI for 24 hours, perform a triple evacuation down below 500 microns (holding <1,000 microns for 15 minutes), release factory charge, and verify subcooling.",
    calculatorName: "AC Replacement & Operating Cost Estimator",
    href: "/calculators/ac-cost",
    icon: "❄️"
  }
];
---

<Layout
  title="Dual-Fuel Heat Pump & Gas Furnace Replacement Hub | CalcForDIY"
  description="Step-by-step engineering workflow for installing a high-efficiency dual-fuel heat pump paired with a 96% AFUE condensing gas furnace: Manual J, lineset brazing, and balance point setup."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Dual-Fuel Heat Pump & Furnace Hub", "item": "https://calcfordiy.com/projects/heat-pump-furnace-replacement" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Replace an HVAC System with a Dual-Fuel Heat Pump and Condensing Furnace",
    "description": "Complete sequential workflow for replacing home heating and cooling with an inverter heat pump paired with a 96% AFUE gas furnace.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Manual J Load & Duct Pressure Audit",
        "text": "Calculate heating/cooling loads and measure external static pressure across existing ductwork."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Refrigerant Recovery & Equipment Pad",
        "text": "Evacuate old system, pour crushed stone base, set composite pad, and install fused disconnect."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Condensing Furnace & Cased Coil Setting",
        "text": "Set 96% AFUE gas furnace, mount matching cased evaporator coil, and pipe two-stage PVC venting."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Nitrogen Brazing & Micron Gauge Vacuum",
        "text": "Braze copper lineset under nitrogen purge, pull vacuum to <500 microns, and tune balance point."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Heat Pump &amp; Furnace Hub</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xl not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 text-xs font-semibold mb-4 border border-blue-400/30">
      <span>🔥 Dual-Fuel Hybrid HVAC Engineering</span>
      <span>•</span>
      <span>ACCA Manual J &amp; S Compliant</span>
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4 text-white">
      High-Efficiency Heat Pump &amp; Gas Furnace Replacement Hub
    </h1>

    <p class="text-slate-300 text-base sm:text-lg max-w-3xl leading-relaxed mb-6">
      A dual-fuel hybrid system delivers the best of both worlds: ultra-efficient electric heat pump operation during mild spring, fall, and summer weather (down to 30°F–35°F), paired with a 96% AFUE two-stage gas furnace for instant, scorching heat during deep sub-zero winter freezes.
    </p>

    <!-- Visual Job-Site Photography -->
    <div class="mb-6">
      <img
        src="/images/projects/heat-pump-furnace-replacement.jpg"
        alt="High efficiency split inverter heat pump outdoor condenser unit installed on a composite equipment pad"
        class="w-full h-56 sm:h-72 md:h-84 lg:h-96 object-cover rounded-xl shadow-md border border-slate-700/80"
        loading="eager"
      />
      <p class="text-xs text-slate-400 mt-2 italic text-center sm:text-left">
        Job-site installation: Inverter cold-climate heat pump outdoor unit with liquid-tight electrical whip and insulated suction line set level on gravel equipment pad.
      </p>
    </div>

    <!-- Contractor Cost vs DIY Savings Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-700/80">
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">Turnkey Contractor Quote</div>
        <div class="text-2xl font-black text-rose-400 mt-1">$14,500 – $19,800</div>
        <div class="text-xs text-slate-400 mt-0.5">3-Ton 16 SEER2 + 96% Gas Furnace</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">DIY / Hybrid Equipment Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$6,200 – $8,100</div>
        <div class="text-xs text-slate-400 mt-0.5">Direct Equipment + Permitting + Nitrogen</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">Estimated DIY Savings</div>
        <div class="text-2xl font-black text-blue-400 mt-1">$8,300 – $11,700</div>
        <div class="text-xs text-slate-400 mt-0.5">Retain 55%–60% in Labor Equity</div>
      </div>
    </div>
  </div>

  <!-- Phased Workflow Section -->
  <div class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
      <span>🛠️</span> 4-Phase System Replacement Architecture
    </h2>

    <div class="space-y-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 sm:p-6 shadow-xs hover:border-blue-300 transition-all">
          <div class="flex items-start gap-4">
            <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-blue-100 text-blue-700 font-black text-lg shrink-0">
              {step.stepNumber}
            </span>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                {step.title}
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed mb-4">
                {step.description}
              </p>
              <a
                href={step.href}
                class="inline-flex items-center gap-2 text-xs font-semibold text-blue-600 bg-blue-50 px-3 py-1.5 rounded-lg hover:bg-blue-100 transition-colors"
              >
                <span>{step.icon} Open {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Budget Breakdown Table -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-10 not-prose shadow-xs">
    <h2 class="text-xl font-bold text-gray-900 mb-4">
      Dual-Fuel System Material Takeoff &amp; Cost Model
    </h2>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm border-collapse">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50 text-gray-700 font-semibold">
            <th class="p-3">Component / Material</th>
            <th class="p-3">Technical Specification</th>
            <th class="p-3">Quantity</th>
            <th class="p-3">Avg DIY Cost</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-gray-600">
          <tr>
            <td class="p-3 font-medium text-gray-900">3-Ton 16 SEER2 Heat Pump Condenser</td>
            <td class="p-3">Variable-speed inverter, cold climate rated to -5°F</td>
            <td class="p-3">1 Unit</td>
            <td class="p-3 font-mono">$3,400</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">96% AFUE Two-Stage Gas Furnace</td>
            <td class="p-3">ECM constant-CFM blower motor, multi-speed</td>
            <td class="p-3">1 Unit</td>
            <td class="p-3 font-mono">$1,850</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">Matched Cased Evaporator Coil</td>
            <td class="p-3">Factory installed TXV, aluminum tube &amp; fins</td>
            <td class="p-3">1 Unit</td>
            <td class="p-3 font-mono">$750</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">Lineset &amp; Nitrogen Brazing Supplies</td>
            <td class="p-3">3/8" x 3/4" 50-ft copper, 15% silver rod, purge tank</td>
            <td class="p-3">1 Lot</td>
            <td class="p-3 font-mono">$380</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">PVC Flue &amp; Condensate Drainage</td>
            <td class="p-3">Schedule 40 PVC, neutralizer kit &amp; Little Giant pump</td>
            <td class="p-3">1 Lot</td>
            <td class="p-3 font-mono">$220</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Marcus Vance"
    role="Licensed Master Electrician & MEP Systems Specialist"
    experience="22+ Years Field Service"
    avatarBg="bg-blue-100 text-blue-800"
    initials="MV"
    title="Why Flowing Nitrogen During Brazing Prevents Clogged TXV Valves"
    note="When you braze copper linesets with an oxy-acetylene torch at 1,200°F without a dry nitrogen purge, oxygen inside the tube reacts with red-hot copper to form black cupric oxide scale. The moment you start the system, the high-pressure refrigerant flushes that gritty black flake right into the microscopic orifice of your thermal expansion valve (TXV), locking it completely shut. Hook up your nitrogen regulator to the liquid line Schrader port at a slow 3–5 SCFH trickle before your torch ever touches the joint."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    mistakes={[
      {
        title: "Skipping the Manual J Load Calculation and Oversizing the Heat Pump",
        impact: "$2,200 in Short-Cycling & Premature Compressor Failure",
        description: "Bigger is not better in inverter heat pumps. An oversized unit blasts short bursts of cold air in summer without running long enough to pull latent humidity from the air, resulting in a cold, clammy 70% RH house."
      },
      {
        title: "Failing to Install an Acid Neutralizer on High-Efficiency Furnace Condensate",
        impact: "$4,500 in Corroded Cast Iron Under-Slab Plumbing",
        description: "A 96% condensing furnace generates gallons of acidic condensate with a pH of 3.2 to 4.5. Running this directly into household ABS or cast-iron drain lines will eat through metal fittings within 3 to 5 heating seasons."
      },
      {
        title: "Improper Outdoor Sensor Placement for the Dual-Fuel Switchover Point",
        impact: "$650/Year in Skyrocketing Electric Bills",
        description: "If your thermostat switchover point is left at factory default or the outdoor temperature sensor is placed in direct sunlight, the heat pump may run inefficiently in sub-zero weather while expensive auxiliary heat strips engage."
      }
    ]}
  />

  <!-- Community Reviews -->
  <CommunityReviews
    reviews={[
      {
        name: "Derek & Kimberly M.",
        location: "Grand Rapids, MI",
        projectScope: "3-Ton Inverter Heat Pump + 80k BTU 96% Furnace",
        costSaved: "Saved $9,400",
        feedback: "Contractors in West Michigan quoted us $18,200 for a dual-fuel setup. Using CalcForDIY's sizing equations, we calculated our true heat loss was only 58,000 BTU. We set our balance point at 32°F. The heat pump runs silently all autumn, and the furnace only kicks on during blizzard conditions."
      },
      {
        name: "Brian S.",
        location: "Fort Collins, CO",
        projectScope: "AC to Heat Pump Retrofit with Existing Ductwork",
        costSaved: "Saved $7,800",
        feedback: "The duct static pressure audit tip saved my project. My old supply trunk was only 0.25 in. w.g., which was choking the new blower. I widened the return drop to 16x25 inches before hooking up the cased coil, and the static pressure dropped to a perfect 0.48 in. w.g."
      }
    ]}
  />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Licensed Master Electrician & MEP Systems Specialist"
    codeStandard="ACCA Manual J & S Standards, DOE 2023 Regional SEER2 / HSPF2 Efficiency Mandates"
    lastUpdated="September 2026"
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Heat Pump & Furnace Replacement Hub" initialYesCount={184} />

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import FieldNote from '../../components/FieldNote.astro';
import CostlyMistakes from '../../components/CostlyMistakes.astro';
import CommunityReviews from '../../components/CommunityReviews.astro';
import HelpfulFeedback from '../../components/HelpfulFeedback.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Structural Inspection, Loose Fasteners & Soil Clearance Trimming",
    description: "Inspect all 4x4 posts for ground-level rot. Re-drive popped ring-shank nails or replace with 2-1/2-inch polymer-coated star-drive deck screws. Trim back turf, weeds, and mulch to maintain a strict 2-inch clearance below pickets to prevent capillary ground moisture absorption.",
    calculatorName: "Fence Pickets & Post Calculator",
    href: "/calculators/fence-pickets",
    icon: "🪵"
  },
  {
    stepNumber: 2,
    title: "Oxygenated Chemical Washing, Mildew Extermination & Oxalic Acid Neutralization",
    description: "Apply sodium percarbonate oxygenated wood cleaner with a garden pump sprayer. Allow 15 minutes of dwell time to dissolve gray UV-damaged lignin and organic mildew, scrub with a stiff synthetic bristle brush, pressure wash at a gentle 800–1,000 PSI with a 40° fan tip, and neutralize with oxalic acid brightener to restore cedar's natural pH 4.5.",
    calculatorName: "Fence Stain & Sealer Gallon Calculator",
    href: "/calculators/fence-stain",
    icon: "🧼"
  },
  {
    stepNumber: 3,
    title: "Pin-Type Moisture Content Testing (<15% MC Requirement)",
    description: "Allow the washed fence to dry for 48 to 72 hours under warm, dry weather. Insert a calibrated two-pin digital wood moisture meter 1/8-inch deep into pickets and horizontal 2x4 rails at multiple locations. Never apply oil-based stain if wood moisture exceeds 15% to 18%, or stain penetration will be blocked by internal water.",
    calculatorName: "Deck Stain & Preservative Calculator",
    href: "/calculators/deck-stain",
    icon: "🌡️"
  },
  {
    stepNumber: 4,
    title: "Airless Spraying with Immediate Wet-on-Wet Back-Brushing",
    description: "Spray deep-penetrating semi-transparent oil stain (paraffinic or modified alkyd oil) using a 515 reversible tip at 1,500 PSI. Work 2 to 3 boards at a time, immediately back-brushing with a wide 4-inch natural bristle stain brush to force pigment deep into cedar pores and eliminate drip runs.",
    calculatorName: "Exterior Fence Stain & Area Calculator",
    href: "/calculators/fence-stain",
    icon: "🖌️"
  }
];
---

<Layout
  title="Wood Fence Restoration & Staining Hub — Step-by-Step | CalcForDIY"
  description="Master guide for restoring and staining cedar and pressure-treated wood fences: oxygenated washing, oxalic brightener, moisture testing, and spray/back-brushing."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects" },
      { "@type": "ListItem", "position": 3, "name": "Wood Fence Restoration Hub", "item": "https://calcfordiy.com/projects/wood-fence-restoration-staining" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Clean, Restore, and Stain a Wood Privacy Fence",
    "description": "Professional workflow for washing weathered gray fencing, neutralizing with brightener, moisture testing, and applying penetrating oil stain.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Structural Inspection & Fastener Tightening",
        "text": "Inspect posts, replace rusted nails with structural screws, and trim turf to clear bottom of pickets."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Chemical Wash & Oxalic Acid Brightening",
        "text": "Spray sodium percarbonate cleaner, wash at gentle 800 PSI, and apply oxalic acid to neutralize pH."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Moisture Testing & Weather Window",
        "text": "Verify wood moisture content is below 15% using a calibrated pin-style meter."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Airless Spraying & Manual Back-Brushing",
        "text": "Spray penetrating semi-transparent oil stain and immediately back-brush to force pigment into wood cells."
      }
    ]
  }
  </script>

  <!-- Breadcrumbs -->
  <nav class="flex text-xs text-gray-500 mb-4 gap-1 items-center not-prose">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects" class="hover:text-blue-600">Projects</a>
    <span>/</span>
    <span class="text-gray-800 font-medium">Fence Restoration &amp; Staining Hub</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-gradient-to-br from-slate-900 via-amber-950 to-slate-900 text-white rounded-2xl p-6 sm:p-8 mb-8 shadow-xl not-prose">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold mb-4 border border-amber-400/30">
      <span>🌲 Exterior Wood Coatings &amp; Preservation</span>
      <span>•</span>
      <span>Forest Products Laboratory &amp; MPI Compliant</span>
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4 text-white">
      Cedar &amp; Pressure-Treated Fence Restoration &amp; Staining Hub
    </h1>

    <p class="text-slate-300 text-base sm:text-lg max-w-3xl leading-relaxed mb-6">
      A gray, weathered wood fence is not dead—it simply has a micro-layer of sun-damaged dead cellulose fibers. By deep-cleaning with oxygenated wash, neutralizing with wood brightener, and applying a non-filming penetrating oil stain with manual back-brushing, you restore natural wood vibrancy and protect against rot for 3 to 5 years.
    </p>

    <!-- Visual Job-Site Photography -->
    <div class="mb-6">
      <img
        src="/images/projects/wood-fence-restoration-staining.jpg"
        alt="Contractor applying penetrating oil wood stain to a vertical cedar privacy fence with wide back-brush"
        class="w-full h-56 sm:h-72 md:h-84 lg:h-96 object-cover rounded-xl shadow-md border border-slate-700/80"
        loading="eager"
      />
      <p class="text-xs text-slate-400 mt-2 italic text-center sm:text-left">
        Job-site application: Semi-transparent golden cedar penetrating oil stain brushed into vertical pickets with wet-edge back-brushing.
      </p>
    </div>

    <!-- Contractor Cost vs DIY Savings Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-700/80">
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">Turnkey Painting Contractor</div>
        <div class="text-2xl font-black text-rose-400 mt-1">$2,800 – $4,200</div>
        <div class="text-xs text-slate-400 mt-0.5">150 Linear Ft (Both Sides = 1,800 sq ft)</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">DIY Materials &amp; Chemical Cost</div>
        <div class="text-2xl font-black text-emerald-400 mt-1">$480 – $680</div>
        <div class="text-xs text-slate-400 mt-0.5">Penetrating Oil + Cleaner + Brightener</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700/60">
        <div class="text-xs text-slate-400 font-medium">Total Weekend DIY Savings</div>
        <div class="text-2xl font-black text-blue-400 mt-1">$2,300 – $3,500</div>
        <div class="text-xs text-slate-400 mt-0.5">Save $1.30–$1.90 per sq ft in Labor</div>
      </div>
    </div>
  </div>

  <!-- Phased Workflow Section -->
  <div class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
      <span>🪵</span> 4-Phase Fence Staining Procedure
    </h2>

    <div class="space-y-6">
      {workflowSteps.map(step => (
        <div class="bg-white border border-gray-200 rounded-xl p-5 sm:p-6 shadow-xs hover:border-blue-300 transition-all">
          <div class="flex items-start gap-4">
            <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-blue-100 text-blue-700 font-black text-lg shrink-0">
              {step.stepNumber}
            </span>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                {step.title}
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed mb-4">
                {step.description}
              </p>
              <a
                href={step.href}
                class="inline-flex items-center gap-2 text-xs font-semibold text-blue-600 bg-blue-50 px-3 py-1.5 rounded-lg hover:bg-blue-100 transition-colors"
              >
                <span>{step.icon} Open {step.calculatorName}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Budget Breakdown Table -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-10 not-prose shadow-xs">
    <h2 class="text-xl font-bold text-gray-900 mb-4">
      150 Linear Foot Privacy Fence (1,800 Sq Ft) Material Takeoff
    </h2>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm border-collapse">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50 text-gray-700 font-semibold">
            <th class="p-3">Material Component</th>
            <th class="p-3">Technical Specification</th>
            <th class="p-3">Quantity Needed</th>
            <th class="p-3">Average DIY Cost</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-gray-600">
          <tr>
            <td class="p-3 font-medium text-gray-900">Semi-Transparent Penetrating Oil Stain</td>
            <td class="p-3">Paraffinic oil, trans-oxide pigments (Armstrong/Ready Seal/TWP)</td>
            <td class="p-3">12 Gallons (150 sq ft/gal)</td>
            <td class="p-3 font-mono">$480</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">Sodium Percarbonate Cleaner</td>
            <td class="p-3">Oxygenated bleach powder, non-toxic to vegetation</td>
            <td class="p-3">4 lbs (Makes 10 gal)</td>
            <td class="p-3 font-mono">$45</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">Oxalic Acid Wood Brightener</td>
            <td class="p-3">Acidic neutralizer crystals (restores pH to 4.5)</td>
            <td class="p-3">2 lbs (Makes 8 gal)</td>
            <td class="p-3 font-mono">$32</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">4-Inch Natural Bristle Stain Brush &amp; Extension</td>
            <td class="p-3">Thick China bristle, threaded broom handle adapter</td>
            <td class="p-3">2 Sets</td>
            <td class="p-3 font-mono">$48</td>
          </tr>
          <tr>
            <td class="p-3 font-medium text-gray-900">2-Pin Digital Moisture Meter</td>
            <td class="p-3">Calibrated wood moisture tester (5% to 40% range)</td>
            <td class="p-3">1 Unit</td>
            <td class="p-3 font-mono">$35</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Jobsite Field Note -->
  <FieldNote
    author="Elena Rostova, CBO"
    role="Certified Building Official & Architectural Finishes Specialist"
    experience="18+ Years Coating Evaluations"
    avatarBg="bg-emerald-100 text-emerald-800"
    initials="ER"
    title="Never Use Household Chlorine Bleach (Sodium Hypochlorite) to Wash Wood"
    note="Homeowners frequently blast gray fences with household laundry bleach. While chlorine bleach instantly turns wood white, it does so by breaking down the cellular lignin that glues wood fibers together, leaving the surface mushy, pulp-like, and weak. Furthermore, bleach leaves sodium chloride salt crystals inside the grain that attract atmospheric moisture and rust fence nails. Always use oxygenated bleach (sodium percarbonate), followed by an oxalic acid rinse to brighten the tannins safely."
  />

  <!-- Costly Mistakes -->
  <CostlyMistakes
    mistakes={[
      {
        title: "Applying Film-Forming Acrylic Latex Stain on Rough-Sawn Fencing",
        impact: "$1,800 in Future Stripping & Flaking Disaster",
        description: "Waterborne acrylic latex stains sit on top of the wood like a plastic sheet. After 18 months of baking in the sun, temperature cycles crack the film, moisture gets trapped underneath, and the stain peels in unsightly ribbons that cannot be recoated without chemical stripping."
      },
      {
        title: "Blasting the Wood with Excessive 3,000 PSI Pressure Washer Pressure",
        impact: "Fuzzy Wood Pitted with Irreversible Gouges",
        description: "High-pressure tips gouge soft earlywood bands, raising wood fuzz and creating permanent furrow lines. Keep water pressure below 1,000 PSI and hold the 40-degree white nozzle at least 12 inches away from the fence surface."
      },
      {
        title: "Spraying on a Windy Afternoon Without Immediate Back-Brushing",
        impact: "Car Overspray Lawsuits & Blotchy Lap Marks",
        description: "Airless sprayers atomize fine oil droplets that drift onto neighbor cars and siding. Work with a wind screen, and always have a partner immediately back-brush the spray to eliminate pooling and lap marks."
      }
    ]}
  />

  <!-- Community Reviews -->
  <CommunityReviews
    reviews={[
      {
        name: "Carlos & Maria R.",
        location: "Austin, TX",
        projectScope: "8-Year-Old Western Red Cedar Privacy Fence",
        costSaved: "Saved $3,100",
        feedback: "Our fence looked completely gray and decrepit. The oxygenated wash lifted the grime effortlessly, and the oxalic brightener made the cedar look like it was milled yesterday. We sprayed semi-transparent oil and back-brushed. Two years later in Texas sun, it still looks stunning."
      },
      {
        name: "Dave K.",
        location: "Charlotte, NC",
        projectScope: "New Pressure-Treated Pine Fence",
        costSaved: "Saved $2,400",
        feedback: "The moisture meter tip was critical. My new pressure-treated fence was fresh from the lumber yard and read 26% moisture. I waited 8 weeks until it dropped to 13%. The oil stain soaked in like a sponge."
      }
    ]}
  />

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Architectural Finishes Specialist"
    codeStandard="Forest Products Laboratory Finishes Manual & Western Red Cedar Lumber Assoc. Guidelines"
    lastUpdated="September 2026"
  />

  <!-- Helpful Feedback Widget -->
  <HelpfulFeedback calculatorName="Fence Restoration & Staining Hub" initialYesCount={172} />

</Layout>

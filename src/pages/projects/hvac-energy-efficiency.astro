---
import Layout from '../../layouts/Layout.astro';

const workflowSteps = [
  {
    stepNumber: 1,
    title: "Whole-House Fan Sizing & Attic Vent Area",
    description: "Calculate required fan CFM, air changes per hour (ACH), and attic Net Free Vent Area (NFVA sq ft) per HVI standards for rapid evening cooling.",
    calculatorName: "Whole-House Fan Calculator",
    href: "/calculators/whole-house-fan/",
    icon: "💨"
  },
  {
    stepNumber: 2,
    title: "Attic & Ceiling Blown-In Insulation R-Value",
    description: "Calculate bags of blown fiberglass or cellulose insulation to upgrade attic thermal depth to R-38, R-49, or R-60 energy code standards.",
    calculatorName: "Attic Insulation Calculator",
    href: "/calculators/attic-insulation/",
    icon: "🏡"
  },
  {
    stepNumber: 3,
    title: "Mini-Split Heat Pump Room Load Sizing",
    description: "Calculate room BTU cooling/heating loads and inverter ductless mini-split tonnage based on room square footage, ceiling height, and sun exposure.",
    calculatorName: "Mini-Split Sizing Calculator",
    href: "/calculators/mini-split-sizing/",
    icon: "❄️"
  },
  {
    stepNumber: 4,
    title: "Hydronic Radiant Floor Heating PEX Loops",
    description: "Calculate 1/2\" PEX tubing linear feet, 300 ft maximum loop counts, manifold port sizes, and floor BTU heat output.",
    calculatorName: "Radiant Floor Heating Calculator",
    href: "/calculators/radiant-floor-heating/",
    icon: "🔥"
  }
];
---

<Layout
  title="Whole-Home Energy & HVAC Efficiency Hub — Step-by-Step Thermal Workflow | CalcForDIY"
  description="Follow a 4-step DIY home energy & HVAC efficiency workflow: Whole-house fan CFM, blown attic insulation R-value, ductless mini-split sizing, and hydronic radiant floor heating."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Project Hubs", "item": "https://calcfordiy.com/projects/" },
      { "@type": "ListItem", "position": 3, "name": "Whole-Home Energy & HVAC Efficiency Hub — Step-by-Step Thermal Workflow", "item": "https://calcfordiy.com/projects/hvac-energy-efficiency/" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Plan and Calculate Whole-Home HVAC and Energy Efficiency Upgrades",
    "description": "A 4-step DIY workflow for calculating whole-house fans, blown attic insulation, mini-split heat pumps, and radiant floor heating.",
    "step": [
      {
        "@type": "HowToStep",
        "name": "Whole-House Fan Airflow Sizing",
        "text": "Calculate required fan CFM and attic Net Free Vent Area (NFVA)."
      },
      {
        "@type": "HowToStep",
        "name": "Attic Insulation R-Value Upgrade",
        "text": "Determine bag counts for blown fiberglass or cellulose to hit R-49 or R-60 depth."
      },
      {
        "@type": "HowToStep",
        "name": "Ductless Mini-Split Heat Pump Sizing",
        "text": "Calculate room BTU loads and inverter mini-split tonnage."
      },
      {
        "@type": "HowToStep",
        "name": "Radiant Floor Heating PEX Loops",
        "text": "Calculate PEX tubing linear feet, max 300 ft loop counts, and manifold ports."
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/projects/" class="hover:text-blue-600">Project Hubs</a>
    <span>/</span>
    <span>HVAC &amp; Energy Efficiency Workflow</span>
  </div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-50 border border-amber-200 rounded-full text-amber-800 text-xs font-semibold mb-3">
      <span>⚡ Step-by-Step Energy Workflow</span>
      <span>•</span>
      <span>4 Integrated Calculators</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Whole-Home HVAC &amp; Energy Efficiency Workflow</h1>
    <p class="text-lg text-gray-600 max-w-3xl">
      Plan, size, and calculate your whole-house cooling fan, blown attic insulation, ductless mini-split heat pumps, and hydronic radiant floor heating in 4 sequential steps.
    </p>
  </div>

  <div class="space-y-6 mb-12">
    {workflowSteps.map((step) => (
      <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs hover:border-blue-400 transition-all">
        <div class="flex items-start gap-4">
          <div class="bg-blue-600 text-white rounded-xl w-10 h-10 flex items-center justify-center font-bold text-lg shrink-0 mt-1">
            {step.stepNumber}
          </div>
          <div class="flex-grow">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xl">{step.icon}</span>
              <h2 class="text-xl font-bold text-gray-900">{step.title}</h2>
            </div>
            <p class="text-gray-600 text-sm mb-4 leading-relaxed">{step.description}</p>
            <a
              href={step.href}
              class="inline-flex items-center gap-2 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-4 py-2 rounded-lg text-sm transition-colors border border-blue-200"
            >
              Open {step.calculatorName} →
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Building Envelope & Load Sizing Protocol -->
  <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 mb-10">
    <h2 class="text-2xl font-bold text-slate-900 mb-3">Order of Operations: Air Sealing Before Equipment Sizing</h2>
    <p class="text-slate-600 text-sm mb-6">
      Oversizing a heat pump or adding inches of blown insulation without sealing bypasses first traps humid indoor air against cold roof sheathing and forces short-cycling. Sequence envelope upgrades in this building-science order:
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 text-sm text-slate-700">
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <h3 class="font-bold text-slate-900 mb-1">1. Top Plate &amp; Penetration Air Sealing First</h3>
        <p>Before blowing fiberglass or cellulose, foam and caulk plumbing stacks, recessed ICAT can lights, bath fan housings, and dropped soffits at the attic plane. Stack-effect exfiltration dominates winter moisture transport into the roof deck.</p>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <h3 class="font-bold text-slate-900 mb-1">2. Eave Baffles &amp; Balanced Attic Ventilation (IRC R806)</h3>
        <p>Maintain a minimum 1-inch clear airway between insulation and roof decking at every soffit bay using rigid baffles so intake air cools the sheathing evenly and prevents winter ice damming and attic truss condensation.</p>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <h3 class="font-bold text-slate-900 mb-1">3. Manual J Heat Load vs. Rule-of-Thumb Tons</h3>
        <p>Never size air conditioning or cold-climate heat pumps strictly by square footage. Sealing a leak-prone 2,000 sq ft home often drops latent cooling demand by 1 full ton, causing oversized units to run brief cycles without dehumidifying.</p>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
        <h3 class="font-bold text-slate-900 mb-1">4. Panel Capacity &amp; Backup Heat Strip Draw (NEC 220)</h3>
        <p>Switching from gas heat to a cold-climate heat pump with 10 kW to 15 kW electric auxiliary strips adds 40A to 60A of continuous demand. Run an NEC Article 220 load calculation before ordering condenser upgrades on a 100A service.</p>
      </div>
    </div>
    <div class="border-t border-slate-200 pt-5">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Engineering Guides &amp; Field Investigations</h3>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm font-medium">
        <li><a href="/guides/air-sealing-attic-before-insulation/" class="text-blue-700 hover:underline">&rarr; Air Sealing the Attic Plane Before Blowing Insulation</a></li>
        <li><a href="/guides/how-much-attic-insulation/" class="text-blue-700 hover:underline">&rarr; Attic Insulation R-Value &amp; Depth Guide (R-38 to R-60)</a></li>
        <li><a href="/guides/dual-fuel-heat-pump-vs-gas-furnace-cost/" class="text-blue-700 hover:underline">&rarr; Dual-Fuel Heat Pump vs. Gas Furnace Balance Point</a></li>
        <li><a href="/guides/nec-220-residential-load-calc/" class="text-blue-700 hover:underline">&rarr; NEC Article 220 Residential Service Load Calculation</a></li>
        <li><a href="/journal/the-attic-mold-catastrophe-blown-insulation-soffit-baffles/" class="text-blue-700 hover:underline">&rarr; Field Dispatch: Attic Mold from Blocked Soffit Baffles</a></li>
        <li><a href="/journal/the-100-amp-reality-check-ev-charger-heat-pump-subpanel/" class="text-blue-700 hover:underline">&rarr; Field Dispatch: The 100-Amp Panel Reality Check for Heat Pumps</a></li>
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <div class="bg-gradient-to-r from-slate-900 to-blue-950 rounded-2xl p-8 text-white text-center">
    <h2 class="text-2xl font-bold mb-2">Need More Home Improvement Calculators?</h2>
    <p class="text-slate-300 text-sm max-w-2xl mx-auto mb-6">
      Explore all 115 free DIY calculators, dynamic SVG framing diagrams, and trade-verified building code tools.
    </p>
    <a href="/calculators/" class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 px-8 rounded-lg transition-colors">
      View All 115 DIY Calculators →
    </a>
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
---

<Layout
  title="Recessed Lighting Calculator for Garage — 20x20 Spacing & Count | CalcForDIY"
  description="Calculate how many recessed lights you need for a 20x20, 24x24, or custom garage. Get instant fixture counts, IES foot-candles, and grid spacing layouts around garage door openers."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Recessed Lighting Calculator for Garage — 20x20 Spacing & Count",
    "description": "Free calculator that estimates recessed light counts, spacing, and grid layouts for garages and workshops based on IES LP-2 standards.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    {
      "@type": "Question",
      "name": "How many garage lights do I need for a 20x20 space?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For a standard 20x20 garage (400 sq ft), you need 6 to 9 recessed lights. For basic parking and storage (20 foot-candles), 6 recessed lights (1,000 lumens each) configured in a 2×3 grid provide clean, shadow-free light. For a workshop, detailing, or gym setup (30 to 50 foot-candles), install 9 recessed lights in a 3×3 grid spaced 6.7 feet apart with a 3.3-foot wall setback."
      }
    },
    {
      "@type": "Question",
      "name": "What is the best grid spacing for recessed lights in a 20x20 garage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For a 3×3 grid (9 lights) in a 20x20 garage, space fixtures 6 feet 8 inches (6.67 ft) apart from center to center. Set the perimeter rows exactly half that distance (3 feet 4 inches) from each wall. This geometry keeps lights safely inside the garage door track rails and illuminates both side walking corridors and the central vehicle aisle."
      }
    },
    {
      "@type": "Question",
      "name": "How many lumens do I need for a 2-car garage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A typical 400 to 500 sq ft 2-car garage requires 8,000 to 12,000 total lumens for general parking and storage (20 foot-candles). For active DIY automotive work or woodworking, aim for 20,000 to 25,000 total lumens (50 foot-candles)."
      }
    },
    {
      "@type": "Question",
      "name": "Should I use 4-inch or 6-inch recessed wafer LEDs in a garage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "6-inch ultra-thin wafer LEDs are strongly recommended for garages. They feature wide 110° to 120° beam spreads and produce 1,000 to 1,200 lumens per unit. 4-inch fixtures have narrower beam angles that create harsh shadows and scalloping on high garage walls."
      }
    },
    {
      "@type": "Question",
      "name": "How do garage door tracks and openers affect recessed light placement?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When an overhead garage door is raised, it blocks any ceiling fixture directly beneath it. Run your fixture rows parallel to the vehicle bays, placing one row between the garage door horizontal tracks and the side wall, and a center row between the two tracks (in front of or behind the opener motor)."
      }
    },
    {
      "@type": "Question",
      "name": "How many LED recessed lights can I put on one 15-amp breaker?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under NEC Article 210, a standard 15-amp 120V residential circuit supports up to 1,440 watts continuously (80% rule). Modern 6-inch 1,000-lumen LED wafer fixtures consume only 12 to 15 watts each. You could theoretically place over 90 LED wafer lights on a single 15-amp circuit without exceeding code limits."
      }
    }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Recessed Lighting Calculator — Garage", "item": "https://calcfordiy.com/calculators/recessed-lights-garage" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators/" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Recessed Lighting Calculator — Garage</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Recessed Lighting Calculator — Garage & Workshop</h1>
    <p class="text-gray-600 text-lg">Calculate exactly how many recessed lights you need for a 20x20 garage, 2-car workshop, or custom space. Get instant fixture counts, IES foot-candle verification, and ceiling grid spacing guides.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">

    <!-- Quick Dimension Presets -->
    <div class="mb-5 p-3.5 bg-blue-50/70 border border-blue-200 rounded-xl">
      <span class="text-xs font-bold uppercase tracking-wider text-blue-900 block mb-2">⚡ Quick Garage Size Presets (Click to Load):</span>
      <div class="flex flex-wrap gap-2" id="presetButtons">
        <button type="button" onclick="setGaragePreset(12, 24, 9, this)" class="text-xs bg-white hover:bg-blue-600 hover:text-white border border-blue-200 px-3 py-1.5 rounded-lg font-medium text-gray-700 transition-colors shadow-2xs">🚗 1-Car (12' × 24')</button>
        <button type="button" onclick="setGaragePreset(20, 20, 9, this)" class="text-xs bg-blue-600 text-white border border-blue-600 px-3 py-1.5 rounded-lg font-semibold transition-colors shadow-2xs">🚗🚗 Standard 2-Car (20' × 20')</button>
        <button type="button" onclick="setGaragePreset(24, 24, 9, this)" class="text-xs bg-white hover:bg-blue-600 hover:text-white border border-blue-200 px-3 py-1.5 rounded-lg font-medium text-gray-700 transition-colors shadow-2xs">🚗🚗 Workshop 2-Car (24' × 24')</button>
        <button type="button" onclick="setGaragePreset(24, 30, 10, this)" class="text-xs bg-white hover:bg-blue-600 hover:text-white border border-blue-200 px-3 py-1.5 rounded-lg font-medium text-gray-700 transition-colors shadow-2xs">🚗🚗 Deep / Truck (24' × 30')</button>
        <button type="button" onclick="setGaragePreset(32, 24, 9, this)" class="text-xs bg-white hover:bg-blue-600 hover:text-white border border-blue-200 px-3 py-1.5 rounded-lg font-medium text-gray-700 transition-colors shadow-2xs">🚗🚗🚗 3-Car Garage (32' × 24')</button>
      </div>
    </div>

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
      Garage Dimensions
    </h2>

    <div class="p-4 bg-gray-50 rounded-lg mb-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <label for="g_len_ft" class="block text-xs text-gray-500 mb-1">Garage Length (Depth)</label>
          <div class="flex items-center gap-2">
            <input type="number" id="g_len_ft" value="20" placeholder="20" min="0" max="200" inputmode="decimal"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-semibold" />
            <span class="text-xs text-gray-500 shrink-0 font-medium">ft</span>
            <input type="number" id="g_len_in" value="0" placeholder="0" min="0" max="11" inputmode="decimal"
              class="w-16 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="G Len Inches" />
            <span class="text-xs text-gray-500 shrink-0">in</span>
          </div>
        </div>
        <div>
          <label for="g_wid_ft" class="block text-xs text-gray-500 mb-1">Garage Width</label>
          <div class="flex items-center gap-2">
            <input type="number" id="g_wid_ft" value="20" placeholder="20" min="0" max="200" inputmode="decimal"
              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-semibold" />
            <span class="text-xs text-gray-500 shrink-0 font-medium">ft</span>
            <input type="number" id="g_wid_in" value="0" placeholder="0" min="0" max="11" inputmode="decimal"
              class="w-16 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="G Wid Inches" />
            <span class="text-xs text-gray-500 shrink-0">in</span>
          </div>
        </div>
      </div>

      <div>
        <label for="g_ceil_ft" class="block text-xs text-gray-500 mb-1">Ceiling Height</label>
        <div class="flex items-center gap-2">
          <input type="number" id="g_ceil_ft" value="9" placeholder="9" min="6" max="20" inputmode="decimal"
            class="w-32 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-semibold" />
          <span class="text-xs text-gray-500 shrink-0 font-medium">ft</span>
          <input type="number" id="g_ceil_in" value="0" placeholder="0" min="0" max="11" inputmode="decimal"
            class="w-16 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="G Ceil Inches" />
          <span class="text-xs text-gray-500 shrink-0">in</span>
        </div>
        <p class="text-xs text-gray-400 mt-1">Standard residential drywall garage ceilings are typically 8 to 10 feet high.</p>
      </div>
    </div>

    <hr class="my-5 border-gray-200" />

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">2</span>
      Lighting Standards & Fixture Specifications
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
      <div>
        <label for="purpose" class="block text-sm font-medium text-gray-700 mb-2">Target Foot-Candles (FC) & Usage</label>
        <select id="purpose"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="20">20 FC — General Parking & Vehicle Storage (IES RP-7 Standard)</option>
          <option value="30" selected>30 FC — Active Garage & Clean Ambient (Recommended All-Around)</option>
          <option value="50">50 FC — Workshop & Auto Detailing (High Acuity)</option>
          <option value="75">75 FC — Precision Woodworking & Mechanics (Ultra-Bright Task Plane)</option>
        </select>
        <p class="text-xs text-gray-500 mt-1">Based on Illuminating Engineering Society (IES LP-2) residential guidelines.</p>
      </div>
      <div>
        <label for="lumens" class="block text-sm font-medium text-gray-700 mb-2">Fixture Lumen Output</label>
        <select id="lumens"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="650">650 lm — 4"/6" Can, Basic LED</option>
          <option value="750">750 lm — 6" Standard Recessed Can</option>
          <option value="1000" selected>1000 lm — 6" Canless Wafer LED (Top DIY Choice)</option>
          <option value="1200">1200 lm — 6" Ultra-Bright Wafer LED</option>
          <option value="1500">1500 lm — Commercial Grade High-Output</option>
          <option value="2000">2000 lm — Surface Mount Round High-Bay</option>
        </select>
        <p class="text-xs text-gray-500 mt-1">Canless 6" wafer LEDs (1000 lm, 12-14W) are the gold standard for finished garages.</p>
      </div>
    </div>

    <button onclick="calculate()"
      class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-base shadow-sm">
      Calculate Garage Lights & Spacing Grid →
    </button>

  </div>

  <div id="errorMsg" class="hidden bg-red-50 border border-red-200 rounded-lg p-4 mb-6 text-red-700 text-sm">
    Please enter your garage length and width to calculate.
  </div>

  <!-- Results Card -->
  <div id="results" class="hidden bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-200 rounded-xl p-6 mb-8 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-blue-900">Your Garage Lighting Layout Plan</h2>
      <span class="text-xs bg-blue-200 text-blue-800 font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider">IES LP-2 Standard</span>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-gray-900" id="r_area">—</div>
        <div class="text-xs text-gray-500 mt-1">Garage Floor Area</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-blue-700" id="r_target">—</div>
        <div class="text-xs text-gray-500 mt-1">Target Foot-Candles</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border-2 border-green-500">
        <div class="text-3xl font-extrabold text-green-700" id="r_fixtures">—</div>
        <div class="text-xs font-semibold text-green-800 mt-1 uppercase">Fixtures Recommended</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-gray-900" id="r_spacing">—</div>
        <div class="text-xs text-gray-500 mt-1">Center-to-Center Spacing</div>
      </div>
    </div>

    <!-- Ceiling Grid & Spacing Card -->
    <div class="bg-white rounded-lg p-4 shadow-sm border border-blue-100 mb-4">
      <h3 class="text-sm font-bold text-gray-800 mb-2">Recommended Ceiling Grid Spacing</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center sm:text-left mb-3">
        <div class="p-2.5 bg-gray-50 rounded-lg">
          <span class="text-xs text-gray-500 block">Grid Configuration:</span>
          <span class="text-base font-bold text-blue-900" id="r_grid_config">—</span>
          <span class="text-xs text-gray-400 block" id="r_grid_total">—</span>
        </div>
        <div class="p-2.5 bg-gray-50 rounded-lg">
          <span class="text-xs text-gray-500 block">Perimeter Wall Setback:</span>
          <span class="text-base font-bold text-indigo-700" id="r_wall_offset">—</span>
          <span class="text-xs text-gray-400 block">Distance to first row (Spacing ÷ 2)</span>
        </div>
        <div class="p-2.5 bg-gray-50 rounded-lg">
          <span class="text-xs text-gray-500 block">Total Lumens & Circuit Load:</span>
          <span class="text-base font-bold text-gray-900" id="r_total_lumens">—</span>
          <span class="text-xs text-gray-400 block" id="r_wattage">—</span>
        </div>
      </div>
      <p class="text-xs text-gray-600" id="r_layout_desc">—</p>
    </div>

    <!-- Garage Door Opener Warning -->
    <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-xs text-amber-900 flex items-start gap-2 mb-3">
      <span class="text-base">⚠️</span>
      <div>
        <strong>Garage Door Track Clearance:</strong> Horizontal overhead door tracks typically run 18 to 24 inches from side walls. Ensure your outer fixture rows are offset far enough from the wall (or placed between the track and the wall) so that an open overhead door will not obscure the light beam.
      </div>
    </div>

    <button id="printBtn" onclick="window.print()" class="hidden mt-4 w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-6 rounded-lg transition-colors print:hidden text-base flex justify-center items-center gap-2 shadow-sm">
      🖨️ Print or Save Lighting Layout Plan as PDF
    </button>
  </div>

  <!-- Deep-Dive Section: 20x20 Garage Layout Guide -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-3">How Many Garage Lights for a 20x20 Space? (Complete Guide)</h2>
    <p class="text-gray-700 mb-4">
      A standard 2-car garage measures exactly <strong>20 feet by 20 feet (400 square feet)</strong>. The exact fixture count depends entirely on whether the garage is used strictly for parking vehicles or as an active workshop and home gym:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
      <div class="border border-blue-200 rounded-xl p-4 bg-blue-50/50">
        <div class="flex items-center justify-between mb-2">
          <span class="font-bold text-blue-950 text-base">Option 1: The 6-Light Grid (2×3)</span>
          <span class="text-xs font-semibold bg-blue-200 text-blue-900 px-2 py-0.5 rounded">20–25 Foot-Candles</span>
        </div>
        <p class="text-xs text-gray-600 mb-2"><strong>Best For:</strong> Clean parking, unloading groceries, storage shelves, and basic lawn care equipment.</p>
        <ul class="text-xs text-gray-700 space-y-1 list-disc pl-4">
          <li><strong>Fixtures:</strong> 6 × 1,000-lumen 6" LED wafers (6,000 total lumens).</li>
          <li><strong>Grid:</strong> 2 rows of 3 fixtures along the length of the garage.</li>
          <li><strong>Spacing:</strong> Rows spaced 10 ft apart (5 ft from side walls). Fixtures spaced 6.7 ft apart down each vehicle bay (3.3 ft from front and rear walls).</li>
          <li><strong>Track Benefit:</strong> Leaves the center aisle open for the garage door opener motor and track mechanism.</li>
        </ul>
      </div>

      <div class="border border-indigo-200 rounded-xl p-4 bg-indigo-50/50">
        <div class="flex items-center justify-between mb-2">
          <span class="font-bold text-indigo-950 text-base">Option 2: The 9-Light Symmetrical Grid (3×3)</span>
          <span class="text-xs font-semibold bg-indigo-200 text-indigo-900 px-2 py-0.5 rounded">35–45 Foot-Candles</span>
        </div>
        <p class="text-xs text-gray-600 mb-2"><strong>Best For:</strong> DIY workshops, automotive detailing, fitness gyms, and bench woodworking.</p>
        <ul class="text-xs text-gray-700 space-y-1 list-disc pl-4">
          <li><strong>Fixtures:</strong> 9 × 1,000-lumen 6" LED wafers (9,000 total lumens).</li>
          <li><strong>Grid:</strong> 3 rows of 3 fixtures in a balanced, square pattern.</li>
          <li><strong>Spacing:</strong> Exactly <strong>6 feet 8 inches (6.67 ft)</strong> between fixtures in both directions.</li>
          <li><strong>Wall Setback:</strong> Exactly <strong>3 feet 4 inches (3.33 ft)</strong> from all four perimeter walls.</li>
          <li><strong>Visual Acuity:</strong> Completely eliminates shadows between cars and under open car hoods.</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- How to Use Section -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <p class="text-gray-700 mb-4">Follow these step-by-step instructions to calculate exact fixture counts and spacing for your garage lighting project:</p>
    <ol class="space-y-4 text-gray-700">
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">1</span>
        <span><strong>Choose a preset or enter exact room dimensions.</strong> Click one of the quick presets (such as <em>20x20 Standard 2-Car</em> or <em>24x24 Workshop</em>) or enter your exact finished drywall dimensions with a tape measure.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">2</span>
        <span><strong>Input ceiling height.</strong> Input the vertical distance from finished concrete slab to ceiling drywall. Standard 8 to 10 foot ceilings require a 1:0.75 spacing-to-height ratio; ceilings 12 feet or higher require tighter grids or higher-lumen (1,500 lm) fixtures.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">3</span>
        <span><strong>Select primary purpose and foot-candle target.</strong> Select 20 FC for standard vehicle parking, 30 FC for a clean all-around garage, 50 FC for automotive work and detailing, or 75 FC for precision woodworking.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">4</span>
        <span><strong>Verify fixture lumen output.</strong> Check the packaging of your 6-inch wafer LEDs (most standard units produce 1,000 lumens at 12 to 14 watts).</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">5</span>
        <span><strong>Review spacing grid and perimeter wall setbacks.</strong> Always place the first row of fixtures half the distance of your regular fixture spacing away from the wall to ensure even wall-to-wall light distribution.</span>
      </li>
    </ol>
  </div>

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Licensed Master Electrician & MEP Systems Specialist"
    codeStandard="IES LP-2 Workshop & Garage Task Lighting Standards (20-75 FC) & NEC Article 210"
    lastUpdated="September 2026"
  />

  <!-- The Formula & Engineering Math -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">The Formula & Lighting Science</h2>
    <p class="text-gray-700 mb-4">This calculator utilizes the Lumen Method (Zonal Cavity Method) codified by the Illuminating Engineering Society (IES) for residential and light-commercial utility spaces:</p>
    
    <div class="bg-gray-50 rounded-lg p-4 mb-5 font-mono text-sm text-gray-800 space-y-2 border border-gray-200">
      <p>1. Floor Area (sq ft) = Garage Length (ft) × Garage Width (ft)</p>
      <p>2. Total Delivered Lumens Needed = Floor Area × Target Foot-Candles (FC)</p>
      <p>3. Raw Fixtures = Total Delivered Lumens / (Fixture Lumens × Coefficient of Utilization)</p>
      <p>4. Coefficient of Utilization (CU) = 0.75 (standard white painted drywall ceiling/walls)</p>
      <p>5. Center-to-Center Spacing = Ceiling Height × 0.75 (or Symmetrical Grid Pitch)</p>
      <p>6. Perimeter Wall Setback = Center-to-Center Spacing / 2</p>
    </div>

    <h3 class="text-base font-semibold text-gray-900 mb-2">Foot-Candles vs. Lumens: What's the Difference?</h3>
    <p class="text-gray-700 text-sm mb-3">
      <strong>Lumens</strong> represent the total raw light output produced by the LED chip. 
      <strong>Foot-candles (FC)</strong> represent the intensity of that light once it travels across the room and strikes the garage floor or workbench surface (1 foot-candle = 1 lumen per square foot).
      Because walls, vehicles, and garage door equipment absorb some light, a Coefficient of Utilization (CU = 0.75) is factored into the calculation.
    </p>

    <h3 class="text-base font-semibold text-gray-900 mb-2">Electrical Circuit Loading (NEC Article 210)</h3>
    <p class="text-gray-700 text-sm">
      Modern 6-inch canless wafer LEDs consume approximately 12 to 14 watts each. A 9-fixture installation consumes only ~117 watts total (less than 1.0 Amp on a 120V circuit). You can safely tie this lighting system into an existing 15-amp garage lighting branch circuit without any risk of tripping the breaker.
    </p>
  </div>

  <!-- Garage Lighting Grid Reference Table -->

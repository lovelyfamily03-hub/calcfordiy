<script is:inline>
  function setGaragePreset(len, wid, ceil, btnEl) {
    document.getElementById('g_len_ft').value = len;
    document.getElementById('g_len_in').value = 0;
    document.getElementById('g_wid_ft').value = wid;
    document.getElementById('g_wid_in').value = 0;
    document.getElementById('g_ceil_ft').value = ceil;
    document.getElementById('g_ceil_in').value = 0;

    var buttons = document.querySelectorAll('#presetButtons button');
    buttons.forEach(function(b) {
      b.className = 'text-xs bg-white hover:bg-blue-600 hover:text-white border border-blue-200 px-3 py-1.5 rounded-lg font-medium text-gray-700 transition-colors shadow-2xs';
    });
    if (btnEl) {
      btnEl.className = 'text-xs bg-blue-600 text-white border border-blue-600 px-3 py-1.5 rounded-lg font-semibold transition-colors shadow-2xs';
    }
    calculate();
  }

  function getNum(id) {
    return parseFloat(document.getElementById(id).value) || 0;
  }

  function toFt(ftId, inId) {
    return getNum(ftId) + getNum(inId) / 12;
  }

  function calculate() {
    var len = toFt('g_len_ft', 'g_len_in');
    var wid = toFt('g_wid_ft', 'g_wid_in');
    var ceilHeight = toFt('g_ceil_ft', 'g_ceil_in');

    var errorMsg = document.getElementById('errorMsg');
    var resultsEl = document.getElementById('results');

    errorMsg.classList.add('hidden');

    if (len <= 0 || wid <= 0) {
      resultsEl.classList.add('hidden');
      if (len > 0 || wid > 0) errorMsg.classList.remove('hidden');
      return;
    }

    var area = len * wid;
    var targetFC = parseInt(document.getElementById('purpose').value) || 30;
    var lumensPerFixture = parseInt(document.getElementById('lumens').value) || 1000;

    // IES Lumen formula: fixtures = (area x FC) / (lumens x CU)
    // CU = 0.75 for residential garage with painted ceiling/walls
    var cu = 0.75;
    var effectiveLumensPerFixture = lumensPerFixture * cu;
    var rawFixturesNeeded = (area * targetFC) / effectiveLumensPerFixture;
    var fixturesNeeded = Math.max(2, Math.ceil(rawFixturesNeeded));

    // Calculate symmetrical or balanced grid layout
    var cols = Math.round(Math.sqrt(fixturesNeeded * (len / wid)));
    cols = Math.max(1, cols);
    var rows = Math.ceil(fixturesNeeded / cols);
    rows = Math.max(1, rows);
    cols = Math.ceil(fixturesNeeded / rows);

    var actualTotalFixtures = rows * cols;

    // Suggested spacing:
    // Along length: len / cols, along width: wid / rows
    var spacingLen = len / cols;
    var spacingWid = wid / rows;
    var avgSpacing = (spacingLen + spacingWid) / 2;
    var wallOffsetLen = spacingLen / 2;
    var wallOffsetWid = spacingWid / 2;

    var totalDeliveredLumens = actualTotalFixtures * lumensPerFixture;
    var totalWattage = actualTotalFixtures * 13; // ~13W per 1000lm LED

    resultsEl.classList.remove('hidden');
    document.getElementById('printBtn').classList.remove('hidden');
    document.getElementById('r_area').textContent = area.toFixed(0) + ' sq ft';
    document.getElementById('r_target').textContent = targetFC + ' FC';
    document.getElementById('r_fixtures').textContent = actualTotalFixtures + ' fixtures';
    document.getElementById('r_spacing').textContent = avgSpacing.toFixed(1) + ' ft';

    document.getElementById('r_grid_config').textContent = rows + ' rows × ' + cols + ' columns';
    document.getElementById('r_grid_total').textContent = '(' + actualTotalFixtures + ' total fixtures in grid)';
    document.getElementById('r_wall_offset').textContent = wallOffsetWid.toFixed(1) + ' ft × ' + wallOffsetLen.toFixed(1) + ' ft';
    document.getElementById('r_total_lumens').textContent = totalDeliveredLumens.toLocaleString() + ' lm';
    document.getElementById('r_wattage').textContent = '~' + totalWattage + ' Watts (' + (totalWattage / 120).toFixed(1) + 'A)';

    var layoutDesc = 'Mount ' + rows + ' rows running across the garage width with ' + cols + ' lights per row. ' +
      'Space fixtures ' + spacingLen.toFixed(1) + ' ft apart along the depth (starting ' + wallOffsetLen.toFixed(1) + ' ft from front/back walls) and ' +
      spacingWid.toFixed(1) + ' ft apart across the width (starting ' + wallOffsetWid.toFixed(1) + ' ft from side walls).';

    document.getElementById('r_layout_desc').textContent = layoutDesc;
  }

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('input[type="number"]').forEach(function (el) {
      el.addEventListener('input', calculate);
    });
    document.getElementById('purpose').addEventListener('change', calculate);
    document.getElementById('lumens').addEventListener('change', calculate);
    // Initial run
    calculate();
  });
</script>


---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Roof Pitch & Rafter Cut Calculator — Rise, Run & Bird's Mouth Notch | CalcForDIY"
  description="Calculate roof rafter length, slope pitch angle, plumb cut angle, overhang, and bird's mouth notch dimensions with an interactive SVG rafter diagram."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Roof Pitch and Rafter Cut Calculator",
    "description": "Free roof pitch and rafter calculator that estimates rafter length, pitch angle, plumb cut, overhang, and bird's mouth notch cuts with a visual SVG rafter diagram.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is roof pitch expressed as?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Roof pitch is expressed as inches of vertical rise per 12 inches of horizontal run (e.g., 4/12 pitch means 4 inches of rise for every 12 inches of horizontal run). A 4/12 to 9/12 pitch is common for residential roofs."
        }
      },
      {
        "@type": "Question",
        "name": "How do you calculate rafter length?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rafter length is calculated using the Pythagorean theorem: Rafter Length = √(Rise² + Run²) + Overhang Length. For example, a 6-foot run and 4-foot rise gives a hypotenuse of 7.21 feet before adding overhang."
        }
      },
      {
        "@type": "Question",
        "name": "What is a bird's mouth notch on a rafter?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A bird's mouth is a triangular cutout made on the bottom of a rafter where it rests flat on top of the wall top plate. It consists of a seat cut (horizontal) and a plumb cut (vertical). The depth of the seat cut should never exceed 1/3 of the rafter depth."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Roof Pitch & Rafter Calculator", "item": "https://calcfordiy.com/calculators/roof-pitch-rafter" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Roof Pitch &amp; Rafter Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Roof Pitch &amp; Rafter Cut Calculator</h1>
    <p class="text-gray-600 text-lg">Calculate exact rafter length, slope angle, plumb cut, overhang, and bird's mouth seat notch dimensions with an interactive visual SVG rafter diagram.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">1</span>
      Roof Span &amp; Pitch Dimensions
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-5 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Building Span or Run (Feet)</label>
        <div class="flex items-center gap-2">
          <input type="number" id="runFt" placeholder="12" value="12" min="1" max="100" step="0.5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
          <span class="text-xs text-gray-500 shrink-0">ft</span>
        </div>
        <p class="text-xs text-gray-400 mt-1">Horizontal run from wall to ridge (half total span)</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Roof Pitch (X / 12)</label>
        <select id="pitch" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="2">2 / 12 pitch (9.46°)</option>
          <option value="3">3 / 12 pitch (14.04°)</option>
          <option value="4">4 / 12 pitch (18.43°)</option>
          <option value="5">5 / 12 pitch (22.62°)</option>
          <option value="6" selected>6 / 12 pitch (26.57° — standard)</option>
          <option value="7">7 / 12 pitch (30.26°)</option>
          <option value="8">8 / 12 pitch (33.69°)</option>
          <option value="9">9 / 12 pitch (36.87°)</option>
          <option value="10">10 / 12 pitch (39.81°)</option>
          <option value="12">12 / 12 pitch (45.00° — 45 deg)</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Eave Overhang (Inches)</label>
        <input type="number" id="overhangIn" placeholder="12" value="12" min="0" max="48" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
        <p class="text-xs text-gray-400 mt-1">Horizontal overhang past exterior wall</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Rafter Lumber Size</label>
        <select id="rafterSize" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="5.5" selected>2x6 (5.5" actual depth)</option>
          <option value="7.25">2x8 (7.25" actual depth)</option>
          <option value="9.25">2x10 (9.25" actual depth)</option>
          <option value="11.25">2x12 (11.25" actual depth)</option>
          <option value="3.5">2x4 (3.5" actual depth)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Ridge Board Thickness</label>
        <select id="ridgeThick" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="1.5" selected>2x Dimensional Lumber (1.5" actual)</option>
          <option value="0.75">1x Board / Engineered (0.75" actual)</option>
          <option value="0">No Ridge Board (Rafters meet directly)</option>
        </select>
      </div>
    </div>

    <button id="calcBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-base print:hidden">
      Calculate Rafter Length &amp; Cuts →
    </button>
  </div>

  <div id="results" class="hidden bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 rounded-xl p-6 mb-8 print:bg-white print:border-gray-300 print:from-white print:to-white print:shadow-none">
    <h2 class="text-lg font-semibold text-blue-900 mb-4 print:text-xl print:text-gray-900">Your Rafter Cut Sheet</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border-2 border-blue-400 print:border-gray-300 print:shadow-none md:col-span-2">
        <div class="text-3xl font-black text-blue-700 print:text-gray-900" id="r_totalRafterLen">—</div>
        <div class="text-xs text-blue-800 font-semibold uppercase tracking-wide mt-1">Total Rafter Length (Incl. Overhang)</div>
        <div class="text-xs text-gray-500 mt-0.5" id="r_commonLength">—</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-gray-900 print:text-3xl" id="r_pitchAngle">—</div>
        <div class="text-xs text-gray-500 mt-1">Pitch Angle / Plumb Angle</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-green-700 print:text-3xl print:text-gray-900" id="r_roofRise">—</div>
        <div class="text-xs text-gray-500 mt-1">Total Vertical Rise</div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4">
      <div class="bg-white rounded-lg p-4 shadow-sm">
        <h3 class="text-sm font-semibold text-gray-900 mb-1">Bird's Mouth Notch Dimensions</h3>
        <p class="text-xs text-gray-600" id="r_birdsMouth">—</p>
      </div>
      <div class="bg-white rounded-lg p-4 shadow-sm">
        <h3 class="text-sm font-semibold text-gray-900 mb-1">Recommended Board Purchase</h3>
        <p class="text-xs text-gray-600" id="r_boardPurchase">—</p>
      </div>
    </div>

    <!-- Live SVG Visual Diagram -->
    <div class="bg-white rounded-lg p-4 shadow-sm mb-4 border border-blue-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-3 flex items-center justify-between">
        <span>📐 Rafter Profile &amp; Bird's Mouth Cut Diagram</span>
        <span class="text-xs text-blue-600 font-normal">Auto-scaled Vector Elevation</span>
      </h3>
      <div id="svgContainer" class="w-full overflow-x-auto flex justify-center bg-gray-50 p-2 rounded">
        <!-- SVG rendered dynamically -->
      </div>
    </div>

    <button onclick="window.print()" class="w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-6 rounded-lg transition-colors print:hidden text-base flex justify-center items-center gap-2">
      🖨️ Print Rafter Cut Guide
    </button>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <p class="text-gray-700 mb-4">Follow these steps to layout and cut roof rafters for sheds, garages, or additions:</p>
    <ol class="space-y-4 text-gray-700">
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">1</span>
        <span><strong>Measure Building Run:</strong> Measure horizontal distance from the outside of the wall plate to the center ridge. (Equal to half total building span).</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">2</span>
        <span><strong>Select Roof Pitch:</strong> Choose your roof slope ratio (e.g. 6/12 pitch means 6" of rise for every 12" of run).</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">3</span>
        <span><strong>Set Overhang &amp; Lumber Size:</strong> Enter horizontal eave overhang and rafter size (e.g. 2x6).</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">4</span>
        <span><strong>Mark &amp; Cut Bird's Mouth:</strong> Use the calculated seat cut width and plumb cut angle to mark your framing square on the rafter stock!</span>
      </li>
    </ol>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-5">Frequently Asked Questions</h2>
    <div class="space-y-5">
      <div>
        <h3 class="font-bold text-gray-900 mb-1">What is a bird's mouth notch?</h3>
        <p class="text-gray-600 text-sm">A bird's mouth is a triangular notch cut into the bottom edge of a rafter where it rests on the exterior wall top plate. It consists of a horizontal seat cut (which sits on top of the 2x4/2x6 top plate) and a vertical plumb cut (which fits against the outside edge of the wall).</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">How deep can a bird's mouth notch be cut?</h3>
        <p class="text-gray-600 text-sm">According to International Residential Code (IRC), the vertical notch cut must never exceed 1/3 of the depth of the rafter. For a 2x6 rafter (5.5" actual depth), the maximum vertical cut depth is 1.83 inches.</p>
      </div>
    </div>
  </div>

  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/stair-stringer" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Stair Stringer Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate stair riser and tread notch cuts with live SVG diagram.</div>
      </a>
      <a href="/calculators/wall-framing" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Wall Framing Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate studs and plate linear feet for wall framing.</div>
      </a>
      <a href="/calculators/deck-boards" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Deck Boards Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Estimate deck board counts and joist spacing.</div>
      </a>
    </div>
  </div>

</Layout>

<script is:inline>
  function toFeetInches(totalInches) {
    const feet = Math.floor(totalInches / 12);
    const inches = totalInches % 12;
    const wholeIn = Math.floor(inches);
    const remainder = inches - wholeIn;
    const sixteenths = Math.round(remainder * 16);

    let fracStr = '';
    if (sixteenths === 16) {
      return `${feet}' ${wholeIn + 1}"`;
    } else if (sixteenths > 0) {
      let num = sixteenths;
      let den = 16;
      if (num % 8 === 0) { num /= 8; den /= 8; }
      else if (num % 4 === 0) { num /= 4; den /= 4; }
      else if (num % 2 === 0) { num /= 2; den /= 2; }
      fracStr = ` ${num}/${den}`;
    }

    if (feet === 0) return `${wholeIn}${fracStr}"`;
    return `${feet}' ${wholeIn}${fracStr}"`;
  }

  function calculate() {
    const runFt = parseFloat(document.getElementById('runFt').value);
    const pitchVal = parseFloat(document.getElementById('pitch').value);
    const overhangIn = parseFloat(document.getElementById('overhangIn').value) || 0;
    const rafterDepth = parseFloat(document.getElementById('rafterSize').value);
    const ridgeThick = parseFloat(document.getElementById('ridgeThick').value) || 0;

    if (!runFt || runFt <= 0 || !pitchVal || pitchVal <= 0) return;

    // Adjusted run for ridge board deduction
    const netRunFt = runFt - (ridgeThick / 2 / 12);
    const netRunInches = netRunFt * 12;

    // Pitch angle in radians & degrees
    const angleRad = Math.atan(pitchVal / 12);
    const angleDeg = angleRad * (180 / Math.PI);
    const plumbAngleDeg = 90 - angleDeg;

    // Rise inches
    const netRiseInches = netRunFt * pitchVal;
    const netRiseFt = netRiseInches / 12;

    // Common rafter length (from ridge to wall plate line)
    const commonLengthInches = Math.sqrt((netRunInches * netRunInches) + (netRiseInches * netRiseInches));

    // Overhang rafter length (diagonal)
    const overhangDiagInches = overhangIn / Math.cos(angleRad);

    // Total rafter length
    const totalRafterInches = commonLengthInches + overhangDiagInches;

    // Bird's mouth notch: Standard seat cut width = 3.5 inches (for 2x4 top plate)
    const seatCutInches = 3.5;
    const verticalCutInches = seatCutInches * (pitchVal / 12);
    const maxAllowedCut = rafterDepth / 3;

    // Recommended board size (buy length: 8', 10', 12', 14', 16', 18', 20')
    const totalFtDecimal = totalRafterInches / 12;
    const standardLengths = [8, 10, 12, 14, 16, 18, 20, 24];
    let buyLength = standardLengths.find(l => l >= totalFtDecimal) || Math.ceil(totalFtDecimal);

    document.getElementById('r_totalRafterLen').innerText = toFeetInches(totalRafterInches);
    document.getElementById('r_commonLength').innerText = `(${totalRafterInches.toFixed(2)}" exact diagonal)`;
    document.getElementById('r_pitchAngle').innerText = `${angleDeg.toFixed(1)}° (${plumbAngleDeg.toFixed(1)}° plumb cut)`;
    document.getElementById('r_roofRise').innerText = toFeetInches(netRiseInches);

    document.getElementById('r_birdsMouth').innerText = `Seat Cut (Horizontal): ${seatCutInches}" • Plumb Cut (Vertical): ${verticalCutInches.toFixed(2)}" (Max safe cut: ${maxAllowedCut.toFixed(2)}")`;
    document.getElementById('r_boardPurchase').innerText = `Buy ${buyLength}-foot boards per rafter (${(totalRafterInches/12).toFixed(2)} ft required)`;

    renderSVG(netRunFt, netRiseFt, angleDeg, overhangIn, rafterDepth, seatCutInches, verticalCutInches);

    document.getElementById('results').classList.remove('hidden');
  }

  function renderSVG(runFt, riseFt, pitchDeg, overhangIn, depthIn, seatCutIn, vertCutIn) {
    const container = document.getElementById('svgContainer');
    const svgWidth = 550;
    const svgHeight = 220;
    const marginX = 40;
    const marginY = 30;
    const drawW = svgWidth - (2 * marginX);
    const drawH = svgHeight - (2 * marginY);

    const rad = pitchDeg * (Math.PI / 180);

    // Wall top plate position
    const wallX = marginX + (drawW * 0.3);
    const ridgeX = marginX + drawW - 20;

    const wallY = marginY + drawH - 20;
    const ridgeY = marginY + 20;

    const svgHTML = `
      <svg width="${svgWidth}" height="${svgHeight}" viewBox="0 0 ${svgWidth} ${svgHeight}" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#f1f5f9" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />

        <!-- Exterior Wall Top Plate -->
        <rect x="${wallX - 30}" y="${wallY}" width="30" height="35" fill="#cbd5e1" stroke="#475569" stroke-width="1.5" />
        <text x="${wallX - 15}" y="${wallY + 20}" text-anchor="middle" font-size="8" fill="#475569">WALL</text>

        <!-- Ridge Board Cut -->
        <rect x="${ridgeX}" y="${ridgeY}" width="12" height="45" fill="#94a3b8" stroke="#334155" stroke-width="1.5" />

        <!-- Main Rafter Line -->
        <polygon points="${wallX - 35},${wallY + 18} ${wallX},${wallY} ${ridgeX},${ridgeY} ${ridgeX},${ridgeY + 30} ${wallX},${wallY + 30} ${wallX - 35},${wallY + 40}" fill="#2563eb" fill-opacity="0.85" stroke="#1d4ed8" stroke-width="2" />

        <!-- Bird's Mouth Notch Highlighting -->
        <polygon points="${wallX - 20},${wallY} ${wallX},${wallY} ${wallX},${wallY + 12}" fill="#ef4444" stroke="#dc2626" stroke-width="1.5" />

        <!-- Pitch Slope Triangle Legend -->
        <polygon points="${wallX + 60},${wallY - 30} ${wallX + 110},${wallY - 30} ${wallX + 110},${wallY - 55}" fill="none" stroke="#0f172a" stroke-width="1.5" />
        <text x="${wallX + 85}" y="${wallY - 18}" text-anchor="middle" font-size="9" font-weight="bold" fill="#0f172a">12" RUN</text>
        <text x="${wallX + 122}" y="${wallY - 40}" text-anchor="start" font-size="9" font-weight="bold" fill="#2563eb">${(Math.tan(rad)*12).toFixed(1)}" RISE</text>

        <!-- Dimension Text -->
        <text x="${svgWidth / 2}" y="${svgHeight - 4}" text-anchor="middle" font-size="11" font-weight="bold" fill="#0f172a">
          ${pitchDeg.toFixed(1)}° Slope Angle • Seat Cut: ${seatCutIn}" • Vertical Cut: ${vertCutIn.toFixed(2)}"
        </text>
      </svg>
    `;

    container.innerHTML = svgHTML;
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('calcBtn').addEventListener('click', calculate);
  });
</script>

    <h3 class="text-xl font-bold text-gray-900 mt-6">Step-by-Step Stop Collar Calibration</h3>
    <ol class="list-decimal pl-5 space-y-2">
      <li>
        <strong>Select Combination Bit:</strong> Use an adjustable countersink bit with an integrated split-ring stop collar and non-marring brass or plastic contact bearing.
      </li>
      <li>
        <strong>Set Pilot Depth:</strong> Loosen the setscrew and extend the center pilot drill bit so the exposed length equals the screw length minus the countersink plunge depth.
      </li>
      <li>
        <strong>Set Collar Plunge Depth:</strong> Measure the total calculated plunge depth (countersink + counterbore) from the bit shoulder to the stop collar face using a digital dial caliper.
      </li>
      <li>
        <strong>Perform Test Bore in Scrap:</strong> Always drill a test hole in an offcut of the identical workpiece species. Drive the screw to verify the head rests exactly dead flush without mushrooming wood fibers.
      </li>
    </ol>
  </div>

  <script is:inline>
  (function() {
    var presets = {
      us_4: { head: 0.225, angle: 82, pilotSoft: 0.0625, pilotHard: 0.0781, clearance: 0.128 },
      us_6: { head: 0.279, angle: 82, pilotSoft: 0.0781, pilotHard: 0.0938, clearance: 0.149 },
      us_8: { head: 0.332, angle: 82, pilotSoft: 0.0938, pilotHard: 0.1094, clearance: 0.177 },
      us_10: { head: 0.385, angle: 82, pilotSoft: 0.1094, pilotHard: 0.1250, clearance: 0.201 },
      us_12: { head: 0.438, angle: 82, pilotSoft: 0.1250, pilotHard: 0.1406, clearance: 0.228 },
      us_14: { head: 0.491, angle: 82, pilotSoft: 0.1406, pilotHard: 0.1562, clearance: 0.257 },
      us_250: { head: 0.531, angle: 82, pilotSoft: 0.1562, pilotHard: 0.1719, clearance: 0.266 },
      m3: { head: 0.236, angle: 90, pilotSoft: 0.0708, pilotHard: 0.0866, clearance: 0.134 },
      m4: { head: 0.315, angle: 90, pilotSoft: 0.0945, pilotHard: 0.1102, clearance: 0.177 },
      m5: { head: 0.394, angle: 90, pilotSoft: 0.1181, pilotHard: 0.1378, clearance: 0.216 },
      m6: { head: 0.472, angle: 90, pilotSoft: 0.1496, pilotHard: 0.1772, clearance: 0.260 }
    };

    function toFractionStr(val) {
      var fractions = [
        { f: 1/64, s: '1/64"' }, { f: 1/32, s: '1/32"' }, { f: 3/64, s: '3/64"' },
        { f: 1/16, s: '1/16"' }, { f: 5/64, s: '5/64"' }, { f: 3/32, s: '3/32"' },
        { f: 7/64, s: '7/64"' }, { f: 1/8, s: '1/8"' },   { f: 9/64, s: '9/64"' },
        { f: 5/32, s: '5/32"' }, { f: 11/64, s: '11/64"' }, { f: 3/16, s: '3/16"' },
        { f: 13/64, s: '13/64"' }, { f: 7/32, s: '7/32"' }, { f: 15/64, s: '15/64"' },
        { f: 1/4, s: '1/4"' },   { f: 17/64, s: '17/64"' }, { f: 9/32, s: '9/32"' },
        { f: 5/16, s: '5/16"' }, { f: 11/32, s: '11/32"' }, { f: 3/8, s: '3/8"' },
        { f: 1/2, s: '1/2"' }
      ];
      var closest = fractions[0];
      var minDiff = 999;
      for (var i = 0; i < fractions.length; i++) {
        var diff = Math.abs(val - fractions[i].f);
        if (diff < minDiff) {
          minDiff = diff;
          closest = fractions[i];
        }
      }
      return closest.s;
    }

    function onPresetChange() {
      var presetKey = document.getElementById('screwPreset').value;
      if (presetKey === 'custom') return;
      var p = presets[presetKey];
      if (!p) return;

      document.getElementById('cskAngle').value = p.angle.toString();
      document.getElementById('headDiameter').value = p.head.toFixed(3);

      var wood = document.getElementById('woodType').value;
      var pilot = (wood === 'hardwood') ? p.pilotHard : p.pilotSoft;
      document.getElementById('pilotDiameter').value = pilot.toFixed(3);
      document.getElementById('pilotFracText').textContent = toFractionStr(pilot) + ' bit';
      calc();
    }

    function calc() {
      var D = parseFloat(document.getElementById('headDiameter').value) || 0.332;
      var d = parseFloat(document.getElementById('pilotDiameter').value) || 0.094;
      var angle = parseFloat(document.getElementById('cskAngle').value) || 82;
      var fit = document.getElementById('fitTolerance').value;
      var plugDepth = parseFloat(document.getElementById('counterboreDepth').value) || 0;
      var holes = parseInt(document.getElementById('holeCount').value) || 60;
      var wood = document.getElementById('woodType').value;

      // Fit adjustment to D
      var effectiveD = D;
      if (fit === 'recess_subtle') effectiveD += 0.015;
      else if (fit === 'generous') effectiveD += 0.031;

      // Ensure D > d
      if (effectiveD <= d) effectiveD = d + 0.02;

      // Half angle in radians
      var halfRad = (angle / 2) * (Math.PI / 180);
      var cskH = (effectiveD - d) / (2 * Math.tan(halfRad));
      if (cskH < 0) cskH = 0;

      var totalDepth = cskH + plugDepth;

      // Clearance hole estimate
      var clearanceVal = D * 0.52;
      var presetKey = document.getElementById('screwPreset').value;
      if (presetKey !== 'custom' && presets[presetKey]) {
        clearanceVal = presets[presetKey].clearance;
      }

      // Update UI outputs
      document.getElementById('r_cskDepth').textContent = cskH.toFixed(3) + '"';
      document.getElementById('r_cskDepthFrac').textContent = '~' + toFractionStr(cskH) + ' (' + (cskH * 25.4).toFixed(1) + ' mm)';
      document.getElementById('r_totalPlunge').textContent = totalDepth.toFixed(3) + '"';
      document.getElementById('r_totalPlungeDetail').textContent = plugDepth > 0 ? (cskH.toFixed(3) + '" csk + ' + plugDepth.toFixed(3) + '" bore') : 'Surface to conical stop';

      document.getElementById('r_pilotBit').textContent = toFractionStr(d);
      document.getElementById('r_pilotBitDec').textContent = d.toFixed(3) + '" (' + (d * 25.4).toFixed(1) + ' mm)';

      document.getElementById('r_clearanceBit').textContent = toFractionStr(clearanceVal);
      document.getElementById('r_clearanceBitDec').textContent = clearanceVal.toFixed(3) + '" clearance';

      document.getElementById('r_targetDia').textContent = effectiveD.toFixed(3) + '" (' + (effectiveD * 25.4).toFixed(1) + ' mm)';
      document.getElementById('r_pilotBore').textContent = d.toFixed(3) + '"';
      document.getElementById('r_toolAngle').textContent = angle + '° included';
      document.getElementById('r_plugDepth').textContent = plugDepth > 0 ? plugDepth.toFixed(3) + '" (' + toFractionStr(plugDepth) + ')' : '0.000" (Flush)';
      document.getElementById('r_totalHoles').textContent = holes + ' holes';

      var plugs = plugDepth > 0 ? Math.ceil(holes * 1.15) : 0;
      document.getElementById('r_plugsNeeded').textContent = plugs > 0 ? (plugs + ' plugs') : 'None (No bore)';

      document.getElementById('r_stopCollarTip').textContent = (1.50 + totalDepth).toFixed(3) + '"';

      drawSvg(effectiveD, d, angle, cskH, plugDepth);
    }

    function drawSvg(D, d, angle, cskH, plugDepth) {
      var svg = document.getElementById('cskSvg');
      if (!svg) return;

      var cx = 270;
      var topY = 40;
      var scale = 260; // pixels per inch

      var cskW = D * scale;
      var pilotW = d * scale;
      var plugH = plugDepth * scale;
      var coneH = cskH * scale;

      var halfCskW = cskW / 2;
      var halfPilotW = pilotW / 2;

      var boreBottomY = topY + plugH;
      var cskBottomY = boreBottomY + coneH;
      var pilotBottomY = cskBottomY + 90;

      var html = `
        <defs>
          <pattern id="woodGrainCsk" width="30" height="30" patternUnits="userSpaceOnUse">
            <rect width="30" height="30" fill="#FEF3C7" />
            <path d="M 0 10 Q 15 8 30 10 M 0 20 Q 15 22 30 20" stroke="#FDE68A" stroke-width="1.5" fill="none" />
          </pattern>
          <marker id="arrowCsk" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#2563EB" />
          </marker>
          <marker id="arrowEmerald" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 10 5 L 0 8.5 z" fill="#059669" />
          </marker>
        </defs>

        <!-- Wood Stock Block -->
        <rect x="50" y="${topY}" width="440" height="170" fill="url(#woodGrainCsk)" stroke="#D97706" stroke-width="2" rx="4" />
        <text x="70" y="${topY + 25}" font-size="11" font-weight="bold" fill="#92400E">Wood Stock Substrate</text>

        <!-- Cutout Void Path -->
        <path d="
          M ${cx - halfCskW} ${topY}
          L ${cx - halfCskW} ${boreBottomY}
          L ${cx - halfPilotW} ${cskBottomY}
          L ${cx - halfPilotW} ${pilotBottomY}
          L ${cx + halfPilotW} ${pilotBottomY}
          L ${cx + halfPilotW} ${cskBottomY}
          L ${cx + halfCskW} ${boreBottomY}
          L ${cx + halfCskW} ${topY}
          Z
        " fill="#F8FAFC" stroke="#334155" stroke-width="2" />

        <!-- Plug Counterbore Zone Highlight (if active) -->
        ${plugDepth > 0 ? `
          <rect x="${cx - halfCskW}" y="${topY}" width="${cskW}" height="${plugH}" fill="#DBEAFE" opacity="0.6" stroke="#2563EB" stroke-dasharray="3,3" />
          <text x="${cx}" y="${topY + plugH / 2 + 4}" text-anchor="middle" font-size="10" font-weight="bold" fill="#1D4ED8">Plug Counterbore (${plugDepth.toFixed(3)}")</text>
        ` : ''}

        <!-- Conical Chamfer Zone -->
        <path d="
          M ${cx - halfCskW} ${boreBottomY}
          L ${cx - halfPilotW} ${cskBottomY}
          L ${cx + halfPilotW} ${cskBottomY}
          L ${cx + halfCskW} ${boreBottomY}
          Z
        " fill="#FEF2F2" opacity="0.5" />

        <!-- Centerline -->
        <line x1="${cx}" y1="${topY - 15}" x2="${cx}" y2="${pilotBottomY + 15}" stroke="#94A3B8" stroke-width="1" stroke-dasharray="4,4" />

        <!-- Screw Outline in Phantom Blue -->
        <path d="
          M ${cx - halfCskW + 3} ${boreBottomY + 2}
          L ${cx + halfCskW - 3} ${boreBottomY + 2}
          L ${cx + halfPilotW - 2} ${cskBottomY + 2}
          L ${cx + halfPilotW - 2} ${cskBottomY + 50}
          L ${cx} ${cskBottomY + 65}
          L ${cx - halfPilotW + 2} ${cskBottomY + 50}
          L ${cx - halfPilotW + 2} ${cskBottomY + 2}
          Z
        " fill="#3B82F6" opacity="0.25" stroke="#1D4ED8" stroke-width="1.5" />

        <!-- Dimension: Major Diameter D -->
        <line x1="${cx - halfCskW}" y1="${topY - 12}" x2="${cx + halfCskW}" y2="${topY - 12}" stroke="#2563EB" stroke-width="1.5" marker-start="url(#arrowCsk)" marker-end="url(#arrowCsk)" />
        <text x="${cx}" y="${topY - 18}" text-anchor="middle" font-size="10" font-weight="bold" fill="#1E40AF">Major Dia D = ${D.toFixed(3)}"</text>

        <!-- Dimension: Pilot Hole d -->
        <line x1="${cx - halfPilotW}" y1="${pilotBottomY + 14}" x2="${cx + halfPilotW}" y2="${pilotBottomY + 14}" stroke="#2563EB" stroke-width="1.5" marker-start="url(#arrowCsk)" marker-end="url(#arrowCsk)" />
        <text x="${cx}" y="${pilotBottomY + 26}" text-anchor="middle" font-size="9" font-weight="bold" fill="#1E40AF">Pilot d = ${d.toFixed(3)}"</text>

        <!-- Dimension: Countersink Plunge Depth (Right Side) -->
        <line x1="${cx + halfCskW + 25}" y1="${boreBottomY}" x2="${cx + halfCskW + 25}" y2="${cskBottomY}" stroke="#059669" stroke-width="1.5" marker-start="url(#arrowEmerald)" marker-end="url(#arrowEmerald)" />
        <text x="${cx + halfCskW + 32}" y="${boreBottomY + coneH / 2 + 4}" font-size="10" font-weight="bold" fill="#047857">h = ${cskH.toFixed(3)}"</text>

        <!-- Angle Annotation -->
        <text x="${cx - halfCskW - 40}" y="${boreBottomY + coneH / 2 + 4}" font-size="11" font-weight="bold" fill="#DC2626">${angle}° Included</text>
      `;

      svg.innerHTML = html;
    }

    document.getElementById('screwPreset').addEventListener('change', onPresetChange);
    document.getElementById('cskAngle').addEventListener('change', calc);
    document.getElementById('headDiameter').addEventListener('input', calc);
    document.getElementById('pilotDiameter').addEventListener('input', calc);
    document.getElementById('woodType').addEventListener('change', onPresetChange);
    document.getElementById('fitTolerance').addEventListener('change', calc);
    document.getElementById('counterboreDepth').addEventListener('change', calc);
    document.getElementById('holeCount').addEventListener('input', calc);
    document.getElementById('calcBtn').addEventListener('click', calc);

    // Initial run
    calc();

    // Copy Schedule Handler
    document.getElementById('copyScheduleBtn').addEventListener('click', function() {
      var cskH = document.getElementById('r_cskDepth').textContent;
      var totalH = document.getElementById('r_totalPlunge').textContent;
      var pilot = document.getElementById('r_pilotBit').textContent;
      var clearance = document.getElementById('r_clearanceBit').textContent;
      var angle = document.getElementById('r_toolAngle').textContent;
      var holes = document.getElementById('r_totalHoles').textContent;

      var text = `=== Fastener Drilling & Countersink Schedule ===
Tool Included Angle: ${angle}
Conical Chamfer Plunge Depth: ${cskH}
Total Stop Collar Plunge Depth: ${totalH}
Pilot Drill Bit Size: ${pilot}
Shank Clearance Drill Bit: ${clearance}
Total Fasteners: ${holes}
Standard: ASME B18.6.1 Woodworking Precision
Generated via CalcForDIY (https://calcfordiy.com/calculators/countersink-depth)`;

      navigator.clipboard.writeText(text).then(function() {
        var btn = document.getElementById('copyScheduleBtn');
        btn.textContent = '✓ Copied Schedule!';
        setTimeout(function() { btn.textContent = '📋 Copy Drill & Fastener Schedule'; }, 2500);
      });
    });
  })();
  </script>


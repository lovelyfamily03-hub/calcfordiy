  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural &amp; Civil Engineering Consultant"
    codeStandard="ASHRAE 90.1, IECC 2024 &amp; ASTM E2357 Standards"
    lastUpdated="September 2026"
  />

  <!-- Deep Editorial & Technical Documentation (800+ Words for AdSense E-E-A-T) -->
  <div class="prose max-w-none text-gray-700 space-y-6 mt-10">
    <h2 class="text-2xl font-bold text-gray-900">Understanding Thermal Bridging &amp; The Cascadia Clip® Solution</h2>
    <p>
      In high-performance exterior wall assemblies, **continuous exterior insulation (ci)** is installed over the structural sheathing and weather-resistive barrier (WRB) to create an unbroken thermal blanket. However, hanging siding, fiber cement panels, or masonry cladding through thick insulation poses a major structural and thermodynamic dilemma:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 not-prose my-4">
      <div class="bg-red-50 border border-red-200 rounded-xl p-4">
        <h3 class="font-bold text-red-950 text-sm mb-1 flex items-center gap-1.5">
          <span>❌</span> The Traditional Metal Z-Girt Problem
        </h3>
        <p class="text-xs text-red-900 leading-relaxed">
          Continuous steel Z-furring or aluminum brackets cut straight through the insulation layer. Because steel has a thermal conductivity of ~50 W/m·K and aluminum is over 200 W/m·K, they act as thermal super-highways. Studies by the <em>Oak Ridge National Laboratory (ORNL)</em> and <em>Building Science Corporation (BSC)</em> prove that metal Z-girts reduce the effective R-value of exterior continuous insulation by **40% to 70%**.
        </p>
      </div>

      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4">
        <h3 class="font-bold text-emerald-950 text-sm mb-1 flex items-center gap-1.5">
          <span>✅</span> The Cascadia Clip® Thermal Spacer Solution
        </h3>
        <p class="text-xs text-emerald-900 leading-relaxed">
          Manufactured from high-strength **pultruded fiberglass-reinforced polymer (FRP)**, Cascadia Clips have a thermal conductivity of just 0.27 W/m·K (over 40× lower than steel and 700× lower than aluminum). They provide point-contact structural support for horizontal or vertical cladding sub-girts while preserving **90% to 95% of your insulation's effective R-value**.
        </p>
      </div>
    </div>

    <h3 class="text-xl font-bold text-gray-900 mt-6">How Cascadia Clip Quantities Are Calculated</h3>
    <p>
      Calculating your exact takeoff requires mapping the framing grid geometry, cladding dead weight (lbs per square foot), and local design wind pressure (psf):
    </p>
    <ol class="list-decimal pl-5 space-y-2">
      <li>
        <strong>Calculate Net Surface Area:</strong>
        <code>Net Area = (Wall Length × Wall Height) - Opening Deductions</code>.
      </li>
      <li>
        <strong>Determine Horizontal Stud Lines:</strong>
        Clips must anchor into structural backup studs. For 16" on-center framing, calculate <code>Horizontal Lines = ceil(Wall Length / 1.33 ft) + 1</code>.
      </li>
      <li>
        <strong>Determine Vertical Clip Pitch:</strong>
        Based on cladding dead weight:
        <ul class="list-disc pl-5 mt-1 text-sm">
          <li><strong>Lightweight Cladding (&lt; 4 psf):</strong> 36" to 48" vertical clip spacing.</li>
          <li><strong>Medium Cladding (4 to 8 psf):</strong> 24" to 32" vertical clip spacing.</li>
          <li><strong>Heavy Cladding (&gt; 8 psf):</strong> 16" to 24" vertical clip spacing.</li>
        </ul>
      </li>
      <li>
        <strong>Add Safety Factor:</strong>
        Multiply raw clip count by 1.10 (10% jobsite waste buffer for corners, jambs, and parapet edges).
      </li>
    </ol>

    <h3 class="text-xl font-bold text-gray-900 mt-6">Building Code Reference Table (IECC 2021/2024 &amp; ASHRAE 90.1)</h3>
    <div class="overflow-x-auto not-prose my-4">
      <table class="w-full text-left border-collapse border border-gray-200 text-xs">
        <thead>
          <tr class="bg-gray-100 border-b border-gray-200">
            <th class="p-2.5 font-bold text-gray-900">Climate Zone</th>
            <th class="p-2.5 font-bold text-gray-900">IECC 2024 Wood Frame Rule</th>
            <th class="p-2.5 font-bold text-gray-900">Recommended ci Depth</th>
            <th class="p-2.5 font-bold text-gray-900">Cascadia Clip Size</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <tr>
            <td class="p-2.5 font-semibold">Zone 3 (South / Moderate)</td>
            <td class="p-2.5">R-20 Cavity or R-13 + R-5 ci</td>
            <td class="p-2.5">1.5" to 2.0"</td>
            <td class="p-2.5 font-mono">2.0" Clip Standoff</td>
          </tr>
          <tr>
            <td class="p-2.5 font-semibold">Zone 4 &amp; 5 (Mid-Atlantic / Midwest)</td>
            <td class="p-2.5">R-20 + R-5 ci or R-13 + R-10 ci</td>
            <td class="p-2.5">2.5" to 3.0"</td>
            <td class="p-2.5 font-mono">3.0" Clip Standoff</td>
          </tr>
          <tr>
            <td class="p-2.5 font-semibold">Zone 6 (Northern US / Canada)</td>
            <td class="p-2.5">R-20 + R-8 ci or R-13 + R-12 ci</td>
            <td class="p-2.5">3.5" to 4.0"</td>
            <td class="p-2.5 font-mono">4.0" Clip Standoff</td>
          </tr>
          <tr>
            <td class="p-2.5 font-semibold">Zone 7 &amp; 8 (Extreme Cold / Passive House)</td>
            <td class="p-2.5">R-20 + R-15 ci or R-0 + R-25 ci</td>
            <td class="p-2.5">5.0" to 6.0"+</td>
            <td class="p-2.5 font-mono">6.0" Clip Standoff</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-xl font-bold text-gray-900 mt-6">Step-by-Step Installation Best Practices</h3>
    <ol class="list-decimal pl-5 space-y-2">
      <li>
        <strong>Weather-Resistive Barrier (WRB):</strong> Install and tape your self-adhered or fluid-applied air barrier over plywood/OSB sheathing prior to mounting clips.
      </li>
      <li>
        <strong>Snap Chalk Lines:</strong> Snap vertical plumb lines directly over framing studs (16" or 24" o.c.) and horizontal lines at your calculated vertical clip pitch.
      </li>
      <li>
        <strong>Fasten Thermal Clips:</strong> Secure each Cascadia Clip using two structural wood screws (minimum 1.5" thread penetration into studs) or heavy-duty self-drilling steel framing screws.
      </li>
      <li>
        <strong>Friction-Fit Continuous Insulation:</strong> Fit rigid mineral wool (e.g. Rockwool CavityRock) or polyiso boards tightly between and around the fiberglass clips.
      </li>
      <li>
        <strong>Attach Sub-Girts:</strong> Fasten 20-gauge galvanized steel hat channels or L-profiles into the clip slot with 2 self-tapping #10 TEK screws per clip.
      </li>
      <li>
        <strong>Install Cladding:</strong> Fasten your siding directly to the sub-girt rails, leaving a 3/8" to 3/4" ventilated drainage air gap behind the cladding.
      </li>
    </ol>
  </div>

  <script is:inline>
  (function() {
    function calc() {
      var len = parseFloat(document.getElementById('wallLength').value) || 0;
      var h = parseFloat(document.getElementById('wallHeight').value) || 0;
      var ded = parseFloat(document.getElementById('deductions').value) || 0;
      var studSpacingIn = parseFloat(document.getElementById('studSpacing').value) || 16;
      var insulDepth = parseFloat(document.getElementById('insulationDepth').value) || 4;
      var insulType = document.getElementById('insulationType').value;
      var vertPitchIn = parseFloat(document.getElementById('claddingWeight').value) || 36;
      var costMult = parseFloat(document.getElementById('costLocation').value) || 1.0;

      var grossArea = len * h;
      var netArea = Math.max(0, grossArea - ded);

      // Grid calculations
      var studSpacingFt = studSpacingIn / 12;
      var vertPitchFt = vertPitchIn / 12;

      var studLines = Math.ceil(len / studSpacingFt) + 1;
      var clipsPerStud = Math.ceil(h / vertPitchFt) + 1;
      var rawClips = studLines * clipsPerStud;

      // Adjust for deductions area ratio
      var areaRatio = grossArea > 0 ? (netArea / grossArea) : 1;
      var estClips = Math.ceil(rawClips * areaRatio * 1.10); // +10% waste/corners
      var totalScrews = estClips * 2;
      var subGirtLF = Math.ceil((studLines * h * areaRatio) * 1.10);
      var subGirtPieces = Math.ceil(subGirtLF / 10);

      // R-value calculations
      var rPerInch = 4.0;
      if (insulType === 'polyiso') rPerInch = 6.0;
      else if (insulType === 'xps') rPerInch = 5.0;
      else if (insulType === 'mineral_wool') rPerInch = 4.2;

      var nomR = insulDepth * rPerInch;
      var effCascadiaR = nomR * 0.925; // 92.5% effective retention
      var effZGirtR = nomR * 0.45;    // 45% retention due to steel bridging

      // Pricing (RSMeans estimates)
      // Cascadia clip ~ $4.80 - $6.50 each
      // Hat channel ~ $1.20 - $1.60 / LF
      // Insulation ~ $1.40 - $2.40 / sq ft
      // Fasteners + misc ~ $200
      var clipCost = estClips * 5.50;
      var girtCost = subGirtLF * 1.40;
      var insulCost = netArea * (insulDepth * 0.45);
      var matCostLow = (clipCost + girtCost + insulCost + 150) * 0.9;
      var matCostHigh = (clipCost + girtCost + insulCost + 250) * 1.15;

      var diyLow = Math.round(matCostLow * costMult);
      var diyHigh = Math.round(matCostHigh * costMult);

      // Turnkey pro installation ($15 - $22 / sq ft net)
      var proLow = Math.round(netArea * 15 * costMult);
      var proHigh = Math.round(netArea * 21 * costMult);
      var savLow = Math.max(0, proLow - diyHigh);
      var savHigh = Math.max(0, proHigh - diyLow);

      // Render Text
      document.getElementById('r_netArea').textContent = netArea.toLocaleString() + ' sq ft';
      document.getElementById('r_clipCount').textContent = estClips.toLocaleString() + ' pcs';
      document.getElementById('r_clipSize').textContent = insulDepth.toFixed(1) + '" Thermal Standoff';
      document.getElementById('r_girtLinearFt').textContent = subGirtLF.toLocaleString() + ' LF';
      document.getElementById('r_girtPieces').textContent = subGirtPieces + ' pcs (10-ft sticks)';
      document.getElementById('r_fasteners').textContent = totalScrews.toLocaleString() + ' pcs';

      document.getElementById('r_nomR').textContent = 'R-' + nomR.toFixed(1);
      document.getElementById('r_effR').textContent = 'R-' + effCascadiaR.toFixed(1) + ' (92.5% Retained)';
      document.getElementById('r_zGirtR').textContent = 'R-' + effZGirtR.toFixed(1) + ' (Only 45% Retained)';

      document.getElementById('c_diy').textContent = '$' + diyLow.toLocaleString() + ' – $' + diyHigh.toLocaleString();
      document.getElementById('c_pro').textContent = '$' + proLow.toLocaleString() + ' – $' + proHigh.toLocaleString();
      document.getElementById('c_savings').textContent = '$' + savLow.toLocaleString() + ' – $' + savHigh.toLocaleString();

      // Render SVG Diagram
      renderSvg(insulDepth);
    }

    function renderSvg(depth) {
      var svg = document.getElementById('wallSvg');
      if (!svg) return;

      var insulW = Math.min(180, Math.max(70, depth * 28));

      var html = `
        <defs>
          <pattern id="woolHatch" width="10" height="10" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
            <line x1="0" y1="0" x2="0" y2="10" stroke="#F59E0B" stroke-width="1.5" />
          </pattern>
        </defs>

        <!-- Stud Wall / Drywall -->
        <rect x="20" y="20" width="30" height="160" fill="#E2E8F0" stroke="#94A3B8" stroke-width="1.5" rx="2" />
        <text x="35" y="105" text-anchor="middle" font-size="9" fill="#475569" font-weight="bold" transform="rotate(-90 35 105)">2x6 Stud Wall</text>

        <!-- Plywood Sheathing + WRB -->
        <rect x="52" y="20" width="12" height="160" fill="#B45309" stroke="#78350F" stroke-width="1.5" />
        <line x1="65" y1="20" x2="65" y2="180" stroke="#2563EB" stroke-width="3" stroke-dasharray="3,3" />
        <text x="60" y="15" text-anchor="middle" font-size="8" fill="#2563EB" font-weight="bold">WRB</text>

        <!-- Continuous Rigid Insulation Layer -->
        <rect x="66" y="25" width="${insulW}" height="150" fill="url(#woolHatch)" opacity="0.6" stroke="#D97706" stroke-width="1" />
        <text x="${66 + insulW / 2}" y="105" text-anchor="middle" font-size="10" font-weight="bold" fill="#B45309">${depth.toFixed(1)}" Continuous Insulation</text>

        <!-- Cascadia Fiberglass Clip (Top) -->
        <path d="M 66 45 L ${66 + insulW} 45 L ${66 + insulW + 8} 52 L ${66 + insulW} 60 L 66 60 Z" fill="#047857" stroke="#064E3B" stroke-width="1.5" />
        <circle cx="72" cy="52.5" r="2.5" fill="#FFFFFF" stroke="#064E3B" stroke-width="1" />

        <!-- Cascadia Fiberglass Clip (Bottom) -->
        <path d="M 66 135 L ${66 + insulW} 135 L ${66 + insulW + 8} 142 L ${66 + insulW} 150 L 66 150 Z" fill="#047857" stroke="#064E3B" stroke-width="1.5" />
        <circle cx="72" cy="142.5" r="2.5" fill="#FFFFFF" stroke="#064E3B" stroke-width="1" />

        <text x="${66 + insulW / 2}" y="40" text-anchor="middle" font-size="8" font-weight="bold" fill="#047857">Cascadia Clip® (Fiberglass FRP)</text>

        <!-- Galvanized Hat Channel Sub-Girt -->
        <rect x="${66 + insulW + 4}" y="20" width="10" height="160" fill="#94A3B8" stroke="#475569" stroke-width="1.5" />
        <text x="${66 + insulW + 9}" y="105" text-anchor="middle" font-size="8" fill="#1E293B" font-weight="bold" transform="rotate(-90 ${66 + insulW + 9} 105)">Hat Channel</text>

        <!-- Air Gap (Rainscreen) -->
        <rect x="${66 + insulW + 15}" y="20" width="10" height="160" fill="#E0F2FE" opacity="0.7" />
        <text x="${66 + insulW + 20}" y="15" text-anchor="middle" font-size="7" fill="#0284C7" font-weight="bold">Air Gap</text>

        <!-- Exterior Cladding (Fiber Cement / Metal Panel) -->
        <rect x="${66 + insulW + 26}" y="15" width="14" height="170" fill="#475569" stroke="#1E293B" stroke-width="2" rx="1" />
        <text x="${66 + insulW + 33}" y="105" text-anchor="middle" font-size="9" fill="#F8FAFC" font-weight="bold" transform="rotate(-90 ${66 + insulW + 33} 105)">Cladding / Siding</text>
      `;

      svg.innerHTML = html;
    }

    document.getElementById('calcBtn').addEventListener('click', calc);
    document.getElementById('wallLength').addEventListener('input', calc);
    document.getElementById('wallHeight').addEventListener('input', calc);
    document.getElementById('deductions').addEventListener('input', calc);
    document.getElementById('studSpacing').addEventListener('change', calc);
    document.getElementById('insulationDepth').addEventListener('change', calc);
    document.getElementById('insulationType').addEventListener('change', calc);
    document.getElementById('claddingWeight').addEventListener('change', calc);
    document.getElementById('costLocation').addEventListener('change', calc);

    // Initial calculation
    calc();

    // Copy Shopping list handler
    document.getElementById('copyListBtn').addEventListener('click', function() {
      var net = document.getElementById('r_netArea').textContent;
      var clips = document.getElementById('r_clipCount').textContent;
      var size = document.getElementById('r_clipSize').textContent;
      var girt = document.getElementById('r_girtLinearFt').textContent;
      var girtPcs = document.getElementById('r_girtPieces').textContent;
      var screws = document.getElementById('r_fasteners').textContent;

      var text = "=== Cascadia Clip & Continuous Insulation Material List ===\n" +
        "Net Insulation Area: " + net + "\n" +
        "Cascadia Clips: " + clips + " (" + size + ")\n" +
        "Sub-Girt Hat Channels: " + girt + " (" + girtPcs + ")\n" +
        "Structural Base Fasteners: " + screws + " (#12/1/4-in structural screws)\n" +
        "Sub-Girt Screws: ~" + clips + " (Self-drilling TEK screws)\n" +
        "Estimated via CalcForDIY (https://calcfordiy.com/calculators/cascadia-clip-insulation)";

      navigator.clipboard.writeText(text).then(function() {
        var btn = document.getElementById('copyListBtn');
        btn.textContent = '✓ Copied to Clipboard!';
        setTimeout(function() { btn.textContent = '📋 Copy Shopping List'; }, 2500);
      });
    });
  })();
  </script>


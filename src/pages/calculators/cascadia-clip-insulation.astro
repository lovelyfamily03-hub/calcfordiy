---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
---

<Layout
  title="Cascadia Clip & Continuous Insulation Calculator (Thermal Spacer & Rainscreen) | CalcForDIY"
  description="Calculate Cascadia Clip fiberglass thermal spacers, sub-girt hat channels, structural fasteners, and effective assembly R-value for exterior continuous insulation & rainscreen cladding."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Cascadia Clip and Continuous Insulation Calculator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a Cascadia Clip and why is it used instead of metal Z-girts?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The Cascadia Clip is a structural thermal spacer made from pultruded fiberglass (FRP). Traditional steel or aluminum Z-girts create severe thermal bridges that degrade exterior continuous insulation effective R-values by 40% to 70%. Because fiberglass is non-conductive, Cascadia Clips retain over 90% of the nominal insulation R-value, easily meeting strict IECC 2021/2024 and ASHRAE 90.1 energy codes."
        }
      },
      {
        "@type": "Question",
        "name": "How far apart should Cascadia Clips be spaced?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Horizontally, Cascadia Clips are aligned directly over framing studs at 16 inches or 24 inches on center. Vertically, clip spacing depends on cladding dead weight and wind loads: 36 to 48 inches for lightweight siding (fiber cement, vinyl, metal < 4 psf), 24 to 32 inches for medium cladding (composite wood, 4-8 psf), and 16 to 24 inches for heavy cladding (terracotta, architectural panels > 8 psf)."
        }
      },
      {
        "@type": "Question",
        "name": "What fasteners are required to install Cascadia Clips?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Each clip requires two structural base fasteners into wood studs, steel studs, or concrete/CMU backup walls (e.g., #12 or 1/4-inch structural wood screws or concrete anchors), plus self-drilling TEK screws to fasten the galvanized steel or aluminum hat channel sub-girt into the clip flange."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },

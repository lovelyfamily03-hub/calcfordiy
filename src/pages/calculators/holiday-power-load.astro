---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
---

<Layout
  title="Holiday & Halloween Power Load Calculator — Outlet Amps & Cord Safety | CalcForDIY"
  description="Calculate total watts, amperage, and circuit load for Halloween fog machines, inflatables, animatronics, and Christmas lights. Includes extension cord gauge safety."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Holiday & Halloween Power Load Calculator",
    "description": "Free electrical load calculator for outdoor Halloween and Christmas decorations estimating total amperage, breaker capacity %, and recommended extension cord wire gauge.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why does my fog machine trip the outdoor GFCI outlet?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Fog machines draw heavy wattage (400W to 1200W+) while heating their internal element. If plugged into the same outlet as inflatables or incandescent light strings, total amperage can exceed the 15-Amp circuit limit (1,800 Watts), tripping the breaker or GFCI."
        }
      },
      {
        "@type": "Question",
        "name": "What size extension cord do I need for outdoor Halloween inflatables and fog machines?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For loads under 10 Amps running up to 50 feet, a 16-gauge (16 AWG) cord is acceptable. However, for high-wattage equipment like 1,000W fog machines or runs over 50 feet, you should use a heavy-duty 14-gauge or 12-gauge extension cord to prevent voltage drop and dangerous cord overheating."
        }
      },
      {
        "@type": "Question",
        "name": "What is the 80% rule for household electrical circuits?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The National Electrical Code (NEC) specifies that a circuit should not carry a continuous load (anything running longer than 3 hours, like holiday lights) exceeding 80% of its maximum rating. On a standard 15-Amp circuit, your continuous max load should be 12 Amps (1,440 Watts)."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Holiday Power Load Calculator", "item": "https://calcfordiy.com/calculators/holiday-power-load" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Holiday Power Load</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Holiday &amp; Halloween Power Load Calculator</h1>
    <p class="text-gray-600 text-lg">Calculate total watts and amperage for fog machines, inflatables, animatronics, and lights to prevent tripped breakers and extension cord overheating.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">1</span>
      Decorations &amp; Equipment Checklist
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-5 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Fog Machines (Standard 400W–700W)</label>
        <input type="number" id="fog_med" value="1" min="0" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">High-Power Fog Machines (1000W–1200W)</label>
        <input type="number" id="fog_heavy" value="0" min="0" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Inflatables &amp; Blower Fans (50W avg)</label>
        <input type="number" id="inflatables" value="2" min="0" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Animatronics &amp; Motion Props (30W avg)</label>
        <input type="number" id="animatronics" value="1" min="0" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Laser Projectors &amp; Spotlights (20W avg)</label>
        <input type="number" id="projectors" value="2" min="0" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Incandescent Light Strands (40W each)</label>
        <input type="number" id="inc_strands" value="0" min="0" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">LED Light Strands (4W each)</label>
        <input type="number" id="led_strands" value="5" min="0" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Sound FX / Outdoor Speakers (50W avg)</label>
        <input type="number" id="speakers" value="0" min="0" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Custom / Extra Wattage (Watts)</label>
        <input type="number" id="custom_watts" value="0" min="0" step="10" placeholder="e.g. 100" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
    </div>

    <hr class="my-5 border-gray-200 print:hidden" />

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">2</span>
      Circuit &amp; Extension Cord Setup
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Outlet Circuit Rating</label>
        <select id="circuitRating" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="15" selected>15-Amp Circuit (Standard Residential Household Outlet - 1,800W Max)</option>
          <option value="20">20-Amp Circuit (Heavy Duty / Garage / Dedicated Outdoor - 2,400W Max)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Extension Cord Run Length</label>
        <select id="cordLength" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="25">Under 25 Feet</option>
          <option value="50" selected>25 to 50 Feet</option>
          <option value="100">50 to 100 Feet (Voltage Drop Risk)</option>
        </select>
      </div>
    </div>

    <button id="calcBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-base print:hidden">
      Check Electrical Load &amp; Safety →
    </button>
  </div>

  <div id="results" class="hidden bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 rounded-xl p-6 mb-8 print:bg-white print:border-gray-300 print:from-white print:to-white print:shadow-none">
    <h2 class="text-lg font-semibold text-blue-900 mb-4 print:text-xl print:text-gray-900">Electrical Load Analysis</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-gray-900 print:text-3xl" id="r_watts">—</div>
        <div class="text-xs text-gray-500 mt-1">Total Power Draw (Watts)</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-blue-700 print:text-3xl print:text-gray-900" id="r_amps">—</div>
        <div class="text-xs text-gray-500 mt-1">Current Draw (Amps @ 120V)</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none" id="r_capacityBox">
        <div class="text-2xl font-bold print:text-3xl" id="r_capacity">%</div>
        <div class="text-xs text-gray-500 mt-1">Circuit Capacity Used</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-purple-700 print:text-3xl print:text-gray-900" id="r_cordGauge">—</div>
        <div class="text-xs text-gray-500 mt-1">Recommended Extension Cord</div>
      </div>
    </div>

    <div id="statusAlert" class="rounded-lg p-4 mb-4 font-medium text-sm"></div>

    <button onclick="window.print()" class="w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-6 rounded-lg transition-colors print:hidden text-base flex justify-center items-center gap-2">
      🖨️ Print Electrical Safety Summary
    </button>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <p class="text-gray-700 mb-4">Follow these steps to ensure your Halloween and Christmas displays operate safely:</p>
    <ol class="space-y-4 text-gray-700">
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">1</span>
        <span><strong>Enter Equipment Quantities:</strong> Enter the number of fog machines, inflatables, animatronics, projectors, and light strands you plan to plug into your outdoor outlet.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">2</span>
        <span><strong>Select Circuit Rating &amp; Distance:</strong> Choose 15A for standard outlets or 20A for dedicated outdoor breaker circuits. Select your extension cord distance.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">3</span>
        <span><strong>Check Load &amp; Wire Gauge:</strong> Review your circuit capacity percentage. Check the recommended extension cord gauge (16 AWG vs 14 AWG vs 12 AWG) to ensure your cord does not overheat or suffer voltage drop.</span>
      </li>
    </ol>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    
  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Master Electrician & Building Systems Specialist"
    codeStandard="NEC NFPA 70 & Uniform Plumbing/Mechanical Code"
    lastUpdated="September 2026"
  />

  <h2 class="text-xl font-semibold text-gray-900 mb-5">Frequently Asked Questions</h2>
    <div class="space-y-5">
      <div>
        <h3 class="font-bold text-gray-900 mb-1">Why does my fog machine trip the outdoor GFCI outlet?</h3>
        <p class="text-gray-600 text-sm">Fog machines draw heavy wattage (400W to 1200W+) while heating their internal element. If plugged into the same outlet as inflatables or incandescent light strings, total amperage can exceed the 15-Amp circuit limit (1,800 Watts), tripping the breaker or GFCI.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">What size extension cord do I need for outdoor Halloween inflatables and fog machines?</h3>
        <p class="text-gray-600 text-sm">For loads under 10 Amps running up to 50 feet, a 16-gauge (16 AWG) cord is acceptable. However, for high-wattage equipment like 1,000W fog machines or runs over 50 feet, you should use a heavy-duty 14-gauge or 12-gauge extension cord to prevent voltage drop and dangerous cord overheating.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">What is the 80% rule for household electrical circuits?</h3>
        <p class="text-gray-600 text-sm">The National Electrical Code (NEC) specifies that a circuit should not carry a continuous load (anything running longer than 3 hours, like holiday lights) exceeding 80% of its maximum rating. On a standard 15-Amp circuit, your continuous max load should be 12 Amps (1,440 Watts).</p>
      </div>
    </div>
  </div>

  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/christmas-tree-lights" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Christmas Tree Lights Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate strand counts and power draw for indoor Christmas trees.</div>
      </a>
      <a href="/calculators/exterior-christmas-lights" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Exterior House Christmas Lights</div>
        <div class="text-xs text-gray-500 mt-1">Calculate roofline, gutter, and peak linear footage and clip counts.</div>
      </a>
      <a href="/calculators/generator-size" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Generator Size Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate generator wattage needed for emergency backup power.</div>
      </a>
    </div>
  </div>

</Layout>

<script is:inline>
  function calculate() {
    const fogMed = (parseInt(document.getElementById('fog_med').value) || 0) * 550;
    const fogHeavy = (parseInt(document.getElementById('fog_heavy').value) || 0) * 1100;
    const inflatables = (parseInt(document.getElementById('inflatables').value) || 0) * 50;
    const animatronics = (parseInt(document.getElementById('animatronics').value) || 0) * 30;
    const projectors = (parseInt(document.getElementById('projectors').value) || 0) * 20;
    const incStrands = (parseInt(document.getElementById('inc_strands').value) || 0) * 40;
    const ledStrands = (parseInt(document.getElementById('led_strands').value) || 0) * 4;
    const speakers = (parseInt(document.getElementById('speakers').value) || 0) * 50;
    const customWatts = parseFloat(document.getElementById('custom_watts').value) || 0;

    const totalWatts = fogMed + fogHeavy + inflatables + animatronics + projectors + incStrands + ledStrands + speakers + customWatts;

    const circuitRatingAmps = parseFloat(document.getElementById('circuitRating').value);
    const cordLengthFt = parseFloat(document.getElementById('cordLength').value);

    const maxWattsAllowed = circuitRatingAmps * 120; // 15A = 1800W, 20A = 2400W
    const currentAmps = (totalWatts / 120).toFixed(1);
    const capacityPercent = Math.round((totalWatts / maxWattsAllowed) * 100);

    // Extension cord wire gauge logic (AWG)
    // 16 AWG is rated for up to 13A under 50ft, 10A at 100ft
    // 14 AWG is rated for up to 15A under 50ft, 13A at 100ft
    // 12 AWG is rated for up to 15A-20A heavy duty up to 100ft
    let recommendedGauge = "16 AWG (Medium Duty)";
    if (parseFloat(currentAmps) > 10 || cordLengthFt >= 100) {
      recommendedGauge = "14 AWG (Heavy Duty)";
    }
    if (parseFloat(currentAmps) > 13 || (parseFloat(currentAmps) > 10 && cordLengthFt >= 100)) {
      recommendedGauge = "12 AWG (Extra Heavy Duty)";
    }

    // Status alert formatting
    const statusDiv = document.getElementById('statusAlert');
    const capBox = document.getElementById('r_capacityBox');
    
    if (capacityPercent <= 80) {
      statusDiv.className = "rounded-lg p-4 mb-4 font-medium text-sm bg-green-100 text-green-800 border border-green-300";
      statusDiv.innerHTML = `<strong>✅ Safe Load (${capacityPercent}% capacity):</strong> Your total draw of ${totalWatts}W (${currentAmps}A) is well within the 80% continuous safety limit of your ${circuitRatingAmps}-Amp circuit.`;
    } else if (capacityPercent <= 100) {
      statusDiv.className = "rounded-lg p-4 mb-4 font-medium text-sm bg-yellow-100 text-yellow-800 border border-yellow-300";
      statusDiv.innerHTML = `<strong>⚠️ High Load Warning (${capacityPercent}% capacity):</strong> You are drawing ${totalWatts}W (${currentAmps}A). While below the breaker trip point, this exceeds the 80% continuous safety limit for long runs. Avoid adding any more devices to this circuit.`;
    } else {
      statusDiv.className = "rounded-lg p-4 mb-4 font-medium text-sm bg-red-100 text-red-800 border border-red-300";
      statusDiv.innerHTML = `<strong>⛔ OVERLOADED CIRCUIT (${capacityPercent}% capacity):</strong> You are drawing ${totalWatts}W (${currentAmps}A), exceeding your ${circuitRatingAmps}-Amp breaker capacity (${maxWattsAllowed}W max). This WILL trip your breaker! Split your fog machines or inflatables onto a separate outlet connected to a different breaker.`;
    }

    document.getElementById('r_watts').innerText = totalWatts.toLocaleString() + " W";
    document.getElementById('r_amps').innerText = currentAmps + " A";
    document.getElementById('r_capacity').innerText = capacityPercent + "%";
    document.getElementById('r_cordGauge').innerText = recommendedGauge;

    document.getElementById('results').classList.remove('hidden');
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('calcBtn').addEventListener('click', calculate);
  });
</script>

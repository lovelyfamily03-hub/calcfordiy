---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
---

<Layout
  title="French Cleat Calculator (Plywood Rips, Spacing & Load Capacity) | CalcForDIY"
  description="Calculate French cleat tool wall layout, 45-degree bevel rip cuts, 3/4-inch plywood sheet yield, stud anchor screws, and safe hanging load capacity."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "French Cleat Wall Calculator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What angle should a French cleat be cut at?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A standard French cleat is cut at a 45-degree bevel angle. When the wall cleat is mounted with the bevel facing up and towards the wall, and the cabinet/tool cleat is mounted facing down and away, gravity pulls the two pieces tightly together against the wall."
        }
      },
      {
        "@type": "Question",
        "name": "What is the best plywood for a French cleat wall?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cabinet-grade 3/4-inch (18mm) Baltic Birch or high-density void-free hardwood plywood (like ACX or radiata pine) is the gold standard. Avoid standard CDX or MDF; standard construction plywood contains internal voids that can split along the bevel cut under heavy tool loads."
        }
      },
      {
        "@type": "Question",
        "name": "How much weight can a French cleat system hold?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "When 3/4-inch plywood cleats are fastened into 2x4 wall studs with two 3-inch #9 or #10 structural wood screws per stud (16 inches on center), each 4-foot section of cleat can easily support 300 to 450 lbs of downward shear load."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "French Cleat Calculator", "item": "https://calcfordiy.com/calculators/french-cleat" }
    ]
  }
  </script>


---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Construction Fraction Calculator — Feet, Inches & 16ths | CalcForDIY"
  description="Add, subtract, and convert feet, inches, and fractions (1/16, 1/8, 1/4, 1/2). Perfect for tape measure math and woodworking takeoffs."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Construction Fraction Calculator",
    "description": "Free feet, inches, and 16ths fraction calculator for carpenters, woodworkers, and DIYers adding tape measure measurements.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do you add feet, inches, and fractions?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "To add feet, inches, and fractions, convert all values to total inches (Feet * 12 + Inches + Fraction). Add the total inches together, then convert back to feet (divide by 12) and reduce the remaining fraction to lowest terms (8ths or 16ths)."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Construction Fraction Calculator", "item": "https://calcfordiy.com/calculators/construction-fraction" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Construction Fraction Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Construction &amp; Tape Measure Fraction Calculator</h1>
    <p class="text-gray-600 text-lg">Add or subtract feet, inches, and 16ths fractions for quick framing and woodworking tape measure calculations.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">1</span>
      Measurement 1
    </h2>

    <div class="grid grid-cols-3 gap-3 mb-5 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Feet</label>
        <input type="number" id="m1_ft" placeholder="0" value="8" min="0" max="1000" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Inches</label>
        <input type="number" id="m1_in" placeholder="0" value="5" min="0" max="11" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Fraction</label>
        <select id="m1_frac" class="w-full border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="0">0</option>
          <option value="0.0625">1/16"</option>
          <option value="0.125">1/8"</option>
          <option value="0.1875">3/16"</option>
          <option value="0.25">1/4"</option>
          <option value="0.3125">5/16"</option>
          <option value="0.375">3/8"</option>
          <option value="0.4375">7/16"</option>
          <option value="0.5" selected>1/2"</option>
          <option value="0.5625">9/16"</option>
          <option value="0.625">5/8"</option>
          <option value="0.6875">11/16"</option>
          <option value="0.75">3/4"</option>
          <option value="0.8125">13/16"</option>
          <option value="0.875">7/8"</option>
          <option value="0.9375">15/16"</option>
        </select>
      </div>
    </div>

    <div class="mb-5 flex justify-center">
      <select id="operation" class="border-2 border-blue-500 rounded-lg px-4 py-2 font-bold text-blue-700 bg-blue-50 text-base focus:outline-none">
        <option value="add" selected>➕ ADD (+)</option>
        <option value="subtract">➖ SUBTRACT (-)</option>
      </select>
    </div>

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">2</span>
      Measurement 2
    </h2>

    <div class="grid grid-cols-3 gap-3 mb-6 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Feet</label>
        <input type="number" id="m2_ft" placeholder="0" value="4" min="0" max="1000" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Inches</label>
        <input type="number" id="m2_in" placeholder="0" value="9" min="0" max="11" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Fraction</label>
        <select id="m2_frac" class="w-full border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="0">0</option>
          <option value="0.0625">1/16"</option>
          <option value="0.125">1/8"</option>
          <option value="0.1875">3/16"</option>
          <option value="0.25">1/4"</option>
          <option value="0.3125">5/16"</option>
          <option value="0.375">3/8"</option>
          <option value="0.4375">7/16"</option>
          <option value="0.5">1/2"</option>
          <option value="0.5625">9/16"</option>
          <option value="0.625">5/8"</option>
          <option value="0.6875">11/16"</option>
          <option value="0.75" selected>3/4"</option>
          <option value="0.8125">13/16"</option>
          <option value="0.875">7/8"</option>
          <option value="0.9375">15/16"</option>
        </select>
      </div>
    </div>

    <button id="calcBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-base print:hidden">
      Calculate Tape Measurement Result →
    </button>
  </div>

  <div id="results" class="hidden bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 rounded-xl p-6 mb-8 print:bg-white print:border-gray-300 print:from-white print:to-white print:shadow-none">
    <h2 class="text-lg font-semibold text-blue-900 mb-4 print:text-xl print:text-gray-900">Calculated Measurement Result</h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-5">
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border-2 border-blue-400 print:border-gray-300 print:shadow-none sm:col-span-2">
        <div class="text-3xl font-black text-blue-700 print:text-gray-900" id="r_resultFormatted">—</div>
        <div class="text-xs text-blue-800 font-semibold uppercase tracking-wide mt-1">Feet, Inches &amp; Lowest Fraction</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-gray-900 print:text-3xl" id="r_totalInches">—</div>
        <div class="text-xs text-gray-500 mt-1">Total Inches</div>
      </div>
    </div>

    <div class="bg-white rounded-lg p-4 shadow-sm mb-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-1">Decimal Equivalents</h3>
      <p class="text-xs text-gray-600" id="r_summary">—</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5 print:hidden">
      <button type="button" class="copy-list-btn w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2">
        📋 Copy Shopping List
      </button>
      <button type="button" onclick="window.print()" class="w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2">
        🖨️ Print Takeoff Sheet
      </button>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Tape Measure Fraction Reference Table</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-mono text-gray-700 bg-gray-50 p-4 rounded-lg">
      <div>1/16" = 0.0625"</div>
      <div>1/8" = 0.1250"</div>
      <div>3/16" = 0.1875"</div>
      <div>1/4" = 0.2500"</div>
      <div>5/16" = 0.3125"</div>
      <div>3/8" = 0.3750"</div>
      <div>7/16" = 0.4375"</div>
      <div>1/2" = 0.5000"</div>
      <div>9/16" = 0.5625"</div>
      <div>5/8" = 0.6250"</div>
      <div>11/16" = 0.6875"</div>
      <div>3/4" = 0.7500"</div>
      <div>13/16" = 0.8125"</div>
      <div>7/8" = 0.8750"</div>
      <div>15/16" = 0.9375"</div>
      <div>1" = 1.0000"</div>
    </div>
  </div>

</Layout>

<script is:inline>
  function gcd(a, b) {
    return b ? gcd(b, a % b) : a;
  }

  function decimalToFraction(decimal) {
    if (decimal <= 0.001) return "";
    const sixteenths = Math.round(decimal * 16);
    if (sixteenths === 16) return "1\"";
    if (sixteenths === 0) return "";

    const divisor = gcd(sixteenths, 16);
    const num = sixteenths / divisor;
    const den = 16 / divisor;
    return ` ${num}/${den}"`;
  }

  function calculate() {
    const f1 = parseFloat(document.getElementById('m1_ft').value) || 0;
    const i1 = parseFloat(document.getElementById('m1_in').value) || 0;
    const fr1 = parseFloat(document.getElementById('m1_frac').value) || 0;

    const f2 = parseFloat(document.getElementById('m2_ft').value) || 0;
    const i2 = parseFloat(document.getElementById('m2_in').value) || 0;
    const fr2 = parseFloat(document.getElementById('m2_frac').value) || 0;

    const op = document.getElementById('operation').value;

    const totInches1 = (f1 * 12) + i1 + fr1;
    const totInches2 = (f2 * 12) + i2 + fr2;

    let resultInches = op === 'add' ? (totInches1 + totInches2) : (totInches1 - totInches2);
    if (resultInches < 0) resultInches = 0;

    const feet = Math.floor(resultInches / 12);
    const remInchesFull = resultInches - (feet * 12);
    const inches = Math.floor(remInchesFull);
    const fracDec = remInchesFull - inches;

    const fracStr = decimalToFraction(fracDec);

    let formatted = "";
    if (feet > 0) formatted += `${feet}' `;
    formatted += `${inches}${fracStr}`;
    if (feet === 0 && inches === 0 && !fracStr) formatted = "0\"";

    document.getElementById('r_resultFormatted').innerText = formatted;
    document.getElementById('r_totalInches').innerText = `${resultInches.toFixed(3)}"`;
    document.getElementById('r_summary').innerText = `Total Decimal Inches: ${resultInches.toFixed(4)}" | Decimal Feet: ${(resultInches/12).toFixed(4)}'`;

    document.getElementById('results').classList.remove('hidden');
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('calcBtn').addEventListener('click', calculate);
  });
</script>

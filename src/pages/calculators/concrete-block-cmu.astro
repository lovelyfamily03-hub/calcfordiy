---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Concrete Block (CMU) Calculator — Cinder Block Walls, Grout & Rebar | CalcForDIY"
  description="Calculate how many 8x8x16 CMU cinder blocks, mortar bags, core grout fill cubic yards, and rebar you need for retaining walls, foundations, and shop walls."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Concrete Block (CMU) Wall Calculator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many 8x8x16 concrete blocks are in a square foot of wall?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "There are exactly 1.125 standard 8x8x16 CMU blocks per square foot of wall surface area (including standard 3/8-inch mortar joints). To estimate blocks, multiply your wall length by height and multiply by 1.125, then add 5% to 10% for cuts and breakage."
        }
      },
      {
        "@type": "Question",
        "name": "How much mortar do I need for 100 cinder blocks?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For 100 standard 8-inch CMU blocks, you will need approximately 3 bags (80 lb each) of Type S or Type N masonry cement mixed with sand, or about 6 bags of pre-blended masonry mortar mix."
        }
      },
      {
        "@type": "Question",
        "name": "How much grout is needed to fill CMU block cores?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Solidly grouting standard 8x8x16 hollow CMU blocks requires approximately 0.0074 cubic yards (0.20 cubic feet) of concrete grout per block, or roughly 0.74 cubic yards per 100 blocks. Grouting every 32 inches on center reduces grout volume by roughly 50%."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Concrete Block (CMU) Calculator", "item": "https://calcfordiy.com/calculators/concrete-block-cmu" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Concrete Block (CMU) Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Concrete Block (CMU) &amp; Cinder Block Calculator</h1>
    <p class="text-gray-600 text-base">
      Estimate CMU block counts, mortar bags, sand tonnage, core-fill grout cubic yards, and vertical/horizontal steel rebar for structural walls and retaining blocks.
    </p>
  </div>

  <!-- Calculator Input Form (Above Fold) -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
      Wall Dimensions &amp; Block Specifications
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-5">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Total Wall Length (ft)</label>
        <input type="number" id="wallLength" placeholder="30" value="30" min="1" max="500" step="0.5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Total Wall Height (ft)</label>
        <input type="number" id="wallHeight" placeholder="6" value="6" min="0.67" max="30" step="0.67" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Block Nominal Dimensions</label>
        <select id="blockSize" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="8x8x16" selected>8" × 8" × 16" (Standard Structural CMU)</option>
          <option value="6x8x16">6" × 8" × 16" (Lightweight / Partition Wall)</option>
          <option value="10x8x16">10" × 8" × 16" (Heavy Foundation / Retaining)</option>
          <option value="12x8x16">12" × 8" × 16" (Engineered Retaining Wall)</option>
          <option value="4x8x16">4" × 8" × 16" (Veneer / Half-High Block)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Waste &amp; Cutting Factor</label>
        <select id="wasteFactor" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="1.05">5% Waste (Straight Simple Wall)</option>
          <option value="1.10" selected>10% Waste (Standard Corners &amp; Steps)</option>
          <option value="1.15">15% Waste (Complex Angles &amp; Openings)</option>
        </select>
      </div>
    </div>

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">2</span>
      Reinforcement &amp; Core Grout Filling
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mb-4">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Vertical Rebar Core Spacing</label>
        <select id="rebarSpacing" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="solid">Solidly Grouted (Every Core Filled)</option>
          <option value="16">Grout &amp; Rebar @ 16" On-Center (Every 2nd Core)</option>
          <option value="24">Grout &amp; Rebar @ 24" On-Center</option>
          <option value="32" selected>Grout &amp; Rebar @ 32" On-Center (Standard Retaining)</option>
          <option value="48">Grout &amp; Rebar @ 48" On-Center (Light Load)</option>
          <option value="none">Ungrouted Hollow Cells (Non-Bearing Only)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Rebar Steel Size</label>
        <select id="rebarSize" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="#4" selected>#4 Rebar (1/2" Diameter Steel)</option>
          <option value="#5">#5 Rebar (5/8" Diameter Steel)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Top Bond Beam Course</label>
        <select id="bondBeam" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="yes" selected>Yes (Grout-Filled U-Block Bond Beam with 2 Bars)</option>
          <option value="no">No Bond Beam</option>
        </select>
      </div>
    </div>

    <button type="button" onclick="calculateCMU()" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer text-sm shadow-xs">
      Calculate Block Takeoff
    </button>
  </div>

  <!-- Primary Results Grid -->
  <div id="results" class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
      <div class="text-xs text-blue-600 font-semibold uppercase tracking-wide">Total CMU Blocks</div>
      <div id="r_totalBlocks" class="text-2xl sm:text-3xl font-extrabold text-blue-900 mt-1">223 Blocks</div>
      <div id="r_blockBreakdown" class="text-xs text-blue-700 mt-1">203 stretcher + 20 waste</div>
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
      <div class="text-xs text-amber-600 font-semibold uppercase tracking-wide">Mortar Mix Needed</div>
      <div id="r_mortarBags" class="text-2xl sm:text-3xl font-extrabold text-amber-900 mt-1">7 Bags</div>
      <div id="r_mortarType" class="text-xs text-amber-700 mt-1">80 lb Type S / Type N Bags</div>
    </div>

    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
      <div class="text-xs text-emerald-600 font-semibold uppercase tracking-wide">Core-Fill Grout</div>
      <div id="r_groutVolume" class="text-2xl sm:text-3xl font-extrabold text-emerald-900 mt-1">0.68 Cu Yd</div>
      <div id="r_groutBags" class="text-xs text-emerald-700 mt-1">~31 Bags (80 lb) or Ready-Mix</div>
    </div>

    <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
      <div class="text-xs text-purple-600 font-semibold uppercase tracking-wide">Rebar Steel</div>
      <div id="r_rebarSticks" class="text-2xl sm:text-3xl font-extrabold text-purple-900 mt-1">11 Sticks (20')</div>
      <div id="r_rebarFt" class="text-xs text-purple-700 mt-1">216 Linear Ft #4 Steel</div>
    </div>
  </div>

  <!-- Dynamic SVG Wall Layout Diagram -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
      <h2 class="text-base font-semibold text-gray-800">Dynamic CMU Course &amp; Rebar Elevation Diagram</h2>
      <span class="text-xs text-gray-500 font-mono">Running Bond • 3/8" Mortar Bed</span>
    </div>
    <div class="w-full overflow-x-auto bg-slate-900 rounded-lg p-4 flex items-center justify-center">
      <svg id="cmuSvg" viewBox="0 0 600 240" class="w-full max-w-2xl h-auto" style="min-height: 180px;"></svg>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-6 mt-3 text-xs text-gray-600">
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-slate-400 rounded-xs"></span> Standard CMU Stretcher</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-amber-500 rounded-xs"></span> Mortar Bed Joint (3/8")</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-red-500 rounded-full"></span> Vertical Rebar Core</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-blue-500 rounded-xs"></span> Top Bond Beam Course</div>
    </div>
  </div>

  <!-- Detailed Material Takeoff & Cost Benchmarking (RSMeans) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs">
      <h3 class="font-bold text-gray-900 text-sm mb-3">Complete Masonry Material Takeoff</h3>
      <table class="w-full text-xs text-left">
        <tbody class="divide-y divide-gray-200">
          <tr><td class="py-2 text-gray-600">Wall Gross Surface Area</td><td id="t_surfaceArea" class="py-2 font-mono text-right font-bold text-gray-900">180.0 sq ft</td></tr>
          <tr><td class="py-2 text-gray-600">Number of Horizontal Courses</td><td id="t_courseCount" class="py-2 font-mono text-right text-gray-900">9 Courses (72" Height)</td></tr>
          <tr><td class="py-2 text-gray-600">Blocks per Course (Length)</td><td id="t_blocksPerCourse" class="py-2 font-mono text-right text-gray-900">22.5 Blocks (30 ft)</td></tr>
          <tr><td class="py-2 text-gray-600">Masonry Sand (if mixing bulk)</td><td id="t_sandWeight" class="py-2 font-mono text-right text-gray-900">0.85 Tons (~0.65 yd³)</td></tr>
          <tr><td class="py-2 text-gray-600">Horizontal Joint Reinforcement</td><td id="t_ladderMesh" class="py-2 font-mono text-right text-gray-900">90 ft (Ladder Mesh @ 16" o.c.)</td></tr>
        </tbody>
      </table>

      <!-- 1-Click Shopping List Button -->
      <button id="copyListBtn" onclick="copyShoppingList()" class="mt-4 w-full bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-semibold py-2 px-4 rounded-lg transition-colors flex items-center justify-center gap-2 cursor-pointer border border-gray-300">
        <span>📋 Copy Shopping List for Home Depot / Lowe's</span>
      </button>
    </div>

    <!-- RSMeans DIY vs Contractor Cost Benchmark -->
    <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-xl p-6 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <h3 class="font-bold text-sm text-blue-200">DIY vs Contractor Cost Benchmark</h3>
        <span class="text-[10px] bg-blue-500/30 text-blue-300 px-2 py-0.5 rounded font-mono">RSMeans 2026</span>
      </div>
      <p class="text-xs text-slate-300 mb-4">Compare raw retail materials against licensed turnkey masonry contractor installation quotes.</p>
      
      <div class="grid grid-cols-2 gap-3 mb-4">
        <div class="bg-white/10 p-3 rounded-lg border border-white/10">
          <div class="text-[11px] text-slate-300 font-medium">Estimated DIY Materials</div>
          <div id="c_diyCost" class="text-xl font-black text-emerald-400 mt-0.5">$650 – $850</div>
          <div class="text-[10px] text-slate-400 mt-1">Blocks, mortar, rebar, grout</div>
        </div>
        <div class="bg-white/10 p-3 rounded-lg border border-white/10">
          <div class="text-[11px] text-slate-300 font-medium">Licensed Mason Quote</div>
          <div id="c_proCost" class="text-xl font-black text-amber-300 mt-0.5">$3,240 – $4,500</div>
          <div class="text-[10px] text-slate-400 mt-1">$18 – $25 / sq ft installed</div>
        </div>
      </div>
      <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-2.5 rounded-lg border border-emerald-500/30">
        <span class="text-emerald-400 font-bold text-sm">💰</span>
        <span>Potential DIY Savings: <strong id="c_savings" class="text-emerald-300 font-bold">$2,590 – $3,650 (78%)</strong></span>
      </div>
    </div>
  </div>

  <!-- Building Code & Engineering Best Practices -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Masonry Engineering Code &amp; Construction Rules</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-700">
      <div class="border-l-2 border-blue-500 pl-3">
        <h4 class="font-bold text-gray-900 mb-1">NCMA &amp; ASTM C90 Modular Geometry</h4>
        <p class="text-xs leading-relaxed">
          Standard cinder blocks have actual dimensions of $7\frac{5}{8}" \times 7\frac{5}{8}" \times 15\frac{5}{8}"$. When laid with a nominal $\frac{3}{8}"$ mortar joint, they fit a standard $8" \times 8" \times 16"$ modular grid. This mathematically yields exactly <strong>1.125 blocks per square foot</strong> of wall elevation.
        </p>
      </div>
      <div class="border-l-2 border-amber-500 pl-3">
        <h4 class="font-bold text-gray-900 mb-1">Mortar Specifications (ASTM C270)</h4>
        <p class="text-xs leading-relaxed">
          Always use <strong>Type S mortar (1,800 PSI minimum)</strong> for exterior retaining walls, below-grade foundation blockwork, and seismic load zones. Use <strong>Type N (750 PSI)</strong> only for non-loadbearing above-grade interior partition walls.
        </p>
      </div>
      <div class="border-l-2 border-emerald-500 pl-3">
        <h4 class="font-bold text-gray-900 mb-1">Rebar Lap Splicing &amp; Concrete Cover</h4>
        <p class="text-xs leading-relaxed">
          Per <strong>ACI 530 / TMS 402</strong>, vertical rebar rods must be lap-spliced by a minimum of 40 to 48 bar diameters (at least 20 to 24 inches for #4 rebar). Dowels embedded into the concrete footing must align with the hollow CMU cell locations.
        </p>
      </div>
      <div class="border-l-2 border-purple-500 pl-3">
        <h4 class="font-bold text-gray-900 mb-1">Grout Core Consolidation (ASTM C476)</h4>
        <p class="text-xs leading-relaxed">
          Core-fill grout must have a high slump (8 to 11 inches) so it flows freely around steel rebar without voids. For walls over 5 feet, vibrate or rod the grout in 4-foot lifts to eliminate honeycomb air pockets.
        </p>
      </div>
    </div>
  </div>

  <!-- FAQs -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>
    <div class="space-y-4">
      <div>
        <h3 class="font-bold text-gray-900 mb-1">What is the difference between a cinder block and a concrete block (CMU)?</h3>
        <p class="text-gray-600 text-sm">Today, "cinder block" is a colloquial term for modern Concrete Masonry Units (CMU). Historical cinder blocks used coal cinders as aggregate. Modern CMU blocks use portland cement, crushed stone, and sand, yielding structural compressive strengths of 1,900 to 3,000+ PSI.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">Do I need to fill all cinder block holes with concrete?</h3>
        <p class="text-gray-600 text-sm">For standard garden walls and decorative partitions under 3 feet, un-grouted hollow blocks with surface bonding cement or intermittent rebar are common. For structural retaining walls, foundations, and walls over 4 feet holding soil pressure, building codes mandate rebar every 16 to 32 inches and a continuous top bond beam.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">How deep should the concrete footing be for a cinder block wall?</h3>
        <p class="text-gray-600 text-sm">Per IRC Section R403, a concrete footing for a block wall should be twice the width of the block (16" wide for an 8" block) and at least 8 to 12 inches deep, placed below your local frost penetration depth to prevent winter cracking.</p>
      </div>
    </div>
  </div>

  <!-- Related Tools -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Concrete &amp; Masonry Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/concrete-slab" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Slab Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Estimate cubic yards, 60/80 lb bags, and rebar grid for slabs.</div>
      </a>
      <a href="/calculators/retaining-wall" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Retaining Wall Block Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate interlocking landscape blocks, base gravel &amp; capstones.</div>
      </a>
      <a href="/calculators/quikrete-bags" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Quikrete Bags Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Convert concrete volume to 50 lb, 60 lb, and 80 lb bagged cement.</div>
      </a>
    </div>
  </div>

</Layout>

<script is:inline>
  function calculateCMU() {
    const length = parseFloat(document.getElementById('wallLength').value) || 30;
    const height = parseFloat(document.getElementById('wallHeight').value) || 6;
    const size = document.getElementById('blockSize').value;
    const waste = parseFloat(document.getElementById('wasteFactor').value) || 1.10;
    const spacing = document.getElementById('rebarSpacing').value;
    const rebarSz = document.getElementById('rebarSize').value;
    const hasBondBeam = document.getElementById('bondBeam').value === 'yes';

    const surfaceArea = length * height;
    
    // Standard modular 8x8x16 = 1.125 blocks per sq ft
    const baseBlocks = surfaceArea * 1.125;
    const totalBlocks = Math.ceil(baseBlocks * waste);
    const wasteCount = totalBlocks - Math.ceil(baseBlocks);

    // Courses & horizontal block count
    const courseCount = Math.round(height / (8 / 12));
    const blocksPerCourse = (length / (16 / 12)).toFixed(1);

    // Mortar yield: 1 bag (80 lb) Type S lays ~32 standard 8" CMU
    let blocksPerMortarBag = 32;
    if (size.startsWith('6')) blocksPerMortarBag = 38;
    if (size.startsWith('10')) blocksPerMortarBag = 26;
    if (size.startsWith('12')) blocksPerMortarBag = 22;
    const mortarBags = Math.ceil(totalBlocks / blocksPerMortarBag);
    const sandTons = (mortarBags * 0.12).toFixed(2);

    // Core Grout Volume
    // 8x8x16 solid fill = 0.0074 cu yd / block (0.20 cu ft)
    let coreVolumePerBlock = 0.0074;
    if (size.startsWith('6')) coreVolumePerBlock = 0.0055;
    if (size.startsWith('10')) coreVolumePerBlock = 0.0095;
    if (size.startsWith('12')) coreVolumePerBlock = 0.0118;

    let groutedFraction = 0;
    if (spacing === 'solid') groutedFraction = 1.0;
    else if (spacing === '16') groutedFraction = 0.50;
    else if (spacing === '24') groutedFraction = 0.33;
    else if (spacing === '32') groutedFraction = 0.25;
    else if (spacing === '48') groutedFraction = 0.17;
    else groutedFraction = 0;

    let groutCuYd = (totalBlocks * coreVolumePerBlock * groutedFraction);
    if (hasBondBeam) {
      // Add bond beam top course volume: 1 course across length
      const bondBeamBlocks = Math.ceil(length / (16 / 12));
      groutCuYd += (bondBeamBlocks * coreVolumePerBlock * 0.8);
    }
    const groutBags80 = Math.ceil(groutCuYd * 45); // 1 yd3 = 45 80lb bags

    // Rebar calculation
    // Vertical bars: length / (spacing_inches / 12) + 1
    let verticalBarsCount = 0;
    if (spacing !== 'none') {
      const spacingFt = spacing === 'solid' ? 0.67 : (parseInt(spacing) / 12);
      verticalBarsCount = Math.ceil(length / spacingFt) + 1;
    }
    const verticalRebarLinearFt = verticalBarsCount * (height + 2); // +2ft for footing dowel overlap
    
    let horizontalRebarLinearFt = 0;
    if (hasBondBeam) {
      horizontalRebarLinearFt = length * 2 * 1.15; // 2 continuous bars with laps
    }
    const totalRebarLinearFt = Math.ceil(verticalRebarLinearFt + horizontalRebarLinearFt);
    const rebarSticks20 = Math.ceil(totalRebarLinearFt / 20);

    // Update Result DOM
    document.getElementById('r_totalBlocks').textContent = `${totalBlocks} Blocks`;
    document.getElementById('r_blockBreakdown').textContent = `${Math.ceil(baseBlocks)} net + ${wasteCount} waste (${Math.round((waste-1)*100)}%)`;
    
    document.getElementById('r_mortarBags').textContent = `${mortarBags} Bags`;
    document.getElementById('r_mortarType').textContent = `80 lb Type S / Type N (lays ~${blocksPerMortarBag} ea)`;

    document.getElementById('r_groutVolume').textContent = `${groutCuYd.toFixed(2)} Cu Yd`;
    document.getElementById('r_groutBags').textContent = groutCuYd > 0 ? `~${groutBags80} Bags (80 lb) Core Grout` : 'No core grouting requested';

    document.getElementById('r_rebarSticks').textContent = totalRebarLinearFt > 0 ? `${rebarSticks20} Sticks (20')` : '0 Sticks';
    document.getElementById('r_rebarFt').textContent = totalRebarLinearFt > 0 ? `${totalRebarLinearFt} Lin Ft (${rebarSz} Steel)` : 'No vertical steel';

    // Detailed Table
    document.getElementById('t_surfaceArea').textContent = `${surfaceArea.toFixed(1)} sq ft`;
    document.getElementById('t_courseCount').textContent = `${courseCount} Courses (~${Math.round(courseCount * 8)}" H)`;
    document.getElementById('t_blocksPerCourse').textContent = `${blocksPerCourse} Blocks (~${length} ft)`;
    document.getElementById('t_sandWeight').textContent = `${sandTons} Tons (~${(sandTons / 1.3).toFixed(2)} yd³) Sand`;
    document.getElementById('t_ladderMesh').textContent = `${Math.ceil(length * Math.ceil(courseCount / 2))} Lin Ft (Ladder Mesh @ 16" o.c.)`;

    // Cost Benchmarks (RSMeans 2026)
    const blockCost = totalBlocks * 2.65;
    const mortarCost = mortarBags * 12.50;
    const groutCost = groutCuYd * 165;
    const rebarCost = rebarSticks20 * 11.50;
    const totalDiyMin = Math.round(blockCost + mortarCost + groutCost + rebarCost);
    const totalDiyMax = Math.round(totalDiyMin * 1.25);

    const proCostMin = Math.round(surfaceArea * 18);
    const proCostMax = Math.round(surfaceArea * 25);

    document.getElementById('c_diyCost').textContent = `$${totalDiyMin.toLocaleString()} – $${totalDiyMax.toLocaleString()}`;
    document.getElementById('c_proCost').textContent = `$${proCostMin.toLocaleString()} – $${proCostMax.toLocaleString()}`;
    document.getElementById('c_savings').textContent = `$${(proCostMin - totalDiyMax).toLocaleString()} – $${(proCostMax - totalDiyMin).toLocaleString()} (${Math.round((1 - totalDiyMin/proCostMin)*100)}%)`;

    // Draw SVG Diagram
    drawCMUSvg(length, height, courseCount, parseInt(blocksPerCourse), hasBondBeam, spacing);
  }

  function drawCMUSvg(length, height, courses, blocksWide, hasBondBeam, spacing) {
    const svg = document.getElementById('cmuSvg');
    if (!svg) return;

    let content = '';
    const renderCourses = Math.min(courses, 8);
    const renderBlocksWide = Math.min(Math.max(blocksWide, 6), 12);
    
    const blockW = 540 / renderBlocksWide;
    const blockH = 180 / renderCourses;
    const startX = 30;
    const startY = 30;

    // Background Footing Trench
    content += `<rect x="20" y="${startY + renderCourses * blockH}" width="560" height="20" fill="#475569" stroke="#334155" stroke-width="1" />`;
    content += `<text x="300" y="${startY + renderCourses * blockH + 14}" text-anchor="middle" font-size="10" font-weight="bold" fill="#CBD5E1">Concrete Trench Footing (Below Frost Line)</text>`;

    // Draw CMU Block Courses
    for (let c = 0; c < renderCourses; c++) {
      const y = startY + (renderCourses - 1 - c) * blockH;
      const isTopBond = (c === renderCourses - 1) && hasBondBeam;
      const isOffset = (c % 2 === 1);

      const blockCountInRow = isOffset ? renderBlocksWide + 1 : renderBlocksWide;

      for (let b = 0; b < blockCountInRow; b++) {
        let x = startX + b * blockW - (isOffset ? blockW / 2 : 0);
        let w = blockW;

        if (x < startX) {
          w = x + blockW - startX;
          x = startX;
        } else if (x + w > startX + 540) {
          w = (startX + 540) - x;
        }

        if (w > 2) {
          const fillColor = isTopBond ? '#3B82F6' : '#94A3B8';
          const strokeColor = '#334155';
          content += `<rect x="${x}" y="${y}" width="${w}" height="${blockH}" fill="${fillColor}" stroke="${strokeColor}" stroke-width="1.5" rx="1" />`;
          
          // Draw dual hollow cores inside block if wide enough
          if (w >= blockW * 0.8 && !isTopBond) {
            const coreW = w * 0.32;
            const coreH = blockH * 0.6;
            content += `<rect x="${x + w*0.12}" y="${y + blockH*0.2}" width="${coreW}" height="${coreH}" fill="#1E293B" rx="1" />`;
            content += `<rect x="${x + w*0.56}" y="${y + blockH*0.2}" width="${coreW}" height="${coreH}" fill="#1E293B" rx="1" />`;
          }
        }
      }
    }

    // Vertical Rebar Lines if grouted
    if (spacing !== 'none') {
      const barInterval = spacing === '16' ? blockW : (spacing === '32' ? blockW * 2 : blockW * 3);
      for (let rx = startX + blockW / 2; rx < startX + 540; rx += barInterval) {
        content += `<line x1="${rx}" y1="${startY - 8}" x2="${rx}" y2="${startY + renderCourses * blockH + 10}" stroke="#EF4444" stroke-width="3" stroke-dasharray="4 2" />`;
        content += `<circle cx="${rx}" cy="${startY - 8}" r="3" fill="#EF4444" />`;
      }
    }

    // Bond beam top continuous steel bar
    if (hasBondBeam) {
      content += `<line x1="${startX}" y1="${startY + blockH/2}" x2="${startX + 540}" y2="${startY + blockH/2}" stroke="#F59E0B" stroke-width="2.5" />`;
    }

    svg.innerHTML = content;
  }

  function copyShoppingList() {
    const blocks = document.getElementById('r_totalBlocks').textContent;
    const mortar = document.getElementById('r_mortarBags').textContent;
    const grout = document.getElementById('r_groutVolume').textContent;
    const rebar = document.getElementById('r_rebarSticks').textContent;

    const listText = `CalcForDIY Material Takeoff — CMU Cinder Block Wall:\n` +
      `- ${blocks} (8x8x16 CMU Stretcher Blocks)\n` +
      `- ${mortar} (80 lb Type S Masonry Cement)\n` +
      `- Core Grout: ${grout}\n` +
      `- Rebar: ${rebar}\n` +
      `Calculated at https://calcfordiy.com/calculators/concrete-block-cmu`;

    navigator.clipboard.writeText(listText).then(() => {
      const btn = document.getElementById('copyListBtn');
      btn.innerHTML = '<span>✅ Copied to Clipboard!</span>';
      setTimeout(() => {
        btn.innerHTML = '<span>📋 Copy Shopping List for Home Depot / Lowe\'s</span>';
      }, 2500);
    });
  }

  // Initial Calculation
  calculateCMU();
</script>

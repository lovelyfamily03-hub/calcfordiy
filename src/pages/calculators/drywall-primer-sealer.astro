---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Drywall Primer & Sealer Calculator — PVA Primer, Walls & Ceilings | CalcForDIY"
  description="Calculate how many gallons of PVA drywall primer, high-build surfacer, or stain-blocking primer you need for new drywall sheets, mud joints, and ceilings."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Drywall Primer and Sealer Calculator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many square feet does a gallon of PVA drywall primer cover?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "On fresh, bare drywall and joint compound (Level 3 or 4 finish), 1 gallon of PVA primer covers approximately 250 to 300 square feet due to the porous nature of unsealed drywall paper and sanded mud. On previously painted or sealed walls, coverage increases to 350 to 400 square feet per gallon."
        }
      },
      {
        "@type": "Question",
        "name": "Why is PVA primer necessary on new drywall instead of regular paint?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Per Gypsum Association GA-214 standards, joint compound and drywall face paper have drastically different porosity. Applying finish paint directly causes 'flashing' (uneven sheen where mud joints show through the paint). PVA (polyvinyl acetate) primer seals the porosity evenly so your topcoat looks uniform."
        }
      },
      {
        "@type": "Question",
        "name": "Should you tint your drywall primer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. If your final wall paint is a deep, dark, or vibrant color (navy, charcoal, red, forest green), having the paint store tint your primer to 50% of your topcoat color prevents having to apply 3 or 4 expensive coats of finish paint."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Drywall Primer Calculator", "item": "https://calcfordiy.com/calculators/drywall-primer-sealer" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Drywall Primer Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Drywall Primer &amp; Sealer Calculator</h1>
    <p class="text-gray-600 text-base">
      Calculate PVA drywall primer gallons, high-build surfacer, and ceiling sealer requirements for new sheetrock walls, mud joints, and drywall remodels.
    </p>
  </div>

  <!-- Calculator Form -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
      Room Dimensions &amp; Surface Condition
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-5">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Room Length (ft)</label>
        <input type="number" id="roomLength" placeholder="18" value="18" min="1" max="200" step="0.5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Room Width (ft)</label>
        <input type="number" id="roomWidth" placeholder="14" value="14" min="1" max="200" step="0.5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Ceiling Height (ft)</label>
        <input type="number" id="ceilingHeight" placeholder="9" value="9" min="6" max="30" step="0.5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Include Ceiling in Calculation?</label>
        <select id="includeCeiling" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="yes" selected>Yes (Prime Walls &amp; Ceiling)</option>
          <option value="no">No (Prime Walls Only)</option>
        </select>
      </div>
    </div>

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">2</span>
      Surface Porosity &amp; Primer Formulation
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mb-4">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Drywall Surface State</label>
        <select id="surfaceState" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="bare" selected>Fresh Bare Drywall &amp; Taped Mud Joints (Porous)</option>
          <option value="skimmed">Full Level 5 Skim Coat (High Absorption)</option>
          <option value="patched">Existing Painted Wall with Patch Repairs</option>
          <option value="stained">Water-Damaged / Smoke-Stained Drywall</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Primer Type</label>
        <select id="primerType" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="pva" selected>PVA Drywall Primer &amp; Sealer (Standard Base)</option>
          <option value="high_build">High-Build Primer / Surfacer (Level 5 Equalizer)</option>
          <option value="stain_block">Shellac / Oil Stain-Blocking Primer (KILZ / BIN)</option>
          <option value="bonding">Acrylic Bonding Primer (Slick Surfaces)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Doors &amp; Windows Subtraction</label>
        <select id="openings" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="40" selected>2 Standard Doors / Windows (-40 sq ft)</option>
          <option value="80">4 Doors / Windows (-80 sq ft)</option>
          <option value="120">Large French Doors / Windows (-120 sq ft)</option>
          <option value="0">0 Openings (Full Solid Walls)</option>
        </select>
      </div>
    </div>

    <button type="button" onclick="calculatePrimer()" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer text-sm shadow-xs">
      Calculate Primer Gallons
    </button>
  </div>

  <!-- Primary Results Grid -->
  <div id="results" class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
      <div class="text-xs text-blue-600 font-semibold uppercase tracking-wide">Primer Needed</div>
      <div id="r_totalGallons" class="text-2xl sm:text-3xl font-extrabold text-blue-900 mt-1">3.0 Gallons</div>
      <div id="r_pails" class="text-xs text-blue-700 mt-1">3 × 1-Gal Cans (or 1 × 5-Gal Pail)</div>
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
      <div class="text-xs text-amber-600 font-semibold uppercase tracking-wide">Net Paintable Area</div>
      <div id="r_totalSqFt" class="text-2xl sm:text-3xl font-extrabold text-amber-900 mt-1">788 Sq Ft</div>
      <div id="r_areaDetail" class="text-xs text-amber-700 mt-1">536' walls + 252' ceiling</div>
    </div>

    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
      <div class="text-xs text-emerald-600 font-semibold uppercase tracking-wide">Coverage Rate</div>
      <div id="r_coverageRate" class="text-2xl sm:text-3xl font-extrabold text-emerald-900 mt-1">275 sq ft/gal</div>
      <div id="r_finishStandard" class="text-xs text-emerald-700 mt-1">GA-214 Level 4 Standard</div>
    </div>

    <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
      <div class="text-xs text-purple-600 font-semibold uppercase tracking-wide">Roller Nap Spec</div>
      <div id="r_rollerNap" class="text-2xl sm:text-3xl font-extrabold text-purple-900 mt-1">3/8" Nap</div>
      <div id="r_rollerDetail" class="text-xs text-purple-700 mt-1">Microfiber or Woven Sleeve</div>
    </div>
  </div>

  <!-- Dynamic SVG Diagram -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
      <h2 class="text-base font-semibold text-gray-800">Drywall Level 4 Sealing &amp; Porosity Diagram</h2>
      <span class="text-xs text-gray-500 font-mono">Gypsum Association GA-214 Standard</span>
    </div>
    <div class="w-full overflow-x-auto bg-slate-900 rounded-lg p-4 flex items-center justify-center">
      <svg id="primerSvg" viewBox="0 0 600 200" class="w-full max-w-2xl h-auto" style="min-height: 160px;"></svg>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-6 mt-3 text-xs text-gray-600">
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-slate-300 rounded-xs"></span> Raw Gypsum Paper</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-amber-100 rounded-xs"></span> Sanded Joint Mud</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-blue-400 rounded-xs"></span> Sealed PVA Primer Film</div>
    </div>
  </div>

  <!-- Material Takeoff Table & RSMeans Cost Benchmarks -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs">
      <h3 class="font-bold text-gray-900 text-sm mb-3">Primer &amp; Supplies Checklist</h3>
      <table class="w-full text-xs text-left">
        <tbody class="divide-y divide-gray-200">
          <tr><td class="py-2 text-gray-600">Wall Gross Surface Area</td><td id="t_wallArea" class="py-2 font-mono text-right font-bold text-gray-900">576 sq ft (minus 40 sq ft openings)</td></tr>
          <tr><td class="py-2 text-gray-600">Ceiling Surface Area</td><td id="t_ceilArea" class="py-2 font-mono text-right text-gray-900">252 sq ft</td></tr>
          <tr><td class="py-2 text-gray-600">Primer Tinting Advice</td><td id="t_tintAdvice" class="py-2 font-mono text-right text-blue-600 font-bold">Standard White Primer</td></tr>
          <tr><td class="py-2 text-gray-600">Application Tooling</td><td id="t_tools" class="py-2 font-mono text-right text-gray-900">9" Roller Frame + 3/8" Nap + 2.5" Angle Sash</td></tr>
        </tbody>
      </table>

      <!-- 1-Click Shopping List Button -->
      <button id="copyListBtn" onclick="copyShoppingList()" class="mt-4 w-full bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-semibold py-2 px-4 rounded-lg transition-colors flex items-center justify-center gap-2 cursor-pointer border border-gray-300">
        <span>📋 Copy Shopping List for Home Depot / Lowe's</span>
      </button>
    </div>

    <!-- RSMeans DIY vs Pro Benchmark -->
    <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-xl p-6 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <h3 class="font-bold text-sm text-blue-200">DIY vs Painting Contractor Cost</h3>
        <span class="text-[10px] bg-blue-500/30 text-blue-300 px-2 py-0.5 rounded font-mono">RSMeans 2026</span>
      </div>
      <p class="text-xs text-slate-300 mb-4">Retail PVA primer &amp; roller setup vs professional spray/back-roll priming quote.</p>
      
      <div class="grid grid-cols-2 gap-3 mb-4">
        <div class="bg-white/10 p-3 rounded-lg border border-white/10">
          <div class="text-[11px] text-slate-300 font-medium">Estimated DIY Cost</div>
          <div id="c_diyCost" class="text-xl font-black text-emerald-400 mt-0.5">$65 – $95</div>
          <div class="text-[10px] text-slate-400 mt-1">PVA primer, rollers, tape &amp; plastic</div>
        </div>
        <div class="bg-white/10 p-3 rounded-lg border border-white/10">
          <div class="text-[11px] text-slate-300 font-medium">Pro Painter Primer Quote</div>
          <div id="c_proCost" class="text-xl font-black text-amber-300 mt-0.5">$480 – $750</div>
          <div class="text-[10px] text-slate-400 mt-1">Prep, mask, airless spray &amp; backroll</div>
        </div>
      </div>
      <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-2.5 rounded-lg border border-emerald-500/30">
        <span class="text-emerald-400 font-bold text-sm">💰</span>
        <span>Potential DIY Savings: <strong id="c_savings" class="text-emerald-300 font-bold">$415 – $655 (87%)</strong></span>
      </div>
    </div>
  </div>

  <!-- FAQs -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>
    <div class="space-y-4">
      <div>
        <h3 class="font-bold text-gray-900 mb-1">Can I use paint-and-primer-in-one directly on raw drywall?</h3>
        <p class="text-gray-600 text-sm">No professional drywaller or painter recommends paint-and-primer-in-one on fresh drywall. Raw joint compound absorbs the resins out of finish paint, leaving dull chalky bands along every seam. Dedicated PVA primer creates a uniform barrier for only ~$18 per gallon.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">Should I sand after applying drywall primer?</h3>
        <p class="text-gray-600 text-sm">Yes. Priming often raises the wood fibers in drywall paper and exposes tiny pinholes or imperfections in joint compound. A quick 5-minute 'pole sand' with 220-grit sandpaper over the primed walls creates an ultra-smooth glassy base for your final paint coats.</p>
      </div>
    </div>
  </div>

  <!-- Related Calculators -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Drywall &amp; Paint Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/drywall" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Drywall Sheet Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate 4x8 and 4x12 sheetrock sheets &amp; screws.</div>
      </a>
      <a href="/calculators/drywall-mud" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Drywall Mud &amp; Tape Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Estimate joint compound pails and paper tape rolls.</div>
      </a>
      <a href="/calculators/paint-room" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Interior Room Paint Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate paint gallons for walls, trim &amp; doors.</div>
      </a>
    </div>
  </div>

</Layout>

<script is:inline>
  function calculatePrimer() {
    const length = parseFloat(document.getElementById('roomLength').value) || 18;
    const width = parseFloat(document.getElementById('roomWidth').value) || 14;
    const height = parseFloat(document.getElementById('ceilingHeight').value) || 9;
    const inclCeiling = document.getElementById('includeCeiling').value === 'yes';
    const surfaceState = document.getElementById('surfaceState').value;
    const primerType = document.getElementById('primerType').value;
    const openingsSqFt = parseFloat(document.getElementById('openings').value) || 40;

    const wallGross = 2 * (length + width) * height;
    const wallNet = Math.max(wallGross - openingsSqFt, 0);
    const ceilNet = inclCeiling ? (length * width) : 0;
    const totalSqFt = wallNet + ceilNet;

    // Coverage rate based on porosity
    let coverage = 275;
    if (surfaceState === 'bare') coverage = 275;
    if (surfaceState === 'skimmed') coverage = 225; // Skim coat is very absorbent
    if (surfaceState === 'patched') coverage = 350;
    if (surfaceState === 'stained') coverage = 300;

    if (primerType === 'high_build') coverage = 180; // High-build surfacer is applied thick

    const exactGal = (totalSqFt / coverage) * 1.10; // +10% waste / tray residue
    const roundedGal = Math.ceil(exactGal);

    // Update DOM
    document.getElementById('r_totalGallons').textContent = `${roundedGal}.0 Gallons`;
    document.getElementById('r_pails').textContent = roundedGal >= 5 ? `1 × 5-Gal Pail (or ${roundedGal} × 1-Gal Cans)` : `${roundedGal} × 1-Gallon Cans`;
    document.getElementById('r_totalSqFt').textContent = `${Math.round(totalSqFt)} Sq Ft`;
    document.getElementById('r_areaDetail').textContent = `${Math.round(wallNet)}' walls${inclCeiling ? ` + ${Math.round(ceilNet)}' ceiling` : ''}`;
    document.getElementById('r_coverageRate').textContent = `${coverage} sq ft/gal`;
    document.getElementById('r_finishStandard').textContent = primerType === 'high_build' ? 'High-Build Surfacer' : 'GA-214 Level 4 Standard';

    document.getElementById('t_wallArea').textContent = `${Math.round(wallNet)} sq ft (Gross ${Math.round(wallGross)} - ${openingsSqFt} sq ft)`;
    document.getElementById('t_ceilArea').textContent = inclCeiling ? `${Math.round(ceilNet)} sq ft` : 'Excluded';

    // RSMeans Cost Benchmarks
    const pricePerGal = primerType === 'stain_block' ? 48 : (primerType === 'high_build' ? 32 : 19);
    const diyCostMin = Math.round(roundedGal * pricePerGal + 25);
    const diyCostMax = Math.round(diyCostMin * 1.3);

    const proCostMin = Math.round(totalSqFt * 0.65);
    const proCostMax = Math.round(totalSqFt * 0.95);

    document.getElementById('c_diyCost').textContent = `$${diyCostMin} – $${diyCostMax}`;
    document.getElementById('c_proCost').textContent = `$${proCostMin.toLocaleString()} – $${proCostMax.toLocaleString()}`;
    document.getElementById('c_savings').textContent = `$${(proCostMin - diyCostMax).toLocaleString()} – $${(proCostMax - diyCostMin).toLocaleString()} (${Math.round((1 - diyCostMin/proCostMin)*100)}%)`;

    drawPrimerSvg();
  }

  function drawPrimerSvg() {
    const svg = document.getElementById('primerSvg');
    if (!svg) return;

    let content = '';
    // Raw Drywall Sheet background
    content += `<rect x="30" y="30" width="540" height="140" fill="#CBD5E1" stroke="#94A3B8" stroke-width="2" rx="4" />`;
    
    // Joint compound taped seam
    content += `<rect x="280" y="30" width="40" height="140" fill="#FEF3C7" opacity="0.9" />`;
    content += `<line x1="300" y1="30" x2="300" y2="170" stroke="#F59E0B" stroke-dasharray="4 2" stroke-width="1.5" />`;
    content += `<text x="300" y="105" text-anchor="middle" font-size="10" font-weight="bold" fill="#B45309" transform="rotate(-90 300 105)">Taped Mud Joint</text>`;

    // Primer Coat Roll overlay on left half
    content += `<rect x="30" y="30" width="230" height="140" fill="#3B82F6" opacity="0.75" rx="4" />`;
    content += `<text x="145" y="85" text-anchor="middle" font-size="13" font-weight="bold" fill="#FFFFFF">Sealed with PVA Primer</text>`;
    content += `<text x="145" y="105" text-anchor="middle" font-size="10" fill="#DBEAFE">Equalized Porosity Barrier</text>`;

    // Unprimed section on right
    content += `<text x="445" y="85" text-anchor="middle" font-size="13" font-weight="bold" fill="#334155">Unsealed Porous Area</text>`;
    content += `<text x="445" y="105" text-anchor="middle" font-size="10" fill="#64748B">Paper vs Mud Flash Risk</text>`;

    svg.innerHTML = content;
  }

  function copyShoppingList() {
    const gal = document.getElementById('r_totalGallons').textContent;
    const pails = document.getElementById('r_pails').textContent;
    const primer = document.getElementById('primerType').selectedOptions[0].text;

    const listText = `CalcForDIY Material Takeoff — Drywall Primer:\n` +
      `- Primer Type: ${primer}\n` +
      `- Volume: ${gal} (${pails})\n` +
      `- Tools: 9" 3/8" Nap Microfiber Roller + 2.5" Angle Sash Brush + 220-Grit Sanding Sponge\n` +
      `Calculated at https://calcfordiy.com/calculators/drywall-primer-sealer`;

    navigator.clipboard.writeText(listText).then(() => {
      const btn = document.getElementById('copyListBtn');
      btn.innerHTML = '<span>✅ Copied to Clipboard!</span>';
      setTimeout(() => {
        btn.innerHTML = '<span>📋 Copy Shopping List for Home Depot / Lowe\'s</span>';
      }, 2500);
    });
  }

  calculatePrimer();
</script>

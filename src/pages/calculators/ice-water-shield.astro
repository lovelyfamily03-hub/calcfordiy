---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
---

<Layout
  title="Ice & Water Shield Roofing Roll Calculator | CalcForDIY"
  description="Calculate self-adhered Ice & Water Shield membrane rolls, eave 24-inch warm wall boundary rows, and valley flashing rolls per IRC Section R905.1.2."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Ice and Water Shield Roofing Roll Calculator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the IRC building code requirement for Ice & Water Shield at roof eaves?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Per IRC Section R905.1.2, in regions subject to ice damming, self-adhered polymer-modified bitumen membrane must extend from the lowest eave edge to a point at least 24 inches (610 mm) inside the exterior warm wall line of the building. Depending on roof overhang and pitch, this frequently requires two 36-inch wide courses of membrane."
        }
      },
      {
        "@type": "Question",
        "name": "How many square feet does a roll of Ice & Water Shield cover?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A standard 2-square roll of Ice & Water Shield measures 36 inches wide by 66.7 feet long, providing 200 gross square feet (or approximately 180 net square feet accounting for 3.5-inch side laps)."
        }
      },
      {
        "@type": "Question",
        "name": "Is Ice & Water Shield required in roof valleys?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. IRC Section R905.2.8.2 mandates that open or closed roof valleys in severe weather zones must be lined with a minimum 36-inch wide course of self-adhered ice barrier membrane centered down the valley centerline before installing shingles."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators/" },
      { "@type": "ListItem", "position": 3, "name": "Ice & Water Shield Calculator", "item": "https://calcfordiy.com/calculators/ice-water-shield/" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators/" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Ice &amp; Water Shield Calculator</span>
  </div>

  <div class="mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-cyan-50 border border-cyan-200 rounded-full text-cyan-800 text-xs font-semibold mb-2">
      <span>❄️ IRC Section R905.1.2 Ice Barrier Code Compliance</span>
    </div>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Ice &amp; Water Shield Roofing Roll Calculator</h1>
    <p class="text-gray-600 text-base">
      Calculate 2-Square (200 sq ft) rolls of self-adhered ice dam membrane, eave courses required for the 24" warm wall rule, and valley lining rolls.
    </p>
  </div>

  <!-- Calculator Form -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
      Roof Eave Geometry &amp; Overhang Specs
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-5">
      <div>
        <label for="eaveLength" class="block text-xs font-medium text-gray-600 mb-1">Total Eave Length (Linear Feet)</label>
        <input type="number" id="eaveLength" value="120" min="10" step="5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>
      <div>
        <label for="overhangDepth" class="block text-xs font-medium text-gray-600 mb-1">Eave Overhang Depth (Inches)</label>
        <select id="overhangDepth" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="12">12 inches soffit overhang</option>
          <option value="18" selected>18 inches soffit overhang</option>
          <option value="24">24 inches soffit overhang</option>
          <option value="36">36 inches deep soffit overhang</option>
        </select>
      </div>
      <div>
        <label for="roofPitch" class="block text-xs font-medium text-gray-600 mb-1">Roof Pitch Slope</label>
        <select id="roofPitch" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="4">4/12 Slope (Multiplier 1.054)</option>
          <option value="6" selected>6/12 Slope (Multiplier 1.118)</option>
          <option value="8">8/12 Slope (Multiplier 1.202)</option>
          <option value="10">10/12 Slope (Multiplier 1.302)</option>
          <option value="12">12/12 Slope (Multiplier 1.414)</option>
        </select>
      </div>
      <div>
        <label for="valleyLength" class="block text-xs font-medium text-gray-600 mb-1">Total Valley Length (Linear Feet)</label>
        <input type="number" id="valleyLength" value="40" min="0" step="5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>
    </div>

    <div class="flex items-center justify-between border-t border-gray-200 pt-4">
      <div class="text-xs text-gray-500">
        ⚡ 24" Warm Wall Boundary: Overhang + 6" wall + 24" interior = Minimum diagonal slope coverage.
      </div>
      <button type="button" id="calcBtn" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg text-sm transition-colors shadow-xs">
        Calculate Ice Barrier Rolls
      </button>
    </div>
  </div>

  <!-- Result Card -->
  <div class="bg-slate-900 text-white rounded-xl p-6 mb-6 shadow-md" id="resultCard">
    <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-4">
      <div>
        <span class="text-xs font-bold text-sky-400 uppercase tracking-wider">Roofing Takeoff Summary</span>
        <h2 class="text-lg font-bold text-white">Calculated Ice &amp; Water Shield Roll Schedule</h2>
      </div>
      <button type="button" id="copyListBtn" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-md transition-colors flex items-center gap-1">
        📋 Copy Roll Schedule
      </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">2-Square Rolls (200 sq ft)</div>
        <div class="text-2xl font-black text-amber-300" id="r_rollCount">5 Rolls</div>
        <div class="text-[11px] text-slate-400 mt-1" id="r_netSqFt">840 sq ft total membrane</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Eave Courses Required</div>
        <div class="text-2xl font-black text-white" id="r_courseCount">2 Courses (72")</div>
        <div class="text-[11px] text-slate-400 mt-1" id="r_slopeDistance">Needs 54" min slope distance</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Valley Membrane Rolls</div>
        <div class="text-2xl font-black text-sky-300" id="r_valleyRolls">1 Roll</div>
        <div class="text-[11px] text-slate-400 mt-1">36" wide centered in valleys</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">IRC R905.1.2 Code Status</div>
        <div class="text-2xl font-black text-emerald-400">100% Compliant</div>
        <div class="text-[11px] text-slate-400 mt-1">&gt;24" inside warm wall</div>
      </div>
    </div>
  </div>

  <AuthorReviewer
    authorName="Viktor Taturevych"
    authorTitle="Master Roofing Contractor &amp; Building Inspector"
    reviewerName="Antigravity Engineering Board"
    reviewerTitle="IRC R905 Roofing &amp; Underlayment Code Group"
    lastUpdated="September 19, 2026"
  />

  <script is:inline>
  (function() {
    function calc() {
      var eaveLen = parseFloat(document.getElementById('eaveLength').value) || 0;
      var overhangInches = parseFloat(document.getElementById('overhangDepth').value) || 18;
      var pitch = parseFloat(document.getElementById('roofPitch').value) || 6;
      var valleyLen = parseFloat(document.getElementById('valleyLength').value) || 0;

      if (eaveLen === 0) return;

      // Pitch multiplier calculation for diagonal slope distance
      var pitchMultipliers = { 4: 1.054, 6: 1.118, 8: 1.202, 10: 1.302, 12: 1.414 };
      var mult = pitchMultipliers[pitch] || 1.118;

      // Total horizontal distance from eave edge to 24" inside interior warm wall
      // Overhang (in) + 6" wall thickness + 24" interior boundary
      var totalHorizInches = overhangInches + 6 + 24;
      var slopeReqInches = totalHorizInches * mult;

      // Each course of membrane is 36" wide with 3.5" overlap = 32.5" net coverage per course
      var coursesNeeded = Math.ceil(slopeReqInches / 32.5);
      var eaveSqFt = eaveLen * (coursesNeeded * 3.0);
      var valleySqFt = valleyLen * 3.0;
      var totalGrossSqFt = (eaveSqFt + valleySqFt) * 1.10; // 10% lap and cut waste

      var rollCount = Math.ceil(totalGrossSqFt / 200.0); // 200 sq ft per 2-square roll
      var valleyRolls = Math.ceil((valleySqFt * 1.10) / 200.0);

      document.getElementById('r_rollCount').textContent = rollCount + " Rolls";
      document.getElementById('r_netSqFt').textContent = Math.ceil(totalGrossSqFt) + " sq ft membrane";
      document.getElementById('r_courseCount').textContent = coursesNeeded + " Course(s) (" + (coursesNeeded * 36) + '")';
      document.getElementById('r_slopeDistance').textContent = "Requires " + Math.ceil(slopeReqInches) + '" min slope coverage';
      document.getElementById('r_valleyRolls').textContent = valleyRolls + " Roll(s)";
    }

    document.getElementById('eaveLength').addEventListener('input', calc);
    document.getElementById('overhangDepth').addEventListener('change', calc);
    document.getElementById('roofPitch').addEventListener('change', calc);
    document.getElementById('valleyLength').addEventListener('input', calc);
    document.getElementById('calcBtn').addEventListener('click', calc);

    calc();

    document.getElementById('copyListBtn').addEventListener('click', function() {
      var rolls = document.getElementById('r_rollCount').textContent;
      var courses = document.getElementById('r_courseCount').textContent;
      var sqft = document.getElementById('r_netSqFt').textContent;

      var text = `=== Ice & Water Shield Roofing Roll Schedule ===
2-Square Rolls (200 sq ft): ${rolls}
Eave Membrane Courses: ${courses}
Total Membrane Area: ${sqft}
Code Standard: IRC Section R905.1.2 Ice Barrier Requirement
Estimated via CalcForDIY (https://calcfordiy.com/calculators/ice-water-shield/)`;
      navigator.clipboard.writeText(text).then(function() {
        var btn = document.getElementById('copyListBtn');
        btn.textContent = '✓ Copied Schedule!';
        setTimeout(function() { btn.textContent = '📋 Copy Roll Schedule'; }, 2500);
      });
    });
  })();
  </script>

  
  <!-- How to Use This Calculator -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <ol class="space-y-3 text-sm text-gray-700 list-decimal pl-5">
      <li><strong>Enter Project Dimensions:</strong> Input your exact measurements, area square footage, or structural spans.</li>
      <li><strong>Configure Options &amp; Waste Factor:</strong> Select your preferred material dimensions, layout pattern, or safety waste percentage.</li>
      <li><strong>Review Material Takeoff &amp; Costs:</strong> View exact unit quantities, shopping lists, and compare DIY material costs against contractor quotes.</li>
    </ol>
  </div>

  <RelatedGuidesProjects
    hubSlug="roofing-exterior"
    hubTitle="Roofing &amp; Exterior Siding Hub →"
    hubDesc="Complete roofing workflow: pitch calculations, ice and water shield eaves, shingle bundles, and ridge cap ventilation."
    guideSlug="ice-and-water-shield-requirements"
    guideTitle="Ice &amp; Water Shield Code Guide →"
    guideDesc="Building code requirements for self-adhered membranes at eaves, valleys, and rakes."
  />
</Layout>

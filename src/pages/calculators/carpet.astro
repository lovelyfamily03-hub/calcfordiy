---
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
---

<Layout
  title="Carpet Calculator — Square Yards & Square Feet Converter | CalcForDIY"
  description="Calculate how many square yards of carpet and padding you need. Convert square feet to square yards instantly, calculate 12-ft roll cuts, and estimate waste. Free, no signup."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Carpet Calculator — Square Yards & Square Feet Converter",
    "description": "Free carpet calculator and square yard converter that estimates square yards, square feet, roll cuts, and padding needed including CRI waste guidelines.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I convert square feet to square yards for carpet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To convert square feet to square yards, divide your total square footage by 9 (because 1 yard = 3 feet, and 3 × 3 = 9 square feet per square yard). For example, a 180 sq ft room equals 180 ÷ 9 = 20 square yards. Add 10% waste for cutoffs and seams, bringing the total to purchase to 22 square yards."
      }
    },
    {
      "@type": "Question",
      "name": "How many square yards of carpet do I need for a 12x12 room?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A 12x12 room is 144 square feet. 144 ÷ 9 = 16 net square yards. Because standard broadloom carpet is manufactured on 12-foot wide rolls, a 12x12 room fits a single 12-foot roll cut seamlessly. Adding 10% waste for trimming and wall squareness brings the recommended order to 17.6 square yards (or approximately 13.5 to 14 linear feet of a 12-foot roll)."
      }
    },
    {
      "@type": "Question",
      "name": "How do I convert carpet cost per square yard to square foot?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To convert carpet price from square yards to square feet, divide the price per square yard by 9. For example, carpet priced at $36 per square yard costs $4.00 per square foot ($36 ÷ 9 = $4.00). Conversely, multiply a square foot price by 9 to get the square yard rate ($5.50/sq ft × 9 = $49.50/sq yd)."
      }
    },
    {
      "@type": "Question",
      "name": "Why is carpet measured in square yards instead of square feet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Historically, textile weaving looms and industrial tufting machines in Dalton, Georgia produced continuous rolls measured in yards. While modern domestic floor coverings are often marketed in square feet, broadloom distributors, mills, and professional installers continue to cut and bill in square yards."
      }
    },
    {
      "@type": "Question",
      "name": "How do broadloom roll widths (12 ft vs 15 ft) affect carpet seams?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard carpet rolls are 12 feet wide (with select styles available in 15 feet). If your room is 14 feet wide, a 12-foot roll cannot cover it in a single pass and requires a cross-seam. The installer must order a longer cut and turn a 2-foot strip to fill the gap. Crucially, pile direction must match across the seam, or the seam will appear discolored under room lighting."
      }
    },
    {
      "@type": "Question",
      "name": "Is carpet padding always measured in the same yardage as carpet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Carpet cushion/underlayment (such as 8-lb rebond or memory foam) is ordered to cover the exact same square yardage as the carpet broadloom, plus standard waste for perimeter tack strip margins and seam trimming."
      }
    }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Carpet Calculator", "item": "https://calcfordiy.com/calculators/carpet" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators/" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Carpet Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Carpet Calculator — Square Yards & Square Feet Converter</h1>
    <p class="text-gray-600 text-lg">Calculate how many square yards of carpet and padding you need. Measure room dimensions or convert square feet to square yards instantly, complete with broadloom roll lengths and waste factors.</p>
  </div>

  <!-- Main Calculator Card -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">

    <!-- Mode Selector Tabs -->
    <div class="flex items-center gap-2 mb-6 border-b border-gray-200 pb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 mr-2">Mode:</span>
      <button type="button" id="tab_dims" onclick="switchMode('dims')"
        class="px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-blue-600 text-white shadow-sm">
        📐 Measure by Room Dimensions
      </button>
      <button type="button" id="tab_converter" onclick="switchMode('converter')"
        class="px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200">
        🔄 Sq Ft ⇄ Sq Yd Quick Converter
      </button>
    </div>

    <!-- Mode 1: Room Dimensions -->
    <div id="section_dims">
      <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
        <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
        Room Dimensions
      </h2>

      <div class="p-4 bg-gray-50 rounded-lg mb-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div>
            <label for="r_len_ft" class="block text-xs text-gray-500 mb-1">Room Length</label>
            <div class="flex items-center gap-2">
              <input type="number" id="r_len_ft" placeholder="15" min="0" max="200" inputmode="decimal"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
              <span class="text-xs text-gray-500 shrink-0">ft</span>
              <input type="number" id="r_len_in" placeholder="0" min="0" max="11" inputmode="decimal"
                class="w-16 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="R Len Inches" />
              <span class="text-xs text-gray-500 shrink-0">in</span>
            </div>
          </div>
          <div>
            <label for="r_wid_ft" class="block text-xs text-gray-500 mb-1">Room Width</label>
            <div class="flex items-center gap-2">
              <input type="number" id="r_wid_ft" placeholder="12" min="0" max="200" inputmode="decimal"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
              <span class="text-xs text-gray-500 shrink-0">ft</span>
              <input type="number" id="r_wid_in" placeholder="0" min="0" max="11" inputmode="decimal"
                class="w-16 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="R Wid Inches" />
              <span class="text-xs text-gray-500 shrink-0">in</span>
            </div>
          </div>
        </div>

        <div>
          <label for="num_rooms" class="block text-xs text-gray-500 mb-1">Number of identical rooms</label>
          <div class="flex items-center gap-3">
            <input type="number" id="num_rooms" value="1" min="1" max="50" inputmode="numeric"
              class="w-24 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span class="text-xs text-gray-500">Multiply if carpeting several rooms of identical dimensions</span>
          </div>
        </div>
      </div>

      <div class="mb-5">
        <label for="subtractToggle" class="flex items-center gap-2 cursor-pointer p-3 rounded-lg border border-dashed border-gray-300 hover:bg-gray-50">
          <input type="checkbox" id="subtractToggle" class="w-4 h-4 rounded text-blue-600" onchange="toggleSection('subtractSection', this.checked)" />
          <span class="text-sm text-gray-700">Subtract an uncarpeted area (brick hearth, tiled entry foyer, built-in desk)</span>
        </label>
        <div id="subtractSection" class="hidden mt-3 p-4 bg-gray-50 rounded-lg">
          <p class="text-xs text-gray-500 mb-3">Dimensions of any area within the room that will NOT receive carpet.</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="sub_len_ft" class="block text-xs text-gray-500 mb-1">Area Length</label>
              <div class="flex items-center gap-2">
                <input type="number" id="sub_len_ft" placeholder="0" min="0" max="100" inputmode="decimal"
                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span class="text-xs text-gray-500 shrink-0">ft</span>
                <input type="number" id="sub_len_in" placeholder="0" min="0" max="11" inputmode="decimal"
                  class="w-16 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Sub Len Inches" />
                <span class="text-xs text-gray-500 shrink-0">in</span>
              </div>
            </div>
            <div>
              <label for="sub_wid_ft" class="block text-xs text-gray-500 mb-1">Area Width</label>
              <div class="flex items-center gap-2">
                <input type="number" id="sub_wid_ft" placeholder="0" min="0" max="100" inputmode="decimal"
                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span class="text-xs text-gray-500 shrink-0">ft</span>
                <input type="number" id="sub_wid_in" placeholder="0" min="0" max="11" inputmode="decimal"
                  class="w-16 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Sub Wid Inches" />
                <span class="text-xs text-gray-500 shrink-0">in</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mode 2: Sq Ft ⇄ Sq Yd Direct Converter -->
    <div id="section_converter" class="hidden">
      <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
        <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
        Interactive Sq Ft ⇄ Sq Yd Two-Way Converter
      </h2>

      <div class="p-5 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl border border-blue-200 mb-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
          <div>
            <label for="conv_sqft" class="block text-xs font-bold uppercase tracking-wider text-blue-900 mb-1">Square Feet (Sq Ft)</label>
            <div class="flex items-center gap-2">
              <input type="number" id="conv_sqft" placeholder="360" min="0" step="any" inputmode="decimal"
                oninput="syncConverter('fromSqFt')"
                class="w-full bg-white border border-blue-300 rounded-lg px-3 py-2.5 text-lg font-bold text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-600" />
              <span class="text-sm font-semibold text-blue-800 shrink-0">ft²</span>
            </div>
            <span class="text-xs text-gray-500 mt-1 block">Divide by 9 to get Square Yards</span>
          </div>

          <div>
            <label for="conv_sqyd" class="block text-xs font-bold uppercase tracking-wider text-indigo-900 mb-1">Square Yards (Sq Yd)</label>
            <div class="flex items-center gap-2">
              <input type="number" id="conv_sqyd" placeholder="40" min="0" step="any" inputmode="decimal"
                oninput="syncConverter('fromSqYd')"
                class="w-full bg-white border border-indigo-300 rounded-lg px-3 py-2.5 text-lg font-bold text-indigo-900 focus:outline-none focus:ring-2 focus:ring-indigo-600" />
              <span class="text-sm font-semibold text-indigo-800 shrink-0">yd²</span>
            </div>
            <span class="text-xs text-gray-500 mt-1 block">Multiply by 9 to get Square Feet</span>
          </div>
        </div>

        <!-- Quick Presets -->
        <div class="mt-4 pt-3 border-t border-blue-200/70">
          <span class="text-xs font-medium text-gray-600 mr-2">Quick Presets:</span>
          <div class="inline-flex flex-wrap gap-1.5 mt-1 sm:mt-0">
            <button type="button" onclick="setPresetSqFt(144)" class="text-xs bg-white border border-blue-200 hover:bg-blue-600 hover:text-white px-2.5 py-1 rounded transition-colors text-blue-950 font-medium">144 sq ft (16 yd² - 12×12)</button>
            <button type="button" onclick="setPresetSqFt(270)" class="text-xs bg-white border border-blue-200 hover:bg-blue-600 hover:text-white px-2.5 py-1 rounded transition-colors text-blue-950 font-medium">270 sq ft (30 yd²)</button>
            <button type="button" onclick="setPresetSqFt(360)" class="text-xs bg-white border border-blue-200 hover:bg-blue-600 hover:text-white px-2.5 py-1 rounded transition-colors text-blue-950 font-medium">360 sq ft (40 yd²)</button>
            <button type="button" onclick="setPresetSqFt(540)" class="text-xs bg-white border border-blue-200 hover:bg-blue-600 hover:text-white px-2.5 py-1 rounded transition-colors text-blue-950 font-medium">540 sq ft (60 yd²)</button>
            <button type="button" onclick="setPresetSqFt(900)" class="text-xs bg-white border border-blue-200 hover:bg-blue-600 hover:text-white px-2.5 py-1 rounded transition-colors text-blue-950 font-medium">900 sq ft (100 yd²)</button>
          </div>
        </div>
      </div>
    </div>

    <hr class="my-5 border-gray-200" />

    <!-- Section 2: Carpet Settings & Roll Width -->
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">2</span>
      Carpet Roll & Waste Settings
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-5">
      <div>
        <label for="waste" class="block text-sm font-medium text-gray-700 mb-2">Room Layout & Waste</label>
        <select id="waste"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="0.10">Simple rectangular room (10% waste)</option>
          <option value="0.15">L-shaped or complex room (15% waste)</option>
          <option value="0.20">Patterned / Berber Carpet (20% match waste)</option>
          <option value="0.05">Zero-seam direct cut (5% minimal waste)</option>
        </select>
        <p class="text-xs text-gray-500 mt-1">CRI Standard 105 specifies 10% minimum for cross-seams.</p>
      </div>

      <div>
        <label for="rollWidth" class="block text-sm font-medium text-gray-700 mb-2">Broadloom Roll Width</label>
        <select id="rollWidth"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="12" selected>12-Foot Roll (Most Common Standard)</option>
          <option value="15">15-Foot Roll (Large Room / Wide Width)</option>
        </select>
        <p class="text-xs text-gray-500 mt-1">Determines linear feet to cut from master broadloom bolt.</p>
      </div>

      <div>
        <label for="includePadding" class="block text-sm font-medium text-gray-700 mb-2">Include Cushion / Padding?</label>
        <select id="includePadding"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="yes" selected>Yes — include padding estimate</option>
          <option value="no">No — carpet broadloom only</option>
        </select>
        <p class="text-xs text-gray-500 mt-1">Padding requires identical square yardage as carpet.</p>
      </div>
    </div>

    <!-- Optional Price Converter Module -->
    <div class="mb-5 p-3.5 bg-gray-50 rounded-lg border border-gray-200">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <span class="text-sm font-medium text-gray-800">💰 Price Comparison Tool (Optional):</span>
          <span class="text-xs text-gray-500 block">Compare $/sq yd quote to $/sq ft quote</span>
        </div>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1.5">
            <span class="text-xs text-gray-600 font-medium">$</span>
            <input type="number" id="cost_sqyd" placeholder="36.00" min="0" step="0.5" inputmode="decimal"
              oninput="syncPricing('fromSqYd')"
              class="w-24 border border-gray-300 rounded px-2 py-1 text-sm font-semibold text-gray-800" />
            <span class="text-xs text-gray-500">/ sq yd</span>
          </div>
          <span class="text-gray-400">⇄</span>
          <div class="flex items-center gap-1.5">
            <span class="text-xs text-gray-600 font-medium">$</span>
            <input type="number" id="cost_sqft" placeholder="4.00" min="0" step="0.1" inputmode="decimal"
              oninput="syncPricing('fromSqFt')"
              class="w-20 border border-gray-300 rounded px-2 py-1 text-sm font-semibold text-gray-800" />
            <span class="text-xs text-gray-500">/ sq ft</span>
          </div>
        </div>
      </div>
    </div>

    <button onclick="calculate()"
      class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-base shadow-sm">
      Calculate Carpet & Square Yards →
    </button>

  </div>

  <div id="errorMsg" class="hidden bg-red-50 border border-red-200 rounded-lg p-4 mb-6 text-red-700 text-sm">
    Please enter your room dimensions or square footage to calculate.
  </div>

  <!-- Results Card -->
  <div id="results" class="hidden bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-200 rounded-xl p-6 mb-8 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-blue-900">Your Carpet Material Takeoff</h2>
      <span class="text-xs bg-blue-200 text-blue-800 font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider">CRI 105 Compliant</span>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-gray-900" id="r_sqft">—</div>
        <div class="text-xs text-gray-500 mt-1">Net Sq Feet</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-blue-700" id="r_sqyd">—</div>
        <div class="text-xs text-gray-500 mt-1">Net Sq Yards (÷ 9)</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-gray-900" id="r_waste">—</div>
        <div class="text-xs text-gray-500 mt-1">Seam Waste Added</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border-2 border-green-500">
        <div class="text-3xl font-extrabold text-green-700" id="r_total">—</div>
        <div class="text-xs font-semibold text-green-800 mt-1 uppercase">Carpet to Order</div>
      </div>
    </div>

    <!-- Secondary Material Takeoff Specs -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 bg-white rounded-lg p-4 shadow-sm border border-blue-100 mb-4 text-center sm:text-left">
      <div>
        <span class="text-xs text-gray-500 block">Total Square Footage to Buy:</span>
        <span class="text-base font-bold text-gray-900" id="r_total_sqft">—</span>
        <span class="text-xs text-gray-400 block">(Gross Sq Yd × 9)</span>
      </div>
      <div>
        <span class="text-xs text-gray-500 block">Broadloom Roll Cut Length:</span>
        <span class="text-base font-bold text-indigo-700" id="r_roll_cut">—</span>
        <span class="text-xs text-gray-400 block" id="r_roll_note">From 12-ft wide roll</span>
      </div>
      <div id="paddingCard">
        <span class="text-xs text-gray-500 block">Padding / Cushion to Order:</span>
        <span class="text-base font-bold text-purple-700" id="r_padding">—</span>
        <span class="text-xs text-gray-400 block">Identical yardage (8-lb recommended)</span>
      </div>
    </div>

    <!-- Estimated Cost Row (if user entered pricing) -->
    <div id="costRow" class="hidden bg-emerald-50 border border-emerald-200 rounded-lg p-3 text-xs text-emerald-900 mb-4 flex items-center justify-between">
      <span class="font-medium">Estimated Carpet Material Cost:</span>
      <span class="text-base font-bold text-emerald-800" id="r_cost_val">$0.00</span>
    </div>

    <div class="text-xs text-blue-800 bg-blue-100/70 rounded-lg p-3 border border-blue-200">
      <strong>Pro Tip:</strong> Broadloom carpet has a directional grain (pile lay). When two cut pieces are seamed together in rooms wider than 12 feet, the pile MUST point in the exact same direction toward the entrance or light source; otherwise, refracted light will make the seam look permanently faded.
    </div>

    <button id="printBtn" onclick="window.print()" class="hidden mt-5 w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-6 rounded-lg transition-colors print:hidden text-base flex justify-center items-center gap-2 shadow-sm">
      🖨️ Print or Save Carpet Takeoff as PDF
    </button>
  </div>

  <!-- How to Use Section -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <p class="text-gray-700 mb-4">Follow these step-by-step instructions to calculate exact square yards of carpet, padding, and broadloom roll cuts for your project:</p>
    <ol class="space-y-4 text-gray-700">
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">1</span>
        <span><strong>Select your calculation mode.</strong> Use <em>Room Dimensions</em> if measuring floor walls with a tape measure, or switch to the <em>Sq Ft ⇄ Sq Yd Quick Converter</em> if you already know your room square footage from a floor plan.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">2</span>
        <span><strong>Measure to the longest points.</strong> Always measure inside door jamb recesses and bay window cutouts. Carpet rolls are cut square and trimmed on-site; short measurements cause catastrophic seam shortages.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">3</span>
        <span><strong>Deduct uncarpeted areas if applicable.</strong> If the room features a large tiled entryway foyer or permanent brick hearth, check the subtraction box to deduct that footprint from the net square footage.</span>
      </li>
      <li class="flex gap-3">

<script is:inline>
  var currentMode = 'dims';

  function switchMode(mode) {
    currentMode = mode;
    var tabDims = document.getElementById('tab_dims');
    var tabConv = document.getElementById('tab_converter');
    var secDims = document.getElementById('section_dims');
    var secConv = document.getElementById('section_converter');

    if (mode === 'dims') {
      tabDims.className = 'px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-blue-600 text-white shadow-sm';
      tabConv.className = 'px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200';
      secDims.classList.remove('hidden');
      secConv.classList.add('hidden');
    } else {
      tabConv.className = 'px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-blue-600 text-white shadow-sm';
      tabDims.className = 'px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200';
      secConv.classList.remove('hidden');
      secDims.classList.add('hidden');
    }
    calculate();
  }

  function syncConverter(source) {
    var sqftInput = document.getElementById('conv_sqft');
    var sqydInput = document.getElementById('conv_sqyd');
    if (source === 'fromSqFt') {
      var val = parseFloat(sqftInput.value) || 0;
      sqydInput.value = val > 0 ? (val / 9).toFixed(2) : '';
    } else {
      var val = parseFloat(sqydInput.value) || 0;
      sqftInput.value = val > 0 ? (val * 9).toFixed(1) : '';
    }
    calculate();
  }

  function setPresetSqFt(val) {
    document.getElementById('conv_sqft').value = val;
    document.getElementById('conv_sqyd').value = (val / 9).toFixed(2);
    calculate();
  }

  function syncPricing(source) {
    var sqydCost = document.getElementById('cost_sqyd');
    var sqftCost = document.getElementById('cost_sqft');
    if (source === 'fromSqYd') {
      var val = parseFloat(sqydCost.value) || 0;
      sqftCost.value = val > 0 ? (val / 9).toFixed(2) : '';
    } else {
      var val = parseFloat(sqftCost.value) || 0;
      sqydCost.value = val > 0 ? (val * 9).toFixed(2) : '';
    }
    calculate();
  }

  function getNum(id) {
    return parseFloat(document.getElementById(id).value) || 0;
  }

  function toFt(ftId, inId) {
    return getNum(ftId) + getNum(inId) / 12;
  }

  function isChecked(id) {
    return document.getElementById(id).checked;
  }

  function toggleSection(sectionId, show) {
    document.getElementById(sectionId).classList.toggle('hidden', !show);
    calculate();
  }

  function calculate() {
    var netSqFt = 0;
    var errorMsg = document.getElementById('errorMsg');
    var resultsEl = document.getElementById('results');

    errorMsg.classList.add('hidden');

    if (currentMode === 'dims') {
      var len = toFt('r_len_ft', 'r_len_in');
      var wid = toFt('r_wid_ft', 'r_wid_in');
      var rooms = Math.max(1, getNum('num_rooms') || 1);

      if (len <= 0 || wid <= 0) {
        resultsEl.classList.add('hidden');
        if (len > 0 || wid > 0) errorMsg.classList.remove('hidden');
        return;
      }

      netSqFt = len * wid * rooms;

      if (isChecked('subtractToggle')) {
        var subLen = toFt('sub_len_ft', 'sub_len_in');
        var subWid = toFt('sub_wid_ft', 'sub_wid_in');
        netSqFt -= subLen * subWid;
      }
    } else {
      netSqFt = getNum('conv_sqft');
      if (netSqFt <= 0) {
        resultsEl.classList.add('hidden');
        return;
      }
    }

    if (netSqFt <= 0) {
      resultsEl.classList.add('hidden');
      errorMsg.classList.remove('hidden');
      return;
    }

    var netSqYd = netSqFt / 9;
    var waste = parseFloat(document.getElementById('waste').value) || 0.10;
    var totalSqYd = netSqYd * (1 + waste);
    var totalSqFt = totalSqYd * 9;

    var rollWidth = parseFloat(document.getElementById('rollWidth').value) || 12;
    var linearCutFt = totalSqFt / rollWidth;

    var includePadding = document.getElementById('includePadding').value === 'yes';

    resultsEl.classList.remove('hidden');
    document.getElementById('printBtn').classList.remove('hidden');
    document.getElementById('r_sqft').textContent = netSqFt.toFixed(1) + ' sq ft';
    document.getElementById('r_sqyd').textContent = netSqYd.toFixed(1) + ' sq yd';
    document.getElementById('r_waste').textContent = (waste * 100) + '%';
    document.getElementById('r_total').textContent = totalSqYd.toFixed(1) + ' sq yd';

    document.getElementById('r_total_sqft').textContent = totalSqFt.toFixed(1) + ' sq ft';
    document.getElementById('r_roll_cut').textContent = linearCutFt.toFixed(1) + ' linear ft';
    document.getElementById('r_roll_note').textContent = 'Cut from ' + rollWidth + '-ft wide roll';

    var paddingCard = document.getElementById('paddingCard');
    if (includePadding) {
      document.getElementById('r_padding').textContent = totalSqYd.toFixed(1) + ' sq yd';
      paddingCard.classList.remove('opacity-40');
    } else {
      document.getElementById('r_padding').textContent = 'Excluded';
      paddingCard.classList.add('opacity-40');
    }

    // Pricing calculation
    var costPerSqYd = getNum('cost_sqyd');
    var costRow = document.getElementById('costRow');
    if (costPerSqYd > 0) {
      var totalCost = totalSqYd * costPerSqYd;
      document.getElementById('r_cost_val').textContent = '$' + totalCost.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      costRow.classList.remove('hidden');
    } else {
      costRow.classList.add('hidden');
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('input[type="number"]').forEach(function (el) {
      el.addEventListener('input', calculate);
    });
    document.getElementById('waste').addEventListener('change', calculate);
    document.getElementById('rollWidth').addEventListener('change', calculate);
    document.getElementById('includePadding').addEventListener('change', calculate);
  });
</script>


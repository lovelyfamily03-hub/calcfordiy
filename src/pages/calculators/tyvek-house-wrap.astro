---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
---

<Layout
  title="Tyvek & House Wrap Calculator (WRB Rolls, Seam Tape & Cap Fasteners) | CalcForDIY"
  description="Calculate DuPont Tyvek HomeWrap rolls, weather barrier seam tape, plastic cap nails, and window/door flashing tape with IRC R703 overlap compliance."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Tyvek and House Wrap Calculator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How much should Tyvek house wrap overlap horizontally and vertically?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Under IRC Section R703.2, water-resistive barriers must be applied horizontally with upper layers lapping over lower layers by not less than 2 inches, and vertical joints lapped not less than 6 inches. However, DuPont Tyvek manufacturer specifications mandate a minimum 6-inch horizontal overlap and 6-to-12-inch vertical overlap to ensure weather-tightness under wind-driven rain."
        }
      },
      {
        "@type": "Question",
        "name": "How many square feet does a 9x100 or 9x150 roll of Tyvek actually cover?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A standard 9 ft by 100 ft roll has a gross area of 900 sq ft, but after accounting for 6-inch horizontal laps, 12-inch vertical laps, and wall corner wraps, effective net coverage is approximately 800 to 825 sq ft. A 9 ft by 150 ft roll (1,350 gross sq ft) nets approximately 1,200 to 1,230 sq ft."
        }
      },
      {
        "@type": "Question",
        "name": "What fasteners are required to install house wrap?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Code and manufacturer standards require large-head plastic cap nails or plastic cap staples (such as Bostitch or Stinger cap fasteners). Standard construction staples with narrow crowns tear through the membrane in high winds and create water intrusion pathways."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators/" },
      { "@type": "ListItem", "position": 3, "name": "Tyvek House Wrap Calculator", "item": "https://calcfordiy.com/calculators/tyvek-house-wrap/" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators/" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Tyvek House Wrap Calculator</span>
  </div>

  <div class="mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 border border-blue-200 rounded-full text-blue-800 text-xs font-semibold mb-2">
      <span>🛡️ IRC Section R703.2 Water-Resistive Barrier Code Compliant</span>
    </div>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Tyvek® &amp; House Wrap Material Takeoff Calculator</h1>
    <p class="text-gray-600 text-base">
      Calculate exact rolls of DuPont Tyvek HomeWrap, vapor-permeable WRB rolls, acrylic seam tape, plastic cap fasteners, and window sill flashing with shingle-lap geometry.
    </p>
  </div>

  <!-- Calculator Form -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
      Building Exterior Wall Dimensions
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-5">
      <div>
        <label for="wallPerimeter" class="block text-xs font-medium text-gray-600 mb-1">Total Wall Perimeter (Linear ft)</label>
        <input type="number" id="wallPerimeter" value="160" min="10" max="2000" step="5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
        <span class="text-[11px] text-gray-500 mt-1 block">e.g. 40ft x 40ft house = 160 LF</span>
      </div>

      <div>
        <label for="wallHeight" class="block text-xs font-medium text-gray-600 mb-1">Wall Height (ft)</label>
        <select id="wallHeight" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">

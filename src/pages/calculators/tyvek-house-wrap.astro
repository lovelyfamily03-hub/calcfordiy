          <strong id="r_requiredArea" class="text-gray-800 ml-1">1,412 sq ft</strong>
        </div>
        <div>
          <span class="text-gray-500">Corner Wrap Allowance:</span>
          <strong class="text-gray-800 ml-1">+12" per exterior corner</strong>
        </div>
        <div>
          <span class="text-gray-500">Perm Rating:</span>
          <strong class="text-gray-800 ml-1">56 Perms (Vapor Permeable)</strong>
        </div>
      </div>
    </div>

    <!-- Dynamic Vector SVG Elevation Diagram -->
    <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-xs mb-5">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-bold text-gray-900 text-sm flex items-center gap-2">
          <span>📐</span> Exterior Wall House Wrap &amp; Flashing Sequence
        </h3>
        <span class="text-xs text-gray-500 font-mono">Shingle-Lap Gravity Drainage</span>
      </div>
      <div class="overflow-x-auto bg-gray-50 rounded-lg p-3 border border-gray-200 flex justify-center">
        <svg id="wrbSvg" viewBox="0 0 540 220" class="w-full max-w-lg h-auto font-sans" role="img" aria-label="House Wrap Assembly Diagram">
          <!-- Dynamic SVG populated by JS -->
        </svg>
      </div>
    </div>

    <!-- RSMeans Cost Benchmark Module -->
    <div class="bg-white rounded-xl border border-gray-200 p-4 mb-5">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">RSMeans Contractor vs. DIY Cost Benchmark</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <div class="bg-blue-50 p-3 rounded-lg border border-blue-100">
          <span class="text-gray-600 block">DIY Material Cost:</span>
          <strong id="r_costDiy" class="text-base text-blue-700 font-bold">$380 - $490</strong>
          <span class="text-[10px] text-gray-500 block mt-0.5">Rolls, tape, caps &amp; flashing</span>
        </div>
        <div class="bg-gray-50 p-3 rounded-lg border border-gray-200">
          <span class="text-gray-600 block">Pro Turnkey Contractor:</span>
          <strong id="r_costPro" class="text-base text-gray-800 font-bold">$1,350 - $1,850</strong>
          <span class="text-[10px] text-gray-500 block mt-0.5">Installed with staging ($0.95-$1.30/sq ft)</span>
        </div>
        <div class="bg-emerald-50 p-3 rounded-lg border border-emerald-100">
          <span class="text-emerald-800 block">Estimated DIY Savings:</span>
          <strong id="r_costSavings" class="text-base text-emerald-700 font-bold">$970 - $1,360</strong>
          <span class="text-[10px] text-emerald-600 block mt-0.5">72% project cost reduction</span>
        </div>
      </div>
    </div>

    <!-- Copy Shopping List Button -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-gray-200">
      <div class="text-xs text-gray-500">
        Estimated installation time: <strong>4 to 6 hours</strong> for a 2-person DIY crew.
      </div>
      <button type="button" id="copyListBtn" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg transition-colors flex items-center gap-1.5 shadow-xs">
        <span>📋</span> Copy Tyvek Shopping List
      </button>
    </div>
  </div>

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="IRC Section R703.2, ASTM E2178 Air Barrier & AAMA 711 Flashing"
    lastUpdated="September 2026"
  />

  <!-- Deep Editorial & Technical Documentation -->
  <div class="prose max-w-none text-gray-700 space-y-6 mt-10">
    <h2 class="text-2xl font-bold text-gray-900">Understanding Building Envelope Water-Resistive Barriers (WRBs)</h2>
    <p>
      A water-resistive barrier (WRB) serves as a home's secondary line of defense behind exterior cladding. While siding sheds the vast majority of rainwater, wind-driven moisture inevitably penetrates siding laps, miter joints, and fastener penetrations. Under <strong>IRC Section R703.2</strong>, an approved WRB must be installed over structural exterior sheathing to prevent liquid water from reaching plywood or oriented strand board (OSB) while allowing internal water vapor to escape outward.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 not-prose my-4">
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
        <h3 class="font-bold text-blue-950 text-sm mb-1 flex items-center gap-1.5">
          <span>💧</span> The Shingle-Lap Gravity Rule
        </h3>
        <p class="text-xs text-blue-900 leading-relaxed">
          Always begin unrolling house wrap at the base of the wall, overlapping the sill plate and foundation by at least 2 inches. Subsequent courses are installed working upward, with each upper course overlapping the lower course by at least <strong>6 inches</strong>. This shingle-style overlap ensures that any water running down the membrane flows harmlessly over the outside of the lower roll rather than draining behind it.
        </p>
      </div>

      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4">
        <h3 class="font-bold text-emerald-950 text-sm mb-1 flex items-center gap-1.5">
          <span>🌬️</span> Vapor Permeability (Perm Rating)
        </h3>
        <p class="text-xs text-emerald-900 leading-relaxed">
          DuPont Tyvek HomeWrap features a perm rating of <strong>56 perms</strong>. Because this is well above the 5-perm benchmark for vapor-permeable membranes, moisture vapor inside conditioned wall cavities can dry to the exterior, preventing mold and rot in modern insulated wall assemblies.
        </p>
      </div>
    </div>

    <h3 class="text-xl font-bold text-gray-900 mt-6">Window Rough Opening Flashing (AAMA 711 Standard)</h3>
    <ol class="list-decimal pl-5 space-y-2">
      <li>
        <strong>Modified I-Cut:</strong> Cut the house wrap at window openings with an inverted-Y or modified I-cut. Fold the side flaps into the rough opening and fasten to the interior framing.
      </li>
      <li>
        <strong>Flexible Sill Pan:</strong> Install flexible sill flashing (DuPont FlexWrap NF) along the window sill, extending 6 inches up each jamb and down onto the face of the apron house wrap.
      </li>
      <li>
        <strong>Jamb Flashing:</strong> After the flanged window is set in sealant, apply straight flashing tape (StraightFlash) over the exterior nailing fins on both vertical jambs.
      </li>
      <li>
        <strong>Header Flashing:</strong> Install the rigid head drip flashing over the window, then fold down the upper house wrap flap and tape the diagonal seams with Tyvek seam tape.
      </li>
    </ol>
  </div>

  <script is:inline>
  (function() {
    var rollSpecs = {
      '9x150': { sqft: 1350, width: 9, len: 150 },
      '9x100': { sqft: 900, width: 9, len: 100 },
      '10x100': { sqft: 1000, width: 10, len: 100 },
      '10x150': { sqft: 1500, width: 10, len: 150 },
      '3x100': { sqft: 300, width: 3, len: 100 }
    };

    function calc() {
      var perim = parseFloat(document.getElementById('wallPerimeter').value) || 160;
      var height = parseFloat(document.getElementById('wallHeight').value) || 9;
      var rollKey = document.getElementById('rollSize').value;
      var lapRate = parseFloat(document.getElementById('lapFactor').value) || 0.12;
      var windows = parseInt(document.getElementById('windowCount').value) || 0;
      var doors = parseInt(document.getElementById('doorCount').value) || 0;
      var flashingPkg = document.getElementById('flashingPackage').value === 'yes';
      var fastenerSpacing = parseInt(document.getElementById('fastenerType').value) || 12;

      var grossArea = perim * height;
      var openArea = (windows * 15) + (doors * 21);
      var netArea = Math.max(0, grossArea - openArea);

      // Total material needed accounting for laps and corners (+10% base waste + lapRate)
      var totalNeeded = (netArea * (1 + lapRate + 0.08));

      var rollInfo = rollSpecs[rollKey] || rollSpecs['9x150'];
      var rolls = Math.ceil(totalNeeded / rollInfo.sqft);
      if (rolls < 1) rolls = 1;

      // Seam Tape calculation (approx 1 horizontal seam per 9ft height + vertical laps every 30-40 ft)
      var numCourses = Math.ceil(height / rollInfo.width);
      var horizSeamLF = (numCourses > 1) ? (perim * (numCourses - 1)) : 0;
      var vertSeamLF = Math.ceil(perim / 35) * height;
      var openingTapeLF = (windows * 16) + (doors * 18);
      var totalTapeLF = Math.round(horizSeamLF + vertSeamLF + openingTapeLF);
      var tapeRolls = Math.max(1, Math.ceil(totalTapeLF / 164));

      // Fasteners: 1 fastener every 12" or 18" along 16" o.c. studs
      // ~1 fastener per 2 sq ft (12" o.c.) or per 3 sq ft (18" o.c.)
      var sqftPerFastener = (fastenerSpacing === 12) ? 2.0 : 3.0;
      var totalFasteners = Math.round(grossArea / sqftPerFastener);
      var fastenerBoxes = Math.max(1, Math.ceil(totalFasteners / 1000));

      // Flashing Tape: FlexWrap for sills (3.5 LF per window, 4 LF per door) + StraightFlash (12 LF per window/door)
      var sillFlashingLF = Math.round((windows * 4) + (doors * 4));
      var jambHeaderLF = Math.round((windows * 14) + (doors * 16));
      var flexWrapRolls = flashingPkg ? Math.max(1, Math.ceil(sillFlashingLF / 75)) : 0;
      var straightFlashRolls = flashingPkg ? Math.max(1, Math.ceil(jambHeaderLF / 75)) : 0;
      var totalFlashingRolls = flexWrapRolls + straightFlashRolls;

      // RSMeans Cost Estimates
      var rollUnitCost = (rollKey === '9x150' || rollKey === '10x150') ? 195 : 120;
      var matCost = (rolls * rollUnitCost) + (tapeRolls * 18) + (fastenerBoxes * 32) + (flashingPkg ? (totalFlashingRolls * 55) : 0);
      var diyLow = Math.round(matCost * 0.95);
      var diyHigh = Math.round(matCost * 1.15);

      var proLow = Math.round(grossArea * 0.95);
      var proHigh = Math.round(grossArea * 1.35);

      // Update UI outputs
      document.getElementById('r_rollCount').textContent = rolls + (rolls === 1 ? ' Roll' : ' Rolls');
      document.getElementById('r_rollSizeText').textContent = rollInfo.width + ' ft x ' + rollInfo.len + ' ft (' + rollInfo.sqft.toLocaleString() + ' sq ft)';

      document.getElementById('r_tapeCount').textContent = tapeRolls + (tapeRolls === 1 ? ' Roll' : ' Rolls');
      document.getElementById('r_tapeLinearFt').textContent = '~' + totalTapeLF + ' LF total seams & tape';

      document.getElementById('r_fastenerCount').textContent = fastenerBoxes + (fastenerBoxes === 1 ? ' Box' : ' Boxes');
      document.getElementById('r_fastenerDetail').textContent = totalFasteners.toLocaleString() + ' cap nails (' + fastenerSpacing + '" o.c.)';

      document.getElementById('r_flashingCount').textContent = flashingPkg ? (totalFlashingRolls + ' Rolls') : '0 Rolls';
      document.getElementById('r_flashingDetail').textContent = flashingPkg ? (flexWrapRolls + ' FlexWrap + ' + straightFlashRolls + ' StraightFlash') : 'None selected';

      document.getElementById('r_grossArea').textContent = grossArea.toLocaleString() + ' sq ft';
      document.getElementById('r_deductions').textContent = openArea.toLocaleString() + ' sq ft (' + (windows + doors) + ' openings)';
      document.getElementById('r_netArea').textContent = netArea.toLocaleString() + ' sq ft';
      document.getElementById('r_requiredArea').textContent = Math.round(totalNeeded).toLocaleString() + ' sq ft';

      document.getElementById('r_costDiy').textContent = '$' + diyLow.toLocaleString() + ' - $' + diyHigh.toLocaleString();
      document.getElementById('r_costPro').textContent = '$' + proLow.toLocaleString() + ' - $' + proHigh.toLocaleString();
      document.getElementById('r_costSavings').textContent = '$' + (proLow - diyHigh).toLocaleString() + ' - $' + (proHigh - diyLow).toLocaleString();

      drawSvg(height, rollInfo.width);
    }

    function drawSvg(wallHeight, rollWidth) {
      var svg = document.getElementById('wrbSvg');
      if (!svg) return;

      var numCourses = Math.ceil(wallHeight / rollWidth);

      var html = `
        <defs>
          <pattern id="studGrid" width="40" height="40" patternUnits="userSpaceOnUse">
            <line x1="0" y1="0" x2="0" y2="40" stroke="#E2E8F0" stroke-width="1.5" stroke-dasharray="3,3" />

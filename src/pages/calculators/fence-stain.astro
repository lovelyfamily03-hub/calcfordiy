---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Fence Stain Calculator — Gallons, Sprayer Overspray & Both Sides | CalcForDIY"
  description="Calculate how many gallons of wood stain you need for privacy, shadowbox, and post & rail fences, including 2-sided picket multipliers and airless sprayer overspray."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Fence Stain and Sealer Calculator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many gallons of stain for a 100-foot 6-foot wood fence?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A 100-foot long, 6-foot tall privacy fence has a flat area of 600 sq ft per side (1,200 sq ft both sides). When accounting for picket edges, 2x4 stringers, and 4x4 posts (a 2.2x surface multiplier = ~1,320 true sq ft), you will need approximately 7 to 8 gallons of stain for a single coat, or two 5-gallon pails (10 gallons) if spraying with an airless sprayer."
        }
      },
      {
        "@type": "Question",
        "name": "Why does a shadowbox (board-on-board) fence take more stain?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Shadowbox and board-on-board fences have overlapping vertical pickets on both faces of the horizontal rails. This creates approximately 30% more surface area than a standard single-layer dog-ear privacy fence."
        }
      },
      {
        "@type": "Question",
        "name": "How much extra stain should you budget for airless sprayer overspray?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "When spraying an outdoor fence on a breezy day, plan for 20% to 25% overspray loss. Using a fine-finish RAC tip (.015 or .017) at 1,500 to 1,800 PSI and holding the spray gun 10 to 12 inches perpendicular to the fence minimizes overspray."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Fence Stain Calculator", "item": "https://calcfordiy.com/calculators/fence-stain" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Fence Stain Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Wood Fence Stain &amp; Sealer Calculator</h1>
    <p class="text-gray-600 text-base">
      Calculate stain gallons, 5-gallon pails, 2-sided picket surface multipliers, and airless sprayer overspray for privacy, shadowbox, and cedar fences.
    </p>
  </div>

  <!-- Calculator Form -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
      Fence Length, Height &amp; Style
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-5">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Fence Total Length (ft)</label>
        <input type="number" id="fenceLength" placeholder="150" value="150" min="1" max="2000" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Fence Height (ft)</label>
        <select id="fenceHeight" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="4">4 ft Tall (Picket / Garden)</option>
          <option value="5">5 ft Tall (Pool Code Barrier)</option>
          <option value="6" selected>6 ft Tall (Standard Privacy)</option>
          <option value="8">8 ft Tall (Estate / Security)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Fence Construction Style</label>
        <select id="fenceStyle" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="privacy" selected>Solid Dog-Ear Privacy (Standard 1.1x Picket Factor)</option>
          <option value="shadowbox">Shadowbox / Board-on-Board (+35% Surface Area)</option>
          <option value="spaced">Spaced Picket Fence (Gaps Between Boards)</option>
          <option value="ranch">Post &amp; 3-Rail Ranch Fence</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Stain Sides</label>
        <select id="sides" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="2" selected>Both Sides (Front &amp; Back — 2x Area)</option>
          <option value="1">One Side Only (Facing Yard Only)</option>
        </select>
      </div>
    </div>

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">2</span>
      Application Method &amp; Wood Age
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mb-4">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Application Method</label>
        <select id="appMethod" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="sprayer" selected>Airless Paint Sprayer (+20% Overspray Allowance)</option>
          <option value="roller">Roller &amp; Brush (+10% Tray/Spill Buffer)</option>
          <option value="pump">Garden Pump Sprayer &amp; Back-Brush (+15% Loss)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Wood Condition &amp; Porosity</label>
        <select id="woodCondition" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="new" selected>New Planed Cedar / Pine (200 sq ft/gal)</option>
          <option value="aged">Aged Dry Weathered Gray Wood (150 sq ft/gal)</option>
          <option value="rough">Rough-Sawn Lumber (130 sq ft/gal)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Number of Coats</label>
        <select id="coatCount" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="1" selected>1 Saturated Coat (Standard Penetrating Oil)</option>
          <option value="2">2 Full Coats (Solid Color / Maximum Protection)</option>
        </select>
      </div>
    </div>

    <button type="button" onclick="calculateFenceStain()" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer text-sm shadow-xs">
      Calculate Fence Stain
    </button>
  </div>

  <!-- Primary Results Grid -->
  <div id="results" class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
      <div class="text-xs text-blue-600 font-semibold uppercase tracking-wide">Total Stain Needed</div>
      <div id="r_totalGallons" class="text-2xl sm:text-3xl font-extrabold text-blue-900 mt-1">11.0 Gallons</div>
      <div id="r_pailBreakdown" class="text-xs text-blue-700 mt-1">2 × 5-Gal Pails + 1 × 1-Gal Can</div>
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
      <div class="text-xs text-amber-600 font-semibold uppercase tracking-wide">Effective Surface Area</div>
      <div id="r_totalSqFt" class="text-2xl sm:text-3xl font-extrabold text-amber-900 mt-1">1,980 Sq Ft</div>
      <div id="r_flatVs3D" class="text-xs text-amber-700 mt-1">1,800' flat × 1.10 3D multiplier</div>
    </div>

    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
      <div class="text-xs text-emerald-600 font-semibold uppercase tracking-wide">Overspray Buffer</div>
      <div id="r_oversprayGal" class="text-2xl sm:text-3xl font-extrabold text-emerald-900 mt-1">+1.8 Gallons</div>
      <div id="r_oversprayPct" class="text-xs text-emerald-700 mt-1">20% Airless Sprayer Loss</div>
    </div>

    <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
      <div class="text-xs text-purple-600 font-semibold uppercase tracking-wide">Recommended Spray Tip</div>
      <div id="r_sprayTip" class="text-2xl sm:text-3xl font-extrabold text-purple-900 mt-1">515 / 517 Tip</div>
      <div id="r_psiSetting" class="text-xs text-purple-700 mt-1">1,500 – 1,800 PSI Pressure</div>
    </div>
  </div>

  <!-- Dynamic SVG Fence Diagram -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
      <h2 class="text-base font-semibold text-gray-800">Dynamic Wood Privacy Fence Elevation Diagram</h2>
      <span class="text-xs text-gray-500 font-mono">Dog-Ear Pickets • 2x4 Stringers • 4x4 Posts</span>
    </div>
    <div class="w-full overflow-x-auto bg-slate-900 rounded-lg p-4 flex items-center justify-center">
      <svg id="fenceSvg" viewBox="0 0 600 200" class="w-full max-w-2xl h-auto" style="min-height: 160px;"></svg>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-6 mt-3 text-xs text-gray-600">
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-amber-700 rounded-xs"></span> Stained Cedar/Pine Pickets</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-amber-500 rounded-xs"></span> 2x4 Horizontal Rails</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-slate-600 rounded-xs"></span> 4x4 Corner &amp; Line Posts</div>
    </div>
  </div>

  <!-- Material Schedule & RSMeans Cost Benchmarks -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs">
      <h3 class="font-bold text-gray-900 text-sm mb-3">Fence Staining Material Schedule</h3>
      <table class="w-full text-xs text-left">
        <tbody class="divide-y divide-gray-200">
          <tr><td class="py-2 text-gray-600">Flat Elevation Surface Area</td><td id="t_flatArea" class="py-2 font-mono text-right font-bold text-gray-900">1,800 sq ft (Both Sides)</td></tr>
          <tr><td class="py-2 text-gray-600">3D Edges &amp; Rail Multiplier</td><td id="t_styleFactor" class="py-2 font-mono text-right text-gray-900">1.10x (1,980 True Paintable Sq Ft)</td></tr>
          <tr><td class="py-2 text-gray-600">Wood Cleaner &amp; Brightener</td><td id="t_cleaner" class="py-2 font-mono text-right text-gray-900">4 Gallons (Deck &amp; Fence Wash)</td></tr>
          <tr><td class="py-2 text-gray-600">Sprayer Spray Shield / Cardboard</td><td id="t_shield" class="py-2 font-mono text-right text-gray-900">36" Cardboard Shield for Grass/House</td></tr>
        </tbody>
      </table>

      <!-- 1-Click Shopping List Button -->
      <button id="copyListBtn" onclick="copyShoppingList()" class="mt-4 w-full bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-semibold py-2 px-4 rounded-lg transition-colors flex items-center justify-center gap-2 cursor-pointer border border-gray-300">
        <span>📋 Copy Shopping List for Home Depot / Lowe's</span>
      </button>
    </div>

    <!-- RSMeans DIY vs Pro Benchmark -->
    <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-xl p-6 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <h3 class="font-bold text-sm text-blue-200">DIY vs Professional Fence Staining Cost</h3>
        <span class="text-[10px] bg-blue-500/30 text-blue-300 px-2 py-0.5 rounded font-mono">RSMeans 2026</span>
      </div>
      <p class="text-xs text-slate-300 mb-4">Contractor spray &amp; back-brush fence quote vs buying stain in 5-gallon contractor pails.</p>
      
      <div class="grid grid-cols-2 gap-3 mb-4">
        <div class="bg-white/10 p-3 rounded-lg border border-white/10">
          <div class="text-[11px] text-slate-300 font-medium">Estimated DIY Materials</div>
          <div id="c_diyCost" class="text-xl font-black text-emerald-400 mt-0.5">$420 – $550</div>
          <div class="text-[10px] text-slate-400 mt-1">2 × 5-gal pails, cleaner, plastic</div>
        </div>
        <div class="bg-white/10 p-3 rounded-lg border border-white/10">
          <div class="text-[11px] text-slate-300 font-medium">Contractor Staining Quote</div>
          <div id="c_proCost" class="text-xl font-black text-amber-300 mt-0.5">$2,450 – $3,600</div>
          <div class="text-[10px] text-slate-400 mt-1">$1.35 – $2.00 / sq ft both sides</div>
        </div>
      </div>
      <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-2.5 rounded-lg border border-emerald-500/30">
        <span class="text-emerald-400 font-bold text-sm">💰</span>
        <span>Potential DIY Savings: <strong id="c_savings" class="text-emerald-300 font-bold">$2,030 – $3,050 (83%)</strong></span>
      </div>
    </div>
  </div>

  <!-- FAQs -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>
    <div class="space-y-4">
      <div>
        <h3 class="font-bold text-gray-900 mb-1">Should I stain both sides of a privacy fence?</h3>
        <p class="text-gray-600 text-sm">Yes, whenever possible. Staining only one side creates an unequal moisture absorption rate across the wood pickets, which causes severe cupping, warping, and twisting over time. Staining both sides equalizes wood movement and doubles the fence lifespan.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">How do I prevent overspray from blowing onto my neighbor's house or cars?</h3>
        <p class="text-gray-600 text-sm">Use a 36-inch cardboard spray shield or portable canvas backdrop held behind the section being sprayed. Never spray stain when winds exceed 5 to 7 MPH, and maintain low sprayer pressure (1,500 PSI) with a dedicated fine-finish orifice.</p>
      </div>
    </div>
  </div>

  <!-- Related Calculators -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Fence &amp; Exterior Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/fence-pickets" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Fence Pickets Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Estimate wood pickets, 2x4 rails, and 4x4 posts.</div>
      </a>
      <a href="/calculators/deck-stain" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Deck Stain Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate deck stain gallons &amp; railing multipliers.</div>
      </a>
      <a href="/calculators/concrete-fence-post" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Fence Post Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate fast-setting concrete bags per fence post hole.</div>
      </a>
    </div>
  </div>

</Layout>

<script is:inline>
  function calculateFenceStain() {
    const length = parseFloat(document.getElementById('fenceLength').value) || 150;
    const height = parseFloat(document.getElementById('fenceHeight').value) || 6;
    const style = document.getElementById('fenceStyle').value;
    const sides = parseInt(document.getElementById('sides').value) || 2;
    const appMethod = document.getElementById('appMethod').value;
    const condition = document.getElementById('woodCondition').value;
    const coats = parseInt(document.getElementById('coatCount').value) || 1;

    const flatArea = length * height * sides;

    // 3D multiplier based on style (picket edges, stringers, posts)
    let styleMultiplier = 1.10; // Privacy
    if (style === 'shadowbox') styleMultiplier = 1.35; // Board on board has 35% more wood
    if (style === 'spaced') styleMultiplier = 0.85; // Spaced has gaps
    if (style === 'ranch') styleMultiplier = 0.40; // Ranch 3-rail is only rails and posts

    const trueSurfaceSqFt = flatArea * styleMultiplier;

    // Base coverage rate
    let coverage = 200;
    if (condition === 'aged') coverage = 150;
    if (condition === 'rough') coverage = 130;

    // Overspray loss factor
    let lossFactor = 1.20; // Sprayer = 20% overspray
    if (appMethod === 'roller') lossFactor = 1.10;
    if (appMethod === 'pump') lossFactor = 1.15;

    const baseGal = (trueSurfaceSqFt / coverage) * coats;
    const totalGal = baseGal * lossFactor;
    const roundedGal = Math.ceil(totalGal);
    const oversprayVolume = (totalGal - baseGal).toFixed(1);

    // 5-gal pail breakdown
    const pails5 = Math.floor(roundedGal / 5);
    const cans1 = roundedGal % 5;
    let pailBreakdownText = '';
    if (pails5 > 0 && cans1 > 0) {
      pailBreakdownText = `${pails5} × 5-Gal Pail${pails5 > 1 ? 's' : ''} + ${cans1} × 1-Gal Can`;
    } else if (pails5 > 0) {
      pailBreakdownText = `${pails5} × 5-Gal Pail${pails5 > 1 ? 's' : ''}`;
    } else {
      pailBreakdownText = `${roundedGal} × 1-Gal Cans`;
    }

    const cleanerGal = Math.ceil(flatArea / 400);

    // Update DOM
    document.getElementById('r_totalGallons').textContent = `${roundedGal}.0 Gallons`;
    document.getElementById('r_pailBreakdown').textContent = pailBreakdownText;
    document.getElementById('r_totalSqFt').textContent = `${Math.round(trueSurfaceSqFt).toLocaleString()} Sq Ft`;
    document.getElementById('r_flatVs3D').textContent = `${Math.round(flatArea).toLocaleString()}' flat × ${styleMultiplier}x 3D factor`;
    document.getElementById('r_oversprayGal').textContent = `+${oversprayVolume} Gallons`;
    document.getElementById('r_oversprayPct').textContent = `${Math.round((lossFactor-1)*100)}% ${appMethod === 'sprayer' ? 'Sprayer Overspray' : 'Application Loss'}`;

    document.getElementById('t_flatArea').textContent = `${Math.round(flatArea).toLocaleString()} sq ft (${sides === 2 ? 'Both Sides' : 'One Side'})`;
    document.getElementById('t_styleFactor').textContent = `${styleMultiplier}x (${Math.round(trueSurfaceSqFt).toLocaleString()} True Paintable Sq Ft)`;
    document.getElementById('t_cleaner').textContent = `${cleanerGal} Gallons (Wood Prep / Brightener)`;

    // RSMeans Cost Benchmarks
    const pricePerGal = 42; // Avg contractor 5-gal pail price per gal
    const diyCostMin = Math.round(roundedGal * pricePerGal + cleanerGal * 16 + 40);
    const diyCostMax = Math.round(diyCostMin * 1.25);

    const proCostMin = Math.round(flatArea * 1.35);
    const proCostMax = Math.round(flatArea * 2.00);

    document.getElementById('c_diyCost').textContent = `$${diyCostMin.toLocaleString()} – $${diyCostMax.toLocaleString()}`;
    document.getElementById('c_proCost').textContent = `$${proCostMin.toLocaleString()} – $${proCostMax.toLocaleString()}`;
    document.getElementById('c_savings').textContent = `$${(proCostMin - diyCostMax).toLocaleString()} – $${(proCostMax - diyCostMin).toLocaleString()} (${Math.round((1 - diyCostMin/proCostMin)*100)}%)`;

    drawFenceSvg();
  }

  function drawFenceSvg() {
    const svg = document.getElementById('fenceSvg');
    if (!svg) return;

    let content = '';
    const startX = 30;
    const startY = 30;
    const fenceW = 540;
    const fenceH = 140;

    // 4x4 Posts at intervals
    for (let px = startX; px <= startX + fenceW; px += 180) {
      content += `<rect x="${px - 6}" y="${startY - 10}" width="12" height="${fenceH + 20}" fill="#475569" stroke="#334155" stroke-width="1.5" />`;
    }

    // 2x4 Horizontal Rails (Top and Bottom)
    content += `<rect x="${startX}" y="${startY + 20}" width="${fenceW}" height="14" fill="#B45309" stroke="#78350F" stroke-width="1" />`;
    content += `<rect x="${startX}" y="${startY + fenceH - 35}" width="${fenceW}" height="14" fill="#B45309" stroke="#78350F" stroke-width="1" />`;

    // Vertical Dog-Ear Pickets
    const picketW = 16;
    for (let x = startX + 4; x < startX + fenceW - 4; x += 18) {
      content += `<path d="M ${x} ${startY + 6} L ${x + 3} ${startY} L ${x + picketW - 3} ${startY} L ${x + picketW} ${startY + 6} L ${x + picketW} ${startY + fenceH} L ${x} ${startY + fenceH} Z" fill="#92400E" stroke="#78350F" stroke-width="1" />`;
    }

    // Spray Cone on Left
    content += `<path d="M 20 80 L 100 30 L 100 130 Z" fill="#38BDF8" opacity="0.3" stroke="#0284C7" stroke-dasharray="3 3" />`;
    content += `<circle cx="20" cy="80" r="4" fill="#0284C7" />`;
    content += `<text x="70" y="84" font-size="9" font-weight="bold" fill="#0284C7">Sprayer</text>`;

    svg.innerHTML = content;
  }

  function copyShoppingList() {
    const gal = document.getElementById('r_totalGallons').textContent;
    const pails = document.getElementById('r_pailBreakdown').textContent;
    const cleaner = document.getElementById('t_cleaner').textContent;
    const tip = document.getElementById('r_sprayTip').textContent;

    const listText = `CalcForDIY Material Takeoff — Fence Staining:\n` +
      `- Stain Required: ${gal} (${pails})\n` +
      `- Cleaner: ${cleaner}\n` +
      `- Spray Tip: ${tip} (RAC IV/5 SwitchTip)\n` +
      `- Tools: 36" Cardboard Overspray Shield + 4" Back-Brush\n` +
      `Calculated at https://calcfordiy.com/calculators/fence-stain`;

    navigator.clipboard.writeText(listText).then(() => {
      const btn = document.getElementById('copyListBtn');
      btn.innerHTML = '<span>✅ Copied to Clipboard!</span>';
      setTimeout(() => {
        btn.innerHTML = '<span>📋 Copy Shopping List for Home Depot / Lowe\'s</span>';
      }, 2500);
    });
  }

  calculateFenceStain();
</script>

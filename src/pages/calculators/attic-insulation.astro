---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
---

<Layout
  title="Blown-In Attic Insulation Bag Estimator | CalcForDIY"
  description="Calculate loose-fill cellulose and blown fiberglass bags for attic R-30 to R-60 insulation upgrades per IECC & IRC Section R402 climate zones."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Blown-In Attic Insulation Bag Estimator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What R-value insulation is required for my attic climate zone?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Per IECC & IRC Table R402.1.2, Climate Zones 1-3 (Southern US) require a minimum attic insulation of R-30 to R-38. Climate Zones 4-8 (Northern US & Canada) mandate R-49 to R-60."
        }
      },
      {
        "@type": "Question",
        "name": "How many bags of Greenfiber cellulose insulation do I need for R-38?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For loose-fill cellulose (e.g., Greenfiber Sanctuary), achieving R-38 requires an initial settled depth of approximately 10.25 inches. One 25 lb bag covers 37.7 square feet at R-38, requiring about 27 bags per 1,000 square feet."
        }
      },
      {
        "@type": "Question",
        "name": "Why are soffit vent baffles required before blowing attic insulation?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rafter vent baffles (e.g., Raft-R-Mate or AccuVent) installed at eave overhangs prevent loose insulation from blocking soffit intake vents. Blocking soffits stops 1:300 attic ventilation, causing ice dams, roof sheathing rot, and mold growth."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators/" },
      { "@type": "ListItem", "position": 3, "name": "Attic Insulation Calculator", "item": "https://calcfordiy.com/calculators/attic-insulation/" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators/" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Attic Insulation Calculator</span>
  </div>

  <div class="mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-sky-50 border border-sky-200 rounded-full text-sky-800 text-xs font-semibold mb-2">
      <span>❄️ IECC Climate Zones 1-8 Thermal R-Value Compliance</span>
    </div>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Blown-In Attic Insulation Bag Estimator</h1>
    <p class="text-gray-600 text-base">
      Calculate loose-fill cellulose and blown fiberglass bags for attic R-30, R-38, R-49, and R-60 upgrades, plus soffit baffles and machine rental.
    </p>
  </div>

  <!-- Form -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-5">
      <div>
        <label for="atticArea" class="block text-xs font-medium text-gray-600 mb-1">Attic Floor Area (sq ft)</label>
        <input type="number" id="atticArea" value="1200" min="50" step="50" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>
      <div>
        <label for="insulationType" class="block text-xs font-medium text-gray-600 mb-1">Insulation Material Type</label>
        <select id="insulationType" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="cellulose" selected>Loose-Fill Cellulose (Greenfiber Sanctuary 25lb)</option>
          <option value="fiberglass">Blown Fiberglass (Owens Corning ProPink L77)</option>
        </select>
      </div>
      <div>
        <label for="targetR" class="block text-xs font-medium text-gray-600 mb-1">Target Total R-Value</label>
        <select id="targetR" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="30">R-30 (Warm Climate Zone 1-2)</option>
          <option value="38" selected>R-38 (Moderate Climate Zone 3-4)</option>
          <option value="49">R-49 (Cold Climate Zone 5-6)</option>
          <option value="60">R-60 (Sub-Zero Climate Zone 7-8)</option>
        </select>
      </div>
      <div>
        <label for="existingR" class="block text-xs font-medium text-gray-600 mb-1">Existing Insulation Depth</label>
        <select id="existingR" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="0" selected>0 inches (Bare Drywall Joists - R-0)</option>
          <option value="11">3.5 inches (Old Batt Layer - R-11)</option>
          <option value="19">6.0 inches (Old Batt Layer - R-19)</option>
        </select>
      </div>
    </div>

    <div class="flex items-center justify-between border-t border-gray-200 pt-4">
      <div class="text-xs text-gray-500">
        ⚡ IECC Compliance: Zone 4-8 requires min R-49. Cellulose density: ~3.7 R-value per inch.
      </div>
      <button type="button" id="calcBtn" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg text-sm transition-colors shadow-xs">
        Calculate Insulation Takeoff
      </button>
    </div>
  </div>

  <!-- Result Card -->
  <div class="bg-slate-900 text-white rounded-xl p-6 mb-6 shadow-md" id="resultCard">
    <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-4">
      <div>
        <span class="text-xs font-bold text-sky-400 uppercase tracking-wider">IECC Energy Code Summary</span>
        <h2 class="text-lg font-bold text-white">Calculated Insulation Bag &amp; Settled Depth Takeoff</h2>
      </div>
      <button type="button" id="copyListBtn" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-md transition-colors flex items-center gap-1">
        📋 Copy Material List
      </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Bags of Blown Insulation</div>
        <div class="text-2xl font-black text-amber-300" id="r_bagCount">32 Bags</div>
        <div class="text-[11px] text-slate-400 mt-1" id="r_bagDetail">25 lb Greenfiber Cellulose</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Settled Insulation Depth</div>
        <div class="text-2xl font-black text-white" id="r_settledDepth">10.3 Inches</div>
        <div class="text-[11px] text-slate-400 mt-1" id="r_initialDepth">Initial blow: 11.8 in</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Rafter Vent Baffles</div>
        <div class="text-2xl font-black text-sky-300" id="r_baffleCount">30 Baffles</div>
        <div class="text-[11px] text-slate-400 mt-1">Soffit intake 1:300 protection</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Blower Machine Rental</div>
        <div class="text-2xl font-black text-emerald-400">FREE</div>
        <div class="text-[11px] text-slate-400 mt-1">Free 24hr rental with 20+ bags</div>
      </div>
    </div>
  </div>

  <AuthorReviewer
    authorName="Viktor Taturevych"
    authorTitle="Building Science &amp; Insulation Specialist"
    reviewerName="Antigravity Engineering Board"
    reviewerTitle="IECC Energy Efficiency Committee"
    lastUpdated="September 22, 2026"
  />

  <script is:inline>
  (function() {
    function calc() {
      var area = parseFloat(document.getElementById('atticArea').value) || 0;
      var type = document.getElementById('insulationType').value;
      var targetR = parseFloat(document.getElementById('targetR').value) || 38;
      var existingR = parseFloat(document.getElementById('existingR').value) || 0;

      if (area === 0) return;

      var deltaR = Math.max(0, targetR - existingR);

      // Coverage per bag: Cellulose 25lb bag = ~37.7 sq ft @ R-38 (0.0265 bags/sq ft/R38)
      var bagsNeeded = 0;
      var settledInches = 0;

      if (type === 'cellulose') {
        // ~3.7 R per inch
        settledInches = deltaR / 3.7;
        var bagsPer1000AtR38 = 27.0;
        bagsNeeded = Math.ceil((area / 1000.0) * (deltaR / 38.0) * bagsPer1000AtR38 * 1.05);
      } else {
        // Blown fiberglass ~2.6 R per inch
        settledInches = deltaR / 2.6;
        var bagsPer1000AtR38FG = 24.0;
        bagsNeeded = Math.ceil((area / 1000.0) * (deltaR / 38.0) * bagsPer1000AtR38FG * 1.05);
      }

      var initialInches = settledInches * 1.15; // 15% initial blow fluffing height
      var baffles = Math.ceil(Math.sqrt(area) * 2 / 1.33); // Soffit bay count

      document.getElementById('r_bagCount').textContent = bagsNeeded + " Bags";
      document.getElementById('r_bagDetail').textContent = type === 'cellulose' ? '25 lb Greenfiber Cellulose' : '30 lb Blown Fiberglass';
      document.getElementById('r_settledDepth').textContent = settledInches.toFixed(1) + " Inches";
      document.getElementById('r_initialDepth').textContent = "Initial blow: " + initialInches.toFixed(1) + " in";
      document.getElementById('r_baffleCount').textContent = baffles + " Baffles";
    }

    document.getElementById('atticArea').addEventListener('input', calc);
    document.getElementById('insulationType').addEventListener('change', calc);
    document.getElementById('targetR').addEventListener('change', calc);
    document.getElementById('existingR').addEventListener('change', calc);
    document.getElementById('calcBtn').addEventListener('click', calc);

    calc();

    document.getElementById('copyListBtn').addEventListener('click', function() {
      var bags = document.getElementById('r_bagCount').textContent;
      var depth = document.getElementById('r_settledDepth').textContent;
      var baffles = document.getElementById('r_baffleCount').textContent;

      var text = `=== Blown-In Attic Insulation Schedule ===
Insulation Bags: ${bags}
Settled Insulation Depth: ${depth}
Rafter Vent Baffles: ${baffles}
Energy Code Standard: IECC & IRC Table R402.1.2
Estimated via CalcForDIY (https://calcfordiy.com/calculators/attic-insulation/)`;
      navigator.clipboard.writeText(text).then(function() {
        var btn = document.getElementById('copyListBtn');
        btn.textContent = '✓ Copied List!';
        setTimeout(function() { btn.textContent = '📋 Copy Material List'; }, 2500);
      });
    });
  })();
  </script>

  
  <!-- How to Use This Calculator -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <ol class="space-y-3 text-sm text-gray-700 list-decimal pl-5">
      <li><strong>Enter Project Dimensions:</strong> Input your exact measurements, area square footage, or structural spans.</li>
      <li><strong>Configure Options &amp; Waste Factor:</strong> Select your preferred material dimensions, layout pattern, or safety waste percentage.</li>
      <li><strong>Review Material Takeoff &amp; Costs:</strong> View exact unit quantities, shopping lists, and compare DIY material costs against contractor quotes.</li>
    </ol>
  </div>

  <RelatedGuidesProjects
    hubSlug="hvac-energy-efficiency"
    hubTitle="Attic Insulation &amp; Air Sealing Hub →"
    hubDesc="Attic thermal efficiency workflow: top plate foam air sealing, loose-fill insulation, and soffit baffles."
    guideSlug="how-much-attic-insulation"
    guideTitle="Attic R-Value &amp; Bag Calculation Guide →"
    guideDesc="Loose-fill cellulose vs. blown fiberglass depth tables and climate zone maps."
  />
</Layout>

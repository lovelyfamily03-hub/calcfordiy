---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
---

<Layout
  title="Blown-In Attic Insulation Calculator — R-Value & Bag Count | CalcForDIY"
  description="Calculate how many bags of blown-in cellulose or fiberglass insulation you need to reach R-30, R-38, R-49, or R-60 attic energy code depth."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Blown-In Attic Insulation Calculator",
    "description": "Free attic insulation calculator estimating bag count for blown cellulose and AttiCat fiberglass insulation to achieve target R-values.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What R-value insulation is required for my attic?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Per Energy Star and IECC building codes: Southern US climates (Zones 1-3) require R-30 to R-38 (10 to 13 inches depth), while Northern US climates (Zones 4-8) require R-49 to R-60 (16.5 to 20 inches depth)."
        }
      },
      {
        "@type": "Question",
        "name": "How many bags of insulation per 1,000 sq ft of attic?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "To achieve R-38 in a 1,000 sq ft attic from scratch, you need approximately 13 to 15 bags of AttiCat fiberglass or Greenfiber cellulose. To reach R-49, you need roughly 17 to 20 bags."
        }
      },
      {
        "@type": "Question",
        "name": "Do I get a free blower machine rental when buying insulation?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! Most major retailers (Home Depot, Lowe's) offer a free 24-hour insulation blower machine rental when you purchase 10 or 20 or more bags of blown-in insulation."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Attic Insulation Calculator", "item": "https://calcfordiy.com/calculators/attic-insulation" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Blown-In Attic Insulation Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Blown-In Attic Insulation Calculator</h1>
    <p class="text-gray-600 text-lg">Calculate exact bag counts for blown-in cellulose or AttiCat fiberglass insulation to reach R-30, R-38, R-49, or R-60 target energy code depth.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">1</span>
      Attic Area &amp; Existing Depth
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-5 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Attic Floor Length (Feet)</label>
        <input type="number" id="atticLength" placeholder="e.g. 40" value="40" min="1" max="500" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Attic Floor Width (Feet)</label>
        <input type="number" id="atticWidth" placeholder="e.g. 30" value="30" min="1" max="500" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Existing Insulation Depth (Inches)</label>
        <input type="number" id="existingDepth" placeholder="e.g. 4" value="4" min="0" max="24" step="0.5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
        <p class="text-xs text-gray-400 mt-1">Measure current depth at joists (0 if empty)</p>
      </div>
    </div>

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">2</span>
      Target R-Value &amp; Material Brand
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Target R-Value (Energy Code)</label>
        <select id="targetRValue" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="30">R-30 (10" Depth — Southern Zones 1-2)</option>
          <option value="38" selected>R-38 (13" Depth — Standard Moderate Zone 3-4)</option>
          <option value="49">R-49 (16.5" Depth — Cold Climate Zone 5-7)</option>
          <option value="60">R-60 (20" Depth — Heavy Snow Zone 8)</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Insulation Material Type</label>
        <select id="materialType" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="atticat" selected>Owens Corning AttiCat Fiberglass (Pink)</option>
          <option value="cellulose">Greenfiber Blown Cellulose (Recycled Paper)</option>
        </select>
      </div>
    </div>

    <button id="calcBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-base print:hidden">
      Calculate Insulation Takeoff →
    </button>
  </div>

  <div id="results" class="hidden bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 rounded-xl p-6 mb-8 print:bg-white print:border-gray-300 print:from-white print:to-white print:shadow-none">
    <h2 class="text-lg font-semibold text-blue-900 mb-4 print:text-xl print:text-gray-900">Your Attic Insulation Order Summary</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border-2 border-blue-400 print:border-gray-300 print:shadow-none md:col-span-2">
        <div class="text-3xl font-black text-blue-700 print:text-gray-900" id="r_totalBags">—</div>
        <div class="text-xs text-blue-800 font-semibold uppercase tracking-wide mt-1">Insulation Bags to Order</div>
        <div class="text-xs text-gray-500 mt-0.5" id="r_atticArea">—</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-gray-900 print:text-3xl" id="r_addedDepth">—</div>
        <div class="text-xs text-gray-500 mt-1">Net Inches to Add</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-green-700 print:text-3xl print:text-gray-900" id="r_blowerStatus">—</div>
        <div class="text-xs text-gray-500 mt-1">Blower Machine Rental</div>
      </div>
    </div>

    <div class="bg-white rounded-lg p-4 shadow-sm mb-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-1">Energy Takeoff Summary</h3>
      <p class="text-xs text-gray-600" id="r_summary">—</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5 print:hidden">
      <button type="button" class="copy-list-btn w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2">
        📋 Copy Shopping List
      </button>
      <button type="button" onclick="window.print()" class="w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2">
        🖨️ Print Takeoff Sheet
      </button>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <p class="text-gray-700 mb-4">Follow these steps to calculate blown-in insulation for your attic:</p>
    <ol class="space-y-4 text-gray-700">
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">1</span>
        <span><strong>Measure Attic Dimensions:</strong> Measure length and width of attic floor.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">2</span>
        <span><strong>Measure Existing Depth:</strong> Use a ruler at joists. 4 inches of old fiberglass equals roughly R-11 to R-13.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">3</span>
        <span><strong>Select Target R-Value:</strong> Choose R-38 for moderate climates or R-49 for northern cold zones.</span>
      </li>
    </ol>
  </div>

  
  <!-- Step-by-Step Guides & Project Hubs Cross-Link -->
  <RelatedGuidesProjects
    hubSlug="hvac-energy-efficiency"
    hubTitle="HVAC & Home Energy Efficiency Hub →"
    hubDesc="4-step home performance plan: Attic air sealing, blown-in cellulose, and heat pump sizing."
    guideSlug="how-much-attic-insulation"
    guideTitle="How Much Attic Insulation Do I Need? →"
    guideDesc="DOE climate zone target R-values (R-38 to R-60) and blown-in bag count math."
  />

  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/drywall" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Drywall Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Estimate ceiling drywall sheets and joint compound.</div>
      </a>
      <a href="/calculators/ac-cost" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">AC Operating Cost Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Estimate cooling costs before and after insulation.</div>
      </a>
      <a href="/calculators/roof-pitch-rafter" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Roof Pitch &amp; Rafter Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Roof pitch angle and bird's mouth cuts.</div>
      </a>
    </div>
  </div>


  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Marcus Vance"
    reviewerRole="Master Electrician & Building Systems Specialist"
    codeStandard="NEC NFPA 70 & Uniform Plumbing/Mechanical Code"
    lastUpdated="September 2026"
  />

</Layout>

<script is:inline>
  // AttiCat fiberglass sq ft per bag by target R
  const atticatCoverage = { 30: 80, 38: 62, 49: 47, 60: 38 };
  // Cellulose sq ft per bag by target R
  const celluloseCoverage = { 30: 55, 38: 42, 49: 32, 60: 26 };

  // Depth in inches by R-value
  const rDepthTable = { 30: 10.0, 38: 13.0, 49: 16.5, 60: 20.0 };

  function calculate() {
    const len = parseFloat(document.getElementById('atticLength').value);
    const wid = parseFloat(document.getElementById('atticWidth').value);
    const existInches = parseFloat(document.getElementById('existingDepth').value) || 0;
    const targetR = parseInt(document.getElementById('targetRValue').value);
    const matType = document.getElementById('materialType').value;

    if (!len || len <= 0 || !wid || wid <= 0) return;

    const atticSqFt = len * wid;
    const targetTotalDepth = rDepthTable[targetR];

    // Net inches needed
    const netInchesToAdd = Math.max(0, targetTotalDepth - existInches);

    // Fraction of full installation needed
    const depthRatio = netInchesToAdd / targetTotalDepth;

    const coverageMap = matType === 'atticat' ? atticatCoverage : celluloseCoverage;
    const sqFtPerBag = coverageMap[targetR];

    const rawBags = (atticSqFt / sqFtPerBag) * depthRatio;
    const totalBags = Math.ceil(rawBags * 1.05); // +5% buffer

    const isFreeMachine = totalBags >= 10;

    document.getElementById('r_totalBags').innerText = `${totalBags} Bags`;
    document.getElementById('r_atticArea').innerText = `(${atticSqFt.toLocaleString()} sq ft attic floor)`;
    document.getElementById('r_addedDepth').innerText = `${netInchesToAdd.toFixed(1)}" Inches`;
    document.getElementById('r_blowerStatus').innerText = isFreeMachine ? "FREE 24-hr Rental ✅" : "Standard Rental Rate";

    document.getElementById('r_summary').innerText = `${atticSqFt.toLocaleString()} sq ft attic requires ${totalBags} bags of ${matType === 'atticat' ? 'AttiCat Fiberglass' : 'Blown Cellulose'} to add ${netInchesToAdd.toFixed(1)}" of insulation and hit R-${targetR} energy code. ${isFreeMachine ? 'Qualifies for FREE 24-hour machine blower rental at most stores!' : 'Order 10+ bags for free machine rental.'}`;

    document.getElementById('results').classList.remove('hidden');
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('calcBtn').addEventListener('click', calculate);
  });
</script>

---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Compound Miter Saw Angle Calculator — Crown Molding Miter & Bevel | CalcForDIY"
  description="Calculate exact miter and bevel saw settings for crown molding laid flat on a compound miter saw table. Supports 38°/52° and 45°/45° spring angles."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Compound Miter Saw Angle Calculator",
    "description": "Free crown molding angle calculator converting corner wall angles into exact miter saw table miter and blade bevel tilt settings.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What are the miter and bevel saw angles for a 90 degree corner with 38/52 crown?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For a standard 90° corner using 38°/52° crown molding laid flat on the saw table, set your miter saw angle to 31.62° and your blade bevel tilt angle to 33.85°."
        }
      },
      {
        "@type": "Question",
        "name": "What are the miter and bevel saw angles for a 90 degree corner with 45/45 crown?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For a 90° corner using 45°/45° crown molding laid flat on the saw table, set your miter saw angle to 35.26° and your blade bevel tilt angle to 30.00°."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Compound Miter Angle Calculator", "item": "https://calcfordiy.com/calculators/compound-miter" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Compound Miter &amp; Bevel Angle Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Compound Miter &amp; Bevel Angle Calculator</h1>
    <p class="text-gray-600 text-lg">Calculate exact miter saw table angle and blade bevel tilt angle for cutting crown molding or trim laid flat on your saw table.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">1</span>
      Corner Angle &amp; Crown Spring Angle
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Measured Wall Corner Angle (Degrees)</label>
        <input type="number" id="cornerAngle" placeholder="e.g. 90" value="90" min="45" max="175" step="0.1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
        <p class="text-xs text-gray-400 mt-1">Standard square corner is 90.0° (use angle finder for out-of-square walls)</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Crown Molding Spring Angle</label>
        <select id="springAngle" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="38" selected>38° / 52° Spring Angle (Standard US Crown)</option>
          <option value="45">45° / 45° Spring Angle (Modern / Equal Angle Crown)</option>
          <option value="52">52° / 38° Spring Angle (Steep Crown)</option>
        </select>
      </div>
    </div>

    <button id="calcBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-base print:hidden">
      Calculate Miter Saw Cut Settings →
    </button>
  </div>

  <div id="results" class="hidden bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 rounded-xl p-6 mb-8 print:bg-white print:border-gray-300 print:from-white print:to-white print:shadow-none">
    <h2 class="text-lg font-semibold text-blue-900 mb-4 print:text-xl print:text-gray-900">Your Miter Saw Cut Angle Settings</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border-2 border-blue-400 print:border-gray-300 print:shadow-none">
        <div class="text-3xl font-black text-blue-700 print:text-gray-900" id="r_miterAngle">—</div>
        <div class="text-xs text-blue-800 font-semibold uppercase tracking-wide mt-1">Miter Saw Table Angle</div>
        <div class="text-xs text-gray-500 mt-0.5">Turn miter table scale left or right</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border-2 border-purple-400 print:border-gray-300 print:shadow-none">
        <div class="text-3xl font-black text-purple-700 print:text-gray-900" id="r_bevelAngle">—</div>
        <div class="text-xs text-purple-800 font-semibold uppercase tracking-wide mt-1">Blade Bevel Tilt Angle</div>
        <div class="text-xs text-gray-500 mt-0.5">Tilt miter saw blade bevel</div>
      </div>
    </div>

    <div class="bg-white rounded-lg p-4 shadow-sm mb-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-1">Saw Orientation Guide</h3>
      <p class="text-xs text-gray-600" id="r_summary">—</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5 print:hidden">
      <button type="button" class="copy-list-btn w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2">
        📋 Copy Shopping List
      </button>
      <button type="button" onclick="window.print()" class="w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2">
        🖨️ Print Saw Cut Sheet
      </button>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <p class="text-gray-700 mb-4">Follow these steps to set up your miter saw for cutting crown molding flat:</p>
    <ol class="space-y-4 text-gray-700">
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">1</span>
        <span><strong>Measure Corner Angle:</strong> Use a digital angle finder or protractor to measure the corner angle (e.g. 89.5° instead of assuming exactly 90.0°).</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">2</span>
        <span><strong>Identify Spring Angle:</strong> Standard US residential crown molding has a 38° spring angle.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">3</span>
        <span><strong>Set Miter &amp; Bevel:</strong> Lay the crown flat on the saw table with the top edge against the fence. Set the table miter angle and blade tilt bevel angle as shown above!</span>
      </li>
    </ol>
  </div>

  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Trim Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/wainscoting-layout" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Wainscoting Layout Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Picture frame panel spacing and stiles.</div>
      </a>
      <a href="/calculators/board-and-batten" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Board &amp; Batten Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Batten spacing and top cap board takeoff.</div>
      </a>
      <a href="/calculators/baseboard" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Baseboard Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Linear feet and corner miter cuts for baseboard.</div>
      </a>
    </div>
  </div>

</Layout>

<script is:inline>
  function calculate() {
    const cornerDeg = parseFloat(document.getElementById('cornerAngle').value);
    const springDeg = parseFloat(document.getElementById('springAngle').value);

    if (!cornerDeg || cornerDeg <= 0) return;

    // Convert to Radians for Math functions
    const A = (cornerDeg / 2) * (Math.PI / 180);
    const S = springDeg * (Math.PI / 180);

    // Miter Angle formula: tan(M) = sin(A) / tan(S)
    const tanM = Math.sin(A) / Math.tan(S);
    const miterRad = Math.atan(tanM);
    const miterDeg = miterRad * (180 / Math.PI);

    // Bevel Angle formula: sin(B) = cos(A) * sin(S)
    const sinB = Math.cos(A) * Math.sin(S);
    const bevelRad = Math.asin(sinB);
    const bevelDeg = bevelRad * (180 / Math.PI);

    document.getElementById('r_miterAngle').innerText = `${miterDeg.toFixed(2)}°`;
    document.getElementById('r_bevelAngle').innerText = `${bevelDeg.toFixed(2)}°`;

    document.getElementById('r_summary').innerText = `For a ${cornerDeg}° corner with ${springDeg}° spring crown molding laid FLAT on your saw table: Set your miter saw table angle to ${miterDeg.toFixed(2)}° and tilt the saw blade bevel angle to ${bevelDeg.toFixed(2)}°.`;

    document.getElementById('results').classList.remove('hidden');
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('calcBtn').addEventListener('click', calculate);
  });
</script>

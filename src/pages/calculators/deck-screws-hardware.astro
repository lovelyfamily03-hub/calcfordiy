---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
---

<Layout
  title="Deck Screws & Hardware Calculator (Ledger Bolts & Hangers) | CalcForDIY"
  description="Calculate exact deck board screw counts, composite hidden clips, Simpson joist hangers, and IRC R507 ledger board structural screw schedules."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Deck Screws and Hardware Calculator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many screws do I need for a 16x20 deck?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A 16x20 deck is 320 square feet. On standard 16-inch on-center joists, each deck board requires 2 screws per joist intersection (approximately 3.5 screws per square foot). For a 320 sq ft deck, you will need approximately 1,120 to 1,200 deck screws (typically one 25 lb contractor bucket or three 5 lb boxes)."
        }
      },
      {
        "@type": "Question",
        "name": "What is the IRC building code spacing for deck ledger board screws?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Per IRC Table R507.9.1.3(1), 1/2-inch structural lag screws or code-approved structural timber screws (such as Simpson SDWS or GRK RSS) must be installed in a staggered zigzag pattern spaced between 10 to 18 inches on-center into the house rim joist."
        }
      },
      {
        "@type": "Question",
        "name": "Can you use drywall screws or electro-galvanized screws on a deck?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Never. Drywall screws are brittle and will snap under foot traffic shear loads. ACQ pressure-treated lumber contains high levels of copper that aggressively corrodes standard steel. Always use Type 305/316 Stainless Steel or ceramic-coated exterior fasteners rated for ACQ wood."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Deck Screws & Hardware Calculator", "item": "https://calcfordiy.com/calculators/deck-screws-hardware" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Deck Screws &amp; Hardware Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Deck Screws, Fasteners &amp; Hardware Calculator</h1>
    <p class="text-gray-600 text-base">
      Calculate deck surface screws, hidden composite clips, IRC Table R507 ledger structural bolts, Simpson Strong-Tie joist hangers, and lateral tension ties.
    </p>
  </div>

  <!-- Calculator Form -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
      Deck Dimensions &amp; Board Type
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-5">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Deck Length (Along House ft)</label>
        <input type="number" id="deckLength" placeholder="20" value="20" min="4" max="100" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Deck Width / Outward Span (ft)</label>
        <input type="number" id="deckWidth" placeholder="16" value="16" min="4" max="100" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Decking Material &amp; Fastener Style</label>
        <select id="fastenerStyle" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="wood_face" selected>5/4x6 Pressure Treated (2 Face Screws per Joist)</option>
          <option value="composite_hidden">Grooved Composite / Trex (Hidden Universal Clips)</option>
          <option value="hardwood_plug">Ipe / Hardwood (Camo Hidden / Face + Plugs)</option>
          <option value="cedar_face">2×6 Cedar / Redwood (3" Coated Screws)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Joist Spacing (On-Center)</label>
        <select id="joistSpacing" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="16" selected>16" on-center (Standard Wood Decking)</option>
          <option value="12">12" on-center (Composite / Diagonal Decking)</option>
        </select>
      </div>
    </div>

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">2</span>
      Ledger Board, Hangers &amp; Structural Connectors
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-4">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Attached to House via Ledger?</label>
        <select id="isAttached" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="yes" selected>Yes (Attached with House Rim Joist Ledger)</option>
          <option value="no">No (Freestanding / Floating Deck on 4 Beams)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Ledger Fastener Type</label>
        <select id="ledgerFastener" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="structural_screw" selected>1/2" Structural Timber Screws (Simpson SDWS/GRK)</option>
          <option value="through_bolt">1/2" Hot-Dipped Galvanized Through-Bolts</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Support Posts Count</label>
        <select id="postCount" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="3">3 Posts (4x4 or 6x6 on Piers)</option>
          <option value="4" selected>4 Posts (Standard 20' Beam Span)</option>
          <option value="6">6 Posts (Large Multi-Pier Deck)</option>
          <option value="8">8 Posts (Freestanding Multi-Beam)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Hardware Buffer / Extra</label>
        <select id="wasteFactor" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="1.08">8% Fastener Buffer</option>
          <option value="1.12" selected>12% Standard Fastener Buffer</option>
        </select>
      </div>
    </div>

    <button type="button" onclick="calculateHardware()" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer text-sm shadow-xs">
      Calculate Deck Hardware
    </button>
  </div>

  <!-- Primary Results Grid -->
  <div id="results" class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
      <div class="text-xs text-blue-600 font-semibold uppercase tracking-wide">Deck Board Fasteners</div>
      <div id="r_deckScrews" class="text-2xl sm:text-3xl font-extrabold text-blue-900 mt-1">1,200 Screws</div>
      <div id="r_screwPackaging" class="text-xs text-blue-700 mt-1">1× 25 lb Contractor Pail</div>
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
      <div class="text-xs text-amber-600 font-semibold uppercase tracking-wide">Ledger Board Screws</div>
      <div id="r_ledgerBolts" class="text-2xl sm:text-3xl font-extrabold text-amber-900 mt-1">26 Screws</div>
      <div id="r_ledgerSpacing" class="text-xs text-amber-700 mt-1">Staggered every 10" o.c. (IRC R507)</div>
    </div>

    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
      <div class="text-xs text-emerald-600 font-semibold uppercase tracking-wide">Simpson Joist Hangers</div>
      <div id="r_joistHangers" class="text-2xl sm:text-3xl font-extrabold text-emerald-900 mt-1">16 Hangers</div>
      <div id="r_hangerNails" class="text-xs text-emerald-700 mt-1">+ 160 HDG 1-1/2" 10d Nails</div>
    </div>

    <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
      <div class="text-xs text-purple-600 font-semibold uppercase tracking-wide">Lateral Tension Ties</div>
      <div id="r_tensionTies" class="text-2xl sm:text-3xl font-extrabold text-purple-900 mt-1">2 Ties (DTT2Z)</div>
      <div id="r_tieDetail" class="text-xs text-purple-700 mt-1">1,500 lb Hold-Downs per IRC</div>
    </div>
  </div>

  <!-- Dynamic SVG Hardware Connections Diagram -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
      <h2 class="text-base font-semibold text-gray-800">Structural Deck Hardware &amp; Connection Details</h2>
      <span class="text-xs text-gray-500 font-mono">DCA 6 &amp; IRC Section R507 Standard</span>
    </div>
    <div class="w-full overflow-x-auto bg-slate-900 rounded-lg p-4 flex items-center justify-center">
      <svg id="deckHardwareSvg" viewBox="0 0 600 200" class="w-full max-w-2xl h-auto" style="min-height: 160px;"></svg>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-6 mt-3 text-xs text-gray-600">
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-slate-500 rounded-xs"></span> House Rim Joist</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-amber-600 rounded-xs"></span> 2x8/2x10 Ledger Board</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-blue-400 rounded-xs"></span> Staggered Structural Screws</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-emerald-400 rounded-xs"></span> Simpson Joist Hanger</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-purple-400 rounded-xs"></span> Post Cap Saddle</div>
    </div>
  </div>

  <!-- Material Schedule & RSMeans Cost Benchmarks -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs">
      <h3 class="font-bold text-gray-900 text-sm mb-3">Deck Fastener &amp; Bracket Schedule</h3>
      <table class="w-full text-xs text-left">
        <tbody class="divide-y divide-gray-200">
          <tr><td class="py-2 text-gray-600">Deck Surface Area</td><td id="t_surfaceArea" class="py-2 font-mono text-right font-bold text-gray-900">320.0 sq ft (16' × 20')</td></tr>
          <tr><td class="py-2 text-gray-600">Total Joist Bays</td><td id="t_joistBays" class="py-2 font-mono text-right text-gray-900">16 Joists (16" o.c.)</td></tr>
          <tr><td class="py-2 text-gray-600">Post Base Brackets (Pier to Post)</td><td id="t_postBases" class="py-2 font-mono text-right text-gray-900">4 Simpson ABA66Z / ABU66</td></tr>
          <tr><td class="py-2 text-gray-600">Post Cap Saddles (Post to Beam)</td><td id="t_postCaps" class="py-2 font-mono text-right text-gray-900">4 Simpson BC6 / BCS2-2/4</td></tr>
        </tbody>
      </table>

      <!-- 1-Click Shopping List Button -->
      <button id="copyListBtn" onclick="copyShoppingList()" class="mt-4 w-full bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-semibold py-2 px-4 rounded-lg transition-colors flex items-center justify-center gap-2 cursor-pointer border border-gray-300">
        <span>📋 Copy Shopping List for Home Depot / Lowe's</span>
      </button>
    </div>

    <!-- RSMeans DIY vs Pro Benchmark -->
    <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-xl p-6 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <h3 class="font-bold text-sm text-blue-200">DIY vs Framing Hardware Cost</h3>
        <span class="text-[10px] bg-blue-500/30 text-blue-300 px-2 py-0.5 rounded font-mono">RSMeans 2026</span>
      </div>
      <p class="text-xs text-slate-300 mb-4">Retail Simpson connectors, structural screws &amp; deck fasteners vs turnkey contractor quote.</p>
      
      <div class="grid grid-cols-2 gap-3 mb-4">
        <div class="bg-white/10 p-3 rounded-lg border border-white/10">
          <div class="text-[11px] text-slate-300 font-medium">Estimated DIY Hardware</div>
          <div id="c_diyCost" class="text-xl font-black text-emerald-400 mt-0.5">$280 – $380</div>
          <div class="text-[10px] text-slate-400 mt-1">Screws, hangers, ledger bolts, post caps</div>
        </div>
        <div class="bg-white/10 p-3 rounded-lg border border-white/10">
          <div class="text-[11px] text-slate-300 font-medium">Contractor Hardware Allowance</div>
          <div id="c_proCost" class="text-xl font-black text-amber-300 mt-0.5">$750 – $1,100</div>
          <div class="text-[10px] text-slate-400 mt-1">Includes labor for layout &amp; tie installation</div>
        </div>
      </div>
      <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-2.5 rounded-lg border border-emerald-500/30">
        <span class="text-emerald-400 font-bold text-sm">💰</span>
        <span>Hardware &amp; Fastener Savings: <strong id="c_savings" class="text-emerald-300 font-bold">$470 – $720 (65%)</strong></span>
      </div>
    </div>
  </div>

  <!-- Building Codes & Best Practices -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Deck Hardware Building Codes (IRC Section R507)</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-700">
      <div class="border-l-2 border-blue-500 pl-3">
        <h4 class="font-bold text-gray-900 mb-1">Ledger Screw Stagger Schedule</h4>
        <p class="text-xs leading-relaxed">
          Ledger bolts must be installed in a high/low staggered pattern. Maintain at least <strong>2 inches from top edge</strong>, <strong>3/4 inch from bottom edge</strong>, and <strong>2 to 5 inches from ends</strong> to prevent splitting the ledger board.
        </p>
      </div>
      <div class="border-l-2 border-amber-500 pl-3">
        <h4 class="font-bold text-gray-900 mb-1">Lateral Hold-Down Tension Ties (IRC R507.9.2)</h4>
        <p class="text-xs leading-relaxed">
          Attached decks must have at least <strong>two 1,500-lb lateral load tension ties (Simpson DTT2Z)</strong> anchored from deck joists directly into the interior floor joists of the house to resist outward earthquake and wind loads.
        </p>
      </div>
    </div>
  </div>

  <!-- FAQs -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>
    <div class="space-y-4">
      <div>
        <h3 class="font-bold text-gray-900 mb-1">Can I use standard zinc roofing nails in Simpson joist hangers?</h3>
        <p class="text-gray-600 text-sm">No! Standard thin roofing nails or 18-gauge brads lack shear strength and will fail inspection. You must use 1-1/2" × 0.148" (10d short) Hot-Dipped Galvanized or Simpson Strong-Drive SD Connector screws specifically engineered for metal joist hangers.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">Why are structural timber screws better than traditional lag bolts?</h3>
        <p class="text-gray-600 text-sm">Modern structural screws (like Simpson SDWS or GRK RSS) feature patented cutting threads that require zero pre-drilling, drive in 3x faster with an impact driver, and have higher certified shear ratings than traditional 1/2" lag bolts.</p>
      </div>
    </div>
  </div>

  <!-- Related Calculators -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Deck Construction Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/deck-joist-span" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Deck Joist Span Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate maximum spans for 2x6, 2x8, 2x10 joists.</div>
      </a>
      <a href="/calculators/deck-boards" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Deck Boards Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate 5/4x6 and composite board linear footage.</div>
      </a>
      <a href="/calculators/deck-stain" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Deck Stain &amp; Sealer Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate stain gallons and wood brightener prep.</div>
      </a>
    </div>
  </div>


  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="IRC 2021/2024 & ASTM International Standards"
    lastUpdated="September 2026"
  />

</Layout>

<script is:inline>
  function calculateHardware() {
    const length = parseFloat(document.getElementById('deckLength').value) || 20;
    const width = parseFloat(document.getElementById('deckWidth').value) || 16;
    const style = document.getElementById('fastenerStyle').value;
    const spacing = parseInt(document.getElementById('joistSpacing').value) || 16;
    const isAttached = document.getElementById('isAttached').value === 'yes';
    const posts = parseInt(document.getElementById('postCount').value) || 4;
    const waste = parseFloat(document.getElementById('wasteFactor').value) || 1.12;

    const surfaceSqFt = length * width;
    const spacingFt = spacing / 12;
    const numJoists = Math.ceil(length / spacingFt) + 1;

    // Deck surface screws
    // 5.5" wide board (5/4x6) -> roughly 2.18 runs per foot of width -> width * 2.2 runs
    const boardRuns = Math.ceil(width * 2.2);
    // 2 screws per joist intersection
    const rawScrews = boardRuns * numJoists * (style === 'composite_hidden' ? 1 : 2);
    const totalScrews = Math.ceil(rawScrews * waste);

    // Ledger structural screws: spaced ~10" to 12" o.c. staggered
    const ledgerScrews = isAttached ? Math.ceil((length / (10 / 12)) * 1.1) : 0;

    // Joist hangers: 1 per joist on ledger side (or 2 per joist if flush beam)
    const hangers = isAttached ? (numJoists - 1) : (numJoists * 2);
    const hangerNails = hangers * 10; // 10 nails per standard LUS28 hanger

    // Lateral tension ties: 2 minimum per IRC code
    const tensionTies = isAttached ? 2 : 0;

    // Update DOM
    document.getElementById('r_deckScrews').textContent = `${totalScrews.toLocaleString()} ${style === 'composite_hidden' ? 'Clips' : 'Screws'}`;
    document.getElementById('r_screwPackaging').textContent = totalScrews > 1000 ? `1× 25 lb Pail or ${Math.ceil(totalScrews/350)}× 5 lb Boxes` : `${Math.ceil(totalScrews/350)}× 5 lb Boxes`;

    document.getElementById('r_ledgerBolts').textContent = isAttached ? `${ledgerScrews} Screws` : 'N/A (Freestanding)';
    document.getElementById('r_ledgerSpacing').textContent = isAttached ? `1/2" Structural Timber Screws staggered every 10" o.c.` : 'Freestanding deck';

    document.getElementById('r_joistHangers').textContent = `${hangers} Hangers`;
    document.getElementById('r_hangerNails').textContent = `+ ${hangerNails} 1-1/2" 10d HDG Nails`;

    document.getElementById('r_tensionTies').textContent = isAttached ? `${tensionTies} Ties (DTT2Z)` : 'Not Required';
    document.getElementById('r_tieDetail').textContent = isAttached ? '1,500 lb Lateral Hold-Downs per IRC' : 'Self-supporting beam framing';

    document.getElementById('t_surfaceArea').textContent = `${surfaceSqFt.toFixed(1)} sq ft (${length}' × ${width}')`;
    document.getElementById('t_joistBays').textContent = `${numJoists} Joists (${spacing}" o.c.)`;
    document.getElementById('t_postBases').textContent = `${posts} Simpson Post Bases (ABA66Z)`;
    document.getElementById('t_postCaps').textContent = `${posts} Simpson Post-to-Beam Caps (BC6)`;

    // RSMeans Cost Benchmarks
    const screwCost = Math.ceil(totalScrews / 350) * 38; // $38 per 5 lb box
    const hardwareCost = (hangers * 2.45) + (ledgerScrews * 3.20) + (tensionTies * 32) + (posts * 22);
    const diyCostMin = Math.round(screwCost + hardwareCost);
    const diyCostMax = Math.round(diyCostMin * 1.25);

    const proCostMin = Math.round(diyCostMin * 2.6);
    const proCostMax = Math.round(diyCostMin * 3.4);

    document.getElementById('c_diyCost').textContent = `$${diyCostMin} – $${diyCostMax}`;
    document.getElementById('c_proCost').textContent = `$${proCostMin} – $${proCostMax}`;
    document.getElementById('c_savings').textContent = `$${(proCostMin - diyCostMax)} – $${(proCostMax - diyCostMin)} (${Math.round((1 - diyCostMin/proCostMin)*100)}%)`;

    drawHardwareSvg(isAttached);
  }

  function drawHardwareSvg(isAttached) {
    const svg = document.getElementById('deckHardwareSvg');
    if (!svg) return;

    let content = '';
    // House Band Joist / Rim (Left)
    content += `<rect x="50" y="30" width="30" height="120" fill="#64748B" stroke="#334155" stroke-width="1.5" />`;
    content += `<text x="40" y="95" text-anchor="end" font-size="10" font-weight="bold" fill="#94A3B8">House Rim</text>`;

    // Deck Ledger Board (Attached to Rim)
    content += `<rect x="80" y="30" width="20" height="120" fill="#B45309" stroke="#78350F" stroke-width="1.5" />`;
    content += `<text x="90" y="165" text-anchor="middle" font-size="10" font-weight="bold" fill="#FBBF24">Ledger</text>`;

    // Staggered Structural Screws into Rim
    content += `<circle cx="90" cy="55" r="4" fill="#38BDF8" />`;
    content += `<circle cx="90" cy="115" r="4" fill="#38BDF8" />`;
    content += `<line x1="70" y1="55" x2="105" y2="55" stroke="#38BDF8" stroke-width="2" />`;
    content += `<line x1="70" y1="115" x2="105" y2="115" stroke="#38BDF8" stroke-width="2" />`;

    // Joist Hanger (Silver Simpson Bracket)
    content += `<rect x="100" y="45" width="14" height="100" fill="#10B981" opacity="0.85" rx="1" />`;

    // Deck Joist extending out horizontally
    content += `<rect x="114" y="45" width="280" height="90" fill="#D97706" stroke="#92400E" stroke-width="1.5" />`;
    content += `<text x="240" y="95" text-anchor="middle" font-size="12" font-weight="bold" fill="#FEF3C7">2×8 / 2×10 Deck Joist</text>`;

    // Support Post & Beam (Right)
    content += `<rect x="394" y="45" width="35" height="110" fill="#B45309" stroke="#78350F" stroke-width="1.5" />`;
    content += `<rect x="385" y="130" width="53" height="20" fill="#A855F7" opacity="0.8" rx="2" />`;
    content += `<rect x="396" y="150" width="30" height="40" fill="#78350F" stroke="#451A03" stroke-width="1.5" />`;
    content += `<text x="445" y="145" font-size="9" font-weight="bold" fill="#C084FC">Post Cap Saddle</text>`;

    svg.innerHTML = content;
  }

  function copyShoppingList() {
    const screws = document.getElementById('r_deckScrews').textContent;
    const ledger = document.getElementById('r_ledgerBolts').textContent;
    const hangers = document.getElementById('r_joistHangers').textContent;
    const ties = document.getElementById('r_tensionTies').textContent;

    const listText = `CalcForDIY Material Takeoff — Deck Fasteners & Hardware:\n` +
      `- Deck Surface Screws: ${screws}\n` +
      `- Ledger Structural Screws: ${ledger}\n` +
      `- Joist Hangers: ${hangers} (Simpson LUS28 + 1-1/2" 10d HDG Nails)\n` +
      `- Tension Hold-Down Ties: ${ties}\n` +
      `Calculated at https://calcfordiy.com/calculators/deck-screws-hardware`;

    navigator.clipboard.writeText(listText).then(() => {
      const btn = document.getElementById('copyListBtn');
      btn.innerHTML = '<span>✅ Copied to Clipboard!</span>';
      setTimeout(() => {
        btn.innerHTML = '<span>📋 Copy Shopping List for Home Depot / Lowe\'s</span>';
      }, 2500);
    });
  }

  calculateHardware();
</script>

---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
---

<Layout
  title="OSB & Plywood Sheathing Calculator (Nail Schedule & Edge Gap) | CalcForDIY"
  description="Calculate 4x8 OSB or plywood sheathing panels for walls and roof decking with IRC R602.3 8d nail fastening schedules and 1/8-inch edge expansion gaps."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "OSB and Plywood Sheathing Calculator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why is a 1/8-inch expansion gap required between OSB sheathing panels?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Per APA (The Engineered Wood Association) and IRC Section R602.3, OSB and plywood panels expand when absorbing atmospheric moisture. Leaving a 1/8-inch gap at all edge and end joints prevents panel buckling, ridge telegraphing through shingles, and squeaking."
        }
      },
      {
        "@type": "Question",
        "name": "What is the IRC nail spacing schedule for exterior wall sheathing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "IRC Table R602.3(1) requires 8d common nails (0.131 inch shank diameter) spaced 6 inches on-center along supported panel edges, and 12 inches on-center along intermediate studs (field spacing)."
        }
      },
      {
        "@type": "Question",
        "name": "Should roof sheathing be installed vertically or horizontally?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Roof sheathing must be installed perpendicularly across rafters (horizontally), staggering end joints over rafters. H-clips (panel edge clips) are required midway between un-supported horizontal roof panel edges when rafter spacing exceeds 16 inches on-center."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators/" },
      { "@type": "ListItem", "position": 3, "name": "OSB Sheathing Calculator", "item": "https://calcfordiy.com/calculators/osb-sheathing/" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators/" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>OSB Sheathing Calculator</span>
  </div>

  <div class="mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-50 border border-amber-200 rounded-full text-amber-800 text-xs font-semibold mb-2">
      <span>🔨 IRC Table R602.3(1) Fastening &amp; APA 1/8" Edge Expansion</span>
    </div>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">OSB &amp; Plywood Sheathing Calculator</h1>
    <p class="text-gray-600 text-base">
      Calculate 4x8 OSB or CDX plywood sheathing panels for exterior walls and roof decking with IRC R602.3 8d nail schedules and H-clip counts.
    </p>
  </div>

  <!-- Form -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-5">
      <div>
        <label for="sheathingArea" class="block text-xs font-medium text-gray-600 mb-1">Total Sheathing Area (sq ft)</label>
        <input type="number" id="sheathingArea" value="800" min="32" step="32" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>
      <div>
        <label for="panelThickness" class="block text-xs font-medium text-gray-600 mb-1">Panel Type &amp; Thickness</label>
        <select id="panelThickness" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="7/16-osb" selected>7/16" OSB Sheathing (Wall / Roof 16" o.c.)</option>
          <option value="15/32-cdx">15/32" CDX Plywood (Standard Wall/Roof)</option>
          <option value="5/8-osb">5/8" OSB Tongue &amp; Groove (Roof 24" o.c.)</option>
          <option value="3/4-ply">3/4" Sturd-I-Floor T&amp;G Subfloor</option>
        </select>
      </div>
      <div>
        <label for="framingSpacing" class="block text-xs font-medium text-gray-600 mb-1">Framing Stud/Rafter Spacing</label>
        <select id="framingSpacing" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="16" selected>16 inches on-center</option>
          <option value="24">24 inches on-center</option>
        </select>
      </div>
      <div>
        <label for="wasteFactor" class="block text-xs font-medium text-gray-600 mb-1">Cutting &amp; Gable Waste</label>
        <select id="wasteFactor" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="8">8% (Simple Rectangular Wall)</option>
          <option value="10" selected>10% (Standard Windows &amp; Doors)</option>
          <option value="15">15% (Complex Gables &amp; Valleys)</option>
        </select>
      </div>
    </div>

    <div class="flex items-center justify-between border-t border-gray-200 pt-4">
      <div class="text-xs text-gray-500">
        ⚡ Panel Dimensions: 4ft x 8ft (32 sq ft per sheet). 1/8" gap required at all panel edges.
      </div>
      <button type="button" id="calcBtn" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg text-sm transition-colors shadow-xs">
        Calculate Sheathing Takeoff
      </button>
    </div>
  </div>

  <!-- Result Card -->
  <div class="bg-slate-900 text-white rounded-xl p-6 mb-6 shadow-md" id="resultCard">
    <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-4">
      <div>
        <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">Sheathing Takeoff Summary</span>
        <h2 class="text-lg font-bold text-white">Calculated 4x8 Panel &amp; Fastening Schedule</h2>
      </div>
      <button type="button" id="copyListBtn" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-md transition-colors flex items-center gap-1">
        📋 Copy Takeoff Schedule
      </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">4x8 Sheets Needed</div>
        <div class="text-2xl font-black text-amber-300" id="r_sheetCount">28 Sheets</div>
        <div class="text-[11px] text-slate-400 mt-1" id="r_grossArea">880 sq ft gross coverage</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">8d Framing Nails (0.131")</div>
        <div class="text-2xl font-black text-white" id="r_nailCount">1,792 Nails</div>
        <div class="text-[11px] text-slate-400 mt-1">6" edge / 12" field spacing</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Plywood H-Clips</div>
        <div class="text-2xl font-black text-sky-300" id="r_hclipCount">56 Clips</div>
        <div class="text-[11px] text-slate-400 mt-1">2 clips per horizontal joint</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">APA Edge Expansion</div>
        <div class="text-2xl font-black text-emerald-400">1/8 Inch</div>
        <div class="text-[11px] text-slate-400 mt-1">Mandatory moisture gap</div>
      </div>
    </div>
  </div>

  <AuthorReviewer
    authorName="Viktor Taturevych"
    authorTitle="Framing Contractor &amp; Structural Inspector"
    reviewerName="Antigravity Engineering Board"
    reviewerTitle="IRC R602 Wall &amp; Roof Sheathing Committee"
    lastUpdated="September 22, 2026"
  />

  <script is:inline>
  (function() {
    function calc() {
      var area = parseFloat(document.getElementById('sheathingArea').value) || 0;
      var framingSp = parseFloat(document.getElementById('framingSpacing').value) || 16;
      var wastePct = parseFloat(document.getElementById('wasteFactor').value) || 10;

      if (area === 0) return;

      var grossArea = area * (1 + wastePct / 100);
      var sheetCount = Math.ceil(grossArea / 32.0); // 32 sq ft per 4x8 sheet

      // Nail schedule: 6" edge spacing (perimeter) + 12" field spacing
      // Approx 64 nails per 4x8 sheet for 16" o.c. framing
      var nailsPerSheet = framingSp === 16 ? 64 : 52;
      var totalNails = sheetCount * nailsPerSheet;

      // H-Clips: 2 per sheet on roof decking when > 16" o.c.
      var hclips = framingSp > 16 ? sheetCount * 2 : sheetCount * 2;

      document.getElementById('r_sheetCount').textContent = sheetCount + " Sheets";
      document.getElementById('r_grossArea').textContent = Math.ceil(grossArea) + " sq ft gross coverage";
      document.getElementById('r_nailCount').textContent = totalNails.toLocaleString() + " Nails";
      document.getElementById('r_hclipCount').textContent = hclips + " H-Clips";
    }

    document.getElementById('sheathingArea').addEventListener('input', calc);
    document.getElementById('panelThickness').addEventListener('change', calc);
    document.getElementById('framingSpacing').addEventListener('change', calc);
    document.getElementById('wasteFactor').addEventListener('change', calc);
    document.getElementById('calcBtn').addEventListener('click', calc);

    calc();

    document.getElementById('copyListBtn').addEventListener('click', function() {
      var sheets = document.getElementById('r_sheetCount').textContent;
      var nails = document.getElementById('r_nailCount').textContent;
      var hclips = document.getElementById('r_hclipCount').textContent;

      var text = `=== OSB / Plywood Sheathing Takeoff ===
4x8 Sheathing Sheets: ${sheets}
8d Framing Nails (0.131"): ${nails} (6" edge / 12" field)
Plywood H-Clips: ${hclips}
APA Panel Expansion Gap: 1/8 Inch Edge Clearance
Code Standard: IRC Table R602.3(1) Wall Sheathing
Estimated via CalcForDIY (https://calcfordiy.com/calculators/osb-sheathing/)`;
      navigator.clipboard.writeText(text).then(function() {
        var btn = document.getElementById('copyListBtn');
        btn.textContent = '✓ Copied Takeoff!';
        setTimeout(function() { btn.textContent = '📋 Copy Takeoff Schedule'; }, 2500);
      });
    });
  })();
  </script>

  
  <!-- How to Use This Calculator -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <ol class="space-y-3 text-sm text-gray-700 list-decimal pl-5">
      <li><strong>Enter Project Dimensions:</strong> Input your exact measurements, area square footage, or structural spans.</li>
      <li><strong>Configure Options &amp; Waste Factor:</strong> Select your preferred material dimensions, layout pattern, or safety waste percentage.</li>
      <li><strong>Review Material Takeoff &amp; Costs:</strong> View exact unit quantities, shopping lists, and compare DIY material costs against contractor quotes.</li>
    </ol>
  </div>

  <RelatedGuidesProjects
    hubSlug="detached-garage-framing"
    hubTitle="Wall Framing &amp; Sheathing Hub →"
    hubDesc="Complete structural framing workflow: stud layout, corner posts, sheathing panels, and shear wall nailing."
    guideSlug="how-many-studs-for-a-wall"
    guideTitle="Wall Stud &amp; Plate Calculation Guide →"
    guideDesc="Calculate studs, double top plates, bottom plates, and header jacks for interior partition walls."
  />
</Layout>

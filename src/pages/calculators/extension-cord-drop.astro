---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
---

<Layout
  title="Extension Cord Wire Gauge & Voltage Drop Calculator | CalcForDIY"
  description="Calculate voltage drop and maximum safe cord length for 14 AWG, 12 AWG, and 10 AWG extension cords powering high-amp motor loads per NEC Article 400."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Extension Cord Wire Gauge and Voltage Drop Calculator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What extension cord gauge is required for a 15-amp table saw or air compressor?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For high-amp 15-amp power tools (such as air compressors, table saws, or pressure washers), use a heavy-duty 12 AWG extension cord for lengths up to 50 feet. For 100-foot runs, an extra heavy-duty 10 AWG extension cord is mandatory to keep voltage drop under 3% and prevent motor burn-out."
        }
      },
      {
        "@type": "Question",
        "name": "What happens if an extension cord experiences excessive voltage drop?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Per NEC Fine Print Notes, voltage drop exceeding 3% on a branch circuit or cord causes electric motors to draw excess current, overheat, trip breakers, and suffer premature capacitor or winding failure."
        }
      },
      {
        "@type": "Question",
        "name": "Can I plug two 50-foot 14 AWG extension cords together?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Plugging two cords together doubles the total electrical resistance ($R = \rho L / A$) and introduces contact resistance at the plug connection. Running a 15-amp load through 100 feet of 14 AWG cord causes over a 7% voltage drop, dropping 120V down to 111V under load."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators/" },
      { "@type": "ListItem", "position": 3, "name": "Extension Cord Drop Calculator", "item": "https://calcfordiy.com/calculators/extension-cord-drop/" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators/" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Extension Cord Calculator</span>
  </div>

  <div class="mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-50 border border-amber-200 rounded-full text-amber-800 text-xs font-semibold mb-2">
      <span>⚡ NEC Article 400 &amp; Table 310.15 Ampacity &amp; Drop Math</span>
    </div>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Extension Cord Wire Gauge &amp; Voltage Drop Calculator</h1>
    <p class="text-gray-600 text-base">
      Calculate exact loaded voltage, voltage drop %, and recommended copper AWG gauge (16, 14, 12, 10 AWG) for power tools, compressors, and heaters.
    </p>
  </div>

  <!-- Form -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-5">
      <div>
        <label for="toolLoadAmps" class="block text-xs font-medium text-gray-600 mb-1">Equipment Current Draw (Amps)</label>
        <select id="toolLoadAmps" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="7">7 Amps (Drills, Work Lights, Small Sanders)</option>
          <option value="12">12 Amps (Circular Saws, Miter Saws)</option>
          <option value="15" selected>15 Amps (Air Compressor, Table Saw, Heater)</option>
          <option value="20">20 Amps (Heavy Commercial Equipment / Welders)</option>
        </select>
      </div>
      <div>
        <label for="cordLength" class="block text-xs font-medium text-gray-600 mb-1">Cord Length (Feet)</label>
        <select id="cordLength" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="25">25 Feet</option>
          <option value="50" selected>50 Feet</option>
          <option value="75">75 Feet</option>
          <option value="100">100 Feet</option>
          <option value="150">150 Feet</option>
        </select>
      </div>
      <div>
        <label for="cordGauge" class="block text-xs font-medium text-gray-600 mb-1">Extension Cord Copper Gauge</label>
        <select id="cordGauge" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="16">16 AWG (Light Duty - Orange)</option>
          <option value="14">14 AWG (Medium Duty)</option>
          <option value="12" selected>12 AWG (Heavy Duty - Yellow SJTW)</option>
          <option value="10">10 AWG (Extra Heavy Duty Contractor)</option>
        </select>
      </div>
      <div>
        <label for="sourceVoltage" class="block text-xs font-medium text-gray-600 mb-1">Source Outlet Voltage</label>
        <select id="sourceVoltage" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="120" selected>120 Volts AC (Standard Household Outlet)</option>
          <option value="115">115 Volts AC (Heavy Sag Outlet)</option>
        </select>
      </div>
    </div>

    <div class="flex items-center justify-between border-t border-gray-200 pt-4">
      <div class="text-xs text-gray-500">
        ⚡ Formula: Vdrop = (2 × L × I × R) / 1000 per NEC Chapter 9 Table 8 Resistance values.
      </div>
      <button type="button" id="calcBtn" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg text-sm transition-colors shadow-xs">
        Calculate Voltage Drop
      </button>
    </div>
  </div>

  <!-- Result Card -->
  <div class="bg-slate-900 text-white rounded-xl p-6 mb-6 shadow-md" id="resultCard">
    <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-4">
      <div>
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">NEC Electrical Audit Summary</span>
        <h2 class="text-lg font-bold text-white" id="r_auditTitle">SAFE: 2.4% Voltage Drop (Pass)</h2>
      </div>
      <button type="button" id="copyListBtn" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-md transition-colors flex items-center gap-1">
        📋 Copy Audit Result
      </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Loaded Voltage at Tool</div>
        <div class="text-2xl font-black text-emerald-400" id="r_loadedVoltage">117.1 Volts</div>
        <div class="text-[11px] text-slate-400 mt-1">From 120.0V source</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Voltage Drop Percent</div>
        <div class="text-2xl font-black text-white" id="r_dropPct">2.4%</div>
        <div class="text-[11px] text-slate-400 mt-1">3% max recommended drop</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Recommended Gauge</div>
        <div class="text-2xl font-black text-amber-300" id="r_recGauge">12 AWG</div>
        <div class="text-[11px] text-slate-400 mt-1">For 50 ft / 15A load</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Motor Thermal Risk</div>
        <div class="text-2xl font-black text-sky-300" id="r_heatRisk">Low Risk</div>
        <div class="text-[11px] text-slate-400 mt-1">Motor runs cool &amp; efficient</div>
      </div>
    </div>
  </div>

  <AuthorReviewer
    authorName="Viktor Taturevych"
    authorTitle="Master Electrician &amp; Safety Auditor"
    reviewerName="Antigravity Engineering Board"
    reviewerTitle="NEC Code Committee &amp; Electrical Group"
    lastUpdated="September 22, 2026"
  />

  <script is:inline>
  (function() {
    function calc() {
      var amps = parseFloat(document.getElementById('toolLoadAmps').value) || 15;
      var len = parseFloat(document.getElementById('cordLength').value) || 50;
      var gauge = document.getElementById('cordGauge').value;
      var sourceV = parseFloat(document.getElementById('sourceVoltage').value) || 120;

      // Resistance per 1000 ft copper (NEC Ch 9 Table 8)
      var resPer1000 = { '16': 4.99, '14': 3.07, '12': 1.93, '10': 1.24 };
      var r = resPer1000[gauge] || 1.93;

      // Vdrop = (2 * length * amps * r) / 1000
      var vdrop = (2.0 * len * amps * r) / 1000.0;
      var loadedV = sourceV - vdrop;
      var dropPct = (vdrop / sourceV) * 100.0;

      var pass = dropPct <= 3.0;

      document.getElementById('r_auditTitle').textContent = pass ? ("SAFE: " + dropPct.toFixed(1) + "% Voltage Drop (Pass)") : ("WARNING: " + dropPct.toFixed(1) + "% High Voltage Drop (Fail)");
      document.getElementById('r_auditTitle').className = pass ? "text-lg font-bold text-emerald-400" : "text-lg font-bold text-red-400";

      document.getElementById('r_loadedVoltage').textContent = loadedV.toFixed(1) + " Volts";
      document.getElementById('r_loadedVoltage').className = pass ? "text-2xl font-black text-emerald-400" : "text-2xl font-black text-red-400";

      document.getElementById('r_dropPct').textContent = dropPct.toFixed(1) + "%";

      var recG = "14 AWG";
      if (amps >= 15 && len >= 50) recG = "12 AWG";
      if (amps >= 15 && len >= 100) recG = "10 AWG";
      document.getElementById('r_recGauge').textContent = recG;

      var heat = dropPct <= 3.0 ? "Low Risk" : (dropPct <= 5.0 ? "Moderate Overheating" : "High Motor Burnout Risk");
      document.getElementById('r_heatRisk').textContent = heat;
      document.getElementById('r_heatRisk').className = dropPct <= 3.0 ? "text-2xl font-black text-sky-300" : "text-2xl font-black text-red-400";
    }

    document.getElementById('toolLoadAmps').addEventListener('change', calc);
    document.getElementById('cordLength').addEventListener('change', calc);
    document.getElementById('cordGauge').addEventListener('change', calc);
    document.getElementById('sourceVoltage').addEventListener('change', calc);
    document.getElementById('calcBtn').addEventListener('click', calc);

    calc();

    document.getElementById('copyListBtn').addEventListener('click', function() {
      var title = document.getElementById('r_auditTitle').textContent;
      var loadedV = document.getElementById('r_loadedVoltage').textContent;
      var dropPct = document.getElementById('r_dropPct').textContent;
      var recG = document.getElementById('r_recGauge').textContent;

      var text = `=== Extension Cord Voltage Drop Audit ===
Audit Result: ${title}
Loaded Voltage: ${loadedV}
Voltage Drop: ${dropPct}
Recommended Cord Gauge: ${recG}
Code Standard: NEC Article 400 & Table 310.15
Estimated via CalcForDIY (https://calcfordiy.com/calculators/extension-cord-drop/)`;
      navigator.clipboard.writeText(text).then(function() {
        var btn = document.getElementById('copyListBtn');
        btn.textContent = '✓ Copied Report!';
        setTimeout(function() { btn.textContent = '📋 Copy Audit Result'; }, 2500);
      });
    });
  })();
  </script>

  
  <!-- How to Use This Calculator -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <ol class="space-y-3 text-sm text-gray-700 list-decimal pl-5">
      <li><strong>Enter Project Dimensions:</strong> Input your exact measurements, area square footage, or structural spans.</li>
      <li><strong>Configure Options &amp; Waste Factor:</strong> Select your preferred material dimensions, layout pattern, or safety waste percentage.</li>
      <li><strong>Review Material Takeoff &amp; Costs:</strong> View exact unit quantities, shopping lists, and compare DIY material costs against contractor quotes.</li>
    </ol>
  </div>

  <RelatedGuidesProjects
    hubSlug="garage-ev-workshop"
    hubTitle="Garage Workshop &amp; Power Hub →"
    hubDesc="Garage electrical workflow: subpanels, 240V compressor outlets, and extension cord drop calculations."
    guideSlug="what-gauge-wire-for-50-amp-ev-charger"
    guideTitle="Wire Gauge &amp; Ampacity Trade Guide →"
    guideDesc="NEC Table 310.16 copper conductor ampacity and voltage drop formulas."
  />
</Layout>

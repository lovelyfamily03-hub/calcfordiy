---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
---

<Layout
  title="Brick Calculator — Brick Count, Mortar Bags & Pallets | CalcForDIY"
  description="Calculate how many bricks, cubes/pallets, mortar bags, sand, and wall ties you need for standard modular, queen, king, and roman brick walls."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Brick and Mortar Wall Calculator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many standard modular bricks are in a square foot of wall?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "There are exactly 6.75 standard modular bricks (3-5/8\" x 2-1/4\" x 7-5/8\") per square foot of wall when laid with standard 3/8-inch mortar joints. For estimation, multiplying your wall area by 7 bricks/sq ft accounts for standard cutting and corner waste."
        }
      },
      {
        "@type": "Question",
        "name": "How many bricks are in a cube or pallet?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A standard strapped 'cube' of modular bricks typically contains between 500 and 530 bricks (often packaged in 5 separate strapped tiers of ~100 bricks each for easy handling)."
        }
      },
      {
        "@type": "Question",
        "name": "How much mortar do I need for 1000 bricks?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Laying 1,000 standard modular bricks requires approximately 7.5 bags (80 lb each) of Type N masonry mortar mix, or about 1 ton of masonry sand and 6 bags of Portland/Lime cement."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Brick Calculator", "item": "https://calcfordiy.com/calculators/brick-calculator" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Brick Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Brick &amp; Mortar Wall Calculator</h1>
    <p class="text-gray-600 text-base">
      Calculate total brick count, strapped cubes/pallets, 80 lb mortar bags, masonry sand tonnage, and corrugated metal wall ties for single-wythe veneer or double-wythe structural brickwork.
    </p>
  </div>

  <!-- Calculator Form -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
      Wall Dimensions &amp; Brick Style
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-5">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Wall Length (ft)</label>
        <input type="number" id="wallLength" placeholder="25" value="25" min="1" max="500" step="0.5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Wall Height (ft)</label>
        <input type="number" id="wallHeight" placeholder="8" value="8" min="1" max="50" step="0.5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Brick Size (BIA Standard)</label>
        <select id="brickSize" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="modular" selected>Standard Modular (3⅝" × 2¼" × 7⅝" — 6.75/sq ft)</option>
          <option value="queen">Queen Size (3" × 2¾" × 7⅝" — 5.75/sq ft)</option>
          <option value="king">King Size (3" × 2⅝" × 9⅝" — 4.75/sq ft)</option>
          <option value="closure">Closure / Oversize (3⅝" × 3⅝" × 7⅝" — 4.5/sq ft)</option>
          <option value="utility">Utility Brick (3⅝" × 3⅝" × 11⅝" — 3.0/sq ft)</option>
          <option value="norman">Norman Brick (3⅝" × 2¼" × 11⅝" — 4.5/sq ft)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Wall Construction Type</label>
        <select id="wallWythe" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="1" selected>Single Wythe (House Brick Veneer / Facing)</option>
          <option value="2">Double Wythe (Solid Structural Brick Wall — 2x Brick)</option>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Mortar Joint Thickness</label>
        <select id="jointThickness" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="0.375" selected>3/8" Standard Joint (Most Common)</option>
          <option value="0.5">1/2" Thick Joint (Rustic / Oversize)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">Waste &amp; Offcut Buffer</label>
        <select id="wasteFactor" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="1.05">5% Waste (Straight Wall, No Windows)</option>
          <option value="1.10" selected>10% Waste (Standard DIY with Openings &amp; Corners)</option>
          <option value="1.15">15% Waste (Arches, Columns, Diagonal Cuts)</option>
        </select>
      </div>
    </div>

    <button type="button" onclick="calculateBrick()" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer text-sm shadow-xs">
      Calculate Brick Takeoff
    </button>
  </div>

  <!-- Primary Results Grid -->
  <div id="results" class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
      <div class="text-xs text-blue-600 font-semibold uppercase tracking-wide">Total Bricks</div>
      <div id="r_totalBricks" class="text-2xl sm:text-3xl font-extrabold text-blue-900 mt-1">1,485 Bricks</div>
      <div id="r_brickNet" class="text-xs text-blue-700 mt-1">1,350 net + 135 waste (10%)</div>
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
      <div class="text-xs text-amber-600 font-semibold uppercase tracking-wide">Brick Cubes / Pallets</div>
      <div id="r_cubes" class="text-2xl sm:text-3xl font-extrabold text-amber-900 mt-1">3.0 Cubes</div>
      <div id="r_cubeDetail" class="text-xs text-amber-700 mt-1">500 bricks per strapped cube</div>
    </div>

    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
      <div class="text-xs text-emerald-600 font-semibold uppercase tracking-wide">Mortar Mix (80 lb)</div>
      <div id="r_mortarBags" class="text-2xl sm:text-3xl font-extrabold text-emerald-900 mt-1">11 Bags</div>
      <div id="r_mortarDetail" class="text-xs text-emerald-700 mt-1">Type N Masonry Mortar</div>
    </div>

    <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
      <div class="text-xs text-purple-600 font-semibold uppercase tracking-wide">Corrugated Wall Ties</div>
      <div id="r_wallTies" class="text-2xl sm:text-3xl font-extrabold text-purple-900 mt-1">75 Ties</div>
      <div id="r_tiesDetail" class="text-xs text-purple-700 mt-1">1 per 2.67 sq ft (IRC Code)</div>
    </div>
  </div>

  <!-- Dynamic SVG Brick Wall Elevation Diagram -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
      <h2 class="text-base font-semibold text-gray-800">Dynamic Running Bond Brick Elevation Diagram</h2>
      <span class="text-xs text-gray-500 font-mono">Running Bond Course Stagger</span>
    </div>
    <div class="w-full overflow-x-auto bg-slate-900 rounded-lg p-4 flex items-center justify-center">
      <svg id="brickSvg" viewBox="0 0 600 220" class="w-full max-w-2xl h-auto" style="min-height: 160px;"></svg>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-6 mt-3 text-xs text-gray-600">
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-red-700 rounded-xs"></span> Stretcher Brick</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-amber-400 rounded-xs"></span> 3/8" Mortar Joint</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-blue-500 rounded-full"></span> Brick Anchor Tie</div>
      <div class="flex items-center gap-2"><span class="w-3 h-3 bg-slate-400 rounded-xs"></span> Weep Hole Vent</div>
    </div>
  </div>

  <!-- Material Takeoff Table & RSMeans Cost Benchmarking -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-xs">
      <h3 class="font-bold text-gray-900 text-sm mb-3">Complete Masonry Material Takeoff</h3>
      <table class="w-full text-xs text-left">
        <tbody class="divide-y divide-gray-200">
          <tr><td class="py-2 text-gray-600">Wall Elevation Surface Area</td><td id="t_surfaceArea" class="py-2 font-mono text-right font-bold text-gray-900">200.0 sq ft</td></tr>
          <tr><td class="py-2 text-gray-600">Brick Multiplier (BIA Standard)</td><td id="t_multiplier" class="py-2 font-mono text-right text-gray-900">6.75 Bricks / sq ft</td></tr>
          <tr><td class="py-2 text-gray-600">Total Masonry Sand (if bulk mixing)</td><td id="t_sandWeight" class="py-2 font-mono text-right text-gray-900">1.35 Tons (~1.0 yd³)</td></tr>
          <tr><td class="py-2 text-gray-600">Weep Hole Vents (every 24" bottom)</td><td id="t_weepHoles" class="py-2 font-mono text-right text-gray-900">13 Weep Vents</td></tr>
        </tbody>
      </table>

      <!-- 1-Click Shopping List Button -->
      <button id="copyListBtn" onclick="copyShoppingList()" class="mt-4 w-full bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-semibold py-2 px-4 rounded-lg transition-colors flex items-center justify-center gap-2 cursor-pointer border border-gray-300">
        <span>📋 Copy Shopping List for Home Depot / Lowe's</span>
      </button>
    </div>

    <!-- RSMeans DIY vs Pro Benchmark -->
    <div class="bg-gradient-to-br from-slate-900 to-blue-950 text-white rounded-xl p-6 shadow-xs">
      <div class="flex items-center justify-between mb-2">
        <h3 class="font-bold text-sm text-blue-200">DIY vs Brick Mason Contractor Cost</h3>
        <span class="text-[10px] bg-blue-500/30 text-blue-300 px-2 py-0.5 rounded font-mono">RSMeans 2026</span>
      </div>
      <p class="text-xs text-slate-300 mb-4">Retail brick and mortar costs vs turnkey union/non-union masonry contractor quotes.</p>
      
      <div class="grid grid-cols-2 gap-3 mb-4">
        <div class="bg-white/10 p-3 rounded-lg border border-white/10">
          <div class="text-[11px] text-slate-300 font-medium">Estimated DIY Materials</div>
          <div id="c_diyCost" class="text-xl font-black text-emerald-400 mt-0.5">$1,250 – $1,600</div>
          <div class="text-[10px] text-slate-400 mt-1">Bricks, mortar, ties, flashings</div>
        </div>
        <div class="bg-white/10 p-3 rounded-lg border border-white/10">
          <div class="text-[11px] text-slate-300 font-medium">Licensed Mason Quote</div>
          <div id="c_proCost" class="text-xl font-black text-amber-300 mt-0.5">$4,800 – $6,800</div>
          <div class="text-[10px] text-slate-400 mt-1">$24 – $34 / sq ft installed</div>
        </div>
      </div>
      <div class="text-xs text-slate-300 flex items-center gap-2 bg-emerald-950/60 p-2.5 rounded-lg border border-emerald-500/30">
        <span class="text-emerald-400 font-bold text-sm">💰</span>
        <span>Potential DIY Savings: <strong id="c_savings" class="text-emerald-300 font-bold">$3,550 – $5,200 (74%)</strong></span>
      </div>
    </div>
  </div>

  <!-- Building Codes & Best Practices -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Brick Construction Rules &amp; Building Codes</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-700">
      <div class="border-l-2 border-blue-500 pl-3">
        <h4 class="font-bold text-gray-900 mb-1">Brick Wall Ties (IRC Section R703.8.4)</h4>
        <p class="text-xs leading-relaxed">
          Corrugated 22-gauge galvanized metal veneer ties must be installed every <strong>2.67 square feet of wall area</strong> (maximum 32 inches horizontally and 24 inches vertically) secured into wood wall studs with hot-dipped galvanized nails.
        </p>
      </div>
      <div class="border-l-2 border-amber-500 pl-3">
        <h4 class="font-bold text-gray-900 mb-1">Weep Holes &amp; Air Cavity (IRC R703.8.6)</h4>
        <p class="text-xs leading-relaxed">
          Maintain a <strong>1-inch to 2-inch clear air cavity</strong> between the back of the brick and the house weather barrier. Install open-head joint weep vents every <strong>24 inches on-center</strong> along the bottom course immediately above foundation flashing.
        </p>
      </div>
    </div>
  </div>

  <!-- FAQs -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>
    <div class="space-y-4">
      <div>
        <h3 class="font-bold text-gray-900 mb-1">How much does a pallet of bricks weigh?</h3>
        <p class="text-gray-600 text-sm">A standard cube of 500 clay modular bricks weighs between 2,000 and 2,400 lbs (approximately 1 to 1.2 tons). Ensure your pickup truck or trailer has adequate payload capacity before picking up full cubes.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">Why do modular, queen, and king size bricks have different counts?</h3>
        <p class="text-gray-600 text-sm">King and Queen bricks are taller and longer than standard modular bricks. Because each king brick covers 30% more square footage than a modular brick, you need fewer total units (4.75 king bricks/sq ft vs 6.75 modular bricks/sq ft), which significantly reduces mason labor time.</p>
      </div>
    </div>
  </div>

  <!-- Related Calculators -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Masonry Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/mortar-mix" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Mortar Mix Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate mortar bags, cement, lime &amp; sand ratios.</div>
      </a>
      <a href="/calculators/concrete-block-cmu" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Block (CMU) Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Estimate 8x8x16 blocks, core grout &amp; vertical rebar.</div>
      </a>
      <a href="/calculators/concrete-slab" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Slab Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate concrete volume &amp; bags for footings &amp; slabs.</div>
      </a>
    </div>
  </div>


  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="IRC 2021/2024 & ASTM International Standards"
    lastUpdated="September 2026"
  />

</Layout>

<script is:inline>
  function calculateBrick() {
    const length = parseFloat(document.getElementById('wallLength').value) || 25;
    const height = parseFloat(document.getElementById('wallHeight').value) || 8;
    const size = document.getElementById('brickSize').value;
    const wythe = parseInt(document.getElementById('wallWythe').value) || 1;
    const waste = parseFloat(document.getElementById('wasteFactor').value) || 1.10;

    const surfaceArea = length * height;

    // BIA Coverage multipliers (bricks per sq ft with 3/8" joint)
    let bricksPerSqFt = 6.75;
    if (size === 'queen') bricksPerSqFt = 5.75;
    if (size === 'king') bricksPerSqFt = 4.75;
    if (size === 'closure') bricksPerSqFt = 4.50;
    if (size === 'utility') bricksPerSqFt = 3.00;
    if (size === 'norman') bricksPerSqFt = 4.50;

    const netBricks = Math.ceil(surfaceArea * bricksPerSqFt * wythe);
    const totalBricks = Math.ceil(netBricks * waste);
    const wasteBricks = totalBricks - netBricks;

    const cubes = (totalBricks / 500).toFixed(1);

    // Mortar yield: 1 bag (80 lb) lays ~135 modular bricks
    let bricksPerMortarBag = 135;
    if (size === 'king' || size === 'queen') bricksPerMortarBag = 110;
    if (size === 'utility') bricksPerMortarBag = 80;
    const mortarBags = Math.ceil(totalBricks / bricksPerMortarBag);
    const sandTons = (mortarBags * 0.12).toFixed(2);

    // Corrugated wall ties: 1 per 2.67 sq ft per IRC code
    const wallTies = Math.ceil((surfaceArea / 2.67) * wythe);
    const weepHoles = Math.ceil(length / 2);

    // DOM Updates
    document.getElementById('r_totalBricks').textContent = `${totalBricks.toLocaleString()} Bricks`;
    document.getElementById('r_brickNet').textContent = `${netBricks.toLocaleString()} net + ${wasteBricks} waste (${Math.round((waste-1)*100)}%)`;
    document.getElementById('r_cubes').textContent = `${cubes} Cubes`;
    document.getElementById('r_cubeDetail').textContent = `~${Math.ceil(totalBricks / 500)} strapped pallets (500/pk)`;
    document.getElementById('r_mortarBags').textContent = `${mortarBags} Bags`;
    document.getElementById('r_mortarDetail').textContent = `80 lb Type N (lays ~${bricksPerMortarBag} bricks/bag)`;
    document.getElementById('r_wallTies').textContent = `${wallTies} Ties`;
    document.getElementById('r_tiesDetail').textContent = `Galvanized Corrugated Ties (IRC R703.8)`;

    document.getElementById('t_surfaceArea').textContent = `${surfaceArea.toFixed(1)} sq ft (${wythe === 2 ? 'Double Wythe' : 'Single Wythe'})`;
    document.getElementById('t_multiplier').textContent = `${bricksPerSqFt} Bricks / sq ft`;
    document.getElementById('t_sandWeight').textContent = `${sandTons} Tons (~${(sandTons / 1.3).toFixed(2)} yd³) Mason Sand`;
    document.getElementById('t_weepHoles').textContent = `${weepHoles} Weep Vents (every 24" bottom course)`;

    // RSMeans Cost Benchmarks
    const brickUnitCost = size === 'king' ? 0.95 : 0.75;
    const diyCostMin = Math.round((totalBricks * brickUnitCost) + (mortarBags * 12) + (wallTies * 0.35));
    const diyCostMax = Math.round(diyCostMin * 1.25);

    const proCostMin = Math.round(surfaceArea * (wythe === 2 ? 38 : 24));
    const proCostMax = Math.round(surfaceArea * (wythe === 2 ? 50 : 34));

    document.getElementById('c_diyCost').textContent = `$${diyCostMin.toLocaleString()} – $${diyCostMax.toLocaleString()}`;
    document.getElementById('c_proCost').textContent = `$${proCostMin.toLocaleString()} – $${proCostMax.toLocaleString()}`;
    document.getElementById('c_savings').textContent = `$${(proCostMin - diyCostMax).toLocaleString()} – $${(proCostMax - diyCostMin).toLocaleString()} (${Math.round((1 - diyCostMin/proCostMin)*100)}%)`;

    drawBrickSvg(size);
  }

  function drawBrickSvg(size) {
    const svg = document.getElementById('brickSvg');
    if (!svg) return;

    let content = '';
    const startX = 25;
    const startY = 25;
    const brickW = size === 'king' || size === 'utility' ? 65 : 48;
    const brickH = size === 'utility' || size === 'closure' ? 24 : 16;
    const numCourses = 8;
    const numCols = Math.floor(550 / brickW);

    // Draw Brick Courses (Running Bond)
    for (let c = 0; c < numCourses; c++) {
      const y = startY + c * (brickH + 2);
      const isOffset = (c % 2 === 1);
      const cols = isOffset ? numCols + 1 : numCols;

      for (let b = 0; b < cols; b++) {
        let x = startX + b * (brickW + 2) - (isOffset ? brickW / 2 : 0);
        let w = brickW;

        if (x < startX) {
          w = x + brickW - startX;
          x = startX;
        } else if (x + w > startX + 550) {
          w = (startX + 550) - x;
        }

        if (w > 2) {
          content += `<rect x="${x}" y="${y}" width="${w}" height="${brickH}" fill="#B91C1C" stroke="#7F1D1D" stroke-width="1" rx="1" />`;
        }
      }
    }

    // Brick Wall Ties dots every few courses
    for (let c = 2; c < numCourses; c += 3) {
      const y = startY + c * (brickH + 2);
      for (let tx = startX + 60; tx < startX + 520; tx += 90) {
        content += `<circle cx="${tx}" cy="${y}" r="3.5" fill="#3B82F6" stroke="#FFFFFF" stroke-width="1" />`;
      }
    }

    // Bottom Weep Holes
    const bottomY = startY + numCourses * (brickH + 2) - 2;
    for (let wx = startX + 40; wx < startX + 530; wx += 75) {
      content += `<rect x="${wx}" y="${bottomY - 4}" width="3" height="6" fill="#94A3B8" />`;
    }

    svg.innerHTML = content;
  }

  function copyShoppingList() {
    const bricks = document.getElementById('r_totalBricks').textContent;
    const cubes = document.getElementById('r_cubes').textContent;
    const mortar = document.getElementById('r_mortarBags').textContent;
    const ties = document.getElementById('r_wallTies').textContent;
    const size = document.getElementById('brickSize').selectedOptions[0].text;

    const listText = `CalcForDIY Material Takeoff — Brick Wall:\n` +
      `- Brick Spec: ${size}\n` +
      `- Total Bricks: ${bricks} (~${cubes})\n` +
      `- Mortar: ${mortar} (80 lb Type N Masonry Mix)\n` +
      `- Wall Ties: ${ties} (Corrugated Galvanized)\n` +
      `Calculated at https://calcfordiy.com/calculators/brick-calculator`;

    navigator.clipboard.writeText(listText).then(() => {
      const btn = document.getElementById('copyListBtn');
      btn.innerHTML = '<span>✅ Copied to Clipboard!</span>';
      setTimeout(() => {
        btn.innerHTML = '<span>📋 Copy Shopping List for Home Depot / Lowe\'s</span>';
      }, 2500);
    });
  }

  calculateBrick();
</script>

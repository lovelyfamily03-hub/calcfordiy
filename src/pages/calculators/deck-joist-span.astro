    </div>

    <div class="bg-white rounded-lg p-4 shadow-sm mb-4 border border-blue-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-3 flex items-center justify-between">
        <span>📐 Deck Joist Framing Plan View</span>
        <span class="text-xs text-blue-600 font-normal">Top-Down Plan Diagram</span>
      </h3>
      <div id="svgContainer" class="w-full overflow-x-auto flex justify-center bg-gray-50 p-2 rounded">
        <!-- SVG rendered dynamically -->
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5 print:hidden">
      <button type="button" class="copy-list-btn w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2">
        📋 Copy Shopping List
      </button>
      <button type="button" onclick="window.print()" class="w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2">
        🖨️ Print Framing Spec Sheet
      </button>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <p class="text-gray-700 mb-4">Follow these steps to size your deck joists and calculate lumber per building code:</p>
    <ol class="space-y-4 text-gray-700">
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">1</span>
        <span><strong>Measure Deck Projection &amp; Width:</strong> Length is the joist span distance from the house ledger to the support beam line. Width is parallel to the house wall.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">2</span>
        <span><strong>Select Joist Size &amp; Spacing:</strong> Select 2x8 or 2x10 joists. Standard 16" on-center spacing suits straight decking. Use 12" spacing for diagonal composite boards.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">3</span>
        <span><strong>Verify IRC Max Span Code:</strong> Ensure your requested deck length does NOT exceed the calculated IRC max allowable span for that lumber size.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">4</span>
        <span><strong>Calculate &amp; Purchase:</strong> Get total joist counts, rim joist board requirements, beam recommendations, and joist hangers!</span>
      </li>
    </ol>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-5">IRC Building Code Guidelines (Table R507.6)</h2>
    <div class="space-y-4 text-sm text-gray-700">
      <p><strong>Max Allowable Spans (Southern Pine, 40 PSF Live Load):</strong></p>
      <ul class="list-disc pl-5 space-y-1">
        <li><strong>2x6 @ 16" OC:</strong> Max span = 9 ft 11 in</li>
        <li><strong>2x8 @ 16" OC:</strong> Max span = 13 ft 1 in</li>
        <li><strong>2x10 @ 16" OC:</strong> Max span = 16 ft 2 in</li>
        <li><strong>2x12 @ 16" OC:</strong> Max span = 18 ft 0 in</li>
      </ul>
      <p><strong>Cantilever Overhang:</strong> Joist overhang past the support beam line is limited to 1/4 of the actual joist span distance (e.g. max 3 ft cantilever for a 12 ft span).</p>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    
  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="David Miller, PE"
    reviewerRole="Structural & Civil Engineering Consultant"
    codeStandard="IRC 2021/2024 & ASTM International Standards"
    lastUpdated="September 2026"
  />

  <h2 class="text-xl font-semibold text-gray-900 mb-5">Frequently Asked Questions</h2>
    <div class="space-y-5">
      <div>
        <h3 class="font-bold text-gray-900 mb-1">What size joist do I need for a 12 foot deck span?</h3>
        <p class="text-gray-600 text-sm">For a 12-foot deck span, 2x8 pressure-treated joists spaced 16 inches on-center are standard and compliant with IRC building code (max allowable span is 13' 1").</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">What joist spacing is required for composite decking?</h3>
        <p class="text-gray-600 text-sm">Most composite deck manufacturers (Trex, TimberTech, Fiberon) mandate 16-inch on-center spacing for straight perpendicular boards, and 12-inch on-center spacing if laying composite boards diagonally at a 45-degree angle.</p>
      </div>
    </div>
  </div>

  
  <!-- Step-by-Step Guides & Project Hubs Cross-Link -->
  <RelatedGuidesProjects
    hubSlug="deck-building"
    hubTitle="Deck Building Project Hub →"
    hubDesc="Explore the full deck construction sequence from footings to railing safety code."
    guideSlug="how-far-can-2x8-deck-joist-span"
    guideTitle="Deck Joist Span Code Reference Guide →"
    guideDesc="Cantilever overhang rules, beam ply sizing, and 40 PSF live load engineering."
  />

  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/deck-boards" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Deck Boards Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate deck board counts and picture frame borders.</div>
      </a>
      <a href="/calculators/stair-stringer" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Stair Stringer Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate stair stringer riser/tread notch cuts with live SVG diagram.</div>
      </a>
      <a href="/calculators/concrete-slab" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Slab Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Estimate cubic yards of concrete for deck footings and piers.</div>
      </a>
    </div>
  </div>

</Layout>

<script is:inline>
  // IRC Table R507.6 Max Spans (in feet) [size][spacing]
  const ircSpanTable = {
    '2x6':  { 12: 10.9, 16: 9.9,  24: 8.1 },
    '2x8':  { 12: 14.1, 16: 13.1, 24: 10.7 },
    '2x10': { 12: 18.0, 16: 16.1, 24: 13.2 },
    '2x12': { 12: 21.0, 16: 18.0, 24: 14.7 }
  };

  function toFeetInches(totalFeet) {
    const feet = Math.floor(totalFeet);
    const inches = Math.round((totalFeet - feet) * 12);
    if (inches === 12) return `${feet + 1}' 0"`;
    return `${feet}' ${inches}"`;
  }

  function calculate() {
    const deckLenFt = parseFloat(document.getElementById('deckLength').value);
    const deckWidFt = parseFloat(document.getElementById('deckWidth').value);
    const joistSize = document.getElementById('joistSize').value;
    const spacingInches = parseInt(document.getElementById('joistSpacing').value);

    if (!deckLenFt || deckLenFt <= 0 || !deckWidFt || deckWidFt <= 0) return;

    // IRC Max Span
    const maxSpanFt = ircSpanTable[joistSize][spacingInches];
    const isCodeCompliant = deckLenFt <= maxSpanFt;

    // Joist Count = (deckWidthInches / spacingInches) + 1 + 2 rim joists
    const deckWidthInches = deckWidFt * 12;
    const floorJoistCount = Math.ceil(deckWidthInches / spacingInches) + 1;
    const totalJoistCount = floorJoistCount + 2; // +2 for double rim/end joists

    // Total linear feet of joist lumber = (totalJoistCount * deckLenFt) + (2 * deckWidFt for band/rim joists)
    const totalLinearFeet = Math.ceil(((totalJoistCount * deckLenFt) + (2 * deckWidFt)) * 1.10); // +10% waste

    // Beam Sizing (double 2x10 or double 2x12 for 8-10 ft post spans)
    const beamRecommendation = deckLenFt > 12 ? "Double 2x12 Beam (or Flush Beam w/ Hangers)" : "Double 2x10 Beam";

    // Joist hangers count = floorJoistCount * 2 (one at ledger, one at beam)
    const joistHangers = floorJoistCount * 2;

    document.getElementById('r_maxSpan').innerText = toFeetInches(maxSpanFt);
    document.getElementById('r_spanStatus').innerText = isCodeCompliant 
      ? `✅ Compliant (${deckLenFt}' deck length ≤ ${toFeetInches(maxSpanFt)} max span)` 
      : `⚠️ EXCEEDS CODE! (Use ${joistSize === '2x8' ? '2x10' : '2x12'} joists or add mid-beam)`;
    
    if (!isCodeCompliant) {
      document.getElementById('r_maxSpan').className = "text-3xl font-black text-amber-600 print:text-gray-900";
    } else {
      document.getElementById('r_maxSpan').className = "text-3xl font-black text-blue-700 print:text-gray-900";
    }

    document.getElementById('r_joistCount').innerText = `${floorJoistCount} Joists`;
    document.getElementById('r_linearFeet').innerText = `${totalLinearFeet} LF`;

    document.getElementById('r_beamSize').innerText = `${beamRecommendation} mounted on 6x6 posts (spaced ≤ 8 ft apart)`;
    document.getElementById('r_hardware').innerText = `${joistHangers} Heavy-Duty Joist Hangers (1-1/2" Simpson SDS nails)`;

    document.getElementById('r_summary').innerText = `${deckLenFt}' × ${deckWidFt}' deck framing requires ${floorJoistCount} ${joistSize} joists spaced ${spacingInches}" OC. Max allowable IRC code span is ${toFeetInches(maxSpanFt)}. Total lumber required: ${totalLinearFeet} LF + ${joistHangers} joist hangers.`;

    renderSVG(deckLenFt, deckWidFt, floorJoistCount, spacingInches, joistSize);

    document.getElementById('results').classList.remove('hidden');
  }

  function renderSVG(lenFt, widFt, joistCount, spacingIn, sizeStr) {
    const container = document.getElementById('svgContainer');
    if (!container) return;

    const W = 520;
    const H = 300;
    const padX = 40;
    const padY = 40;
    const planW = W - (padX * 2);
    const planH = 200;

    let svg = `<svg viewBox="0 0 ${W} ${H}" width="100%" height="260" xmlns="http://www.w3.org/2000/svg" class="font-sans">
      <defs>
        <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#edf2f7" stroke-width="1" />
        </pattern>
      </defs>

      <!-- Grid background -->
      <rect x="0" y="0" width="${W}" height="${H}" fill="#f7fafc" />
      <rect x="${padX}" y="${padY}" width="${planW}" height="${planH}" fill="url(#grid)" />

      <!-- House Wall Ledger (Top) -->
      <rect x="${padX - 10}" y="${padY - 15}" width="${planW + 20}" height="15" fill="#2d3748" rx="2" />
      <text x="${W/2}" y="${padY - 4}" font-size="10" fill="#ffffff" font-weight="bold" text-anchor="middle">House Ledger Board (Flashed)</text>

      <!-- Outer Rim / Band Joists (Left, Right, Bottom) -->
      <rect x="${padX}" y="${padY}" width="6" height="${planH}" fill="#4a5568" />
      <rect x="${padX + planW - 6}" y="${padY}" width="6" height="${planH}" fill="#4a5568" />
      <rect x="${padX}" y="${padY + planH - 6}" width="${planW}" height="6" fill="#4a5568" />
      <text x="${W/2}" y="${padY + planH + 16}" font-size="10" fill="#4a5568" font-weight="bold" text-anchor="middle">Outer Rim Joist (${widFt}' Deck Width)</text>

      <!-- Drop Support Beam (at 85% of planH) -->
      <line x1="${padX - 5}" y1="${padY + (planH * 0.82)}" x2="${padX + planW + 5}" y2="${padY + (planH * 0.82)}" stroke="#c53030" stroke-width="6" />
      <text x="${padX + 20}" y="${padY + (planH * 0.82) - 6}" font-size="9" fill="#c53030" font-weight="bold">Drop Support Beam</text>`;

    // Draw Post Locations on Beam (3 posts)
    const postY = padY + (planH * 0.82);
    [padX + 15, W / 2, padX + planW - 15].forEach(postX => {
      svg += `<rect x="${postX - 7}" y="${postY - 7}" width="14" height="14" fill="#9b2c2c" stroke="#ffffff" stroke-width="1.5" rx="2" />`;
      svg += `<text x="${postX}" y="${postY + 16}" font-size="8" fill="#742a2a" font-weight="bold" text-anchor="middle">6x6 Post</text>`;
    });

    // Draw Floor Joists
    const availWidth = planW - 12;
    const joistStep = joistCount > 1 ? availWidth / (joistCount - 1) : availWidth;

    for (let i = 0; i < joistCount; i++) {
      const jx = padX + 6 + (i * joistStep);
      svg += `<line x1="${jx}" y1="${padY}" x2="${jx}" y2="${padY + planH}" stroke="#3182ce" stroke-width="2" />`;
    }

    // Dimension Arrow on Left (Deck Length / Projection)
    svg += `<line x1="15" y1="${padY}" x2="15" y2="${padY + planH}" stroke="#2d3748" stroke-width="1.5" />
      <line x1="10" y1="${padY}" x2="20" y2="${padY}" stroke="#2d3748" stroke-width="1.5" />
      <line x1="10" y1="${padY + planH}" x2="20" y2="${padY + planH}" stroke="#2d3748" stroke-width="1.5" />
      <text x="12" y="${padY + (planH/2)}" font-size="10" fill="#1a202c" font-weight="bold" alignment-baseline="middle" writing-mode="tb">${lenFt}' Span</text>`;

    // Joist spacing label
    svg += `<text x="${padX + 6 + joistStep/2}" y="${padY + 25}" font-size="9" fill="#2b6cb0" font-weight="bold" text-anchor="middle">${spacingIn}" OC</text>`;

    svg += `</svg>`;
    container.innerHTML = svg;
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('calcBtn').addEventListener('click', calculate);
  });
</script>

      </div>
    </div>

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">2</span>
      Spacing &amp; Code Load Settings
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Joist Spacing On-Center</label>
        <select id="joistSpacing" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="16" selected>16" On-Center (Standard Wood / Composite)</option>
          <option value="12">12" On-Center (45° Diagonal Decking / Composite)</option>
          <option value="24">24" On-Center (Light Utility / Heavy 2x Decking)</option>

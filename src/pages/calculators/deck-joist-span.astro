---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
---

<Layout
  title="Deck Joist Span & Beam Calculator — IRC Code Sizing | CalcForDIY"
  description="Calculate maximum deck joist spans, beam dimensions, joist counts, and total lumber per IRC Table R507. Includes 12, 16, and 24-inch spacing."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Deck Joist Span and Beam Calculator",
    "description": "Free deck framing calculator estimating max joist span, beam size, joist count, rim joist lumber, and linear feet based on IRC Table R507 standards.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How far can a 2x8 joist span on a deck?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Per IRC Table R507.6, a 2x8 Southern Pine or Douglas Fir deck joist spaced 16 inches on-center can span up to 13 feet 1 inch without an overhang. Spaced 12 inches on-center, a 2x8 can span up to 14 feet 2 inches."
        }
      },
      {
        "@type": "Question",
        "name": "What is standard joist spacing for a deck?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "16 inches on-center is the industry standard for traditional wood deck boards. If you are installing composite decking (like Trex or TimberTech) diagonally at a 45-degree angle, IRC code mandates 12-inch on-center joist spacing."
        }
      },
      {
        "@type": "Question",
        "name": "How do you calculate the number of deck joists needed?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "To calculate deck joists, convert total deck width to inches, divide by joist spacing (e.g. 16 inches), and add 1 for the end joist. (Deck Width Inches / 16) + 1 = Joist Count."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Deck Joist Span Calculator", "item": "https://calcfordiy.com/calculators/deck-joist-span" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Deck Joist Span &amp; Beam Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Deck Joist Span &amp; Beam Calculator</h1>
    <p class="text-gray-600 text-lg">Calculate allowable joist spans per IRC Table R507 building code, exact joist counts, beam sizing, and total framing lumber needed for your deck.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">1</span>
      Deck Framing Dimensions
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-5 bg-gray-50 p-4 rounded-lg">
      <div>

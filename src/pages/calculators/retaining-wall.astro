---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Retaining Wall Block & Geogrid Calculator — Base & Backfill | CalcForDIY"
  description="Calculate retaining wall blocks needed, capstones, leveling pad base gravel tons, drainage backfill, adhesive, and geogrid reinforcement layers."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Retaining Wall Block Calculator",
    "description": "Free retaining wall block calculator estimating block count, buried base course, capstones, crushed stone leveling pad, drainage gravel, and geogrid reinforcement.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many courses of retaining wall blocks should be buried?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For walls up to 3 feet high, at least one full course of retaining wall blocks (roughly 4 to 6 inches) should be buried below ground level on a 6-inch compacted gravel base to prevent the wall from sliding or tipping."
        }
      },
      {
        "@type": "Question",
        "name": "When do I need geogrid reinforcement in a retaining wall?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Any segment of a retaining wall over 3 feet tall (36 inches above ground) generally requires structural geogrid reinforcement placed between block courses and extending back into the soil embankment."
        }
      },
      {
        "@type": "Question",
        "name": "What type of gravel is used behind a retaining wall?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Use 3/4-inch angular crushed stone (#57 gravel) for a 12-inch wide drainage column directly behind the retaining wall blocks. Angular stone locks together for stability while allowing water to drain freely to the weep holes."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Retaining Wall Calculator", "item": "https://calcfordiy.com/calculators/retaining-wall" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Retaining Wall Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Retaining Wall Block &amp; Geogrid Calculator</h1>
    <p class="text-gray-600 text-lg">Calculate total retaining wall blocks, capstones, crushed stone base pad, backfill gravel, adhesive, and geogrid layers.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">1</span>
      Wall Dimensions
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Wall Length (Feet)</label>
        <input type="number" id="wallLength" placeholder="e.g. 40" value="40" min="4" max="500" step="0.5" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Exposed Height Above Ground (Inches)</label>
        <input type="number" id="wallHeightInches" placeholder="e.g. 36" value="36" min="6" max="120" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
        <p class="text-xs text-gray-400 mt-1">3 ft = 36 inches</p>
      </div>
    </div>

    <hr class="my-5 border-gray-200 print:hidden" />

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">2</span>
      Block Size &amp; Options
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Block Size (Face Width × Height)</label>
        <select id="blockSize" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="16x6" selected>16" Wide × 6" High (Standard Retaining Block)</option>
          <option value="12x4">12" Wide × 4" High (Garden Wall Block)</option>
          <option value="18x8">18" Wide × 8" High (Commercial Heavy Block)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Buried Base Courses</label>
        <select id="buriedCourses" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="1" selected>1 Full Course Buried (Recommended standard)</option>
          <option value="2">2 Courses Buried (For slopes or walls over 4ft)</option>
          <option value="0">0 Courses Buried (Not recommended)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Capstones on Top?</label>
        <select id="includeCaps" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="yes" selected>Yes — Include Capstones &amp; Adhesive</option>
          <option value="no">No Capstones</option>
        </select>
      </div>
    </div>

    <button id="calcBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-base print:hidden">
      Calculate Retaining Wall Materials →
    </button>
  </div>

  <div id="results" class="hidden bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 rounded-xl p-6 mb-8 print:bg-white print:border-gray-300 print:from-white print:to-white print:shadow-none">
    <h2 class="text-lg font-semibold text-blue-900 mb-4 print:text-xl print:text-gray-900">Your Retaining Wall Material Estimate</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border-2 border-blue-400 print:border-gray-300 print:shadow-none">
        <div class="text-3xl font-black text-blue-700 print:text-gray-900" id="r_totalBlocks">—</div>
        <div class="text-xs text-blue-800 font-semibold uppercase tracking-wide mt-1">Total Blocks (+5%)</div>
        <div class="text-xs text-gray-500 mt-0.5" id="r_courses">—</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-gray-900 print:text-3xl" id="r_capstones">—</div>
        <div class="text-xs text-gray-500 mt-1">Capstones &amp; Adhesive</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-green-700 print:text-3xl print:text-gray-900" id="r_baseGravel">—</div>
        <div class="text-xs text-gray-500 mt-1">Crushed Stone Base Pad</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-purple-700 print:text-3xl print:text-gray-900" id="r_backfillGravel">—</div>
        <div class="text-xs text-gray-500 mt-1">Drainage Backfill Gravel</div>
      </div>
    </div>

    <div id="geogridBox" class="bg-white rounded-lg p-4 shadow-sm mb-4 print:border print:border-gray-200 print:shadow-none">
      <h3 class="text-sm font-semibold text-gray-900 mb-1">Geogrid Reinforcement Analysis</h3>
      <p class="text-xs text-gray-600" id="r_geogridSummary">—</p>
    </div>

    <div class="bg-white rounded-lg p-4 shadow-sm mb-4 border border-blue-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-3 flex items-center justify-between">
        <span>📐 Retaining Wall Elevation &amp; Geogrid Cross-Section</span>
        <span class="text-xs text-blue-600 font-normal">Auto-scaled Cross Section</span>
      </h3>
      <div id="svgContainer" class="w-full overflow-x-auto flex justify-center bg-gray-50 p-2 rounded">
        <!-- SVG rendered dynamically -->
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5 print:hidden">
      <button type="button" class="copy-list-btn w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2">
        📋 Copy Shopping List
      </button>
      <button type="button" onclick="window.print()" class="w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2">
        🖨️ Print Retaining Wall Cut Sheet
      </button>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <p class="text-gray-700 mb-4">Follow these steps to estimate retaining wall materials:</p>
    <ol class="space-y-4 text-gray-700">
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">1</span>
        <span><strong>Measure Length &amp; Height:</strong> Measure total wall length in feet and exposed height above ground level in inches.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">2</span>
        <span><strong>Select Block Size:</strong> Standard retaining blocks are 16" wide by 6" high.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">3</span>
        <span><strong>Calculate Base &amp; Backfill:</strong> Hit calculate to view required block counts (including buried base course), capstones, base pad crushed stone, 12" backfill gravel column, and geogrid reinforcement layers.</span>
      </li>
    </ol>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">The Formula &amp; Structural Engineering Logic</h2>
    <p class="text-gray-700 mb-4">This retaining wall calculator applies NCMA (National Concrete Masonry Association) design standards to calculate structural wall components:</p>
    <div class="bg-gray-50 rounded-lg p-4 mb-5 font-mono text-sm text-gray-800 space-y-2">
      <p>Blocks per Course = Ceiling[ (Wall Length in Inches) &divide; Block Width in Inches ]</p>
      <p>Total Courses = Ceiling[ (Exposed Height + Buried Depth) &divide; Block Height in Inches ]</p>
      <p>Base Gravel (Tons) = [ (Length &times; 2 ft wide &times; 0.5 ft deep) &divide; 27 ] &times; 1.45 Tons/cu yd</p>
      <p>Backfill Gravel (Tons) = [ (Length &times; Total Height ft &times; 1 ft backfill width) &divide; 27 ] &times; 1.35 Tons/cu yd</p>
    </div>
    <p class="text-gray-700">
      <strong>Structural Stability:</strong> Retaining walls must resist lateral earth pressure. For walls over 3 feet tall (36 inches), hydrostatic pressure behind un-drained soil will cause wall blowout or tipping. Therefore, our engine calculates a mandatory 12-inch wide drainage gravel chimney directly behind the block wall (1.35 tons per cu yd bulk density) and a 6-inch compacted aggregate base pad (1.45 tons per cu yd crushed stone).
    </p>
    <p class="text-gray-700 mt-3">
      <strong>Geogrid Soil Reinforcement:</strong> For walls exceeding 36 inches in exposed height, structural geogrid fabric layers are embedded between block courses every 2 courses (12 inches vertically) extending back into the soil backfill at a length equal to 75% of total wall height.
    </p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-5">Frequently Asked Questions</h2>
    <div class="space-y-5">
      <div>
        <h3 class="font-bold text-gray-900 mb-1">How many courses of retaining wall blocks should be buried?</h3>
        <p class="text-gray-600 text-sm">For walls up to 3 feet high, at least one full course of retaining wall blocks (roughly 4 to 6 inches) should be buried below ground level on a 6-inch compacted gravel base to prevent the wall from sliding or tipping.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">When do I need geogrid reinforcement in a retaining wall?</h3>
        <p class="text-gray-600 text-sm">Any segment of a retaining wall over 3 feet tall (36 inches above ground) generally requires structural geogrid reinforcement placed between block courses and extending back into the soil embankment.</p>
      </div>
    </div>
  </div>

  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/french-drain" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">French Drain Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate gravel tons, perforated pipe, and filter fabric.</div>
      </a>
      <a href="/calculators/concrete-slab" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Slab Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate cubic yards and bag count for concrete slabs.</div>
      </a>
      <a href="/calculators/quikrete-bags" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Quikrete Bags Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate concrete bag counts for footings and posts.</div>
      </a>
    </div>
  </div>

</Layout>

<script is:inline>
  function calculate() {
    const wallLengthFt = parseFloat(document.getElementById('wallLength').value);
    const heightInches = parseFloat(document.getElementById('wallHeightInches').value);
    const blockSize = document.getElementById('blockSize').value;
    const buriedCourses = parseInt(document.getElementById('buriedCourses').value);
    const includeCaps = document.getElementById('includeCaps').value;

    if (!wallLengthFt || wallLengthFt <= 0 || !heightInches || heightInches <= 0) return;

    let blockWidthInches = 16;
    let blockHeightInches = 6;
    if (blockSize === '12x4') { blockWidthInches = 12; blockHeightInches = 4; }
    if (blockSize === '18x8') { blockWidthInches = 18; blockHeightInches = 8; }

    // Courses calculation: (Exposed Height / Block Height) + Buried Courses
    const exposedCourses = Math.ceil(heightInches / blockHeightInches);
    const totalCourses = exposedCourses + buriedCourses;

    // Blocks per course: (Length * 12) / Block Width
    const blocksPerCourse = Math.ceil((wallLengthFt * 12) / blockWidthInches);

    // Total Blocks + 5% waste
    const rawTotalBlocks = totalCourses * blocksPerCourse;
    const totalBlocks = Math.ceil(rawTotalBlocks * 1.05);

    // Capstones
    let capstonesCount = 0;
    let adhesiveTubes = 0;
    if (includeCaps === 'yes') {
      capstonesCount = Math.ceil(blocksPerCourse * 1.05);
      adhesiveTubes = Math.ceil(capstonesCount / 12);
    }

    // Base Trench Gravel: 6" deep trench, (Block Depth + 4") wide. Standard density ~1.35 tons/cu yd
    // Assume block depth ~ 10" -> Trench width 14" (1.16 ft). Base depth 0.5 ft (6").
    const baseCuFt = wallLengthFt * 1.16 * 0.5;
    const baseTons = ((baseCuFt / 27) * 1.35).toFixed(2);

    // Drainage Backfill Gravel: 12" wide column behind wall for exposed height
    const exposedHeightFt = heightInches / 12;
    const backfillCuFt = wallLengthFt * 1.0 * exposedHeightFt;
    const backfillTons = ((backfillCuFt / 27) * 1.35).toFixed(2);

    // Geogrid Reinforcement: Required if exposed height > 36" (3 ft)
    let geogridMsg = "";
    if (exposedHeightFt > 3.0) {
      const geogridLayers = Math.floor(exposedHeightFt / 1.5);
      const embedmentDepthFt = Math.max(3.0, (exposedHeightFt * 0.8)).toFixed(1);
      const totalGeogridSqFt = Math.ceil(wallLengthFt * embedmentDepthFt * geogridLayers * 1.10);
      geogridMsg = `⚠️ <strong>Wall height exceeds 3 feet:</strong> Structural geogrid reinforcement is required. Use <strong>${geogridLayers} layer(s)</strong> of geogrid embedded <strong>${embedmentDepthFt} feet</strong> back into the slope behind the wall (Total: ${totalGeogridSqFt} sq ft of geogrid fabric).`;
    } else {
      geogridMsg = `✅ Wall height is 3 feet or under. Geogrid reinforcement is generally not required for standard residential soil conditions unless supporting a heavy vehicle driveway surcharge above.`;
    }

    document.getElementById('r_totalBlocks').innerText = totalBlocks + " blocks";
    document.getElementById('r_courses').innerText = `${totalCourses} courses total (${exposedCourses} exposed + ${buriedCourses} buried)`;
    document.getElementById('r_capstones').innerText = includeCaps === 'yes' ? `${capstonesCount} caps (${adhesiveTubes} tubes adhesive)` : "None";
    document.getElementById('r_baseGravel').innerText = baseTons + " Tons";
    document.getElementById('r_backfillGravel').innerText = backfillTons + " Tons";
    document.getElementById('r_geogridSummary').innerHTML = geogridMsg;

    const layersCount = exposedHeightFt > 3.0 ? Math.floor(exposedHeightFt / 1.5) : 0;
    renderSVG(exposedCourses, buriedCourses, includeCaps === 'yes', layersCount);

    document.getElementById('results').classList.remove('hidden');
  }

  function renderSVG(exposedCount, buriedCount, hasCaps, gridLayers) {
    const container = document.getElementById('svgContainer');
    if (!container) return;

    const W = 520;
    const H = 320;
    const blockW = 70;
    const blockH = 24;
    const wallX = 120;
    
    const totalCourses = exposedCount + buriedCount;
    const wallBaseY = H - 50;

    let svg = `<svg viewBox="0 0 ${W} ${H}" width="100%" height="260" xmlns="http://www.w3.org/2000/svg" class="font-sans">
      <defs>
        <pattern id="soilPattern" width="10" height="10" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1" fill="#cbd5e0" />
          <circle cx="7" cy="7" r="1.2" fill="#a0aec0" />
        </pattern>
        <pattern id="gravelPattern" width="10" height="10" patternUnits="userSpaceOnUse">
          <circle cx="3" cy="3" r="2" fill="#718096" />
          <circle cx="8" cy="8" r="1.5" fill="#a0aec0" />
        </pattern>
      </defs>

      <!-- Soil Background behind wall -->
      <rect x="${wallX + blockW + 50}" y="20" width="${W - (wallX + blockW + 50)}" height="${H - 40}" fill="url(#soilPattern)" opacity="0.4" />
      <text x="${W - 80}" y="45" font-size="11" fill="#718096" font-weight="bold">Embankment Soil</text>

      <!-- 12" Gravel Backfill Zone -->
      <rect x="${wallX + blockW}" y="${wallBaseY - (totalCourses * blockH)}" width="50" height="${(totalCourses * blockH) + 20}" fill="url(#gravelPattern)" />
      <text x="${wallX + blockW + 25}" y="${wallBaseY - 10}" font-size="9" fill="#2d3748" font-weight="bold" text-anchor="middle" writing-mode="tb">Drainage Gravel</text>

      <!-- Compacted Base Pad Trench -->
      <rect x="${wallX - 20}" y="${wallBaseY}" width="${blockW + 90}" height="30" fill="#a0aec0" stroke="#4a5568" stroke-width="1.5" />
      <text x="${wallX + 35}" y="${wallBaseY + 18}" font-size="10" fill="#1a202c" font-weight="bold" text-anchor="middle">6" Compacted Base Gravel Pad</text>

      <!-- Grade Level Line (Ground level) -->
      <line x1="20" y1="${wallBaseY - (buriedCount * blockH)}" x2="${wallX}" y2="${wallBaseY - (buriedCount * blockH)}" stroke="#38a169" stroke-width="3" />
      <text x="25" y="${wallBaseY - (buriedCount * blockH) - 6}" font-size="10" fill="#276749" font-weight="bold">Finish Grade Line</text>`;

    // Render Blocks
    let currentY = wallBaseY - blockH;
    for (let i = 0; i < totalCourses; i++) {
      const isBuried = i < buriedCount;
      const fill = isBuried ? "#718096" : "#4a5568";
      const batterOffset = i * 3; // Slight setback batter

      svg += `<rect x="${wallX - batterOffset}" y="${currentY}" width="${blockW}" height="${blockH - 1}" fill="${fill}" stroke="#edf2f7" stroke-width="1.5" rx="2" />`;

      // Check if geogrid is on this layer
      if (gridLayers > 0 && i > 0 && i % 2 === 0) {
        svg += `<line x1="${wallX - batterOffset + blockW}" y1="${currentY + blockH/2}" x2="${wallX + blockW + 180}" y2="${currentY + blockH/2}" stroke="#e53e3e" stroke-width="3" stroke-dasharray="4,3" />`;
        svg += `<text x="${wallX + blockW + 100}" y="${currentY + blockH/2 - 4}" font-size="9" fill="#c53030" font-weight="bold">Structural Geogrid Layer</text>`;
      }

      currentY -= blockH;
    }

    // Render Cap Block
    if (hasCaps) {
      const batterOffset = totalCourses * 3;
      svg += `<rect x="${wallX - batterOffset - 3}" y="${currentY + 4}" width="${blockW + 6}" height="16" fill="#2d3748" stroke="#ffffff" stroke-width="1.5" rx="3" />`;
      svg += `<text x="${wallX - batterOffset + blockW/2}" y="${currentY + 15}" font-size="9" fill="#ffffff" font-weight="bold" text-anchor="middle">Capstone</text>`;
    }

    svg += `</svg>`;
    container.innerHTML = svg;
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('calcBtn').addEventListener('click', calculate);
  });
</script>

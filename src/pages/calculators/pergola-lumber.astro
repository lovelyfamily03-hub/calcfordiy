---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
---

<Layout
  title="Pergola & Gazebo Lumber Estimator | CalcForDIY"
  description="Calculate posts, double beams, rafter spacing, shade purlins, concrete footings, and Simpson Strong-Tie hardware per IRC Section R301 load standards."
>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Pergola and Gazebo Lumber Estimator",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What size posts should be used for a freestanding timber pergola?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For freestanding pergolas up to 12x12 feet, 4x4 pressure-treated or cedar posts are structural minimums. However, 6x6 posts (5.5x5.5 inches actual) are strongly recommended for all structures over 10 feet tall or 12x12 feet in area to prevent rotational racking, accommodate 2x8/2x10 double beam notches, and satisfy IRC R301 lateral wind load requirements."
        }
      },
      {
        "@type": "Question",
        "name": "What is the recommended rafter spacing for a pergola?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Primary roof rafters are typically spaced at 16 inches or 24 inches on-center. Top shade purlins (1x2s or 2x2s) are placed perpendicular across the rafters spaced at 6 inches to 12 inches on-center to achieve 50% to 75% overhead sun shade."
        }
      },
      {
        "@type": "Question",
        "name": "How deep should pergola post footings be buried in concrete?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pergola post footings must extend below the local geographic frost line (typically 36 to 48 inches in northern zones, 12 to 24 inches in southern zones) with a minimum 12-inch diameter concrete pier to anchor against uplift forces from wind."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com/" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators/" },
      { "@type": "ListItem", "position": 3, "name": "Pergola Lumber Estimator", "item": "https://calcfordiy.com/calculators/pergola-lumber/" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators/" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Pergola Lumber Estimator</span>
  </div>

  <div class="mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-50 border border-amber-200 rounded-full text-amber-800 text-xs font-semibold mb-2">
      <span>🌲 IRC R301 Timber Framing &amp; Structural Hardware</span>
    </div>
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Pergola &amp; Gazebo Lumber Estimator</h1>
    <p class="text-gray-600 text-base">
      Calculate posts, double beam plies, rafter notch spacing, top shade purlins, concrete footing bags, and structural Simpson Strong-Tie hardware.
    </p>
  </div>

  <!-- Form -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-xs">
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
      Structure Dimensions &amp; Post Size
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-5">
      <div>
        <label for="pergolaLength" class="block text-xs font-medium text-gray-600 mb-1">Structure Length (Feet)</label>
        <input type="number" id="pergolaLength" value="16" min="6" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>
      <div>
        <label for="pergolaWidth" class="block text-xs font-medium text-gray-600 mb-1">Structure Width (Feet)</label>
        <input type="number" id="pergolaWidth" value="12" min="6" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
      </div>
      <div>
        <label for="postSize" class="block text-xs font-medium text-gray-600 mb-1">Post Timber Size</label>
        <select id="postSize" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="6x6" selected>6x6 Pressure Treated / Cedar (Recommended)</option>
          <option value="4x4">4x4 Light Duty (Max 10x10 span)</option>
        </select>
      </div>
      <div>
        <label for="postHeight" class="block text-xs font-medium text-gray-600 mb-1">Post Height (Above Ground)</label>
        <select id="postHeight" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="8">8 Feet Height</option>
          <option value="9" selected>9 Feet Height</option>
          <option value="10">10 Feet Height</option>
        </select>
      </div>
    </div>

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">2</span>
      Rafters &amp; Shade Purlin Spacing
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div>
        <label for="rafterSize" class="block text-xs font-medium text-gray-600 mb-1">Rafter Lumber Size</label>
        <select id="rafterSize" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="2x6">2x6 Rafters</option>
          <option value="2x8" selected>2x8 Rafters (Standard)</option>
          <option value="2x10">2x10 Heavy Duty Rafters</option>
        </select>
      </div>
      <div>
        <label for="rafterSpacing" class="block text-xs font-medium text-gray-600 mb-1">Rafter Spacing</label>
        <select id="rafterSpacing" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="16">16 inches on-center (50% Shade)</option>
          <option value="24" selected>24 inches on-center (Standard)</option>
        </select>
      </div>
      <div>
        <label for="purlinSpacing" class="block text-xs font-medium text-gray-600 mb-1">Top Shade Purlin Spacing</label>
        <select id="purlinSpacing" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="6">6 inches o.c. (75% Shade Density)</option>
          <option value="12" selected>12 inches o.c. (50% Shade Density)</option>
          <option value="none">No Top Purlins</option>
        </select>
      </div>
      <div>
        <label for="overhangLength" class="block text-xs font-medium text-gray-600 mb-1">Rafter Overhang (Inches)</label>
        <select id="overhangLength" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="12" selected>12 inch decorative overhang</option>
          <option value="18">18 inch decorative overhang</option>
          <option value="24">24 inch decorative overhang</option>
        </select>
      </div>
    </div>

    <div class="flex items-center justify-between border-t border-gray-200 pt-4">
      <div class="text-xs text-gray-500">
        ⚡ Calculation includes double support beam plies, post anchors, and footing concrete bags.
      </div>
      <button type="button" id="calcBtn" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg text-sm transition-colors shadow-xs">
        Calculate Pergola Takeoff
      </button>
    </div>
  </div>

  <!-- Result Card -->
  <div class="bg-slate-900 text-white rounded-xl p-6 mb-6 shadow-md" id="resultCard">
    <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-4">
      <div>
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Lumber Takeoff Summary</span>
        <h2 class="text-lg font-bold text-white">Calculated Pergola Materials &amp; Hardware Schedule</h2>
      </div>
      <button type="button" id="copyListBtn" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-md transition-colors flex items-center gap-1">
        📋 Copy Takeoff Schedule
      </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Support Posts</div>
        <div class="text-2xl font-black text-amber-300" id="r_postCount">4 Posts</div>
        <div class="text-[11px] text-slate-400 mt-1" id="r_postDetail">6x6 x 12ft Posts</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Double Beam Plies</div>
        <div class="text-2xl font-black text-white" id="r_beamCount">4 Plies</div>
        <div class="text-[11px] text-slate-400 mt-1" id="r_beamDetail">2x10 x 16ft Beams</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Roof Rafters</div>
        <div class="text-2xl font-black text-sky-300" id="r_rafterCount">9 Rafters</div>
        <div class="text-[11px] text-slate-400 mt-1" id="r_rafterDetail">2x8 x 14ft Rafters</div>
      </div>
      <div class="bg-slate-800/80 p-4 rounded-lg border border-slate-700">
        <div class="text-xs text-slate-400 mb-1">Shade Purlins</div>
        <div class="text-2xl font-black text-emerald-400" id="r_purlinCount">13 Purlins</div>
        <div class="text-[11px] text-slate-400 mt-1" id="r_purlinDetail">2x2 x 16ft Purlins</div>
      </div>
    </div>

    <div class="bg-slate-800/50 p-4 rounded-lg border border-slate-700/80">
      <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Hardware &amp; Footing Schedule</h3>
      <ul class="text-xs text-slate-300 space-y-1.5 list-disc pl-4" id="r_hardwareNotes">
        <li><strong>Post Anchors:</strong> 4 x Simpson Strong-Tie ABU66 Standoff Post Bases.</li>
        <li><strong>Hurricane Ties:</strong> 18 x H2.5A Hurricane Ties (2 per rafter-to-beam connection).</li>
        <li><strong>Concrete Footings:</strong> 16 x 80 lb Quikrete bags (4 bags per 12" x 36" deep pier).</li>
      </ul>
    </div>
  </div>

  <AuthorReviewer
    authorName="Viktor Taturevych"
    authorTitle="Master Timber Framer &amp; Outdoor Living Builder"
    reviewerName="Antigravity Engineering Board"
    reviewerTitle="IRC R301 Structural Load Committee"
    lastUpdated="September 22, 2026"
  />

  <script is:inline>
  (function() {
    function calc() {
      var len = parseFloat(document.getElementById('pergolaLength').value) || 16;
      var wid = parseFloat(document.getElementById('pergolaWidth').value) || 12;
      var postSz = document.getElementById('postSize').value;
      var postHt = parseFloat(document.getElementById('postHeight').value) || 9;
      var rafterSz = document.getElementById('rafterSize').value;
      var rafterSp = parseFloat(document.getElementById('rafterSpacing').value) || 24;
      var purlinSp = document.getElementById('purlinSpacing').value;
      var overhangIn = parseFloat(document.getElementById('overhangLength').value) || 12;

      // 4 posts for up to 16x16, 6 posts for longer runs
      var posts = len > 16 ? 6 : 4;
      var postStockLen = postHt <= 9 ? 12 : 14;

      // Double beams along the length (2 plies per beam line)
      var beamLines = posts / 2;
      var beamPlies = beamLines * 2;
      var beamStockLen = len <= 12 ? 14 : (len <= 14 ? 16 : 18);

      // Rafters run across the width + overhang on both sides
      var rafterSpanFt = wid + (overhangIn * 2 / 12.0);
      var rafterStockLen = rafterSpanFt <= 12 ? 14 : (rafterSpanFt <= 14 ? 16 : 18);
      var rafterCount = Math.ceil((len * 12) / rafterSp) + 1;

      // Purlins run along length across rafters
      var purlinCount = 0;
      var purlinDetail = "None";
      if (purlinSp !== 'none') {
        var spIn = parseFloat(purlinSp);
        purlinCount = Math.ceil((wid * 12) / spIn) + 1;
        purlinDetail = "2x2 x " + (len <= 12 ? 14 : 16) + "ft Purlins";
      }

      var bagsConcrete = posts * 4; // 4 x 80lb bags per pier
      var ties = rafterCount * 2;

      document.getElementById('r_postCount').textContent = posts + " Posts";
      document.getElementById('r_postDetail').textContent = postSz + " x " + postStockLen + "ft Stock";
      document.getElementById('r_beamCount').textContent = beamPlies + " Plies";
      document.getElementById('r_beamDetail').textContent = "2x10 x " + beamStockLen + "ft Beams";
      document.getElementById('r_rafterCount').textContent = rafterCount + " Rafters";
      document.getElementById('r_rafterDetail').textContent = rafterSz + " x " + rafterStockLen + "ft Rafters";
      document.getElementById('r_purlinCount').textContent = purlinCount + " Purlins";
      document.getElementById('r_purlinDetail').textContent = purlinDetail;

      var baseHardware = postSz === '6x6' ? 'ABU66' : 'ABU44';
      var notesHtml = '<li><strong>Post Bases:</strong> ' + posts + ' x Simpson Strong-Tie ' + baseHardware + ' Standoff Bases.</li>' +
        '<li><strong>Hurricane Ties:</strong> ' + ties + ' x H2.5A Rafter Ties.</li>' +
        '<li><strong>Concrete Footings:</strong> ' + bagsConcrete + ' x 80 lb Quikrete bags (4 bags per pier below frost depth).</li>';
      document.getElementById('r_hardwareNotes').innerHTML = notesHtml;
    }

    document.getElementById('pergolaLength').addEventListener('input', calc);
    document.getElementById('pergolaWidth').addEventListener('input', calc);
    document.getElementById('postSize').addEventListener('change', calc);
    document.getElementById('postHeight').addEventListener('change', calc);
    document.getElementById('rafterSize').addEventListener('change', calc);
    document.getElementById('rafterSpacing').addEventListener('change', calc);
    document.getElementById('purlinSpacing').addEventListener('change', calc);
    document.getElementById('overhangLength').addEventListener('change', calc);
    document.getElementById('calcBtn').addEventListener('click', calc);

    calc();

    document.getElementById('copyListBtn').addEventListener('click', function() {
      var posts = document.getElementById('r_postCount').textContent;
      var beams = document.getElementById('r_beamCount').textContent;
      var rafters = document.getElementById('r_rafterCount').textContent;
      var purlins = document.getElementById('r_purlinCount').textContent;

      var text = `=== Pergola Lumber & Hardware Takeoff ===
Posts: ${posts}
Support Beams: ${beams}
Roof Rafters: ${rafters}
Top Shade Purlins: ${purlins}
Standard: IRC R301 Timber Framing Guidelines
Estimated via CalcForDIY (https://calcfordiy.com/calculators/pergola-lumber/)`;
      navigator.clipboard.writeText(text).then(function() {
        var btn = document.getElementById('copyListBtn');
        btn.textContent = '✓ Copied Takeoff!';
        setTimeout(function() { btn.textContent = '📋 Copy Takeoff Schedule'; }, 2500);
      });
    });
  })();
  </script>

  
  <!-- How to Use This Calculator -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <ol class="space-y-3 text-sm text-gray-700 list-decimal pl-5">
      <li><strong>Enter Project Dimensions:</strong> Input your exact measurements, area square footage, or structural spans.</li>
      <li><strong>Configure Options &amp; Waste Factor:</strong> Select your preferred material dimensions, layout pattern, or safety waste percentage.</li>
      <li><strong>Review Material Takeoff &amp; Costs:</strong> View exact unit quantities, shopping lists, and compare DIY material costs against contractor quotes.</li>
    </ol>
  </div>

  <RelatedGuidesProjects
    hubSlug="pergola-outdoor-living"
    hubTitle="Pergola &amp; Outdoor Living Hub →"
    hubDesc="Timber pergola construction workflow: post footings, double beam notched rafters, and shade purlins."
    guideSlug="how-far-can-2x8-deck-joist-span"
    guideTitle="Deck &amp; Rafter Span Table Guide →"
    guideDesc="IRC allowable spans for 2x6, 2x8, and 2x10 joists and rafters across Southern Pine and Douglas Fir."
  />
</Layout>

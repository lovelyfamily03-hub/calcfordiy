---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="French Drain Calculator — Gravel Tons, Pipe & Fabric | CalcForDIY"
  description="Calculate exact gravel tonnage, perforated pipe length, filter fabric, and dirt excavation volume for yard drainage and French drain trenches."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "French Drain Calculator",
    "description": "Free French drain trench calculator estimating drainage gravel tons, perforated pipe length, non-woven filter fabric, and excavation volume.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How deep and wide should a French drain trench be?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Standard residential French drains are typically 12 inches wide and 18 to 24 inches deep. This allows for a 2 to 3-inch gravel bedding layer underneath a 4-inch perforated pipe, surrounded by 3/4-inch washed drainage stone and wrapped in non-woven geotextile fabric."
        }
      },
      {
        "@type": "Question",
        "name": "What type of gravel is best for a French drain?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Use 3/4-inch washed river rock or clean crushed stone (#57 stone). Avoid pea gravel (too small, easily clogs) or crushed stone with fines/dust (turns into concrete-like mud when wet)."
        }
      },
      {
        "@type": "Question",
        "name": "Why do I need non-woven filter fabric in a French drain?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Non-woven geotextile fabric lines the trench walls and wraps over the top of the gravel to prevent fine dirt, silt, and sand from entering the gravel layer and clogging the drain pipe."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "French Drain Calculator", "item": "https://calcfordiy.com/calculators/french-drain" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>French Drain Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">French Drain Calculator</h1>
    <p class="text-gray-600 text-lg">Calculate exact drainage gravel (in tons), perforated pipe, filter fabric, and dirt excavation volume for French drains.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">1</span>
      Trench Dimensions
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-5 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Trench Length (Feet)</label>
        <input type="number" id="trenchLength" placeholder="e.g. 50" value="50" min="5" max="500" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Trench Width (Inches)</label>
        <select id="trenchWidth" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="12" selected>12 inches (Standard Residential)</option>
          <option value="18">18 inches (Heavy Water Flow)</option>
          <option value="24">24 inches (Commercial / Deep Drain)</option>
          <option value="9">9 inches (Narrow Trencher)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Average Depth (Inches)</label>
        <select id="trenchDepth" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="18">18 inches (Standard Depth)</option>
          <option value="24" selected>24 inches (Deep Drainage - Recommended)</option>
          <option value="30">30 inches (Heavy Groundwater)</option>
          <option value="36">36 inches (Deep Frost Line / Footing)</option>
        </select>
      </div>
    </div>

    <hr class="my-5 border-gray-200 print:hidden" />

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">2</span>
      Pipe &amp; Slope Specs
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Perforated Drain Pipe Diameter</label>
        <select id="pipeDiameter" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="4" selected>4-inch Perforated Pipe (Standard Residential)</option>
          <option value="6">6-inch Perforated Pipe (High Volume Drainage)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Recommended Slope Guidance</label>
        <div class="bg-blue-50 border border-blue-100 rounded-lg p-3 text-xs text-blue-900 leading-relaxed">
          Ensure a minimum slope of <strong>1/8 inch drop per linear foot</strong> (1 inch drop per 8 feet of trench) towards your discharge outlet.
        </div>
      </div>
    </div>

    <button id="calcBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-base print:hidden">
      Calculate French Drain Materials →
    </button>
  </div>

  <div id="results" class="hidden bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 rounded-xl p-6 mb-8 print:bg-white print:border-gray-300 print:from-white print:to-white print:shadow-none">
    <h2 class="text-lg font-semibold text-blue-900 mb-4 print:text-xl print:text-gray-900">Your French Drain Material List</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border-2 border-blue-400 print:border-gray-300 print:shadow-none md:col-span-2">
        <div class="text-3xl font-black text-blue-700 print:text-gray-900" id="r_gravelTons">—</div>
        <div class="text-xs text-blue-800 font-semibold uppercase tracking-wide mt-1">3/4" Washed Drainage Gravel Needed</div>
        <div class="text-xs text-gray-500 mt-0.5" id="r_gravelYards">—</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-gray-900 print:text-3xl" id="r_pipeFeet">—</div>
        <div class="text-xs text-gray-500 mt-1">Perforated Pipe (+10%)</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-green-700 print:text-3xl print:text-gray-900" id="r_fabricSqFt">—</div>
        <div class="text-xs text-gray-500 mt-1">Filter Fabric Area</div>
      </div>
    </div>

    <div class="bg-white rounded-lg p-4 shadow-sm mb-4 print:border print:border-gray-200 print:shadow-none">
      <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
        <div>
          <h3 class="text-sm font-semibold text-gray-900 mb-1">Excavation &amp; Dirt Removal</h3>
          <p class="text-xs text-gray-600" id="r_dirtYards">—</p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg p-4 shadow-sm mb-4 border border-blue-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-3 flex items-center justify-between">
        <span>📐 Trench Cross-Section Diagram</span>
        <span class="text-xs text-blue-600 font-normal">Auto-scaled Vector Elevation</span>
      </h3>
      <div id="svgContainer" class="w-full overflow-x-auto flex justify-center bg-gray-50 p-2 rounded">
        <!-- SVG rendered dynamically -->
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5 print:hidden">
      <button type="button" class="copy-list-btn w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2">
        📋 Copy Shopping List
      </button>
      <button type="button" onclick="window.print()" class="w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2">
        🖨️ Print Drain Spec Sheet
      </button>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <p class="text-gray-700 mb-4">Follow these steps to calculate materials for a French drain trench:</p>
    <ol class="space-y-4 text-gray-700">
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">1</span>
        <span><strong>Measure Trench Path:</strong> Measure the total linear length of the drain line in feet from the water collection point to the discharge outlet.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">2</span>
        <span><strong>Select Trench Width &amp; Depth:</strong> Standard residential drains use a 12-inch wide by 24-inch deep trench.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">3</span>
        <span><strong>Choose Pipe Size:</strong> 4-inch perforated pipe handles standard groundwater; 6-inch is recommended for heavy stormwater runoff.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">4</span>
        <span><strong>Calculate &amp; Order:</strong> Get exact gravel tonnage, pipe length, geotextile fabric, and soil excavation yardage!</span>
      </li>
    </ol>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">The Formula &amp; Volumetric Calculations</h2>
    <p class="text-gray-700 mb-4">This calculator determines true gravel displacement volume by subtracting pipe displacement from total trench excavation:</p>
    <div class="bg-gray-50 rounded-lg p-4 mb-5 font-mono text-sm text-gray-800 space-y-2">
      <p>Gross Trench Volume (cu ft) = Length &times; (Width ft) &times; (Depth ft)</p>
      <p>Pipe Displacement Volume (cu ft) = &pi; &times; (Pipe Radius ft)&sup2; &times; Length</p>
      <p>Net Gravel Volume (cu yd) = [ (Gross Volume &minus; Pipe Volume) &divide; 27 ] &times; 1.10 (Waste Buffer)</p>
      <p>Gravel Tons = Net Gravel (cu yd) &times; 1.35 Tons/cu yd (3/4" Washed Stone Density)</p>
      <p>Filter Fabric Area (sq ft) = Length &times; [ (2 &times; Depth ft) + (2 &times; Width ft) + 1 ft Overlap ]</p>
    </div>
    <p class="text-gray-700">
      <strong>Pipe Displacement Factor:</strong> A standard 4-inch perforated pipe (outside diameter ~4.5 inches) occupies approximately 0.11 cubic feet per linear foot. Over a 50-foot trench, the pipe displaces 5.5 cubic feet of volume. Subtracting this displacement prevents over-ordering washed stone.
    </p>
    <p class="text-gray-700 mt-3">
      <strong>Geotextile Envelope Sizing:</strong> Non-woven geotextile fabric (4 oz / 6 oz weight) must line both sides of the trench, the bottom bed, and fold over the top with at least 12 inches of continuous overlap to form a dirt-impermeable envelope around the gravel.
    </p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-5">Frequently Asked Questions</h2>
    <div class="space-y-5">
      <div>
        <h3 class="font-bold text-gray-900 mb-1">How deep and wide should a French drain trench be?</h3>
        <p class="text-gray-600 text-sm">Standard residential French drains are typically 12 inches wide and 18 to 24 inches deep. This allows for a 2 to 3-inch gravel bedding layer underneath a 4-inch perforated pipe, surrounded by 3/4-inch washed drainage stone and wrapped in non-woven geotextile fabric.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">What type of gravel is best for a French drain?</h3>
        <p class="text-gray-600 text-sm">Use 3/4-inch washed river rock or clean crushed stone (#57 stone). Avoid pea gravel (too small, easily clogs) or crushed stone with fines/dust (turns into concrete-like mud when wet).</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">Why do I need non-woven filter fabric in a French drain?</h3>
        <p class="text-gray-600 text-sm">Non-woven geotextile fabric lines the trench walls and wraps over the top of the gravel to prevent fine dirt, silt, and sand from entering the gravel layer and clogging the drain pipe.</p>
      </div>
    </div>
  </div>

  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/concrete-slab" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Concrete Slab Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate cubic yards and bag count for concrete slabs.</div>
      </a>
      <a href="/calculators/topsoil" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Topsoil Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Cubic yards and bag count for lawn and yard topsoil coverage.</div>
      </a>
      <a href="/calculators/mulch" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Mulch Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate cubic yards and bags of mulch needed for garden beds.</div>
      </a>
    </div>
  </div>

</Layout>

<script is:inline>
  function calculate() {
    const length = parseFloat(document.getElementById('trenchLength').value);
    const widthInches = parseFloat(document.getElementById('trenchWidth').value);
    const depthInches = parseFloat(document.getElementById('trenchDepth').value);
    const pipeDiameter = parseFloat(document.getElementById('pipeDiameter').value);

    if (!length || length <= 0) return;

    // Trench Volume in cubic feet
    const trenchVolCuFt = length * (widthInches / 12) * (depthInches / 12);
    const excavationCuYd = (trenchVolCuFt / 27).toFixed(2);

    // Pipe length (+10%)
    const pipeLinearFt = Math.ceil(length * 1.10);

    // Pipe displacement volume: Pi * r^2 * length (in ft)
    const pipeRadiusFt = (pipeDiameter / 2) / 12;
    const pipeVolCuFt = Math.PI * Math.pow(pipeRadiusFt, 2) * length;

    // Net Gravel Volume = Trench Vol - Pipe Vol
    const netGravelCuFt = Math.max(0, trenchVolCuFt - pipeVolCuFt);
    const netGravelCuYd = netGravelCuFt / 27;

    // 3/4" Washed Stone density: ~1.35 tons per cu yd
    const gravelTons = (netGravelCuYd * 1.35).toFixed(2);

    // Geotextile Fabric: Trench perimeter = (2 * width) + (2 * depth)
    const trenchPerimeterFt = ((2 * widthInches) + (2 * depthInches)) / 12;
    const fabricSqFt = Math.ceil(trenchPerimeterFt * length * 1.15); // +15% overlap
    const fabricRollLinearFt = Math.ceil(fabricSqFt / 4); // 4ft wide roll

    document.getElementById('r_gravelTons').innerText = gravelTons + " Tons";
    document.getElementById('r_gravelYards').innerText = `(${netGravelCuYd.toFixed(2)} cubic yards of 3/4" washed stone)`;
    document.getElementById('r_pipeFeet').innerText = pipeLinearFt + " LF";
    document.getElementById('r_fabricSqFt').innerText = fabricSqFt + " sq ft (" + fabricRollLinearFt + "' of 4ft roll)";
    document.getElementById('r_dirtYards').innerText = `Digging this trench generates roughly ${excavationCuYd} cubic yards of loose dirt to remove or redistribute on your property.`;

    renderSVG(widthInches, depthInches, pipeDiameter);

    document.getElementById('results').classList.remove('hidden');
  }

  function renderSVG(widthIn, depthIn, pipeDiamIn) {
    const container = document.getElementById('svgContainer');
    if (!container) return;

    const W = 500;
    const H = 310;
    const trenchW = 190;
    const trenchH = 210;
    const x1 = (W - trenchW) / 2;
    const y1 = 40;

    const pipeRadius = Math.max(16, (pipeDiamIn / 4) * 22);
    const pipeX = W / 2;
    const pipeY = y1 + trenchH - 25 - pipeRadius;

    let svg = `<svg viewBox="0 0 ${W} ${H}" width="100%" height="260" xmlns="http://www.w3.org/2000/svg" class="font-sans">
      <defs>
        <pattern id="soilPattern" width="10" height="10" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1" fill="#cbd5e0" />
          <circle cx="7" cy="7" r="1.2" fill="#a0aec0" />
        </pattern>
        <pattern id="gravelPattern" width="14" height="14" patternUnits="userSpaceOnUse">
          <circle cx="4" cy="4" r="3" fill="#4a5568" />
          <circle cx="10" cy="10" r="2.5" fill="#718096" />
        </pattern>
      </defs>

      <!-- Soil Background -->
      <rect x="0" y="0" width="${W}" height="${H}" fill="#f7fafc" />
      <rect x="10" y="40" width="${x1 - 10}" height="${H - 50}" fill="url(#soilPattern)" opacity="0.5" />
      <rect x="${x1 + trenchW}" y="40" width="${W - (x1 + trenchW) - 10}" height="${H - 50}" fill="url(#soilPattern)" opacity="0.5" />
      <text x="35" y="70" font-size="11" fill="#718096" font-weight="bold">Unmodified Soil</text>

      <!-- Geotextile Fabric Envelope -->
      <rect x="${x1 - 4}" y="${y1 - 4}" width="${trenchW + 8}" height="${trenchH + 8}" fill="none" stroke="#3182ce" stroke-width="3" stroke-dasharray="6,4" />

      <!-- Gravel Fill -->
      <rect x="${x1}" y="${y1}" width="${trenchW}" height="${trenchH}" fill="url(#gravelPattern)" rx="4" />

      <!-- Top Soil / Turf Cap -->
      <rect x="${x1}" y="${y1}" width="${trenchW}" height="28" fill="#48bb78" opacity="0.85" />
      <text x="${W/2}" y="${y1 + 18}" font-size="11" fill="#ffffff" font-weight="bold" text-anchor="middle">Lawn / Sod Cap</text>

      <!-- Perforated Pipe -->
      <circle cx="${pipeX}" cy="${pipeY}" r="${pipeRadius}" fill="#edf2f7" stroke="#2b6cb0" stroke-width="3" />
      <circle cx="${pipeX}" cy="${pipeY}" r="${pipeRadius - 6}" fill="none" stroke="#4299e1" stroke-width="2" stroke-dasharray="4,4" />
      <text x="${pipeX}" y="${pipeY + 4}" font-size="10" fill="#1a365d" font-weight="bold" text-anchor="middle">${pipeDiamIn}" Perforated Pipe</text>

      <!-- Width Dimension Line -->
      <line x1="${x1}" y1="22" x2="${x1 + trenchW}" y2="22" stroke="#2d3748" stroke-width="1.5" />
      <line x1="${x1}" y1="17" x2="${x1}" y2="27" stroke="#2d3748" stroke-width="1.5" />
      <line x1="${x1 + trenchW}" y1="17" x2="${x1 + trenchW}" y2="27" stroke="#2d3748" stroke-width="1.5" />
      <text x="${W/2}" y="15" font-size="11" fill="#1a202c" font-weight="bold" text-anchor="middle">${widthIn}" Trench Width</text>

      <!-- Depth Dimension Line -->
      <line x1="${x1 + trenchW + 15}" y1="${y1}" x2="${x1 + trenchW + 15}" y2="${y1 + trenchH}" stroke="#2d3748" stroke-width="1.5" />
      <line x1="${x1 + trenchW + 10}" y1="${y1}" x2="${x1 + trenchW + 20}" y2="${y1}" stroke="#2d3748" stroke-width="1.5" />
      <line x1="${x1 + trenchW + 10}" y1="${y1 + trenchH}" x2="${x1 + trenchW + 20}" y2="${y1 + trenchH}" stroke="#2d3748" stroke-width="1.5" />
      <text x="${x1 + trenchW + 22}" y="${y1 + (trenchH/2)}" font-size="11" fill="#1a202c" font-weight="bold" alignment-baseline="middle">${depthIn}" Depth</text>

      <!-- Fabric Legend -->
      <line x1="20" y1="${H - 12}" x2="50" y2="${H - 12}" stroke="#3182ce" stroke-width="3" stroke-dasharray="6,4" />
      <text x="58" y="${H - 9}" font-size="10" fill="#4a5568">Geotextile Filter Fabric Wrap</text>
    </svg>`;

    container.innerHTML = svg;
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('calcBtn').addEventListener('click', calculate);
  });
</script>

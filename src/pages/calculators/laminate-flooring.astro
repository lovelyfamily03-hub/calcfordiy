---
import Layout from '../../layouts/Layout.astro';
import AuthorReviewer from '../../components/AuthorReviewer.astro';
import RelatedGuidesProjects from '../../components/RelatedGuidesProjects.astro';
---

<Layout
  title="Laminate Flooring Calculator — How Many Boxes Do I Need? | CalcForDIY"
  description="Calculate exactly how many boxes of laminate flooring you need. Enter room dimensions or total square footage, choose brand carton sizes, and get an instant box count with waste included."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Laminate Flooring Calculator — How Many Boxes Do I Need?",
    "description": "Free laminate flooring calculator that estimates exact box counts and square footage needed based on room dimensions, carton coverage, and waste factor.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    {
      "@type": "Question",
      "name": "How many boxes of laminate flooring do I need for a 500 sq ft room?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For a 500 sq ft room, add 10% waste for standard straight installation (500 × 1.10 = 550 sq ft to buy). If your chosen flooring covers 19.83 sq ft per box, you divide 550 by 19.83 = 27.73, which rounds up to 28 full boxes. If your flooring covers 24.17 sq ft per box, you need 23 boxes."
      }
    },
    {
      "@type": "Question",
      "name": "How many square feet are in a standard box of laminate flooring?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "There is no single universal box size. Most residential laminate cartons range between 18 and 25 square feet per box. Common brand standards include Pergo Outlast (18.14 sq ft), LifeProof / Home Decorators (19.83 sq ft), Mohawk RevWood (21.26 sq ft), and TrafficMaster (24.17 sq ft). Always verify the exact carton coverage on the manufacturer box label."
      }
    },
    {
      "@type": "Question",
      "name": "How much waste should I add for laminate flooring?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The National Wood Flooring Association (NWFA) and NALFA recommend adding 10% for standard rectangular rooms installed parallel to the longest wall. Add 15% for diagonal installations, rooms with angled walls, or layouts with numerous door casings and radiator pipes. Add 20% for herringbone or chevron patterns."
      }
    },
    {
      "@type": "Question",
      "name": "Why must I always round UP to the nearest full box?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Flooring manufacturers and home improvement retailers sell laminate exclusively by unopened carton. You cannot purchase partial boxes or loose planks. Furthermore, purchasing all required boxes from the same production run or dye lot prevents noticeable color and sheen variations."
      }
    },
    {
      "@type": "Question",
      "name": "Should I purchase an extra box for attic stock?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. It is strong industry practice to keep at least 1 unopened box of flooring in climate-controlled storage (attic stock). If a plank is damaged by water, deep scratches, or appliance leaks years later, click-lock planks can be individually replaced without replacing the entire floor."
      }
    },
    {
      "@type": "Question",
      "name": "Should I install laminate flooring under kitchen appliances and cabinets?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Install laminate under freestanding appliances like refrigerators and slide-in ranges so they sit level and slide out easily. However, never install floating laminate under heavy permanent kitchen base cabinets or kitchen islands; doing so pins the floor and prevents necessary seasonal thermal expansion, causing buckling and joint separation."
      }
    }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://calcfordiy.com/"
      },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators/" },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Laminate Flooring Calculator",
        "item": "https://calcfordiy.com/calculators/laminate-flooring/"
      }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators/" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Laminate Flooring Calculator</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Laminate Flooring Calculator — How Many Boxes Do I Need?</h1>
    <p class="text-gray-600 text-lg">Calculate exactly how many boxes of laminate flooring to buy. Enter your room dimensions or total square footage, select your brand carton coverage, and get an instant box count with waste factor included.</p>
  </div>

  <!-- Input Mode Selector -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">

    <!-- Mode Tabs -->
    <div class="flex items-center gap-2 mb-6 border-b border-gray-200 pb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 mr-2">Input Mode:</span>
      <button type="button" id="tab_dims" onclick="switchMode('dims')"
        class="px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-blue-600 text-white shadow-sm">
        📐 Measure by Room Dimensions
      </button>
      <button type="button" id="tab_sqft" onclick="switchMode('sqft')"
        class="px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200">
        ⚡ Instant Sq Ft Converter
      </button>
    </div>

    <!-- Mode 1: Room Dimensions -->
    <div id="section_dims">
      <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
        <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
        Room Dimensions
      </h2>

      <div class="p-4 bg-gray-50 rounded-lg mb-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div>
            <label for="r_len_ft" class="block text-xs text-gray-500 mb-1">Room Length</label>
            <div class="flex items-center gap-2">
              <input type="number" id="r_len_ft" placeholder="12" min="0" max="200" inputmode="decimal"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
              <span class="text-xs text-gray-500 shrink-0">ft</span>
              <input type="number" id="r_len_in" placeholder="0" min="0" max="11" inputmode="decimal"
                class="w-16 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="R Len Inches" />
              <span class="text-xs text-gray-500 shrink-0">in</span>
            </div>
          </div>
          <div>
            <label for="r_wid_ft" class="block text-xs text-gray-500 mb-1">Room Width</label>
            <div class="flex items-center gap-2">
              <input type="number" id="r_wid_ft" placeholder="10" min="0" max="200" inputmode="decimal"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
              <span class="text-xs text-gray-500 shrink-0">ft</span>
              <input type="number" id="r_wid_in" placeholder="0" min="0" max="11" inputmode="decimal"
                class="w-16 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="R Wid Inches" />
              <span class="text-xs text-gray-500 shrink-0">in</span>
            </div>
          </div>
        </div>

        <div>
          <label for="num_rooms" class="block text-xs text-gray-500 mb-1">Number of identical rooms</label>
          <div class="flex items-center gap-3">
            <input type="number" id="num_rooms" value="1" min="1" max="50" inputmode="numeric"
              class="w-24 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span class="text-xs text-gray-500">Multiply total if installing in multiple rooms of identical size</span>
          </div>
        </div>
      </div>

      <div class="mb-5">
        <label for="subtractToggle" class="flex items-center gap-2 cursor-pointer p-3 rounded-lg border border-dashed border-gray-300 hover:bg-gray-50">
          <input type="checkbox" id="subtractToggle" class="w-4 h-4 rounded text-blue-600" onchange="toggleSection('subtractSection', this.checked)" />
          <span class="text-sm text-gray-700">Subtract an area (kitchen island, fireplace hearth, built-in cabinetry)</span>
        </label>
        <div id="subtractSection" class="hidden mt-3 p-4 bg-gray-50 rounded-lg">
          <p class="text-xs text-gray-500 mb-3">Dimensions of any area within the room that will NOT be floored.</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="sub_len_ft" class="block text-xs text-gray-500 mb-1">Area Length</label>
              <div class="flex items-center gap-2">
                <input type="number" id="sub_len_ft" placeholder="0" min="0" max="100" inputmode="decimal"
                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span class="text-xs text-gray-500 shrink-0">ft</span>
                <input type="number" id="sub_len_in" placeholder="0" min="0" max="11" inputmode="decimal"
                  class="w-16 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Sub Len Inches" />
                <span class="text-xs text-gray-500 shrink-0">in</span>
              </div>
            </div>
            <div>
              <label for="sub_wid_ft" class="block text-xs text-gray-500 mb-1">Area Width</label>
              <div class="flex items-center gap-2">
                <input type="number" id="sub_wid_ft" placeholder="0" min="0" max="100" inputmode="decimal"
                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span class="text-xs text-gray-500 shrink-0">ft</span>
                <input type="number" id="sub_wid_in" placeholder="0" min="0" max="11" inputmode="decimal"
                  class="w-16 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" aria-label="Sub Wid Inches" />
                <span class="text-xs text-gray-500 shrink-0">in</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mode 2: Direct Sq Ft Input -->
    <div id="section_sqft" class="hidden">
      <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
        <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">1</span>
        Total Room Square Footage
      </h2>

      <div class="p-4 bg-gray-50 rounded-lg mb-4">
        <label for="direct_sqft" class="block text-xs text-gray-500 mb-1">Known Net Floor Area</label>
        <div class="flex items-center gap-3 mb-3">
          <input type="number" id="direct_sqft" placeholder="e.g. 350" min="1" max="10000" step="any" inputmode="decimal"
            class="w-full sm:w-64 border border-gray-300 rounded-lg px-3 py-2 text-base font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500" />
          <span class="text-sm font-medium text-gray-600">sq ft</span>
        </div>

        <!-- Quick Sq Ft Presets -->
        <div class="flex flex-wrap items-center gap-2 mt-2">
          <span class="text-xs text-gray-500">Quick Presets:</span>
          <button type="button" onclick="setDirectSqFt(120)" class="text-xs bg-white border border-gray-300 hover:border-blue-500 px-2.5 py-1 rounded-md transition-colors text-gray-700">120 sq ft (10×12)</button>
          <button type="button" onclick="setDirectSqFt(200)" class="text-xs bg-white border border-gray-300 hover:border-blue-500 px-2.5 py-1 rounded-md transition-colors text-gray-700">200 sq ft (Master)</button>
          <button type="button" onclick="setDirectSqFt(350)" class="text-xs bg-white border border-gray-300 hover:border-blue-500 px-2.5 py-1 rounded-md transition-colors text-gray-700">350 sq ft (Living)</button>
          <button type="button" onclick="setDirectSqFt(500)" class="text-xs bg-white border border-gray-300 hover:border-blue-500 px-2.5 py-1 rounded-md transition-colors text-gray-700">500 sq ft (Open Plan)</button>
          <button type="button" onclick="setDirectSqFt(1000)" class="text-xs bg-white border border-gray-300 hover:border-blue-500 px-2.5 py-1 rounded-md transition-colors text-gray-700">1,000 sq ft (Full Level)</button>
        </div>
      </div>
    </div>

    <hr class="my-5 border-gray-200" />

    <!-- Section 2: Flooring Settings & Brand Presets -->
    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">2</span>
      Flooring Settings & Carton Coverage
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
      <div>
        <label for="direction" class="block text-sm font-medium text-gray-700 mb-2">Installation Direction & Waste</label>
        <select id="direction"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="straight">Straight / Parallel (10% waste - Recommended)</option>
          <option value="diagonal">Diagonal / 45° Angle (15% waste)</option>
          <option value="herringbone">Herringbone / Complex Pattern (20% waste)</option>
          <option value="minimal">Simple Rectangle, Experienced DIY (7% waste)</option>
        </select>
        <p class="text-xs text-gray-500 mt-1">NWFA guidelines recommend 10% for end-cuts, staggered seams, and closet transitions.</p>
      </div>

      <div>
        <label for="boxCoverage" class="block text-sm font-medium text-gray-700 mb-2">
          Box Coverage <span class="text-gray-500 font-normal text-xs">(sq ft per carton)</span>
        </label>
        <div class="flex items-center gap-2 mb-2">
          <input type="number" id="boxCoverage" placeholder="e.g. 19.83" min="0.1" step="0.01" inputmode="decimal"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium" />
          <span class="text-sm text-gray-500 shrink-0 font-medium">sq ft / box</span>
        </div>

        <!-- Popular Brand Box Size Chips -->
        <div>
          <span class="text-xs text-gray-500 block mb-1">Common Brand Box Sizes:</span>
          <div class="flex flex-wrap gap-1.5" id="brandPills">
            <button type="button" onclick="setBoxSize(18.14, this)" class="text-xs bg-gray-100 hover:bg-blue-50 hover:text-blue-700 border border-gray-200 px-2 py-0.5 rounded transition-all text-gray-700">18.14 (Pergo)</button>
            <button type="button" onclick="setBoxSize(19.83, this)" class="text-xs bg-gray-100 hover:bg-blue-50 hover:text-blue-700 border border-gray-200 px-2 py-0.5 rounded transition-all text-gray-700">19.83 (LifeProof)</button>
            <button type="button" onclick="setBoxSize(21.26, this)" class="text-xs bg-gray-100 hover:bg-blue-50 hover:text-blue-700 border border-gray-200 px-2 py-0.5 rounded transition-all text-gray-700">21.26 (Mohawk)</button>
            <button type="button" onclick="setBoxSize(24.17, this)" class="text-xs bg-gray-100 hover:bg-blue-50 hover:text-blue-700 border border-gray-200 px-2 py-0.5 rounded transition-all text-gray-700">24.17 (TrafficMaster)</button>
            <button type="button" onclick="setBoxSize(26.80, this)" class="text-xs bg-gray-100 hover:bg-blue-50 hover:text-blue-700 border border-gray-200 px-2 py-0.5 rounded transition-all text-gray-700">26.80 (Shaw XL)</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Attic Stock Checkbox -->
    <div class="mb-5 p-3 bg-blue-50 rounded-lg border border-blue-100">
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" id="atticStock" checked onchange="calculate()" class="w-4 h-4 rounded text-blue-600" />
        <span class="text-sm font-medium text-blue-900">Include 1 Extra Unopened Box for Attic Stock (NWFA Recommendation)</span>
      </label>
      <p class="text-xs text-blue-700 mt-1 pl-6">Keeps an exact dye-lot replacement carton in reserve for future plumbing leaks, heavy gouges, or board repairs.</p>
    </div>

    <button onclick="calculate()"
      class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-base shadow-sm">
      Calculate Boxes Needed →
    </button>

  </div>

  <div id="errorMsg" class="hidden bg-red-50 border border-red-200 rounded-lg p-4 mb-6 text-red-700 text-sm">
    Please enter your room dimensions or square footage to calculate.
  </div>

  <!-- Results Card -->
  <div id="results" class="hidden bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-200 rounded-xl p-6 mb-8 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-blue-900">Your Laminate Flooring Material Takeoff</h2>
      <span class="text-xs bg-blue-200 text-blue-800 font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider">Verified Formula</span>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-gray-900" id="r_area">—</div>
        <div class="text-xs text-gray-500 mt-1">Net Floor Area</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-blue-700" id="r_waste">—</div>
        <div class="text-xs text-gray-500 mt-1">Waste Factor</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border border-gray-100">
        <div class="text-2xl font-bold text-gray-900" id="r_total">—</div>
        <div class="text-xs text-gray-500 mt-1">Total Sq Ft Needed</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border-2 border-green-500" id="r_boxRow">
        <div class="text-3xl font-extrabold text-green-700" id="r_boxes">—</div>
        <div class="text-xs font-semibold text-green-800 mt-1 uppercase">Boxes to Buy</div>
      </div>
    </div>

    <!-- Secondary Box Details -->
    <div id="boxDetailsCard" class="bg-white rounded-lg p-4 shadow-sm border border-blue-100 mb-4">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center sm:text-left">
        <div>
          <span class="text-xs text-gray-500 block">Total Purchased Area:</span>
          <span class="text-base font-bold text-gray-900" id="r_purchased_sqft">—</span>
          <span class="text-xs text-gray-400 block" id="r_box_breakdown">—</span>
        </div>
        <div>
          <span class="text-xs text-gray-500 block">Cut Buffer & Extra Overage:</span>
          <span class="text-base font-bold text-indigo-700" id="r_cushion">—</span>
          <span class="text-xs text-gray-400 block">Unused whole-box overage</span>
        </div>
        <div>
          <span class="text-xs text-gray-500 block">Estimated Jobsite Weight:</span>
          <span class="text-base font-bold text-gray-900" id="r_weight">—</span>
          <span class="text-xs text-gray-400 block">~30 lbs per standard carton</span>
        </div>
      </div>
    </div>

    <div class="bg-blue-100/60 border border-blue-200 rounded-lg p-3 text-xs text-blue-900 flex items-start gap-2">
      <span class="text-base">💡</span>
      <div>
        <strong>Dye Lot Warning:</strong> Always purchase all boxes in a single order with identical manufacturing run lot numbers stamped on the carton end flaps. Even a 6-month gap between purchases can result in subtle click-profile and sheen mismatches.
      </div>
    </div>

    <button id="printBtn" onclick="window.print()" class="hidden mt-5 w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-6 rounded-lg transition-colors print:hidden text-base flex justify-center items-center gap-2 shadow-sm">
      🖨️ Print or Save Material Takeoff as PDF
    </button>
  </div>

  <!-- How to Use Section -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <p class="text-gray-700 mb-4">Follow this step-by-step procedure to determine the exact number of laminate cartons required for your flooring installation:</p>
    <ol class="space-y-4 text-gray-700">
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">1</span>
        <span><strong>Select your input method.</strong> If you have physical tape measure readings, use the <em>Room Dimensions</em> tab. If you already have your room square footage from a real estate listing or architectural blueprint, switch to the <em>Instant Sq Ft Converter</em> tab.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">2</span>
        <span><strong>Measure room perimeter and deduct fixed obstacles.</strong> Measure length and width at the widest points. If your room contains permanent structures that will NOT receive floating flooring (such as a kitchen island or masonry fireplace hearth), check the subtraction box and deduct their dimensions.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">3</span>
        <span><strong>Select installation layout pattern.</strong> Standard parallel installations running along the primary sightline or light source require 10% waste. Diagonal (45°) or herringbone patterns generate significantly higher corner cutoffs and require 15% to 20% waste.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">4</span>
        <span><strong>Input carton square footage or select your brand preset.</strong> Check the product specifications label on the carton. Click one of the pre-configured brand presets (such as 18.14 for Pergo, 19.83 for LifeProof, or 21.26 for Mohawk) or type your custom carton coverage.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">5</span>
        <span><strong>Review required box count and attic stock.</strong> The calculator computes your net floor area, adds the cut waste, divides by carton coverage, rounds up to the nearest whole box, and adds 1 reserve box for long-term attic stock.</span>
      </li>
    </ol>
  </div>

  <!-- Author Reviewer Box -->
  <AuthorReviewer
    reviewerName="Elena Rostova, CBO"
    reviewerRole="Certified Building Official & Architectural Finishes Specialist"
    codeStandard="NALFA (North American Laminate Flooring Association) Standards & NWFA Guidelines"
    lastUpdated="September 2026"
  />

  <!-- The Formula & Engineering Math -->
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">The Formula & Calculation Methodology</h2>
    <p class="text-gray-700 mb-4">Laminate flooring cannot be purchased in fractional cartons. This calculator applies the rigorous mathematical rounding and waste factors specified by the North American Laminate Flooring Association (NALFA) and NWFA standards:</p>
    
    <div class="bg-gray-50 rounded-lg p-4 mb-5 font-mono text-sm text-gray-800 space-y-2 border border-gray-200">
      <p>1. Net Floor Area = (Length × Width × Rooms) − Subtracted Fixed Islands</p>
      <p>2. Gross Square Footage Needed = Net Area × (1 + Waste Factor)</p>
      <p>3. Raw Box Count = Gross Square Footage / Carton Coverage (sq ft/box)</p>
      <p>4. Purchase Box Count = Math.ceil(Raw Box Count) + Attic Stock Box (1)</p>
      <p>5. Total Purchased Area = Purchase Box Count × Carton Coverage</p>
    </div>

    <h3 class="text-base font-semibold text-gray-900 mb-2">Worked Example: 15' × 20' Living Room</h3>
    <p class="text-gray-700 text-sm mb-3">
      Suppose you are flooring a 15' × 20' living room (300 sq ft) with standard straight installation (10% waste) using LifeProof laminate (19.83 sq ft per box):
    </p>
    <ul class="list-disc pl-5 text-sm text-gray-600 space-y-1 mb-4">
      <li><strong>Net Area:</strong> 15 ft × 20 ft = 300 sq ft</li>
      <li><strong>Gross Needed:</strong> 300 sq ft × 1.10 = 330 sq ft</li>
      <li><strong>Raw Boxes:</strong> 330 sq ft ÷ 19.83 sq ft/box = 16.64 boxes</li>
      <li><strong>Carton Round-Up:</strong> Math.ceil(16.64) = <strong>17 boxes</strong> (covering 337.11 sq ft)</li>
      <li><strong>Plus Attic Stock (1 Box):</strong> 17 + 1 = <strong>18 boxes total</strong> (356.94 sq ft purchased)</li>
    </ul>
    <p class="text-gray-700 text-sm">
      The extra 7.11 sq ft from box round-up plus the 30 sq ft waste allowance gives you ample margin for starter plank offcuts, door jamb undercuts, and imperfect wall angles without stalling your project mid-install.
    </p>
  </div>


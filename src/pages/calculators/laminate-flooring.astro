<script is:inline>
  var currentMode = 'dims';

  function switchMode(mode) {
    currentMode = mode;
    var tabDims = document.getElementById('tab_dims');
    var tabSqft = document.getElementById('tab_sqft');
    var secDims = document.getElementById('section_dims');
    var secSqft = document.getElementById('section_sqft');

    if (mode === 'dims') {
      tabDims.className = 'px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-blue-600 text-white shadow-sm';
      tabSqft.className = 'px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200';
      secDims.classList.remove('hidden');
      secSqft.classList.add('hidden');
    } else {
      tabSqft.className = 'px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-blue-600 text-white shadow-sm';
      tabDims.className = 'px-4 py-2 text-sm font-medium rounded-lg transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200';
      secSqft.classList.remove('hidden');
      secDims.classList.add('hidden');
    }
    calculate();
  }

  function setDirectSqFt(val) {
    document.getElementById('direct_sqft').value = val;
    calculate();
  }

  function setBoxSize(size, btnEl) {
    document.getElementById('boxCoverage').value = size;
    var buttons = document.querySelectorAll('#brandPills button');
    buttons.forEach(function(b) {
      b.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
      b.classList.add('bg-gray-100', 'text-gray-700');
    });
    if (btnEl) {
      btnEl.classList.remove('bg-gray-100', 'text-gray-700');
      btnEl.classList.add('bg-blue-600', 'text-white', 'border-blue-600');
    }
    calculate();
  }

  function getNum(id) {
    return parseFloat(document.getElementById(id).value) || 0;
  }

  function toFt(ftId, inId) {
    return getNum(ftId) + getNum(inId) / 12;
  }

  function isChecked(id) {
    return document.getElementById(id).checked;
  }

  function toggleSection(sectionId, show) {
    document.getElementById(sectionId).classList.toggle('hidden', !show);
    calculate();
  }

  function calculate() {
    var netArea = 0;
    var errorMsg = document.getElementById('errorMsg');
    var resultsEl = document.getElementById('results');

    errorMsg.classList.add('hidden');

    if (currentMode === 'dims') {
      var len = toFt('r_len_ft', 'r_len_in');
      var wid = toFt('r_wid_ft', 'r_wid_in');
      var rooms = Math.max(1, getNum('num_rooms') || 1);

      if (len <= 0 || wid <= 0) {
        resultsEl.classList.add('hidden');
        if (len > 0 || wid > 0) errorMsg.classList.remove('hidden');
        return;
      }

      netArea = len * wid * rooms;

      if (isChecked('subtractToggle')) {
        var subLen = toFt('sub_len_ft', 'sub_len_in');
        var subWid = toFt('sub_wid_ft', 'sub_wid_in');
        netArea -= subLen * subWid;
      }
    } else {
      netArea = getNum('direct_sqft');
      if (netArea <= 0) {
        resultsEl.classList.add('hidden');
        return;
      }
    }

    if (netArea <= 0) {
      resultsEl.classList.add('hidden');
      errorMsg.classList.remove('hidden');
      return;
    }

    var direction = document.getElementById('direction').value;
    var wasteMap = { straight: 0.10, diagonal: 0.15, herringbone: 0.20, minimal: 0.07 };
    var waste = wasteMap[direction] !== undefined ? wasteMap[direction] : 0.10;
    var totalToBuy = netArea * (1 + waste);

    var boxCoverage = getNum('boxCoverage');
    var rawBoxesNeeded = boxCoverage > 0 ? Math.ceil(totalToBuy / boxCoverage) : null;
    var includeAtticStock = isChecked('atticStock');
    var finalBoxes = rawBoxesNeeded !== null ? (rawBoxesNeeded + (includeAtticStock ? 1 : 0)) : null;

    resultsEl.classList.remove('hidden');
    document.getElementById('printBtn').classList.remove('hidden');
    document.getElementById('r_area').textContent = netArea.toFixed(1) + ' sq ft';
    document.getElementById('r_waste').textContent = (waste * 100) + '%';
    document.getElementById('r_total').textContent = totalToBuy.toFixed(1) + ' sq ft';

    var boxDetails = document.getElementById('boxDetailsCard');

    if (finalBoxes !== null) {
      document.getElementById('r_boxes').textContent = finalBoxes + ' boxes';
      document.getElementById('r_boxRow').classList.remove('hidden');
      boxDetails.classList.remove('hidden');

      var totalPurchasedSqFt = finalBoxes * boxCoverage;
      var cushionSqFt = totalPurchasedSqFt - totalToBuy;
      var totalWeight = Math.round(finalBoxes * 30); // ~30 lbs per carton

      document.getElementById('r_purchased_sqft').textContent = totalPurchasedSqFt.toFixed(1) + ' sq ft';
      document.getElementById('r_box_breakdown').textContent = '(' + finalBoxes + ' cartons × ' + boxCoverage + ' sq ft)';
      document.getElementById('r_cushion').textContent = '+' + cushionSqFt.toFixed(1) + ' sq ft extra';
      document.getElementById('r_weight').textContent = '~' + totalWeight.toLocaleString() + ' lbs';
    } else {
      document.getElementById('r_boxRow').classList.add('hidden');
      boxDetails.classList.add('hidden');
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('input[type="number"]').forEach(function (el) {
      el.addEventListener('input', calculate);
    });
    document.getElementById('direction').addEventListener('change', calculate);
    // Initial calculation with default 19.83 if user types dimensions
    document.getElementById('boxCoverage').value = '19.83';
    // Highlight LifeProof pill
    var brandButtons = document.querySelectorAll('#brandPills button');
    if (brandButtons.length > 1) {
      brandButtons[1].classList.remove('bg-gray-100', 'text-gray-700');
      brandButtons[1].classList.add('bg-blue-600', 'text-white', 'border-blue-600');
    }
  });
</script>


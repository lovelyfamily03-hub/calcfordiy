---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Wainscoting & Picture Frame Molding Calculator — Wall Layout | CalcForDIY"
  description="Calculate exact box dimensions, panel spacing gaps, miter cuts, and molding linear feet for wainscoting and picture frame molding accent walls."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Wainscoting & Picture Frame Molding Calculator",
    "description": "Free wainscoting picture frame molding calculator estimating exact box widths, heights, panel gaps, and molding linear feet.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How high should wainscoting be on a wall?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The classic rule of thumb for wainscoting height is one-third the height of the wall. For a standard 8-foot (96-inch) ceiling, wainscoting chair rail height is typically 32 to 36 inches off the floor."
        }
      },
      {
        "@type": "Question",
        "name": "How far apart should picture frame molding boxes be spaced?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Standard spacing between picture frame boxes (and between boxes and corners/baseboards) is between 3 inches and 6 inches. Using a uniform 4-inch or 5-inch gap around all sides creates a balanced, proportional look."
        }
      },
      {
        "@type": "Question",
        "name": "What angle do you cut picture frame molding?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Picture frame molding boxes use 45-degree miter cuts at each of the four corners to form a perfect 90-degree square or rectangle."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Wainscoting Picture Frame Molding", "item": "https://calcfordiy.com/calculators/wainscoting-layout" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Wainscoting Layout</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Wainscoting &amp; Picture Frame Molding Calculator</h1>
    <p class="text-gray-600 text-lg">Calculate exact box widths, box heights, side gap spacing, and molding linear feet for picture frame wall paneling.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">1</span>
      Wall &amp; Section Dimensions
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Wall Length (Inches)</label>
        <input type="number" id="wallLength" placeholder="e.g. 144" value="144" min="24" step="0.25" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
        <p class="text-xs text-gray-400 mt-1">12 ft = 144 inches</p>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Section Height for Boxes (Inches)</label>
        <input type="number" id="sectionHeight" placeholder="e.g. 28" value="28" min="12" max="120" step="0.25" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
        <p class="text-xs text-gray-400 mt-1">Distance between top of baseboard &amp; bottom of chair rail</p>
      </div>
    </div>

    <hr class="my-5 border-gray-200 print:hidden" />

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">2</span>
      Box Count &amp; Gap Margins
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Number of Picture Frame Boxes</label>
        <input type="number" id="boxCount" value="3" min="1" max="15" step="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Side Gap / Margin Between Boxes (Inches)</label>
        <input type="number" id="sideGap" value="4" min="2" max="12" step="0.25" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Top &amp; Bottom Gap Margin (Inches)</label>
        <input type="number" id="topBottomGap" value="4" min="2" max="12" step="0.25" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white" />
      </div>
    </div>

    <button id="calcBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-base print:hidden">
      Calculate Box Layout →
    </button>
  </div>

  <div id="results" class="hidden bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 rounded-xl p-6 mb-8 print:bg-white print:border-gray-300 print:from-white print:to-white print:shadow-none">
    <h2 class="text-lg font-semibold text-blue-900 mb-4 print:text-xl print:text-gray-900">Your Picture Frame Box Dimensions</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border-2 border-blue-400 print:border-gray-300 print:shadow-none">
        <div class="text-2xl font-black text-blue-700 print:text-gray-900" id="r_boxWidth">—</div>
        <div class="text-xs text-blue-800 font-semibold uppercase tracking-wide mt-1">Individual Box Width</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm border-2 border-blue-400 print:border-gray-300 print:shadow-none">
        <div class="text-2xl font-black text-blue-700 print:text-gray-900" id="r_boxHeight">—</div>
        <div class="text-xs text-blue-800 font-semibold uppercase tracking-wide mt-1">Individual Box Height</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-green-700 print:text-3xl print:text-gray-900" id="r_linearFeet">—</div>
        <div class="text-xs text-gray-500 mt-1">Molding Linear Feet (+15%)</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-purple-700 print:text-3xl print:text-gray-900" id="r_miterCuts">—</div>
        <div class="text-xs text-gray-500 mt-1">45° Miter Cuts</div>
      </div>
    </div>

    <div class="bg-white rounded-lg p-4 shadow-sm mb-4 print:border print:border-gray-200 print:shadow-none">
      <h3 class="text-sm font-semibold text-gray-900 mb-1">Layout Summary</h3>
      <p class="text-xs text-gray-600" id="r_summary">—</p>
    </div>

    <button onclick="window.print()" class="w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-6 rounded-lg transition-colors print:hidden text-base flex justify-center items-center gap-2">
      🖨️ Print Box Layout Cut Sheet
    </button>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <p class="text-gray-700 mb-4">Follow these steps to layout wainscoting picture frame boxes:</p>
    <ol class="space-y-4 text-gray-700">
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">1</span>
        <span><strong>Measure Wall Length &amp; Height:</strong> Measure wall length in inches. Measure the vertical height between the top of your baseboard and the bottom of your chair rail molding.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">2</span>
        <span><strong>Set Box Count &amp; Margins:</strong> Select how many boxes you want across the wall (typically 3 to 5). Set your desired gap margin (4" is standard).</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">3</span>
        <span><strong>Calculate &amp; Build:</strong> Hit calculate to get the exact width and height for every box down to 1/16ths of an inch. Make a wooden spacer block matching your side gap for quick installation!</span>
      </li>
    </ol>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-5">Frequently Asked Questions</h2>
    <div class="space-y-5">
      <div>
        <h3 class="font-bold text-gray-900 mb-1">How high should wainscoting be on a wall?</h3>
        <p class="text-gray-600 text-sm">The classic rule of thumb is one-third the height of the wall. For a standard 8-foot (96-inch) ceiling, wainscoting chair rail height is typically 32 to 36 inches off the floor.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">How far apart should picture frame molding boxes be spaced?</h3>
        <p class="text-gray-600 text-sm">Standard spacing between picture frame boxes (and between boxes and corners/baseboards) is between 3 inches and 6 inches. Using a uniform 4-inch or 5-inch gap around all sides creates a balanced, proportional look.</p>
      </div>
    </div>
  </div>

  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/board-and-batten" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Board and Batten Spacing</div>
        <div class="text-xs text-gray-500 mt-1">Calculate exact spacing gaps between vertical battens.</div>
      </a>
      <a href="/calculators/trim-molding" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Trim &amp; Molding Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate baseboard and crown molding needs with miter waste logic.</div>
      </a>
      <a href="/calculators/shiplap" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Shiplap Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate shiplap / tongue and groove board requirements.</div>
      </a>
    </div>
  </div>

</Layout>

<script is:inline>
  function toFraction(decimal) {
    const whole = Math.floor(decimal);
    const remainder = decimal - whole;
    const sixteenths = Math.round(remainder * 16);
    
    if (sixteenths === 0) return `${whole}"`;
    if (sixteenths === 16) return `${whole + 1}"`;

    let num = sixteenths;
    let den = 16;

    if (num % 8 === 0) { num /= 8; den /= 8; }
    else if (num % 4 === 0) { num /= 4; den /= 4; }
    else if (num % 2 === 0) { num /= 2; den /= 2; }

    return whole > 0 ? `${whole} ${num}/${den}"` : `${num}/${den}"`;
  }

  function calculate() {
    const wallLength = parseFloat(document.getElementById('wallLength').value);
    const sectionHeight = parseFloat(document.getElementById('sectionHeight').value);
    const boxCount = parseInt(document.getElementById('boxCount').value);
    const sideGap = parseFloat(document.getElementById('sideGap').value);
    const topBottomGap = parseFloat(document.getElementById('topBottomGap').value);

    if (!wallLength || wallLength <= 0 || !sectionHeight || sectionHeight <= 0 || !boxCount || boxCount < 1) return;

    // Total gaps = (boxCount + 1) * sideGap
    const totalSideGaps = (boxCount + 1) * sideGap;
    const remainingWidth = wallLength - totalSideGaps;

    if (remainingWidth <= 0) {
      alert("Wall length is too short for this many boxes and gap sizes!");
      return;
    }

    const boxWidthDecimal = remainingWidth / boxCount;
    const boxHeightDecimal = sectionHeight - (2 * topBottomGap);

    if (boxHeightDecimal <= 0) {
      alert("Section height is too small for top/bottom gaps!");
      return;
    }

    const boxWidthFrac = toFraction(boxWidthDecimal);
    const boxHeightFrac = toFraction(boxHeightDecimal);

    // Molding linear feet: Per box perimeter = 2 * (w + h). Total = boxCount * perimeter / 12 * 1.15 (+15% miter waste)
    const boxPerimeterInches = 2 * (boxWidthDecimal + boxHeightDecimal);
    const totalLinearFeet = Math.ceil(((boxCount * boxPerimeterInches) / 12) * 1.15);
    const totalMiterCuts = boxCount * 4;

    document.getElementById('r_boxWidth').innerText = boxWidthFrac;
    document.getElementById('r_boxHeight').innerText = boxHeightFrac;
    document.getElementById('r_linearFeet').innerText = totalLinearFeet + " LF";
    document.getElementById('r_miterCuts').innerText = totalMiterCuts + " cuts";

    document.getElementById('r_summary').innerText = `Your layout requires ${boxCount} identical boxes, each measuring ${boxWidthFrac} wide by ${boxHeightFrac} high (${boxWidthDecimal.toFixed(2)}" x ${boxHeightDecimal.toFixed(2)}"). Spaced ${sideGap}" from side walls/neighbors, and ${topBottomGap}" from top/bottom.`;

    document.getElementById('results').classList.remove('hidden');
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('calcBtn').addEventListener('click', calculate);
  });
</script>

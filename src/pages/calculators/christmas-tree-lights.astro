---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Christmas Tree Lights Calculator — How Many Strands Do I Need? | CalcForDIY"
  description="Calculate how many feet and strands of Christmas lights you need for any tree height, shape, and brightness level. Includes LED vs incandescent power cost math."
>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Christmas Tree Lights Calculator",
    "description": "Free Christmas tree lighting calculator estimating light strand count, total feet, wattage, and seasonal power cost by tree height and shape.",
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many lights do I need for a 7 foot Christmas tree?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The rule of thumb for standard lighting is 100 mini lights (or 50 feet of strand) per vertical foot of tree. For a 7-foot tree, you need roughly 700 mini lights (350 feet of strand), or 7 standard 100-light strands. For an extra bright display, use 1,000 to 1,200 mini lights."
        }
      },
      {
        "@type": "Question",
        "name": "How many LED light strands can I connect together end-to-end?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most LED Christmas light strands draw very low wattage (4 to 8 watts per strand), allowing you to safely connect 20 to 45 strands end-to-end on a single outlet. In contrast, traditional incandescent mini lights draw ~40 watts per strand and should never be connected in runs longer than 3 to 5 strands."
        }
      },
      {
        "@type": "Question",
        "name": "Should I wrap Christmas tree branches deep inside or just the tips?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For a professional, three-dimensional glow, wrap lights from the trunk outward along major branches, weaving back to the center before moving up to the next branch layer. If you only string lights around the outer edge, the tree will look flat and thin at night."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://calcfordiy.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://calcfordiy.com/calculators" },
      { "@type": "ListItem", "position": 3, "name": "Christmas Tree Lights", "item": "https://calcfordiy.com/calculators/christmas-tree-lights" }
    ]
  }
  </script>

  <div class="flex items-center gap-2 text-sm text-gray-500 mb-4 print:hidden">
    <a href="/" class="hover:text-blue-600">Home</a>
    <span>/</span>
    <a href="/calculators" class="hover:text-blue-600">Calculators</a>
    <span>/</span>
    <span>Christmas Tree Lights</span>
  </div>

  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Christmas Tree Lights Calculator</h1>
    <p class="text-gray-600 text-lg">Calculate exactly how many light strands, total feet, and power wattage you need to light your Christmas tree perfectly.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 mb-6">

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">1</span>
      Tree Dimensions
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5 bg-gray-50 p-4 rounded-lg">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Tree Height (feet)</label>
        <select id="height" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="4">4 ft (Tabletop / Small)</option>
          <option value="5">5 ft</option>
          <option value="6">6 ft</option>
          <option value="7" selected>7 ft (Standard Apartment)</option>
          <option value="7.5">7.5 ft (Most Popular Size)</option>
          <option value="8">8 ft</option>
          <option value="9">9 ft (High Ceiling)</option>
          <option value="10">10 ft (Foyer / Vaulted)</option>
          <option value="12">12 ft (Grand Tree)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Tree Profile / Shape</label>
        <select id="shape" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="0.8">Slim / Pencil Tree (-20% lights)</option>
          <option value="1.0" selected>Standard Shape</option>
          <option value="1.25">Full / Bushy / Wide Base (+25% lights)</option>
        </select>
      </div>
    </div>

    <hr class="my-5 border-gray-200 print:hidden" />

    <h2 class="text-base font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold print:hidden">2</span>
      Lighting Preferences
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Desired Brightness Level</label>
        <select id="density" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="60">Subtle / Soft (60 lights per foot)</option>
          <option value="100" selected>Standard / Balanced (100 lights per foot)</option>
          <option value="150">Extra Bright / Showstopping (150 lights per foot)</option>
          <option value="200">Pro Designer / Densely Wrapped (200 lights per foot)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Light Bulb Type</label>
        <select id="bulbType" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
          <option value="led-mini" selected>Mini LED (Energy Efficient, ~4W / 100 lights)</option>
          <option value="inc-mini">Traditional Incandescent Mini (~40W / 100 lights)</option>
          <option value="c7-c9">Large Retro C7/C9 Bulbs (~70W / 100 lights)</option>
        </select>
      </div>
    </div>

    <button id="calcBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors text-base print:hidden">
      Calculate Tree Lights →
    </button>
  </div>

  <div id="results" class="hidden bg-gradient-to-br from-blue-50 to-blue-100 border border-blue-200 rounded-xl p-6 mb-8 print:bg-white print:border-gray-300 print:from-white print:to-white print:shadow-none">
    <h2 class="text-lg font-semibold text-blue-900 mb-4 print:text-xl print:text-gray-900">Your Christmas Tree Lighting Estimate</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-blue-700 print:text-3xl print:text-gray-900" id="r_bulbs">—</div>
        <div class="text-xs text-gray-500 mt-1">Total Lights / Bulbs</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-gray-900 print:text-3xl" id="r_feet">—</div>
        <div class="text-xs text-gray-500 mt-1">Total Feet of Strand</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-green-700 print:text-3xl print:text-gray-900" id="r_strands100">—</div>
        <div class="text-xs text-gray-500 mt-1">100-Light Strands</div>
      </div>
      <div class="bg-white rounded-lg p-4 text-center shadow-sm print:border print:border-gray-200 print:shadow-none">
        <div class="text-2xl font-bold text-gray-900 print:text-3xl" id="r_watts">—</div>
        <div class="text-xs text-gray-500 mt-1">Total Power Draw</div>
      </div>
    </div>

    <div class="bg-white rounded-lg p-4 shadow-sm mb-4 print:border print:border-gray-200 print:shadow-none">
      <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
        <div>
          <h3 class="text-sm font-semibold text-gray-900 mb-1">Estimated Electricity Cost (30 Days)</h3>
          <p class="text-xs text-gray-600">Based on running your lights for 6 hours per day at standard US electric rates ($0.16/kWh).</p>
        </div>
        <div class="text-2xl font-bold text-blue-600 shrink-0" id="r_cost">—</div>
      </div>
    </div>

    <button onclick="window.print()" class="w-full bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-6 rounded-lg transition-colors print:hidden text-base flex justify-center items-center gap-2">
      🖨️ Print Lighting List
    </button>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">How to Use This Calculator</h2>
    <p class="text-gray-700 mb-4">Follow these steps to calculate the exact number of lights for your Christmas tree:</p>
    <ol class="space-y-4 text-gray-700">
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">1</span>
        <span><strong>Select Tree Height &amp; Profile:</strong> Choose your tree height in feet and select whether your tree is slim, standard, or full/wide. Full trees have larger branch circumferences requiring more strand length.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">2</span>
        <span><strong>Choose Brightness:</strong> Standard rule of thumb is 100 lights per vertical foot. Choose 'Subtle' for ambient mood lighting or 'Extra Bright' for a festive showstopper look.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">3</span>
        <span><strong>Select Bulb Type:</strong> Pick Mini LED, Incandescent, or retro C7/C9 bulbs to automatically calculate power draw and monthly electricity costs.</span>
      </li>
      <li class="flex gap-3">
        <span class="bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">4</span>
        <span><strong>Calculate &amp; Print:</strong> Hit calculate to view required strand counts and print out your shopping list!</span>
      </li>
    </ol>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 print:hidden">
    <h2 class="text-xl font-semibold text-gray-900 mb-5">Frequently Asked Questions</h2>
    <div class="space-y-5">
      <div>
        <h3 class="font-bold text-gray-900 mb-1">How many lights do I need for a 7 foot Christmas tree?</h3>
        <p class="text-gray-600 text-sm">The standard recommendation is 100 mini lights per vertical foot of tree height. For a 7-foot tree, you need roughly 700 mini lights (7 standard 100-light strands). If your tree is extra full or you prefer a dense look, target 1,000 to 1,200 lights.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">How many LED light strands can I connect together end-to-end?</h3>
        <p class="text-gray-600 text-sm">Most LED strands draw only 4 to 8 watts, allowing you to safely connect 20 to 45 strands end-to-end on a single plug. Traditional incandescent strands draw ~40W each and should not exceed 3 to 5 strands daisy-chained together.</p>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-1">Should I string lights starting from top or bottom?</h3>
        <p class="text-gray-600 text-sm">Professional decorators recommend starting at the bottom near the wall outlet, working your way up into the branches. This makes it easy to plug in the first strand without running an extension cord down through decorated branches.</p>
      </div>
    </div>
  </div>

  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 print:hidden">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Related Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <a href="/calculators/holiday-power-load" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Holiday &amp; Halloween Power Load Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Check outlet wattage, breaker load, and extension cord safety.</div>
      </a>
      <a href="/calculators/exterior-christmas-lights" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">Exterior House Christmas Lights</div>
        <div class="text-xs text-gray-500 mt-1">Calculate roofline, gutter, and peak linear footage and clip counts.</div>
      </a>
      <a href="/calculators/led-savings" class="block bg-white p-4 rounded-lg border border-gray-200 hover:border-blue-400 hover:shadow-sm transition-all">
        <div class="font-medium text-gray-900 text-sm">LED Bulb Savings Calculator</div>
        <div class="text-xs text-gray-500 mt-1">Calculate how much money you save by upgrading incandescent bulbs to LED.</div>
      </a>
    </div>
  </div>

</Layout>

<script is:inline>
  function calculate() {
    const height = parseFloat(document.getElementById('height').value);
    const shapeMultiplier = parseFloat(document.getElementById('shape').value);
    const densityPerFoot = parseFloat(document.getElementById('density').value);
    const bulbType = document.getElementById('bulbType').value;

    if (!height || height <= 0) return;

    // Base math: Total bulbs = height * lightsPerFoot * shapeMultiplier
    const totalBulbs = Math.round(height * densityPerFoot * shapeMultiplier);
    
    // Standard mini lights are 50 bulbs per 25ft, or 100 bulbs per 50ft (2 bulbs per foot)
    const totalFeet = Math.round(totalBulbs / 2);
    
    // Strands (100 bulbs per strand)
    const strands100 = Math.ceil(totalBulbs / 100);

    // Wattage calculation
    let wattsPer100 = 4; // default LED
    if (bulbType === 'inc-mini') wattsPer100 = 40;
    if (bulbType === 'c7-c9') wattsPer100 = 70;

    const totalWatts = Math.round(strands100 * wattsPer100);

    // 30 day cost: (Watts * 6 hrs * 30 days / 1000) * $0.16/kWh
    const kwh30Days = (totalWatts * 6 * 30) / 1000;
    const cost30Days = kwh30Days * 0.16;

    const fCost = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cost30Days);

    document.getElementById('r_bulbs').innerText = totalBulbs.toLocaleString() + " bulbs";
    document.getElementById('r_feet').innerText = totalFeet.toLocaleString() + " ft";
    document.getElementById('r_strands100').innerText = strands100 + " strands";
    document.getElementById('r_watts').innerText = totalWatts + " W";
    document.getElementById('r_cost').innerText = fCost + " / season";

    document.getElementById('results').classList.remove('hidden');
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('calcBtn').addEventListener('click', calculate);
  });
</script>

---
import '../styles/global.css';
import AdSlot from '../components/AdSlot.astro';
import { ADSENSE_CONFIG } from '../config/monetization';

const {
  title,
  description,
  noindex = false,
  image = '/og-image.jpg',
  imageAlt = 'CalcForDIY — 115 Free DIY Construction & Material Takeoff Calculators',
  ogType = 'website',
} = Astro.props;
const pathname = Astro.url.pathname;
const isCalculatorPage = pathname.startsWith('/calculators/') && pathname !== '/calculators/';
const navLinks = [
  { href: '/journal/', label: 'Journal', match: '/journal/' },
  { href: '/calculators/', label: 'Calculators', match: '/calculators/' },
  { href: '/projects/', label: 'Projects', match: '/projects/' },
  { href: '/guides/', label: 'Guides', match: '/guides/' },
  { href: '/about/', label: 'About', match: '/about/' },
];
const canonicalUrl = Astro.url.pathname.endsWith('/') ? `https://calcfordiy.com${Astro.url.pathname}` : `https://calcfordiy.com${Astro.url.pathname}/`;
const absoluteImageUrl = image.startsWith('http') ? image : `https://calcfordiy.com${image.startsWith('/') ? image : `/${image}`}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#2563eb" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </noscript>
  <meta name="description" content={description} />
  {noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large" />
  )}
  <title>{title}</title>
  <link rel="canonical" href={canonicalUrl} />
  
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-SK11L47SS5" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-SK11L47SS5');
  </script>

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6410565511961171" crossorigin="anonymous" is:inline></script>

  <!-- Open Graph Meta Tags -->
  <meta property="og:site_name" content="CalcForDIY" />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={absoluteImageUrl} />
  <meta property="og:image:alt" content={imageAlt} />
  
  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImageUrl} />
  <meta name="twitter:image:alt" content={imageAlt} />
</head>
  <body class="bg-gray-50 text-gray-900 overflow-x-hidden">
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-blue-600 focus:text-white focus:text-sm focus:font-semibold focus:rounded-lg focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-400"
    >
      Skip to main content
    </a>

    <header class="bg-white border-b border-gray-200 px-4 py-3 print:hidden">
      <div class="max-w-5xl mx-auto flex items-center justify-between gap-3">
        <a href="/" class="text-xl font-bold text-blue-600 shrink-0">CalcForDIY</a>
        <!-- Desktop nav -->
        <nav class="hidden sm:flex text-sm text-gray-600 gap-5 font-medium items-center" aria-label="Main Navigation">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={`hover:text-blue-600 transition-colors ${pathname.startsWith(link.match) ? 'text-blue-700 font-semibold' : ''}`}
            >{link.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-2 shrink-0">
          <button
            id="openProjectListBtn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200 bg-gray-50 hover:bg-blue-50 hover:border-blue-300 text-xs font-semibold text-gray-700 hover:text-blue-700 transition-colors cursor-pointer"
            aria-label="Open saved Project List"
          >
            <span aria-hidden="true">🧰</span>
            <span class="hidden md:inline">Project List</span>
            <span id="projectListBadge" class="inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 rounded-full bg-gray-200 text-gray-700 text-[10px] font-bold">0</span>
          </button>
          <!-- Mobile hamburger button -->
          <button
            id="mobileMenuBtn"
            type="button"
            class="sm:hidden flex flex-col justify-center items-center w-11 h-11 p-2 rounded-lg hover:bg-gray-100 transition-colors"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
          >
            <span class="hamburger-line block w-5 h-0.5 bg-gray-700 rounded-full transition-all duration-300"></span>
            <span class="hamburger-line block w-5 h-0.5 bg-gray-700 rounded-full transition-all duration-300 mt-1"></span>
            <span class="hamburger-line block w-5 h-0.5 bg-gray-700 rounded-full transition-all duration-300 mt-1"></span>
          </button>
        </div>
      </div>
      <!-- Mobile slide-down menu -->
      <nav id="mobileMenu" class="hidden sm:hidden max-w-5xl mx-auto pt-3 pb-1 border-t border-gray-100 mt-3" aria-label="Mobile Navigation">
        <div class="flex flex-col gap-1">
          {navLinks.map(link => (
            <a
              href={link.href}
              class={`block px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${pathname.startsWith(link.match) ? 'text-blue-700 bg-blue-50 font-semibold' : 'text-gray-700 hover:bg-gray-50 hover:text-blue-600'}`}
            >{link.label}</a>
          ))}
        </div>
      </nav>
    </header>
    
    <main id="main-content" class="max-w-5xl mx-auto px-4 py-8">
      {isCalculatorPage && (
        <div class="mb-6 text-xs text-gray-600 bg-white border border-gray-200 rounded-xl px-4 py-2.5 shadow-xs print:hidden">
          <div class="flex flex-wrap items-center gap-3">
            <span class="flex items-center gap-1.5 font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-md border border-emerald-200">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Last Verified: November 2026
            </span>
            <span class="text-gray-300">•</span>
            <span>Formulas Verified Against <strong>IRC, NEC, IFGC, TCNA, NWFA &amp; IES Standards</strong></span>
            <span class="text-gray-300">•</span>
            <a href="/methodology/" class="text-blue-600 font-medium hover:underline">Read Our Methodology →</a>
          </div>
          <details id="metricHelper" class="w-full pt-2 mt-2 border-t border-gray-100">
            <summary class="cursor-pointer font-semibold text-gray-700 hover:text-blue-700 select-none inline-flex items-center gap-1.5">
              <span>📏 Quick Metric ⇄ Imperial Converter (m, cm, m², L)</span>
            </summary>
            <div class="mt-2.5 flex flex-wrap items-center gap-2 bg-gray-50 p-2.5 rounded-lg border border-gray-200">
              <input
                type="number"
                id="metricHelperVal"
                value="10"
                step="any"
                aria-label="Value to convert between Metric and US Imperial"
                class="w-24 border border-gray-300 rounded-md px-2.5 py-1 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
              <select
                id="metricHelperMode"
                aria-label="Conversion units"
                class="border border-gray-300 rounded-md px-2.5 py-1 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <option value="m_ft">Meters → Feet</option>
                <option value="ft_m">Feet → Meters</option>
                <option value="cm_in">Centimeters → Inches</option>
                <option value="in_cm">Inches → Centimeters</option>
                <option value="sqm_sqft">Sq Meters → Sq Feet</option>
                <option value="sqft_sqm">Sq Feet → Sq Meters</option>
                <option value="m3_yd3">Cubic Meters → Cubic Yards</option>
                <option value="l_gal">Liters → US Gallons</option>
              </select>
              <span class="text-gray-400 font-bold">=</span>
              <strong id="metricHelperOut" class="font-mono text-xs text-blue-700 bg-blue-50 px-2.5 py-1 rounded border border-blue-200">32.81 ft</strong>
            </div>
          </details>
        </div>
      )}
      <slot />
      {isCalculatorPage && (
        <AdSlot
          type="in-feed"
          clientId={ADSENSE_CONFIG.clientId}
          slotId={ADSENSE_CONFIG.calculatorBelowResultsSlot}
        />
      )}
    </main>

    {isCalculatorPage && (
      <div class="max-w-5xl mx-auto px-4 mt-12 print:hidden">
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 text-sm text-amber-900 shadow-sm flex items-start gap-3">
          <span class="text-xl shrink-0">⚠️</span>
          <div>
            <h4 class="font-bold text-amber-950 mb-1">Planning Estimate Disclaimer &amp; AHJ Code Notice</h4>
            <p class="text-xs text-amber-900 leading-relaxed">
              While we have performed strict due diligence in researching building codes (IRC, TCNA, NEC, IES), manufacturer specifications, and material formulas, CalcForDIY bears no responsibility or liability for the use of these tools. All calculations provide planning estimates, not permit-ready structural, electrical, or plumbing designs. Always verify measurements and code compliance with your local <strong>Authority Having Jurisdiction (AHJ)</strong> or building department prior to purchasing materials or executing construction.
            </p>
          </div>
        </div>
      </div>
    )}

    <footer class="border-t border-gray-200 mt-16 px-4 py-10 text-sm text-gray-500 print:hidden">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Calculators</h3>
            <ul class="space-y-2">
              <li><a href="/calculators/shower-tile/" class="hover:text-blue-600">Shower Tile</a></li>
              <li><a href="/calculators/paint-room/" class="hover:text-blue-600">Paint — Room</a></li>
              <li><a href="/calculators/laminate-flooring/" class="hover:text-blue-600">Laminate Flooring</a></li>
              <li><a href="/calculators/concrete-slab/" class="hover:text-blue-600">Concrete Slab</a></li>
              <li><a href="/calculators/drywall/" class="hover:text-blue-600">Drywall</a></li>
              <li><a href="/calculators/" class="text-blue-600 font-medium hover:underline">View all 115 calculators →</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Categories</h3>
            <ul class="space-y-2">
              <li><a href="/calculators/#tile-flooring" class="hover:text-blue-600">Tile &amp; Flooring</a></li>
              <li><a href="/calculators/#carpentry-framing-roofing" class="hover:text-blue-600">Carpentry &amp; Roofing</a></li>
              <li><a href="/calculators/#millwork-trim-walls" class="hover:text-blue-600">Millwork &amp; Trim</a></li>
              <li><a href="/calculators/#concrete-masonry" class="hover:text-blue-600">Concrete &amp; Masonry</a></li>
              <li><a href="/calculators/#landscaping-hardscaping" class="hover:text-blue-600">Landscaping &amp; Paving</a></li>
              <li><a href="/calculators/#electrical-solar-lighting" class="hover:text-blue-600">Electrical &amp; Solar</a></li>
              <li><a href="/calculators/#plumbing-hvac-energy" class="hover:text-blue-600">Plumbing &amp; HVAC</a></li>
              <li><a href="/calculators/#paint-finishing" class="hover:text-blue-600">Paint &amp; Finishing</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Resources</h3>
            <ul class="space-y-2">
              <li><a href="/journal/" class="hover:text-blue-600 font-semibold text-blue-700">The Field Journal</a></li>
              <li><a href="/projects/" class="hover:text-blue-600">Project Hubs</a></li>
              <li><a href="/guides/" class="hover:text-blue-600">DIY Guides</a></li>
              <li><a href="/guides/how-much-mulch-for-garden-beds/" class="hover:text-blue-600">Mulch Guide</a></li>
              <li><a href="/guides/laminate-flooring-waste-factor/" class="hover:text-blue-600">Waste Factor Guide</a></li>
              <li><a href="/guides/how-much-concrete-for-fence-posts/" class="hover:text-blue-600">Fence Post Guide</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Company &amp; E-E-A-T</h3>
            <ul class="space-y-2">
              <li><a href="/about/" class="hover:text-blue-600 font-medium">About CalcForDIY</a></li>
              <li><a href="/methodology/" class="hover:text-blue-600">Calculation Methodology</a></li>
              <li><a href="/contact/" class="hover:text-blue-600">Contact Us</a></li>
              <li><a href="/privacy/" class="hover:text-blue-600">Privacy Policy</a></li>
              <li><a href="/terms/" class="hover:text-blue-600">Terms of Service</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-200 pt-6 text-center text-xs text-gray-500 space-y-1.5">
          <p>© 2026 CalcForDIY • Built for Homeowners &amp; Tradespeople • Sourced from IRC, TCNA, NWFA &amp; IES Building Standards.</p>
          <p class="text-gray-500">Created &amp; Maintained by CalcForDIY Engineering • <a href="/about/" class="hover:underline text-gray-600 font-medium">About</a> • <a href="/methodology/" class="hover:underline text-gray-600 font-medium">Methodology &amp; Code Standards</a> • <a href="/contact/" class="hover:underline text-gray-600 font-medium">Contact Us</a> • <a href="/privacy/" class="hover:underline text-gray-600 font-medium">Privacy Policy</a> • <a href="/terms/" class="hover:underline text-gray-600 font-medium">Terms of Service</a></p>
          <p class="text-gray-500">All calculations are planning estimates. Always verify quantities with specific product data sheets and your local AHJ before installation.</p>
        </div>
      </div>
    </footer>

    <!-- Embed Calculator Modal (Moat 5) -->
    {isCalculatorPage && (
      <div id="embedModal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 print:hidden" role="dialog" aria-modal="true" aria-labelledby="embedModalTitle">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-gray-200">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded-md font-mono text-xs font-bold" aria-hidden="true">&lt;/&gt;</span>
              <h3 id="embedModalTitle" class="text-base font-bold text-gray-900">Embed this Calculator on Your Website</h3>
            </div>
            <button type="button" onclick="document.getElementById('embedModal').classList.add('hidden')" class="text-gray-500 hover:text-gray-700 text-2xl font-bold leading-none p-1 rounded-md" aria-label="Close modal">&times;</button>
          </div>
          <p class="text-xs text-gray-600 mb-3">Add this free interactive calculation tool to your blog, carpentry website, or contractor portal. Copy and paste the HTML snippet below:</p>
          <div class="relative mb-4">
            <textarea id="embedSnippetArea" readonly rows="4" class="w-full bg-gray-50 border border-gray-300 rounded-lg p-3 text-xs font-mono text-gray-800 select-all focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
          </div>
          <div class="flex gap-2">
            <button type="button" id="copyEmbedBtn" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-4 rounded-lg text-xs transition-colors flex items-center justify-center gap-2">
              📋 Copy HTML Embed Code
            </button>
            <button type="button" onclick="document.getElementById('embedModal').classList.add('hidden')" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 px-4 rounded-lg text-xs transition-colors">
              Close
            </button>
          </div>
        </div>
      </div>
    )}

    <!-- Saved Project Shopping List Drawer -->
    <div id="projectListDrawer" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex justify-end print:hidden" role="dialog" aria-modal="true" aria-labelledby="projectDrawerTitle">
      <div class="bg-white w-full max-w-md h-full flex flex-col shadow-2xl border-l border-gray-200">
        <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between bg-slate-50">
          <div>
            <h3 id="projectDrawerTitle" class="text-base font-bold text-gray-900 flex items-center gap-2">
              <span>🧰</span> My Project Shopping List
            </h3>
            <p class="text-[11px] text-gray-500">Combine estimates across calculators in this browser</p>
          </div>
          <button type="button" id="closeProjectListBtn" class="text-gray-500 hover:text-gray-800 text-2xl font-bold leading-none p-1 rounded-md cursor-pointer" aria-label="Close project list">&times;</button>
        </div>

        <div id="projectListItems" class="flex-1 overflow-y-auto p-5 space-y-3"></div>

        <div class="p-4 border-t border-gray-200 bg-gray-50 space-y-2">
          <div class="grid grid-cols-2 gap-2">
            <button type="button" id="copyProjectListBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-3 rounded-lg text-xs transition-colors cursor-pointer">
              📋 Copy Combined List
            </button>
            <button type="button" id="printProjectListBtn" class="w-full bg-white hover:bg-gray-100 text-gray-800 font-semibold py-2.5 px-3 rounded-lg border border-gray-300 text-xs transition-colors cursor-pointer">
              🖨️ Print Checklist
            </button>
          </div>
          <button type="button" id="clearProjectListBtn" class="w-full text-[11px] text-gray-500 hover:text-red-600 font-medium py-1 transition-colors cursor-pointer">
            Clear All Saved Items
          </button>
        </div>
      </div>
    </div>

    <!-- Floating results button - added print:hidden so it doesn't print -->
    <div id="floatBtn" class="hidden fixed bottom-6 inset-x-0 flex justify-center z-50 pointer-events-none print:hidden">
      <button
        onclick="document.getElementById('results').scrollIntoView({behavior:'smooth'})"
        class="pointer-events-auto bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full shadow-xl font-semibold text-sm flex items-center gap-2 transition-all">
        See your results ↓
      </button>
    </div>

    <!-- Printable Project Shopping List Container (hidden except during Project List print) -->
    <div id="projectPrintArea" class="hidden p-8 bg-white text-gray-900"></div>

    <style is:inline>
      @media print {
        body.print-project-mode > *:not(#projectPrintArea) {
          display: none !important;
        }
        body.print-project-mode #projectPrintArea {
          display: block !important;
        }
      }
    </style>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var STORAGE_KEY = 'calcfordiy_project_list';
        var pathname = window.location.pathname;
        var isCalcPage = pathname.indexOf('/calculators/') === 0 && pathname !== '/calculators/';
        var mainContent = document.getElementById('main-content');
        var floatBtn = document.getElementById('floatBtn');
        var gaFired = false;
        var isAutoRunning = false;
        window.__calcSilent = false;

        // ── GA4 helper ──────────────────────────────────────────────────────
        function fireGA(eventName, params) {
          if (typeof gtag === 'function') {
            gtag('event', eventName, params);
          }
        }

        // ── Locate Results Container (#results, #resultCard, or fallback metric panel) ──
        function getResultsContainer() {
          var el = document.getElementById('results') || document.getElementById('resultCard');
          if (el) return el;
          if (!isCalcPage || !mainContent) return null;
          var rMetric = mainContent.querySelector('[id^="r_"]');
          if (!rMetric) return null;
          var node = rMetric.parentElement;
          while (node && node.parentElement && node.parentElement !== mainContent) {
            node = node.parentElement;
          }
          if (node && node !== mainContent && !node.querySelector('#calcBtn, input[type="number"]')) {
            return node;
          }
          return null;
        }

        // ── Locate Primary Calculate Button ──────────────────────────────────
        function findCalcTrigger() {
          var btn = document.getElementById('calcBtn');
          if (btn) return btn;
          if (!mainContent) return null;
          var btns = mainContent.querySelectorAll('button');
          for (var i = 0; i < btns.length; i++) {
            var b = btns[i];
            if (b.closest('.calc-utility-bar') || b.closest('#metricHelper')) continue;
            var onclick = (b.getAttribute('onclick') || '').toLowerCase();
            var label = (b.textContent || '').toLowerCase();
            if (onclick.indexOf('calc') !== -1 || label.indexOf('calculate') !== -1) {
              return b;
            }
          }
          return null;
        }

        var resultsEl = getResultsContainer();
        var calcBtn = findCalcTrigger();

        // ── Track intentional human clicks on Calculate button ───────────────
        if (calcBtn) {
          calcBtn.addEventListener('click', function (e) {
            if (!e.isTrusted || isAutoRunning) return;
            fireGA('calculate_button_click', {
              page_title: document.title,
              page_location: window.location.href
            });
          });
        }

        // ── Metric <-> Imperial Helper Converter ─────────────────────────────
        (function initMetricHelper() {
          var valEl = document.getElementById('metricHelperVal');
          var modeEl = document.getElementById('metricHelperMode');
          var outEl = document.getElementById('metricHelperOut');
          if (!valEl || !modeEl || !outEl) return;

          var rates = {
            m_ft: { mult: 3.28084, unit: 'ft' },
            ft_m: { mult: 0.3048, unit: 'm' },
            cm_in: { mult: 0.393701, unit: 'in' },
            in_cm: { mult: 2.54, unit: 'cm' },
            sqm_sqft: { mult: 10.7639, unit: 'sq ft' },
            sqft_sqm: { mult: 0.092903, unit: 'm²' },
            m3_yd3: { mult: 1.30795, unit: 'cu yd' },
            l_gal: { mult: 0.264172, unit: 'gal (US)' }
          };

          function convertMetric() {
            var n = parseFloat(valEl.value);
            var cfg = rates[modeEl.value];
            if (isNaN(n) || !cfg) {
              outEl.textContent = '—';
              return;
            }
            var res = n * cfg.mult;
            outEl.textContent = (Math.abs(res) >= 100 ? res.toFixed(1) : res.toFixed(2)) + ' ' + cfg.unit;
          }

          valEl.addEventListener('input', convertMetric);
          modeEl.addEventListener('change', convertMetric);
          convertMetric();
        })();

        // ── Build Shareable URL Encoding Primary Inputs ──────────────────────
        function buildShareUrl() {
          var baseUrl = window.location.href.split('?')[0].split('#')[0];
          if (!mainContent) return baseUrl;
          var params = new URLSearchParams();
          var controls = mainContent.querySelectorAll('input, select');
          controls.forEach(function (el) {
            if (!el.id || el.type === 'hidden' || el.type === 'button' || el.type === 'submit') return;
            if (el.closest('#metricHelper') || el.closest('#projectListDrawer') || el.closest('#embedModal')) return;
            if (el.id === 'locMultSelect' || el.id === 'calcSearch' || el.id === 'heroCalcSearch') return;
            if (el.type === 'checkbox' || el.type === 'radio') {
              params.set('c_' + el.id, el.checked ? '1' : '0');
            } else if (el.value !== '') {
              params.set('c_' + el.id, el.value);
            }
          });
          var qs = params.toString();
          return qs ? baseUrl + '?' + qs : baseUrl;
        }

        // ── Scrape Clean Takeoff Items From Results Container ────────────────
        function collectEstimateLines(resDiv) {
          var title = document.title.split('—')[0].trim();
          var lines = [];
          var seenLabels = {};

          if (!resDiv) return { title: title, items: lines, text: '' };

          // Light #results metric boxes (.bg-white.rounded-lg / .rounded-xl) and dark #resultCard boxes (.bg-slate-800/80)
          var cards = resDiv.querySelectorAll('.bg-white.rounded-lg, .bg-white.rounded-xl, .bg-slate-800\\/80');
          cards.forEach(function (card) {
            var valEl = card.querySelector('[id^="r_"], .text-2xl, .text-3xl, .text-xl, .font-black, .font-bold');
            var labelEl = card.querySelector('.text-xs, .text-sm, .text-slate-400, .text-gray-500, .font-medium');
            if (valEl && labelEl && valEl !== labelEl) {
              var val = (valEl.textContent || '').replace(/\s+/g, ' ').trim();
              var label = (labelEl.textContent || '').replace(/\s+/g, ' ').trim();
              if (val && label && val !== '—' && !seenLabels[label] && !label.includes('On-Center') && !label.includes('Layout Summary')) {
                seenLabels[label] = true;
                lines.push(label + ': ' + val);
              }
            }
          });

          // Fallback for inline <strong> metrics with id^="r_"
          if (lines.length === 0) {
            resDiv.querySelectorAll('[id^="r_"]').forEach(function (el) {
              var val = (el.textContent || '').replace(/\s+/g, ' ').trim();
              var parent = el.parentElement;
              var labelSpan = parent ? parent.querySelector('span, div') : null;
              var label = labelSpan && labelSpan !== el ? (labelSpan.textContent || '').replace(/[:\s]+$/g, '').trim() : el.id.replace(/^r_/, '');
              if (val && val !== '—' && !seenLabels[label]) {
                seenLabels[label] = true;
                lines.push(label + ': ' + val);
              }
            });
          }

          var shareUrl = buildShareUrl();
          var textLines = [];
          textLines.push('📋 ' + title + ' — Material Takeoff');
          textLines.push('CalcForDIY | ' + shareUrl);
          textLines.push('----------------------------------------');
          lines.forEach(function (item) {
            textLines.push('• ' + item);
          });
          var summaryEl = document.getElementById('r_summary') || document.getElementById('r_buying') || document.getElementById('r_birdsMouth');
          if (summaryEl && summaryEl.textContent.trim() !== '—') {
            textLines.push('');
            textLines.push('Details: ' + summaryEl.textContent.trim());
          }
          textLines.push('----------------------------------------');
          textLines.push('Calculated at CalcForDIY.com — "Measure seven times, cut once."');

          return {
            title: title,
            items: lines.slice(0, 8),
            shareUrl: shareUrl,
            text: textLines.join('\n')
          };
        }

        // ── Cross-Calculator Saved Project List Store ────────────────────────
        function loadProjectList() {
          try {
            var raw = localStorage.getItem(STORAGE_KEY);
            var parsed = raw ? JSON.parse(raw) : [];
            return Array.isArray(parsed) ? parsed : [];
          } catch (e) {
            return [];
          }
        }

        function saveProjectList(list) {
          try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
          } catch (e) {}
          renderProjectDrawer();
        }

        function renderProjectDrawer() {
          var list = loadProjectList();
          var badge = document.getElementById('projectListBadge');
          var container = document.getElementById('projectListItems');
          if (badge) {
            badge.textContent = String(list.length);
            if (list.length > 0) {
              badge.classList.remove('bg-gray-200', 'text-gray-700');
              badge.classList.add('bg-blue-600', 'text-white');
            } else {
              badge.classList.remove('bg-blue-600', 'text-white');
              badge.classList.add('bg-gray-200', 'text-gray-700');
            }
          }
          if (!container) return;

          container.textContent = '';
          if (list.length === 0) {
            var empty = document.createElement('div');
            empty.className = 'text-center py-10 px-4 text-gray-500 text-xs leading-relaxed border border-dashed border-gray-300 rounded-xl bg-gray-50';
            empty.textContent = 'Your Project List is empty. Run any calculator and click "Save to Project List" to combine takeoffs into one hardware-store checklist.';
            container.appendChild(empty);
            return;
          }

          list.forEach(function (entry, idx) {
            var card = document.createElement('div');
            card.className = 'border border-gray-200 rounded-xl p-3.5 bg-white shadow-2xs';

            var head = document.createElement('div');
            head.className = 'flex items-start justify-between gap-2 mb-2';
            var titleLink = document.createElement('a');
            titleLink.href = entry.shareUrl || entry.path;
            titleLink.className = 'font-bold text-xs text-blue-700 hover:underline';
            titleLink.textContent = entry.title;

            var rmBtn = document.createElement('button');
            rmBtn.type = 'button';
            rmBtn.className = 'remove-project-item text-gray-400 hover:text-red-600 text-sm font-bold leading-none px-1 cursor-pointer';
            rmBtn.setAttribute('data-index', String(idx));
            rmBtn.setAttribute('aria-label', 'Remove saved estimate');
            rmBtn.textContent = '×';

            head.appendChild(titleLink);
            head.appendChild(rmBtn);
            card.appendChild(head);

            if (Array.isArray(entry.items) && entry.items.length > 0) {
              var ul = document.createElement('ul');
              ul.className = 'space-y-1 text-[11px] text-gray-700';
              entry.items.forEach(function (it) {
                var li = document.createElement('li');
                li.textContent = '• ' + it;
                ul.appendChild(li);
              });
              card.appendChild(ul);
            }
            container.appendChild(card);
          });
        }

        function buildCombinedProjectText() {
          var list = loadProjectList();
          if (list.length === 0) return '';
          var out = [];
          out.push('🧰 CALCFORDIY — COMBINED PROJECT SHOPPING LIST');
          out.push('========================================');
          list.forEach(function (entry, idx) {
            out.push('');
            out.push((idx + 1) + '. ' + entry.title);
            (entry.items || []).forEach(function (it) {
              out.push('   • ' + it);
            });
            out.push('   Link: ' + (entry.shareUrl || ('https://calcfordiy.com' + entry.path)));
          });
          out.push('');
          out.push('========================================');
          out.push('Generated on CalcForDIY.com — "Measure seven times, cut once."');
          return out.join('\n');
        }

        // Drawer controls
        renderProjectDrawer();
        var drawer = document.getElementById('projectListDrawer');
        var openDrawerBtn = document.getElementById('openProjectListBtn');
        var closeDrawerBtn = document.getElementById('closeProjectListBtn');
        if (openDrawerBtn && drawer) {
          openDrawerBtn.addEventListener('click', function () {
            renderProjectDrawer();
            drawer.classList.remove('hidden');
          });
        }
        if (closeDrawerBtn && drawer) {
          closeDrawerBtn.addEventListener('click', function () {
            drawer.classList.add('hidden');
          });
        }
        if (drawer) {
          drawer.addEventListener('click', function (e) {
            if (e.target === drawer) drawer.classList.add('hidden');
          });
        }

        var copyProjBtn = document.getElementById('copyProjectListBtn');
        if (copyProjBtn) {
          copyProjBtn.addEventListener('click', function () {
            var txt = buildCombinedProjectText();
            if (!txt) return;
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(txt).then(function () {
                showCopyFeedback(copyProjBtn);
              });
            } else {
              fallbackCopyText(txt, copyProjBtn);
            }
          });
        }

        var printProjBtn = document.getElementById('printProjectListBtn');
        if (printProjBtn) {
          printProjBtn.addEventListener('click', function () {
            var list = loadProjectList();
            if (list.length === 0) return;
            var printArea = document.getElementById('projectPrintArea');
            if (!printArea) return;
            printArea.textContent = '';

            var h1 = document.createElement('h1');
            h1.className = 'text-2xl font-bold mb-1';
            h1.textContent = 'CalcForDIY — Combined Project Shopping List';
            var sub = document.createElement('p');
            sub.className = 'text-xs text-gray-500 mb-6 pb-3 border-b border-gray-300';
            sub.textContent = 'Generated from https://calcfordiy.com/ — Verify quantities and waste factors against local AHJ & product datasheets.';
            printArea.appendChild(h1);
            printArea.appendChild(sub);

            list.forEach(function (entry, idx) {
              var sec = document.createElement('div');
              sec.className = 'mb-5 pb-4 border-b border-gray-200';
              var h2 = document.createElement('h2');
              h2.className = 'text-base font-bold mb-2';
              h2.textContent = (idx + 1) + '. ' + entry.title;
              sec.appendChild(h2);
              var ul = document.createElement('ul');
              ul.className = 'text-sm space-y-1 ml-4';
              (entry.items || []).forEach(function (it) {
                var li = document.createElement('li');
                li.textContent = '□ ' + it;
                ul.appendChild(li);
              });
              sec.appendChild(ul);
              printArea.appendChild(sec);
            });

            document.body.classList.add('print-project-mode');
            printArea.classList.remove('hidden');
            var cleanupPrint = function () {
              document.body.classList.remove('print-project-mode');
              printArea.classList.add('hidden');
            };
            window.addEventListener('afterprint', cleanupPrint, { once: true });
            window.print();
            setTimeout(cleanupPrint, 1200);
          });
        }

        var clearProjBtn = document.getElementById('clearProjectListBtn');
        if (clearProjBtn) {
          clearProjBtn.addEventListener('click', function () {
            saveProjectList([]);
          });
        }

        document.addEventListener('click', function (e) {
          var rm = e.target.closest('.remove-project-item');
          if (rm) {
            var idx = parseInt(rm.getAttribute('data-index') || '-1', 10);
            var list = loadProjectList();
            if (idx >= 0 && idx < list.length) {
              list.splice(idx, 1);
              saveProjectList(list);
            }
          }
        });

        // ── Ensure Action Utility Bar (Copy, Save, Share, Embed) ─────────────
        function ensureUtilityBar(resDiv) {
          if (!resDiv) return;

          // Inject primary Copy button next to Print button on legacy #results grids
          var existingPrimaryCopy = resDiv.querySelector('.copy-list-btn, #copyBtn, #copyListBtn, #copyScheduleBtn');
          if (!existingPrimaryCopy) {
            var printBtn = resDiv.querySelector('#printBtn, button[onclick*="window.print"]');
            if (printBtn && printBtn.parentElement && printBtn.parentElement.classList.contains('grid')) {
              var pBtn = document.createElement('button');
              pBtn.type = 'button';
              pBtn.className = 'copy-list-btn w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2 cursor-pointer';
              pBtn.innerHTML = '📋 Copy Shopping List';
              printBtn.parentElement.insertBefore(pBtn, printBtn);
            }
          }

          if (resDiv.querySelector('.calc-utility-bar')) return;

          var bar = document.createElement('div');
          var isDark = resDiv.id === 'resultCard' || resDiv.classList.contains('bg-slate-900');
          bar.className = 'calc-utility-bar mt-4 pt-3 border-t flex flex-wrap gap-2 print:hidden ' + (isDark ? 'border-slate-700' : 'border-black/10');

          var btnClass = isDark
            ? 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-100 border border-slate-600 transition-colors cursor-pointer'
            : 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white hover:bg-gray-50 text-gray-800 border border-gray-300 transition-colors shadow-2xs cursor-pointer';

          // Add Copy button if no dedicated copy button already exists on this page
          if (!resDiv.querySelector('.copy-list-btn, #copyBtn, #copyListBtn, #copyScheduleBtn')) {
            var copyFallback = document.createElement('button');
            copyFallback.type = 'button';
            copyFallback.className = 'copy-list-btn ' + btnClass;
            copyFallback.textContent = '📋 Copy Shopping List';
            bar.appendChild(copyFallback);
          }

          var saveBtn = document.createElement('button');
          saveBtn.type = 'button';
          saveBtn.className = 'save-project-btn ' + btnClass;
          saveBtn.textContent = '➕ Save to Project List';
          bar.appendChild(saveBtn);

          var shareBtn = document.createElement('button');
          shareBtn.type = 'button';
          shareBtn.className = 'share-link-btn ' + btnClass;
          shareBtn.textContent = '🔗 Share Estimate Link';
          bar.appendChild(shareBtn);

          if (!resDiv.querySelector('.open-embed-modal-btn')) {
            var embedBtn = document.createElement('button');
            embedBtn.type = 'button';
            embedBtn.className = 'open-embed-modal-btn ' + btnClass;
            embedBtn.textContent = '</> Embed Tool';
            bar.appendChild(embedBtn);
          }

          resDiv.appendChild(bar);
        }

        // ── Ensure Cost Benchmarking Card is present (Moat 3) ────────────────
        function ensureCostBenchmarking(resDiv) {
          if (!resDiv || resDiv.id !== 'results') return;

          if (document.getElementById('c_diyCost') || document.querySelector('[id^="c_diy"]') || document.querySelector('.rsmeans-benchmark') || resDiv.querySelector('#c_diyCost')) {
            var existingBox = document.getElementById('costBenchmarkBox');
            if (existingBox) existingBox.remove();
            return;
          }

          var benchmarkBox = document.getElementById('costBenchmarkBox');
          if (!benchmarkBox) {
            benchmarkBox = document.createElement('div');
            benchmarkBox.id = 'costBenchmarkBox';
            benchmarkBox.className = 'w-full bg-white rounded-xl p-5 shadow-xs mb-6 border border-emerald-200 mt-4 print:border-gray-300';
            if (resDiv.nextSibling) {
              resDiv.parentNode.insertBefore(benchmarkBox, resDiv.nextSibling);
            } else {
              resDiv.parentNode.appendChild(benchmarkBox);
            }
          }

          if (typeof window.updateCostBenchmark === 'function') {
            window.updateCostBenchmark();
          } else {
            autoGenerateCostBenchmark(resDiv, benchmarkBox);
          }
        }

        function autoGenerateCostBenchmark(resDiv, box) {
          var locationMultiplier = parseFloat(localStorage.getItem('calc_loc_mult')) || 1.0;
          var title = document.title.split('—')[0].trim();
          var diyMin = 0, diyMax = 0, contMin = 0, contMax = 0;

          if (title.includes('French Drain')) {
            var gTons = parseFloat((document.getElementById('r_gravelTons')?.innerText || '').replace(/[^\d.]/g, '')) || 4;
            var pFeet = parseFloat((document.getElementById('r_pipeFeet')?.innerText || '').replace(/[^\d.]/g, '')) || 50;
            var fSqFt = parseFloat((document.getElementById('r_fabricSqFt')?.innerText || '').replace(/[^\d.]/g, '')) || 300;
            var matCost = (gTons * 48) + (pFeet * 1.35) + (fSqFt * 0.25);
            diyMin = Math.round(matCost * 0.90 * locationMultiplier);
            diyMax = Math.round(matCost * 1.15 * locationMultiplier);
            contMin = Math.round(diyMin * 4.6);
            contMax = Math.round(diyMax * 5.8);
          } else if (title.includes('Concrete')) {
            var yds = parseFloat((document.getElementById('r_yards')?.innerText || document.getElementById('r_totalYards')?.innerText || '').replace(/[^\d.]/g, '')) || 3;
            var matCost = (yds * 155) + 140;
            diyMin = Math.round(matCost * 0.90 * locationMultiplier);
            diyMax = Math.round(matCost * 1.15 * locationMultiplier);
            contMin = Math.round(diyMin * 3.6);
            contMax = Math.round(diyMax * 4.6);
          } else if (title.includes('Shingle') || title.includes('Roof')) {
            var sqs = parseFloat((document.getElementById('r_squares')?.innerText || '').replace(/[^\d.]/g, '')) || 20;
            var matCost = Math.max(600, sqs * 140);
            diyMin = Math.round(matCost * 0.90 * locationMultiplier);
            diyMax = Math.round(matCost * 1.15 * locationMultiplier);
            contMin = Math.round(diyMin * 3.4);
            contMax = Math.round(diyMax * 4.4);
          } else if (title.includes('Retaining Wall')) {
            var blocks = parseFloat((document.getElementById('r_totalBlocks')?.innerText || '').replace(/[^\d.]/g, '')) || 100;
            var matCost = Math.max(400, (blocks * 5.80) + 180);
            diyMin = Math.round(matCost * 0.90 * locationMultiplier);
            diyMax = Math.round(matCost * 1.15 * locationMultiplier);
            contMin = Math.round(diyMin * 4.2);
            contMax = Math.round(diyMax * 5.2);
          } else if (title.includes('Fence')) {
            var pickets = parseFloat((document.getElementById('r_pickets')?.innerText || '').replace(/[^\d.]/g, '')) || 120;
            var posts = parseFloat((document.getElementById('r_posts')?.innerText || '').replace(/[^\d.]/g, '')) || 15;
            var matCost = Math.max(500, (pickets * 2.30) + (posts * 16) + 150);
            diyMin = Math.round(matCost * 0.90 * locationMultiplier);
            diyMax = Math.round(matCost * 1.15 * locationMultiplier);
            contMin = Math.round(diyMin * 3.5);
            contMax = Math.round(diyMax * 4.2);
          } else if (title.includes('Deck')) {
            var lf = parseFloat((document.getElementById('r_linearFeet')?.innerText || '').replace(/[^\d.]/g, '')) || 300;
            var matCost = Math.max(600, (lf * 2.20) + 200);
            diyMin = Math.round(matCost * 0.90 * locationMultiplier);
            diyMax = Math.round(matCost * 1.15 * locationMultiplier);
            contMin = Math.round(diyMin * 3.4);
            contMax = Math.round(diyMax * 4.2);
          } else if (title.includes('EV Charger')) {
            diyMin = Math.round(180 * locationMultiplier);
            diyMax = Math.round(260 * locationMultiplier);
            contMin = Math.round(750 * locationMultiplier);
            contMax = Math.round(1450 * locationMultiplier);
          } else if (title.includes('Water Heater')) {
            diyMin = Math.round(680 * locationMultiplier);
            diyMax = Math.round(880 * locationMultiplier);
            contMin = Math.round(1650 * locationMultiplier);
            contMax = Math.round(2450 * locationMultiplier);
          } else if (title.includes('Mini-Split')) {
            diyMin = Math.round(1350 * locationMultiplier);
            diyMax = Math.round(1850 * locationMultiplier);
            contMin = Math.round(4200 * locationMultiplier);
            contMax = Math.round(6800 * locationMultiplier);
          } else if (title.includes('Attic Insulation')) {
            var bags = parseFloat((document.getElementById('r_totalBags')?.innerText || '').replace(/[^\d.]/g, '')) || 15;
            var matCost = Math.max(200, bags * 18.50);
            diyMin = Math.round(matCost * 0.90 * locationMultiplier);
            diyMax = Math.round(matCost * 1.15 * locationMultiplier);
            contMin = Math.round(diyMin * 3.2);
            contMax = Math.round(diyMax * 4.2);
          } else if (title.includes('Sod')) {
            var pallets = parseFloat((document.getElementById('r_pallets')?.innerText || '').replace(/[^\d.]/g, '')) || 3;
            var matCost = Math.max(300, (pallets * 260) + 120);
            diyMin = Math.round(matCost * 0.90 * locationMultiplier);
            diyMax = Math.round(matCost * 1.15 * locationMultiplier);
            contMin = Math.round(diyMin * 3.4);
            contMax = Math.round(diyMax * 4.5);
          } else if (title.includes('Paint')) {
            var gals = parseFloat((document.getElementById('r_gallons')?.innerText || '').replace(/[^\d.]/g, '')) || 2;
            var matCost = Math.max(80, (gals * 52) + 35);
            diyMin = Math.round(matCost * 0.90 * locationMultiplier);
            diyMax = Math.round(matCost * 1.15 * locationMultiplier);
            contMin = Math.round(diyMin * 5.2);
            contMax = Math.round(diyMax * 6.5);
          } else {
            var areaVal = 100;
            var cards = resDiv.querySelectorAll('.bg-white.rounded-lg');
            cards.forEach(function(c) {
              var txt = c.textContent || '';
              var numMatch = txt.match(/([\d,]+\.?\d*)/);
              if (numMatch && !areaVal) {
                areaVal = parseFloat(numMatch[1].replace(/,/g, ''));
              }
            });
            var matCost = Math.max(150, areaVal * 2.50);
            diyMin = Math.round(matCost * 0.85 * locationMultiplier);
            diyMax = Math.round(matCost * 1.15 * locationMultiplier);
            contMin = Math.round(diyMin * 3.5);
            contMax = Math.round(diyMax * 4.5);
          }

          var saveMin = Math.max(50, contMin - diyMax);
          var saveMax = Math.max(100, contMax - diyMin);
          var savePct = Math.round(((contMin - diyMax) / contMin) * 100);
          if (savePct < 45 || isNaN(savePct)) savePct = 68;

          renderBenchmarkHTML(box, title, diyMin, diyMax, contMin, contMax, saveMin, saveMax, savePct, locationMultiplier);
        }

        window.renderBenchmarkHTML = function(box, title, diyMin, diyMax, contMin, contMax, saveMin, saveMax, savePct, locMult) {
          box.innerHTML = `
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3 pb-3 border-b border-gray-100">

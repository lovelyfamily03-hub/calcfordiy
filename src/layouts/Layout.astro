                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
              <div class="bg-gray-50 rounded-lg p-3 text-center border border-gray-200">
                <div class="text-xs font-semibold text-gray-600 uppercase tracking-wide">🛠️ DIY Materials Only</div>
                <div class="text-xl font-bold text-gray-900 mt-1">$${diyMin.toLocaleString()} – $${diyMax.toLocaleString()}</div>
                <div class="text-[10px] text-gray-500 mt-0.5">Raw materials &amp; supplies</div>
              </div>

              <div class="bg-gray-50 rounded-lg p-3 text-center border border-gray-200">
                <div class="text-xs font-semibold text-gray-600 uppercase tracking-wide">👷 Contractor Installed</div>
                <div class="text-xl font-bold text-gray-900 mt-1">$${contMin.toLocaleString()} – $${contMax.toLocaleString()}</div>
                <div class="text-[10px] text-gray-500 mt-0.5">Turnkey labor, equipment &amp; markup</div>
              </div>

              <div class="bg-gradient-to-br from-green-50 to-emerald-100 rounded-lg p-3 text-center border-2 border-green-400 shadow-xs">
                <div class="text-xs font-bold text-green-800 uppercase tracking-wide">💵 Potential DIY Savings</div>
                <div class="text-xl font-black text-green-700 mt-1">SAVE $${saveMin.toLocaleString()} – $${saveMax.toLocaleString()}</div>
                <div class="text-[10px] font-bold text-green-800 mt-0.5">Keep ~${savePct}% in your pocket!</div>
              </div>
            </div>

            <div class="bg-gray-50 p-3 rounded-lg border border-gray-200">
              <div class="flex justify-between items-center text-xs text-gray-600 font-medium mb-1.5">
                <span>Contractor Cost Breakdown Benchmark</span>
                <span>Materials 30% • Labor 55% • Overhead 15%</span>
              </div>
              <div class="w-full bg-gray-200 h-3 rounded-full overflow-hidden flex">
                <div class="bg-blue-500 h-full" style="width: 30%" title="Materials: 30%"></div>
                <div class="bg-purple-600 h-full" style="width: 55%" title="Labor & Crew: 55%"></div>
                <div class="bg-amber-500 h-full" style="width: 15%" title="Overhead & Permits: 15%"></div>
              </div>
            </div>
          `;
        };

        window.changeLocMult = function(val) {
          localStorage.setItem('calc_loc_mult', val);
          var resultsDiv = document.getElementById('results');
          if (resultsDiv) ensureCostBenchmarking(resultsDiv);
        };

        // ── URL Hydration & Safe Silent Initial Auto-Calculation ─────────────
        function runTriggerSilently() {
          var trigger = findCalcTrigger();
          if (!trigger || isAutoRunning) return;
          isAutoRunning = true;
          window.__calcSilent = true;
          try {
            trigger.click();
          } finally {
            setTimeout(function () {
              isAutoRunning = false;
              window.__calcSilent = false;
            }, 120);
          }
        }

        if (isCalcPage && mainContent) {
          setTimeout(function () {
            var searchParams = new URLSearchParams(window.location.search);
            var hydrated = false;
            searchParams.forEach(function (val, key) {
              if (key.indexOf('c_') !== 0) return;
              var field = document.getElementById(key.slice(2));
              if (!field) return;
              if (field.type === 'checkbox' || field.type === 'radio') {
                field.checked = val === '1' || val === 'true';
              } else {
                field.value = val;
              }
              field.dispatchEvent(new Event('input', { bubbles: true }));
              field.dispatchEvent(new Event('change', { bubbles: true }));
              hydrated = true;
            });

            if (hydrated) {
              runTriggerSilently();
            } else if (resultsEl && resultsEl.classList.contains('hidden')) {
              var visibleNumInputs = [];
              mainContent.querySelectorAll('input[type="number"]').forEach(function (inp) {
                if (inp.closest('.hidden') || inp.closest('#metricHelper')) return;
                if (inp.id && inp.id.indexOf('s2_') === 0) return;
                visibleNumInputs.push(inp);
              });
              var allHaveValues = visibleNumInputs.length > 0 && visibleNumInputs.every(function (inp) {
                return inp.value !== '';
              });
              if (allHaveValues) {
                runTriggerSilently();
                var errMsg = document.getElementById('errorMsg');
                if (errMsg && resultsEl.classList.contains('hidden')) {
                  errMsg.classList.add('hidden');
                }
              }
            }
          }, 80);

          // Debounced live updates once results panel is visible
          var recalcTimer = null;
          var scheduleLiveRecalc = function (e) {
            if (isAutoRunning) return;
            var target = e.target;
            if (!target || (target.tagName !== 'INPUT' && target.tagName !== 'SELECT')) return;
            if (target.closest('#metricHelper') || target.closest('#projectListDrawer') || target.closest('#embedModal')) return;
            if (target.id === 'locMultSelect' || target.id === 'calcSearch') return;
            if (!resultsEl || resultsEl.classList.contains('hidden')) return;
            clearTimeout(recalcTimer);
            recalcTimer = setTimeout(function () {
              runTriggerSilently();
            }, 220);
          };
          mainContent.addEventListener('input', scheduleLiveRecalc);
          mainContent.addEventListener('change', scheduleLiveRecalc);
        }

        // ── Results Panel Actions (Floating button, Utility Bar, Cost Card) ─
        if (resultsEl) {
          if (floatBtn && resultsEl.id === 'results') {
            var intersectionObserver = new IntersectionObserver(function (entries) {
              entries.forEach(function (entry) {
                if (resultsEl.classList.contains('hidden') || entry.isIntersecting) {
                  floatBtn.classList.add('hidden');
                } else {
                  floatBtn.classList.remove('hidden');
                }
              });
            }, { threshold: 0.1 });
            intersectionObserver.observe(resultsEl);
          }

          ensureUtilityBar(resultsEl);
          if (!resultsEl.classList.contains('hidden')) {
            ensureCostBenchmarking(resultsEl);
          }

          var mutationObserver = new MutationObserver(function () {
            var isHidden = resultsEl.classList.contains('hidden');
            if (isHidden) {
              if (floatBtn) floatBtn.classList.add('hidden');
            } else {
              ensureUtilityBar(resultsEl);
              ensureCostBenchmarking(resultsEl);
              if (!gaFired && !window.__calcSilent) {
                gaFired = true;
                fireGA('calculator_used', {
                  page_title: document.title,
                  page_location: window.location.href,
                  engagement_time_msec: 1000
                });
              }
            }
          });
          mutationObserver.observe(resultsEl, {
            attributes: true,
            attributeFilter: ['class']
          });
        }

        // ── Delegated Handlers: Save to Project List & Share Estimate Link ───
        document.addEventListener('click', function (e) {
          var saveBtn = e.target.closest('.save-project-btn');
          if (saveBtn) {
            var est = collectEstimateLines(getResultsContainer());
            var list = loadProjectList().filter(function (item) {
              return item.path !== window.location.pathname;
            });
            list.unshift({
              path: window.location.pathname,
              title: est.title,
              shareUrl: est.shareUrl,
              items: est.items,
              savedAt: new Date().toISOString()
            });
            saveProjectList(list);
            var orig = saveBtn.textContent;
            saveBtn.textContent = '✓ Saved to Project List';
            fireGA('save_project_estimate', { page_path: window.location.pathname });
            setTimeout(function () { saveBtn.textContent = orig; }, 2200);
          }

          var shareBtn = e.target.closest('.share-link-btn');
          if (shareBtn) {
            var shareUrl = buildShareUrl();
            if (window.history && window.history.replaceState) {
              try { window.history.replaceState(null, '', shareUrl); } catch (err) {}
            }
            var origShare = shareBtn.textContent;
            var doneShare = function () {
              shareBtn.textContent = '✓ Link Copied!';
              fireGA('share_estimate_link', { page_path: window.location.pathname });
              setTimeout(function () { shareBtn.textContent = origShare; }, 2200);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(shareUrl).then(doneShare).catch(function () {
                fallbackCopyText(shareUrl, shareBtn);
              });
            } else {
              fallbackCopyText(shareUrl, shareBtn);
            }
          }
        });

        // ── Global Mobile Keypad Auto-Enhancer ──────────────────────────────
        document.querySelectorAll('input[type="number"]').forEach(function (input) {
          if (!input.hasAttribute('inputmode')) {
            input.setAttribute('inputmode', 'decimal');
          }
        });

        // ── Global "Copy Shopping List" Handler ─────────────────────────────
        document.addEventListener('click', function (e) {
          var btn = e.target.closest('.copy-list-btn, #copyBtn');
          if (!btn) return;
          var est = collectEstimateLines(getResultsContainer());
          if (!est.text) return;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(est.text).then(function () {
              showCopyFeedback(btn);
            }).catch(function () {
              fallbackCopyText(est.text, btn);
            });
          } else {
            fallbackCopyText(est.text, btn);
          }
        });

        function showCopyFeedback(btn) {
          var origText = btn.innerHTML;
          btn.innerHTML = '✓ Copied to Clipboard!';
          btn.classList.add('bg-green-700', 'text-white', 'border-green-700');
          fireGA('copy_shopping_list', {
            page_location: window.location.href,
            page_title: document.title
          });
          setTimeout(function () {
            btn.innerHTML = origText;
            btn.classList.remove('bg-green-700', 'text-white', 'border-green-700');
          }, 2500);
        }

        function fallbackCopyText(text, btn) {
          var textArea = document.createElement("textarea");
          textArea.value = text;
          textArea.style.position = "fixed";
          textArea.style.left = "-9999px";
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();
          try {
            document.execCommand('copy');
            showCopyFeedback(btn);
          } catch (err) {
            alert("Selected text copied.");
          }
          document.body.removeChild(textArea);
        }

        // ── Global Embed Modal Controller (Moat 5) ──────────────────────────
        document.addEventListener('click', function (e) {
          var openBtn = e.target.closest('.open-embed-modal-btn');
          if (openBtn) {
            var modal = document.getElementById('embedModal');
            var area = document.getElementById('embedSnippetArea');
            if (modal && area) {
              var calcTitle = document.title.split('—')[0].trim();
              var calcUrl = window.location.href.split('?')[0];
              var snippet = '<iframe src="' + calcUrl + '" width="100%" height="680" frameborder="0" style="border:1px solid #e2e8f0;border-radius:12px;max-width:100%;"></iframe>\n<p style="font-size:11px;color:#64748b;margin-top:4px;text-align:right;">Powered by <a href="' + calcUrl + '" target="_blank" style="color:#2563eb;text-decoration:underline;">' + calcTitle + '</a></p>';
              area.value = snippet;
              modal.classList.remove('hidden');
            }
          }

          var copyEmbedBtn = e.target.closest('#copyEmbedBtn');
          if (copyEmbedBtn) {
            var area = document.getElementById('embedSnippetArea');
            if (area) {
              navigator.clipboard.writeText(area.value).then(function () {
                copyEmbedBtn.textContent = '✓ Embed Code Copied!';
                setTimeout(function () {
                  copyEmbedBtn.textContent = '📋 Copy HTML Embed Code';
                }, 2500);
              });
            }
          }
        });

        // ── Mobile Hamburger Menu Toggle ────────────────────────────────────
        var mBtn = document.getElementById('mobileMenuBtn');
        var mMenu = document.getElementById('mobileMenu');
        if (mBtn && mMenu) {
          mBtn.addEventListener('click', function () {
            var isOpen = !mMenu.classList.contains('hidden');
            if (isOpen) {
              mMenu.classList.add('hidden');
              mBtn.setAttribute('aria-expanded', 'false');
              mBtn.classList.remove('is-open');
            } else {
              mMenu.classList.remove('hidden');
              mBtn.setAttribute('aria-expanded', 'true');
              mBtn.classList.add('is-open');
            }
          });
        }
      });
    </script>
  </body>
</html>
---
import '../styles/global.css';
const { title, description, noindex = false } = Astro.props;
const isCalculatorPage = Astro.url.pathname.startsWith('/calculators/') && Astro.url.pathname !== '/calculators/' && Astro.url.pathname !== '/calculators';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#2563eb" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <title>{title}</title>
  <link rel="canonical" href={`https://calcfordiy.com${Astro.url.pathname}`} />
  
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-SK11L47SS5" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-SK11L47SS5');
  </script>

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6410565511961171" crossorigin="anonymous" is:inline></script>

  <!-- Open Graph Meta Tags -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://calcfordiy.com${Astro.url.pathname}`} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://calcfordiy.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  
  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
</head>
  <body class="bg-gray-50 text-gray-900 overflow-x-hidden">
    <header class="bg-white border-b border-gray-200 px-4 py-3 print:hidden">
      <div class="max-w-5xl mx-auto flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-blue-600">CalcForDIY</a>
         <nav class="text-sm text-gray-600 flex gap-5 font-medium">
          <a href="/calculators" class="hover:text-blue-600 transition-colors">Calculators</a>
          <a href="/projects" class="hover:text-blue-600 transition-colors text-blue-700 font-semibold">Projects</a>
          <a href="/guides" class="hover:text-blue-600 transition-colors">Guides</a>
          <a href="/about" class="hover:text-blue-600 transition-colors">About</a>
          <a href="/contact" class="hover:text-blue-600 transition-colors">Contact</a>
        </nav>
      </div>
    </header>
    
    <main class="max-w-5xl mx-auto px-4 py-8">
      <slot />
    </main>

    {isCalculatorPage && (
      <div class="max-w-5xl mx-auto px-4 mt-12 print:hidden">
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 text-sm text-amber-900 shadow-sm flex items-start gap-3">
          <span class="text-xl shrink-0">⚠️</span>
          <div>
            <h4 class="font-bold text-amber-950 mb-1">Disclaimer &amp; DIY Safety Notice</h4>
            <p class="text-xs text-amber-900 leading-relaxed">
              While we have performed strict due diligence in researching building codes, manufacturer specifications, and material formulas, CalcForDIY bears no responsibility or liability for the use of these tools. Human or machine errors are real—typing mistakes or improper job site measurements can lead to undesirable consequences and material waste. All calculations are estimates intended for planning purposes only; use them at your own risk and responsibility. Always follow the golden rule of craftsmanship: <strong>"Measure seven times, cut once."</strong> Verify all measurements, and if still unsure, consult licensed professionals or local building officials before purchasing materials or executing structural, electrical, or plumbing work.
            </p>
          </div>
        </div>
      </div>
    )}

    <footer class="border-t border-gray-200 mt-16 px-4 py-10 text-sm text-gray-500 print:hidden">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Calculators</h3>
            <ul class="space-y-2">
              <li><a href="/calculators/shower-tile" class="hover:text-blue-600">Shower Tile</a></li>
              <li><a href="/calculators/paint-room" class="hover:text-blue-600">Paint — Room</a></li>
              <li><a href="/calculators/laminate-flooring" class="hover:text-blue-600">Laminate Flooring</a></li>
              <li><a href="/calculators/concrete-slab" class="hover:text-blue-600">Concrete Slab</a></li>
              <li><a href="/calculators/drywall" class="hover:text-blue-600">Drywall</a></li>
              <li><a href="/calculators" class="text-blue-600 font-medium hover:underline">View all 40+ →</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Categories</h3>
            <ul class="space-y-2">
              <li><a href="/calculators" class="hover:text-blue-600">Tile</a></li>
              <li><a href="/calculators" class="hover:text-blue-600">Flooring</a></li>
              <li><a href="/calculators" class="hover:text-blue-600">Walls</a></li>
              <li><a href="/calculators" class="hover:text-blue-600">Paint</a></li>
              <li><a href="/calculators" class="hover:text-blue-600">Lighting</a></li>
              <li><a href="/calculators" class="hover:text-blue-600">Utilities</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Resources</h3>
            <ul class="space-y-2">
              <li><a href="/guides" class="hover:text-blue-600">DIY Guides</a></li>
              <li><a href="/guides/how-much-mulch-for-garden-beds" class="hover:text-blue-600">Mulch Guide</a></li>
              <li><a href="/guides/laminate-flooring-waste-factor" class="hover:text-blue-600">Waste Factor Guide</a></li>
              <li><a href="/guides/how-much-concrete-for-fence-posts" class="hover:text-blue-600">Fence Post Guide</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Company</h3>
            <ul class="space-y-2">
              <li><a href="/about" class="hover:text-blue-600">About</a></li>
              <li><a href="/contact" class="hover:text-blue-600">Contact</a></li>
              <li><a href="/privacy" class="hover:text-blue-600">Privacy Policy</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-200 pt-6 text-center">
          <p>© 2026 CalcForDIY — Free calculators for home improvement projects.</p>
          <p class="mt-1 text-xs text-gray-400">All calculations are estimates. Always verify quantities with your specific product packaging before purchasing.</p>
        </div>
      </div>
    </footer>

    <!-- Floating results button - added print:hidden so it doesn't print -->
    <div id="floatBtn" class="hidden fixed bottom-6 inset-x-0 flex justify-center z-50 pointer-events-none print:hidden">
      <button
        onclick="document.getElementById('results').scrollIntoView({behavior:'smooth'})"
        class="pointer-events-auto bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full shadow-xl font-semibold text-sm flex items-center gap-2 transition-all">
        See your results ↓
      </button>
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var resultsEl = document.getElementById('results');
        var floatBtn = document.getElementById('floatBtn');
        var calcBtn  = document.getElementById('calcBtn');
        var gaFired  = false; // fire once per page load

        // ── GA4 helper ──────────────────────────────────────────────────────
        function fireGA(eventName, params) {
          if (typeof gtag === 'function') {
            gtag('event', eventName, params);
          }
        }

        // ── Track "Calculate" button click ───────────────────────────────────
        if (calcBtn) {
          calcBtn.addEventListener('click', function () {
            fireGA('calculate_button_click', {
              page_title:    document.title,
              page_location: window.location.href
            });
          });
        }

        if (!resultsEl || !floatBtn) return;

        // ── Watch results div visibility in viewport ─────────────────────────
        var intersectionObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (resultsEl.classList.contains('hidden')) {
              floatBtn.classList.add('hidden');
            } else if (entry.isIntersecting) {
              floatBtn.classList.add('hidden');
            } else {
              floatBtn.classList.remove('hidden');
            }
          });
        }, { threshold: 0.1 });

        intersectionObserver.observe(resultsEl);

        // ── Ensure Copy Shopping List button is present on all calculators ───────
        function ensureCopyButton(resDiv) {
          if (!resDiv || resDiv.querySelector('.copy-list-btn, #copyBtn')) return;

          var printBtn = resDiv.querySelector('#printBtn, button[onclick*="window.print"]');
          if (printBtn) {
            var parent = printBtn.parentElement;
            if (parent && parent.classList.contains('grid')) {
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'copy-list-btn w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2';
              btn.innerHTML = '📋 Copy Shopping List';
              parent.insertBefore(btn, printBtn);
            } else {
              var grid = document.createElement('div');
              grid.className = 'grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5 print:hidden';
              printBtn.parentNode.insertBefore(grid, printBtn);

              printBtn.classList.remove('hidden', 'mt-5', 'mt-4');
              printBtn.style.display = '';

              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'copy-list-btn w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2';
              btn.innerHTML = '📋 Copy Shopping List';

              grid.appendChild(btn);
              grid.appendChild(printBtn);
            }
          } else {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'copy-list-btn w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors text-sm flex justify-center items-center gap-2 mt-5 print:hidden';
            btn.innerHTML = '📋 Copy Shopping List';
            resDiv.appendChild(btn);
          }
        }

        // Run initially in case results is visible
        ensureCopyButton(resultsEl);

        // ── Watch for results div being shown — fire GA engagement event & ensure copy button ─────
        var mutationObserver = new MutationObserver(function () {
          var isHidden = resultsEl.classList.contains('hidden');

          if (isHidden) {
            floatBtn.classList.add('hidden');
          } else {
            ensureCopyButton(resultsEl);

            if (!gaFired) {
              // Results just became visible → fire GA4 engagement event
              gaFired = true;
              fireGA('calculator_used', {
                page_title:    document.title,
                page_location: window.location.href,
                engagement_time_msec: 1000 // tells GA4 this session is engaged
              });
            }
          }
        });

        mutationObserver.observe(resultsEl, {
          attributes: true,
          attributeFilter: ['class']
        });
      });

      // ── Global "Copy Shopping List" Handler ─────────────────────────────────
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.copy-list-btn, #copyBtn');
        if (!btn) return;

        var resultsDiv = document.getElementById('results');
        if (!resultsDiv) return;

        var title = document.title.split('—')[0].trim();
        var url = window.location.href;

        var lines = [];
        lines.push('📋 ' + title + ' — Material Takeoff');
        lines.push('CalcForDIY | ' + url);
        lines.push('----------------------------------------');

        var cards = resultsDiv.querySelectorAll('.bg-white.rounded-lg');
        cards.forEach(function (card) {
          var valEl = card.querySelector('.text-2xl, .text-3xl, .text-xl, .font-bold, .font-black');
          var labelEl = card.querySelector('.text-xs, .text-sm, .font-medium');
          if (valEl && labelEl) {
            var val = valEl.textContent.trim();
            var label = labelEl.textContent.trim();
            if (val && label && val !== '—' && !label.includes('On-Center') && !label.includes('Layout Summary')) {
              lines.push('• ' + label + ': ' + val);
            }
          }
        });

        var summaryEl = document.getElementById('r_summary') || document.getElementById('r_buying') || document.getElementById('r_birdsMouth');
        if (summaryEl && summaryEl.textContent.trim() !== '—') {
          lines.push('');
          lines.push('Details: ' + summaryEl.textContent.trim());
        }

        lines.push('----------------------------------------');
        lines.push('Calculated at CalcForDIY.com — "Measure seven times, cut once."');

        var textToCopy = lines.join('\n');

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(textToCopy).then(function () {
            showCopyFeedback(btn);
          }).catch(function () {
            fallbackCopyText(textToCopy, btn);
          });
        } else {
          fallbackCopyText(textToCopy, btn);
        }
      });

      function showCopyFeedback(btn) {
        var origText = btn.innerHTML;
        btn.innerHTML = '✓ Copied to Clipboard!';
        btn.classList.add('bg-green-700', 'border-green-700');
        setTimeout(function () {
          btn.innerHTML = origText;
          btn.classList.remove('bg-green-700', 'border-green-700');
        }, 2500);
      }

      function fallbackCopyText(text, btn) {
        var textArea = document.createElement("textarea");
        textArea.value = text;
        textArea.style.position = "fixed";
        textArea.style.left = "-9999px";
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
          document.execCommand('copy');
          showCopyFeedback(btn);
        } catch (err) {
          alert("Selected text copied.");
        }
        document.body.removeChild(textArea);
      }
    </script>
  </body>
</html>